            {
                var cell = root.GetComponent<StationCell>();
                var ratio = StageLayout.CellMetres / WorldUnits.CellLength;
                foreach (var filter in root.GetComponentsInChildren<MeshFilter>(true))
                {
                    if (filter.transform.IsChildOf(cell.stake) || filter.transform.IsChildOf(cell.collapseProps.transform)
                        || filter.transform.IsChildOf(cell.pipes.transform) && filter.name.StartsWith("LaidPipe", StringComparison.Ordinal)) continue;
