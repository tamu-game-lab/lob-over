        private static Component[] SavedComponents(GameObject obj) => obj.GetComponents<Component>()
            .Where(c => c == null || (c.hideFlags & HideFlags.DontSave) == 0).ToArray();
        private static bool SameReference(Object a, Object b, Dictionary<Object, string> paths, Dictionary<Object, string> otherPaths)
        {
            if (a == null || b == null) return a == null && b == null;
            var internalA = paths.TryGetValue(a, out var path); var internalB = otherPaths.TryGetValue(b, out var otherPath);
            if (internalA || internalB) return internalA && internalB && path == otherPath;
            // Shared assets have persistent GUID/local IDs; scene instance IDs and bone
            // object identity are never used as the value of a serialized reference.
            return AssetDatabase.TryGetGUIDAndLocalFileIdentifier(a, out string guid, out long localId)
                && AssetDatabase.TryGetGUIDAndLocalFileIdentifier(b, out string otherGuid, out long otherId)
                && guid == otherGuid && localId == otherId;
        }
        private static GameObject BuiltModel(string name, Mesh mesh, Material material)
        {
            var root = new GameObject(name);
            try
            {
                root.AddComponent<MeshFilter>().sharedMesh = mesh;
                root.AddComponent<MeshRenderer>().sharedMaterial = material;
                return SaveIfChanged(root, SiteAssetBuilder.Converted + "Play_" + name + ".prefab");
            }
            finally { Object.DestroyImmediate(root); }
        }
        private static GameObject Pipe(WorldAssets assets)
        {
            var material = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "LaidPipe.mat", "LOBOver/SiteLit");
            material.shaderKeywords = Array.Empty<string>(); material.SetFloat("_World", 0); material.SetFloat("_Splat", 0);
            var root = new GameObject("PipeMaps");
            try
            {
                root.AddComponent<MeshRenderer>().sharedMaterial = material;
                Maps(root, SiteAssetBuilder.Imported + "3D_Models/pipe/source/PIPE.fbx", assets);
            }
            finally { Object.DestroyImmediate(root); }
            return BuiltModel("Pipe", SiteGeometryBuilder.Pipe(), material);
        }
        private static void ScaleLog(string name, float measured, float target)
        {
            if (Mathf.Abs(measured / target - 1) > ScaleTolerance)
                Debug.LogWarning($"WO-L4 scale: {name} was {measured:F3} m; scaled to {target:F3} m (over 25% off).");
        }
        public static GameObject Model(string path, string name, float height, WorldAssets assets, bool optional = false, bool pipe = false)
        {
            var source = AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Imported + path);
            if (source == null && optional) { Debug.LogWarning("WO-L4 optional import missing: " + path + "; rerun Play Scene after import."); return null; }
            return Copy(source, name, height, pipe, assets);
        }
        public static float RoofHeight(GameObject model)
        {
            var bounds = Bounds(model);
            // The imported excavator calls its cab operatorCabin; "cab" also matches boom cables.
            var cabin = model.GetComponentsInChildren<Renderer>(true).Where(r => r.name.IndexOf("Cabin", StringComparison.OrdinalIgnoreCase) >= 0
                || r.name.EndsWith(":mainBody", StringComparison.Ordinal)).ToArray();
            return cabin.Length > 0 ? cabin.Max(r => r.bounds.max.y) - bounds.min.y : bounds.size.y;
        }
        // WO-L8 item 3, length and cab-roof height, metres.
        public static Vector2 MachineSize(string crew, string plate)
        {
            var size = plate.ToLowerInvariant();
            if (crew == "exc") return size == "large" ? new Vector2(11, 3.6f) : size == "small" ? new Vector2(7.5f, 2.8f) : new Vector2(9.5f, 3.2f);
            if (crew == "pipe") return (size == "heavy" || size == "large") ? new Vector2(14, 4.2f) : new Vector2(12, 3.8f);
            return new Vector2(size == "small" ? 5 : size == "large" ? 7 : 6, 3.2f);
        }
        public static void Populate(WorldAssets assets, WorldAssets legacy)
        {
            assets.worker = Copy(legacy.worker, "Worker", WorkerHeight, assets: assets);
            assets.machines = legacy.machines.Select(m => new MachineAsset { crew = m.crew, label = m.label, plate = m.plate,
                prefab = Copy(m.prefab, m.prefab.name, assets: assets, machineSize: MachineSize(m.crew, m.plate)) }).ToArray();
            assets.pipe = Pipe(assets);
            assets.spoil = BuiltModel("HeroSpoil", SiteGeometryBuilder.HeroPile(), assets.spoilSurface);
            assets.cone = Copy(legacy.cone, "Cone", 0.7f, assets: assets);
            assets.barrier = Copy(legacy.barrier, "WaterBarrier", 1, assets: assets);
            const string props = "3D_Models/Construction Assets/Traffic Props/";
            assets.fence = Model(props + "fence_long/fence_long.obj", "Fence", 1.8f, assets);
            assets.jersey = Model(props + "jersey_barrier/jersey_barrier.obj", "Jersey", 0.9f, assets);
            // Convert every material in the four additions, including FBX subassets, without
            // changing importers or remaps in the read-only LOBGame copies.
            foreach (var folder in new[] { "Tree", "sophiaImports", "traffic-props", "construction-site-barrier" })
            {
                var path = SiteAssetBuilder.Imported + "3D_Models/" + folder;
                if (!AssetDatabase.IsValidFolder(path)) { Debug.LogWarning("WO-L4 optional import missing: " + path); continue; }
                foreach (var guid in AssetDatabase.FindAssets("", new[] { path }).OrderBy(g => g, StringComparer.Ordinal))
                    foreach (var material in AssetDatabase.LoadAllAssetsAtPath(AssetDatabase.GUIDToAssetPath(guid)).OfType<Material>()) SiteMaterialBuilder.Copy(material);
            }
            var newFence = Model("3D_Models/traffic-props/source/Traffic Props/Traffic Props/fence_long/fence_long.obj", "AddedFence", 1.8f, assets, true);
            if (newFence != null) assets.fence = newFence;
            var newBarrier = Model("3D_Models/construction-site-barrier/source/blocker.fbx", "ConstructionBarrier", 1, assets, true);
            if (newBarrier != null) assets.barrier = newBarrier;
            assets.tree = Tree(assets);
        }
        public static int Triangles(GameObject model) => model.GetComponentsInChildren<MeshFilter>(true).Sum(f => f.sharedMesh == null ? 0 : Enumerable.Range(0, f.sharedMesh.subMeshCount).Sum(i => (int)f.sharedMesh.GetIndexCount(i) / 3))
            + model.GetComponentsInChildren<SkinnedMeshRenderer>(true).Sum(r => r.sharedMesh == null ? 0 : r.sharedMesh.triangles.Length / 3);
        private static GameObject Tree(WorldAssets assets)
        {
            var paths = new[] { "Tree 2/fast-urban-tree/source/Fast-tree.fbx", "Tree 2/beech/beech.fbx", "Tree1/tree/source/TreeGenerator.fbx" };
            var candidate = paths.Select(p => AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Imported + "3D_Models/Tree/" + p))
                .Where(m => m != null && Triangles(m) > 0 && Triangles(m) < TreeTriangleLimit).OrderBy(Triangles).ThenBy(m => m.name, StringComparer.Ordinal).FirstOrDefault();
            if (candidate == null) { Debug.LogWarning("WO-L4: no imported tree below 8,000 triangles; tree line omitted until import."); return null; }
            Debug.Log("WO-L4 tree: " + candidate.name + ", " + Triangles(candidate) + " triangles.");
            // Level 1's trees are all 80..120 m from the road, beyond the 60 m detail
            // boundary. The full beech survives only as this builder's bake source.
            var source = Copy(candidate, "TreeBakeSource", assets: assets);
            return SiteTreeBuilder.Build(source);
        }
        private static void Maps(GameObject root, string path, WorldAssets assets)
        {
            if (assets == null) return;
            if (path.Contains("a-pile-of-sand"))
            {
                // The hero keeps its scan UVs; only the procedural windrow uses world tiling.
                var scan = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "HeroSpoil.mat", "LOBOver/SiteLit");
                scan.CopyPropertiesFromMaterial(assets.spoilSurface); scan.DisableKeyword("_WORLD"); scan.SetFloat("_World", 0);
                foreach (var r in root.GetComponentsInChildren<Renderer>()) r.sharedMaterials = r.sharedMaterials.Select(_ => scan).ToArray();
                return;
            }
            var folder = Path.GetDirectoryName(path).Replace('\\', '/');
            if (path.Contains("/pipe/")) folder = SiteAssetBuilder.Imported + "3D_Models/pipe/textures";
            if (path.Contains("fast-urban-tree")) folder = SiteAssetBuilder.Imported + "3D_Models/Tree/Tree 2/fast-urban-tree/textures";
            if (path.Contains("Tree1/tree")) folder = SiteAssetBuilder.Imported + "3D_Models/Tree/Tree1/tree/textures";
            if (path.Contains("/beech/"))
            {
                // The FBX 6.1 file binds textures to Tree_0 (bark) and Tree_1 (leaf),
                // without named Material nodes. Keep those two surfaces distinct on import.
                foreach (var renderer in root.GetComponentsInChildren<Renderer>())
                {
                    var leaf = renderer.name.Contains("Tree_1");
                    var material = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + (leaf ? "BeechLeaf.mat" : "BeechBark.mat"), "LOBOver/SiteLit");
                    if (renderer.sharedMaterial != null) material.CopyPropertiesFromMaterial(renderer.sharedMaterial);
                    renderer.sharedMaterials = renderer.sharedMaterials.Select(_ => material).ToArray();
                }
            }
            foreach (var material in root.GetComponentsInChildren<Renderer>().SelectMany(r => r.sharedMaterials).Distinct())
            {
                var albedo = SiteMaterialBuilder.Texture(folder, path.Contains("fast-urban-tree") ? "Fastcolor" : "BaseColor") ?? SiteMaterialBuilder.Texture(folder, "Albedo");
                var normal = SiteMaterialBuilder.Texture(folder, "Normal");
                if (path.Contains("/beech/"))
                {
                    var leaf = material.name.IndexOf("leaf", StringComparison.OrdinalIgnoreCase) >= 0;
                    albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(folder + (leaf ? "/beech leaf.png" : "/bark01.png"));
                    normal = SiteMaterialBuilder.Texture(folder, leaf ? "leaf_Normal" : "bark01_normal");
                }
                if (albedo != null) { material.SetTexture("_BaseMap", albedo); material.SetColor("_BaseColor", Color.white); }
                if (normal != null) material.SetTexture("_BumpMap", SiteTextureBuilder.LinearCopy(normal, true));
                var occlusion = SiteMaterialBuilder.Texture(folder, "Occlusion");
                if (occlusion != null)
                {
                    var map = SiteTextureBuilder.LinearCopy(occlusion, false);
                    if (material.GetTexture("_OcclusionMap") != map) material.SetFloat("_OcclusionFromMask", 0);
                    material.SetTexture("_OcclusionMap", map);
                }
                SiteMaterialBuilder.PackOcclusion(material);
                if (path.Contains("/pipe/"))
                {
                    var metallic = SiteTextureBuilder.LinearCopy(SiteMaterialBuilder.Texture(folder, "Metallic"), false);
                    var roughness = SiteTextureBuilder.LinearCopy(SiteMaterialBuilder.Texture(folder, "Roughness"), false);
                    if (metallic != null && roughness != null)
                    { material.SetTexture("_MetallicGlossMap", SiteTextureBuilder.MetallicRoughness(metallic, roughness)); material.SetFloat("_Smoothness", 1); material.EnableKeyword("_METALLICSPECGLOSSMAP"); }
                }
                if (path.Contains("/Tree/"))
                {
                    var leaf = material.name.IndexOf("leaf", StringComparison.OrdinalIgnoreCase) >= 0;
                    var alpha = path.Contains("/beech/") && !leaf ? null : SiteMaterialBuilder.Texture(folder, path.Contains("fast-urban-tree") ? "Fastmask" : "leaf_alpha");
                    material.SetTexture("_AlphaMap", SiteTextureBuilder.LinearCopy(alpha, false)); material.SetFloat("_UseAlphaMap", alpha == null ? 0 : 1);
                    if (alpha != null && material.GetTexture("_BaseMap") is Texture2D color)
                        material.SetTexture("_BaseMap", SiteTextureBuilder.PackOpacity(color, SiteTextureBuilder.LinearCopy(alpha, false)));
                    material.EnableKeyword("_ALPHATEST_ON"); material.SetFloat("_AlphaClip", 1); material.SetFloat("_Cull", 0);
                }
                EditorUtility.SetDirty(material);
            }
        }
    }
}
using System;
using LOBOver.Sim;
using LOBOver.XR;
using TMPro;
using UnityEngine;
using UnityEngine.Rendering;

namespace LOBOver.World
{
    public sealed class CrewRig : MonoBehaviour
    {
        public bool staged;
        public string Id { get; private set; }
        public string Status { get; private set; }
        public double StationFt { get; private set; }
        public int MoodLevel { get; private set; }
        public string MachinePlate { get; private set; }
        public Transform Foreman => workers[0];
        public Transform Partner => partner;
        public string ForemanClip => clips[0];
        public bool WorkingParticles => particles != null && particles.isPlaying;
        public GameObject Machine => machine;
        private WorldAssets assets;
        private GameObject machine, effects;
        private GameObject machinePerimeter;
        private Animator[] machineAnimators;
        private readonly Transform[] workers = new Transform[2]; // WO-08: two workers per machine.
        private readonly Animator[] animators = new Animator[2];
        private readonly string[] clips = new string[2];
        private TextMeshPro plate;
        private ParticleSystem particles;
        private AudioSource engine, argument;
        private Transform partner;
        private Vector3 target, movementVelocity;
        private float statusTime;
        private bool positioned;
        public const float ShadowMetres = 30, MachineDetailMetres = 60, DistanceCheckSeconds = 1; // WO-L4 rejection 3.
        private XRRig rig;
        private Renderer[] shadowRenderers;
        private GroundedObject[] grounded;
        private LODGroup machineLod;
        private float nextDistanceCheck;
        private readonly Vector3[] workerTargets = new Vector3[2], workerVelocities = new Vector3[2];
        // Presentation cadence only; the mood level itself comes exclusively from SiteView.
        private const float PointPeriodSeconds = 10; // WO-08 section 3.
        private const float WorkingAlternateSeconds = 4;
        private static readonly string[] MoodClips = { "Idle", "IdleAlternate", "Drink", "EquipmentCheck" };
        private static readonly float[] MoodSpeeds = { 1, 0.9f, 0.8f, 0.7f };
        private void OnEnable()
        {
            if (engine != null && engine.clip != null) engine.Play();
            if (argument != null && argument.clip != null) argument.Play();
            if (Status == "working" && effects != null)
                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Play();
            nextDistanceCheck = 0;
        }

        public void Initialize(string id, WorldAssets source)
        {
            Id = id; assets = source; name = "Crew_" + id;
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i] = Instantiate(assets.worker, transform).transform; workers[i].name = i == 0 ? "Foreman" : "Worker";
                animators[i] = workers[i].GetComponentInChildren<Animator>();
                if (animators[i] != null) { animators[i].applyRootMotion = false; animators[i].cullingMode = AnimatorCullingMode.AlwaysAnimate; }
                InspectTarget.Attach(workers[i].gameObject, "crew");
                if (assets.detailedSite) GroundedObject.Place(workers[i].gameObject, transform.parent, true);
            }
            effects = Instantiate(assets.particles, transform); effects.name = "WorkParticles";
            particles = effects.GetComponentInChildren<ParticleSystem>();
            foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
            if (assets.detailedSite) SiteDetailDrawing.CrewSurroundings(transform, assets, staged);
            else
            {
                plate = WorldDrawing.Text("MachinePlate", transform, new Vector3(-1, 2.5f, 1), new Vector2(4, 0.5f), 0.25f, assets.font);
                plate.transform.localRotation = Quaternion.Euler(0, 180, 0);
            }
            engine = WorldDrawing.Sound(gameObject, true); argument = WorldDrawing.Sound(gameObject, true, 35);
        }
        public void Apply(CrewView view, Vector3? stageTarget = null)
        {
            var machineChanged = machine == null || !string.Equals(MachinePlate, view.machinePlate, StringComparison.OrdinalIgnoreCase);
            if (machineChanged)
            {
                var item = assets.Machine(Id, view.machinePlate);
                if (item == null) throw new InvalidOperationException("No imported machine for " + Id + "/" + view.machinePlate);
                WorldDrawing.Remove(machine); machine = Instantiate(item.prefab, transform); machine.name = "Machine";
                if (staged) machine.transform.localRotation *= Quaternion.Euler(0, 180, 0);
                InspectTarget.Attach(machine, "machine"); machineAnimators = machine.GetComponentsInChildren<Animator>();
                foreach (var animator in machineAnimators) animator.applyRootMotion = false;
                if (assets.detailedSite) GroundedObject.Place(machine, transform.parent, true);
                if (assets.detailedSite)
                { WorldDrawing.Remove(machinePerimeter); machinePerimeter = SiteDetailDrawing.MachinePerimeter(machine, transform, assets); }
                MachinePlate = view.machinePlate; if (plate != null) plate.text = item.label;
                machineLod = machine.GetComponent<LODGroup>();
                shadowRenderers = GetComponentsInChildren<Renderer>(true);
                grounded = GetComponentsInChildren<GroundedObject>(true);
                nextDistanceCheck = 0;
            }
            var next = stageTarget ?? new Vector3((float)view.stationFt * WorldUnits.MetresPerFoot, 0, 0);
            if (!staged && view.status == "demobilized") next += new Vector3(-WorldUnits.DemobBackMetres, 0, WorldUnits.RoadZ);
            if (!positioned || !staged && Math.Abs(view.stationFt - StationFt) > WorldUnits.StationFeet)
            { transform.localPosition = next; movementVelocity = Vector3.zero; positioned = true; }
            target = next;
            StationFt = view.stationFt; MoodLevel = Mathf.Clamp((int)view.moodLevel, 0, 3);
            if (Status != view.status || machineChanged)
            {
                Status = view.status; statusTime = 0; Debug.Log(name + " " + Status, this);
                var working = Status == "working";
                if (machinePerimeter != null) machinePerimeter.SetActive(working);
                foreach (var animator in machineAnimators)
                {
                    animator.speed = working ? 1 : 0;
                    var cycle = Id == "exc" ? "Dig" : "Cycle";
                    if (working && animator.runtimeAnimatorController != null && animator.HasState(0, Animator.StringToHash(cycle))) animator.Play(cycle, 0, 0);
                }
                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>())
                    if (working && Application.isPlaying && effect.gameObject.activeInHierarchy) effect.Play(); else effect.Stop(true, ParticleSystemStopBehavior.StopEmitting);
                WorldDrawing.Loop(engine, working ? (Id == "exc" ? assets.excavation : Id == "back" ? assets.dozer : assets.idle) : Status == "demobilized" ? null : assets.idle);
                WorldDrawing.Loop(argument, Status == "arguing" ? assets.conflict : null);
            }
            ApplyAnimations();
        }
        public void FaceArgument(Transform other)
        {
            partner = other;
            SetWorkerTargets();
        }
        private void SetWorkerTargets()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                // WO-08: workers stand 2 metres behind the working edge on the road side.
                var goal = transform.parent.TransformPoint((staged ? new Vector3(transform.localPosition.x + 2, 0, -1.8f - i) : target + new Vector3(-2, 0, 2 + i)));
                if (i == 0 && Status == "arguing" && partner != null)
                {
                    var other = partner.GetComponent<CrewRig>();
                    var midpoint = (transform.localPosition + other.transform.localPosition) / 2;
                    if (staged) midpoint.z = -1.8f;
                    var side = string.CompareOrdinal(Id, other.Id) < 0 ? -1 : 1;
                    goal = transform.parent.TransformPoint(midpoint + new Vector3(side * 0.65f, 0, staged ? 0 : 3));
                }
                workerTargets[i] = goal;
            }
        }
        private void Update()
        {
            if (!positioned) return;
            if (assets.detailedSite && Time.unscaledTime >= nextDistanceCheck)
            {
                nextDistanceCheck = Time.unscaledTime + DistanceCheckSeconds;
                if (rig == null) rig = FindFirstObjectByType<XRRig>();
                if (rig != null) RefreshDistancePresentation(rig.ViewEye);
            }
            statusTime += Time.deltaTime;
            // A continuous target must not restart a tween on every frame. Four damping periods
            // settle a state change within the WO's half-second presentation interval.
            transform.localPosition = staged ? Vector3.MoveTowards(transform.localPosition, target, StageLayout.CrawlSpeed * Time.deltaTime)
                : Vector3.SmoothDamp(transform.localPosition, target, ref movementVelocity, WorldUnits.PoseSeconds / 4);
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i].position = Vector3.SmoothDamp(workers[i].position, workerTargets[i], ref workerVelocities[i], WorldUnits.PoseSeconds / 4);
                var facing = Status == "held" ? transform.parent.forward : (staged ? -transform.parent.right : transform.parent.right);
                if (i == 0 && Status == "arguing" && partner != null)
                    facing = partner.GetComponent<CrewRig>().Foreman.position - workers[i].position;
                facing.y = 0;
                if (facing.sqrMagnitude > 0.001f) workers[i].rotation = Quaternion.LookRotation(facing);
            }
            if (grounded != null) foreach (var item in grounded) if (item != null) item.Settle();
            ApplyAnimations();
        }
        public void RefreshDistancePresentation(Transform head)
        {
            if (head == null || assets == null || !assets.detailedSite) return;
            var distanceSquared = (transform.position - head.position).sqrMagnitude;
            var mode = distanceSquared <= ShadowMetres * ShadowMetres ? ShadowCastingMode.On : ShadowCastingMode.Off;
            shadowRenderers ??= GetComponentsInChildren<Renderer>(true);
            foreach (var renderer in shadowRenderers)
                if (renderer != null && !(renderer is ParticleSystemRenderer) && renderer.shadowCastingMode != mode) renderer.shadowCastingMode = mode;
            if (machineLod != null) machineLod.ForceLOD(distanceSquared <= MachineDetailMetres * MachineDetailMetres ? 0 : 1);
        }
        public void SnapPose()
        {
            if (!positioned) return;
            transform.localPosition = target; movementVelocity = Vector3.zero;
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            { workers[i].position = workerTargets[i]; workerVelocities[i] = Vector3.zero; }
            if (grounded != null) foreach (var item in grounded) if (item != null) item.Settle();
        }
        private bool ClipFinished(int index) => animators[index] == null || !animators[index].isActiveAndEnabled
            || animators[index].GetCurrentAnimatorStateInfo(0).normalizedTime >= 1;
        private void ApplyAnimations()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                var clip = MoodClips[MoodLevel];
                if (Status == "working") clip = ((int)(statusTime / WorkingAlternateSeconds) + i) % 2 == 0 ? "Walk" : "Inspect";
                else if (Status == "held" && MoodLevel == 0) clip = "IdleAlternate";
                else if (Status == "stopped" && (statusTime == 0 || clips[i] == "SignalHalt" && !ClipFinished(i))) clip = "SignalHalt";
                else if (Status == "arguing") clip = i == 0 && string.CompareOrdinal(Id, partner == null ? "" : partner.GetComponent<CrewRig>().Id) < 0 ? "ConflictTalk" : "TalkAlternate";
                else if (Status == "demobilized") clip = "Shelter";
                else if (MoodLevel == 3 && statusTime >= PointPeriodSeconds && statusTime % PointPeriodSeconds < 1) clip = "SignalPoint";
                if (clips[i] != clip)
                {
                    clips[i] = clip;
                    if (animators[i] != null && animators[i].runtimeAnimatorController != null && animators[i].HasState(0, Animator.StringToHash(clip)))
                        animators[i].Play(clip, 0, 0);
                }
                if (animators[i] != null) animators[i].speed = clip == MoodClips[MoodLevel] ? MoodSpeeds[MoodLevel] : 1;
            }
        }
    }
}

