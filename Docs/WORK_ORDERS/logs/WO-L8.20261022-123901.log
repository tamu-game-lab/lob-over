                for (var i = 0; i < 24; i++)
                {
                    if (i % 7 == 3) continue;
                    var tree = SiteDetailDrawing.Prop(assets.tree, site, new Vector3(-70 + i * 49, 0, -80 - i * 17 % 40));
                    tree.transform.localRotation = Quaternion.Euler(0, i * 137, 0); tree.GetComponent<GroundedObject>().Settle();
                }
