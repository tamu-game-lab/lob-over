            var horizon = SiteDetailDrawing.Mesh("Horizon", site, assets.horizonMesh, assets.ground);
            // WO-L4 rejection 3: these continuous surfaces receive, but need not cast.
            foreach (var surface in new[] { ground, horizon })
            { var renderer = surface.GetComponent<Renderer>(); renderer.shadowCastingMode = ShadowCastingMode.Off; renderer.receiveShadows = true; }
            // Seal the corridor beyond the longest authored site without covering host-driven cells.
            var after = SiteDetailDrawing.Mesh("BeyondTrench", site, assets.stripMesh, assets.soil, new Vector3(StageLayout.Extent, 0, 0));
            after.transform.localScale = new Vector3((SiteGeometryBuilder.MaxX - StageLayout.Extent) / WorldUnits.CellLength, 1, 1);
            var before = SiteDetailDrawing.Mesh("BeforeTrench", site, assets.stripMesh, assets.soil, new Vector3(SiteGeometryBuilder.MinX, 0, 0));
            before.transform.localScale = new Vector3((-StageLayout.Extent - SiteGeometryBuilder.MinX) / WorldUnits.CellLength, 1, 1);
            var sky = Sky(site, assets);
