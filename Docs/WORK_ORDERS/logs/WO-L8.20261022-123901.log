+using System;
+using System.Collections.Generic;
+using System.Linq;
+using LOBOver.World;
+using UnityEngine;
+using UnityEngine.Rendering;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Editor
+{
+    // WO-L8 rejection 1: keep the animated silhouettes, but do not draw each imported part
+    // separately or spend the three-crew budget on sub-centimetre worker detail.
+    public static class SiteMeshBudgetBuilder
+    {
+        private const int WorkerTriangles = 6000;
+        private const float FirstClusterMetres = 0.005f, LastClusterMetres = 0.04f;
+        public static void Prepare(GameObject model, string name, bool worker)
+        {
+            if (name.Contains("Fence"))
+            {
+                var filters = model.GetComponentsInChildren<MeshFilter>(true);
+                for (var i = 0; i < filters.Length; i++)
+                {
+                    var source = filters[i].sharedMesh;
+                    if (source == null || source.isReadable) continue;
+                    var mesh = new Mesh { indexFormat = IndexFormat.UInt32 };
+                    mesh.CombineMeshes(Enumerable.Range(0, source.subMeshCount)
+                        .Select(s => new CombineInstance { mesh = source, subMeshIndex = s, transform = Matrix4x4.identity }).ToArray(), false);
+                    filters[i].sharedMesh = SiteGeometryBuilder.Save(name + "_Batchable_" + i, mesh);
+                }
+            }
+            var skins = SiteGround.PhysicalRenderers(model.transform).OfType<SkinnedMeshRenderer>().ToArray();
+            if (worker)
+            {
+                var total = skins.Sum(r => r.sharedMesh.triangles.Length / 3);
+                for (var i = 0; i < skins.Length; i++)
+                {
+                    var skin = skins[i]; var mesh = skin.sharedMesh;
+                    if (total <= WorkerTriangles || mesh.blendShapeCount != 0 || mesh.subMeshCount != 1) continue;
+                    var target = Math.Max(1, WorkerTriangles * (mesh.triangles.Length / 3) / total);
+                    Mesh reduced = null;
+                    for (var step = FirstClusterMetres; ; step = Mathf.Min(LastClusterMetres, step * 1.4f))
+                    {
+                        if (reduced != null) Object.DestroyImmediate(reduced);
+                        reduced = Cluster(mesh, skin.transform.localToWorldMatrix, step);
+                        if (reduced.triangles.Length / 3 <= target || step >= LastClusterMetres) break;
+                    }
+                    skin.sharedMesh = SiteGeometryBuilder.Save(name + "_Skin_" + i, reduced);
+                }
+            }
+            // Single-material parts share their original bones, controller and animation paths.
+            var groups = skins.Where(r => r.sharedMaterials.Length == 1 && r.sharedMesh.subMeshCount == 1 && r.sharedMesh.blendShapeCount == 0
+                && r.name.IndexOf("Cabin", StringComparison.OrdinalIgnoreCase) < 0 && !r.name.EndsWith(":mainBody", StringComparison.Ordinal))
+                .GroupBy(r => r.sharedMaterial).ToArray();
+            for (var groupIndex = 0; groupIndex < groups.Length; groupIndex++)
+            {
+                var parts = groups[groupIndex].ToArray(); if (parts.Length < 2) continue;
+                var bones = new List<Transform>(); var poses = new List<Matrix4x4>(); var weights = new List<BoneWeight>();
+                var combines = new List<CombineInstance>();
+                foreach (var part in parts)
+                {
+                    var mesh = part.sharedMesh; var offset = bones.Count;
+                    var toModel = model.transform.worldToLocalMatrix * part.transform.localToWorldMatrix;
+                    combines.Add(new CombineInstance { mesh = mesh, transform = toModel });
+                    bones.AddRange(part.bones);
+                    poses.AddRange(mesh.bindposes.Select(p => p * toModel.inverse));
+                    foreach (var source in mesh.boneWeights)
+                    {
+                        var weight = source;
+                        weight.boneIndex0 += offset; weight.boneIndex1 += offset; weight.boneIndex2 += offset; weight.boneIndex3 += offset;
+                        weights.Add(weight);
+                    }
+                }
+                var combined = new Mesh { indexFormat = IndexFormat.UInt32 };
+                combined.CombineMeshes(combines.ToArray(), true, true);
+                combined.bindposes = poses.ToArray(); combined.boneWeights = weights.ToArray();
+                combined.RecalculateBounds();
+                var obj = new GameObject("BatchedSkin_" + groupIndex); obj.transform.SetParent(model.transform, false);
+                var renderer = obj.AddComponent<SkinnedMeshRenderer>();
+                renderer.sharedMesh = SiteGeometryBuilder.Save(name + "_BatchedSkin_" + groupIndex, combined);
+                renderer.sharedMaterial = groups[groupIndex].Key; renderer.bones = bones.ToArray();
+                renderer.rootBone = model.transform; renderer.localBounds = renderer.sharedMesh.bounds;
+                renderer.updateWhenOffscreen = true;
+                foreach (var part in parts) part.enabled = false;
+            }
+        }
+        private static Mesh Cluster(Mesh source, Matrix4x4 toMetres, float step)
+        {
+            var positions = source.vertices; var normals = source.normals; var uv = source.uv; var weights = source.boneWeights;
+            var grid = new Dictionary<(int, int, int, int), List<int>>(); var representatives = new List<int>(); var map = new int[positions.Length];
+            // Keep the physical extrema; sizing/grounding tests must measure the drawn geometry.
+            var extremes = new HashSet<int>();
+            for (var axis = 0; axis < 3; axis++)
+            {
+                var min = 0; var max = 0;
+                for (var i = 1; i < positions.Length; i++)
+                { if (positions[i][axis] < positions[min][axis]) min = i; if (positions[i][axis] > positions[max][axis]) max = i; }
+                extremes.Add(min); extremes.Add(max);
+            }
+            for (var i = 0; i < positions.Length; i++)
+            {
+                var p = toMetres.MultiplyPoint3x4(positions[i]);
+                var key = (Mathf.FloorToInt(p.x / step), Mathf.FloorToInt(p.y / step), Mathf.FloorToInt(p.z / step), weights[i].boneIndex0);
+                if (!grid.TryGetValue(key, out var bucket)) { bucket = new List<int>(); grid.Add(key, bucket); }
+                var match = -1;
+                if (!extremes.Contains(i)) foreach (var candidate in bucket)
+                {
+                    var old = representatives[candidate];
+                    // Do not weld across a UV seam, a crease, or two different skeleton influences.
+                    if (Vector2.SqrMagnitude(uv[i] - uv[old]) > 0.01f || Vector3.Dot(normals[i], normals[old]) < 0.5f
+                        || weights[i].boneIndex1 != weights[old].boneIndex1 || weights[i].boneIndex2 != weights[old].boneIndex2
+                        || weights[i].boneIndex3 != weights[old].boneIndex3) continue;
+                    match = candidate; break;
+                }
+                if (match < 0) { match = representatives.Count; representatives.Add(i); bucket.Add(match); }
+                map[i] = match;
+            }
+            var indices = source.triangles; var triangles = new List<int>(); var faces = new HashSet<(int, int, int)>();
+            for (var i = 0; i < indices.Length; i += 3)
+            {
+                var a = map[indices[i]]; var b = map[indices[i + 1]]; var c = map[indices[i + 2]];
+                if (a == b || b == c || c == a) continue;
+                var face = a < b && a < c ? (a, b, c) : b < c ? (b, c, a) : (c, a, b);
+                if (faces.Add(face)) { triangles.Add(a); triangles.Add(b); triangles.Add(c); }
+            }
+            // Strip unused vertices too: otherwise an undrawn point could falsely ground a worker.
+            var used = triangles.Distinct().OrderBy(i => i).ToArray(); var compact = new int[representatives.Count];
+            for (var i = 0; i < used.Length; i++) compact[used[i]] = i;
+            var selected = used.Select(i => representatives[i]).ToArray();
+            var mesh = new Mesh { indexFormat = IndexFormat.UInt32 };
+            mesh.vertices = selected.Select(i => positions[i]).ToArray(); mesh.normals = selected.Select(i => normals[i]).ToArray();
+            mesh.uv = selected.Select(i => uv[i]).ToArray(); mesh.boneWeights = selected.Select(i => weights[i]).ToArray(); mesh.bindposes = source.bindposes;
+            var tangents = source.tangents; if (tangents.Length == positions.Length) mesh.tangents = selected.Select(i => tangents[i]).ToArray();
+            mesh.triangles = triangles.Select(i => compact[i]).ToArray(); mesh.RecalculateBounds(); return mesh;
+        }
+    }
+}
