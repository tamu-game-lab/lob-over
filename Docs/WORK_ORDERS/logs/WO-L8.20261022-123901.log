        // LEVEL1.md clock; WO-L8 item 7 lighting and caption timing.
        public const float FullDaySeconds = 4, SlowDaySeconds = 15, DuskStart = 0.85f, DuskBrightness = 0.25f;
        public const float DawnSeconds = 0.3f, CaptionSeconds = 1.5f, CaptionAhead = 2, CaptionHeight = 0.2f;
        public const float HorizonDegrees = 20;
        public string Speed { get; private set; } = "paused";
        public float Fraction { get; private set; }
        public float Brightness { get; private set; } = 1;
        public float DaylightIntensity { get; private set; }
        private double day;
        private float receivedAt, dawnAt = -100, captionUntil;
        private int displayDay = -1;
        private Color daylightColour, ambientSky, ambientEquator, ambientGround, fog;
        private string run;
        private void OnEnable()
        {
            connection.Message += Receive;
            DaylightIntensity = sun.intensity; daylightColour = sun.color;
            ambientSky = RenderSettings.ambientSkyColor; ambientEquator = RenderSettings.ambientEquatorColor;
            ambientGround = RenderSettings.ambientGroundColor; fog = RenderSettings.fogColor;
            Shader.SetGlobalFloat("_SiteDayActive", 1);
        }
        private void OnDisable()
        {
            connection.Message -= Receive;
            sun.intensity = DaylightIntensity; sun.color = daylightColour;
            RenderSettings.ambientSkyColor = ambientSky; RenderSettings.ambientEquatorColor = ambientEquator;
            RenderSettings.ambientGroundColor = ambientGround; RenderSettings.fogColor = fog;
            Shader.SetGlobalFloat("_SiteDusk", 0); Shader.SetGlobalFloat("_SiteDayActive", 0);
        }
        private void Receive(JObject message)
        {
            if ((string)message["t"] == "welcome") message = message["state"] as JObject;
            if (message?["day"] == null) return;
            if (run != connection.RunId) { displayDay = -1; run = connection.RunId; }
            day = (double)message["day"]; receivedAt = Time.unscaledTime;
            Speed = (string)message["speed"] ?? "paused";
            var next = (int)System.Math.Floor(day) + 1;
            if (displayDay > 0 && next != displayDay)
            {
                dawnAt = Time.unscaledTime; captionUntil = dawnAt + CaptionSeconds;
                if (rig.TryHeadPose(out var pose))
                {
                    var position = pose.position + pose.rotation * Vector3.forward * CaptionAhead;
                    caption.transform.SetPositionAndRotation(position, Quaternion.LookRotation(position - pose.position));
                }
                caption.text = "Day " + next;
            }
