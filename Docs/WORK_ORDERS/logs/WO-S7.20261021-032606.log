<div class="controls"><a id="open-plan" target="_blank" href="plan.html">Open Plan tab</a><a id="open-site" target="_blank" href="site.html">Open Site tab</a><a id="manual" target="_blank" href="manual/slice_texas.pdf">Field manual</a><a href="howto.html" target="_blank">How to play</a></div>
