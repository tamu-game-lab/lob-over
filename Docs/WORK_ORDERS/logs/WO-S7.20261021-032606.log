      else {
        if (message.action === 'load') scenario = stageMap.get(message.stage);
        reset(); pacer.setFast(false);
        reply = { ok: true, appliedDay: sim.t };
      }
    } else if (message.t === 'ctrl' && message.action === 'fast') {
