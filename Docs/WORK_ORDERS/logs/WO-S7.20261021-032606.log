+  $('stations').innerHTML=stations.join('');
+  $('day-boxes').innerHTML='<thead><tr><th>Day</th>'+kit.job.zones.map(z=>`<th>Zone ${z.id}<br>${z.fromFt/100}+00 – ${z.toFt/100}+00</th>`).join('')+'</tr></thead><tbody>'+['Permit day','Pipe complete day','Inspection day','Backfill day'].map(label=>`<tr><th>${label}</th>${kit.job.zones.map(z=>`<td><input type="text" aria-label="${label} zone ${z.id}"></td>`).join('')}</tr>`).join('')+'</tbody>';
+  $('manual-content').replaceChildren();$('manual-status').textContent='Loading manual';selectSection(selected);
+  try{
