  }
  const clients = createClients({
    state,
    welcome(socket, seat, send) {
      for (const message of initialMessages) if (message.seats?.includes(seat)) send(socket, withVoiceText(message));
      if (result) send(socket, result);
    },
    command: handleCommand,
  });
  const broadcastTimer = setInterval(clients.broadcast, STATE_MS);
  function control(action, fields = {}) {
    let response;
    // Public controls are local to the host, so do not claim a facilitator seat.
    handleCommand(null, 'facilitator', { t: 'ctrl', v: 1, action, ...fields }, (_, message) => { response = message; });
    return response;
  }
  return {
    attach: clients.attach, state,
    start: () => control('start'), pause: () => control('pause'), resume: () => control('resume'),
    reset: () => control('reset'), load: stage => control('load', { stage }),
    setFast: value => { if (allowFast) pacer.setFast(value); },
    setAutoplan(script, enabled = true) {
      director = createAutoplan(script, { enabled });
      clients.broadcast();
    },
    enableAutoplan(value) { director.setEnabled(value); clients.broadcast(); },
    get transcript() { return transcript; },
    close() { clearInterval(broadcastTimer); pacer.close(); clients.close(); },
  };
}
import { EPS } from '../sim/common.js';

/** Headless script order is stable at equal times; Site remains under human control. */
export function createAutoplan(script = [], { enabled = script.length > 0 } = {}) {
  if (!Array.isArray(script)) throw new Error('Autoplan script must be an array');
  const commands = structuredClone(script).map((entry, index) => {
    if (!Number.isFinite(entry.t) || entry.t < 0 || !['plan', 'site', 'facilitator'].includes(entry.seat)
      || !entry.cmd || typeof entry.cmd.action !== 'string') throw new Error(`Invalid autoplan entry ${index + 1}`);
    return { ...entry, index };
  }).filter(entry => entry.seat !== 'site').sort((a, b) => a.t - b.t || a.index - b.index);
  let index = 0;
  return {
    get status() { return { enabled, nextT: commands[index]?.t ?? null }; },
    setEnabled(value) { enabled = Boolean(value); },
    reset() { index = 0; },
    advance(time, apply) {
      while (enabled && index < commands.length && commands[index].t <= time + EPS) {
        const { seat, cmd } = commands[index++];
        apply(seat, structuredClone(cmd));
      }
    },
  };
}
// WO-03: identical simulation ticks at full, office and test speeds.
export const STEP_DAYS = 0.01;
export const FULL_MS = 50;
export const SLOW_MS = 200;
export const FAST_MS = 2;
export const STATE_MS = 250;
// WO-03 rejection 1: bound catch-up after a stalled callback.
const MAX_CATCH_UP_STEPS = 20;

export function createPacer(getSim, afterTick, {
  now = () => performance.now(), setTimer = setTimeout, clearTimer = clearTimeout,
} = {}) {
  let timer, fast = false, closed = false;
  let currentSim, stepMs, accountedAt;
  function interval(sim) {
    if (closed || sim.done || sim.speed === 'paused') return null;
    return fast ? FAST_MS : sim.speed === 'slow' ? SLOW_MS : FULL_MS;
  }
  function schedule() {
    clearTimer(timer);
    const sim = getSim();
    const nextMs = interval(sim);
    // Commands at the same speed must not discard partial steps; pauses and new runs must.
    if (sim !== currentSim || nextMs !== stepMs) {
      currentSim = sim; stepMs = nextMs; accountedAt = now();
    }
    if (stepMs === null) return;
    timer = setTimer(() => {
      const elapsed = now() - accountedAt;
      const due = Math.floor(elapsed / stepMs);
      // Retain the fractional step, but drop excess backlog after a long stall.
      accountedAt += due * stepMs;
      for (let i = 0; i < Math.min(due, MAX_CATCH_UP_STEPS); i++) {
        sim.tick(STEP_DAYS);
        afterTick();
        // A tick can fire an event or finish the stage before the batch ends.
        if (getSim() !== sim || interval(sim) !== stepMs) break;
      }
      schedule();
    }, Math.max(0, stepMs - (now() - accountedAt)));
  }
  return {
    sync: schedule,
    setFast(value) { fast = value; schedule(); },
    close() { closed = true; clearTimer(timer); },
  };
}
import { createServer } from 'node:http';
import { readFile, stat } from 'node:fs/promises';
import { mkdirSync, writeFileSync } from 'node:fs';
import { dirname, extname, isAbsolute, relative, resolve, sep } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { loadCatalog } from '../common/catalog.js';
import { loadScenario } from '../scenario/load.js';
import { WebSocketServer, WebSocket } from 'ws';
import { createHost, roundedJSON } from './core.js';

const ROOT = fileURLToPath(new URL('../../../', import.meta.url));
const WEB = resolve(ROOT, 'Monitor/web');
const VOICE = resolve(ROOT, 'Voice');
const OUT = resolve(ROOT, 'Monitor/out');
// Docs/PROTOCOL.md default HTTP and WebSocket port.
const DEFAULT_PORT = 7331;
const MIME = { '.html': 'text/html; charset=utf-8', '.wav': 'audio/wav', '.ico': 'image/x-icon', '.js': 'text/javascript', '.json': 'application/json' };

export async function startHost({ scenarioPath, stage2Path, autoplanPath, port = DEFAULT_PORT, testMode = process.env.NODE_ENV === 'test' }) {
  const catalog = loadCatalog();
  const base = process.env.INIT_CWD || process.cwd();
  const scenario = loadScenario(resolve(base, scenarioPath), { catalog });
  const stage2 = loadScenario(stage2Path ? resolve(base, stage2Path)
    : resolve(dirname(resolve(base, scenarioPath)), 'stage2_texas.json'), { catalog });
  const autoplan = autoplanPath ? JSON.parse(await readFile(resolve(base, autoplanPath), 'utf8')) : [];
  const core = createHost({ scenario, catalog, stages: [stage2], autoplan, allowFast: testMode,
    onTranscript(transcript) {
      mkdirSync(OUT, { recursive: true });
      const stamp = new Date().toISOString().replaceAll(':', '-');
      writeFileSync(resolve(OUT, `${transcript.scenario}.${stamp}.json`), roundedJSON(transcript));
    },
  });
  const server = createServer(async (req, res) => {
    try {
      if (!['GET', 'HEAD'].includes(req.method)) { res.writeHead(405).end(); return; }
      const pathname = decodeURIComponent(new URL(req.url, 'http://localhost').pathname);
      if (pathname === '/transcript.json') {
        res.writeHead(200, { 'Content-Type': 'application/json',
          'Content-Disposition': `attachment; filename="${core.transcript.scenario}.json"` });
        res.end(req.method === 'HEAD' ? undefined : roundedJSON(core.transcript)); return;
      }
      const voice = pathname.startsWith('/Voice/');
      const root = voice ? VOICE : WEB;
      const path = resolve(root, voice ? pathname.slice('/Voice/'.length) : `.${pathname === '/' ? '/plan.html' : pathname}`);
      const rel = relative(root, path);
      if (rel.startsWith(`..${sep}`) || rel === '..' || isAbsolute(rel) || !(await stat(path)).isFile()) {
        res.writeHead(404).end(); return;
      }
      res.writeHead(200, { 'Content-Type': MIME[extname(path)] ?? 'application/octet-stream', 'Cache-Control': 'no-store' });
      res.end(req.method === 'HEAD' ? undefined : await readFile(path));
    } catch { res.writeHead(404).end(); }
  });
  const wss = new WebSocketServer({ server, path: '/ws' });
  wss.on('connection', socket => {
    socket.on('error', error => console.error('WebSocket:', error.message));
    core.attach({
      send(message) { if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify(message)); },
      onMessage(receive) {
        socket.on('message', raw => {
          let message;
          try { message = JSON.parse(raw); } catch { return; }
          receive(message);
        });
      },
      onClose(callback) { socket.on('close', callback); },
      close() { socket.terminate(); },
    });
  });
  try {
    await new Promise((ready, reject) => { server.once('error', reject); server.listen(port, ready); });
  } catch (error) { core.close(); wss.close(); throw error; }
  return { server, core, port: server.address().port,
    close() { core.close(); wss.close(); return new Promise(done => server.close(done)); },
  };
}

async function main(args) {
  const [scenarioPath, ...options] = args;
  if (!scenarioPath || scenarioPath.startsWith('--')) throw new Error('Usage: node server.js <scenario.json> [--port 7331] [--stage2 <scenario.json>] [--autoplan <script.json>]');
  const config = { scenarioPath };
  for (let i = 0; i < options.length; i++) {
    if (options[i] === '--port' && options[i + 1]) config.port = Number(options[++i]);
    else if (options[i] === '--stage2' && options[i + 1]) config.stage2Path = options[++i];
    else if (options[i] === '--autoplan' && options[i + 1]) config.autoplanPath = options[++i];
    else throw new Error(`Unknown or incomplete option: ${options[i]}`);
  }
  const host = await startHost(config);
  console.log(`LOB host listening on ${host.port}`);
  for (const signal of ['SIGINT', 'SIGTERM']) process.once(signal, () => host.close().then(() => process.exit(0)));
}
if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
  main(process.argv.slice(2)).catch(error => { console.error(error.message); process.exitCode = 1; });
}

