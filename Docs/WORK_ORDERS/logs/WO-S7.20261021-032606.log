+LobGuide.attach(socket,'rules',message=>{highlighted=message.rulesSection;if(highlighted)selectSection(highlighted);});
+socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'rules',client:'web'}));
+socket.onclose=()=>{$('connection').textContent='Disconnected';};
+function selectSection(id){
+  selected=id;
+  for(const button of $('sections').children){button.setAttribute('aria-pressed',String(button.dataset.section===id));button.dataset.highlight=String(button.dataset.section===highlighted);}
+  for(const section of $('manual-content').children)section.hidden=section.id!==id;
+}
+async function acceptKit(message){
+  kit=message;selected=highlighted??kit.manualPages[0];
+  $('title').textContent=kit.title+' / Rules';
+  $('job-sign').textContent=`${kit.job.sign.cityCode} · ${kit.job.sign.pipe} · ${kit.job.sign.contractDays} contract days · ${kit.job.lengthFt} ft`;
+  $('sections').innerHTML=kit.manualPages.map(id=>`<button data-section="${esc(id)}">${esc(labels[id]??id)}</button>`).join('');
+  $('sections').onclick=e=>{if(e.target.dataset.section)selectSection(e.target.dataset.section);};
+  $('cards').innerHTML=kit.permits.cards.map(card=>`<article class="card"><h3>Permit · Zone ${card.zone}</h3><div>${esc(card.number)}</div><b class="code">${esc(card.code)}</b><small>Check the digits before you read it.</small></article>`).join('')+
+    kit.inspections.cards.map(card=>`<article class="card"><h3>Inspection · Zone ${card.zone}</h3><b class="code">${esc(card.number)}</b><small>Check the digits before you read it.</small>${kit.inspections.checklist.map(item=>`<label><input type="checkbox"> ${esc(item)}</label>`).join('')}<label>Rules signature<input type="text" aria-label="Rules signature zone ${card.zone}"></label></article>`).join('');
+  // Paper/make_kit.py uses 500 ft station labels and these four authored day boxes.
+  const stationEveryFt=500,stations=[];
+  for(let ft=0;ft<=kit.job.lengthFt;ft+=stationEveryFt)stations.push(`<span>${Math.floor(ft/100)}+${String(ft%100).padStart(2,'0')}</span>`);
+  $('stations').innerHTML=stations.join('');
+  $('day-boxes').innerHTML='<thead><tr><th>Day</th>'+kit.job.zones.map(z=>`<th>Zone ${z.id}<br>${z.fromFt/100}+00 – ${z.toFt/100}+00</th>`).join('')+'</tr></thead><tbody>'+['Permit day','Pipe complete day','Inspection day','Backfill day'].map(label=>`<tr><th>${label}</th>${kit.job.zones.map(z=>`<td><input type="text" aria-label="${label} zone ${z.id}"></td>`).join('')}</tr>`).join('')+'</tbody>';
+  $('manual-content').replaceChildren();$('manual-status').textContent='Loading manual';selectSection(selected);
+  try{
+    const response=await fetch(`manual/${encodeURIComponent(kit.stage)}.html`);if(!response.ok)throw new Error('Field manual unavailable');
+    const documentSource=new DOMParser().parseFromString(await response.text(),'text/html');
+    if(kit!==message)return;
+    $('manual-content').replaceChildren(...[...documentSource.querySelectorAll('main > section')].map(section=>document.importNode(section,true)));
+    $('manual-status').textContent='';selectSection(selected);
+  }catch(error){if(kit===message)$('manual-status').textContent=error.message;}
+}
+socket.onmessage=event=>{
+  const message=JSON.parse(event.data);
+  if(message.t==='welcome'){$('connection').textContent=message.mirror?'Mirror · read only':'Connected';state=message.state;}
+  else if(message.t==='state')state=message;
+  else if(message.t==='kit')acceptKit(message);
+  else if(message.t==='nack')$('feedback').textContent=message.reason;
+  if(state)$('today').textContent=`Day ${state.view.displayDay} · ${state.view.speed}`;
+};
+</script></body></html>
