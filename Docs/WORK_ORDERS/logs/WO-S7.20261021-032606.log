</style></head><body><header><div><div class="eyebrow">LOB, Over / Session controls</div><h1 id="title">Facilitator</h1></div><small id="connection">Connecting</small></header><main>
<section class="panel showcase"><div class="setup"><h2>Showcase session</h2>
<label>Scenario <select id="scenario"><option value="slice_texas">Slice &middot; Texas</option><option value="stage1_texas">Stage 1 &middot; Texas</option><option value="stage2_texas">Stage 2 &middot; Texas</option></select></label>
<label><input id="autoplan" type="checkbox" checked>Autoplan</label>
