+}
+async function acceptKit(message){
+  kit=message;selected=highlighted??kit.manualPages[0];
+  $('title').textContent=kit.title+' / Rules';
+  $('job-sign').textContent=`${kit.job.sign.cityCode} · ${kit.job.sign.pipe} · ${kit.job.sign.contractDays} contract days · ${kit.job.lengthFt} ft`;
+  $('sections').innerHTML=kit.manualPages.map(id=>`<button data-section="${esc(id)}">${esc(labels[id]??id)}</button>`).join('');
+  $('sections').onclick=e=>{if(e.target.dataset.section)selectSection(e.target.dataset.section);};
+  $('cards').innerHTML=kit.permits.cards.map(card=>`<article class="card"><h3>Permit · Zone ${card.zone}</h3><div>${esc(card.number)}</div><b class="code">${esc(card.code)}</b><small>Check the digits before you read it.</small></article>`).join('')+
+    kit.inspections.cards.map(card=>`<article class="card"><h3>Inspection · Zone ${card.zone}</h3><b class="code">${esc(card.number)}</b><small>Check the digits before you read it.</small>${kit.inspections.checklist.map(item=>`<label><input type="checkbox"> ${esc(item)}</label>`).join('')}<label>Rules signature<input type="text" aria-label="Rules signature zone ${card.zone}"></label></article>`).join('');
