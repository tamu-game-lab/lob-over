+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOB · Rules</title><style>
+:root{font:15px/1.5 system-ui,sans-serif;color:#283942;background:#eeeae2}*{box-sizing:border-box}body{margin:0}header{padding:18px 26px;background:#303c48;color:white;display:flex;justify-content:space-between;gap:15px}h1{font-size:21px;margin:0}h2{font-size:19px}h3{font-size:17px}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase}main{max-width:1500px;margin:auto;padding:20px}.panel{padding:18px;background:#fffdf8;border:1px solid #c7cec9;margin-bottom:18px}.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,1fr);gap:18px}button,input{font:inherit;padding:9px;border:1px solid #8b999f;background:#fffdf8;border-radius:3px;color:inherit}button{cursor:pointer}#sections{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}#sections [aria-pressed=true]{background:#324f60;color:white}#sections [data-highlight=true]{outline:3px solid #a78042;outline-offset:2px}#manual-content section[hidden]{display:none}#manual-content h2{margin-top:0}table{border-collapse:collapse;width:100%}th,td{border:1px solid #bac6ca;text-align:left;vertical-align:top;padding:8px}.table-scroll{overflow:auto}li{margin:7px 0}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{border:1px solid #98a9af;padding:14px;overflow-wrap:anywhere}.card h3{margin:0 0 6px}.code{font:700 25px ui-monospace,monospace;display:block;margin:10px 0}.card label{display:block;margin:8px 0;font-size:13px}.card input[type=text]{width:100%}.card small{display:block}#ledger input{width:100%;min-width:60px}#ledger .stations{display:flex;justify-content:space-between;min-width:500px;font:12px ui-monospace,monospace;padding:12px 0}#ledger table{min-width:500px}#job-sign{margin-bottom:18px}#manual-status{white-space:pre-line}@media(max-width:850px){.layout{grid-template-columns:1fr}main{padding:12px}header{padding:14px}.cards{grid-template-columns:1fr 1fr}}
+</style></head><body><header><div><div class="eyebrow">LOB, Over / Spec keeper</div><h1 id="title">Rules</h1></div><div><div id="today"></div><small id="connection">Connecting</small></div></header>
+<main><div class="panel" id="job-sign"></div><div class="layout"><section class="panel"><h2>Field manual</h2><nav id="sections" aria-label="Manual sections"></nav><p id="manual-status" role="status"></p><div id="manual-content"></div></section><aside><section class="panel"><h2>Permit and inspection cards</h2><div id="cards" class="cards"></div></section><section class="panel" id="ledger"><h2>Zone ledger</h2><p>Notes stay on this page.</p><div class="table-scroll"><div class="stations" id="stations"></div><table id="day-boxes"></table></div></section></aside></div><p id="feedback" role="status"></p></main>
+<script src="lib/transport.js"></script><script src="lib/guide.js"></script><script>
+'use strict';
+const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const labels={front_rule:'Front page rule',city_texas:'Texas',indicators:'Indicators',P1:'P1',A2:'A2',permits_holdpoints:'Permits and hold points',lookup:'Lookup',procedures:'Procedures'};
+let state,kit,selected,highlighted;
