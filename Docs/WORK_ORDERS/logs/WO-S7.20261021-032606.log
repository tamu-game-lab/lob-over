export function publicOrder(order) {
  // The radio log carries the issued instruction, not whether the crew obeyed it.
  return { id: order.id, op: order.op, crew: order.crew, issuedDay: order.issuedT,
    landsDay: order.landsT, status: order.status };
}

export function planView(s) {
  return {
    plannedLines: s.plannedLines,
    responses: availableResponses(s).map(({ event, option }) => ({ key: option.key, label: option.label,
      cost: option.cost, eventTitle: event.card.title })),
    reportedLines: s.reportedLines,
    budget: { budgetUsd: s.scenario.plan.budgetUsd, spentUsd: s.spentUsd, committedUsd: s.spentUsd,
      deadlineDay: s.scenario.plan.deadlineDay, promisedDay: s.scenario.plan.promisedFinishDay },
    inbox: s.inbox, radioLog: s.orders.map(publicOrder),
    catalog: { machines: Object.fromEntries(Object.entries(s.catalog.machines).filter(([key]) => !key.startsWith('_'))
      .map(([key, machine]) => [key, { ...clean(machine), leadDays: { normal: machine.leadDays.normal
        + s.catalog.cities[s.scenario.city].leadDelayDays } }])), protection: clean(s.catalog.protection) },
    permits: s.scenario.job.zones.map(z => ({ zone: z.id, entered: s.permits[z.id].entered,
      ...(s.permits[z.id].entered ? { number: s.permits[z.id].number } : {}) })),
    inspections: s.scenario.job.zones.map(z => ({ zone: z.id, cleared: s.inspections[z.id].cleared })),
    flags: s.flags, draft: [],
    uncertainty: Object.fromEntries(CREW_IDS.map(id => {
      const report = s.reportedLines[id].at(-1);
      const estimate = report.ft + plannedRate(s.plannedLines[id], s.t)
        * Math.max(0, s.t - Math.max(report.t, s.plannedLines[id].startDay - 1));
      const band = s.t <= report.t + EPS ? 0 : s.scenario.rules.uncertaintyBandFt;
      return [id, { estimateFt: Math.min(s.scenario.job.lengthFt, estimate),
        fromFt: Math.max(0, estimate - band), toFt: Math.min(s.scenario.job.lengthFt, estimate + band), asOfT: report.t }];
    })), pmLines: s.pmLines,
  };
}

export function siteView(s) {
  const trench = [];
  for (let ft = 0; ft <= s.scenario.job.lengthFt; ft += s.scenario.job.stationEveryFt) trench.push(trenchAt(s, ft));
  const localEvent = s.events.find(e => e.fired && !e.resolved
    && (e.zone == null || e.zone === zoneAt(s, s.truck.stationFt)?.id || e.inspected));
  return {
    truck: { stationFt: s.truck.stationFt, moving: s.truck.moving, dismounted: s.truck.dismounted },
    crews: CREW_IDS.map(id => { const c = s.crews[id], size = s.catalog.machines[c.machine]?.sizeClass;
      return { id, stationFt: c.pos, status: c.status, machinePlate: size ? size[0].toUpperCase() + size.slice(1) : null, moodLevel: c.mood }; }),
    trench, boards: s.scenario.job.zones.map(z => ({ zone: z.id,
      permitNumber: s.permits[z.id].entered ? s.permits[z.id].number : null,
      inspectionNumber: s.inspections[z.id].cleared ? s.inspections[z.id].number : null })),
    sky: sky(s), gate: { trucksWaiting: s.deliveries.filter(d => !d.arrived).length },
    activeEvent: localEvent ? { id: localEvent.id, card: localEvent.shownCard } : null,
    orders: s.orders.filter(order => order.crew && order.landedT != null && order.status !== 'sent' && order.status !== 'confirmed'
      && nearby(s, s.crews[order.crew].pos)).map(publicOrder),
  };
}

export function view(s, seat) {
  if (seat === 'plan') return copy(planView(s));
  if (seat === 'site') return copy(siteView(s));
  if (seat === 'facilitator') {
    const { messages, ...state } = s;
    return copy({ ...state, deviations: s.deviations.map(d => ({ ...d,
      state: !d.triggered ? 'armed' : d.caught ? 'caught' : 'missed' })), plan: planView(s), site: siteView(s) });
  }
  throw new Error('unknown seat');
}
// WO-02 crew order, precision, haul-road speed, proximity and mood conventions.
export const CREW_IDS = ['exc', 'pipe', 'back'];
export const LEADER = { pipe: 'exc', back: 'pipe' };
export const DT = 0.01;
export const EPS = 1e-6;
export const NEAR_FT = 100;
export const HAUL_FT_PER_HOUR = 1500;
export const HOURS_PER_DAY = 24;
export const MAX_MOOD = 3;
export const MOODS = ['calm', 'grumbling', 'angry', 'furious'];
// WO-02: conflicts look one day ahead; P1 durations round to half days.
export const CONFLICT_LOOKAHEAD_DAYS = 1;
export const CLEARING_DAY_STEP = 0.5;
export const travelDays = (a, b) => Math.abs(a - b) / HAUL_FT_PER_HOUR / HOURS_PER_DAY;
export const displayDay = t => Math.floor(t + EPS) + 1;
export const nextBoundary = t => Math.floor(t + EPS) + 1;
export const copy = value => JSON.parse(JSON.stringify(value));
export const zoneAt = (s, ft) => s.scenario.job.zones.find(z => ft >= z.fromFt
  && (ft < z.toFt || ft === s.scenario.job.lengthFt));
export const nearby = (s, ft) => s.truck.dismounted && !s.truck.moving
  && Math.abs(s.truck.stationFt - ft) <= NEAR_FT;
export const crewAt = s => CREW_IDS.map(id => s.crews[id])
  .filter(c => Math.abs(c.pos - s.truck.stationFt) <= NEAR_FT)
  .sort((a, b) => Math.abs(a.pos - s.truck.stationFt) - Math.abs(b.pos - s.truck.stationFt))[0];
export const protectionAt = (s, ft) => Number.isFinite(ft)
  ? s.protections.find(p => ft >= p.fromFt && ft <= p.toFt) : undefined;
export const activeCollapse = s => s.events.find(e => e.type === 'P1' && e.fired && !e.resolved);
export const emit = (s, type, fields) => s.messages.push({ t: type, v: 1, day: s.t, ...fields });

export function voice(s, trigger, seats, crewIds) {
  const lines = s.scenario.lines.filter(line => line.trigger === trigger
    && (!crewIds || crewIds.includes(line.speaker.replace('foreman_', ''))));
  if (!lines.length) return;
  emit(s, 'voice', { lineIds: lines.map(line => line.id), seats });
  s.pmLines.push(...lines.filter(line => line.speaker === 'pm').map(line => line.text));
import { EPS } from './common.js';
import { boundaryAllowance } from './deviations.js';

export function validatePermit(s, op) {
  const card = s.scenario.permits.cards.find(card => card.zone === op.zone);
  if (!card || card.code !== op.code) return 'code not on file';
  if (!s.permits[op.zone].entered && Object.values(s.permits).filter(p => p.entered && !p.signed).length
      >= s.scenario.permits.openZoneLimit) return `city limit: ${s.scenario.permits.openZoneLimit} zones open`;
}

export function validateInspection(s, op) {
  const card = s.scenario.inspections.cards.find(card => card.zone === op.zone);
  if (!card || card.number !== op.number) return 'code not on file';
}

export function excavationLimit(s, desired) {
  const zone = s.scenario.job.zones.find(z => !s.permits[z.id].entered);
  if (!zone) return s.scenario.job.lengthFt;
  let limit = zone.fromFt;
  if (desired >= limit - EPS && s.crews.exc.pos >= limit - EPS) limit = boundaryAllowance(s, zone);
  // An already excavated F2 stretch is never rolled back by a later gate calculation.
  return Math.max(s.crews.exc.pos, limit);
}

export function backfillLimit(s) {
  if (!s.scenario.inspections.required) return s.scenario.job.lengthFt;
  return s.scenario.job.zones.find(z => !s.inspections[z.id].cleared)?.toFt ?? s.scenario.job.lengthFt;
}

export function updateHoldPoints(s) {
  for (const zone of s.scenario.job.zones) {
    const inspection = s.inspections[zone.id];
    if (s.crews.back.pos >= zone.toFt - EPS) {
      if (!inspection.reported && s.scenario.inspections.required) {
        inspection.reported = true;
        // WO-02: both authored Texas stages return this compaction result.
        s.inbox.push({ day: s.t, from: 'City inspector', subject: `Zone ${zone.id} compaction`, body: 'passed' });
      }
      if (inspection.cleared || !s.scenario.inspections.required) s.permits[zone.id].signed = true;
    }
  }
}

export const finalInspectionEntered = s => !s.scenario.inspections.required
  || s.inspections[s.scenario.job.zones.at(-1).id].cleared;

