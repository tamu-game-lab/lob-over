export function createHost({ scenario, catalog, pacing = {}, autoplan = [], stages = [],
  allowFast = false, onTranscript = () => {} }) {
  const stageMap = new Map([scenario, ...stages].map(s => [s.id, s]));
  let director = createAutoplan(autoplan);
  const runs = new Map();
