+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { fileURLToPath } from 'node:url';
+import { loadCatalog, machine, protection, city } from '../src/common/catalog.js';
+
+test('default catalog contains the authored machines and Texas delay', () => {
+  const catalog = loadCatalog();
+  assert.equal(Object.keys(catalog.machines).length, 8);
+  assert.equal(catalog.machines.excavator_standard.rateFtPerDay, 220);
+  assert.equal(catalog.cities.texas.remobilizationDelayDays, 1);
+});
+
+test('catalog also loads from an explicit path', () => {
+  const path = fileURLToPath(new URL('../../Data/catalog.json', import.meta.url));
+  assert.deepEqual(loadCatalog(path), loadCatalog());
+});
+
+test('named helpers return the matching catalog entries', () => {
+  const catalog = loadCatalog();
+  assert.deepEqual(machine('excavator_standard'), catalog.machines.excavator_standard);
+  assert.deepEqual(protection('trench_box'), catalog.protection.trench_box);
+  assert.deepEqual(city('texas'), catalog.cities.texas);
+});
+
+test('all helpers reject unknown and inherited keys clearly', () => {
+  for (const [kind, lookup] of [['machine', machine], ['protection', protection], ['city', city]]) {
+    for (const key of ['missing', 'toString', '__proto__']) {
+      assert.throws(() => lookup(key), { message: `Unknown ${kind} key: "${key}"` });
+    }
+  }
+});
diff --git a/Monitor/test/rng.test.js b/Monitor/test/rng.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..5f91bff8c7035ed8b4f5f860e50dfcc293f24463
--- /dev/null
+++ b/Monitor/test/rng.test.js
@@ -0,0 +1,51 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { makeRng } from '../src/common/rng.js';
+
+test('same seed produces the same first 100 values in [0, 1)', () => {
+  const a = makeRng(1);
+  const b = makeRng(1);
+  for (let i = 0; i < 100; i++) {
+    const value = a.next();
+    assert.equal(value, b.next());
+    assert.ok(value >= 0 && value < 1);
+  }
+});
+
+test('different seeds produce different sequences', () => {
+  const a = makeRng(1);
+  const b = makeRng(2);
+  assert.notDeepEqual(Array.from({ length: 100 }, () => a.next()),
+    Array.from({ length: 100 }, () => b.next()));
+});
+
+test('JSON state round-trip resumes the sequence after mixed draws', () => {
+  const original = makeRng(0xffffffff);
+  original.next();
+  original.int(1, 6);
+  original.pick(['a', 'b', 'c']);
+  const saved = JSON.parse(JSON.stringify(original.state()));
+  const resumed = makeRng(saved);
+  assert.equal(resumed.state(), saved);
+  for (let i = 0; i < 100; i++) {
+    assert.equal(original.next(), resumed.next());
+    assert.equal(original.state(), resumed.state());
+  }
+});
+
+test('integer draws include both bounds and pick returns array members', () => {
+  const rng = makeRng(7);
+  const seen = new Set();
+  const choices = ['a', 'b', 'c'];
+  for (let i = 0; i < 100; i++) {
+    const value = rng.int(-1, 1);
+    assert.ok(Number.isInteger(value) && value >= -1 && value <= 1);
+    seen.add(value);
+    assert.ok(choices.includes(rng.pick(choices)));
+  }
+  assert.deepEqual(seen, new Set([-1, 0, 1]));
+  assert.equal(rng.int(4, 4), 4);
+  assert.equal(rng.pick(['only']), 'only');
+  assert.throws(() => rng.pick([]), /non-empty array/);
+  assert.throws(() => rng.int(2, 1), /bounds/);
+});
