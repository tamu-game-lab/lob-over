index 0000000000000000000000000000000000000000..43b58207ce21716a68f0f54e1d5287e5460b4afa
--- /dev/null
+++ b/Monitor/src/common/log.js
@@ -0,0 +1,18 @@
+import { format } from 'node:util';
+
+const LEVELS = ['debug', 'info', 'warn', 'error'];
+
+export function createLogger(level = 'info') {
+  const threshold = LEVELS.indexOf(level);
+  if (threshold === -1) {
+    throw new Error(`Unknown log level: "${level}"`);
+  }
+  return Object.fromEntries(LEVELS.map((name, index) => [name, (...args) => {
+    if (index >= threshold) {
+      // Keep stdout available for machine-readable command output.
+      process.stderr.write(`[${name}] ${format(...args)}\n`);
+    }
+  }]));
+}
+
+export const log = createLogger();
diff --git a/Monitor/src/common/rng.js b/Monitor/src/common/rng.js
new file mode 100644
index 0000000000000000000000000000000000000000..f20598cb81a8a871642db090f106ca7f65aeb09a
--- /dev/null
+++ b/Monitor/src/common/rng.js
@@ -0,0 +1,34 @@
+// Mulberry32 uses one unsigned 32-bit state word. Pass state() back to makeRng
+// to resume immediately after the last draw, including after JSON serialization.
+export function makeRng(seed) {
+  if (!Number.isInteger(seed) || seed < 0 || seed > 0xffffffff) {
+    throw new RangeError('RNG seed must be an unsigned 32-bit integer');
+  }
+  let current = seed;
+
+  function next() {
+    current = (current + 0x6d2b79f5) >>> 0;
+    let value = current;
+    value = Math.imul(value ^ (value >>> 15), value | 1);
+    value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
+    return ((value ^ (value >>> 14)) >>> 0) / 0x100000000;
+  }
+
+  // Both endpoints are inclusive so pick can address every array element.
+  function int(lo, hi) {
+    if (!Number.isSafeInteger(lo) || !Number.isSafeInteger(hi)
+        || lo > hi || !Number.isSafeInteger(hi - lo + 1)) {
+      throw new RangeError('RNG integer bounds must be ordered safe integers');
+    }
+    return lo + Math.floor(next() * (hi - lo + 1));
+  }
+
+  function pick(array) {
+    if (!Array.isArray(array) || array.length === 0) {
+      throw new RangeError('RNG pick requires a non-empty array');
+    }
+    return array[int(0, array.length - 1)];
+  }
+
+  return { next, int, pick, state: () => current };
+}
diff --git a/Monitor/src/common/units.js b/Monitor/src/common/units.js
new file mode 100644
index 0000000000000000000000000000000000000000..906d4ae83b73dbc9fcd9a7d069d4c96282137d66
--- /dev/null
+++ b/Monitor/src/common/units.js
@@ -0,0 +1,42 @@
+// Docs/PROTOCOL.md, Transport: station 7+20 represents 720 integer feet.
+const FEET_PER_STATION = 100;
+const STATION_REMAINDER_DIGITS = 2;
+// Docs/PROTOCOL.md, Transport: simulated day 0 starts display Day 1.
+const DISPLAY_DAY_OFFSET = 1;
+
+const usdFormatter = new Intl.NumberFormat('en-US', {
+  style: 'currency',
+  currency: 'USD',
+  // WO-00 specifies whole-dollar display, for example $278,400.
+  minimumFractionDigits: 0,
+  maximumFractionDigits: 0,
+});
+
+export function fmtStation(ft) {
+  if (!Number.isSafeInteger(ft) || ft < 0) {
+    throw new RangeError('Station feet must be a non-negative safe integer');
+  }
+  const station = Math.floor(ft / FEET_PER_STATION);
+  const remainder = String(ft % FEET_PER_STATION).padStart(STATION_REMAINDER_DIGITS, '0');
+  return `${station}+${remainder}`;
+}
+
+export function parseStation(station) {
+  if (typeof station !== 'string' || !/^\d+\+\d{2}$/.test(station)) {
+    throw new Error('Station must use the format 7+20');
+  }
+  const [whole, remainder] = station.split('+').map(Number);
+  const ft = whole * FEET_PER_STATION + remainder;
+  if (!Number.isSafeInteger(ft)) {
+    throw new RangeError('Station feet must be a safe integer');
+  }
+  return ft;
+}
+
+export function displayDay(t) {
+  return Math.floor(t) + DISPLAY_DAY_OFFSET;
+}
+
+export function fmtUsd(n) {
+  return usdFormatter.format(n);
+}
