from pathlib import Path
import re,struct
p=Path('Assets/LOBOver/Art/Generated/GroundRelief.asset').read_text()
print(p[:5500].split('m_IndexBuffer')[0])
vdata=re.search(r'_typelessdata: ([0-9a-f]+)',p).group(1)
n=int(re.search(r'm_VertexCount: (\\d+)',p).group(1))
b=bytes.fromhex(vdata);stride=len(b)//n
v=[struct.unpack_from('<3f',b,i*stride) for i in range(n)]
ib=bytes.fromhex(re.search(r'm_IndexBuffer: ([0-9a-f]+)',p).group(1));fmt='I' if 'm_IndexFormat: 1' in p else 'H'
ii=struct.unpack('<'+fmt*(len(ib)//struct.calcsize(fmt)),ib)
hits=[]
for i in range(0,len(ii),3):
 t=[v[j] for j in ii[i:i+3]]
 if max(x[0] for x in t)>0 and min(x[0] for x in t)<914 and min(x[2] for x in t)<0.599 and max(x[2] for x in t)>-0.599:hits.append(t)
print('vertices, stride, tris, cut overlaps:',n,stride,len(ii)//3,len(hits));print(hits[:2])
for path in ['Assets/Scenes/Play.unity','Assets/LOBOver/Art/Converted/Play_StationCell.prefab']:
 s=Path(path).read_text();blocks=re.split(r'(?=--- "'!u!)'"',s);gos={}
 for block in blocks:
  m=re.search(r'--- "'!u!1 &('"\\d+).*?m_Name: (.*)',block,re.S)
  if m:gos[m[1]]=m[2].splitlines()[0]
 for block in blocks:
  m=re.search(r'--- "'!u!4 &('"\\d+)',block);gid=re.search(r'm_GameObject: \\{fileID: (\\d+)\\}',block)
  if m and gid and gos.get(gid[1]) in ['Ground','SiteWorld','[LOBOver] Site','Walls','NearWall','FarWall','Surface','Floor','Pipes']:
   print(path,gos[gid[1]],block)
