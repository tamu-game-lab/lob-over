using System.Collections;
using System.Collections.Generic;
using System.Linq;
using LOBOver.Client;
using LOBOver.World;
using LOBOver.XR;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class WarpController : MonoBehaviour
    {
        public HostConnection connection;
        public XRRig rig;
        public HostWorldPresenter presenter;
        public Transform site;
        public GameObject hub, wrist;
        public Renderer sphere;
        public Material dissolveMaterial, fallbackMaterial;
        public bool Busy { get; private set; }
        public bool InSite { get; private set; }
        public double SelectedStation { get; private set; }
        // WO-L2: one-second dissolve; fallback totals 0.3 seconds.
        public const float DissolveSeconds = 1, FadeSeconds = 0.3f, SphereDiameter = 4;
        private Material effect;
        private bool dissolve;
        private readonly Dictionary<Animator, float> animatorSpeeds = new Dictionary<Animator, float>();
        private readonly List<ParticleSystem> particles = new List<ParticleSystem>();
        private readonly List<CrewRig> crews = new List<CrewRig>();
        private void Start()
        {
            rig.Resolve();
            site.gameObject.SetActive(false); wrist.SetActive(false); hub.SetActive(true);
            SetPassthrough(true);
            dissolve = dissolveMaterial != null && dissolveMaterial.shader != null && dissolveMaterial.shader.isSupported;
            var material = dissolve ? dissolveMaterial : fallbackMaterial;
            if (material != null) { effect = new Material(material); sphere.sharedMaterial = effect; }
            sphere.gameObject.SetActive(false);
        }
        public bool Visit(string crewId)
        {
            if (Busy || InSite || !connection.Connected || connection.Mirror || !rig.TryHeadPose(out var pose)) return false;
            var crew = connection.View?.crews.FirstOrDefault(c => c.id == crewId);
            if (crew == null) return false;
            SelectedStation = crew.stationFt;
            Busy = true;
            presenter.Present();
            var forward = Vector3.ProjectOnPlane(pose.rotation * Vector3.forward, Vector3.up).normalized;
            if (forward.sqrMagnitude < 0.1f) forward = Vector3.forward;
            // Road is +Z of the trench. Align -Z with gaze and put the road at the tracked feet.
            site.rotation = Quaternion.LookRotation(-forward);
            var feet = new Vector3(pose.position.x, 0, pose.position.z);
            var road = new Vector3((float)SelectedStation * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
            site.position = feet - site.rotation * road;
            StartCoroutine(Transition(true));
            _ = SendArrival(SelectedStation);
            return true;
        }
        private async System.Threading.Tasks.Task SendArrival(double station)
        {
            // Transport order is intentional; dismount waits for the host's moving flag to clear.
            // PROTOCOL.md retains the mounted travel precondition, even though Play has no truck presentation.
            if (connection.View?.truck.dismounted == true && !await connection.SendCommand("mount")) return;
            if (!await connection.SendCommand("moveTo", station)) return;
            arrivalPending = true;
        }
        private bool arrivalPending;
        private void Update()
        {
            if (!arrivalPending) return;
            if (!connection.Connected) { arrivalPending = false; return; }
            var truck = connection.View?.truck;
            if (truck != null && !truck.moving && System.Math.Abs(truck.stationFt - SelectedStation) < 0.1)
            { arrivalPending = false; _ = connection.SendCommand("dismount"); }
        }
        public bool Back()
        {
            if (Busy || !InSite) return false;
            Busy = true; StartCoroutine(Transition(false)); return true;
        }
        private IEnumerator Transition(bool entering)
        {
            presenter.Frozen = true;
            if (dissolve && effect != null)
            {
                effect.SetFloat("_Progress", entering ? 0 : 1);
                sphere.gameObject.SetActive(true); FollowHead();
                SetPassthrough(true);
                site.gameObject.SetActive(true);
                FreezeWorld(entering);
                var elapsed = 0f;
                while (elapsed < DissolveSeconds)
                {
                    effect.SetFloat("_Progress", entering ? elapsed / DissolveSeconds : 1 - elapsed / DissolveSeconds);
                    yield return null; elapsed += Time.unscaledDeltaTime;
                }
            }
            else
            {
                // Built-in serialized fallback reference survives shader stripping.
                if (effect == null) { Busy = false; presenter.Frozen = false; yield break; }
                sphere.gameObject.SetActive(true); FollowHead();
                FreezeWorld(entering);
                yield return Fade(0, 1);
                site.gameObject.SetActive(entering); SetPassthrough(!entering);
                yield return Fade(1, 0);
            }
            InSite = entering;
            SetPassthrough(!entering);
            site.gameObject.SetActive(entering); hub.SetActive(!entering); wrist.SetActive(entering);
            sphere.gameObject.SetActive(false);
            ThawWorld(); presenter.Frozen = false; presenter.Present(); Busy = false;
        }
        private IEnumerator Fade(float from, float to)
        {
            var elapsed = 0f;
            while (elapsed < FadeSeconds / 2)
            {
                effect.SetFloat("_Opacity", Mathf.Lerp(from, to, elapsed / (FadeSeconds / 2)));
                yield return null; elapsed += Time.unscaledDeltaTime;
            }
            effect.SetFloat("_Opacity", to);
        }
        private void LateUpdate() { if (Busy) FollowHead(); }
        private void FollowHead()
        {
            if (rig.ViewEye == null) return;
            sphere.transform.position = rig.ViewEye.position;
            sphere.transform.rotation = Quaternion.identity;
            if (dissolve && effect != null)
            {
                effect.SetFloat("_Bottom", rig.ViewEye.position.y - SphereDiameter / 2);
                effect.SetFloat("_Span", SphereDiameter);
            }
        }
        private void FreezeWorld(bool snap)
        {
            foreach (var crew in site.GetComponentsInChildren<CrewRig>(true))
                if (crew.enabled) { if (snap) crew.SnapPose(); crews.Add(crew); crew.enabled = false; }
            foreach (var animator in site.GetComponentsInChildren<Animator>(true))
            { animatorSpeeds[animator] = animator.speed; animator.speed = 0; }
            foreach (var particle in site.GetComponentsInChildren<ParticleSystem>(true))
                if (particle.isPlaying) { particles.Add(particle); particle.Pause(); }
        }
        private void ThawWorld()
        {
            foreach (var crew in crews) if (crew != null) crew.enabled = true;
            foreach (var pair in animatorSpeeds) if (pair.Key != null) pair.Key.speed = pair.Value;
            foreach (var particle in particles) if (particle != null && particle.gameObject.activeInHierarchy) particle.Play();
            crews.Clear(); animatorSpeeds.Clear(); particles.Clear();
        }
        private void SetPassthrough(bool value)
        {
            if (rig.Passthrough == null) return;
            rig.Passthrough.enabled = value; rig.Passthrough.hidden = !value;
        }
        private void OnDestroy() { if (effect != null) Destroy(effect); }
    }
}
using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using LOBOver.Editor;
using LOBOver.Sim;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using NUnit.Framework;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.TestTools;
using Object = UnityEngine.Object;

namespace LOBOver.Tests.Editor
{
    public sealed class SitePresentationTests
    {
        [Test]
        public void PlayRebuildHasIdenticalGeometryMaterialsAndArtBytes()
        {
            var scene = PlaySceneBuilder.Build(false);
            var first = Hierarchy(scene.GetRootGameObjects()); var files = ArtHashes();
            PlaySceneBuilder.Build(false);
            var secondFiles = ArtHashes();
            CollectionAssert.AreEqual(first, Hierarchy(scene.GetRootGameObjects()), "Owned hierarchy changed on second build");
            CollectionAssert.AreEquivalent(files.Keys, secondFiles.Keys, "Second build generated extra art");
            foreach (var pair in files) Assert.That(secondFiles[pair.Key], Is.EqualTo(pair.Value), pair.Key);
        }
        private static string[] Hierarchy(IEnumerable<GameObject> roots)
        {
            string PathOf(Transform t) => t.parent == null ? t.name : PathOf(t.parent) + "/" + t.name;
            return roots.Where(r => r.name.StartsWith("[LOBOver]", StringComparison.Ordinal)).SelectMany(r => r.GetComponentsInChildren<Transform>(true))
                .Select(t => PathOf(t) + "|" + t.localPosition.ToString("R") + "|" + t.localRotation.ToString("R") + "|" + t.localScale.ToString("R")
                    + "|" + t.gameObject.activeSelf + "|" + string.Join(",", t.GetComponents<Component>().Select(c => c == null ? "missing" : c.GetType().FullName))
                    + "|" + string.Join(",", t.GetComponents<Renderer>().SelectMany(r => r.sharedMaterials).Select(m => AssetDatabase.GetAssetPath(m))))
                .OrderBy(s => s, StringComparer.Ordinal).ToArray();
        }
        private static Dictionary<string, string> ArtHashes()
        {
            using var hash = SHA256.Create();
            return Directory.GetFiles(SiteAssetBuilder.Art, "*", SearchOption.AllDirectories)
                .Where(p => !p.EndsWith(".meta", StringComparison.Ordinal))
                .ToDictionary(p => p, p => Convert.ToBase64String(hash.ComputeHash(File.ReadAllBytes(p))));
        }
        [Test]
        public void EveryRuntimeSiteRendererUsesTexturedApprovedShader()
        {
            var scene = PlaySceneBuilder.Build(false);
            var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
            var world = site.GetComponentInChildren<SiteWorld>(true); Populate(world);
            Assert.That(scene.GetRootGameObjects().SelectMany(r => r.GetComponentsInChildren<Light>(true)).Count(l => l.enabled), Is.EqualTo(1));
            var shaders = new[] { "LOBOver/SiteLit", "LOBOver/SiteSky", "Universal Render Pipeline/Particles/Unlit" };
            foreach (var renderer in site.GetComponentsInChildren<Renderer>(true))
                foreach (var material in renderer.sharedMaterials)
                {
                    Assert.That(material, Is.Not.Null, renderer.name); Assert.That(material.shader, Is.Not.Null, material.name);
                    Assert.That(shaders, Does.Contain(material.shader.name), renderer.name + "/" + material.name);
                    if (material.shader.name != "LOBOver/SiteSky") Assert.That(material.mainTexture, Is.Not.Null, renderer.name + "/" + material.name);
                    Assert.That(ShaderUtil.GetShaderMessages(material.shader).Where(m => m.severity.ToString() == "Error"), Is.Empty, material.shader.name);
                }
            Assert.That(site.GetComponentsInChildren<Collider>(true).Where(c => c.enabled), Is.Empty);
            Assert.That(world.assets.tree == null || SiteModelBuilder.Triangles(world.assets.tree) < 8000, Is.True);
        }
        [Test]
        public void GroundAndPhysicalDetailsMatchTheSpecifiedDimensions()
        {
            var a = SitePresentationBuilder.BuildAssets();
            Assert.That(a.groundMesh.triangles.Length / 3, Is.LessThan(60000));
            Assert.That(a.groundMesh.bounds.size.x, Is.EqualTo(1200).Within(0.01));
            Assert.That(a.groundMesh.bounds.size.z, Is.EqualTo(200).Within(0.01));
            Assert.That(a.groundMesh.vertices.Max(v => v.y) - a.groundMesh.vertices.Min(v => v.y), Is.GreaterThan(0.1f));
            foreach (var vertex in a.groundMesh.vertices.Where(v => Mathf.Abs(v.z) > 12)) Assert.That(Mathf.Abs(vertex.y), Is.LessThanOrEqualTo(0.6f));
            Assert.That(SiteGeometryBuilder.Height(100, WorldUnits.RoadZ + 0.85f), Is.LessThan(SiteGeometryBuilder.Height(100, WorldUnits.RoadZ)));
            foreach (var c in a.groundMesh.colors) Assert.That(c.r + c.g + c.b, Is.EqualTo(1).Within(0.001));
            Assert.That(a.wallNearMesh.bounds.size.y, Is.EqualTo(1.8f).Within(0.001));
            Assert.That(a.stripMesh.bounds.size.z, Is.EqualTo(1.2f).Within(0.001));
            Assert.That(PrefabSize(a.worker).y, Is.EqualTo(1.8f).Within(0.01));
            var pipe = PrefabSize(a.pipe);
            Assert.That(Mathf.Max(pipe.y, pipe.z), Is.EqualTo(0.3f).Within(0.01));
            Assert.That(a.cellPrefab.water.transform.localPosition.y, Is.EqualTo(-1.5f).Within(0.001));
            Assert.That(a.cellPrefab.pipes.GetComponentsInChildren<MeshRenderer>(true).Length, Is.GreaterThan(1));
        }
        private static Vector3 PrefabSize(GameObject prefab)
        {
            var copy = Object.Instantiate(prefab);
            try { return SiteModelBuilder.Bounds(copy).size; }
            finally { Object.DestroyImmediate(copy); }
        }
        [Test]
        public void GeneratedMapsAreTileableAndImportedAsLinearDataExceptAlbedo()
        {
            // Exercise the fallback even on Bryan's machine where authored TerrainLayers exist.
            foreach (var kind in new[] { "Dirt", "Gravel", "Grass" }) SiteTextureBuilder.Generate(kind);
            SiteTextureBuilder.Dust();
            foreach (var path in Directory.GetFiles(SiteTextureBuilder.Folder, "*.png"))
            {
                var image = new Texture2D(2, 2, TextureFormat.RGBA32, false, true);
                try
                {
                    Assert.That(image.LoadImage(File.ReadAllBytes(path)), Is.True);
                    var pixels = image.GetPixels(); var size = image.width;
                    for (var i = 0; i < size; i++)
                    {
                        AssertChannels(pixels[i * size], pixels[i * size + size - 1], path);
                        AssertChannels(pixels[i], pixels[(size - 1) * size + i], path);
                    }
                    var importer = (TextureImporter)AssetImporter.GetAtPath(path.Replace('\\', '/'));
                    if (path.Contains("_Normal") || path.Contains("_Mask")) Assert.That(importer.sRGBTexture, Is.False, path);
                    var android = importer.GetPlatformTextureSettings("Android");
                    Assert.That(android.overridden, Is.True); Assert.That(android.format, Is.EqualTo(TextureImporterFormat.ASTC_6x6));
                }
                finally { Object.DestroyImmediate(image); }
            }
        }
        private static void AssertChannels(Color a, Color b, string context)
        { for (var channel = 0; channel < 4; channel++) Assert.That(Mathf.Abs(a[channel] - b[channel]), Is.LessThanOrEqualTo(0.02f), context); }

        [UnityTest]
        public IEnumerator PipeStationPreviewStaysInsideQuestBudget()
        {
            var scene = PlaySceneBuilder.Build(false); var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
            var world = site.GetComponentInChildren<SiteWorld>(true); Populate(world);
            var camera = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Preview").GetComponentInChildren<Camera>();
            var target = new RenderTexture(1440, 1440, 24, RenderTextureFormat.ARGB32);
            var oldTarget = camera.targetTexture; var oldPosition = camera.transform.position; var oldRotation = camera.transform.rotation;
            var otherCameras = scene.GetRootGameObjects().Where(r => r.name.StartsWith("[LOBOver]", StringComparison.Ordinal))
                .SelectMany(r => r.GetComponentsInChildren<Camera>(true)).Where(c => c != camera && c.enabled).ToArray();
            try
            {
                site.SetActive(true); foreach (var c in otherCameras) c.enabled = false;
                camera.targetTexture = target;
                var x = (float)world.Crew("pipe").StationFt * WorldUnits.MetresPerFoot;
                camera.transform.position = new Vector3(x, 1.65f, WorldUnits.RoadZ);
                camera.transform.rotation = Quaternion.LookRotation(new Vector3(0, -0.12f, -1));
                world.sky.observer = camera.transform;
                for (var i = 0; i < 3; i++) { camera.Render(); yield return null; }
                Debug.Log($"WO-L4 preview 1440x1440: {UnityStats.triangles} triangles, {UnityStats.drawCalls} draw calls.");
                Assert.That(UnityStats.triangles, Is.GreaterThan(0), "No Editor render statistics; run with the Game view visible.");
                Assert.That(UnityStats.drawCalls, Is.GreaterThan(0));
                Assert.That(UnityStats.triangles, Is.LessThan(300000)); Assert.That(UnityStats.drawCalls, Is.LessThan(150));
            }
            finally
            {
                camera.targetTexture = oldTarget; camera.transform.SetPositionAndRotation(oldPosition, oldRotation);
                foreach (var c in otherCameras) c.enabled = true;
                site.SetActive(false); Object.DestroyImmediate(target);
            }
        }
        private static void Populate(SiteWorld world)
        {
            var scenario = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json"));
            var transcript = JObject.Parse(File.ReadAllText("Data/transcripts/slice_play.json"));
            var snapshots = (JArray)transcript["snapshots"];
            var snapshot = snapshots.OfType<JObject>().FirstOrDefault(s => ((JArray)s["site"]["trench"]).OfType<JObject>().Any(t => (string)t["state"] == "piped"))
                ?? (JObject)snapshots[1];
            world.Configure((JObject)scenario["job"], 0); world.Apply(SiteView.From((JObject)snapshot["site"]), 4);
            foreach (var crew in WorldUnits.CrewIds) world.Crew(crew).SnapPose();
        }
    }
}

