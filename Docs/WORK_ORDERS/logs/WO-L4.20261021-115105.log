using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using LOBOver.Editor;
using LOBOver.Sim;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using NUnit.Framework;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.TestTools;
using Object = UnityEngine.Object;

namespace LOBOver.Tests.Editor
{
    public sealed class SitePresentationTests
    {
        [Test]
        public void PlayRebuildHasIdenticalGeometryMaterialsAndArtBytes()
        {
            var scene = PlaySceneBuilder.Build(false);
            var first = Hierarchy(scene.GetRootGameObjects()); var files = ArtHashes();
            PlaySceneBuilder.Build(false);
            var secondFiles = ArtHashes();
            CollectionAssert.AreEqual(first, Hierarchy(scene.GetRootGameObjects()), "Owned hierarchy changed on second build");
            CollectionAssert.AreEquivalent(files.Keys, secondFiles.Keys, "Second build generated extra art");
            foreach (var pair in files) Assert.That(secondFiles[pair.Key], Is.EqualTo(pair.Value), pair.Key);
        }
        private static string[] Hierarchy(IEnumerable<GameObject> roots)
        {
            string PathOf(Transform t) => t.parent == null ? t.name : PathOf(t.parent) + "/" + t.name;
            return roots.Where(r => r.name.StartsWith("[LOBOver]", StringComparison.Ordinal)).SelectMany(r => r.GetComponentsInChildren<Transform>(true))
                .Select(t => PathOf(t) + "|" + t.localPosition.ToString("R") + "|" + t.localRotation.ToString("R") + "|" + t.localScale.ToString("R")
                    + "|" + t.gameObject.activeSelf + "|" + string.Join(",", t.GetComponents<Component>().Select(c => c == null ? "missing" : c.GetType().FullName))
                    + "|" + string.Join(",", t.GetComponents<Renderer>().SelectMany(r => r.sharedMaterials).Select(m => AssetDatabase.GetAssetPath(m))))
                .OrderBy(s => s, StringComparer.Ordinal).ToArray();
        }
        private static Dictionary<string, string> ArtHashes()
        {
            using var hash = SHA256.Create();
            return Directory.GetFiles(SiteAssetBuilder.Art, "*", SearchOption.AllDirectories)
                .Where(p => !p.EndsWith(".meta", StringComparison.Ordinal))
                .ToDictionary(p => p, p => Convert.ToBase64String(hash.ComputeHash(File.ReadAllBytes(p))));
        }
        [Test]
        public void EveryRuntimeSiteRendererUsesTexturedApprovedShader()
        {
            var scene = PlaySceneBuilder.Build(false);
            var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
            var world = site.GetComponentInChildren<SiteWorld>(true); Populate(world);
            Assert.That(scene.GetRootGameObjects().SelectMany(r => r.GetComponentsInChildren<Light>(true)).Count(l => l.enabled), Is.EqualTo(1));
            var shaders = new[] { "LOBOver/SiteLit", "LOBOver/SiteSky", "Universal Render Pipeline/Particles/Unlit" };
            foreach (var renderer in site.GetComponentsInChildren<Renderer>(true))
                foreach (var material in renderer.sharedMaterials)
                {
                    Assert.That(material, Is.Not.Null, renderer.name); Assert.That(material.shader, Is.Not.Null, material.name);
                    Assert.That(shaders, Does.Contain(material.shader.name), renderer.name + "/" + material.name);
                    if (material.shader.name != "LOBOver/SiteSky") Assert.That(material.mainTexture, Is.Not.Null, renderer.name + "/" + material.name);
                    Assert.That(ShaderUtil.GetShaderMessages(material.shader).Where(m => m.severity.ToString() == "Error"), Is.Empty, material.shader.name);
                }
            Assert.That(site.GetComponentsInChildren<Collider>(true).Where(c => c.enabled), Is.Empty);
            Assert.That(world.assets.tree == null || SiteModelBuilder.Triangles(world.assets.tree) < 8000, Is.True);
        }
        [Test]
        public void GroundAndPhysicalDetailsMatchTheSpecifiedDimensions()
        {
            var a = SitePresentationBuilder.BuildAssets();
            Assert.That(a.groundMesh.triangles.Length / 3, Is.LessThan(60000));
            Assert.That(a.groundMesh.bounds.size.x, Is.EqualTo(1200).Within(0.01));
            Assert.That(a.groundMesh.bounds.size.z, Is.EqualTo(200).Within(0.01));
            Assert.That(a.groundMesh.vertices.Max(v => v.y) - a.groundMesh.vertices.Min(v => v.y), Is.GreaterThan(0.1f));
            foreach (var vertex in a.groundMesh.vertices.Where(v => Mathf.Abs(v.z) > 12)) Assert.That(Mathf.Abs(vertex.y), Is.LessThanOrEqualTo(0.6f));
            Assert.That(SiteGeometryBuilder.Height(100, WorldUnits.RoadZ + 0.85f), Is.LessThan(SiteGeometryBuilder.Height(100, WorldUnits.RoadZ)));
            foreach (var c in a.groundMesh.colors) Assert.That(c.r + c.g + c.b, Is.EqualTo(1).Within(0.001));
            Assert.That(a.wallNearMesh.bounds.size.y, Is.EqualTo(1.8f).Within(0.001));
            Assert.That(a.stripMesh.bounds.size.z, Is.EqualTo(1.2f).Within(0.001));
            Assert.That(PrefabSize(a.worker).y, Is.EqualTo(1.8f).Within(0.01));
            var pipe = PrefabSize(a.pipe);
            Assert.That(Mathf.Max(pipe.y, pipe.z), Is.EqualTo(0.3f).Within(0.01));
            Assert.That(a.cellPrefab.water.transform.localPosition.y, Is.EqualTo(-1.5f).Within(0.001));
            Assert.That(a.cellPrefab.pipes.GetComponentsInChildren<MeshRenderer>(true).Length, Is.GreaterThan(1));
        }
        private static Vector3 PrefabSize(GameObject prefab)
        {
            var copy = Object.Instantiate(prefab);
            try { return SiteModelBuilder.Bounds(copy).size; }
            finally { Object.DestroyImmediate(copy); }
        }
        [Test]
        public void GeneratedMapsAreTileableAndImportedAsLinearDataExceptAlbedo()
        {
            // Exercise the fallback even on Bryan's machine where authored TerrainLayers exist.
            foreach (var kind in new[] { "Dirt", "Gravel", "Grass" }) SiteTextureBuilder.Generate(kind);
            SiteTextureBuilder.Dust();
            foreach (var path in Directory.GetFiles(SiteTextureBuilder.Folder, "*.png"))
            {
                var image = new Texture2D(2, 2, TextureFormat.RGBA32, false, true);
                try
                {
                    Assert.That(image.LoadImage(File.ReadAllBytes(path)), Is.True);
                    var pixels = image.GetPixels(); var size = image.width;
                    for (var i = 0; i < size; i++)
                    {
                        AssertChannels(pixels[i * size], pixels[i * size + size - 1], path);
                        AssertChannels(pixels[i], pixels[(size - 1) * size + i], path);
                    }
                    var importer = (TextureImporter)AssetImporter.GetAtPath(path.Replace('\\', '/'));
                    if (path.Contains("_Normal") || path.Contains("_Mask")) Assert.That(importer.sRGBTexture, Is.False, path);
                    var android = importer.GetPlatformTextureSettings("Android");
                    Assert.That(android.overridden, Is.True); Assert.That(android.format, Is.EqualTo(TextureImporterFormat.ASTC_6x6));
                }
                finally { Object.DestroyImmediate(image); }
            }
        }
        private static void AssertChannels(Color a, Color b, string context)
        { for (var channel = 0; channel < 4; channel++) Assert.That(Mathf.Abs(a[channel] - b[channel]), Is.LessThanOrEqualTo(0.02f), context); }

        [UnityTest]
        public IEnumerator PipeStationPreviewStaysInsideQuestBudget()
        {
            var scene = PlaySceneBuilder.Build(false); var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
            var world = site.GetComponentInChildren<SiteWorld>(true); Populate(world);
            var camera = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Preview").GetComponentInChildren<Camera>();
            var target = new RenderTexture(1440, 1440, 24, RenderTextureFormat.ARGB32);
            var oldTarget = camera.targetTexture; var oldPosition = camera.transform.position; var oldRotation = camera.transform.rotation;
            var otherCameras = scene.GetRootGameObjects().Where(r => r.name.StartsWith("[LOBOver]", StringComparison.Ordinal))
                .SelectMany(r => r.GetComponentsInChildren<Camera>(true)).Where(c => c != camera && c.enabled).ToArray();
            try
            {
                site.SetActive(true); foreach (var c in otherCameras) c.enabled = false;
                camera.targetTexture = target;
                var x = (float)world.Crew("pipe").StationFt * WorldUnits.MetresPerFoot;
                camera.transform.position = new Vector3(x, 1.65f, WorldUnits.RoadZ);
                camera.transform.rotation = Quaternion.LookRotation(new Vector3(0, -0.12f, -1));
                world.sky.observer = camera.transform;
                for (var i = 0; i < 3; i++) { camera.Render(); yield return null; }
                Debug.Log($"WO-L4 preview 1440x1440: {UnityStats.triangles} triangles, {UnityStats.drawCalls} draw calls.");
                Assert.That(UnityStats.triangles, Is.GreaterThan(0), "No Editor render statistics; run with the Game view visible.");
                Assert.That(UnityStats.drawCalls, Is.GreaterThan(0));
                Assert.That(UnityStats.triangles, Is.LessThan(300000)); Assert.That(UnityStats.drawCalls, Is.LessThan(150));
            }
            finally
            {
                camera.targetTexture = oldTarget; camera.transform.SetPositionAndRotation(oldPosition, oldRotation);
                foreach (var c in otherCameras) c.enabled = true;
                site.SetActive(false); Object.DestroyImmediate(target);
            }
        }
        private static void Populate(SiteWorld world)
        {
            var scenario = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json"));
            var transcript = JObject.Parse(File.ReadAllText("Data/transcripts/slice_play.json"));
            var snapshots = (JArray)transcript["snapshots"];
            var snapshot = snapshots.OfType<JObject>().FirstOrDefault(s => ((JArray)s["site"]["trench"]).OfType<JObject>().Any(t => (string)t["state"] == "piped"))
                ?? (JObject)snapshots[1];
            world.Configure((JObject)scenario["job"], 0); world.Apply(SiteView.From((JObject)snapshot["site"]), 4);
            foreach (var crew in WorldUnits.CrewIds) world.Crew(crew).SnapPose();
        }
    }
}
param([string]$UnityData = 'C:/Program Files/Unity/Hub/Editor/6000.3.8f1/Editor/Data')
$ErrorActionPreference = 'Stop'
$projectRoot = (Resolve-Path (Join-Path $PSScriptRoot '../../..')).Path
Set-Location -LiteralPath $projectRoot
$scratch = Join-Path $PSScriptRoot '.offline'
New-Item -ItemType Directory -Path $scratch -Force | Out-Null
$generated = [System.Collections.Generic.List[string]]::new()
$script:compiledCount = 0
function Compile-Assembly([string]$name, [string]$folder, [string[]]$references, [string]$defines = 'UNITY_EDITOR;UNITY_6000_3_OR_NEWER;UNITY_INCLUDE_TESTS') {
    # Match Unity's declared assembly graph; a broad compiler reference set can hide missing asmdef references.
    $definition = Get-ChildItem -LiteralPath $folder -Filter '*.asmdef' | Select-Object -First 1
    if ($definition) {
        $asm = Get-Content -LiteralPath $definition.FullName -Raw | ConvertFrom-Json
        $references = @($baseReferences)
        if (!$asm.noEngineReferences) { $references += $engineReferences }
        foreach ($dependency in $asm.references) {
            $compiled = Join-Path $scratch ($dependency + '.dll')
            $androidDependency = Join-Path $scratch ($dependency + '.Android.dll')
            if ($defines -match 'UNITY_ANDROID' -and $defines -notmatch 'UNITY_EDITOR' -and (Test-Path -LiteralPath $androidDependency)) { $compiled = $androidDependency }
            $references += $(if (Test-Path -LiteralPath $compiled) { $compiled } else { 'Library/ScriptAssemblies/' + $dependency + '.dll' })
        }
        if ($asm.optionalUnityReferences -contains 'TestAssemblies') {
            $references += 'Library/ScriptAssemblies/UnityEngine.TestRunner.dll', 'Library/ScriptAssemblies/UnityEditor.TestRunner.dll'
        }
        if ($asm.precompiledReferences -contains 'nunit.framework.dll') {
            $references += (Get-ChildItem 'Library/PackageCache/com.unity.ext.nunit*/net40/unity-custom/nunit.framework.dll').FullName
        }
    }
    $output = Join-Path $scratch ($name + '.dll')
    $response = Join-Path $scratch ($name + '.rsp')
    $generated.Add($output)
    $generated.Add($response)
    $argsForCompiler = @('-nologo', '-target:library', '-langversion:9', '-nostdlib+', ('-define:' + $defines), ('-out:"' + $output + '"'))
    foreach ($reference in $references) { $argsForCompiler += '-r:"' + $reference + '"' }
    foreach ($source in (Get-ChildItem -LiteralPath $folder -Recurse -Filter '*.cs' | Where-Object { $folder -notmatch 'Runtime/(VR|MR|Start)$' -or $_.FullName -notmatch '[\\/]Editor[\\/]' })) { $argsForCompiler += '"' + $source.FullName + '"' }
    $argsForCompiler | Set-Content -LiteralPath $response -Encoding UTF8
    & (Join-Path $UnityData 'NetCoreRuntime/dotnet.exe') (Join-Path $UnityData 'DotNetSdkRoslyn/csc.dll') ('@' + $response)
    if ($LASTEXITCODE -ne 0) { throw "Offline compilation failed: $name" }
    $script:compiledCount++
    Write-Output "$name`: 0 errors"
}
try {
    $baseReferences = @((Join-Path $UnityData 'NetStandard/ref/2.1.0/netstandard.dll'))
    $baseReferences += (Get-ChildItem (Join-Path $UnityData 'NetStandard/compat/2.1.0/shims/netfx') -Filter '*.dll').FullName
    $jsonDll = (Get-ChildItem 'Library/PackageCache/com.unity.nuget.newtonsoft-json*/Runtime/Newtonsoft.Json.dll').FullName
    $baseReferences += $jsonDll
    $sdkAssemblies = @(Get-ChildItem 'Library/ScriptAssemblies/Oculus.Interaction*.dll', 'Library/ScriptAssemblies/Meta.XR.BuildingBlocks*.dll')
    $sdkPackages = @(Get-ChildItem 'Library/PackageCache' -Directory | Where-Object Name -Like 'com.meta.xr.sdk.interaction*')
    $sdkSources = @(Get-ChildItem $sdkPackages.FullName -Recurse -Filter '*.cs')
    foreach ($required in @('PointableCanvas.cs', 'RayInteractable.cs', 'PokeInteractable.cs', 'FirstPersonLocomotor.cs', 'CharacterController.cs', 'PlayerLocomotor.cs')) {
        if (!($sdkSources | Where-Object Name -EQ $required)) { throw "Missing installed Interaction SDK source: $required" }
    }
    if ($sdkAssemblies.Count -eq 0) { throw 'Missing imported Interaction SDK / Building Blocks assemblies' }
    Write-Output "SDK inputs: $($sdkAssemblies.Count) imported assemblies; $($sdkSources.Count) installed package sources (no restore)."
    $engineReferences = (Get-ChildItem (Join-Path $UnityData 'Managed/UnityEngine') -Filter '*.dll').FullName
    Compile-Assembly 'LOBOver.Sim' 'Assets/LOBOver/Sim' $baseReferences
    Compile-Assembly 'LOBOver.Client' 'Assets/LOBOver/Runtime/Client' $baseReferences
    Compile-Assembly 'LOBOver.Client.Android' 'Assets/LOBOver/Runtime/Client' $baseReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    $runtimeReferences = $baseReferences + $engineReferences + @((Join-Path $scratch 'LOBOver.Sim.dll'))
    Compile-Assembly 'LOBOver.Director' 'Assets/LOBOver/Runtime/Director' $runtimeReferences
    $worldReferences = $runtimeReferences + @((Join-Path $scratch 'LOBOver.Director.dll'), 'Library/ScriptAssemblies/Unity.TextMeshPro.dll', 'Library/ScriptAssemblies/Unity.InputSystem.dll', 'Library/ScriptAssemblies/UnityEngine.UI.dll')
    Compile-Assembly 'LOBOver.XR' 'Assets/LOBOver/Runtime/XR' $worldReferences
    Compile-Assembly 'LOBOver.XR.Android' 'Assets/LOBOver/Runtime/XR' $worldReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    Compile-Assembly 'LOBOver.World' 'Assets/LOBOver/Runtime/World' $worldReferences
    # Compile the conditional Android reader too, without opening the Editor or changing build settings.
    Compile-Assembly 'LOBOver.Director.Android' 'Assets/LOBOver/Runtime/Director' $runtimeReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    Compile-Assembly 'LOBOver.World.Android' 'Assets/LOBOver/Runtime/World' $worldReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    Compile-Assembly 'LOBOver.Play' 'Assets/LOBOver/Runtime/Play' $worldReferences
    Compile-Assembly 'LOBOver.Play.Android' 'Assets/LOBOver/Runtime/Play' $worldReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    # SDK assemblies are already installed/imported; this check never restores packages.
    $xrReferences = $worldReferences + @((Join-Path $scratch 'LOBOver.World.dll'),
        'Library/ScriptAssemblies/Oculus.VR.dll', 'Library/ScriptAssemblies/Unity.XR.OpenXR.dll',
        'Library/ScriptAssemblies/Unity.XR.Management.dll')
    foreach ($assembly in @('VR', 'MR', 'Start')) {
        $folder = 'Assets/LOBOver/Runtime/' + $assembly
        if (!(Test-Path -LiteralPath $folder)) { continue }
        Compile-Assembly ('LOBOver.' + $assembly) $folder $xrReferences
        Compile-Assembly ('LOBOver.' + $assembly + '.Android') $folder $xrReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
        $xrReferences += (Join-Path $scratch ('LOBOver.' + $assembly + '.dll'))
    }
    $editorReferences = $worldReferences + @((Join-Path $scratch 'LOBOver.World.dll'), 'Library/ScriptAssemblies/Unity.RenderPipelines.Core.Runtime.dll')
    Compile-Assembly 'LOBOver.Editor' 'Assets/LOBOver/Editor' $editorReferences
    $xrEditorReferences = $xrReferences + $editorReferences + @((Join-Path $scratch 'LOBOver.Editor.dll'),
        'Library/ScriptAssemblies/Unity.XR.Management.Editor.dll', 'Library/ScriptAssemblies/Unity.XR.OpenXR.Editor.dll',
        'Library/ScriptAssemblies/Unity.XR.OpenXR.Features.MetaQuestSupport.dll')
    Compile-Assembly 'LOBOver.XR.Editor' 'Assets/LOBOver/Runtime/Start/Editor' $xrEditorReferences
    $testReferences = $xrEditorReferences + @((Join-Path $scratch 'LOBOver.Editor.dll'), 'Library/ScriptAssemblies/UnityEngine.TestRunner.dll', 'Library/ScriptAssemblies/UnityEditor.TestRunner.dll')
    $testReferences += (Get-ChildItem 'Library/PackageCache/com.unity.ext.nunit*/net40/unity-custom/nunit.framework.dll').FullName
    Compile-Assembly 'LOBOver.EditModeTests' 'Assets/LOBOver/Tests/EditMode' $testReferences
    Compile-Assembly 'LOBOver.PlayModeTests' 'Assets/LOBOver/Tests/PlayMode' $testReferences
    Write-Output "PASS: $script:compiledCount offline assembly compilations; Unity import, tests and rendering still require the Editor."
    $fixtureProgram = Join-Path $scratch 'VerifyFixtures.dll'
    $fixtureResponse = Join-Path $scratch 'VerifyFixtures.rsp'
    $fixtureConfig = Join-Path $scratch 'VerifyFixtures.runtimeconfig.json'
    $fixtureJson = Join-Path $scratch 'Newtonsoft.Json.dll'
    foreach ($file in @($fixtureProgram, $fixtureResponse, $fixtureConfig, $fixtureJson)) { $generated.Add($file) }
    $fixtureArgs = @('-nologo', '-target:exe', '-langversion:9', '-nostdlib+', ('-out:"' + $fixtureProgram + '"'), ('-r:"' + (Join-Path $scratch 'LOBOver.Sim.dll') + '"'))
    foreach ($reference in $baseReferences) { $fixtureArgs += '-r:"' + $reference + '"' }
    $fixtureArgs += '-r:"' + (Join-Path $scratch 'LOBOver.VR.dll') + '"'
    $fixtureArgs += '"' + (Join-Path $PSScriptRoot 'VerifyFixtures.cs.txt') + '"'
    $fixtureArgs += '"' + (Join-Path $PSScriptRoot 'VerifyPresenter.cs.txt') + '"'
    $fixtureArgs += '"' + (Join-Path $PSScriptRoot 'VerifyLevel1.cs.txt') + '"'
    $fixtureArgs += '"' + (Join-Path $projectRoot 'Assets/LOBOver/Runtime/Client/DiscoveryPacket.cs') + '"'
    $fixtureArgs += '"' + (Join-Path $projectRoot 'Assets/LOBOver/Runtime/Client/VoiceTurn.cs') + '"'
    $fixtureArgs | Set-Content -LiteralPath $fixtureResponse -Encoding UTF8
    & (Join-Path $UnityData 'NetCoreRuntime/dotnet.exe') (Join-Path $UnityData 'DotNetSdkRoslyn/csc.dll') ('@' + $fixtureResponse)
    if ($LASTEXITCODE -ne 0) { throw 'Fixture verifier did not compile' }
    Copy-Item -LiteralPath (Join-Path $UnityData 'DotNetSdkRoslyn/csc.runtimeconfig.json') -Destination $fixtureConfig
    Copy-Item -LiteralPath $jsonDll -Destination $fixtureJson
    & (Join-Path $UnityData 'NetCoreRuntime/dotnet.exe') $fixtureProgram
    if ($LASTEXITCODE -ne 0) { throw 'Fixture replay failed' }
}
finally {
    # Only exact outputs from this invocation are removed; never traverse another workspace.
    foreach ($file in $generated) { if (Test-Path -LiteralPath $file) { Remove-Item -LiteralPath $file -Force } }
    if ((Get-ChildItem -LiteralPath $scratch -Force | Measure-Object).Count -eq 0) { Remove-Item -LiteralPath $scratch }
}

