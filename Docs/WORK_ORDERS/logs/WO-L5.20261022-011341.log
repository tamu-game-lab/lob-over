        }
        public static Mesh HeroPile()
        {
            // WO-L4 rejection 1 permits a builder mound with the scan's PBR maps.
            // 32 by 16 cells = 1,024 triangles, one metre tall like the accepted scan.
            const int along = 32, across = 16;
