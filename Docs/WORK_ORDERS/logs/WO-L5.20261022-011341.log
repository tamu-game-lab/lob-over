+                        var label = step.ToString("0.0#", CultureInfo.InvariantCulture);
+                        File.WriteAllBytes(Path.Combine(OutputFolder, "warp-" + label + ".png"), composite.EncodeToPNG());
+                    }
+                    finally { DestroyImmediate(frame); }
+                }
+            }
+            finally
