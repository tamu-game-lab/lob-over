diff --git a/Assets/LOBOver/Tests/CheckWarp.py b/Assets/LOBOver/Tests/CheckWarp.py
new file mode 100644
index 0000000000000000000000000000000000000000..dcb51d4fbc4e474f83690318609b4b242824a038
--- /dev/null
+++ b/Assets/LOBOver/Tests/CheckWarp.py
@@ -0,0 +1,19 @@
+"""WO-L5 source acceptance scan, runnable without Unity or additional dependencies."""
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parents[1]
+failures = []
+paths = sorted([*root.rglob("*.cs"), *root.rglob("*.shader")])
+sources = [p for p in paths if "Tests" not in p.relative_to(root).parts]
+for path in sources:
+    for number, line in enumerate(path.read_text(encoding="utf-8-sig").splitlines(), 1):
