        }
        public static Mesh Windrow()
        {
            var b = new MeshData(); const int steps = 30, cross = 6;
            for (var i = 0; i <= steps; i++) for (var j = 0; j <= cross; j++)
            {
                var x = (SpoilBreak - 1) * i / steps + 0.5f; var v = j / (float)cross;
