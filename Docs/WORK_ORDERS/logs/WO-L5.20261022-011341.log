+                        {
+                            var index = y * FrameSize + x;
+                            var wall = room.GetPixelBilinear((x + 0.5f) / FrameSize, (y + 0.5f) / FrameSize);
+                            pixels[index] = Composite(pixels[index], wall, QualitySettings.activeColorSpace == ColorSpace.Linear);
+                        }
