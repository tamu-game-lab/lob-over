main{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:20px;min-height:0}.board{min-width:0;min-height:0;position:relative;display:flex;flex-direction:column;background:var(--paper);background-image:radial-gradient(#80745418 .65px,transparent .65px);background-size:5px 5px;border:9px solid #a18b64;border-radius:3px;box-shadow:0 4px 12px #101a1d66,inset 0 0 0 1px #716648;padding:17px 17px 10px}.board:before,.board:after{position:absolute;top:-12px;width:42px;height:20px;content:"";background:linear-gradient(90deg,#939a91,#c9cec1 48%,#7a867f);border:1px solid #525e57;border-radius:3px;box-shadow:0 2px 3px #28333066}.board:before{left:25%}.board:after{right:25%}.eyebrow{text-transform:uppercase;letter-spacing:.19em;font-size:10px;font-weight:700;color:#6c715f}.board h2{font-size:clamp(20px,1.7vw,30px);margin:3px 0 8px}.legend{display:flex;gap:14px;align-items:center;font-size:10px;color:#626959;flex-wrap:wrap}.legend span{display:inline-flex;align-items:center;gap:5px}.legend i{width:21px;border-top:2px solid #626959}.legend .dashed{border-top-style:dashed}.legend .faint{opacity:.25}.chart-wrap{flex:1;min-height:0;position:relative;margin-top:8px}#chart{width:100%;height:100%;display:block;overflow:visible}#chart text{font:13px "Segoe UI",sans-serif;fill:#626959}#chart .zone-label{font-size:12px;letter-spacing:2px}#chart .day-label{font-size:12px}#ruler{transition:transform 400ms cubic-bezier(.2,.7,.3,1)}.ink-segment{animation:ink 400ms cubic-bezier(.22,.65,.35,1) both;stroke-dasharray:1;stroke-dashoffset:1}@keyframes ink{to{stroke-dashoffset:0}}
.stamp{position:absolute;top:22%;left:9%;right:9%;z-index:2;transform:rotate(-4deg);border:3px double #3f5148;background:#f4ecd9f5;padding:17px;text-align:center;box-shadow:3px 5px 0 #29343116;animation:stamp 300ms cubic-bezier(.2,.8,.3,1) both}.stamp #finish{font:600 clamp(18px,1.5vw,28px)/1.3 var(--display)}.stamp .eyebrow{margin-bottom:7px}.stamp #idle{display:flex;justify-content:center;gap:17px;margin-top:12px;padding-top:10px;border-top:1px solid #a4a78e;font-size:11px}.idle-count{display:block;font:600 23px var(--display);font-variant-numeric:tabular-nums}.idle-crew{border-top:3px solid var(--crew);padding-top:6px;min-width:85px}@keyframes stamp{from{opacity:0;transform:rotate(-4deg) scale(1.6)}to{opacity:1;transform:rotate(-4deg) scale(1)}}
.console{min-height:0;display:flex;flex-direction:column;padding:15px;background:linear-gradient(125deg,#344449,#202e32);border:1px solid #637174;border-radius:7px;box-shadow:inset 0 0 0 4px #243337,0 4px 12px #101a1d66;color:#eee8d7}.console-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;padding:0 3px}.console h2{font-size:16px;letter-spacing:.14em;text-transform:uppercase}.console-heading span{font-size:9px;letter-spacing:.17em;color:#b1bcb8}#crews{display:grid;gap:8px}.crew-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 143px;gap:12px;align-items:center;border:1px solid #65716e;border-left:6px solid var(--crew);border-radius:3px;padding:10px 12px;background:linear-gradient(105deg,#405055,#334247);box-shadow:0 2px 2px #101a1d55}.crew-name{font:600 17px/1.2 var(--display);color:var(--crew)}.foreman{font-size:12px;color:#f5efdf;margin-left:8px;font-weight:400}.crew-meta{font-size:11px;color:#c4ceca;margin-top:5px;white-space:nowrap}.crew-meta strong{font-weight:500;color:#fff2dc}.crew-switch{display:flex;position:relative;width:100%;padding:4px;border:1px solid #111e21;border-bottom:2px solid #70807d;border-radius:5px;background:#132126;color:#c1c8c2;box-shadow:inset 0 3px 4px #0008;font:600 12px var(--display)}.crew-switch:before{content:"";position:absolute;left:4px;top:4px;bottom:4px;width:calc(50% - 4px);background:linear-gradient(#ffc382,#df813b);border:1px solid #f8b77a;border-radius:3px;box-shadow:0 2px 3px #0007;transition:transform 120ms ease-out}.crew-switch[aria-checked="true"]:before{transform:translateX(100%)}.crew-switch span{width:50%;z-index:1;padding:7px 0}.crew-switch[aria-checked="false"] .go,.crew-switch[aria-checked="true"] .hold{color:#2b312e}.order-state{display:flex;justify-content:center;align-items:center;gap:5px;font-size:10px;margin-top:6px;min-height:14px;white-space:nowrap}.lamp{width:6px;height:6px;border-radius:50%;background:#a8b4af;box-shadow:0 0 4px #a8b4af66}.crew-