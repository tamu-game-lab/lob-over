.pm{display:flex;align-items:end;position:relative;flex:1;min-height:145px;margin-top:9px;border-top:1px solid #72807a;padding-top:7px;gap:8px}.portrait-frame{align-self:stretch;position:relative;width:39%;flex-shrink:0;overflow:hidden;background:radial-gradient(ellipse at bottom,#79897e80,transparent 70%)}#pm-portrait{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:185%;height:112%;object-fit:contain;object-position:center bottom}.pm-message{align-self:center;flex:1;min-width:0;padding-right:4px}.pm-label{color:#bdc8bf;font-size:10px;letter-spacing:.13em;text-transform:uppercase;margin-bottom:9px}.pm-label strong{display:block;color:#f0ead8;font:600 18px var(--display);letter-spacing:0;text-transform:none}#pm-bubble{position:relative;color:#35413a;background:#f4ecd9;padding:12px 14px;border-radius:4px;box-shadow:0 3px 0 #14212666;font-size:clamp(12px,.95vw,16px);line-height:1.45}#pm-bubble:before{content:"";position:absolute;left:-8px;bottom:15px;border-top:8px solid transparent;border-bottom:8px solid transparent;border-right:9px solid #f4ecd9}#feedback{position:absolute;left:15px;right:15px;bottom:9px;font-size:12px;background:#263638;color:#f1e2cb}#feedback:empty{display:none}
.reports{min-height:0;display:flex;gap:17px;background:#d7d0bb;border:1px solid #a5a88e;border-radius:3px;padding:12px 16px;box-shadow:0 3px 5px #111b1e66}.reports-heading{width:110px;flex-shrink:0;align-self:center}.reports h2{font-size:18px;line-height:1.15}.reports-heading p{font-size:10px;margin-top:6px;color:#626959}#reports{display:flex;gap:10px;flex:1;min-width:0;align-items:stretch;overflow:hidden;list-style:none;padding:0;margin:0}.report{flex:1;min-width:0;padding:8px 10px;background:#f7f0df;border-left:1px dashed #9f9d83;box-shadow:1px 2px 3px #797c6229;font-size:11px;line-height:1.55}.report-day{font:600 14px var(--display);display:block;border-bottom:1px solid #d8d7bf;margin-bottom:4px;padding-bottom:3px}.report-crew{display:block;white-space:nowrap}.report-crew:before{content:"";display:inline-block;width:4px;height:9px;background:var(--crew);margin-right:5px}.report-separator{display:none}.report-empty{font-size:12px;align-self:center;color:#717460}.report-new{outline:1px solid #a5a88e}
@media(min-width:1650px){body{grid-template-rows:105px minmax(0,1fr) 160px;gap:24px;padding:0 30px 24px}header{gap:30px}h1{font-size:32px}h1 small{font-size:13px}.connection{min-width:210px}.clock{font-size:14px}.site{font-size:13px}.console{padding:22px}.console-heading{margin-bottom:16px}#crews{gap:14px}.crew-card{padding:16px;grid-template-columns:minmax(0,1fr) 160px}.crew-name{font-size:22px}.foreman{font-size:15px}.crew-meta{font-size:14px}.order-state{font-size:12px}.crew-switch{font-size:15px}.pm{min-height:210px}.report{font-size:14px;padding:10px 14px}.report-day{font-size:17px}.reports-heading{width:145px}.reports h2{font-size:22px}.legend{font-size:12px}.board{padding:24px}.eyebrow{font-size:12px}}
</style></head>
<body>
<header>
  <div class="brand"><h1>LOB, Over <small>Level 1 Â· Texas water main</small></h1></div>
  <div class="calendar" id="calendar" aria-label="Day 1"><span>DAY</span><strong id="day">1</strong></div>
  <div class="connection"><div class="clock" id="clock" data-speed="paused" role="status">Paused</div><div class="site"><svg class="radio-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14v13H5zM8 8V2m3 10h5m-5 4h5M2 4v4m20-4v4"/></svg><span id="site-status">Waiting for the headset</span></div></div>
  <div class="header-actions"><a href="/level1/rules.pdf" target="_blank" rel="noopener">Rules page â†—</a><button class="mute" id="mute" aria-pressed="false" aria-label="Mute all sound">â™ª Mute</button><button class="main-button" id="start" disabled>Start</button></div>
</header>
<main>
  <section class="board" aria-labelledby="board-title"><div class="eyebrow">Site office / Line of balance</div><h2 id="board-title">The PM's plan: promised Day 18</h2>
    <div class="legend"><span><i class="dashed"></i>PM's plan</span><span><i></i><span id="actual-label">Reported through yesterday</span></span><span id="previous-label" hidden><i class="faint"></i>Previous run Â· 25%</span></div>
    <div class="chart-wrap"><svg id="chart" viewBox="0 0 1000 590" role="img" aria-label="Crew stations across from 0+00 to 30+00, days down"><g id="grid"></g><g id="previous-lines"></g><g id="planned-lines"></g><g id="reported-lines"></g><g id="ruler" hidden><rect x="65" y="-5" width="850" height="10" fill="#8c7958" fill-opacity=".18"/><path d="M65 0H915" stroke="#71634a" stroke-width="1.4"/><text id="today-label" x="928" y="4">Today</text></g></svg></div>
    <div class="stamp" id="result" hidden><div class="eyebrow">Run record</div><div id="finish"></div><div class="eyebrow" style="margin-top:12px">Idle crew-days</div><div id="idle"></div></div>
  </section>
  <aside class="console" aria-labelledby="console-title"><div class="console-heading"><h2 id="console-title">Crew radio</h2><span>PLAN / TRANSMIT</span></div><div id="crews"></div>
    <section class="pm" aria-label="Project manager"><div class="portrait-frame"><img id="pm-portrait" src="img/clipboard_Final.png" alt="The project manager holding a clipboard"></div><div class="pm-message"><div class="pm-label">From the site office<strong>The PM</strong></div><p id="pm-bubble" role="status" hidden></p></div><p id="feedback" role="status"></p></section>
  </aside>
</main>
<section class="reports" aria-labelledby="reports-title"><div class="reports-heading"><div class="eyebrow">Incoming</div><h2 id="reports-title">Daily reports</h2><p>Latest at the right â†’</p></div><ol id="reports" aria-live="polite"><li class="report-empty">Awaiting the first daily report.</li></ol></section>
<script src="lib/transport.js"></script><script src="lib/play-audio.js"></script>
<script>
'use strict';
const $=id=>document.getElementById(id), CREWS=['exc','pipe','back'];
// WO-L3: shared crew inks and presentation timings; none affect the host clock.
const COLORS={exc:'#E0A800',pipe:'#2E86C1',back:'#D35400'};
const TAPE_MS=3000, WORRIED_MS=4000, TYPE_MS=600, COUNT_MS=1000, REPORT_LIMIT=5;
// Docs/LEVEL1.md, The job: all three crews use one Standard machine.
const MACHINE='Standard', REPORT_NAMES={exc:'Excavation',pipe:'Pipe',back:'Backfill'};
const esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const station=ft=>Math.floor(ft/100)+'+'+String(Math.round(ft%100)).padStart(2,'0');
const number=value=>Math.round(value).toLocaleString('en-US');
let state, result, sequence=0, mirror=false, starting=false, connected=true, hasStarted=false;
let chartKey='', gridKey='', drawn={}, lastTotals={}, lastReportDay=0, voiceText='', worried=false, worriedTimer, countFrame;
const heldSince={}, pending=new Map(), switching=new Map(), tapeTimers=new Map(), typing=new Map();
const audio=LobOfficeAudio.create(text=>{voiceText=text;$('pm-bubble').textContent=text;$('pm-bubble').hidden=!text;portrait();});
const socket=LobTransport.connect();
socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'plan',client:'web'}));
socket.onclose=()=>{connected=false;starting=false;switching.clear();$('feedback').textContent='Connection to the game closed.';if(state)render();};
function send(t,action,fields={},onAck,crew){
  if(socket.readyState!==WebSocket.OPEN)return false;
  const id='l1-'+(++sequence);pending.set(id,{onAck,crew});
  socket.send(JSON.stringify({t,v:1,id,seat:'plan',action,...fields}));return true;
}
function portrait(){
  const name=worried?'worriedSurprise.png':voiceText?'explaining_Final.png':'clipboard_Final.png';
  const img=$('pm-portrait');if(!img.src.endsWith(name))img.src='img/'+name;
  img.alt=worried?'The project manager looking worried':voiceText?'The project manager speaking':'The project manager holding a clipboard';
}
$('mute').onclick=()=>{const muted=audio.toggleMute();$('mute').setAttribute('aria-pressed',String(muted));$('mute').setAttribute('aria-label',muted?'Unmute all sound':'Mute all sound');$('mute').textContent=muted?'â™ª Muted':'â™ª Mute';};
$('start').onclick=()=>{
  audio.sound('click');starting=true;$('start').disabled=true;$('feedback').textContent='';
  if(result)send('ctrl','reset',{},()=>send('ctrl','start'));
  else send('ctrl','start');
};
$('crews').onclick=event=>{
  const button=event.target.closest('[data-crew]'),crew=button?.dataset.crew;
  if(!crew||mirror||result||!connected||switching.has(crew))return;
  switching.set(crew,!state.view.held[crew]);renderCrews();audio.sound('switch');
  if(!send('cmd','commit',{ops:[{op:state.view.held[crew]?'resume':'hold',crew}]},null,crew)){switching.delete(crew);renderCrews();}
};
function makeCrews(){
  $('crews').innerHTML=state.view.crews.map(c=>`<article class="crew-card" id="crew-${c.id}" style="--crew:${COLORS[c.id]}"><div><div class="crew-name">${esc(c.name)}<span class="foreman">${esc(c.foreman)}</span></div><div class="crew-meta">${MACHINE} Â· <strong>${c.rate} ft / day</strong> Â· Start Day ${c.startDay}</div></div><div><button type="button" role="switch" class="crew-switch" data-crew="${c.id}" aria-label="Hold ${esc(c.name)}" aria-checked="false"><span class="go">GO</span><span class="hold">HOLD</span></button><div class="order-state"><i class="lamp" aria-hidden="true"></i><span id="order-${c.id}">Go</span></div></div><div class="refusal" id="refusal-${c.id}" role="status" hidden></div></article>`).join('');
}
function renderCrews(){
  for(const c of state.view.crews){
    const held=state.view.held[c.id],button=document.querySelector(`[data-crew="${c.id}"]`);
    if(held&&heldSince[c.id]===undefined)heldSince[c.id]=state.displayDay;
    if(!held)delete heldSince[c.id];
    button.setAttribute('aria-checked',String(switching.get(c.id)??held));
    button.disabled=mirror||!!result||!connected||switching.has(c.id);
    $('crew-'+c.id).dataset.held=String(held);
    $('order-'+c.id).textContent=held?'Holding since Day '+heldSince[c.id]:'Go';
  }
}
function drawChart(){
  const v=state.view,length=v.project.job.lengthFt,previous=result?result.previousRun?.lines.actual:v.previousRun;
  const actual=result?.lines.actual??v.reportedLines,planned=result?.lines.planned??v.plannedPolylines;
  const all=[...Object.values(actual).flat(),...Object.values(previous??{}).flat()];
  const maxDay=Math.max(v.promisedDay+3,state.displayDay,...all.map(p=>Math.ceil(p.t+1)));
  const x=ft=>65+ft/length*850,y=t=>38+t/(maxDay-1)*486;
  const nextGrid=JSON.stringify([length,maxDay,v.project.job.zones]);
  if(gridKey!==nextGrid){
    let grid=v.project.job.zones.map((z,i)=>`<rect x="${x(z.fromFt)}" y="38" width="${x(z.toFt)-x(z.fromFt)}" height="486" fill="${i%2?'#b3bea5':'#bda47b'}" opacity=".12"/><text class="zone-label" x="${x((z.fromFt+z.toFt)/2)}" y="18" text-anchor="middle">ZONE ${z.id}</text>`).join('');
    for(let ft=0;ft<=length;ft+=v.project.job.stationEveryFt){
      const major=ft%500===0;grid+=`<line x1="${x(ft)}" x2="${x(ft)}" y1="38" y2="524" stroke="#7f8870" stroke-opacity="${major?.3:.12}"/>`;
      if(major)grid+=`<text x="${x(ft)}" y="549" text-anchor="middle">${station(ft)}</text>`;
    }
    for(let day=1;day<=maxDay;day++)grid+=`<line x1="65" x2="915" y1="${y(day-1)}" y2="${y(day-1)}" stroke="#7f8870" stroke-opacity=".2"/><text class="day-label" x="49" y="${y(day-1)+4}" text-anchor="end">${day}</text>`;
    grid+=`<text x="19" y="18">DAY</text><text x="490" y="578" text-anchor="middle">STATION / FEET</text><path d="M65 ${y(v.promisedDay-1)}H915" stroke="#776c52" stroke-dasharray="3 5"/><text x="928" y="${y(v.promisedDay-1)+4}">${v.promisedDay}</text>`;
    $('grid').innerHTML=grid;gridKey=nextGrid;
  }
  const nextKey=JSON.stringify([nextGrid,planned,actual,previous]);
  if(chartKey!==nextKey){
    const line=(id,points,kind,opacity=1,extra='')=>points?.length>1?`<polyline data-line="${id}" data-kind="${kind}" points="${points.map(p=>`${x(p.ft)},${y(p.t)}`).join(' ')}" fill="none" stroke="${COLORS[id]}" stroke-width="${kind==='plan'?2.5:3.5}" stroke-linecap="round" stroke-linejoin="round" ${kind==='plan'?'stroke-dasharray="9 7"':''} opacity="${opacity}" ${extra}/>`:'';
    $('previous-lines').innerHTML=CREWS.map(id=>line(id,previous?.[id],'previous',.25)).join('');
    $('planned-lines').innerHTML=CREWS.map(id=>line(id,planned[id],'plan')).join('');
    $('reported-lines').innerHTML=CREWS.map(id=>{
      const points=actual[id],old=drawn[id]??[],extendsOld=old.length&&points.length>old.length&&old.every((p,i)=>p.t===points[i].t&&p.ft===points[i].ft);
      if(!result&&extendsOld)return line(id,old,'actual')+line(id,points.slice(old.length-1),'segment',1,'class="ink-segment" pathLength="1"');
      return line(id,points,'actual');
    }).join('');
    chartKey=nextKey;drawn=structuredClone(actual);
  }
  $('previous-label').hidden=!previous;$('ruler').toggleAttribute('hidden',!hasStarted);
  $('ruler').style.transform=`translateY(${y(state.displayDay-1)}px)`;
  $('today-label').textContent='Day '+state.displayDay;
}
function render(){
  const v=state.view,day=Number.isFinite(result?.finishDay)?Math.floor(result.finishDay+1e-6)+1:state.displayDay;
  if($('day').textContent!==String(day)){
    $('day').textContent=day;$('calendar').setAttribute('aria-label','Day '+day);
    $('calendar').classList.remove('flip');void $('calendar').offsetWidth;$('calendar').classList.add('flip');audio.sound('tick');
  }
  $('clock').textContent=state.speed==='slow'?'Field is slow today':state.speed==='paused'?'Paused':'Running';$('clock').dataset.speed=state.speed;
  $('site-status').textContent=v.siteClient==='quest'?'Headset connected':v.siteClient==='web'?'Site connected in a browser':'Waiting for the headset';
  $('actual-label').textContent=result?'Actual work':'Reported through yesterday';
  $('start').textContent=result?'Run again':'Start';$('start').disabled=!connected||mirror||starting||(!result&&state.speed!=='paused');
  $('board-title').textContent=hasStarted?'Texas water main Â· Crew reports':`The PM's plan: promised Day ${v.promisedDay}`;
  renderCrews();drawChart();
}
function resetPresentation(){
  result=null;hasStarted=false;drawn={};chartKey='';lastTotals={};lastReportDay=0;
  for(const crew of CREWS)delete heldSince[crew];
  pending.clear();switching.clear();for(const timer of tapeTimers.values())clearTimeout(timer);tapeTimers.clear();
  for(const frame of typing.values())cancelAnimationFrame(frame);typing.clear();
  clearTimeout(worriedTimer);cancelAnimationFrame(countFrame);worried=false;audio.reset();
  $('result').hidden=true;$('feedback').textContent='';$('reports').innerHTML='<li class="report-empty">Awaiting the first daily report.</li>';
}
function acceptState(message){
  const newRun=state?.runId!==message.runId,wasSlow=state?.speed==='slow';
  if(newRun)resetPresentation();
  state=message;if(newRun)makeCrews();
  if(state.speed!=='paused'){starting=false;hasStarted=true;}
  if(state.speed==='slow'&&!wasSlow){
    worried=true;portrait();audio.sound('hiss');clearTimeout(worriedTimer);
    worriedTimer=setTimeout(()=>{worried=false;portrait();},WORRIED_MS);
  }
  render();
}
function report(message){
  if(message.day<=lastReportDay)return;
  const pieces=[`Day ${message.day}`,...CREWS.map(id=>`${REPORT_NAMES[id]} +${number(message.feetByCrew[id]-(lastTotals[id]??0))} ft (${number(message.feetByCrew[id])})`)];
  lastTotals={...message.feetByCrew};lastReportDay=message.day;
  $('reports').querySelector('.report-empty')?.remove();$('reports').querySelector('.report-new')?.classList.remove('report-new');
  const item=document.createElement('li');item.className='report report-new';item.dataset.day=message.day;
  pieces.forEach((text,i)=>{const span=document.createElement('span');span.className=i?'report-crew':'report-day';if(i)span.style.setProperty('--crew',COLORS[CREWS[i-1]]);item.append(span);if(i<pieces.length-1){const separator=document.createElement('span');separator.className='report-separator';separator.textContent=' Â· ';item.append(separator);}});
  $('reports').append(item);
  while($('reports').children.length>REPORT_LIMIT){const oldest=$('reports').firstElementChild;cancelAnimationFrame(typing.get(oldest));typing.delete(oldest);oldest.remove();}
  const spans=[...item.querySelectorAll('.report-day,.report-crew')],total=pieces.join('').length,start=performance.now();let lastClick=-1;
  function type(now){
    let remaining=Math.floor(Math.min(1,(now-start)/TYPE_MS)*total);
    spans.forEach((span,i)=>{span.textContent=pieces[i].slice(0,Math.max(0,remaining));remaining-=pieces[i].length;});
    const click=Math.floor((now-start)/75);if(click!==lastClick){audio.sound('teletype');lastClick=click;}
    if(now-start<TYPE_MS)typing.set(item,requestAnimationFrame(type));else typing.delete(item);
  }
  typing.set(item,requestAnimationFrame(type));
}
function showResult(message){
  result=message;starting=false;$('result').hidden=false;
  $('finish').textContent=Number.isFinite(result.finishDay)?`Finished Day ${Math.floor(result.finishDay+1e-6)+1} Â· Promised Day ${result.promisedDay}`:`Run ended Â· Promised Day ${result.promisedDay}`;
  $('idle').innerHTML=state.view.crews.map(c=>`<div class="idle-crew" style="--crew:${COLORS[c.id]}">${esc(c.name)}<strong class="idle-count" id="idle-${c.id}">0</strong></div>`).join('');
  cancelAnimationFrame(countFrame);const start=performance.now();
  function count(now){const progress=Math.min(1,(now-start)/COUNT_MS);for(const id of CREWS)$('idle-'+id).textContent=Number((result.idleDays[id]*progress).toFixed(2));if(progress<1)countFrame=requestAnimationFrame(count);}
  countFrame=requestAnimationFrame(count);render();
}
socket.onmessage=event=>{
  const message=JSON.parse(event.data);
  if(message.t==='welcome'){mirror=message.mirror;acceptState(message.state);}
  else if(message.t==='state')acceptState(message);
  else if(message.t==='ack'||message.t==='nack'){
    const request=pending.get(message.id);pending.delete(message.id);
    if(request?.crew)switching.delete(request.crew);
    if(message.t==='nack'){
      starting=false;
      if(request?.crew){const tape=$('refusal-'+request.crew);tape.textContent=message.reason;tape.hidden=false;clearTimeout(tapeTimers.get(request.crew));tapeTimers.set(request.crew,setTimeout(()=>{tape.hidden=true;},TAPE_MS));}
      else $('feedback').textContent=message.reason;
      render();
    }else request?.onAck?.();
  }else if(message.t==='voice')audio.play(message,state.stage);
  else if(message.t==='report')report(message);
  else if(message.t==='result')showResult(message);
};
</script></body></html>

