using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.XR;
using Meta.XR.BuildingBlocks;
using Oculus.Interaction;
using Oculus.Interaction.Input;
using Oculus.Interaction.Locomotion;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace LOBOver.Editor
{
    public static class BuildingBlocksSetup
    {
        // SDK core and interaction.ovr Editor/BlockDataIds.cs; names alone never establish block presence.
        private const string InteractionId = "81f55626-5fad-45e9-a1df-184f330da7ba";
        public static readonly string[] DemoNames = { "[BuildingBlock] Cube", "Poke Interaction" };

        [MenuItem("LOB Over/Setup/Check Building Blocks")]
        public static void CheckMenu() => CheckPlay();

        public static bool CheckPlay()
        {
            if (!File.Exists(PlaySceneBuilder.ScenePath))
            { Debug.LogError("LOB Over: Assets/Scenes/Play.unity is missing; Bryan must save his Building Blocks scene there."); return false; }
            var scene = SceneManager.GetSceneByPath(PlaySceneBuilder.ScenePath);
            var preview = !scene.IsValid() || !scene.isLoaded;
            if (preview) scene = EditorSceneManager.OpenPreviewScene(PlaySceneBuilder.ScenePath);
            try { return Check(scene); }
            finally { if (preview) EditorSceneManager.ClosePreviewScene(scene); }
        }

        public static List<string> Missing(Scene scene)
        {
            var missing = new List<string>();
            var rig = XRRig.Components<OVRCameraRig>(scene).FirstOrDefault();
            var blocks = XRRig.Components<BuildingBlock>(scene);
            void Need(bool present, string name) { if (!present) missing.Add(name); }
            Need(rig != null && rig.centerEyeAnchor != null && rig.GetComponent<OVRManager>() != null, "Camera Rig");
            Need(XRRig.Components<OVRPassthroughLayer>(scene).Length > 0, "Passthrough");
            foreach (var side in new[] { Handedness.Left, Handedness.Right })
            {
                var controller = XRRig.Components<FromOVRControllerDataSource>(scene).Any(c => HasSide(c, side))
                    || XRRig.Components<OVRControllerHelper>(scene).Any(c => c.m_controller == (side == Handedness.Left ? OVRInput.Controller.LTouch : OVRInput.Controller.RTouch));
                Need(controller && rig != null && (side == Handedness.Left ? rig.leftControllerAnchor : rig.rightControllerAnchor) != null,
                    "Controller Tracking (" + side.ToString().ToLowerInvariant() + ")");
            }
            Need((blocks.Any(block => block.BlockId == InteractionId) || XRRig.Components<RayInteractor>(scene).Length > 0)
                && XRRig.Components<RayInteractor>(scene).Length > 0 && XRRig.Components<PokeInteractor>(scene).Length > 0, "Interactions Rig");
            foreach (var side in new[] { Handedness.Left, Handedness.Right })
            {
                var hand = XRRig.Components<FromOVRHandDataSource>(scene).Any(c => HasSide(c, side))
                    || XRRig.Components<OVRHand>(scene).Any(c => c.GetHand() == (side == Handedness.Left ? OVRPlugin.Hand.HandLeft : OVRPlugin.Hand.HandRight));
                Need(hand && rig != null && (side == Handedness.Left ? rig.leftHandAnchor : rig.rightHandAnchor) != null,
                    "Hand Tracking (" + side.ToString().ToLowerInvariant() + ")");
            }
            return missing;
        }
        private static bool HasSide(Component source, Handedness side)
        {
            using var serialized = new SerializedObject(source);
            return serialized.FindProperty("_handedness")?.intValue == (int)side;
        }
        public static bool Check(Scene scene, bool level1 = true)
        {
            var missing = Missing(scene);
            foreach (var name in new[] { "Camera Rig", "Passthrough", "Controller Tracking (left)", "Controller Tracking (right)",
                "Interactions Rig", "Hand Tracking (left)", "Hand Tracking (right)" })
            {
                if (missing.Contains(name)) Debug.LogError("LOB Over: MISSING " + name + "; add it from Building Blocks.");
                else Debug.Log("LOB Over: PRESENT " + name);
            }
            foreach (var layer in XRRig.Components<OVRPassthroughLayer>(scene))
                Debug.Log("LOB Over: Passthrough layer " + PathOf(layer.transform) + (layer.GetComponent<OVRCameraRig>() != null ? " (additional rig layer; preserved)" : ""));
            var forbidden = level1 ? Forbidden(scene) : new List<string>();
            foreach (var name in forbidden) Debug.LogError("LOB Over: remove " + name + " in the Building Blocks window before building Play.unity.");
            return missing.Count == 0 && forbidden.Count == 0;
        }
        public static List<string> Forbidden(Scene scene)
        {
            var result = new List<string>();
            if (XRRig.Components<BuildingBlock>(scene).Any(b => b.BlockId == XRRig.RealHandsId)
                || XRRig.Components<Transform>(scene).Any(t => t.name.IndexOf("Real Hands", StringComparison.OrdinalIgnoreCase) >= 0)) result.Add("Real Hands");
            if (XRRig.Components<Component>(scene).Any(c => c != null && c.GetType().Name == "EnableUnpremultipliedAlpha")) result.Add("EnableUnpremultipliedAlpha (Real Hands)");
            var layers = XRRig.Components<OVRPassthroughLayer>(scene);
            if (layers.Length > 1) result.Add("extra Passthrough layers: " + string.Join(", ", layers.Select(l => PathOf(l.transform))));
            result.AddRange(Demos(scene).Select(d => "demo " + PathOf(d.transform)));
            return result;
        }
        public static IEnumerable<GameObject> Demos(Scene scene) => XRRig.Components<Transform>(scene)
            .Where(t => DemoNames.Contains(t.name) || t.name.StartsWith("[BuildingBlock]", StringComparison.Ordinal)
                && t.name.IndexOf("demo", StringComparison.OrdinalIgnoreCase) >= 0).Select(t => t.gameObject);

        [MenuItem("LOB Over/Setup/Configure Building Blocks")]
        public static void ConfigureMenu()
        {
            if (!File.Exists(PlaySceneBuilder.ScenePath)) { CheckPlay(); return; }
            var scene = PlaySceneBuilder.OpenExisting();
            if (!Check(scene)) return;
            Configure(scene);
            EditorSceneManager.SaveScene(scene);
        }
        public static void Configure(Scene scene)
        {
            foreach (var component in XRRig.Components<Behaviour>(scene))
            {
                // Include the SDK's event broadcasters/connections: enabled listeners could still move a disabled locomotor.
                if (component != null && component.GetType().Namespace == "Oculus.Interaction.Locomotion" && BelongsToBlocks(component)) // missing-script components come back null
                {
                    if (component is FirstPersonLocomotor locomotor && locomotor.GravityFactor != 0)
                        Change(locomotor, "GravityFactor", locomotor.GravityFactor, 0f, () => locomotor.GravityFactor = 0);
                    if (component.enabled) Change(component, "enabled", true, false, () => component.enabled = false);
                }
            }
            foreach (var manager in XRRig.Components<OVRManager>(scene).Where(BelongsToBlocks))
            {
                if (manager.trackingOriginType != OVRManager.TrackingOrigin.FloorLevel)
                    Change(manager, "trackingOriginType", manager.trackingOriginType, OVRManager.TrackingOrigin.FloorLevel,
                        () => manager.trackingOriginType = OVRManager.TrackingOrigin.FloorLevel);
                if (!manager.isInsightPassthroughEnabled)
                    Change(manager, "isInsightPassthroughEnabled", false, true, () => manager.isInsightPassthroughEnabled = true);
            }
            foreach (var layer in XRRig.Components<OVRPassthroughLayer>(scene).Where(l => BelongsToBlocks(l) && l.GetComponent<OVRCameraRig>() == null)) // the Passthrough block's layer; the rig's own is an old-builder leftover
            {
                if (!layer.enabled) Change(layer, "enabled", false, true, () => layer.enabled = true);
                if (layer.hidden) Change(layer, "hidden", true, false, () => layer.hidden = false);
                // Installed SDK 207 SyncToOverlay always sets Underlay/int.MaxValue; it exposes no overlay-type field.
                Debug.Log("LOB Over: " + PathOf(layer.transform) + " uses SDK-enforced Underlay (SyncToOverlay); preserved.");
            }
            foreach (var rig in XRRig.Components<OVRCameraRig>(scene))
            {
                var camera = rig.centerEyeAnchor == null ? null : rig.centerEyeAnchor.GetComponent<Camera>();
                if (camera == null) continue;
                if (camera.clearFlags != CameraClearFlags.SolidColor)
                    Change(camera, "clearFlags", camera.clearFlags, CameraClearFlags.SolidColor, () => camera.clearFlags = CameraClearFlags.SolidColor);
                if (camera.backgroundColor != Color.clear)
                    Change(camera, "backgroundColor", camera.backgroundColor, Color.clear, () => camera.backgroundColor = Color.clear);
                if (camera.allowHDR) Change(camera, "allowHDR", true, false, () => camera.allowHDR = false);
            }
        }
        private static bool BelongsToBlocks(Component component) => component.GetComponentInParent<BuildingBlock>(true) != null
            || component.GetComponentInParent<OVRCameraRig>(true) != null;
        private static void Change(UnityEngine.Object target, string property, object before, object after, Action apply)
        {
            Undo.RecordObject(target, "Configure Building Blocks"); apply(); EditorUtility.SetDirty(target);
            var component = target as Component;
            var owner = component == null ? (GameObject)target : component.gameObject;
            PrefabUtility.RecordPrefabInstancePropertyModifications(target);
            EditorSceneManager.MarkSceneDirty(owner.scene);
            Debug.Log("LOB Over: " + PathOf(owner.transform) + "/" + target.GetType().Name + "." + property + ": " + before + " -> " + after);
        }
        private static string PathOf(Transform target) => target.parent == null ? target.name : PathOf(target.parent) + "/" + target.name;
    }
}
using LOBOver.XR;
using Oculus.Interaction;
using UnityEngine;
#if UNITY_EDITOR
using System;
using System.Collections;
using System.Globalization;
using System.IO;
using UnityEditor;
using UnityEngine.InputSystem;
#endif

namespace LOBOver.Play
{
    // The entire root is EditorOnly. Mouse clicks exercise the same ISDK event as a ray selection.
    public sealed class PlayPreview : MonoBehaviour
    {
        public Camera view;
        public XRRig rig;
        public CrewButton back;
        private void Start()
        {
#if UNITY_EDITOR
            if (OVRManager.isHmdPresent) gameObject.SetActive(false);
#else
            gameObject.SetActive(false);
#endif
        }
        private void Update()
        {
#if UNITY_EDITOR
            var mouse = Mouse.current; var keyboard = Keyboard.current;
            if (mouse == null) return;
            if (mouse.leftButton.wasPressedThisFrame && Physics.Raycast(view.ScreenPointToRay(mouse.position.ReadValue()), out var hit))
            {
                var button = hit.collider.GetComponentInParent<CrewButton>();
                if (button != null) Select(button);
            }
            if (keyboard != null && keyboard.bKey.wasPressedThisFrame && back.gameObject.activeInHierarchy) Select(back);
#endif
        }
        private static void Select(CrewButton button)
        {
            var ray = button.GetComponent<RayInteractable>();
            if (!button.Available || ray == null) return;
            var pose = new Pose(button.transform.position, button.transform.rotation);
            ray.PublishPointerEvent(new PointerEvent(-1, PointerEventType.Hover, pose));
            ray.PublishPointerEvent(new PointerEvent(-1, PointerEventType.Select, pose));
            ray.PublishPointerEvent(new PointerEvent(-1, PointerEventType.Unselect, pose));
            ray.PublishPointerEvent(new PointerEvent(-1, PointerEventType.Unhover, pose));
        }
#if UNITY_EDITOR
        // WO-L5 item 6 / WO-L4 preview resolution.
        public const int FrameSize = 1440;
        private static readonly float[] WarpSteps = { 0.2f, 0.45f, 0.7f, 0.9f, 1f };
        private static readonly string OutputFolder = "Monitor/out/unity";
        [MenuItem("LOB Over/Debug/Warp Frames")]
        public static void WarpFrames()
        {
            var preview = FindFirstObjectByType<PlayPreview>();
            if (!Application.isPlaying || preview == null)
                throw new InvalidOperationException("Warp Frames requires the Play scene in Play Mode.");
            var warp = preview.back.warp;
            if (warp.Busy) throw new InvalidOperationException("Wait for the current warp to finish before capturing Warp Frames.");
            if (!warp.InSite && !warp.Visit("pipe"))
                throw new InvalidOperationException("Warp Frames requires a connected Node host and Marcus's crew.");
            preview.StartCoroutine(preview.CaptureWhenReady(warp));
        }
        private IEnumerator CaptureWhenReady(WarpController warp)
        {
            while (warp.Busy) yield return null;
            if (!warp.InSite) yield break;
            WriteWarpFrames(warp);
        }
        public void WriteWarpFrames(WarpController warp)
        {
            Directory.CreateDirectory(OutputFolder);
            var roomPath = Path.Combine(OutputFolder, "room.png");
            EnsureRoom(roomPath);
            var room = new Texture2D(2, 2, TextureFormat.RGBA32, false);
            var composite = new Texture2D(FrameSize, FrameSize, TextureFormat.RGBA32, false);
            var progress = warp.Progress; var frozen = warp.presenter.Frozen;
            var hubVisible = warp.hub.activeSelf; var wristVisible = warp.wrist.activeSelf;
            try
            {
                if (!room.LoadImage(File.ReadAllBytes(roomPath))) throw new IOException("Cannot decode " + roomPath);
                warp.presenter.Frozen = true;
                // Capture the site eye buffer alone; the panel would occlude its lower centre.
                warp.hub.SetActive(false); warp.wrist.SetActive(false);
                foreach (var step in WarpSteps)
                {
                    warp.PreviewProgress(step);
                    var frame = CaptureFrame();
                    try
                    {
                        var pixels = frame.GetPixels();
                        for (var y = 0; y < FrameSize; y++) for (var x = 0; x < FrameSize; x++)
                        {
                            var index = y * FrameSize + x;
                            var wall = room.GetPixelBilinear((x + 0.5f) / FrameSize, (y + 0.5f) / FrameSize);
                            pixels[index] = Composite(pixels[index], wall, QualitySettings.activeColorSpace == ColorSpace.Linear);
                        }
                        composite.SetPixels(pixels); composite.Apply();
                        var label = step.ToString("0.0#", CultureInfo.InvariantCulture);
                        File.WriteAllBytes(Path.Combine(OutputFolder, "warp-" + label + ".png"), composite.EncodeToPNG());
                    }
                    finally { DestroyImmediate(frame); }
                }
            }
            finally
            {
                warp.PreviewProgress(progress); warp.presenter.Frozen = frozen;
                warp.hub.SetActive(hubVisible); warp.wrist.SetActive(wristVisible);
                DestroyImmediate(room); DestroyImmediate(composite);
            }
            Debug.Log("LOBOver Warp Frames: wrote 5 alpha composites to " + OutputFolder);
        }
        public Texture2D CaptureFrame()
        {
            var target = RenderTexture.GetTemporary(FrameSize, FrameSize, 24, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Linear);
            var previousTarget = view.targetTexture; var previousActive = RenderTexture.active;
            var previousHdr = view.allowHDR; var previousClear = view.clearFlags; var previousBackground = view.backgroundColor;
            var frame = new Texture2D(FrameSize, FrameSize, TextureFormat.RGBA32, false, true);
            try
            {
                view.allowHDR = false; view.clearFlags = CameraClearFlags.SolidColor; view.backgroundColor = Color.clear;
                view.targetTexture = target; view.Render(); RenderTexture.active = target;
                frame.ReadPixels(new Rect(0, 0, FrameSize, FrameSize), 0, 0); frame.Apply(); return frame;
            }
            catch { DestroyImmediate(frame); throw; }
            finally
            {
                view.targetTexture = previousTarget; view.allowHDR = previousHdr;
                view.clearFlags = previousClear; view.backgroundColor = previousBackground;
                RenderTexture.active = previousActive; RenderTexture.ReleaseTemporary(target);
            }
        }
        public static Color Composite(Color premultipliedFrame, Color roomSrgb, bool linear)
        {
            // The eye's RGB is already premultiplied: multiplying it by alpha again darkens the wire.
            var result = premultipliedFrame + (linear ? roomSrgb.linear : roomSrgb) * (1 - premultipliedFrame.a);
            if (linear) result = result.gamma;
            result.a = 1; return result;
        }
        private static void EnsureRoom(string path)
        {
            if (File.Exists(path)) return;
            // WO-L5: a mid-grey wall, 20 cm grid. Stand-in wall spans four metres.
            const float WallMetres = 4, GridMetres = 0.2f;
            var spacing = Mathf.RoundToInt(FrameSize * GridMetres / WallMetres);
            var image = new Texture2D(FrameSize, FrameSize, TextureFormat.RGBA32, false);
            try
            {
                var pixels = new Color32[FrameSize * FrameSize];
                for (var y = 0; y < FrameSize; y++) for (var x = 0; x < FrameSize; x++)
                {
                    var shade = (byte)(x % spacing < 2 || y % spacing < 2 ? 100 : 128);
                    pixels[y * FrameSize + x] = new Color32(shade, shade, shade, 255);
                }
                image.SetPixels32(pixels); image.Apply(); File.WriteAllBytes(path, image.EncodeToPNG());
            }
            finally { DestroyImmediate(image); }
        }
#endif
    }
}
using System;
using System.IO;
using System.Linq;
using LOBOver.Client;
using LOBOver.Play;
using LOBOver.World;
using LOBOver.XR;
using Meta.XR.BuildingBlocks;
using TMPro;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.SceneManagement;
using Object = UnityEngine.Object;

namespace LOBOver.Editor
{
    public static class PlaySceneBuilder
    {
        public const string ScenePath = "Assets/Scenes/Play.unity"; // WO-L2 Amendment 1; Bryan owns this scene.
        private const float FloorSize = 20; // Existing tracked-floor guard, retained from WO-S6.
        [MenuItem("LOB Over/Build/Play Scene")]
        public static void BuildMenu()
        {
            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return;
            Build();
        }
        public static Scene OpenExisting()
        {
            if (!File.Exists(ScenePath)) throw new FileNotFoundException("Bryan must save the Building Blocks scene at " + ScenePath);
            var scene = SceneManager.GetSceneByPath(ScenePath);
            if (!scene.IsValid() || !scene.isLoaded) scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
            SceneManager.SetActiveScene(scene); return scene;
        }
        public static Scene Build(bool saveScene = true)
        {
            var scene = OpenExisting();
            if (!BuildingBlocksSetup.Check(scene)) throw new InvalidOperationException("Play Scene stopped: resolve the Building Blocks check first.");
            var replaced = scene.GetRootGameObjects().Where(r => r.name.StartsWith("[LOBOver]", StringComparison.Ordinal)).ToArray();
            foreach (var root in replaced)
                if (root.GetComponentInChildren<BuildingBlock>(true) != null || root.GetComponentInChildren<OVRCameraRig>(true) != null
                    || root.GetComponentsInChildren<Transform>(true).Any(t => t.name.StartsWith("[BuildingBlock]", StringComparison.Ordinal) || t.name == "OVRCameraRig"))
                    throw new InvalidOperationException("Play Scene stopped: protected block/rig under " + root.name + ". Nothing removed.");
            // WO-L4 owns new copies under Art; the legacy prefab directory is outside this order.
            var assets = SitePresentationBuilder.BuildAssets();
            var dark = Material("PlayPanel", "Universal Render Pipeline/Unlit", new Color(0.035f, 0.045f, 0.06f, 1));
            var buttonMaterial = Material("PlayButton", "Universal Render Pipeline/Unlit", new Color(0.18f, 0.22f, 0.28f, 1));
            foreach (var root in replaced) Object.DestroyImmediate(root);
            var lighting = Root("Lighting");
            var sun = WorldDrawing.Group("Sun", lighting).AddComponent<Light>(); sun.type = LightType.Directional;
            SitePresentationBuilder.Lighting(sun);
            foreach (var light in scene.GetRootGameObjects().SelectMany(r => r.GetComponentsInChildren<Light>(true)).Where(l => l != sun && l.enabled))
            {
                if (light.GetComponentInParent<BuildingBlock>(true) != null
                    || light.GetComponentsInParent<Transform>(true).Any(t => t.name.StartsWith("[BuildingBlock]", StringComparison.Ordinal)))
                    throw new InvalidOperationException("WO-L4: protected Building Block light would exceed the one-light budget: " + light.name);
                light.enabled = false; EditorUtility.SetDirty(light); PrefabUtility.RecordPrefabInstancePropertyModifications(light);
                Debug.Log("WO-L4: disabled extra scene light " + light.name + "; the site uses one directional sun.");
            }
            var hub = Root("Hub");
            var floor = WorldDrawing.Group("TrackedFloor", hub).AddComponent<BoxCollider>();
            floor.size = new Vector3(FloorSize, 0.1f, FloorSize); floor.center = new Vector3(0, -0.05f, 0);
            var site = Root("Site"); site.gameObject.SetActive(false);
            var sky = SitePresentationBuilder.Build(site, assets);
            var world = WorldDrawing.Group("SiteWorld", site).AddComponent<SiteWorld>(); world.assets = assets;
            world.sky = sky;
            var client = Root("Client");
            var connection = client.gameObject.AddComponent<HostConnection>();
            var xr = client.gameObject.AddComponent<XRRig>(); client.gameObject.AddComponent<XRRuntimeSettings>();
            var presenter = client.gameObject.AddComponent<HostWorldPresenter>(); presenter.connection = connection; presenter.world = world;
            var warpRoot = Root("Warp"); var warp = warpRoot.gameObject.AddComponent<WarpController>();
            warp.connection = connection; warp.rig = xr; warp.presenter = presenter; warp.site = site; warp.hub = hub.gameObject;
            var panel = WorldDrawing.Group("CrewPanel", hub).transform;
            var background = WorldDrawing.Box("Background", panel, Vector3.zero, new Vector3(HubPanel.Width, 0.43f, 0.008f), dark);
            Object.DestroyImmediate(background.GetComponent<Collider>());
            Label("Title", panel, "LOB, Over", new Vector3(0, 0.17f, -0.008f), new Vector2(0.36f, 0.04f), HubPanel.TitleHeight, assets);
            var status = Label("Status", panel, "Looking for the game. Start it on the PC with Play LOB Over.",
                new Vector3(0, 0.09f, -0.008f), new Vector2(0.36f, 0.1f), HubPanel.TextHeight, assets);
            var hubPanel = client.gameObject.AddComponent<HubPanel>(); hubPanel.connection = connection; hubPanel.rig = xr; hubPanel.panel = panel; hubPanel.status = status;
            hubPanel.warp = warp;
            var click = SiteAssetBuilder.Required<AudioClip>(SiteAssetBuilder.Art + "Click.wav");
            var names = new[] { "Ray Â· digging", "Marcus Â· pipe", "Dana Â· backfill" };
            for (var i = 0; i < names.Length; i++)
                Button(panel, names[i], WorldUnits.CrewIds[i], new Vector3(0, -0.02f - i * 0.075f, -0.012f),
                    new Vector2(HubPanel.ButtonWidth, HubPanel.ButtonHeight), assets, buttonMaterial, click, warp);
            var wrist = WorldDrawing.Group("BackWrist", warpRoot);
            var follower = wrist.AddComponent<RigAnchorFollower>(); follower.rig = xr; follower.leftWrist = true;
            follower.positionOffset = new Vector3(0, 0.08f, 0); follower.rotationOffset = new Vector3(90, 0, 0);
            var back = Button(wrist.transform, "Back", "", Vector3.zero, new Vector2(0.11f, 0.06f), assets, buttonMaterial, click, warp);
            warp.wrist = wrist; wrist.SetActive(false);
            var voice = client.gameObject.AddComponent<HostVoice>(); voice.connection = connection; voice.world = world; voice.warp = warp;
            voice.source = WorldDrawing.Sound(WorldDrawing.Group("ForemanVoice", client), false, HostVoice.SilentMetres);
            voice.source.minDistance = HostVoice.ClearMetres;
            var preview = Root("Preview"); preview.gameObject.tag = "EditorOnly";
            var camera = WorldDrawing.Group("DesktopCamera", preview).AddComponent<Camera>();
            camera.transform.position = new Vector3(0, 1.65f, 0); camera.clearFlags = CameraClearFlags.SolidColor;
            camera.backgroundColor = Color.clear; camera.allowHDR = false; camera.nearClipPlane = 0.05f; camera.farClipPlane = 6000; camera.depth = 100;
            var desktop = preview.gameObject.AddComponent<PlayPreview>(); desktop.view = camera; desktop.rig = xr; desktop.back = back;
            xr.editorHead = camera.transform;
            sky.observer = camera.transform;
            sky.rig = xr;
            // Editor inspection shows the complete site; WarpController sets the hub state in Play.
            Shader.SetGlobalFloat("_WarpProgress", 1);
            Shader.SetGlobalFloat("_WarpRadius", WarpController.RestRadius);
            Shader.SetGlobalFloat("_WarpBand", WarpController.BandMetres);
            EditorSceneManager.MarkSceneDirty(scene);
            if (saveScene)
            {
                if (!EditorSceneManager.SaveScene(scene)) throw new IOException("Could not save " + ScenePath);
                EditorBuildSettings.scenes = new[] { new EditorBuildSettingsScene(ScenePath, true) };
            }
            AssetDatabase.SaveAssets();
            Debug.Log("LOB Over: Play Scene built; Sync Data before the Quest build. Start Play LOB Over on the PC.");
            return scene;
        }
        private static Transform Root(string name) => new GameObject("[LOBOver] " + name).transform;
        private static Material Material(string name, string shaderName, Color color, bool required = true)
        {
            var shader = Shader.Find(shaderName);
            if (shader == null) { if (!required) return null; throw new InvalidOperationException("Missing shader " + shaderName); }
            var path = SiteAssetBuilder.Art + name + ".mat";
            var material = AssetDatabase.LoadAssetAtPath<Material>(path);
            if (material == null) { material = new Material(shader); AssetDatabase.CreateAsset(material, path); }
            material.shader = shader;
            if (material.HasProperty("_BaseColor")) material.SetColor("_BaseColor", color);
            EditorUtility.SetDirty(material); return material;
        }
        private static TextMeshPro Label(string name, Transform parent, string value, Vector3 position, Vector2 size, float height, WorldAssets assets)
        {
            var label = WorldDrawing.Text(name, parent, position, size, height, assets.font);
            // TMP uses a tenth of a world unit per font unit. Size the capital glyph, not its line box.
            var face = assets.font.faceInfo;
            label.fontSize = height * 10 * face.pointSize / Mathf.Max(1, face.capLine);
            label.alignment = TextAlignmentOptions.Center; label.text = value; return label;
        }
        private static CrewButton Button(Transform parent, string title, string crew, Vector3 position, Vector2 size,
            WorldAssets assets, Material material, AudioClip click, WarpController warp)
        {
            var obj = WorldDrawing.Group(string.IsNullOrEmpty(crew) ? "Back" : "Visit_" + crew, parent);
            obj.transform.localPosition = position;
            WorldDrawing.Box("Face", obj.transform, Vector3.zero, new Vector3(size.x, size.y, 0.006f), material);
            Label("Label", obj.transform, title, new Vector3(0, 0, -0.005f), size * 0.95f, HubPanel.TextHeight, assets);
            InteractionSurface.Button(obj, size);
            var button = obj.AddComponent<CrewButton>(); button.warp = warp; button.crew = crew;
            button.click = obj.AddComponent<AudioSource>(); button.click.playOnAwake = false; button.click.spatialBlend = 0; button.click.clip = click;
            return button;
        }
    }
}

