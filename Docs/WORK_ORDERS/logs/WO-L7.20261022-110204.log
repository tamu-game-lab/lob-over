                    Assert.That(source.Contains("OVRInput.") && source.Contains("Physics.Raycast"), Is.False, file);
                }
            Assert.That(File.Exists("Assets/LOBOver/Runtime/VR/" + "ControllerPointer.cs"), Is.False);
        }
