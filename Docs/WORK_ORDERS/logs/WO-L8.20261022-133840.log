            {
                Assert.That(room.LoadImage(File.ReadAllBytes(folder + "/room.png")), Is.True);
                frame = preview.CaptureFrame(); composite = PlayPreview.CompositeFrame(frame, room);
                Assert.That(preview.view.transform.parent, Is.EqualTo(warp.rig.CentreEye));
                Assert.That(preview.view.transform.localPosition, Is.EqualTo(Vector3.zero));
                Assert.That(preview.view.transform.localRotation, Is.EqualTo(Quaternion.identity));
                File.WriteAllBytes(folder + "/l8-" + name + "-raw.png", frame.EncodeToPNG());
                File.WriteAllBytes(folder + "/l8-" + name + ".png", composite.EncodeToPNG());
                File.WriteAllBytes(folder + "/l8-" + name + "-composite.png", composite.EncodeToPNG());
            }
            finally { Object.DestroyImmediate(room); if (frame != null) Object.DestroyImmediate(frame); if (composite != null) Object.DestroyImmediate(composite); }
#endif
        }
        [TearDown]
