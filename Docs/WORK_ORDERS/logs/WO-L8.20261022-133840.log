        [Test]
        public void BuilderAndRuntimeObjectsRestOnTheSameTerrain()
        {
            var scene = PlaySceneBuilder.Build(false);
            var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
            var world = site.GetComponentInChildren<SiteWorld>(true);
            var job = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json"));
            var recorded = JObject.Parse(File.ReadAllText("Data/transcripts/slice_play.json"));
            world.Configure((JObject)job["job"], 0);
            foreach (var day in new[] { 1, 4, 5, 9, 16 })
            {
                world.Apply(SiteView.From((JObject)recorded["snapshots"][day]["site"]), day + 1);
                foreach (var id in WorldUnits.CrewIds) world.Crew(id).SnapPose();
                world.stage.Refresh();
                var objects = site.GetComponentsInChildren<GroundedObject>(true);
                Assert.That(objects.Length, Is.GreaterThan(50), "Grounding covers machines, workers, piles, roadside props, cabin and trees");
                foreach (var item in objects) Assert.That(item.Clearance, Is.EqualTo(0).Within(0.05f), day + ": " + item.name);
                foreach (var crew in site.GetComponentsInChildren<CrewRig>(true))
                {
                    Assert.That(crew.Machine.GetComponent<GroundedObject>(), Is.Not.Null);
                    Assert.That(crew.Foreman.GetComponent<GroundedObject>(), Is.Not.Null);
                    var position = crew.transform.localPosition;
                    Assert.That(position.z, Is.LessThan(-WorldUnits.TrenchWidth / 2), "Machine on far bank");
                    using var geometry = new SiteGround.Geometry(crew.Machine.transform);
                    var edgeGap = -WorldUnits.TrenchWidth / 2 - geometry.BoundsIn(world.transform).max.z;
                    Assert.That(edgeGap, Is.InRange(0, 3), "Near machine edge beside the far trench edge");
                }
            }
            foreach (var vertex in world.assets.groundMesh.vertices)
                Assert.That(vertex.y, Is.EqualTo(SiteGround.GroundHeight(vertex.x, vertex.z)).Within(0.0001f));
            Assert.That(world.assets.groundMesh.bounds.min.x, Is.LessThanOrEqualTo(-120));
            Assert.That(world.assets.groundMesh.bounds.max.x, Is.GreaterThanOrEqualTo(120));
        }
