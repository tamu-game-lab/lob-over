            public Geometry(Transform root) { this.root = root; Renderers = PhysicalRenderers(root); }
            public Bounds Bounds => BoundsIn(null);
            public Bounds BoundsIn(Transform space)
            {
                var bounds = new Bounds(space == null ? root.position : space.InverseTransformPoint(root.position), Vector3.zero); var found = false;
                foreach (var renderer in Renderers)
