using System.Collections;
using System.Collections.Generic;
using System.Linq;
using LOBOver.Client;
using LOBOver.World;
using LOBOver.XR;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class WarpController : MonoBehaviour
    {
        public HostConnection connection;
        public XRRig rig;
        public HostWorldPresenter presenter;
        public Transform site;
        public GameObject hub, wrist;
        public bool Busy { get; private set; }
        public bool InSite { get; private set; }
        public float Progress { get; private set; }
        public Vector3 Origin { get; private set; }
        public double SelectedStation { get; private set; }
        public event System.Action Changed;
        // WO-L8 item 8 (supersedes WO-L5): metres and unscaled seconds. Quadratic ease-out for the front.
        public const float InSeconds = 2.5f, OutSeconds = 1.5f, WatchdogSeconds = 3;
        public const float WaveMetres = 160, BandMetres = 14, RestRadius = 1e6f;
        private Coroutine transition;
        private bool entering;
        private double transitionStarted;
        private readonly Dictionary<Animator, float> animatorSpeeds = new Dictionary<Animator, float>();
        private readonly List<ParticleSystem> particles = new List<ParticleSystem>();
        private readonly List<ParticleSystemRenderer> particleRenderers = new List<ParticleSystemRenderer>();
        private readonly List<CrewRig> crews = new List<CrewRig>();
        private void Start()
        {
            rig.Resolve();
            site.gameObject.SetActive(false); wrist.SetActive(false); hub.SetActive(true);
            SetPassthrough(true);
            ApplyProgress(0);
        }
        public bool GoToSite() => Visit("pipe");
        public bool Visit(string crewId)
        {
            if (Busy || InSite || !connection.Connected || connection.Mirror || !rig.TryHeadPose(out var pose)) return false;
            var crew = connection.View?.crews.FirstOrDefault(c => c.id == crewId);
            if (crew == null) return false;
            SelectedStation = crew.stationFt;
            presenter.Present();
            var forward = Vector3.ProjectOnPlane(pose.rotation * Vector3.forward, Vector3.up).normalized;
            if (forward.sqrMagnitude < 0.1f) forward = Vector3.forward;
            // Road is +Z of the trench. Align -Z with gaze and put the road at the tracked feet.
            site.rotation = Quaternion.LookRotation(-forward);
            var feet = new Vector3(pose.position.x, 0, pose.position.z);
            var road = new Vector3(0, 0, WorldUnits.RoadZ);
            site.position = feet - site.rotation * road;
            BeginTransition(true);
            AttendedCrew = "pipe";
            _ = SendArrival(SelectedStation);
            return true;
        }
        public string AttendedCrew { get; private set; } = "pipe";
        public bool Attend(string crewId)
        {
            if (!InSite || Busy || arrivalPending || sendingArrival || AttendedCrew == crewId) return false;
            var crew = connection.View?.crews.FirstOrDefault(c => c.id == crewId);
            if (crew == null) return false;
            AttendedCrew = crewId; SelectedStation = crew.stationFt; _ = SendArrival(SelectedStation); return true;
        }
        private bool sendingArrival;
        private async System.Threading.Tasks.Task SendArrival(double station)
        {
            sendingArrival = true;
            try
            {
            // Transport order is intentional; dismount waits for the host's moving flag to clear.
            // PROTOCOL.md retains the mounted travel precondition, even though Play has no truck presentation.
            if (connection.View?.truck.dismounted == true && !await connection.SendCommand("mount")) return;
            if (!await connection.SendCommand("moveTo", station)) return;
            arrivalPending = true;
            }
            finally { sendingArrival = false; }
        }
        private bool arrivalPending;
        private void Update()
        {
            // Separate from the coroutine so StopAllCoroutines cannot strand the player.
            if (Busy && Time.realtimeSinceStartupAsDouble - transitionStarted >= WatchdogSeconds)
            {
                LogPhase("watchdog");
                if (transition != null) StopCoroutine(transition);
                FinishTransition();
            }
            if (!arrivalPending) return;
            if (!connection.Connected) { arrivalPending = false; return; }
            var truck = connection.View?.truck;
            if (truck != null && !truck.moving && System.Math.Abs(truck.stationFt - SelectedStation) < 0.1)
            { arrivalPending = false; _ = connection.SendCommand("dismount"); }
        }
        public bool Back()
        {
            // Repeated Back is harmless and never restarts the watchdog's clock.
            if (Busy && !entering) return true;
            if (!Busy && !InSite) return true;
            BeginTransition(false); return true;
        }
        private void BeginTransition(bool toSite)
        {
            if (transition != null) StopCoroutine(transition);
            var alreadyFrozen = Busy;
            entering = toSite; Busy = true;
            transitionStarted = Time.realtimeSinceStartupAsDouble;
            presenter.Frozen = true;
            SetPassthrough(true);
            ApplyProgress(Progress);
            site.gameObject.SetActive(true);
            wrist.SetActive(true);
            if (!alreadyFrozen) FreezeWorld(entering);
            LogPhase(entering ? "in start" : "out start");
            Changed?.Invoke();
            transition = StartCoroutine(Transition());
        }
        private IEnumerator Transition()
        {
            var from = Progress;
            var target = entering ? 1f : 0f;
            // Reversal keeps the same progress speed, starting exactly where Back was pressed.
            var duration = (entering ? InSeconds : OutSeconds) * Mathf.Abs(target - from);
            while (Time.realtimeSinceStartupAsDouble - transitionStarted < duration)
            {
                ApplyProgress(Mathf.Lerp(from, target, (float)(Time.realtimeSinceStartupAsDouble - transitionStarted) / duration));
                yield return null;
            }
            FinishTransition();
        }
        private void FinishTransition()
        {
            ApplyProgress(entering ? 1 : 0);
            InSite = entering;
            if (entering) GetComponent<CrewAttention>()?.PrimeVisible();
            SetPassthrough(!entering);
            site.gameObject.SetActive(entering); hub.SetActive(!entering); wrist.SetActive(entering);
            ThawWorld(); presenter.Frozen = false; presenter.Present(); Busy = false;
            transition = null;
            LogPhase(entering ? "in done" : "out done");
            Changed?.Invoke();
        }
        public static float RadiusAt(float progress)
        {
            var p = Mathf.Clamp01(progress);
            return p >= 1 ? RestRadius : WaveMetres * (1 - (1 - p) * (1 - p));
        }
        private void ApplyProgress(float value)
        {
            Progress = Mathf.Clamp01(value);
            if (rig.TryHeadPose(out var pose)) Origin = new Vector3(pose.position.x, site.position.y, pose.position.z);
            Shader.SetGlobalFloat("_WarpProgress", Progress);
            Shader.SetGlobalVector("_WarpOrigin", Origin);
            Shader.SetGlobalFloat("_WarpRadius", RadiusAt(Progress));
            Shader.SetGlobalFloat("_WarpBand", BandMetres);
        }
        private void LogPhase(string phase) => Debug.Log("LOBOver Warp: " + phase + " progress=" + Progress.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture));
#if UNITY_EDITOR
        // Synchronous preview capture restores this value before the next runtime frame.
        private bool previewFrozen, previewPresenterWasFrozen;
        public void PreviewProgress(float value)
        {
            if (Busy) throw new System.InvalidOperationException("Wait for the warp before stepping preview progress.");
            if (value < 1 && !previewFrozen)
            {
                previewPresenterWasFrozen = presenter.Frozen; presenter.Frozen = true;
                FreezeWorld(false); previewFrozen = true;
            }
            else if (value >= 1 && previewFrozen)
            {
                ThawWorld(); presenter.Frozen = previewPresenterWasFrozen; previewFrozen = false;
            }
            ApplyProgress(value);
        }
#endif
        private void FreezeWorld(bool snap)
        {
            foreach (var crew in site.GetComponentsInChildren<CrewRig>(true))
                if (crew.enabled) { if (snap) crew.SnapPose(); crews.Add(crew); crew.enabled = false; }
            foreach (var animator in site.GetComponentsInChildren<Animator>(true))
            { animatorSpeeds[animator] = animator.speed; animator.speed = 0; }
            foreach (var particle in site.GetComponentsInChildren<ParticleSystem>(true))
                if (particle.isPlaying) { particles.Add(particle); particle.Pause(); }
            // Particles use URP's particle shader, so keep them absent until the material wave ends.
            foreach (var renderer in site.GetComponentsInChildren<ParticleSystemRenderer>(true))
                if (renderer.enabled) { particleRenderers.Add(renderer); renderer.enabled = false; }
        }
        private void ThawWorld()
        {
            foreach (var crew in crews) if (crew != null) crew.enabled = true;
            foreach (var pair in animatorSpeeds) if (pair.Key != null) pair.Key.speed = pair.Value;
            foreach (var particle in particles) if (particle != null && particle.gameObject.activeInHierarchy) particle.Play();
            foreach (var renderer in particleRenderers) if (renderer != null) renderer.enabled = true;
            crews.Clear(); animatorSpeeds.Clear(); particles.Clear(); particleRenderers.Clear();
        }
        private void SetPassthrough(bool value)
        {
            if (rig.Passthrough == null) return;
            rig.Passthrough.enabled = value; rig.Passthrough.hidden = !value;
        }
        private void OnDestroy()
        {
            ThawWorld();
            if (presenter != null) presenter.Frozen = false;
            Shader.SetGlobalFloat("_WarpProgress", 1);
            Shader.SetGlobalFloat("_WarpRadius", RestRadius);
        }
    }
}
# WO-L7 No tunnel, head-camera verification, chart orientation

## Goal

The grey circle Bryan saw in three headset builds is gone for good, verification can never miss it again, and the Plan page's chart runs days across and stations up.

## The cause (found October 22)

The Interactions Rig block's `Locomotor` carries two Interaction SDK comfort effects, `SmoothMovementTunneling` and `WallPenetrationTunneling`. Each is a driver script in `Oculus.Interaction.Locomotion` plus a `TunnelingEffect` (namespace `Oculus.Interaction`) that draws a full-view quad 0.3 m in front of the centre eye (`ZTest Always`, transparent queue) with a feathered circular hole. `Configure Building Blocks` disables every Behaviour in `Oculus.Interaction.Locomotion`, so it switched off the drivers, which normally hide the quads every frame, but left the `TunnelingEffect` components running with their serialized defaults: the wall-penetration one shows a 60° hole in a grey (0.547) mask permanently. That is the "fisheye": the hub panel was hidden behind it except through the hole, and the site was visible only through the hole. Editor verification missed it three times because every screenshot came from a separate preview camera, which saw the quads edge-on as a "black plate" beside the foreman.

## Read

- `AGENTS.md`, `Docs/XR_RENDERING.md` (all of it), `Docs/DECISIONS.md` K42 and K43
- `Assets/LOBOver/Editor/BuildingBlocksSetup.cs`, `Assets/LOBOver/Runtime/Play/PlayPreview.cs`, `Assets/LOBOver/Editor/PlaySceneBuilder.cs` (the preview camera), `Assets/LOBOver/Tests/**`
- `Library/PackageCache/com.meta.xr.sdk.interaction*/Runtime/Scripts/Interaction/Models/Locomotion/Tunneling/*.cs`, `Runtime/Prefabs/Locomotion/{Locomotor,TunnelingEffect}.prefab`
- `Monitor/web/play.html` (the board), `Monitor/web/plan.html` (the chart), their e2e tests

## You may change

`Assets/LOBOver/Editor/**`, `Assets/LOBOver/Runtime/**`, `Assets/LOBOver/Tests/**`, `Play.unity` only through Configure and the builder; `Monitor/web/play.html`, `Monitor/web/plan.html`, `Monitor/e2e/**`, `Monitor/test/**`; `Docs/XR_RENDERING.md` only the lines named below.

## Build

1. **Configure Building Blocks** also sets inactive every GameObject under the blocks that carries a `TunnelingEffect` (`SetActive(false)`; values only, nothing added or removed), logging each. **Check Building Blocks** fails when any `TunnelingEffect` in the scene is on an active object with an enabled `MeshRenderer`, naming the object. If Bryan has already unchecked the two objects by hand, Configure changes nothing and Check passes.
2. **Verification camera.** The Editor preview renders through the head: the preview camera becomes a child of the rig's centre eye anchor with local pose identity, the centre eye camera's field of view and clipping planes, so anything attached to the head (tunnels, masks, panels) appears in every screenshot and composite exactly as the headset shows it. The old free preview pose is kept only as a second, explicitly named "survey" view for the WO-L4 stats, never for acceptance images. `XR_RENDERING.md` "Seeing the real thing before a build" gains one sentence saying so.
3. **Tests.** EditMode: a scene with an active `TunnelingEffect` fails Check and passes after Configure; Configure on Play.unity is idempotent. PlayMode: with the rig at a simulated head pose, a frame rendered through the head camera at progress 0 (hub) contains no pixel within 0.03 of the tunnel grey (0.547, 0.547, 0.547) and the composite over `room.png` shows the grid everywhere except the panel; a frame at warp progress 1 contains none either.
4. **Chart orientation**, `play.html` and `plan.html`: days across (left to right, Day 1 at the left), stations up (0+00 at the bottom, 30+00 at the top), zone bands horizontal, the day ruler vertical and sliding right, the PM's dashed plan and the inked actuals in the same crew colours. Labels: "Day" along the bottom, station marks along the left. The result stamp and the faint previous run follow. The e2e assertions on the board update accordingly.

## Acceptance checks

- Orchestrator through the MCP: compile clean; Check on the committed Play.unity reports the two tunnel objects (if Bryan has not already turned them off), Configure turns them off, Check passes, Play Scene twice; EditMode and PlayMode pass; the head-camera screenshots at the hub and in the site show no tunnel, no mask, no black plate; composites reviewed.
- `npm test` and the e2e pass; screenshots of the flipped board before Start, mid-run and at the result in `Monitor/out/play/`.
- No Quest build (K41). Bryan builds and checks: the whole room in the hub, the panel readable, the site filling in around him with no circle.

## Out of scope

Everything else in Level 1.

