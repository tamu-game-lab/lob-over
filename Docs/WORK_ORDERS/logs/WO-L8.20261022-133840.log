        private IEnumerator MeasureHeadBudget()
        {
#if UNITY_EDITOR
            var camera = preview.view;
            var cameras = Resources.FindObjectsOfTypeAll<Camera>().Where(c => c != null && c != camera && !UnityEditor.EditorUtility.IsPersistent(c))
                .Select(c => (camera: c, enabled: c.enabled, mask: c.cullingMask, clear: c.clearFlags)).ToArray();
            var rigRenderers = warp.rig.CameraRig.GetComponentsInChildren<Renderer>(true).Select(r => (renderer: r, enabled: r.enabled)).ToArray();
            var gameType = typeof(UnityEditor.EditorWindow).Assembly.GetType("UnityEditor.GameView", true);
            var game = Resources.FindObjectsOfTypeAll(gameType).Cast<UnityEditor.EditorWindow>().FirstOrDefault();
            var created = game == null; var maximized = game != null && game.maximized;
            var otherWindows = Resources.FindObjectsOfTypeAll<UnityEditor.EditorWindow>().Where(w => w != game && w.maximized).ToArray();
            var focused = UnityEditor.EditorWindow.focusedWindow;
            var previewEnabled = preview.enabled; var enabled = camera.enabled; var target = camera.targetTexture;
            var renders = 0;
            void Count(UnityEngine.Rendering.ScriptableRenderContext context, Camera rendered) { if (rendered == camera) renders++; }
            try
            {
                preview.enabled = false; // Keep AlignHeadCamera from copying the temporarily masked eye camera.
                foreach (var other in otherWindows) other.maximized = false;
                if (game == null) game = UnityEditor.EditorWindow.GetWindow(gameType);
                game.Focus(); game.maximized = true;
                foreach (var other in cameras) if (other.camera != null)
                { other.camera.enabled = false; other.camera.cullingMask = 0; other.camera.clearFlags = CameraClearFlags.Nothing; }
                foreach (var entry in rigRenderers) entry.renderer.enabled = false;
                camera.enabled = true; camera.targetTexture = null;
                warp.presenter.world.stage.BatchGeometry();
                warp.presenter.world.stage.RefreshShadows(camera.transform);
                foreach (var id in WorldUnits.CrewIds) warp.presenter.world.Crew(id).RefreshDistancePresentation(camera.transform);
                yield return null;
                UnityEngine.Rendering.RenderPipelineManager.beginCameraRendering += Count;
                game.Repaint(); yield return null;
                var count = Math.Max(1, renders);
                var triangles = UnityEditor.UnityStats.triangles / count; var calls = UnityEditor.UnityStats.drawCalls / count;
                Debug.Log($"WO-L8 head view: {triangles} triangles, {calls} draw calls ({renders} camera renders)");
                Assert.That(renders, Is.GreaterThan(0), "Head camera must render in the statistics window");
                Assert.That(triangles, Is.InRange(1, 299999)); Assert.That(calls, Is.InRange(1, 149));
            }
            finally
            {
                UnityEngine.Rendering.RenderPipelineManager.beginCameraRendering -= Count;
                if (camera != null) { camera.enabled = enabled; camera.targetTexture = target; }
                foreach (var other in cameras) if (other.camera != null)
                { other.camera.enabled = other.enabled; other.camera.cullingMask = other.mask; other.camera.clearFlags = other.clear; }
                foreach (var entry in rigRenderers) if (entry.renderer != null) entry.renderer.enabled = entry.enabled;
                if (preview != null) preview.enabled = previewEnabled;
                if (game != null) { game.maximized = maximized; if (created) game.Close(); }
                foreach (var other in otherWindows) if (other != null) other.maximized = true;
                if (focused != null) focused.Focus();
            }
#else
            yield break;
#endif
        }
