        private GameObject confirmation;
        private readonly List<RayButton> verbs = new List<RayButton>();
        private readonly List<double> destinations = new List<double>();
        private readonly List<GameObject> flags = new List<GameObject>();
        private readonly HashSet<string> listened = new HashSet<string>();
        private LineRenderer reticle;
        private AudioSource engine;
        private Coroutine ride;
        private bool positioned, dismounted, turnLatched, navLatched;
        private double station;
        private float fadeSeconds = ShortFade, cardUntil, voiceUntil;
        private string inspection = "", missingVoice = "";
        private int selected;
        private JObject pendingFact;
        // WO-09 sections 1-7: comfort, geometry and card timings.
        private const float ShortFade = 0.3f, LongFade = 0.6f, EngineSeconds = 1.5f, SeatEye = 1.15f;
        private const float StandingEye = 1.7f, EdgeOffset = 1.5f, SnapDegrees = 30, CardSeconds = 20, VoiceSeconds = 8;

        private void OnEnable()
        {
            if (director == null) return;
            if (InputLayer == null) BuildControls();
            director.ViewsChanged += OnViews; director.Message += OnMessage; director.Loaded += ResetSeat;
            pointer.AnyPress += DismissCard; voice.MissingVoice += MissingVoice;
            ResetSeat();
            if (director.SiteView != null) OnViews(director.SiteView, null);
        }
        private void OnDisable()
        {
            if (director == null) return;
            director.ViewsChanged -= OnViews; director.Message -= OnMessage; director.Loaded -= ResetSeat;
            pointer.AnyPress -= DismissCard; voice.MissingVoice -= MissingVoice;
            if (ride != null) StopCoroutine(ride);
            ride = null; if (engine != null) engine.Stop(); if (fade != null) fade.SetExplicitFade(0);
        }
        private void ResetSeat()
        {
            if (ride != null) StopCoroutine(ride);
            ride = null; positioned = false; listened.Clear(); destinations.Clear(); selected = 0;
            inspection = ""; missingVoice = ""; cardUntil = voiceUntil = 0; pendingFact = null;
            confirmation.SetActive(false);
            foreach (var flag in flags) if (flag != null) Destroy(flag);
            flags.Clear();
            if (director.Job == null) return;
            var length = (double)director.Job["lengthFt"];
            for (double ft = 0; ft <= length; ft += WorldUnits.StationFeet) destinations.Add(ft);
            foreach (var zone in director.Job["zones"].OfType<JObject>()) destinations.Add((double)zone["fromFt"]);
            // The slice's collapse stake is authored at 5+20, between the regular survey stakes.
            // Offer crew stations as well (updated when cycling), without rounding the selected destination.
            RefreshDestinations();
        }
        private void BuildControls()
        {
            InputLayer = new InspectorInputLayer(); InputLayer.Command += Send;
            InputLayer.Text += text => inspection = text;
            InputLayer.ConfirmRequested += () => confirmation.SetActive(true);
            clipboard = WorldDrawing.Text("Inspection", wrist, new Vector3(0, 0.012f, -0.012f), new Vector2(0.20f, 0.10f), 0.012f, assets.font);
            clipboard.enableAutoSizing = true; clipboard.fontSizeMin = 0.65f; clipboard.fontSizeMax = 1.2f;
            wristCard = WorldDrawing.Text("Event", wrist, new Vector3(0, 0.15f, -0.012f), new Vector2(0.22f, 0.13f), 0.012f, assets.font);
            var labels = new[] { "Flag", "Stop work", "Confirm" };
            for (var i = 0; i < labels.Length; i++)
            {
                var button = (InspectorButton)(i + 1);
                verbs.Add(RayButton.Create(wrist, labels[i], new Vector3((i - 1) * 0.065f, -0.06f, -0.015f), new Vector2(0.03f, 0.02f), assets, clickClip, () => Press(button)));
            }
            confirmation = WorldDrawing.Group("ConfirmOutcome", wrist);
            RayButton.Create(confirmation.transform, "Done", new Vector3(-0.055f, -0.105f, 0), new Vector2(0.09f, 0.035f), assets, clickClip, () => Press(InspectorButton.Done));
            RayButton.Create(confirmation.transform, "Not carried out", new Vector3(0.055f, -0.105f, 0), new Vector2(0.09f, 0.035f), assets, clickClip, () => Press(InspectorButton.NotCarriedOut));
            dashText = WorldDrawing.Text("TruckState", dashboard, new Vector3(0, 0.09f, -0.04f), new Vector2(0.75f, 0.08f), 0.03f, assets.font);
            selectedText = WorldDrawing.Text("Destination", dashboard, new Vector3(0, 0.02f, -0.04f), new Vector2(0.75f, 0.08f), 0.027f, assets.font);
            RayButton.Create(dashboard, "Previous", new Vector3(-0.26f, -0.08f, -0.04f), new Vector2(0.22f, 0.06f), assets, clickClip, () => Select(-1));
            RayButton.Create(dashboard, "Ride", new Vector3(0, -0.08f, -0.04f), new Vector2(0.22f, 0.06f), assets, clickClip, RideSelected);
            RayButton.Create(dashboard, "Next", new Vector3(0.26f, -0.08f, -0.04f), new Vector2(0.22f, 0.06f), assets, clickClip, () => Select(1));
            RayButton.Create(dashboard, "Settings: fade 0.3 s / 0.6 s", new Vector3(0, -0.20f, -0.04f), new Vector2(0.5f, 0.06f), assets, clickClip,
                () => { fadeSeconds = fadeSeconds == ShortFade ? LongFade : ShortFade; });
            cardText = WorldDrawing.Text("EventCard", dashboard, new Vector3(0, 0.42f, -0.04f), new Vector2(0.8f, 0.45f), 0.035f, assets.font);
            engine = WorldDrawing.Sound(cab.gameObject, true); engine.clip = assets.dozer;
            reticle = WorldDrawing.Line("DwellReticle", rig.centerEyeAnchor, assets.ink, Color.white, 0.0005f);
            reticle.positionCount = 33;
        }
        private void RefreshDestinations()
        {
            if (director.SiteView != null)
                foreach (var crew in director.SiteView.crews)
                    if (!destinations.Contains(crew.stationFt)) destinations.Add(crew.stationFt);
            destinations.Sort();
        }
        private void Select(int direction)
        {
            RefreshDestinations();
            if (destinations.Count == 0) return;
            selected = (selected + direction + destinations.Count) % destinations.Count;
        }
        private void RideSelected() { if (destinations.Count > 0) InputLayer.Ride(destinations[selected]); }
        private string FirstOrder => director.SiteView?.orders.FirstOrDefault()?.id;
        private int Zone => director.SiteView == null ? 0 : world.ZoneAt(director.SiteView.truck.stationFt);
        private void Press(InspectorButton button)
        {
            DismissCard(); InputLayer.Press(button, Zone, FirstOrder);
            if (button == InspectorButton.Done || button == InspectorButton.NotCarriedOut) confirmation.SetActive(false);
        }
        private void Send(JObject command)
        {
            var action = (string)command["action"];
            pendingFact = action == "flag" || action == "stopWork" ? (JObject)command.DeepClone() : null;
            director.Send(command);
            if (action == "moveTo" && director.SiteView?.truck.moving == true && ride == null) ride = StartCoroutine(Ride());
        }
        private void OnViews(SiteView site, PlanView ignored)
        {
            InputLayer.Observe(site.truck);
            if (!positioned) { Position(site.truck); positioned = true; }
            else if (ride == null && !site.truck.moving && (station != site.truck.stationFt || dismounted != site.truck.dismounted))
                ride = StartCoroutine(Ride(false));
            if (site.truck.moving && ride == null) ride = StartCoroutine(Ride());
        }
        private void Position(TruckView truck)
        {
            station = truck.stationFt; dismounted = truck.dismounted;
            cab.localPosition = new Vector3((float)station * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
            cab.localRotation = Quaternion.Euler(0, 90, 0);
            rig.transform.SetParent(dismounted ? transform : cab, true);
            var desired = transform.TransformPoint(new Vector3((float)station * WorldUnits.MetresPerFoot,
                dismounted ? StandingEye : SeatEye, dismounted ? WorldUnits.TrenchWidth / 2 + EdgeOffset : WorldUnits.RoadZ));
            var yaw = (dismounted ? 180 : 90) + transform.eulerAngles.y - rig.centerEyeAnchor.eulerAngles.y;
            rig.transform.RotateAround(rig.centerEyeAnchor.position, Vector3.up, yaw);
            rig.transform.position += desired - rig.centerEyeAnchor.position;
            world.sky.observer = rig.centerEyeAnchor;
        }
        private IEnumerator Ride(bool engineOn = true)
        {
            yield return Fade(0, 1);
            if (engineOn)
            { engine.Play(); yield return new WaitForSecondsRealtime(EngineSeconds); engine.Stop(); }
            while (director.SiteView == null || director.SiteView.truck.moving) yield return null;
            Position(director.SiteView.truck);
            yield return Fade(1, 0); ride = null;
        }
        private IEnumerator Fade(float from, float to)
        {
            for (float elapsed = 0; elapsed < fadeSeconds; elapsed += Time.unscaledDeltaTime)
            { fade.SetExplicitFade(Mathf.Lerp(from, to, elapsed / fadeSeconds)); yield return null; }
            fade.SetExplicitFade(to);
        }
        private void Update()
        {
            if (InputLayer == null || director.SiteView == null) return;
            var input = pointer.Input;
            var eye = rig.centerEyeAnchor;
            InspectTarget target = null;
            if (ride == null && Physics.Raycast(eye.position, eye.forward, out var hit, 6000, ~0, QueryTriggerInteraction.Collide))
                target = hit.collider.GetComponentInParent<InspectTarget>();
            InputLayer.Tick(input, Time.unscaledDeltaTime, Time.unscaledTime, target == null ? null : target.GetInstanceID().ToString(), target?.target, Zone, FirstOrder);
            if (input.GoDown) { DismissCard(); RideSelected(); }
            if (Mathf.Abs(input.Turn) < 0.3f) turnLatched = false;
            if (!turnLatched && Mathf.Abs(input.Turn) > 0.7f && ride == null)
            { rig.transform.RotateAround(eye.position, Vector3.up, Mathf.Sign(input.Turn) * SnapDegrees); turnLatched = true; }
            if (Mathf.Abs(input.Navigate) < 0.3f) navLatched = false;
            if (!navLatched && Mathf.Abs(input.Navigate) > 0.7f) { Select(input.Navigate > 0 ? 1 : -1); navLatched = true; }
            for (var i = 0; i < 33; i++)
            {
                var angle = i / 32f * Mathf.PI * 2;
                var radius = Mathf.Lerp(0.002f, 0.007f, InputLayer.DwellFraction);
                reticle.SetPosition(i, new Vector3(Mathf.Cos(angle) * radius, Mathf.Sin(angle) * radius, 0.5f));
            }
            reticle.gameObject.SetActive(ride == null && target != null);
            var truck = director.SiteView.truck;
            dashText.text = truck.moving || ride != null ? "driving" : WorldUnits.Station(truck.stationFt) + (truck.dismounted ? " dismounted" : " mounted");
            if (destinations.Count > 0)
                selectedText.text = "Previous " + WorldUnits.Station(destinations[(selected + destinations.Count - 1) % destinations.Count]) + "   > " + WorldUnits.Station(destinations[selected]) + "   Next " + WorldUnits.Station(destinations[(selected + 1) % destinations.Count]);
            clipboard.text = "Day " + director.DisplayDay + " / " + director.Speed + "\n" + (Time.unscaledTime < voiceUntil ? missingVoice : inspection);
            cardText.gameObject.SetActive(Time.unscaledTime < cardUntil); wristCard.gameObject.SetActive(Time.unscaledTime < cardUntil);
            foreach (var button in verbs) button.Available = truck.dismounted && !truck.moving;
            if (truck.dismounted && !truck.moving)
                foreach (var crew in director.SiteView.crews.Where(c => c.status == "arguing" || c.status == "held"))
                {
                    var key = crew.id + ":" + crew.status + ":" + crew.moodLevel;
                    if (Vector3.Distance(eye.position, world.Crew(crew.id).transform.position) <= 10 && listened.Add(key))
                        director.Send(new JObject { ["action"] = "listen" });
                }
        }
        private void DismissCard() { cardUntil = 0; }
        private void MissingVoice(string value) { missingVoice = value; voiceUntil = Time.unscaledTime + VoiceSeconds; }
        private void OnMessage(JObject message)
        {
            var type = (string)message["t"];
            if (type == "ack" && pendingFact != null)
            {
                var isStop = (string)pendingFact["action"] == "stopWork";
                var obj = Instantiate(isStop ? stopFlagPrefab : flagPrefab, world.transform);
                var position = isStop ? world.Board((int)pendingFact["zone"]).transform.localPosition : new Vector3((float)pendingFact["stationFt"] * WorldUnits.MetresPerFoot, 0, 1.2f);
                obj.transform.localPosition = position; flags.Add(obj); pendingFact = null;
            }
            if (type == "nack") { inspection = (string)message["reason"]; pendingFact = null; }
            if (!Director.ForSeat(message, "site")) return;
            if (type == "inspection") { inspection = (string)message["text"]; speech.Speak(inspection); }
            if (type == "event")
            {
                cardText.text = (string)message["card"]?["title"] + "\n" + string.Join("\n", message["card"]?["facts"]?.Values<string>() ?? Enumerable.Empty<string>());
                wristCard.text = cardText.text; cardUntil = Time.unscaledTime + CardSeconds;
            }
        }
    }
}
using System;
using LOBOver.World;
using TMPro;
using UnityEngine;

namespace LOBOver.VR
{
    public sealed class RayButton : MonoBehaviour
    {
        public TextMeshPro label;
        public Transform face;
        public AudioSource click;
        public bool Available = true;
        public Action Pressed;
        private float depressedUntil;
        // WO-09 section 5: 5 mm depression; the short click uses hydraulics_01.
        public void Press()
        {
            depressedUntil = Time.unscaledTime + 0.12f;
            if (click != null && click.clip != null) click.Play();
            Pressed?.Invoke();
        }
        private void Update()
        {
            if (face != null) face.localPosition = new Vector3(0, 0, Time.unscaledTime < depressedUntil ? 0.005f : 0);
            if (label != null) label.color = Available ? Color.white : Color.gray;
        }
        public static RayButton Create(Transform parent, string title, Vector3 position, Vector2 size, WorldAssets assets, AudioClip sound, Action action)
        {
            var root = WorldDrawing.Group(title, parent); root.transform.localPosition = position;
            var button = root.AddComponent<RayButton>();
            button.face = WorldDrawing.Box("SafetyOrange", root.transform, Vector3.zero, new Vector3(size.x, size.y, 0.01f), assets.orange).transform;
            button.label = WorldDrawing.Text("Label", root.transform, new Vector3(0, 0, -0.006f), size * 0.9f, size.y * 0.27f, assets.font);
            button.label.alignment = TextAlignmentOptions.Center; button.label.text = title;
            button.click = WorldDrawing.Sound(root, false, 2); button.click.clip = sound;
            button.Pressed = action; return button;
        }
    }
}
using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using UnityEngine;
using UnityEngine.Networking;

namespace LOBOver.VR
{
    public sealed class SeatAudio : MonoBehaviour
    {
        public Director director;
        public SiteWorld world;
        public Transform listener, dashboard;
        public bool presenter;
        public event Action<string> MissingVoice;
        private readonly Queue<string> queue = new Queue<string>();
        private readonly List<string> waiting = new List<string>();
        private AudioSource source;
        private Coroutine playing;
        private const float ListenMetres = 10, MissingSeconds = 8; // WO-09 sections 5-6.
        private void OnEnable()
        {
            if (director == null) return;
            director.Voice += OnVoice; director.Loaded += Clear;
            if (source == null) source = WorldDrawing.Sound(WorldDrawing.Group("ForemanVoice", transform), false);
        }
        private void OnDisable()
        {
            if (director != null) { director.Voice -= OnVoice; director.Loaded -= Clear; }
            Clear();
        }
        private void Clear()
        {
            queue.Clear(); waiting.Clear();
            if (playing != null) StopCoroutine(playing);
            playing = null;
            if (source != null) { source.Stop(); if (source.clip != null) Destroy(source.clip); source.clip = null; }
        }
        private JObject Line(string id) => director.Lines?.OfType<JObject>().FirstOrDefault(line => (string)line["id"] == id);
        private CrewRig Speaker(JObject line)
        {
            var speaker = (string)line?["speaker"];
            return speaker != null && speaker.StartsWith("foreman_", StringComparison.Ordinal) ? world.Crew(speaker.Substring(8)) : null;
        }
        private bool Audible(string id)
        {
            var crew = Speaker(Line(id));
            return presenter || crew == null || listener != null && Vector3.Distance(listener.position, crew.transform.position) <= ListenMetres;
        }
        private void OnVoice(JObject message)
        {
            if (!Director.ForSeat(message, "site")) return;
            foreach (var id in message["lineIds"]?.Values<string>() ?? Enumerable.Empty<string>())
                if (Audible(id)) queue.Enqueue(id); else if (!waiting.Contains(id)) waiting.Add(id);
        }
        private void Update()
        {
            for (var i = 0; i < waiting.Count;)
                if (Audible(waiting[i])) { queue.Enqueue(waiting[i]); waiting.RemoveAt(i); } else i++;
            if (playing == null && queue.Count > 0) playing = StartCoroutine(Play());
        }
        private IEnumerator Play()
        {
            yield return null;
            while (queue.Count > 0)
            {
                var id = queue.Dequeue(); var line = Line(id);
                if (line == null) continue;
                var crew = Speaker(line);
                var relative = "Voice/" + director.scenarioId + "/" + id + ".wav";
#if !UNITY_ANDROID || UNITY_EDITOR
                if (!File.Exists(Path.Combine(Application.streamingAssetsPath, relative)))
                { MissingVoice?.Invoke((string)line["text"]); yield return new WaitForSecondsRealtime(MissingSeconds); continue; }
#endif
                using (var request = UnityWebRequestMultimedia.GetAudioClip(StreamingData.Url(relative), AudioType.WAV))
                {
                    yield return request.SendWebRequest();
                    if (request.result != UnityWebRequest.Result.Success)
                    { MissingVoice?.Invoke((string)line["text"]); yield return new WaitForSecondsRealtime(MissingSeconds); continue; }
                    source.clip = DownloadHandlerAudioClip.GetContent(request);
                    Position(crew); source.Play();
                    while (source.isPlaying) { Position(crew); yield return null; }
                    Destroy(source.clip); source.clip = null;
                }
            }
            playing = null;
        }
        private void Position(CrewRig crew)
        {
            source.transform.position = crew != null ? crew.transform.position : dashboard.position;
            source.spatialBlend = 1;
            var scale = presenter ? world.transform.lossyScale.x : 1;
            source.minDistance = 2 * scale; source.maxDistance = 50 * scale;
        }
    }
}
using System;
using System.Collections;
using System.IO;
using System.Linq;
using LOBOver.Sim;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Simulation = LOBOver.Sim.Sim;

namespace LOBOver.Runtime
{
    public sealed class Director : MonoBehaviour
    {
        public string scenarioId = "slice_texas";
        public SiteView SiteView { get; private set; }
        public PlanView PlanView { get; private set; }
        public JObject Job { get; private set; }
        public JObject MachineCatalog { get; private set; }
        public JArray Lines { get; private set; }
        public double DeadlineDay { get; private set; }
        public double TimeDays => simulation == null ? 0 : simulation.T;
        // Same day boundary as Common.DisplayDay; view snapshots use simulation time instead.
        public int DisplayDay => (int)Math.Floor(TimeDays + 1e-6) + 1;
        public string Speed => simulation == null ? "paused" : simulation.Speed;
        public bool Ready => simulation != null;
        public bool Done => simulation != null && simulation.Done;
        // WO-S4 Amendment 1: pausing the script leaves its cursor untouched.
        public bool AutoplanEnabled { get; set; } = true;
        public double ScenarioSecondsPerDay => secondsFull;
        public double SecondsPerDay
        {
            get => playbackSeconds ?? secondsFull;
            set
            {
                if (double.IsNaN(value) || double.IsInfinity(value) || value <= 0)
                    throw new ArgumentOutOfRangeException(nameof(value));
                playbackSeconds = value;
            }
        }
        public string LoadError { get; private set; }
        public string TranscriptPath { get; private set; }
        public event Action Loaded;
        public event Action<SiteView, PlanView> ViewsChanged;
        public event Action<JObject> Message;
        public event Action<JObject> Event;
        public event Action<JObject> Voice;
        public event Action<JObject> Result;

        private Simulation simulation;
        private Scenario scenario;
        private Catalog catalog;
        private Autoplan autoplan;
        private Pacer pacer;
        private Coroutine loading;
        private double secondsFull, secondsSlow;
        private double? playbackSeconds;
        private JObject transcript;
        private JArray snapshots, messages, commands;
        private int lastSnapshot = -1;
        private bool savedResult;

        private void OnEnable() { if (!Ready && loading == null) Load(scenarioId); }

        // Public Start is also Unity's lifecycle method. A slow Android load is started by OnEnable.
        public void Start()
        {
            if (simulation == null || simulation.Done) return;
            Apply("facilitator", new JObject { ["action"] = "start" });
            Publish();
        }
        public void Pause()
        {
            if (simulation == null) return;
            Apply("facilitator", new JObject { ["action"] = "pause" });
            Publish(); SaveTranscript();
        }
        public void Reset()
        {
            if (scenario == null) return;
            SaveTranscript(); Initialize();
        }
        public void Load(string id)
        {
            if (id != "slice_texas" && id != "stage1_texas" && id != "stage2_texas")
                throw new ArgumentException("Unknown scenario: " + id, nameof(id));
            SaveTranscript();
            if (loading != null) StopCoroutine(loading);
            pacer?.Close(); simulation = null; SiteView = null; PlanView = null;
            scenarioId = id; LoadError = null;
            playbackSeconds = null;
            loading = StartCoroutine(LoadFiles());
        }
        private IEnumerator LoadFiles()
        {
            // Let scene subscribers attach before File-backed Editor reads can finish.
            yield return null;
            string catalogText = null, scenarioText = null, scriptText = null;
            Action<string> failed = error => { LoadError = error; Debug.LogError(error, this); };
            yield return StreamingData.ReadText("Data/catalog.json", value => catalogText = value, failed);
            if (LoadError != null) yield break;
            yield return StreamingData.ReadText("Data/Scenarios/" + scenarioId + ".json", value => scenarioText = value, failed);
            if (LoadError != null) yield break;
            var script = scenarioId == "slice_texas" ? "slice_autoplan" : scenarioId == "stage1_texas" ? "stage1_pm_play" : "stage2_pull_play";
            yield return StreamingData.ReadText("Data/scripts/" + script + ".json", value => scriptText = value, failed);
            if (LoadError != null) yield break;
            try
            {
                var source = JObject.Parse(scenarioText);
                catalog = Catalog.Load(catalogText); scenario = Scenario.Load(scenarioText, catalog);
                Job = (JObject)source["job"].DeepClone();
                MachineCatalog = (JObject)JObject.Parse(catalogText)["machines"];
                Lines = (JArray)source["lines"].DeepClone();
                DeadlineDay = (double)source["plan"]["deadlineDay"];
                secondsFull = (double)source["time"]["secondsPerDayFull"];
                secondsSlow = (double)source["time"]["secondsPerDaySlow"];
                if (secondsFull <= 0 || secondsSlow <= 0) throw new InvalidDataException("Scenario day lengths must be positive");
                // Autoplan removes Site entries; the presenter retains every Site verb.
                autoplan = new Autoplan(JArray.Parse(scriptText));
                Initialize();
            }
            catch (Exception error) { failed(error.ToString()); }
            loading = null;
        }
        private void Initialize()
        {
            pacer?.Close(); simulation = Simulation.Create(scenario, catalog); autoplan.Reset();
            snapshots = new JArray(); messages = new JArray(); commands = new JArray();
            transcript = new JObject { ["scenario"] = scenarioId, ["snapshots"] = snapshots,
                ["messages"] = messages, ["commands"] = commands, ["result"] = null };
            TranscriptPath = Path.Combine(Application.persistentDataPath, "transcripts",
                scenarioId + "-" + DateTime.UtcNow.ToString("yyyyMMdd-HHmmss-fff") + ".json");
            lastSnapshot = -1; savedResult = false;
            pacer = new Pacer(() => simulation, AfterTick);
            Loaded?.Invoke();
            if (AutoplanEnabled) autoplan.Advance(simulation.T, Apply);
            Start();
            Drain(); CaptureDay();
        }
        private void Update()
        {
            if (simulation == null) return;
            // Pacer's 5/20-second day cadence is scaled to the scenario's full/slow seconds per day.
            var baselineMs = (Speed == "slow" ? Pacer.SLOW_MS : Pacer.FULL_MS) / Pacer.STEP_DAYS;
            var authoredMs = (Speed == "slow" ? secondsSlow : secondsFull) * 1000;
            // Preserve the authored full/slow ratio when the presenter changes playback speed.
            if (playbackSeconds.HasValue) authoredMs *= playbackSeconds.Value / secondsFull;
            pacer.Advance(UnityEngine.Time.unscaledDeltaTime * 1000 * baselineMs / authoredMs);
            Publish();
        }
        private void AfterTick()
        {
            if (AutoplanEnabled) autoplan.Advance(simulation.T, Apply);
            Drain(); CaptureDay();
            if (simulation.Done && !savedResult) { savedResult = true; SaveTranscript(); }
        }
        private void Apply(string seat, JObject command)
        {
            var reply = simulation.Apply(seat, command);
            commands.Add(new JObject { ["t"] = simulation.T, ["seat"] = seat, ["cmd"] = command.DeepClone() });
            var acknowledgement = JObject.FromObject(reply);
            acknowledgement["t"] = reply.Ok ? "ack" : "nack";
            acknowledgement["id"] = command["id"];
            messages.Add(new JObject { ["t"] = simulation.T, ["message"] = acknowledgement });
            // Only the initiating seat receives its rejection text.
            if (seat == "site") Message?.Invoke(acknowledgement);
            Drain();
        }
        public void Send(JObject command)
        {
            if (simulation == null || command == null) return;
            Apply("site", command); Publish();
        }
        public static bool ForSeat(JObject message, string seat) =>
            message["seats"] is JArray seats && seats.Any(value => (string)value == seat);
        private void Drain()
        {
            foreach (var message in simulation.Drain())
            {
                messages.Add(new JObject { ["t"] = message["day"] ?? new JValue(simulation.T), ["message"] = message.DeepClone() });
                Message?.Invoke(message);
                if ((string)message["t"] == "event") Event?.Invoke(message);
                if ((string)message["t"] == "voice") Voice?.Invoke(message);
                if ((string)message["t"] == "result") Result?.Invoke(message);
            }
        }
        private void Publish()
        {
            SiteView = SiteView.From(simulation.View("site"));
            PlanView = PlanView.From(simulation.View("plan"));
            ViewsChanged?.Invoke(SiteView, PlanView);
        }
        private void CaptureDay()
        {
            var day = (int)Math.Floor(simulation.T + 1e-6);
            if (day == lastSnapshot) return;
            snapshots.Add(simulation.View("facilitator")); lastSnapshot = day;
            SaveTranscript();
        }
        public void SaveTranscript()
        {
            if (transcript == null || simulation == null) return;
            transcript["result"] = simulation.Result;
            try
            {
                Directory.CreateDirectory(Path.GetDirectoryName(TranscriptPath));
                File.WriteAllText(TranscriptPath, transcript.ToString(Formatting.Indented));
            }
            catch (IOException error) { Debug.LogWarning("Transcript: " + error.Message, this); }
            catch (UnauthorizedAccessException error) { Debug.LogWarning("Transcript: " + error.Message, this); }
        }
        private void OnApplicationPause(bool paused) { if (paused) SaveTranscript(); }
        private void OnDisable()
        {
            SaveTranscript();
            if (loading != null) { StopCoroutine(loading); loading = null; }
        }
        private void OnDestroy() { pacer?.Close(); }
    }
}
param([string]$UnityData = 'C:/Program Files/Unity/Hub/Editor/6000.3.8f1/Editor/Data')
$ErrorActionPreference = 'Stop'
$projectRoot = (Resolve-Path (Join-Path $PSScriptRoot '../../..')).Path
Set-Location -LiteralPath $projectRoot
$scratch = Join-Path $PSScriptRoot '.offline'
New-Item -ItemType Directory -Path $scratch -Force | Out-Null
$generated = [System.Collections.Generic.List[string]]::new()
$script:compiledCount = 0
function Compile-Assembly([string]$name, [string]$folder, [string[]]$references, [string]$defines = 'UNITY_EDITOR;UNITY_6000_3_OR_NEWER;UNITY_INCLUDE_TESTS') {
    $output = Join-Path $scratch ($name + '.dll')
    $response = Join-Path $scratch ($name + '.rsp')
    $generated.Add($output)
    $generated.Add($response)
    $argsForCompiler = @('-nologo', '-target:library', '-langversion:9', '-nostdlib+', ('-define:' + $defines), ('-out:"' + $output + '"'))
    foreach ($reference in $references) { $argsForCompiler += '-r:"' + $reference + '"' }
    foreach ($source in (Get-ChildItem -LiteralPath $folder -Recurse -Filter '*.cs')) { $argsForCompiler += '"' + $source.FullName + '"' }
    $argsForCompiler | Set-Content -LiteralPath $response -Encoding UTF8
    & (Join-Path $UnityData 'NetCoreRuntime/dotnet.exe') (Join-Path $UnityData 'DotNetSdkRoslyn/csc.dll') ('@' + $response)
    if ($LASTEXITCODE -ne 0) { throw "Offline compilation failed: $name" }
    $script:compiledCount++
    Write-Output "$name`: 0 errors"
}
try {
    $baseReferences = @((Join-Path $UnityData 'NetStandard/ref/2.1.0/netstandard.dll'))
    $baseReferences += (Get-ChildItem (Join-Path $UnityData 'NetStandard/compat/2.1.0/shims/netfx') -Filter '*.dll').FullName
    $jsonDll = (Get-ChildItem 'Library/PackageCache/com.unity.nuget.newtonsoft-json*/Runtime/Newtonsoft.Json.dll').FullName
    $baseReferences += $jsonDll
    $engineReferences = (Get-ChildItem (Join-Path $UnityData 'Managed/UnityEngine') -Filter '*.dll').FullName
    Compile-Assembly 'LOBOver.Sim' 'Assets/LOBOver/Sim' $baseReferences
    $runtimeReferences = $baseReferences + $engineReferences + @((Join-Path $scratch 'LOBOver.Sim.dll'))
    Compile-Assembly 'LOBOver.Director' 'Assets/LOBOver/Runtime/Director' $runtimeReferences
    $worldReferences = $runtimeReferences + @((Join-Path $scratch 'LOBOver.Director.dll'), 'Library/ScriptAssemblies/Unity.TextMeshPro.dll', 'Library/ScriptAssemblies/Unity.InputSystem.dll', 'Library/ScriptAssemblies/UnityEngine.UI.dll')
    Compile-Assembly 'LOBOver.World' 'Assets/LOBOver/Runtime/World' $worldReferences
    # Compile the conditional Android reader too, without opening the Editor or changing build settings.
    Compile-Assembly 'LOBOver.Director.Android' 'Assets/LOBOver/Runtime/Director' $runtimeReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    Compile-Assembly 'LOBOver.World.Android' 'Assets/LOBOver/Runtime/World' $worldReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
    # SDK assemblies are already installed/imported; this check never restores packages.
    $xrReferences = $worldReferences + @((Join-Path $scratch 'LOBOver.World.dll'),
        'Library/ScriptAssemblies/Oculus.VR.dll', 'Library/ScriptAssemblies/Unity.XR.OpenXR.dll',
        'Library/ScriptAssemblies/Unity.XR.Management.dll')
    foreach ($assembly in @('VR', 'MR', 'Start')) {
        $folder = 'Assets/LOBOver/Runtime/' + $assembly
        if (!(Test-Path -LiteralPath $folder)) { continue }
        Compile-Assembly ('LOBOver.' + $assembly) $folder $xrReferences
        Compile-Assembly ('LOBOver.' + $assembly + '.Android') $folder $xrReferences 'UNITY_ANDROID;UNITY_6000_3_OR_NEWER'
        $xrReferences += (Join-Path $scratch ('LOBOver.' + $assembly + '.dll'))
    }
    $editorReferences = $worldReferences + @((Join-Path $scratch 'LOBOver.World.dll'), 'Library/ScriptAssemblies/Unity.RenderPipelines.Core.Runtime.dll')
    Compile-Assembly 'LOBOver.Editor' 'Assets/LOBOver/Editor' $editorReferences
    $testReferences = $editorReferences + @((Join-Path $scratch 'LOBOver.Editor.dll'), 'Library/ScriptAssemblies/UnityEngine.TestRunner.dll', 'Library/ScriptAssemblies/UnityEditor.TestRunner.dll')
    $testReferences += (Get-ChildItem 'Library/PackageCache/com.unity.ext.nunit*/net40/unity-custom/nunit.framework.dll').FullName
    Compile-Assembly 'LOBOver.EditModeTests' 'Assets/LOBOver/Tests/EditMode' $testReferences
    Compile-Assembly 'LOBOver.PlayModeTests' 'Assets/LOBOver/Tests/PlayMode' $testReferences
    Write-Output "PASS: $script:compiledCount offline assembly compilations; Unity import, tests and rendering still require the Editor."
    $fixtureProgram = Join-Path $scratch 'VerifyFixtures.dll'
    $fixtureResponse = Join-Path $scratch 'VerifyFixtures.rsp'
    $fixtureConfig = Join-Path $scratch 'VerifyFixtures.runtimeconfig.json'
    $fixtureJson = Join-Path $scratch 'Newtonsoft.Json.dll'
    foreach ($file in @($fixtureProgram, $fixtureResponse, $fixtureConfig, $fixtureJson)) { $generated.Add($file) }
    $fixtureArgs = @('-nologo', '-target:exe', '-langversion:9', '-nostdlib+', ('-out:"' + $fixtureProgram + '"'), ('-r:"' + (Join-Path $scratch 'LOBOver.Sim.dll') + '"'))
    foreach ($reference in $baseReferences) { $fixtureArgs += '-r:"' + $reference + '"' }
    $fixtureArgs += '"' + (Join-Path $PSScriptRoot 'VerifyFixtures.cs.txt') + '"'
    $fixtureArgs | Set-Content -LiteralPath $fixtureResponse -Encoding UTF8
    & (Join-Path $UnityData 'NetCoreRuntime/dotnet.exe') (Join-Path $UnityData 'DotNetSdkRoslyn/csc.dll') ('@' + $fixtureResponse)
    if ($LASTEXITCODE -ne 0) { throw 'Fixture verifier did not compile' }
    Copy-Item -LiteralPath (Join-Path $UnityData 'DotNetSdkRoslyn/csc.runtimeconfig.json') -Destination $fixtureConfig
    Copy-Item -LiteralPath $jsonDll -Destination $fixtureJson
    & (Join-Path $UnityData 'NetCoreRuntime/dotnet.exe') $fixtureProgram
    if ($LASTEXITCODE -ne 0) { throw 'Fixture replay failed' }
}
finally {
    # Only exact outputs from this invocation are removed; never traverse another workspace.
    foreach ($file in $generated) { if (Test-Path -LiteralPath $file) { Remove-Item -LiteralPath $file -Force } }
    if ((Get-ChildItem -LiteralPath $scratch -Force | Measure-Object).Count -eq 0) { Remove-Item -LiteralPath $scratch }
}

