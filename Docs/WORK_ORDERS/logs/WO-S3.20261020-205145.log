+                ? new StandardUpgrader(shaderName)
+                : MaterialUpgrader.FetchAllUpgradersForPipeline(typeof(UniversalRenderPipelineAsset)).FirstOrDefault(item => item.OldShaderPath == shaderName);
+            if (upgrader != null)
