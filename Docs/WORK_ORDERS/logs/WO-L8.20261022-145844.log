                    var roof = RoofHeight(model);
                    // Imported nested rigs have inconsistent units. Fit in a parent aligned to site axes.
                    var fit = WorldDrawing.Group("PhysicalSize", root.transform).transform;
                    model.transform.SetParent(fit, true);
