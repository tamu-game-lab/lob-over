using System;
using System.IO;
using System.Linq;
using LOBOver.Editor;
using LOBOver.Play;
using LOBOver.Sim;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using NUnit.Framework;
using Oculus.Interaction;
using Oculus.Interaction.HandGrab;
using UnityEngine;
using UnityEngine.EventSystems;
using Object = UnityEngine.Object;

namespace LOBOver.Tests.Editor
{
    public sealed class StagePresentationTests
    {
        [Test]
        public void GeometryMatchesDrawnBoundsForEveryMachineWorkerAndProp()
        {
            var assets = SitePresentationBuilder.BuildAssets();
            var prefabs = assets.machines.Select(m => m.prefab).Concat(new[]
                { assets.worker, assets.pipe, assets.spoil, assets.cone, assets.barrier, assets.fence, assets.jersey, assets.tree })
                .Where(p => p != null).Distinct();
            foreach (var prefab in prefabs)
            {
                var instance = Object.Instantiate(prefab, Vector3.zero, Quaternion.identity);
                try
                {
                    var renderers = SiteGround.PhysicalRenderers(instance.transform);
                    Assert.That(renderers, Is.Not.Empty, prefab.name);
                    var drawn = renderers[0].bounds;
                    foreach (var renderer in renderers.Skip(1)) drawn.Encapsulate(renderer.bounds);
                    using var geometry = new SiteGround.Geometry(instance.transform);
                    var measured = geometry.Bounds;
                    for (var axis = 0; axis < 3; axis++)
                    {
                        Assert.That(measured.size[axis], Is.EqualTo(drawn.size[axis]).Within(Mathf.Max(0.0001f, drawn.size[axis] * 0.1f)), prefab.name + " size axis " + axis);
                        Assert.That(measured.center[axis], Is.EqualTo(drawn.center[axis]).Within(0.1f), prefab.name + " position axis " + axis);
                    }
                    foreach (var renderer in renderers)
                    {
                        var localToWorld = geometry.RendererLocalBoundsIn(renderer, null);
                        for (var axis = 0; axis < 3; axis++)
                        {
                            Assert.That(localToWorld.min[axis], Is.EqualTo(renderer.bounds.min[axis]).Within(0.1f), renderer.name + " local bounds min " + axis);
                            Assert.That(localToWorld.max[axis], Is.EqualTo(renderer.bounds.max[axis]).Within(0.1f), renderer.name + " local bounds max " + axis);
                        }
                    }
                }
                finally { Object.DestroyImmediate(instance); }
            }
        }
        [Test]
        public void AllMachineVariantsAndWorkersHavePhysicalBounds()
        {
            var assets = SitePresentationBuilder.BuildAssets();
            var sourceWorker = SiteAssetBuilder.Required<WorldAssets>(SiteAssetBuilder.Art + "WorldAssets.asset").worker;
            CollectionAssert.AreEquivalent(sourceWorker.GetComponentsInChildren<SkinnedMeshRenderer>(true).Select(r => r.sharedMesh),
                assets.worker.GetComponentsInChildren<SkinnedMeshRenderer>(true).Select(r => r.sharedMesh), "K50: keep every imported worker mesh");
            foreach (var item in assets.machines)
            {
                var instance = Object.Instantiate(item.prefab);
                try
                {
                    var bounds = SiteModelBuilder.Bounds(instance);
                    var target = SiteModelBuilder.MachineSize(item.crew, item.plate);
                    Assert.That(bounds.size.x, Is.EqualTo(target.x).Within(target.x * 0.1f), item.crew + "/" + item.plate + " length");
                    var roof = SiteModelBuilder.RoofHeight(instance);
                    Assert.That(roof, Is.EqualTo(target.y).Within(target.y * 0.1f), item.crew + "/" + item.plate + " roof");
                    Assert.That(bounds.min.y, Is.EqualTo(0).Within(0.05f));
                }
                finally { Object.DestroyImmediate(instance); }
            }
            foreach (var item in new[] { (assets.worker, new Vector3(0, 1.8f, 0)), (assets.pipe, new Vector3(6, 0.3f, 0.3f)) })
            {
                var instance = Object.Instantiate(item.Item1);
                try
                {
                    var bounds = SiteModelBuilder.Bounds(instance);
                    for (var axis = 0; axis < 3; axis++) if (item.Item2[axis] > 0)
                        Assert.That(bounds.size[axis], Is.EqualTo(item.Item2[axis]).Within(item.Item2[axis] * 0.1f));
                    Assert.That(bounds.min.y, Is.EqualTo(0).Within(0.05f));
                }
                finally { Object.DestroyImmediate(instance); }
            }
        }
        [Test]
        public void EveryVariantWorkerAndPropIsGroundedByItsPhysicalGeometry()
        {
            var assets = SitePresentationBuilder.BuildAssets();
            var prefabs = assets.machines.Select(m => m.prefab).Concat(new[]
                { assets.worker, assets.spoil, assets.cone, assets.barrier, assets.fence, assets.jersey, assets.tree }).Where(p => p != null);
            var terrain = new GameObject("GroundSpace");
            try
            {
                terrain.transform.SetPositionAndRotation(new Vector3(0.8f, 0, -0.4f), Quaternion.Euler(0, 23, 0));
                foreach (var prefab in prefabs) foreach (var position in new[] { new Vector3(3, 0, -4), new Vector3(38, 0, -23) })
                {
                    var obj = Object.Instantiate(prefab, terrain.transform);
                    try
                    {
                        obj.transform.localPosition = position;
                        var placed = GroundedObject.Place(obj, terrain.transform);
                        var bounds = SiteGround.Bounds(obj.transform); var point = terrain.transform.InverseTransformPoint(bounds.center);
                        Assert.That(bounds.min.y, Is.EqualTo(SiteGround.GroundHeight(point.x, point.z)).Within(0.05f), prefab.name);
                        Assert.That(placed.Clearance, Is.EqualTo(0).Within(0.05f), prefab.name);
                    }
                    finally { Object.DestroyImmediate(obj); }
