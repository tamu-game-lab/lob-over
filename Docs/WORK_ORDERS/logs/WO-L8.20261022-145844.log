using System;
using System.Collections.Generic;
using System.Linq;
using UnityEngine;

namespace LOBOver.World
{
    public static class SiteGround
    {
        // WO-L4 ground generator, shared by the builder and WO-L8 placement.
        public const float FlatRadius = 8, Relief = 0.6f, RutDepth = 0.06f;
        public const float MachineBaseHeight = 1.5f; // WO-L8 Amendment 1 (K50): bank clearance excludes the boom.
        public static float Noise(float x, float z) => (Mathf.PerlinNoise(x * 0.017f + 23, z * 0.017f + 73) * 0.57f
            + Mathf.PerlinNoise(x * 0.037f + 9, z * 0.037f + 31) * 0.28f + Mathf.PerlinNoise(x * 0.081f + 59, z * 0.081f + 11) * 0.15f) * 2 - 1;
        public static float GroundHeight(float x, float z)
        {
            var distance = Mathf.Min(Mathf.Abs(z), Mathf.Abs(z - WorldUnits.RoadZ));
            var height = Relief * Noise(x, z) * Mathf.SmoothStep(0, 1, (distance - FlatRadius) / 14);
            var road = z - WorldUnits.RoadZ;
            return height - RutDepth * (Mathf.Exp(-Mathf.Pow((road - 0.85f) / 0.3f, 2)) + Mathf.Exp(-Mathf.Pow((road + 0.85f) / 0.3f, 2)));
        }
        public static Bounds Bounds(Transform root)
        {
            using var geometry = new Geometry(root);
            return geometry.Bounds;
        }
        // Measure the physical model, never its inactive placeholders or alternate LOD boxes.
        // Ignore ancestors above root: the builder also places objects while the site is hidden.
        public static Renderer[] PhysicalRenderers(Transform root)
        {
            var alternates = new HashSet<Renderer>();
            foreach (var group in root.GetComponentsInChildren<LODGroup>(true))
            {
                var levels = group.GetLODs();
                foreach (var level in levels.Skip(1)) foreach (var renderer in level.renderers) alternates.Add(renderer);
                if (levels.Length > 0) foreach (var renderer in levels[0].renderers) alternates.Remove(renderer);
            }
            return root.GetComponentsInChildren<Renderer>(true).Where(r => IsPhysical(r, root) && !alternates.Contains(r)).ToArray();
        }
        public static bool IsPhysical(Renderer renderer, Transform root)
        {
            if (renderer == null || !renderer.enabled || renderer is ParticleSystemRenderer || renderer is LineRenderer
                || renderer.GetComponent<TMPro.TMP_Text>() != null) return false;
            for (var item = renderer.transform; item != null && item != root; item = item.parent)
                if (!item.gameObject.activeSelf) return false;
            return renderer is SkinnedMeshRenderer || renderer.GetComponent<MeshFilter>()?.sharedMesh != null;
        }
        // WO-L8 rejection 2: use Unity's drawn bounds for every physical renderer. Imported
        // readable/skinned vertex coordinates do not share a reliable scale across these rigs.
        public sealed class Geometry : IDisposable
        {
            private readonly Transform root;
            public readonly Renderer[] Renderers;
            public Geometry(Transform root) { this.root = root; Renderers = PhysicalRenderers(root); }
            public Bounds Bounds => BoundsIn(null);
            public Bounds BoundsIn(Transform space)
            {
                var bounds = new Bounds(space == null ? root.position : space.InverseTransformPoint(root.position), Vector3.zero); var found = false;
                foreach (var renderer in Renderers)
                {
                    if (!IsPhysical(renderer, root)) continue;
                    var part = RendererBounds(renderer, space);
                    if (!found) { bounds = part; found = true; } else bounds.Encapsulate(part);
                }
                return bounds;
            }
            public Bounds RendererBounds(Renderer renderer, Transform space = null)
            {
                var world = renderer.bounds;
                if (space == null) return world;
                var local = new Bounds(space.InverseTransformPoint(world.center), Vector3.zero);
                for (var corner = 0; corner < 8; corner++) local.Encapsulate(space.InverseTransformPoint(world.center
                    + Vector3.Scale(world.extents, new Vector3((corner & 1) == 0 ? -1 : 1, (corner & 2) == 0 ? -1 : 1, (corner & 4) == 0 ? -1 : 1))));
                return local;
            }
            public Bounds LowerBodyBoundsIn(Transform space)
            {
                // Clip each drawn part before the union; clipping the whole machine's box
                // would retain the boom's horizontal overhang. Transform local renderer
                // bounds directly so a turned site does not expand a world AABB twice.
                var parts = Renderers.Where(r => IsPhysical(r, root)).Select(r => RendererLocalBoundsIn(r, space)).ToArray();
                if (parts.Length == 0) throw new InvalidOperationException("No physical machine bounds: " + root.name);
                var bottom = parts.Min(p => p.min.y); var top = bottom + MachineBaseHeight;
                var bounds = default(Bounds); var found = false;
                foreach (var part in parts)
                {
                    if (part.min.y > top) continue;
                    var clipped = part;
                    clipped.SetMinMax(part.min, new Vector3(part.max.x, Mathf.Min(part.max.y, top), part.max.z));
                    if (!found) { bounds = clipped; found = true; } else bounds.Encapsulate(clipped);
                }
                return bounds;
            }
            public Bounds RendererLocalBoundsIn(Renderer renderer, Transform space)
            {
                var matrix = (space == null ? Matrix4x4.identity : space.worldToLocalMatrix) * renderer.localToWorldMatrix;
                var source = renderer.localBounds;
                var part = new Bounds(matrix.MultiplyPoint3x4(source.center), Vector3.zero);
                for (var corner = 0; corner < 8; corner++) part.Encapsulate(matrix.MultiplyPoint3x4(source.center
                    + Vector3.Scale(source.extents, new Vector3((corner & 1) == 0 ? -1 : 1, (corner & 2) == 0 ? -1 : 1, (corner & 4) == 0 ? -1 : 1))));
                return part;
            }
            public void Dispose() { }
        }
    }

}
using UnityEngine;

namespace LOBOver.World
{
    // One marker per placed object, not per piece of a machine or cabin. Trench parts have their own depths.
    public sealed class GroundedObject : MonoBehaviour
    {
        public Transform groundSpace;
        public bool followsAnimation;
        private SiteGround.Geometry geometry;
        public static GroundedObject Place(GameObject obj, Transform space, bool animated = false)
        {
            var item = obj.GetComponent<GroundedObject>() ?? obj.AddComponent<GroundedObject>();
            item.groundSpace = space; item.followsAnimation = animated; item.Settle(); return item;
        }
        public float Clearance
        {
            get
            {
                geometry ??= new SiteGround.Geometry(transform);
                var bounds = geometry.Bounds;
                var point = groundSpace.InverseTransformPoint(bounds.center);
                return bounds.min.y - groundSpace.TransformPoint(new Vector3(point.x, SiteGround.GroundHeight(point.x, point.z), point.z)).y;
            }
        }
        public void Settle() { if (groundSpace != null) transform.position -= Vector3.up * Clearance; }
        private void LateUpdate() { if (followsAnimation) Settle(); }
        private void OnDestroy() { geometry?.Dispose(); geometry = null; }
    }
}

