        [UnityTest]
        public IEnumerator PipeStationPreviewStaysInsideQuestBudget()
        {
            var scene = PlaySceneBuilder.Build(false); var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
            var world = site.GetComponentInChildren<SiteWorld>(true); Populate(world, 8);
            foreach (var name in new[] { "Ground", "Horizon" })
            {
                var surface = site.transform.Find(name).GetComponent<Renderer>();
                Assert.That(surface.shadowCastingMode, Is.EqualTo(UnityEngine.Rendering.ShadowCastingMode.Off));
                Assert.That(surface.receiveShadows, Is.True);
            }
            var camera = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Preview").GetComponentInChildren<Camera>();
            var target = new RenderTexture(1440, 1440, 24, RenderTextureFormat.ARGB32);
            var oldTarget = camera.targetTexture; var oldPosition = camera.transform.position; var oldRotation = camera.transform.rotation;
            // Scene view and the rig's centre eye are outside the owned roots. Include
            // hidden Editor cameras too; Scene view may explicitly render even disabled.
            var otherCameras = Resources.FindObjectsOfTypeAll<Camera>().Where(c => c != null && c != camera && !EditorUtility.IsPersistent(c))
                .Select(c => (camera: c, enabled: c.enabled, mask: c.cullingMask, clear: c.clearFlags)).ToArray();
            // OVR hides these at runtime; EditMode must exclude its controller/hand
            // variants from site statistics, restoring every enabled state afterwards.
            var rigRenderers = scene.GetRootGameObjects().SelectMany(r => r.GetComponentsInChildren<OVRCameraRig>(true))
                .SelectMany(r => r.GetComponentsInChildren<Renderer>(true)).Distinct().Where(r => r != null)
                .Select(r => (renderer: r, enabled: r.enabled)).ToArray();
            var crewShadows = world.GetComponentsInChildren<CrewRig>(true).SelectMany(c => c.GetComponentsInChildren<Renderer>(true))
                .Select(r => (renderer: r, mode: r.shadowCastingMode)).ToArray();
            var enabled = camera.enabled; var active = site.activeSelf; var observer = world.sky.observer;
            var gameViewType = typeof(EditorWindow).Assembly.GetType("UnityEditor.GameView", true);
            var gameView = Resources.FindObjectsOfTypeAll(gameViewType).Cast<EditorWindow>().FirstOrDefault();
            var createdGameView = gameView == null; var wasMaximized = gameView != null && gameView.maximized;
            var focusedWindow = EditorWindow.focusedWindow;
            var maximizedWindows = Resources.FindObjectsOfTypeAll<EditorWindow>().Where(w => w != gameView && w.maximized).ToArray();
            try
            {
                // SceneView can render despite a disabled camera. Hide it for the entire
                // measured frame by maximizing Game, then restore the Editor layout below.
                foreach (var window in maximizedWindows) window.maximized = false;
                if (gameView == null) gameView = EditorWindow.GetWindow(gameViewType);
                gameView.Focus(); gameView.maximized = true; gameView.Repaint();
                site.SetActive(true);
                foreach (var entry in otherCameras) if (entry.camera != null)
                { entry.camera.enabled = false; entry.camera.cullingMask = 0; entry.camera.clearFlags = CameraClearFlags.Nothing; }
                foreach (var entry in rigRenderers) if (entry.renderer != null) entry.renderer.enabled = false;
                Debug.Log($"WO-L4 excluded Camera Rig renderers: {rigRenderers.Length} total, {rigRenderers.Count(r => r.enabled)} enabled.");
                // Explicit rendering only: do not also submit this camera from the Game view.
                camera.enabled = false;
                camera.targetTexture = target;
                var x = (float)world.Crew("pipe").StationFt * WorldUnits.MetresPerFoot;
                camera.transform.position = new Vector3(x, 1.65f, WorldUnits.RoadZ);
                camera.transform.rotation = Quaternion.LookRotation(new Vector3(0, -0.12f, -1));
                world.sky.observer = camera.transform;
                foreach (var crew in world.GetComponentsInChildren<CrewRig>(true)) crew.RefreshDistancePresentation(camera.transform);
                yield return null;
                for (var i = 0; i < 3; i++) { camera.Render(); yield return null; }
                var triangles = UnityStats.triangles; var drawCalls = UnityStats.drawCalls;
                Debug.Log($"WO-L4 preview 1440x1440: {triangles} triangles, {drawCalls} draw calls.");
                Assert.That(gameView.maximized, Is.True, "Game view must hide SceneView for the measurement");
                Assert.That(triangles, Is.GreaterThan(0), "No Editor render statistics; run with the Game view visible.");
                Assert.That(drawCalls, Is.GreaterThan(0));
                Assert.That(triangles, Is.LessThan(300000)); Assert.That(drawCalls, Is.LessThan(150));
                camera.transform.LookAt(world.Crew("exc").transform.position + Vector3.up);
                for (var i = 0; i < 3; i++) { camera.Render(); yield return null; }
                Debug.Log($"WO-L4 toward excavator 1440x1440: {UnityStats.triangles} triangles, {UnityStats.drawCalls} draw calls.");
                Assert.That(UnityStats.triangles, Is.GreaterThan(0)); Assert.That(UnityStats.triangles, Is.LessThan(300000));
                Assert.That(UnityStats.drawCalls, Is.GreaterThan(0)); Assert.That(UnityStats.drawCalls, Is.LessThan(150));
            }
            finally
            {
                if (camera != null)
                { camera.targetTexture = oldTarget; camera.transform.SetPositionAndRotation(oldPosition, oldRotation); camera.enabled = enabled; }
                if (world != null && world.sky != null) world.sky.observer = observer;
                foreach (var entry in otherCameras) if (entry.camera != null)
                { entry.camera.enabled = entry.enabled; entry.camera.cullingMask = entry.mask; entry.camera.clearFlags = entry.clear; }
                foreach (var entry in rigRenderers) if (entry.renderer != null) entry.renderer.enabled = entry.enabled;
                foreach (var entry in crewShadows) if (entry.renderer != null) entry.renderer.shadowCastingMode = entry.mode;
                if (world != null) foreach (var lod in world.GetComponentsInChildren<LODGroup>(true)) lod.ForceLOD(-1);
                if (site != null) site.SetActive(active); Object.DestroyImmediate(target);
                if (gameView != null)
                {
                    gameView.maximized = wasMaximized;
                    if (createdGameView) gameView.Close();
                }
                foreach (var window in maximizedWindows) if (window != null) window.maximized = true;
                if (focusedWindow != null) focusedWindow.Focus();

> Docs\LEVEL1.md:34:## In the headset
  Docs\LEVEL1.md:35:
  Docs\LEVEL1.md:36:Revised later on October 21, after the first Level 1 build (WO-L2) was tested: its warp drew a 
mask around the head that stuck as a window, the site was a flat band of colour under a flat sky with white blobs, and 
the view read as a drawing seen through a lens. Decisions K37 to K40; work orders WO-L4 and WO-L5.
  Docs\LEVEL1.md:37:
  Docs\LEVEL1.md:38:- You start in your room, in full passthrough, and can see and talk to the others. Nothing is 
drawn but a panel within arm's reach: the day and three buttons, Ray, digging; Marcus, pipe; Dana, backfill.
  Docs\LEVEL1.md:39:- Touch a button, or point at it and pull the trigger. The site materializes around you where you 
stand: a wave runs outward from your feet across the ground; just behind its front everything is drawn as glowing wire 
and blueprint lines over the room, and a moment later the surfaces fill in, dirt, gravel, steel, the crews, the 
machines, until the room is gone and the sky closes over you. About 1.5 s. You do not move; the site is built around 
you. Going back runs the same wave inward, and the room returns.
  Docs\LEVEL1.md:40:- The site has to look like a site: a textured ground with relief, a real trench with spoil along 
it, bedding and pipe in the bottom, a gravel road with ruts, fences, cones and barriers, the trailer, the crews and 
their machines, a sky with sun and clouds, shadows, and haze toward the horizon. You can look anywhere; nothing frames 
or masks the view.
  Docs\LEVEL1.md:41:- In the site you look and listen. Foremen talk from where they stand; when you arrive, the 
foreman greets you or says what is going on. The only button is Back, on your left wrist.
  Docs\LEVEL1.md:42:
  Docs\LEVEL1.md:43:## On the PC
  Docs\LEVEL1.md:44:
  Docs\LEVEL1.md:45:Revised later on October 21: the first page worked but did not feel like a game (WO-L3).
  Docs\LEVEL1.md:46:
  Docs\LEVEL1.md:47:The Plan seat is the site office. The Line of Balance is a drafting board, inked day by day as the 
reports come in, with the PM's planned lines dashed under it and a ruler sliding down the days. Beside it is the radio 
console: one card per crew with its foreman, machine and speed, and a two-position switch, Go or Hold, that clunks and 
sends a radio chirp. The PM has a face (LOB-Game's portraits) and a speech bubble when a line plays. A calendar tile 
flips each day with a tick; when the field slows the clock pill says so and the radio hisses, and nothing on the page 
says why. A daily report line types itself at the bottom. At the end the result is stamped on the board: the finish 
against the promise and the idle crew-days per crew, with the actual lines over the plan; Run again keeps the previous 
run faint underneath. Nothing on the page shows the live site, money, or a verdict.
  Docs\LEVEL1.md:48:
  Docs\LEVEL1.md:49:## How a run goes
  Docs\LEVEL1.md:50:
  Docs\LEVEL1.md:51:Push, the PM's plan:
  Docs\LEVEL1.md:52:
> Docs\LEVEL1.md:70:Foremen are heard only in the headset; the PM only on the Plan page. Each line plays once. An 
exchange plays turn by turn, each from its speaker's crew, 0.3 s apart, and exchanges never overlap. The texts follow 
`Docs/VOICE.md`: claims, not conclusions.
  Docs\LEVEL1.md:71:
