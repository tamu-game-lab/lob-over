using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.XR;
using Meta.XR.BuildingBlocks;
using Oculus.Interaction;
using Oculus.Interaction.Input;
using Oculus.Interaction.Locomotion;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace LOBOver.Editor
{
    public static class BuildingBlocksSetup
    {
        // SDK core and interaction.ovr Editor/BlockDataIds.cs; names alone never establish block presence.
        private const string InteractionId = "81f55626-5fad-45e9-a1df-184f330da7ba";
        public static readonly string[] DemoNames = { "[BuildingBlock] Cube", "Poke Interaction" };

        [MenuItem("LOB Over/Setup/Check Building Blocks")]
        public static void CheckMenu() => CheckPlay();

        public static bool CheckPlay()
        {
            if (!File.Exists(PlaySceneBuilder.ScenePath))
            { Debug.LogError("LOB Over: Assets/Scenes/Play.unity is missing; Bryan must save his Building Blocks scene there."); return false; }
            var scene = SceneManager.GetSceneByPath(PlaySceneBuilder.ScenePath);
            var preview = !scene.IsValid() || !scene.isLoaded;
            if (preview) scene = EditorSceneManager.OpenPreviewScene(PlaySceneBuilder.ScenePath);
            try { return Check(scene); }
            finally { if (preview) EditorSceneManager.ClosePreviewScene(scene); }
        }

        public static List<string> Missing(Scene scene)
        {
            var missing = new List<string>();
            var rig = XRRig.Components<OVRCameraRig>(scene).FirstOrDefault();
            var blocks = XRRig.Components<BuildingBlock>(scene);
            void Need(bool present, string name) { if (!present) missing.Add(name); }
            Need(rig != null && rig.centerEyeAnchor != null && rig.GetComponent<OVRManager>() != null, "Camera Rig");
            Need(XRRig.Components<OVRPassthroughLayer>(scene).Length > 0, "Passthrough");
            foreach (var side in new[] { Handedness.Left, Handedness.Right })
            {
                var controller = XRRig.Components<FromOVRControllerDataSource>(scene).Any(c => HasSide(c, side))
                    || XRRig.Components<OVRControllerHelper>(scene).Any(c => c.m_controller == (side == Handedness.Left ? OVRInput.Controller.LTouch : OVRInput.Controller.RTouch));
                Need(controller && rig != null && (side == Handedness.Left ? rig.leftControllerAnchor : rig.rightControllerAnchor) != null,
                    "Controller Tracking (" + side.ToString().ToLowerInvariant() + ")");
            }
            Need((blocks.Any(block => block.BlockId == InteractionId) || XRRig.Components<RayInteractor>(scene).Length > 0)
                && XRRig.Components<RayInteractor>(scene).Length > 0 && XRRig.Components<PokeInteractor>(scene).Length > 0, "Interactions Rig");
            foreach (var side in new[] { Handedness.Left, Handedness.Right })
            {
                var hand = XRRig.Components<FromOVRHandDataSource>(scene).Any(c => HasSide(c, side))
                    || XRRig.Components<OVRHand>(scene).Any(c => c.GetHand() == (side == Handedness.Left ? OVRPlugin.Hand.HandLeft : OVRPlugin.Hand.HandRight));
                Need(hand && rig != null && (side == Handedness.Left ? rig.leftHandAnchor : rig.rightHandAnchor) != null,
                    "Hand Tracking (" + side.ToString().ToLowerInvariant() + ")");
            }
            return missing;
        }
        private static bool HasSide(Component source, Handedness side)
        {
            using var serialized = new SerializedObject(source);
            return serialized.FindProperty("_handedness")?.intValue == (int)side;
        }
        public static bool Check(Scene scene, bool level1 = true)
        {
            var missing = Missing(scene);
            foreach (var name in new[] { "Camera Rig", "Passthrough", "Controller Tracking (left)", "Controller Tracking (right)",
                "Interactions Rig", "Hand Tracking (left)", "Hand Tracking (right)" })
            {
                if (missing.Contains(name)) Debug.LogError("LOB Over: MISSING " + name + "; add it from Building Blocks.");
                else Debug.Log("LOB Over: PRESENT " + name);
            }
            foreach (var layer in XRRig.Components<OVRPassthroughLayer>(scene))
                Debug.Log("LOB Over: Passthrough layer " + PathOf(layer.transform) + (layer.GetComponent<OVRCameraRig>() != null ? " (additional rig layer; preserved)" : ""));
            var forbidden = level1 ? Forbidden(scene) : new List<string>();
            foreach (var name in forbidden) Debug.LogError("LOB Over: remove " + name + " in the Building Blocks window before building Play.unity.");
            return missing.Count == 0 && forbidden.Count == 0;
        }
        public static List<string> Forbidden(Scene scene)
        {
            var result = new List<string>();
            if (XRRig.Components<BuildingBlock>(scene).Any(b => b.BlockId == XRRig.RealHandsId)
                || XRRig.Components<Transform>(scene).Any(t => t.name.IndexOf("Real Hands", StringComparison.OrdinalIgnoreCase) >= 0)) result.Add("Real Hands");
            if (XRRig.Components<Component>(scene).Any(c => c != null && c.GetType().Name == "EnableUnpremultipliedAlpha")) result.Add("EnableUnpremultipliedAlpha (Real Hands)");
            var layers = XRRig.Components<OVRPassthroughLayer>(scene);
            if (layers.Length > 1) result.Add("extra Passthrough layers: " + string.Join(", ", layers.Select(l => PathOf(l.transform))));
            result.AddRange(Demos(scene).Select(d => "demo " + PathOf(d.transform)));
            return result;
        }
        public static IEnumerable<GameObject> Demos(Scene scene) => XRRig.Components<Transform>(scene)
            .Where(t => DemoNames.Contains(t.name) || t.name.StartsWith("[BuildingBlock]", StringComparison.Ordinal)
                && t.name.IndexOf("demo", StringComparison.OrdinalIgnoreCase) >= 0).Select(t => t.gameObject);

        [MenuItem("LOB Over/Setup/Configure Building Blocks")]
        public static void ConfigureMenu()
        {
            if (!File.Exists(PlaySceneBuilder.ScenePath)) { CheckPlay(); return; }
            var scene = PlaySceneBuilder.OpenExisting();
            if (!Check(scene)) return;
            Configure(scene);
            EditorSceneManager.SaveScene(scene);
        }
        public static void Configure(Scene scene)
        {
            foreach (var component in XRRig.Components<Behaviour>(scene))
            {
                // Include the SDK's event broadcasters/connections: enabled listeners could still move a disabled locomotor.
                if (component != null && component.GetType().Namespace == "Oculus.Interaction.Locomotion" && BelongsToBlocks(component)) // missing-script components come back null
                {
                    if (component is FirstPersonLocomotor locomotor && locomotor.GravityFactor != 0)
                        Change(locomotor, "GravityFactor", locomotor.GravityFactor, 0f, () => locomotor.GravityFactor = 0);
using UnityEngine;

namespace LOBOver.World
{
    public sealed class SiteSky : MonoBehaviour
    {
        public ParticleSystem rain;
        public Transform cloudBank;
        public Transform observer;
        public Transform dome;
        public LOBOver.XR.XRRig rig;
        public string State { get; private set; }
        public bool Raining => rain.gameObject.activeSelf;
        private WorldAssets assets;
        private AudioSource bed;
        private bool originalFog;
        private Color originalFogColour;
        private float originalFogDensity;
        public void Configure(WorldAssets source)
        {
            assets = source;
            if (bed == null) { bed = WorldDrawing.Sound(gameObject, true); bed.spatialBlend = 0; }
            originalFog = RenderSettings.fog; originalFogColour = RenderSettings.fogColor; originalFogDensity = RenderSettings.fogDensity;
            State = null; Apply("clear");
        }
        public void Apply(string state)
        {
            if (State == state) return;
            State = state; var raining = state == "rain";
            if (dome != null)
            {
                Shader.SetGlobalFloat("_SiteRain", raining ? 1 : 0);
                Shader.SetGlobalFloat("_SiteCloudBank", state == "towersSouth" || raining ? 1 : 0);
            }
            cloudBank.gameObject.SetActive(state == "towersSouth" || raining);
            rain.gameObject.SetActive(raining);
            if (raining && Application.isPlaying) rain.Play();
            RenderSettings.fog = raining || originalFog;
            RenderSettings.fogColor = raining ? new Color(0.48f, 0.5f, 0.52f) : originalFogColour;
            RenderSettings.fogDensity = raining ? 0.006f : originalFogDensity;
            WorldDrawing.Loop(bed, raining ? assets.rainfall : state == "towersSouth" ? assets.wind : null);
        }
        private void LateUpdate()
        {
            if (rig != null) observer = rig.ViewEye;
            if (observer == null) return;
            if (dome != null) dome.position = observer.position;
            rain.transform.position = observer.position + Vector3.up * 12;
            // WO-08: a cumulus billboard bank 2 km south of the site.
            cloudBank.forward = (cloudBank.position - observer.position).normalized;
        }
        private void OnDestroy()
        {
            if (assets == null) return;
            if (dome != null) { Shader.SetGlobalFloat("_SiteRain", 0); Shader.SetGlobalFloat("_SiteCloudBank", 0); }
            RenderSettings.fog = originalFog; RenderSettings.fogColor = originalFogColour; RenderSettings.fogDensity = originalFogDensity;
        }
    }
}
using System;
using TMPro;
using UnityEngine;

namespace LOBOver.World
{
    [Serializable] public sealed class MachineAsset
    {
        public string crew, plate, label;
        public GameObject prefab;
    }
    public sealed class WorldAssets : ScriptableObject
    {
        public StationCell cellPrefab;
        public CrewRig crewPrefab;
        public GameObject worker, particles, spoil, barrier, cone;
        public MachineAsset[] machines;
        public TMP_FontAsset font;
        public Material ink, soil, timber, steel, orange, cloud, rain;
        // WO-L4 assets live under Art so rebuilding Play never rewrites the legacy prefabs.
        public bool detailedSite;
        public GameObject pipe, fence, jersey, tree;
        public Material ground, road, trench, bedding, spoilSurface, wetSoil, waterSurface, backfill, flagging, siteText, cabin, glass, skyMaterial;
        public Mesh groundMesh, horizonMesh, wallNearMesh, wallFarMesh, stripMesh, slumpMesh, windrowMesh;
        public AudioClip wind, rainfall, excavation, dozer, idle, conflict, collapse, pipeSetdown;
        public MachineAsset Machine(string crew, string plate) => Array.Find(machines,
            item => item.crew == crew && string.Equals(item.plate, plate, StringComparison.OrdinalIgnoreCase));
    }

    public static class WorldUnits
    {
        // WO-08 sections 1-3: physical scale and station geometry.
        public const float MetresPerFoot = 0.3048f, StationFeet = 100, CellLength = 30.48f;
        public const float TrenchWidth = 1.2f, TrenchDepth = 1.8f, RoadZ = 6;
        public const float PoseSeconds = 0.5f, DemobBackMetres = 60;
        public static readonly string[] CrewIds = { "exc", "pipe", "back" };
        // Crew identity colours, never status or decision feedback.
        public static readonly Color[] CrewColours = { new Color(0.95f, 0.65f, 0.25f), new Color(0.4f, 0.7f, 1), new Color(0.85f, 0.65f, 0.95f) };
        public static string Station(double feet) => ((int)Math.Floor(feet / 100)) + "+" + ((int)Math.Round(feet % 100)).ToString("00");
    }

    public static class WorldDrawing
    {
        public static GameObject Group(string name, Transform parent)
        {
            var obj = new GameObject(name); obj.transform.SetParent(parent, false); return obj;
        }
        public static GameObject Box(string name, Transform parent, Vector3 position, Vector3 size, Material material)
        {
            var obj = GameObject.CreatePrimitive(PrimitiveType.Cube); obj.name = name;
            obj.transform.SetParent(parent, false); obj.transform.localPosition = position; obj.transform.localScale = size;
            obj.GetComponent<Renderer>().sharedMaterial = material; return obj;
        }
        public static TextMeshPro Text(string name, Transform parent, Vector3 position, Vector2 size, float height, TMP_FontAsset font)
        {
            var obj = Group(name, parent); obj.transform.localPosition = position;
            var text = obj.AddComponent<TextMeshPro>(); text.font = font;
            text.fontSize = height * 10; text.color = new Color(0.95f, 0.94f, 0.9f);
            text.alignment = TextAlignmentOptions.TopLeft; text.rectTransform.sizeDelta = size;
            text.textWrappingMode = TextWrappingModes.Normal; text.overflowMode = TextOverflowModes.Overflow;
            text.richText = false; return text;
        }
        public static LineRenderer Line(string name, Transform parent, Material material, Color colour, float width)
        {
            var line = Group(name, parent).AddComponent<LineRenderer>(); line.useWorldSpace = false;
            line.sharedMaterial = material; line.startColor = line.endColor = colour;
            line.startWidth = line.endWidth = width; line.positionCount = 0;
            line.alignment = LineAlignment.TransformZ; return line;
        }
        public static AudioSource Sound(GameObject obj, bool loop, float distance = 50)
        {
            var audio = obj.AddComponent<AudioSource>(); audio.playOnAwake = false; audio.loop = loop;
            audio.spatialBlend = 1; audio.rolloffMode = AudioRolloffMode.Linear; audio.minDistance = 2; audio.maxDistance = distance;
            return audio;
        }
        public static void Loop(AudioSource audio, AudioClip clip)
        {
            if (audio.clip == clip) return;
            audio.Stop(); audio.clip = clip;
            if (clip != null && Application.isPlaying && audio.isActiveAndEnabled) audio.Play();
        }
        public static void Remove(GameObject obj)
        {
            if (obj == null) return;
            obj.SetActive(false);
            if (Application.isPlaying) UnityEngine.Object.Destroy(obj); else UnityEngine.Object.DestroyImmediate(obj);
        }
    }
}



