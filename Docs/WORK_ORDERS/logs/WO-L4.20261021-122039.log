using System;
using System.IO;
using System.Linq;
using LOBOver.World;
using UnityEditor;
using UnityEngine;
using UnityEngine.Rendering;
using Object = UnityEngine.Object;

namespace LOBOver.Editor
{
    public static class SitePresentationBuilder
    {
        // WO-L4 item 7 / XR_RENDERING.md. Initial corridor length is LEVEL1.md's 3,000 ft.
        private const float SunElevation = 48, FogNear = 300, FogFar = 2500, InitialLength = 3000 * WorldUnits.MetresPerFoot;
        private const int ShadowMapSize = 2048;
        public static readonly Color HorizonColour = new Color(0.68f, 0.73f, 0.75f);
        public static bool DaylightSkyName(string name) => !new[] { "Overcast", "Night", "Dusk", "Sunset", "Space" }
            .Any(word => name.IndexOf(word, StringComparison.OrdinalIgnoreCase) >= 0);
        public static Material SkyMaterial()
        {
            var sky = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "SiteSky.mat", "LOBOver/SiteSky");
            Cubemap cube = null; Material source = null; var direction = Vector3.zero;
            var paths = AssetDatabase.FindAssets("t:Material", new[] { "Assets" }).Select(AssetDatabase.GUIDToAssetPath)
                .Where(p => !p.StartsWith(SiteAssetBuilder.Art, StringComparison.Ordinal) && DaylightSkyName(p)).OrderBy(p => p, StringComparer.Ordinal);
            foreach (var path in paths)
            {
                var candidate = AssetDatabase.LoadAssetAtPath<Material>(path);
                if (candidate == null || candidate.shader == null || !DaylightSkyName(candidate.name)
                    || candidate.shader.name.IndexOf("Skybox", StringComparison.OrdinalIgnoreCase) < 0) continue;
                foreach (var property in candidate.GetTexturePropertyNames())
                    if (candidate.GetTexture(property) is Cubemap found && DaylightSkyName(found.name))
                    { cube = found; source = candidate; direction = CubemapSun(found); break; }
                if (cube != null) break;
            }
            sky.SetTexture("_Cube", cube); sky.SetFloat("_UseCube", cube == null ? 0 : 1);
            sky.SetFloat("_Exposure", source != null && source.HasProperty("_Exposure") ? source.GetFloat("_Exposure") : 1);
            var rotation = source != null && source.HasProperty("_Rotation") ? source.GetFloat("_Rotation") : 0;
            sky.SetFloat("_Rotation", rotation);
            // SiteSky rotates the sampling direction by -rotation around Y; invert it for the light.
            sky.SetVector("_SunDirection", Quaternion.Euler(0, rotation, 0) * direction);
            return sky;
        }
        public static Vector3 CubemapSun(Cubemap cube)
        {
            // A tiny GPU readback also supports non-readable imports, without changing their importers.
            const int size = 64; // Editor-only sun search resolution, not a runtime rendering setting.
            var shader = Shader.Find("Hidden/LOBOver/CubemapSunProbe") ?? throw new InvalidOperationException("Missing cubemap sun probe shader");
            var probe = new Material(shader); probe.SetTexture("_Cube", cube);
            var target = RenderTexture.GetTemporary(size, size, 0, RenderTextureFormat.ARGBFloat, RenderTextureReadWrite.Linear);
            var pixels = new Texture2D(size, size, TextureFormat.RGBAFloat, false, true);
            var previous = RenderTexture.active; var brightest = float.NegativeInfinity; var direction = Vector3.up;
            try
            {
                foreach (var forward in new[] { Vector3.right, Vector3.left, Vector3.up, Vector3.down, Vector3.forward, Vector3.back })
                {
                    var up = Mathf.Abs(forward.y) > 0.5f ? Vector3.forward : Vector3.up;
                    var right = Vector3.Cross(up, forward);
                    probe.SetVector("_FaceForward", forward); probe.SetVector("_FaceRight", right); probe.SetVector("_FaceUp", up);
                    Graphics.Blit(null, target, probe); RenderTexture.active = target;
                    pixels.ReadPixels(new Rect(0, 0, size, size), 0, 0); pixels.Apply();
                    var colors = pixels.GetPixels();
                    for (var y = 0; y < size; y++) for (var x = 0; x < size; x++)
                    {
                        var ray = (forward + right * (2 * (x + 0.5f) / size - 1) + up * (2 * (y + 0.5f) / size - 1)).normalized;
                        if (ray.y <= 0) continue;
                        var color = colors[y * size + x]; var luminance = color.r * 0.2126f + color.g * 0.7152f + color.b * 0.0722f;
                        if (luminance > brightest) { brightest = luminance; direction = ray; }
                    }
                }
                return direction;
            }
            finally { RenderTexture.active = previous; RenderTexture.ReleaseTemporary(target); Object.DestroyImmediate(pixels); Object.DestroyImmediate(probe); }
        }
        public static WorldAssets BuildAssets()
        {
            var legacy = SiteAssetBuilder.Required<WorldAssets>(SiteAssetBuilder.Art + "WorldAssets.asset");
            var path = SiteAssetBuilder.Art + "PlayWorldAssets.asset";
            var assets = AssetDatabase.LoadAssetAtPath<WorldAssets>(path);
            if (assets == null) { assets = ScriptableObject.CreateInstance<WorldAssets>(); AssetDatabase.CreateAsset(assets, path); }
            EditorUtility.CopySerialized(legacy, assets); assets.name = "PlayWorldAssets"; assets.detailedSite = true;
            Directory.CreateDirectory(SiteAssetBuilder.Converted); AssetDatabase.Refresh();
            SiteMaterialBuilder.Prepare(assets); SiteModelBuilder.Populate(assets, legacy);
            assets.groundMesh = SiteGeometryBuilder.Ground(); assets.horizonMesh = SiteGeometryBuilder.HorizonMesh();
            assets.stripMesh = SiteGeometryBuilder.Strip(); assets.wallNearMesh = SiteGeometryBuilder.Wall(1); assets.wallFarMesh = SiteGeometryBuilder.Wall(-1);
            assets.slumpMesh = SiteGeometryBuilder.Collapse(); assets.windrowMesh = SiteGeometryBuilder.Windrow();
            assets.cellPrefab = Cell(assets); assets.crewPrefab = Crew(); assets.particles = Dust(assets);
            EditorUtility.SetDirty(assets); AssetDatabase.SaveAssets(); return assets;
        }
        private static StationCell Cell(WorldAssets assets)
        {
            var root = new GameObject("DetailedStationCell");
            try
            {
                var cell = root.AddComponent<StationCell>(); SiteDetailDrawing.Cell(cell, assets);
                return SiteModelBuilder.SaveIfChanged(root, SiteAssetBuilder.Converted + "Play_StationCell.prefab").GetComponent<StationCell>();
            }
            finally { Object.DestroyImmediate(root); }
        }
        private static CrewRig Crew()
        {
            var root = new GameObject("DetailedCrewRig"); root.AddComponent<CrewRig>();
            try { return SiteModelBuilder.SaveIfChanged(root, SiteAssetBuilder.Converted + "Play_Crew.prefab").GetComponent<CrewRig>(); }
            finally { Object.DestroyImmediate(root); }
        }
        private static GameObject Dust(WorldAssets assets)
        {
            var root = new GameObject("WorkParticles");
            try
            {
                var ps = root.AddComponent<ParticleSystem>(); ps.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
                var main = ps.main; main.loop = true; main.playOnAwake = false; main.startLifetime = 1.8f;
                main.startSpeed = 0.35f; main.startSize = new ParticleSystem.MinMaxCurve(0.15f, 0.45f);
                main.startColor = new Color(0.65f, 0.52f, 0.36f, 0.35f); main.maxParticles = 60;
                var emission = ps.emission; emission.rateOverTime = 18;
                var shape = ps.shape; shape.shapeType = ParticleSystemShapeType.Box; shape.scale = new Vector3(2, 0.15f, 1);
                var alpha = ps.colorOverLifetime; alpha.enabled = true;
                var gradient = new Gradient(); gradient.SetKeys(new[] { new GradientColorKey(Color.white, 0), new GradientColorKey(Color.white, 1) },
                    new[] { new GradientAlphaKey(0, 0), new GradientAlphaKey(0.6f, 0.15f), new GradientAlphaKey(0, 1) }); alpha.color = gradient;
                root.transform.localPosition = new Vector3(-1, 0.2f, 0);
                var renderer = ps.GetComponent<ParticleSystemRenderer>(); renderer.sharedMaterial = assets.ink;
                renderer.shadowCastingMode = ShadowCastingMode.Off; renderer.receiveShadows = false;
                return SiteModelBuilder.SaveIfChanged(root, SiteAssetBuilder.Converted + "Play_WorkParticles.prefab");
            }
            finally { Object.DestroyImmediate(root); }
        }
        public static SiteSky Build(Transform site, WorldAssets assets)
        {
            var ground = SiteDetailDrawing.Mesh("Ground", site, assets.groundMesh, assets.ground);
            SiteDetailDrawing.Mesh("Horizon", site, assets.horizonMesh, assets.ground);
            // Seal the corridor beyond the longest authored site without covering host-driven cells.
            var after = SiteDetailDrawing.Mesh("BeyondTrench", site, assets.stripMesh, assets.soil, new Vector3(InitialLength, 0, 0));
            after.transform.localScale = new Vector3((SiteGeometryBuilder.MaxX - InitialLength) / WorldUnits.CellLength, 1, 1);
            var sky = Sky(site, assets);
            var trailer = WorldDrawing.Group("Trailer", site).transform; trailer.localPosition = new Vector3(-16, 0, 12);
            SiteDetailDrawing.Block("Cabin", trailer, new Vector3(0, 1.5f, 0), new Vector3(7, 3, 2.8f), assets.cabin);
            SiteDetailDrawing.Block("Roof", trailer, new Vector3(0, 3.08f, 0), new Vector3(7.25f, 0.16f, 3), assets.steel);
            SiteDetailDrawing.Block("DoorFrame", trailer, new Vector3(-1.7f, 1.15f, -1.43f), new Vector3(1.05f, 2.3f, 0.06f), assets.steel);
            SiteDetailDrawing.Block("Door", trailer, new Vector3(-1.7f, 1.15f, -1.47f), new Vector3(0.9f, 2.18f, 0.025f), assets.cabin);
            SiteDetailDrawing.Block("DoorHandle", trailer, new Vector3(-1.36f, 1.1f, -1.5f), new Vector3(0.04f, 0.18f, 0.04f), assets.steel);
            SiteDetailDrawing.Block("WindowFrame", trailer, new Vector3(1.35f, 1.75f, -1.44f), new Vector3(2.1f, 1.25f, 0.08f), assets.steel);
            SiteDetailDrawing.Block("Window", trailer, new Vector3(1.35f, 1.75f, -1.49f), new Vector3(1.94f, 1.09f, 0.02f), assets.glass);
            foreach (var x in new[] { -2.5f, 2.5f }) SiteDetailDrawing.Block("Support", trailer, new Vector3(x, 0.12f, 0), new Vector3(0.4f, 0.24f, 2.4f), assets.steel);
            foreach (var z in new[] { WorldUnits.RoadZ - 3, WorldUnits.RoadZ + 3 })
                SiteDetailDrawing.Prop(assets.jersey, site, new Vector3(-8, 0, z));
            if (assets.tree != null)
            {
                // WO-L4: fewer than thirty instances, 80..120 m on the far side, with gaps.
                for (var i = 0; i < 24; i++)
                {
                    if (i % 7 == 3) continue;
                    var tree = SiteDetailDrawing.Prop(assets.tree, site, new Vector3(-70 + i * 49, 0, -80 - i * 17 % 40));
                    tree.transform.localPosition += Vector3.up * SiteGeometryBuilder.Height(tree.transform.localPosition.x, tree.transform.localPosition.z);
                    tree.transform.localRotation = Quaternion.Euler(0, i * 137, 0);
                }
            }
            foreach (var renderer in site.GetComponentsInChildren<MeshRenderer>(true))
            {
                if (renderer.transform.IsChildOf(sky.transform)) continue;
                // Trees remain instanced. The ground and cabin are builder-owned static geometry.
                if (renderer.GetComponentInParent<LODGroup>() != null || renderer.transform.root != site.root) continue;
                if (!renderer.transform.IsChildOf(trailer) && renderer.gameObject != ground && renderer.name != "Horizon" && renderer.name != "BeyondTrench") continue;
                GameObjectUtility.SetStaticEditorFlags(renderer.gameObject, StaticEditorFlags.BatchingStatic);
            }
            return sky;
        }
        private static SiteSky Sky(Transform parent, WorldAssets assets)
        {
            var root = WorldDrawing.Group("SiteSky", parent); var sky = root.AddComponent<SiteSky>();
            var dome = GameObject.CreatePrimitive(PrimitiveType.Sphere); dome.name = "SiteBackdrop"; dome.transform.SetParent(root.transform, false);
            dome.transform.localPosition = new Vector3(500, 0, 0); dome.transform.localScale = Vector3.one * 10000;
            Object.DestroyImmediate(dome.GetComponent<Collider>());
            var renderer = dome.GetComponent<Renderer>(); renderer.sharedMaterial = assets.skyMaterial;
            renderer.shadowCastingMode = ShadowCastingMode.Off; renderer.receiveShadows = false;
            sky.dome = dome.transform;
            sky.cloudBank = WorldDrawing.Group("CloudBank", root.transform).transform;
            var rain = WorldDrawing.Group("Rain", root.transform).AddComponent<ParticleSystem>();
            rain.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
            var main = rain.main; main.loop = true; main.playOnAwake = false; main.startLifetime = 1.2f; main.startSpeed = 24;
            main.startSize = 0.025f; main.maxParticles = 1200; main.simulationSpace = ParticleSystemSimulationSpace.World;
            var emission = rain.emission; emission.rateOverTime = 800;
            var shape = rain.shape; shape.shapeType = ParticleSystemShapeType.Box; shape.scale = new Vector3(24, 24, 1);
            rain.transform.localRotation = Quaternion.Euler(90, 0, 0);
            var particles = rain.GetComponent<ParticleSystemRenderer>(); particles.sharedMaterial = assets.rain;
            particles.renderMode = ParticleSystemRenderMode.Stretch; particles.lengthScale = 5; particles.velocityScale = 0.02f;
            particles.shadowCastingMode = ShadowCastingMode.Off; sky.rain = rain; rain.gameObject.SetActive(false); return sky;
        }
        public static void Lighting(Light sun)
        {
            sun.transform.rotation = Quaternion.Euler(SunElevation, -35, 0); sun.color = new Color(1, 0.93f, 0.82f);
            var sky = AssetDatabase.LoadAssetAtPath<Material>(SiteMaterialBuilder.Folder + "SiteSky.mat");
            if (sky != null && sky.GetFloat("_UseCube") > 0.5f)
            {
                Vector3 direction = sky.GetVector("_SunDirection");
                sun.transform.rotation = Quaternion.LookRotation(-direction, Mathf.Abs(direction.y) > 0.99f ? Vector3.forward : Vector3.up);
            }
            sun.intensity = 1.2f; sun.shadows = LightShadows.Soft; sun.shadowCustomResolution = ShadowMapSize;
            RenderSettings.sun = sun; RenderSettings.ambientMode = AmbientMode.Trilight;
            RenderSettings.ambientSkyColor = new Color(0.49f, 0.59f, 0.70f);
            RenderSettings.ambientEquatorColor = HorizonColour * 0.65f; RenderSettings.ambientGroundColor = new Color(0.24f, 0.20f, 0.16f);
            RenderSettings.fog = true; RenderSettings.fogMode = FogMode.Linear; RenderSettings.fogColor = HorizonColour;
            RenderSettings.fogStartDistance = FogNear; RenderSettings.fogEndDistance = FogFar;
        }
    }
}
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.World;
using UnityEditor;
using UnityEngine;
using UnityEngine.Rendering;
using Object = UnityEngine.Object;

namespace LOBOver.Editor
{
    public static class SiteModelBuilder
    {
        private const float ScaleTolerance = 0.25f, WorkerHeight = 1.8f, CabHeight = 3.2f, PipeDiameter = 0.3f; // WO-L4 item 10.
        private const int TreeTriangleLimit = 8000; // WO-L4 item 6, strict upper bound.
        public static Bounds Bounds(GameObject root)
        {
            var renderers = root.GetComponentsInChildren<Renderer>(true).Where(r => !(r is ParticleSystemRenderer)).ToArray();
            if (renderers.Length == 0) throw new InvalidOperationException("Imported model has no renderer: " + root.name);
            var bounds = renderers[0].bounds; foreach (var renderer in renderers.Skip(1)) bounds.Encapsulate(renderer.bounds); return bounds;
        }
        public static GameObject Copy(GameObject source, string name, float height = 0, bool pipe = false, WorldAssets assets = null)
        {
            if (source == null) throw new FileNotFoundException("Required model " + name);
            var root = new GameObject(name);
            try
            {
                var model = (GameObject)PrefabUtility.InstantiatePrefab(source); model.transform.SetParent(root.transform, false);
                if (PrefabUtility.IsPartOfPrefabInstance(model)) PrefabUtility.UnpackPrefabInstance(model, PrefabUnpackMode.Completely, InteractionMode.AutomatedAction);
                SiteAssetBuilder.StripMissing(model);
                foreach (var collider in root.GetComponentsInChildren<Collider>(true)) Object.DestroyImmediate(collider);
                foreach (var light in root.GetComponentsInChildren<Light>(true)) Object.DestroyImmediate(light);
                var bounds = Bounds(model);
                if ((name.Contains("Fence") || name.Contains("Jersey") || name.Contains("Barrier")) && bounds.size.z > bounds.size.x)
                {
                    // The OBJ modules are authored along Z; the road and fence run along X.
                    model.transform.localRotation *= Quaternion.Euler(0, 90, 0); bounds = Bounds(model);
                }
                if (pipe)
                {
                    if (bounds.size.z > bounds.size.x) model.transform.localRotation *= Quaternion.Euler(0, 90, 0);
                    else if (bounds.size.y > bounds.size.x) model.transform.localRotation *= Quaternion.Euler(0, 0, 90);
                    bounds = Bounds(model); var diameter = Mathf.Max(bounds.size.y, bounds.size.z);
                    ScaleLog(name + " outside diameter", diameter, PipeDiameter); model.transform.localScale *= PipeDiameter / diameter;
                }
                else if (height > 0)
                {
                    var measured = bounds.size.y;
                    if (name.StartsWith("Excavator", StringComparison.Ordinal))
                    {
                        var cab = model.GetComponentsInChildren<Renderer>(true).Where(r => r.name.IndexOf("cab", StringComparison.OrdinalIgnoreCase) >= 0).ToArray();
                        if (cab.Length > 0) measured = cab.Max(r => r.bounds.max.y) - bounds.min.y;
                    }
                    ScaleLog(name + " height", measured, height); model.transform.localScale *= height / Mathf.Max(measured, 0.001f);
                }
                bounds = Bounds(model);
                model.transform.position -= new Vector3(name.StartsWith("Excavator", StringComparison.Ordinal) || name.StartsWith("Crane", StringComparison.Ordinal)
                    || name.StartsWith("Backfill", StringComparison.Ordinal) ? bounds.max.x : bounds.center.x, bounds.min.y, bounds.center.z);
                SiteMaterialBuilder.Convert(root); Maps(root, AssetDatabase.GetAssetPath(source), assets);
                foreach (var renderer in root.GetComponentsInChildren<Renderer>(true))
                { renderer.receiveShadows = true; renderer.shadowCastingMode = ShadowCastingMode.On; }
                return SaveIfChanged(root, SiteAssetBuilder.Converted + "Play_" + name + ".prefab");
            }
            finally { Object.DestroyImmediate(root); }
        }
        public static GameObject SaveIfChanged(GameObject root, string path)
        {
            var previous = AssetDatabase.LoadAssetAtPath<GameObject>(path);
            // Saving an equivalent unpacked hierarchy can reassign duplicate-named FBX
            // children to different local IDs. Compare content before invoking the saver.
            if (previous != null && SameContent(root, previous)) return previous;
            return PrefabUtility.SaveAsPrefabAsset(root, path);
        }
        public static bool SameContent(GameObject candidate, GameObject previous)
        {
            var references = new Dictionary<Object, Object>();
            bool Pair(Transform a, Transform b)
            {
                if (a.childCount != b.childCount) return false;
                references.Add(a.gameObject, b.gameObject);
                var ac = a.GetComponents<Component>(); var bc = b.GetComponents<Component>();
                if (ac.Length != bc.Length) return false;
                for (var i = 0; i < ac.Length; i++)
                {
                    if (ac[i] == null || bc[i] == null || ac[i].GetType() != bc[i].GetType()) return false;
                    references.Add(ac[i], bc[i]);
                }
                for (var i = 0; i < a.childCount; i++) if (!Pair(a.GetChild(i), b.GetChild(i))) return false;
                return true;
            }
            if (!Pair(candidate.transform, previous.transform)) return false;
            foreach (var pair in references)
            {
                using var a = new SerializedObject(pair.Key); using var b = new SerializedObject(pair.Value);
                var property = a.GetIterator();
                while (property.Next(true))
                {
                    // Prefab linkage and temporary hide flags describe storage, not content.
                    if (property.propertyPath == "m_CorrespondingSourceObject" || property.propertyPath == "m_PrefabInstance"
                        || property.propertyPath == "m_PrefabAsset" || property.propertyPath == "m_ObjectHideFlags") continue;
                    var other = b.FindProperty(property.propertyPath);
                    if (other == null || property.propertyType != other.propertyType) return false;
                    if (property.propertyType == SerializedPropertyType.ObjectReference)
                    {
                        var reference = property.objectReferenceValue;
                        if (reference != null && references.TryGetValue(reference, out var mapped)) reference = mapped;
                        if (reference != other.objectReferenceValue) return false;
                    }
                    // Container equality includes transient instance IDs; compare its leaves instead.
                    else if (property.propertyType != SerializedPropertyType.Generic && !SerializedProperty.DataEquals(property, other)) return false;
                }
            }
            return true;
        }
        private static GameObject BuiltModel(string name, Mesh mesh, Material material)
        {
            var root = new GameObject(name);
            try
            {
                root.AddComponent<MeshFilter>().sharedMesh = mesh;
                root.AddComponent<MeshRenderer>().sharedMaterial = material;
                return SaveIfChanged(root, SiteAssetBuilder.Converted + "Play_" + name + ".prefab");
            }
            finally { Object.DestroyImmediate(root); }
        }
        private static GameObject Pipe(WorldAssets assets)
        {
            var material = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "LaidPipe.mat", "LOBOver/SiteLit");
            material.shaderKeywords = Array.Empty<string>(); material.SetFloat("_World", 0); material.SetFloat("_Splat", 0);
            var root = new GameObject("PipeMaps");
            try
            {
                root.AddComponent<MeshRenderer>().sharedMaterial = material;
                Maps(root, SiteAssetBuilder.Imported + "3D_Models/pipe/source/PIPE.fbx", assets);
            }
            finally { Object.DestroyImmediate(root); }
            return BuiltModel("Pipe", SiteGeometryBuilder.Pipe(), material);
        }
        private static void ScaleLog(string name, float measured, float target)
        {
            if (Mathf.Abs(measured / target - 1) > ScaleTolerance)
                Debug.LogWarning($"WO-L4 scale: {name} was {measured:F3} m; scaled to {target:F3} m (over 25% off).");
        }
        public static GameObject Model(string path, string name, float height, WorldAssets assets, bool optional = false, bool pipe = false)
        {
            var source = AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Imported + path);
            if (source == null && optional) { Debug.LogWarning("WO-L4 optional import missing: " + path + "; rerun Play Scene after import."); return null; }
            return Copy(source, name, height, pipe, assets);
        }
        public static void Populate(WorldAssets assets, WorldAssets legacy)
        {
            assets.worker = Copy(legacy.worker, "Worker", WorkerHeight, assets: assets);
            assets.machines = legacy.machines.Select(m => new MachineAsset { crew = m.crew, label = m.label, plate = m.plate,
                prefab = Copy(m.prefab, m.prefab.name, m.crew == "exc" ? CabHeight : 0, assets: assets) }).ToArray();
            assets.pipe = Pipe(assets);
            assets.spoil = BuiltModel("HeroSpoil", SiteGeometryBuilder.HeroPile(), assets.spoilSurface);
            assets.cone = Copy(legacy.cone, "Cone", 0.7f, assets: assets);
            assets.barrier = Copy(legacy.barrier, "WaterBarrier", 1, assets: assets);
            const string props = "3D_Models/Construction Assets/Traffic Props/";
            assets.fence = Model(props + "fence_long/fence_long.obj", "Fence", 1.8f, assets);
            assets.jersey = Model(props + "jersey_barrier/jersey_barrier.obj", "Jersey", 0.9f, assets);
            // Convert every material in the four additions, including FBX subassets, without
            // changing importers or remaps in the read-only LOBGame copies.
            foreach (var folder in new[] { "Tree", "sophiaImports", "traffic-props", "construction-site-barrier" })
            {
                var path = SiteAssetBuilder.Imported + "3D_Models/" + folder;
                if (!AssetDatabase.IsValidFolder(path)) { Debug.LogWarning("WO-L4 optional import missing: " + path); continue; }
                foreach (var guid in AssetDatabase.FindAssets("", new[] { path }).OrderBy(g => g, StringComparer.Ordinal))
                    foreach (var material in AssetDatabase.LoadAllAssetsAtPath(AssetDatabase.GUIDToAssetPath(guid)).OfType<Material>()) SiteMaterialBuilder.Copy(material);
            }
            var newFence = Model("3D_Models/traffic-props/source/Traffic Props/Traffic Props/fence_long/fence_long.obj", "AddedFence", 1.8f, assets, true);
            if (newFence != null) assets.fence = newFence;
            var newBarrier = Model("3D_Models/construction-site-barrier/source/blocker.fbx", "ConstructionBarrier", 1, assets, true);
            if (newBarrier != null) assets.barrier = newBarrier;
            assets.tree = Tree(assets);
        }
        public static int Triangles(GameObject model) => model.GetComponentsInChildren<MeshFilter>(true).Sum(f => f.sharedMesh == null ? 0 : Enumerable.Range(0, f.sharedMesh.subMeshCount).Sum(i => (int)f.sharedMesh.GetIndexCount(i) / 3))
            + model.GetComponentsInChildren<SkinnedMeshRenderer>(true).Sum(r => r.sharedMesh == null ? 0 : r.sharedMesh.triangles.Length / 3);
        private static GameObject Tree(WorldAssets assets)
        {
            var paths = new[] { "Tree 2/fast-urban-tree/source/Fast-tree.fbx", "Tree 2/beech/beech.fbx", "Tree1/tree/source/TreeGenerator.fbx" };
            var candidate = paths.Select(p => AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Imported + "3D_Models/Tree/" + p))
                .Where(m => m != null && Triangles(m) > 0 && Triangles(m) < TreeTriangleLimit).OrderBy(Triangles).ThenBy(m => m.name, StringComparer.Ordinal).FirstOrDefault();
            if (candidate == null) { Debug.LogWarning("WO-L4: no imported tree below 8,000 triangles; tree line omitted until import."); return null; }
            Debug.Log("WO-L4 tree: " + candidate.name + ", " + Triangles(candidate) + " triangles.");
            return Copy(candidate, "Tree", assets: assets);
        }
        private static void Maps(GameObject root, string path, WorldAssets assets)
        {
            if (assets == null) return;
            if (path.Contains("a-pile-of-sand"))
            {
                // The hero keeps its scan UVs; only the procedural windrow uses world tiling.
                var scan = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "HeroSpoil.mat", "LOBOver/SiteLit");
                scan.CopyPropertiesFromMaterial(assets.spoilSurface); scan.DisableKeyword("_WORLD"); scan.SetFloat("_World", 0);
                foreach (var r in root.GetComponentsInChildren<Renderer>()) r.sharedMaterials = r.sharedMaterials.Select(_ => scan).ToArray();
                return;
            }
            var folder = Path.GetDirectoryName(path).Replace('\\', '/');
            if (path.Contains("/pipe/")) folder = SiteAssetBuilder.Imported + "3D_Models/pipe/textures";
            if (path.Contains("fast-urban-tree")) folder = SiteAssetBuilder.Imported + "3D_Models/Tree/Tree 2/fast-urban-tree/textures";
            if (path.Contains("Tree1/tree")) folder = SiteAssetBuilder.Imported + "3D_Models/Tree/Tree1/tree/textures";
            if (path.Contains("/beech/"))
            {
                // The FBX 6.1 file binds textures to Tree_0 (bark) and Tree_1 (leaf),
                // without named Material nodes. Keep those two surfaces distinct on import.
                foreach (var renderer in root.GetComponentsInChildren<Renderer>())
                {
                    var leaf = renderer.name.Contains("Tree_1");
                    var material = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + (leaf ? "BeechLeaf.mat" : "BeechBark.mat"), "LOBOver/SiteLit");
                    if (renderer.sharedMaterial != null) material.CopyPropertiesFromMaterial(renderer.sharedMaterial);
                    renderer.sharedMaterials = renderer.sharedMaterials.Select(_ => material).ToArray();
                }
            }
            foreach (var material in root.GetComponentsInChildren<Renderer>().SelectMany(r => r.sharedMaterials).Distinct())
            {
                var albedo = SiteMaterialBuilder.Texture(folder, path.Contains("fast-urban-tree") ? "Fastcolor" : "BaseColor") ?? SiteMaterialBuilder.Texture(folder, "Albedo");
                var normal = SiteMaterialBuilder.Texture(folder, "Normal");
                if (path.Contains("/beech/"))
                {
                    var leaf = material.name.IndexOf("leaf", StringComparison.OrdinalIgnoreCase) >= 0;
                    albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(folder + (leaf ? "/beech leaf.png" : "/bark01.png"));
                    normal = SiteMaterialBuilder.Texture(folder, leaf ? "leaf_Normal" : "bark01_normal");
                }
                if (albedo != null) { material.SetTexture("_BaseMap", albedo); material.SetColor("_BaseColor", Color.white); }
                if (normal != null) material.SetTexture("_BumpMap", SiteTextureBuilder.LinearCopy(normal, true));
                var occlusion = SiteMaterialBuilder.Texture(folder, "Occlusion");
                if (occlusion != null)
                {
                    var map = SiteTextureBuilder.LinearCopy(occlusion, false);
                    if (material.GetTexture("_OcclusionMap") != map) material.SetFloat("_OcclusionFromMask", 0);
                    material.SetTexture("_OcclusionMap", map);
                }
                SiteMaterialBuilder.PackOcclusion(material);
                if (path.Contains("/pipe/"))
                {
                    var metallic = SiteTextureBuilder.LinearCopy(SiteMaterialBuilder.Texture(folder, "Metallic"), false);
                    var roughness = SiteTextureBuilder.LinearCopy(SiteMaterialBuilder.Texture(folder, "Roughness"), false);
                    if (metallic != null && roughness != null)
                    { material.SetTexture("_MetallicGlossMap", SiteTextureBuilder.MetallicRoughness(metallic, roughness)); material.SetFloat("_Smoothness", 1); material.EnableKeyword("_METALLICSPECGLOSSMAP"); }
                }
                if (path.Contains("/Tree/"))
                {
                    var leaf = material.name.IndexOf("leaf", StringComparison.OrdinalIgnoreCase) >= 0;
                    var alpha = path.Contains("/beech/") && !leaf ? null : SiteMaterialBuilder.Texture(folder, path.Contains("fast-urban-tree") ? "Fastmask" : "leaf_alpha");
                    material.SetTexture("_AlphaMap", SiteTextureBuilder.LinearCopy(alpha, false)); material.SetFloat("_UseAlphaMap", alpha == null ? 0 : 1);
                    if (alpha != null && material.GetTexture("_BaseMap") is Texture2D color)
                        material.SetTexture("_BaseMap", SiteTextureBuilder.PackOpacity(color, SiteTextureBuilder.LinearCopy(alpha, false)));
                    material.EnableKeyword("_ALPHATEST_ON"); material.SetFloat("_AlphaClip", 1); material.SetFloat("_Cull", 0);
                }
                EditorUtility.SetDirty(material);
            }
        }
    }
}
Shader "LOBOver/SiteSky"
{
    Properties
    {
        _Cube ("Imported sky", Cube) = "" {}
        _UseCube ("Use imported sky", Float) = 0
        _Exposure ("Exposure", Float) = 1
        _Rotation ("Cubemap rotation", Float) = 0
        [HideInInspector] _SunDirection ("Cubemap sun direction", Vector) = (0,1,0,0)
        _Zenith ("Zenith", Color) = (0.16,0.32,0.53,1)
        _Horizon ("Horizon haze", Color) = (0.68,0.73,0.75,1)
    }
    SubShader
    {
        Tags { "RenderPipeline"="UniversalPipeline" "Queue"="Background" "RenderType"="Opaque" }
        Pass
        {
            Cull Front ZWrite Off ZTest LEqual
            HLSLPROGRAM
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma multi_compile_instancing
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
            TEXTURECUBE(_Cube); SAMPLER(sampler_Cube);
            CBUFFER_START(UnityPerMaterial)
                half4 _Zenith, _Horizon;
                float _UseCube, _Exposure, _Rotation;
            CBUFFER_END
            // Weather is shared by the dome and all site surfaces, including future materialization.
            float _SiteRain, _SiteCloudBank;
            struct Attributes { float4 positionOS : POSITION; UNITY_VERTEX_INPUT_INSTANCE_ID };
            struct Varyings { float4 positionCS : SV_POSITION; float3 direction : TEXCOORD0; UNITY_VERTEX_OUTPUT_STEREO };
            float Hash(float2 p) { return frac(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
            float Noise(float2 p)
            {
                float2 i=floor(p), f=frac(p); f=f*f*(3-2*f);
                return lerp(lerp(Hash(i),Hash(i+float2(1,0)),f.x),lerp(Hash(i+float2(0,1)),Hash(i+1),f.x),f.y);
            }
            float Fbm(float2 p) { return Noise(p)*0.57+Noise(p*2.03)*0.28+Noise(p*4.07)*0.15; }
            Varyings Vert(Attributes input)
            {
                Varyings output; UNITY_SETUP_INSTANCE_ID(input); UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);
                output.positionCS=TransformObjectToHClip(input.positionOS.xyz);
                output.positionCS.z=UNITY_RAW_FAR_CLIP_VALUE*output.positionCS.w;
                output.direction=TransformObjectToWorldDir(input.positionOS.xyz); return output;
            }
            half4 Frag(Varyings input) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(input);
                float3 d=normalize(input.direction);
                half3 col=lerp(_Horizon.rgb,_Zenith.rgb,pow(saturate(d.y),0.45));
                if (_UseCube>0.5)
                {
                    float a=radians(_Rotation); float s=sin(a), c=cos(a);
                    float3 q=float3(c*d.x-s*d.z,d.y,s*d.x+c*d.z);
                    col=SAMPLE_TEXTURECUBE(_Cube,sampler_Cube,q).rgb*_Exposure;
                }
                else
                {
                    float2 uv=d.xz/max(0.12,d.y);
                    float cloud=Fbm(uv*1.2+_Time.y*float2(0.002,0.0007));
                    cloud=lerp(cloud,Fbm(uv*2.7+_Time.y*float2(-0.001,0.0015)),0.3);
                    col=lerp(col,half3(0.91,0.91,0.88),smoothstep(0.5,0.72,cloud)*smoothstep(0,0.15,d.y));
                }
                Light sun=GetMainLight(); float alignment=saturate(dot(d,sun.direction));
                col+=sun.color*(pow(alignment,1100)*0.8+pow(alignment,48)*0.12)*(1-_SiteRain);
                float bank=smoothstep(0.25,0.8,-d.z)*(1-smoothstep(0.12,0.42,d.y));
                col=lerp(col,half3(0.36,0.40,0.44),saturate(_SiteCloudBank*bank*0.7+_SiteRain*0.45));
