+    lineIds.add(line?.id);
+  });
+  array(scenario.inbox, '$.inbox', true).forEach((item, index) => {
+    if (!Number.isFinite(item?.day) || item.day < FIRST_DAY) {
+      add('INBOX_DAY', `$.inbox[${index}].day`, `must be at least ${FIRST_DAY}`);
+    }
+  });
+  return { ok: problems.length === 0, problems, toValidate };
+}
+
+export function formatProblem({ id, path, message }) {
+  return `[${id}] ${path}: ${message}`.replace(/[\r\n]+/g, ' ');
+}
+
+function main(args) {
+  if (args.length !== 1 || args[0].startsWith('-')) {
+    console.log('Usage: node Monitor/src/scenario/validate.js <scenario.json>');
+    return 2;
+  }
+  let scenario;
+  let result;
+  try {
+    scenario = JSON.parse(readFileSync(args[0], 'utf8'));
+    result = validateScenario(scenario, loadCatalog());
+  } catch (error) {
+    result = {
+      ok: false,
+      problems: [{ id: error instanceof SyntaxError ? 'JSON_PARSE' : 'FILE_READ', path: args[0], message: error.message }],
+      toValidate: [],
+    };
+  }
+  result.problems.forEach(problem => console.log(formatProblem(problem)));
+  for (const source of ['scenario', 'catalog']) {
+    const notes = result.toValidate.filter(note => note.source === source);
+    console.log(`${source === 'catalog' ? 'catalog ' : ''}to validate (${notes.length}):`);
+    notes.forEach(note => console.log(`  ${note.path}: ${String(note.text).replace(/[\r\n]+/g, ' ')}`));
+  }
+  const id = String(scenario?.id ?? basename(args[0], '.json')).replace(/[\r\n]+/g, ' ');
+  console.log(`${result.ok ? 'OK' : 'FAIL'} ${id}`);
+  return result.ok ? 0 : 1;
+}
+
+// Importing the validator must not run the CLI or change the caller's exit code.
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  process.exitCode = main(process.argv.slice(2));
+}
