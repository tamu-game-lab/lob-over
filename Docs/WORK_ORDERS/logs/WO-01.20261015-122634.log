diff --git a/Monitor/src/scenario/helpers.js b/Monitor/src/scenario/helpers.js
new file mode 100644
index 0000000000000000000000000000000000000000..c7b611ce42dccd395d0fbd2a472f377e6ccf9a29
--- /dev/null
+++ b/Monitor/src/scenario/helpers.js
@@ -0,0 +1,25 @@
+// Docs/SCENARIO_SCHEMA.md, kit: four decimal digits, then digitSumMod10.
+const CODE_DIGITS = 4;
+const CHECK_DIGIT_MODULUS = 10;
+const CODE_PATTERN = new RegExp(`^[0-9]{${CODE_DIGITS}}-[0-9]$`);
+
+export function checkDigitOk(code) {
+  if (typeof code !== 'string' || !CODE_PATTERN.test(code) || code.length !== CODE_DIGITS + 2) return false;
+  const sum = [...code.slice(0, CODE_DIGITS)].reduce((total, digit) => total + Number(digit), 0);
+  return sum % CHECK_DIGIT_MODULUS === Number(code.at(-1));
+}
+
+// Boundary convention for WO-01: [fromFt, toFt), with the job endpoint in the last zone.
+export function zoneAt(zones, lengthFt, ft) {
+  if (!Number.isFinite(ft) || ft < 0 || ft > lengthFt) return undefined;
+  return zones.find(zone => zone && ft >= zone.fromFt
+    && (ft < zone.toFt || (ft === lengthFt && zone.toFt === lengthFt)))?.id;
+}
+
+export function deepFreeze(value) {
+  if (value !== null && (typeof value === 'object' || typeof value === 'function') && !Object.isFrozen(value)) {
+    Object.values(value).forEach(deepFreeze);
+    Object.freeze(value);
+  }
+  return value;
+}
diff --git a/Monitor/src/scenario/load.js b/Monitor/src/scenario/load.js
new file mode 100644
index 0000000000000000000000000000000000000000..3b97fc7625006e0cfa90b63bc6c5ffb70b6002ec
--- /dev/null
+++ b/Monitor/src/scenario/load.js
@@ -0,0 +1,34 @@
+import { readFileSync } from 'node:fs';
+import { loadCatalog } from '../common/catalog.js';
+import { validateScenario, formatProblem } from './validate.js';
+import { checkDigitOk, deepFreeze, zoneAt } from './helpers.js';
+
+// WO-01 and Docs/SCENARIO_SCHEMA.md, job.stationEveryFt: stations every 100 feet.
+const STATION_EVERY_FT = 100;
+
+/** Synchronous load; catalog is a parsed catalog object and defaults to Data/catalog.json. */
+export function loadScenario(path, { catalog = loadCatalog() } = {}) {
+  const data = JSON.parse(readFileSync(path, 'utf8'));
+  const result = validateScenario(data, catalog);
+  if (!result.ok) {
+    const error = new Error(result.problems.map(formatProblem).join('\n'));
+    error.name = 'ScenarioValidationError';
+    error.problems = result.problems;
+    throw error;
+  }
+
+  // Copy catalog numbers so mutating the caller's catalog cannot change a loaded scenario.
+  const rates = new Map(data.crews.map(crew => [crew.id, catalog.machines[crew.machine].rateFtPerDay]));
+  const dailyFleetUsd = data.crews.reduce((sum, crew) => sum + catalog.machines[crew.machine].dailyUsd, 0);
+  const stations = [];
+  for (let ft = 0; ft <= data.job.lengthFt; ft += STATION_EVERY_FT) stations.push(ft);
+
+  return deepFreeze({
+    ...data,
+    stations,
+    dailyFleetUsd,
+    zoneOf: ft => zoneAt(data.job.zones, data.job.lengthFt, ft),
+    crewRate: crewId => rates.get(crewId),
+    checkDigitOk,
+  });
+}
