  "lines": [
    {
      "id": "pm_open_01",
      "speaker": "pm",
      "trigger": "stageStart",
      "text": "Morning. The plan is locked: dig Day 1, pipe Day 2, backfill Day 5, Standard machines. We promised Day 35 and the budget is two seventy-eight. Permits are posted. Nothing gets bought ahead; it is not in the budget. Call me before you change anything."
    },
    {
      "id": "pm_prep_refused_01",
      "speaker": "pm",
      "trigger": "prepRefused",
      "text": "No. We are not buying steel for a hole that has not failed. Not in the budget."
    },
    {
      "id": "pm_hold_01",
      "speaker": "pm",
      "trigger": "holdCommitted",
      "text": "You are holding a crew that bills eighteen hundred a day. I hope you have a reason."
    },
    {
      "id": "pm_demob_01",
      "speaker": "pm",
      "trigger": "demobCommitted",
      "text": "Sending a crew home mid-job? Getting them back costs us five thousand and days we do not have."
    },
    {
      "id": "pm_end_01",
      "speaker": "pm",
      "trigger": "stageEnd",
      "text": "That is the job. Let us see where the lines ended up against what we promised."
    },
    {
      "id": "radio_ack_01",
      "speaker": "radio",
      "trigger": "orderLanded",
      "text": "Copy, office. Passing it to the foreman at the next shift."
    },
    {
      "id": "radio_notdone_01",
      "speaker": "radio",
      "trigger": "orderNotDone",
      "text": "Office, inspector reports the crew never got it. Say again?"
    },
    {
      "id": "foreman_pipe_arg_01",
      "speaker": "foreman_pipe",
      "trigger": "conflict",
      "text": "You are on top of me! I have got a wall down at seven-twenty and your loader is pushing dirt onto my bedding."
    },
    {
      "id": "foreman_back_arg_01",
      "speaker": "foreman_back",
      "trigger": "conflict",
      "text": "The schedule had me here Day 5. I lay two-fifty a day and you lay one-eighty. Where exactly did they think I would go?"
    },
    {
      "id": "foreman_held_01",
      "speaker": "foreman_back",
      "trigger": "heldDay1",
      "text": "Standing by. Meter is running."
    },
    {
      "id": "foreman_held_02",
      "speaker": "foreman_back",
      "trigger": "heldDay2",
      "text": "Second day on a hold. My guys are getting paid to watch a trench."
    },
    {
      "id": "foreman_held_03",
      "speaker": "foreman_back",
      "trigger": "heldDay3",
      "text": "Three days. Either give me a stretch to fill or send us home."
    }
  ],
