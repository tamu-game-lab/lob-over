            var day = connection.DisplayDay;
            yield return Until(() => connection.DisplayDay > day, 2);
            yield return new WaitForSecondsRealtime(0.35f);
            Assert.That(cycle.sun.intensity / cycle.DaylightIntensity, Is.EqualTo(1).Within(0.05));
            Assert.That(cycle.caption.gameObject.activeSelf, Is.True); Assert.That(cycle.caption.text, Is.EqualTo("Day " + connection.DisplayDay));
            yield return Level1HostTests.Control("pause");
            // A large station update changes the target, never teleports the machine.
            warp.presenter.Frozen = true;
            var original = exc.transform.localPosition;
            var sample = new LOBOver.Sim.CrewView { id = "exc", stationFt = exc.StationFt + 500, machinePlate = exc.MachinePlate, status = exc.Status };
            exc.Apply(sample, original + Vector3.left * 5);
            Assert.That(exc.transform.localPosition, Is.EqualTo(original));
            var started = Time.time; var previous = original;
            while (Time.time - started < 1)
            {
                yield return null;
                Assert.That(Vector3.Distance(previous, exc.transform.localPosition), Is.LessThanOrEqualTo(Time.deltaTime + 0.001f));
                previous = exc.transform.localPosition;
            }
            Assert.That(Vector3.Distance(original, previous), Is.GreaterThan(0.5f));
            warp.presenter.Frozen = false;
            foreach (var name in new[] { "hub", "site", "argument", "log", "dusk" })
                foreach (var suffix in new[] { "", "-raw", "-composite" })
                    Assert.That(new FileInfo("Monitor/out/unity/l8-" + name + suffix + ".png").Length, Is.GreaterThan(0), name + suffix + " capture");
            LogAssert.NoUnexpectedReceived();
        }
        [UnityTest]
        public IEnumerator DayFiveHeadViewStaysInsideQuestBudget()
        {
            yield return Level1HostTests.Control("day5");
            yield return Until(() => connection.DisplayDay == 5, 3);
            Assert.That(warp.GoToSite(), Is.True);
            yield return Until(() => !warp.Busy && warp.InSite, 3);
            yield return MeasureHeadBudget();
        }
        private IEnumerator MeasureHeadBudget()
        {
#if UNITY_EDITOR
            var camera = preview.view;
            var cameras = Resources.FindObjectsOfTypeAll<Camera>().Where(c => c != camera && !UnityEditor.EditorUtility.IsPersistent(c))
                .Select(c => (camera: c, enabled: c.enabled, mask: c.cullingMask, clear: c.clearFlags)).ToArray();
            var rigRenderers = warp.rig.CameraRig.GetComponentsInChildren<Renderer>(true).Select(r => (renderer: r, enabled: r.enabled)).ToArray();
            var gameType = typeof(UnityEditor.EditorWindow).Assembly.GetType("UnityEditor.GameView", true);
            var game = Resources.FindObjectsOfTypeAll(gameType).Cast<UnityEditor.EditorWindow>().FirstOrDefault();
            var created = game == null; var maximized = game != null && game.maximized;
            var otherWindows = Resources.FindObjectsOfTypeAll<UnityEditor.EditorWindow>().Where(w => w != game && w.maximized).ToArray();
            var focused = UnityEditor.EditorWindow.focusedWindow;
            var previewEnabled = preview.enabled; var enabled = camera.enabled; var target = camera.targetTexture;
            var renders = 0;
            void Count(UnityEngine.Rendering.ScriptableRenderContext context, Camera rendered) { if (rendered == camera) renders++; }
            try
            {
                preview.enabled = false; // Keep AlignHeadCamera from copying the temporarily masked eye camera.
                foreach (var other in otherWindows) other.maximized = false;
                if (game == null) game = UnityEditor.EditorWindow.GetWindow(gameType);
                game.Focus(); game.maximized = true;
                foreach (var other in cameras) { other.camera.enabled = false; other.camera.cullingMask = 0; other.camera.clearFlags = CameraClearFlags.Nothing; }
                foreach (var entry in rigRenderers) entry.renderer.enabled = false;
                camera.enabled = true; camera.targetTexture = null;
                warp.presenter.world.stage.BatchGeometry();
                warp.presenter.world.stage.RefreshShadows(camera.transform);
                foreach (var id in WorldUnits.CrewIds) warp.presenter.world.Crew(id).RefreshDistancePresentation(camera.transform);
                yield return null;
                UnityEngine.Rendering.RenderPipelineManager.beginCameraRendering += Count;
                game.Repaint(); yield return null;
                var count = Math.Max(1, renders);
                var triangles = UnityEditor.UnityStats.triangles / count; var calls = UnityEditor.UnityStats.drawCalls / count;
                Debug.Log($"WO-L8 head view: {triangles} triangles, {calls} draw calls");
                Assert.That(renders, Is.GreaterThan(0), "Head camera must render in the statistics window");
                Assert.That(triangles, Is.InRange(1, 299999)); Assert.That(calls, Is.InRange(1, 149));
            }
            finally
            {
                UnityEngine.Rendering.RenderPipelineManager.beginCameraRendering -= Count;
                if (camera != null) { camera.enabled = enabled; camera.targetTexture = target; }
                foreach (var other in cameras) if (other.camera != null)
                { other.camera.enabled = other.enabled; other.camera.cullingMask = other.mask; other.camera.clearFlags = other.clear; }
                foreach (var entry in rigRenderers) if (entry.renderer != null) entry.renderer.enabled = entry.enabled;
                if (preview != null) preview.enabled = previewEnabled;
                if (game != null) { game.maximized = maximized; if (created) game.Close(); }
                foreach (var other in otherWindows) if (other != null) other.maximized = true;
                if (focused != null) focused.Focus();
            }
#else
            yield break;
#endif
        }
        [Test]
        public void DestroyedDayLightAndCaptionCanDisable()
        {
            var root = new GameObject("DayCycleLifecycle"); root.SetActive(false);
            var sun = new GameObject("Sun").AddComponent<Light>();
            var caption = new GameObject("Day").AddComponent<TMPro.TextMeshPro>();
            var client = new GameObject("InactiveClient"); client.SetActive(false);
            try
            {
                var cycle = root.AddComponent<SiteDayCycle>();
                cycle.connection = client.AddComponent<HostConnection>(); cycle.sun = sun; cycle.caption = caption;
                root.SetActive(true);
                Object.DestroyImmediate(sun.gameObject); Object.DestroyImmediate(caption.gameObject);
                root.SetActive(false); LogAssert.NoUnexpectedReceived();
            }
            finally
            {
                Object.DestroyImmediate(root); Object.DestroyImmediate(client);
                if (sun != null) Object.DestroyImmediate(sun.gameObject); if (caption != null) Object.DestroyImmediate(caption.gameObject);
            }
        }
        private void Capture(string name)
        {
#if UNITY_EDITOR
            const string folder = "Monitor/out/unity";
            Directory.CreateDirectory(folder); PlayPreview.EnsureRoom(folder + "/room.png");
            var room = new Texture2D(2, 2, TextureFormat.RGBA32, false);
            Texture2D frame = null, composite = null;
            try
            {
                Assert.That(room.LoadImage(File.ReadAllBytes(folder + "/room.png")), Is.True);
                frame = preview.CaptureFrame(); composite = PlayPreview.CompositeFrame(frame, room);
                Assert.That(preview.view.transform.parent, Is.EqualTo(warp.rig.CentreEye));
                Assert.That(preview.view.transform.localPosition, Is.EqualTo(Vector3.zero));
                Assert.That(preview.view.transform.localRotation, Is.EqualTo(Quaternion.identity));
                File.WriteAllBytes(folder + "/l8-" + name + "-raw.png", frame.EncodeToPNG());
                File.WriteAllBytes(folder + "/l8-" + name + ".png", composite.EncodeToPNG());
                File.WriteAllBytes(folder + "/l8-" + name + "-composite.png", composite.EncodeToPNG());
            }
            finally { Object.DestroyImmediate(room); if (frame != null) Object.DestroyImmediate(frame); if (composite != null) Object.DestroyImmediate(composite); }
#endif
        }
        [TearDown]
        public void Cleanup()
        {
            SceneManager.sceneLoaded -= SetHead; HostConnection.TestEndpointOverride = null;
            if (connection != null) { connection.CommandSent -= commands.Add; connection.enabled = false; }
            if (clip != null) Object.Destroy(clip); commands.Clear();
        }
    }
