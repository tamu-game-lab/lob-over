using System.IO;
using System.Linq;
using LOBOver.World;
using UnityEditor;
using UnityEngine;
using UnityEngine.Rendering;
using Object = UnityEngine.Object;

namespace LOBOver.Editor
{
    public static class SitePresentationBuilder
    {
        // WO-L4 item 7 / XR_RENDERING.md. Initial corridor length is LEVEL1.md's 3,000 ft.
        private const float SunElevation = 48, FogNear = 300, FogFar = 2500, InitialLength = 3000 * WorldUnits.MetresPerFoot;
        private const float MinimumCubemapSunElevation = 30; // WO-L4 Amendment 1: strictly above this elevation.
        private const int ShadowMapSize = 2048;
        public static readonly Color HorizonColour = new Color(0.68f, 0.73f, 0.75f);
        public static bool DaylightSkyName(string name) => !new[] { "Overcast", "Night", "Dusk", "Sunset", "Space" }
            .Any(word => name.IndexOf(word, StringComparison.OrdinalIgnoreCase) >= 0);
        public static bool ElevatedCubemapSun(Vector3 direction) => direction.normalized.y > Mathf.Sin(MinimumCubemapSunElevation * Mathf.Deg2Rad);
        public static Material SkyMaterial()
        {
            var sky = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "SiteSky.mat", "LOBOver/SiteSky");
            Cubemap cube = null; Material source = null; var direction = Vector3.zero;
            var paths = AssetDatabase.FindAssets("t:Material", new[] { "Assets" }).Select(AssetDatabase.GUIDToAssetPath)
                .Where(p => !p.StartsWith(SiteAssetBuilder.Art, StringComparison.Ordinal) && DaylightSkyName(p)).OrderBy(p => p, StringComparer.Ordinal);
            foreach (var path in paths)
            {
                var candidate = AssetDatabase.LoadAssetAtPath<Material>(path);
                if (candidate == null || candidate.shader == null || !DaylightSkyName(candidate.name)
                    || candidate.shader.name.IndexOf("Skybox", StringComparison.OrdinalIgnoreCase) < 0) continue;
                foreach (var property in candidate.GetTexturePropertyNames())
                    if (candidate.GetTexture(property) is Cubemap found && DaylightSkyName(found.name))
                    {
                        var probedSun = CubemapSun(found);
                        if (!ElevatedCubemapSun(probedSun)) continue;
                        cube = found; source = candidate; direction = probedSun; break;
                    }
                if (cube != null) break;
            }
            sky.SetTexture("_Cube", cube); sky.SetFloat("_UseCube", cube == null ? 0 : 1);
            sky.SetFloat("_Exposure", source != null && source.HasProperty("_Exposure") ? source.GetFloat("_Exposure") : 1);
            var rotation = source != null && source.HasProperty("_Rotation") ? source.GetFloat("_Rotation") : 0;
            sky.SetFloat("_Rotation", rotation);
            // SiteSky rotates the sampling direction by -rotation around Y; invert it for the light.
            sky.SetVector("_SunDirection", Quaternion.Euler(0, rotation, 0) * direction);
            return sky;
        }
        public static Vector3 CubemapSun(Cubemap cube)
        {
            // A tiny GPU readback also supports non-readable imports, without changing their importers.
            const int size = 64; // Editor-only sun search resolution, not a runtime rendering setting.
            var shader = Shader.Find("Hidden/LOBOver/CubemapSunProbe") ?? throw new InvalidOperationException("Missing cubemap sun probe shader");
            var probe = new Material(shader); probe.SetTexture("_Cube", cube);
            var target = RenderTexture.GetTemporary(size, size, 0, RenderTextureFormat.ARGBFloat, RenderTextureReadWrite.Linear);
            var pixels = new Texture2D(size, size, TextureFormat.RGBAFloat, false, true);
            var previous = RenderTexture.active; var brightest = float.NegativeInfinity; var direction = Vector3.zero;
            try
            {
                foreach (var forward in new[] { Vector3.right, Vector3.left, Vector3.up, Vector3.down, Vector3.forward, Vector3.back })
                {
                    var up = Mathf.Abs(forward.y) > 0.5f ? Vector3.forward : Vector3.up;
                    var right = Vector3.Cross(up, forward);
                    probe.SetVector("_FaceForward", forward); probe.SetVector("_FaceRight", right); probe.SetVector("_FaceUp", up);
                    Graphics.Blit(null, target, probe); RenderTexture.active = target;
                    pixels.ReadPixels(new Rect(0, 0, size, size), 0, 0); pixels.Apply();
                    var colors = pixels.GetPixels();
                    for (var y = 0; y < size; y++) for (var x = 0; x < size; x++)
                    {
                        var ray = (forward + right * (2 * (x + 0.5f) / size - 1) + up * (2 * (y + 0.5f) / size - 1)).normalized;
                        var color = colors[y * size + x]; var luminance = color.r * 0.2126f + color.g * 0.7152f + color.b * 0.0722f;
                        if (luminance > brightest) { brightest = luminance; direction = ray; }
                    }
                }
                return direction;
            }
            finally { RenderTexture.active = previous; RenderTexture.ReleaseTemporary(target); Object.DestroyImmediate(pixels); Object.DestroyImmediate(probe); }
        }
        public static WorldAssets BuildAssets()
        {
            var legacy = SiteAssetBuilder.Required<WorldAssets>(SiteAssetBuilder.Art + "WorldAssets.asset");
            var path = SiteAssetBuilder.Art + "PlayWorldAssets.asset";
            var assets = AssetDatabase.LoadAssetAtPath<WorldAssets>(path);
            if (assets == null) { assets = ScriptableObject.CreateInstance<WorldAssets>(); AssetDatabase.CreateAsset(assets, path); }
            EditorUtility.CopySerialized(legacy, assets); assets.name = "PlayWorldAssets"; assets.detailedSite = true;
            Directory.CreateDirectory(SiteAssetBuilder.Converted); AssetDatabase.Refresh();
            SiteMaterialBuilder.Prepare(assets); SiteModelBuilder.Populate(assets, legacy);
            assets.groundMesh = SiteGeometryBuilder.Ground(); assets.horizonMesh = SiteGeometryBuilder.HorizonMesh();
            assets.stripMesh = SiteGeometryBuilder.Strip(); assets.wallNearMesh = SiteGeometryBuilder.Wall(1); assets.wallFarMesh = SiteGeometryBuilder.Wall(-1);
            assets.slumpMesh = SiteGeometryBuilder.Collapse(); assets.windrowMesh = SiteGeometryBuilder.Windrow();
            assets.blockMesh = SiteGeometryBuilder.Block();
            assets.cellPrefab = Cell(assets); assets.stageCellPrefab = StageCell(assets); assets.crewPrefab = Crew(); assets.particles = Dust(assets);
            EditorUtility.SetDirty(assets); AssetDatabase.SaveAssets(); return assets;
        }
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using LOBOver.Client;
using LOBOver.World;
using LOBOver.XR;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class WarpController : MonoBehaviour
    {
        public HostConnection connection;
        public XRRig rig;
        public HostWorldPresenter presenter;
        public Transform site;
        public GameObject hub, wrist;
        public bool Busy { get; private set; }
        public bool InSite { get; private set; }
        public float Progress { get; private set; }
        public Vector3 Origin { get; private set; }
        public double SelectedStation { get; private set; }
        public event System.Action Changed;
        // WO-L8 item 8 (supersedes WO-L5): metres and unscaled seconds. Quadratic ease-out for the front.
        public const float InSeconds = 2.5f, OutSeconds = 1.5f, WatchdogSeconds = 3;
        public const float WaveMetres = 160, BandMetres = 14, RestRadius = 1e6f;
        private Coroutine transition;
        private bool entering;
        private double transitionStarted;
        private readonly Dictionary<Animator, float> animatorSpeeds = new Dictionary<Animator, float>();
        private readonly List<ParticleSystem> particles = new List<ParticleSystem>();
        private readonly List<ParticleSystemRenderer> particleRenderers = new List<ParticleSystemRenderer>();
        private readonly List<CrewRig> crews = new List<CrewRig>();
        private void Start()
        {
            rig.Resolve();
            site.gameObject.SetActive(false); wrist.SetActive(false); hub.SetActive(true);
            SetPassthrough(true);
            ApplyProgress(0);
        }
        public bool GoToSite() => Visit("pipe");
        public bool Visit(string crewId)
        {
            if (Busy || InSite || !connection.Connected || connection.Mirror || !rig.TryHeadPose(out var pose)) return false;
            var crew = connection.View?.crews.FirstOrDefault(c => c.id == crewId);
            if (crew == null) return false;
            SelectedStation = crew.stationFt;
            presenter.Present();
            var forward = Vector3.ProjectOnPlane(pose.rotation * Vector3.forward, Vector3.up).normalized;
            if (forward.sqrMagnitude < 0.1f) forward = Vector3.forward;
            // Road is +Z of the trench. Align -Z with gaze and put the road at the tracked feet.
            site.rotation = Quaternion.LookRotation(-forward);
            var feet = new Vector3(pose.position.x, 0, pose.position.z);
            var road = new Vector3(0, 0, WorldUnits.RoadZ);
            site.position = feet - site.rotation * road;
            BeginTransition(true);
            AttendedCrew = "pipe";
            _ = SendArrival(SelectedStation);
            return true;
        }
        public string AttendedCrew { get; private set; } = "pipe";
        public bool Attend(string crewId)
        {
            if (!InSite || Busy || arrivalPending || sendingArrival || AttendedCrew == crewId) return false;
            var crew = connection.View?.crews.FirstOrDefault(c => c.id == crewId);
            if (crew == null) return false;
            AttendedCrew = crewId; SelectedStation = crew.stationFt; _ = SendArrival(SelectedStation); return true;
        }
        private bool sendingArrival;
        private async System.Threading.Tasks.Task SendArrival(double station)
        {
            sendingArrival = true;
            try
            {
            // Transport order is intentional; dismount waits for the host's moving flag to clear.
            // PROTOCOL.md retains the mounted travel precondition, even though Play has no truck presentation.
            if (connection.View?.truck.dismounted == true && !await connection.SendCommand("mount")) return;
            if (!await connection.SendCommand("moveTo", station)) return;
            arrivalPending = true;
            }
            finally { sendingArrival = false; }
        }
        private bool arrivalPending;
        private void Update()
        {
            // Separate from the coroutine so StopAllCoroutines cannot strand the player.
            if (Busy && Time.realtimeSinceStartupAsDouble - transitionStarted >= WatchdogSeconds)
            {
                LogPhase("watchdog");
                if (transition != null) StopCoroutine(transition);
                FinishTransition();
            }
            if (!arrivalPending) return;
            if (!connection.Connected) { arrivalPending = false; return; }
            var truck = connection.View?.truck;
            if (truck != null && !truck.moving && System.Math.Abs(truck.stationFt - SelectedStation) < 0.1)
            { arrivalPending = false; _ = connection.SendCommand("dismount"); }
        }
        public bool Back()
        {
            // Repeated Back is harmless and never restarts the watchdog's clock.
            if (Busy && !entering) return true;
            if (!Busy && !InSite) return true;
            BeginTransition(false); return true;
        }
        private void BeginTransition(bool toSite)
        {
            if (transition != null) StopCoroutine(transition);
            var alreadyFrozen = Busy;
            entering = toSite; Busy = true;
            transitionStarted = Time.realtimeSinceStartupAsDouble;
            presenter.Frozen = true;
            SetPassthrough(true);
            ApplyProgress(Progress);
            site.gameObject.SetActive(true);
            wrist.SetActive(true);
            if (!alreadyFrozen) FreezeWorld(entering);
            LogPhase(entering ? "in start" : "out start");
            Changed?.Invoke();
            transition = StartCoroutine(Transition());
        }
        private IEnumerator Transition()
        {
            var from = Progress;
            var target = entering ? 1f : 0f;
            // Reversal keeps the same progress speed, starting exactly where Back was pressed.
            var duration = (entering ? InSeconds : OutSeconds) * Mathf.Abs(target - from);
            while (Time.realtimeSinceStartupAsDouble - transitionStarted < duration)
            {
                ApplyProgress(Mathf.Lerp(from, target, (float)(Time.realtimeSinceStartupAsDouble - transitionStarted) / duration));
                yield return null;
            }
            FinishTransition();
        }
        private void FinishTransition()
        {
            ApplyProgress(entering ? 1 : 0);
            InSite = entering;
            if (entering) GetComponent<CrewAttention>()?.PrimeVisible();
            SetPassthrough(!entering);
            site.gameObject.SetActive(entering); hub.SetActive(!entering); wrist.SetActive(entering);
            ThawWorld(); presenter.Frozen = false; presenter.Present(); Busy = false;
            transition = null;
            LogPhase(entering ? "in done" : "out done");
            Changed?.Invoke();
        }
        public static float RadiusAt(float progress)
        {
            var p = Mathf.Clamp01(progress);
            return p >= 1 ? RestRadius : WaveMetres * (1 - (1 - p) * (1 - p));
        }
        private void ApplyProgress(float value)
        {
            Progress = Mathf.Clamp01(value);
            if (rig.TryHeadPose(out var pose)) Origin = new Vector3(pose.position.x, site.position.y, pose.position.z);
            Shader.SetGlobalFloat("_WarpProgress", Progress);
            Shader.SetGlobalVector("_WarpOrigin", Origin);
            Shader.SetGlobalFloat("_WarpRadius", RadiusAt(Progress));
            Shader.SetGlobalFloat("_WarpBand", BandMetres);
        }
        private void LogPhase(string phase) => Debug.Log("LOBOver Warp: " + phase + " progress=" + Progress.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture));
#if UNITY_EDITOR
        // Synchronous preview capture restores this value before the next runtime frame.
        private bool previewFrozen, previewPresenterWasFrozen;
        public void PreviewProgress(float value)
        {
            if (Busy) throw new System.InvalidOperationException("Wait for the warp before stepping preview progress.");
            if (value < 1 && !previewFrozen)
            {
                previewPresenterWasFrozen = presenter.Frozen; presenter.Frozen = true;
                FreezeWorld(false); previewFrozen = true;
            }
            else if (value >= 1 && previewFrozen)
            {
                ThawWorld(); presenter.Frozen = previewPresenterWasFrozen; previewFrozen = false;
            }
            ApplyProgress(value);
        }
#endif
