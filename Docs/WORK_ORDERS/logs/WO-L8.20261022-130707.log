            var hand = panel.AddComponent<HandGrabInteractable>(); hand.InjectRigidbody(body); hand.InjectOptionalPointableElement(grabbable);
            var canvasObject = new GameObject("LogCanvas", typeof(RectTransform), typeof(Canvas), typeof(GraphicRaycaster));
            canvasObject.transform.SetParent(panel.transform, false); canvasObject.transform.localPosition = new Vector3(0, 0, -0.008f);
            // Pixel-sized UI at a fixed metre scale keeps TMP cap heights and Interaction SDK canvas input consistent.
            canvasObject.transform.localScale = Vector3.one * 0.001f;
