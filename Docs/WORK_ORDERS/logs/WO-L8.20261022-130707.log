using System;
using System.Collections.Generic;
using System.Linq;
using LOBOver.Sim;
using TMPro;
using UnityEngine;
using UnityEngine.Rendering;

namespace LOBOver.World
{
    public sealed class StageLayout : MonoBehaviour
    {
        // WO-L8 items 2-3. Slot sign is in the viewer's right direction; local X faces left.
        public const float BaseGap = 8, MetresPerGapFoot = 0.02f, MaxSlot = 30, CaughtSlot = 4;
        public const float CrawlSpeed = 1, Extent = 120, CellMetres = 6, StakeLetters = 0.06f;
        // WO-L8 rejection 1: the near edge is beside the far trench edge (at most 3 m).
        public const float BankClearance = 2;
        public SiteWorld world;
        private readonly List<StationCell> cells = new List<StationCell>();
        private readonly Dictionary<string, Transform> stakes = new Dictionary<string, Transform>();
        private readonly Dictionary<string, TextMeshPro> labels = new Dictionary<string, TextMeshPro>();
        private Transform geometryRoot;
        private readonly List<GameObject> batchObjects = new List<GameObject>();
        private Renderer[] fixedRenderers;
        private bool batched;
        private float nextShadowCheck;
        public static float Slot(string id, double excavation, double pipe, double backfill)
        {
            if (id == "pipe") return 0;
            var gap = Math.Max(0, id == "exc" ? excavation - pipe : pipe - backfill);
            if (id == "back" && gap == 0) return -CaughtSlot;
            var distance = Mathf.Min(MaxSlot, BaseGap + MetresPerGapFoot * (float)gap);
            return id == "exc" ? distance : -distance;
        }
        public Vector3 Target(CrewView crew, SiteView view) => new Vector3(-Slot(crew.id,
            view.crews.First(c => c.id == "exc").stationFt, view.crews.First(c => c.id == "pipe").stationFt,
            view.crews.First(c => c.id == "back").stationFt), 0, 0);
        public void Build(Transform parent, WorldAssets assets)
        {
            cells.Clear(); stakes.Clear(); labels.Clear(); batchObjects.Clear();
            geometryRoot = parent; batched = false; nextShadowCheck = 0;
            for (var x = -Extent; x < Extent; x += CellMetres)
            {
                var cell = Instantiate(assets.stageCellPrefab, parent); cell.Initialize(0, assets);
                cell.name = "StageCell_" + x; cell.transform.localPosition = new Vector3(x, 0, 0);
                cell.stationText.text = ""; cells.Add(cell);
                foreach (var filter in cell.GetComponentsInChildren<MeshFilter>(true))
                {
                    // Sloping walls rotate with host protection state; their shared meshes stay instanced.
                    if (filter.transform == cell.nearWall || filter.transform == cell.farWall || filter.GetComponent<TMP_Text>() != null) continue;
                    if (filter.sharedMesh != null && filter.GetComponent<MeshRenderer>() != null) batchObjects.Add(filter.gameObject);
                }
            }
            foreach (var id in WorldUnits.CrewIds)
            {
                var stake = SiteDetailDrawing.Stake(parent, assets, out var label);
                label.fontSize = StakeLetters * 10 * assets.font.faceInfo.pointSize / Mathf.Max(1, assets.font.faceInfo.capLine);
                label.rectTransform.sizeDelta = new Vector2(0.48f, 0.12f);
                stake.Find("StationSign").localScale = new Vector3(0.52f, 0.16f, 0.018f);
                stakes[id] = stake; labels[id] = label;
            }
            for (var x = -Extent; x <= Extent; x += 10)
            {
                var fence = SiteDetailDrawing.Prop(assets.fence, parent, new Vector3(x, 0, WorldUnits.RoadZ + 3));
                if (fence != null) batchObjects.AddRange(fence.GetComponentsInChildren<MeshFilter>().Select(f => f.gameObject));
            }
            fixedRenderers = parent.GetComponentsInChildren<Renderer>(true);
        }
        public void BatchGeometry()
        {
            if (batched || geometryRoot == null || !geometryRoot.gameObject.activeInHierarchy) return;
            // Include currently hidden cell states in one batch, so later host state toggles
            // can enable them without duplicating meshes. The batch root moves with the site.
            var objects = batchObjects.Where(o => o != null && o.GetComponent<MeshFilter>().sharedMesh.isReadable).ToArray();
            var states = new Dictionary<GameObject, bool>();
            foreach (var obj in objects) for (var t = obj.transform; t != geometryRoot; t = t.parent)
                if (!states.ContainsKey(t.gameObject)) states.Add(t.gameObject, t.gameObject.activeSelf);
            try
            {
                foreach (var obj in states.Keys) obj.SetActive(true);
                StaticBatchingUtility.Combine(objects, geometryRoot.gameObject);
                batched = true;
            }
            finally { foreach (var state in states) if (state.Key != null) state.Key.SetActive(state.Value); }
        }
        public void RefreshShadows(Transform head)
        {
            if (head == null || fixedRenderers == null) return;
            foreach (var renderer in fixedRenderers)
            {
                if (renderer == null || renderer is ParticleSystemRenderer) continue;
                renderer.shadowCastingMode = (renderer.bounds.center - head.position).sqrMagnitude <= CrewRig.ShadowMetres * CrewRig.ShadowMetres
                    ? ShadowCastingMode.On : ShadowCastingMode.Off;
            }
        }
        private void LateUpdate() => Refresh();
        public void Refresh()
        {
            var view = world.CurrentView;
            if (view == null || cells.Count == 0) return;
            BatchGeometry();
            if (Time.unscaledTime >= nextShadowCheck)
            {
                RefreshShadows(world.sky == null ? null : world.sky.observer);
                nextShadowCheck = Time.unscaledTime + CrewRig.DistanceCheckSeconds;
            }
            var exc = world.Crew("exc").transform.localPosition.x;
            var pipe = world.Crew("pipe").transform.localPosition.x;
            var back = world.Crew("back").transform.localPosition.x;
            foreach (var cell in cells)
            {
                var x = cell.transform.localPosition.x + CellMetres / 2;
                var state = x < exc ? "undug" : x < pipe ? "open" : x < back ? "piped" : "backfilled";
                var pipeFront = view.crews.First(c => c.id == "pipe").stationFt;
                var real = view.trench.Where(c => c.stationFt <= pipeFront).OrderByDescending(c => c.stationFt).FirstOrDefault();
                // The visible pipe-front cell carries the host's live collapse/water, never an invented event.
                var atPipe = pipe >= cell.transform.localPosition.x && pipe < cell.transform.localPosition.x + CellMetres;
                if (atPipe && real != null && (real.wall == "slumped" || real.water != "none")) state = "open";
                cell.Apply(new TrenchView { state = state, wall = atPipe ? real?.wall ?? "sound" : "sound",
                    water = atPipe ? real?.water ?? "none" : "none", protection = atPipe ? real?.protection ?? "none" : "none", pipeDamage = "none" });
            }
            foreach (var id in WorldUnits.CrewIds)
            {
                var crew = world.Crew(id);
                stakes[id].localPosition = new Vector3(crew.transform.localPosition.x, 0, 1.2f);
                labels[id].text = WorldUnits.Station(crew.StationFt);
                stakes[id].GetComponent<GroundedObject>().Settle();
            }
        }
    }
}
using System;
using LOBOver.Sim;
using LOBOver.XR;
using TMPro;
using UnityEngine;
using UnityEngine.Rendering;

namespace LOBOver.World
{
    public sealed class CrewRig : MonoBehaviour
    {
        public bool staged;
        public string Id { get; private set; }
        public string Status { get; private set; }
        public double StationFt { get; private set; }
        public int MoodLevel { get; private set; }
        public string MachinePlate { get; private set; }
        public Transform Foreman => workers[0];
        public Transform Partner => partner;
        public string ForemanClip => clips[0];
        public bool WorkingParticles => particles != null && particles.isPlaying;
        public GameObject Machine => machine;
        private WorldAssets assets;
        private GameObject machine, effects;
        private GameObject machinePerimeter;
        private Animator[] machineAnimators;
        private readonly Transform[] workers = new Transform[2]; // WO-08: two workers per machine.
        private readonly Animator[] animators = new Animator[2];
        private readonly string[] clips = new string[2];
        private TextMeshPro plate;
        private ParticleSystem particles;
        private AudioSource engine, argument;
        private Transform partner;
        private Vector3 target, movementVelocity;
        private float statusTime;
        private bool positioned;
        private float machineBank;
        public const float ShadowMetres = 30, MachineDetailMetres = 60, DistanceCheckSeconds = 1; // WO-L4 rejection 3.
        private XRRig rig;
        private Renderer[] shadowRenderers;
        private GroundedObject[] grounded;
        private LODGroup machineLod;
        private float nextDistanceCheck;
        private readonly Vector3[] workerTargets = new Vector3[2], workerVelocities = new Vector3[2];
        // Presentation cadence only; the mood level itself comes exclusively from SiteView.
        private const float PointPeriodSeconds = 10; // WO-08 section 3.
        private const float WorkingAlternateSeconds = 4;
        private static readonly string[] MoodClips = { "Idle", "IdleAlternate", "Drink", "EquipmentCheck" };
        private static readonly float[] MoodSpeeds = { 1, 0.9f, 0.8f, 0.7f };
        private void OnEnable()
        {
            if (engine != null && engine.clip != null) engine.Play();
            if (argument != null && argument.clip != null) argument.Play();
            if (Status == "working" && effects != null)
                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Play();
            nextDistanceCheck = 0;
        }

        public void Initialize(string id, WorldAssets source)
        {
            Id = id; assets = source; name = "Crew_" + id;
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i] = Instantiate(assets.worker, transform).transform; workers[i].name = i == 0 ? "Foreman" : "Worker";
                animators[i] = workers[i].GetComponentInChildren<Animator>();
                if (animators[i] != null) { animators[i].applyRootMotion = false; animators[i].cullingMode = AnimatorCullingMode.AlwaysAnimate; }
                InspectTarget.Attach(workers[i].gameObject, "crew");
                if (assets.detailedSite) GroundedObject.Place(workers[i].gameObject, transform.parent, true);
            }
            effects = Instantiate(assets.particles, transform); effects.name = "WorkParticles";
            particles = effects.GetComponentInChildren<ParticleSystem>();
            foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
            if (assets.detailedSite) SiteDetailDrawing.CrewSurroundings(transform, assets, staged);
            else
            {
                plate = WorldDrawing.Text("MachinePlate", transform, new Vector3(-1, 2.5f, 1), new Vector2(4, 0.5f), 0.25f, assets.font);
                plate.transform.localRotation = Quaternion.Euler(0, 180, 0);
            }
            engine = WorldDrawing.Sound(gameObject, true); argument = WorldDrawing.Sound(gameObject, true, 35);
        }
        public void Apply(CrewView view, Vector3? stageTarget = null)
        {
            var machineChanged = machine == null || !string.Equals(MachinePlate, view.machinePlate, StringComparison.OrdinalIgnoreCase);
            if (machineChanged)
            {
                var item = assets.Machine(Id, view.machinePlate);
                if (item == null) throw new InvalidOperationException("No imported machine for " + Id + "/" + view.machinePlate);
                WorldDrawing.Remove(machine); machine = Instantiate(item.prefab, transform); machine.name = "Machine";
                if (staged) machine.transform.localRotation *= Quaternion.Euler(0, 180, 0);
                if (staged)
                {
                    using var geometry = new SiteGround.Geometry(machine.transform);
                    machineBank = -WorldUnits.TrenchWidth / 2 - StageLayout.BankClearance - geometry.BoundsIn(transform).max.z;
                }
                InspectTarget.Attach(machine, "machine"); machineAnimators = machine.GetComponentsInChildren<Animator>();
                foreach (var animator in machineAnimators) animator.applyRootMotion = false;
                if (assets.detailedSite) GroundedObject.Place(machine, transform.parent, true);
                if (assets.detailedSite)
                { WorldDrawing.Remove(machinePerimeter); machinePerimeter = SiteDetailDrawing.MachinePerimeter(machine, transform, assets); }
                MachinePlate = view.machinePlate; if (plate != null) plate.text = item.label;
                machineLod = machine.GetComponent<LODGroup>();
                shadowRenderers = GetComponentsInChildren<Renderer>(true);
                grounded = GetComponentsInChildren<GroundedObject>(true);
                nextDistanceCheck = 0;
            }
            var next = stageTarget ?? new Vector3((float)view.stationFt * WorldUnits.MetresPerFoot, 0, 0);
            if (staged) next.z = machineBank;
            if (!staged && view.status == "demobilized") next += new Vector3(-WorldUnits.DemobBackMetres, 0, WorldUnits.RoadZ);
            if (!positioned || !staged && Math.Abs(view.stationFt - StationFt) > WorldUnits.StationFeet)
            { transform.localPosition = next; movementVelocity = Vector3.zero; positioned = true; }
            target = next;
            StationFt = view.stationFt; MoodLevel = Mathf.Clamp((int)view.moodLevel, 0, 3);
            if (Status != view.status || machineChanged)
            {
                Status = view.status; statusTime = 0; Debug.Log(name + " " + Status, this);
                var working = Status == "working";
                if (machinePerimeter != null) machinePerimeter.SetActive(working);
                foreach (var animator in machineAnimators)
                {
                    animator.speed = working ? 1 : 0;
                    var cycle = Id == "exc" ? "Dig" : "Cycle";
                    if (working && animator.runtimeAnimatorController != null && animator.HasState(0, Animator.StringToHash(cycle))) animator.Play(cycle, 0, 0);
                }
                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>())
                    if (working && Application.isPlaying && effect.gameObject.activeInHierarchy) effect.Play(); else effect.Stop(true, ParticleSystemStopBehavior.StopEmitting);
                WorldDrawing.Loop(engine, working ? (Id == "exc" ? assets.excavation : Id == "back" ? assets.dozer : assets.idle) : Status == "demobilized" ? null : assets.idle);
                WorldDrawing.Loop(argument, Status == "arguing" ? assets.conflict : null);
            }
            ApplyAnimations();
        }
        public void FaceArgument(Transform other)
        {
            partner = other;
            SetWorkerTargets();
        }
        private void SetWorkerTargets()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                // WO-08: workers stand 2 metres behind the working edge on the road side.
                var goal = transform.parent.TransformPoint((staged ? new Vector3(transform.localPosition.x + 2, 0, -1.8f - i) : target + new Vector3(-2, 0, 2 + i)));
                if (i == 0 && Status == "arguing" && partner != null)
                {
                    var other = partner.GetComponent<CrewRig>();
                    var midpoint = (transform.localPosition + other.transform.localPosition) / 2;
                    if (staged) midpoint.z = -1.8f;
                    var side = string.CompareOrdinal(Id, other.Id) < 0 ? -1 : 1;
                    goal = transform.parent.TransformPoint(midpoint + new Vector3(side * 0.65f, 0, staged ? 0 : 3));
                }
                workerTargets[i] = goal;
            }
        }
        private void Update()
        {
            if (!positioned) return;
            if (assets.detailedSite && Time.unscaledTime >= nextDistanceCheck)
            {
                nextDistanceCheck = Time.unscaledTime + DistanceCheckSeconds;
                if (rig == null) rig = FindFirstObjectByType<XRRig>();
                if (rig != null) RefreshDistancePresentation(rig.ViewEye);
            }
            statusTime += Time.deltaTime;
            // A continuous target must not restart a tween on every frame. Four damping periods
            // settle a state change within the WO's half-second presentation interval.
            transform.localPosition = staged ? Vector3.MoveTowards(transform.localPosition, target, StageLayout.CrawlSpeed * Time.deltaTime)
                : Vector3.SmoothDamp(transform.localPosition, target, ref movementVelocity, WorldUnits.PoseSeconds / 4);
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i].position = Vector3.SmoothDamp(workers[i].position, workerTargets[i], ref workerVelocities[i], WorldUnits.PoseSeconds / 4);
                var facing = Status == "held" ? transform.parent.forward : (staged ? -transform.parent.right : transform.parent.right);
                if (i == 0 && Status == "arguing" && partner != null)
                    facing = partner.GetComponent<CrewRig>().Foreman.position - workers[i].position;
                facing.y = 0;
                if (facing.sqrMagnitude > 0.001f) workers[i].rotation = Quaternion.LookRotation(facing);
            }
            // Animated objects settle after Animator evaluation in GroundedObject.LateUpdate.
            if (grounded != null) foreach (var item in grounded) if (item != null && !item.followsAnimation) item.Settle();
            ApplyAnimations();
        }
        public void RefreshDistancePresentation(Transform head)
        {
            if (head == null || assets == null || !assets.detailedSite) return;
            var distanceSquared = (transform.position - head.position).sqrMagnitude;
            var mode = distanceSquared <= ShadowMetres * ShadowMetres ? ShadowCastingMode.On : ShadowCastingMode.Off;
            shadowRenderers ??= GetComponentsInChildren<Renderer>(true);
            foreach (var renderer in shadowRenderers)
                if (renderer != null && !(renderer is ParticleSystemRenderer) && renderer.shadowCastingMode != mode) renderer.shadowCastingMode = mode;
            if (machineLod != null) machineLod.ForceLOD(distanceSquared <= MachineDetailMetres * MachineDetailMetres ? 0 : 1);
        }
        public void SnapPose()
        {
            if (!positioned) return;
            transform.localPosition = target; movementVelocity = Vector3.zero;
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            { workers[i].position = workerTargets[i]; workerVelocities[i] = Vector3.zero; }
            if (grounded != null) foreach (var item in grounded) if (item != null) item.Settle();
        }
        private bool ClipFinished(int index) => animators[index] == null || !animators[index].isActiveAndEnabled
            || animators[index].GetCurrentAnimatorStateInfo(0).normalizedTime >= 1;
        private void ApplyAnimations()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                var clip = MoodClips[MoodLevel];
                if (Status == "working") clip = ((int)(statusTime / WorkingAlternateSeconds) + i) % 2 == 0 ? "Walk" : "Inspect";
                else if (Status == "held" && MoodLevel == 0) clip = "IdleAlternate";
                else if (Status == "stopped" && (statusTime == 0 || clips[i] == "SignalHalt" && !ClipFinished(i))) clip = "SignalHalt";
                else if (Status == "arguing") clip = i == 0 && string.CompareOrdinal(Id, partner == null ? "" : partner.GetComponent<CrewRig>().Id) < 0 ? "ConflictTalk" : "TalkAlternate";
                else if (Status == "demobilized") clip = "Shelter";
                else if (MoodLevel == 3 && statusTime >= PointPeriodSeconds && statusTime % PointPeriodSeconds < 1) clip = "SignalPoint";
                if (clips[i] != clip)
                {
                    clips[i] = clip;
                    if (animators[i] != null && animators[i].runtimeAnimatorController != null && animators[i].HasState(0, Animator.StringToHash(clip)))
                        animators[i].Play(clip, 0, 0);
                }
                if (animators[i] != null) animators[i].speed = clip == MoodClips[MoodLevel] ? MoodSpeeds[MoodLevel] : 1;
            }
        }
    }
}

