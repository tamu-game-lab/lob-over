new file mode 100644
index 0000000000000000000000000000000000000000..179e795c5da02aeed538d0f05dd52e7aa560459b
--- /dev/null
+++ b/Monitor/src/sim/common.js
@@ -0,0 +1,46 @@
+// WO-02 crew order, precision, haul-road speed, proximity and mood conventions.
+export const CREW_IDS = ['exc', 'pipe', 'back'];
+export const LEADER = { pipe: 'exc', back: 'pipe' };
+export const DT = 0.01;
+export const EPS = 1e-6;
+export const NEAR_FT = 100;
+export const HAUL_FT_PER_HOUR = 1500;
+export const HOURS_PER_DAY = 24;
+export const MAX_MOOD = 3;
+export const MOODS = ['calm', 'grumbling', 'angry', 'furious'];
+// WO-02: conflicts look one day ahead; P1 durations round to half days.
+export const CONFLICT_LOOKAHEAD_DAYS = 1;
+export const CLEARING_DAY_STEP = 0.5;
+export const travelDays = (a, b) => Math.abs(a - b) / HAUL_FT_PER_HOUR / HOURS_PER_DAY;
+export const displayDay = t => Math.floor(t + EPS) + 1;
+export const nextBoundary = t => Math.floor(t + EPS) + 1;
+export const copy = value => JSON.parse(JSON.stringify(value));
+export const zoneAt = (s, ft) => s.scenario.job.zones.find(z => ft >= z.fromFt
+  && (ft < z.toFt || ft === s.scenario.job.lengthFt));
+export const nearby = (s, ft) => s.truck.dismounted && !s.truck.moving
+  && Math.abs(s.truck.stationFt - ft) <= NEAR_FT;
+export const crewAt = s => CREW_IDS.map(id => s.crews[id])
+  .filter(c => Math.abs(c.pos - s.truck.stationFt) <= NEAR_FT)
+  .sort((a, b) => Math.abs(a.pos - s.truck.stationFt) - Math.abs(b.pos - s.truck.stationFt))[0];
+export const protectionAt = (s, ft) => s.protections.find(p => ft >= p.fromFt && ft <= p.toFt);
+export const activeCollapse = s => s.events.find(e => e.type === 'P1' && e.fired && !e.resolved);
+export const emit = (s, type, fields) => s.messages.push({ t: type, v: 1, ...fields });
+
+export function voice(s, trigger, seats, crewIds) {
+  const lines = s.scenario.lines.filter(line => line.trigger === trigger
+    && (!crewIds || crewIds.includes(line.speaker.replace('foreman_', ''))));
+  if (!lines.length) return;
+  emit(s, 'voice', { lineIds: lines.map(line => line.id), seats });
+  s.pmLines.push(...lines.filter(line => line.speaker === 'pm').map(line => line.text));
+}
+
+// Reducers own this draft; source state and caller-owned scenario/catalog stay untouched.
+// Histories are append-only, so copying their outer arrays avoids repeatedly cloning points.
+export function draftState(s) {
+  const { scenario, catalog, actualLines, plannedLines, inbox, changeLog, messages, ...dynamic } = s;
+  return {
+    ...structuredClone(dynamic), scenario, catalog,
+    actualLines: Object.fromEntries(CREW_IDS.map(id => [id, [...actualLines[id]]])),
+    plannedLines: copy(plannedLines), inbox: [...inbox], changeLog: [...changeLog], messages: [...messages],
+  };
+}
diff --git a/Monitor/src/sim/conflict.js b/Monitor/src/sim/conflict.js
new file mode 100644
index 0000000000000000000000000000000000000000..c2c23dc20222e52908a39ab61fe65f6b50f5a5a4
--- /dev/null
+++ b/Monitor/src/sim/conflict.js
@@ -0,0 +1,34 @@
+import { LEADER, EPS, CONFLICT_LOOKAHEAD_DAYS, emit, voice } from './common.js';
+
+export function detectConflicts(s) {
+  for (const [trailingId, leaderId] of Object.entries(LEADER)) {
+    const trailing = s.crews[trailingId], leader = s.crews[leaderId];
+    const key = `${trailingId}:${leaderId}`;
+    if (s.conflicts.some(c => c.pair === key) || trailing.mult <= 0 || trailing.pos >= leader.pos - EPS) continue;
+    if (trailing.pos + trailing.rate * trailing.mult * CONFLICT_LOOKAHEAD_DAYS
+      <= leader.pos + leader.rate * leader.mult * CONFLICT_LOOKAHEAD_DAYS + EPS) continue;
+    s.conflicts.push({ pair: key, trailing: trailingId, leader: leaderId, firedT: s.t, resolved: false });
+    trailing.arguing = leader.arguing = true;
+    trailing.mult = leader.mult = 0;
+    trailing.status = leader.status = 'arguing';
+    s.speed = 'slow';
+    voice(s, 'conflict', ['site'], [trailingId, leaderId]);
+    emit(s, 'event', { eventId: `conflict_${trailingId}_${leaderId}`, day: s.t,
+      stationFt: trailing.pos, zone: null, seats: ['site'],
+      card: { title: 'Crews stopped', facts: [`${trailing.name} and ${leader.name} foremen are arguing.`] } });
+  }
+}
+
+export function validateConflictCommit(s, ops) {
+  if (s.conflicts.some(c => !c.resolved && !ops.some(op => op.crew === c.trailing
+    && (op.op === 'hold' || op.op === 'demob')))) return 'conflict: hold or demobilize the trailing crew';
+}
+
+export function resolveConflicts(s) {
+  for (const conflict of s.conflicts.filter(c => !c.resolved)) {
+    conflict.resolved = true;
+    conflict.resolvedT = s.t;
+    // The trailing crew waits for its field order; only the leader resumes at commit.
+    s.crews[conflict.leader].arguing = false;
+  }
+}
diff --git a/Monitor/src/sim/crews.js b/Monitor/src/sim/crews.js
new file mode 100644
index 0000000000000000000000000000000000000000..c845c0fc3381453af124ea410b302caa3c30df2c
--- /dev/null
+++ b/Monitor/src/sim/crews.js
@@ -0,0 +1,79 @@
+import { CREW_IDS, LEADER, EPS, MAX_MOOD, voice } from './common.js';
+import { excavationLimit, backfillLimit, finalInspectionEntered } from './permits.js';
+import { rainMultiplier, pipeReworking } from './rain.js';
+
+export function refreshCrews(s) {
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    if (c.hold?.untilT != null && s.t >= c.hold.untilT - EPS) c.hold = null;
+    if (c.remobT != null && s.t >= c.remobT - EPS) {
+      c.demobilized = false;
+      c.demobBillingEndsT = null;
+      c.remobT = null;
+    }
+    c.rate = s.catalog.machines[c.machine].rateFtPerDay;
+    for (const loan of s.loans.filter(l => l.toCrew === id && l.phase === 'working' && !l.eventId)) {
+      c.rate += s.catalog.machines[loan.machine].rateFtPerDay;
+    }
+    const held = c.hold && s.t >= c.hold.fromT - EPS;
+    const stopped = c.stop && s.t >= c.stop.fromT - EPS;
+    c.status = c.demobilized ? 'demobilized' : c.arguing ? 'arguing'
+      : stopped ? 'stopped' : held ? 'held' : 'working';
+    c.mult = 1;
+    if (s.t < c.startDay - 1 - EPS || c.finishT != null) { c.mult = 0; c.status = 'idle'; }
+    if (c.demobilized || c.arguing || stopped || held || c.lentAway) c.mult = 0;
+    if (!s.pure) {
+      c.mult *= rainMultiplier(s, id);
+      for (const event of s.events.filter(e => e.fired && !e.resolved && e.type !== 'A2'
+        && (e.hits === id || e.hits === 'all'))) c.mult *= 1 - event.rateDrop;
+      if (id === 'pipe' && pipeReworking(s)) c.mult = 0;
+    }
+    if (!c.mult && c.status === 'working') c.status = 'idle';
+  }
+}
+
+export function moveCrews(s, dt) {
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    if (s.t < c.startDay - 1 - EPS || c.finishT != null) continue;
+    const leader = LEADER[id] && s.crews[LEADER[id]];
+    let limit = Math.min(s.scenario.job.lengthFt, leader?.pos ?? s.scenario.job.lengthFt);
+    let desired = c.pos + c.rate * c.mult * dt;
+    c.idleReason = null;
+    if (s.pure && id === 'exc' && s.capFt != null) limit = Math.min(limit, s.crews.back.pos + s.capFt);
+    if (!s.pure && id === 'exc') {
+      const permitLimit = excavationLimit(s, c.mult > 0 ? desired : c.pos);
+      limit = Math.min(limit, permitLimit);
+      if (desired > permitLimit || c.pos >= permitLimit - EPS && permitLimit < s.scenario.job.lengthFt) c.idleReason = 'idleNoPermit';
+    }
+    if (!s.pure && id === 'back') {
+      const holdPoint = backfillLimit(s);
+      limit = Math.min(limit, holdPoint);
+      if (desired > holdPoint || c.pos >= holdPoint - EPS && !finalInspectionEntered(s)) c.idleReason = 'idleHoldPoint';
+    }
+    desired = Math.max(c.pos, Math.min(desired, limit));
+    const moved = desired - c.pos;
+    c.work += moved / c.rate;
+    c.pos = desired;
+    c.moved = moved;
+    if (leader && moved < c.rate * c.mult * dt - EPS && !c.idleReason) c.idleReason = 'leader';
+    if (c.status === 'working' && moved < EPS) c.status = 'idle';
+    if (c.pos >= s.scenario.job.lengthFt - EPS
+      && (id !== 'back' || s.pure || finalInspectionEntered(s))) c.finishT = s.t + dt;
+  }
+  s.peakOpenTrenchFt = Math.max(s.peakOpenTrenchFt, s.crews.exc.pos - s.crews.back.pos);
+}
+
+export function updateMood(s, dt) {
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    const held = c.status === 'held' || c.status === 'stopped';
+    const waiting = held || c.idleReason === 'leader';
+    c.waitDays = waiting ? c.waitDays + dt : 0;
+    const level = Math.min(MAX_MOOD, Math.floor((c.waitDays + EPS) / s.scenario.rules.moodStepDays));
+    if (held && level > c.mood) {
+      for (let mood = c.mood + 1; mood <= level; mood++) voice(s, `heldDay${mood}`, ['site'], [id]);
+    }
+    c.mood = level;
+  }
+}
diff --git a/Monitor/src/sim/deviations.js b/Monitor/src/sim/deviations.js
new file mode 100644
index 0000000000000000000000000000000000000000..a8d8c1fd2481639761e94bf1135e0aba3cd5e9f7
--- /dev/null
+++ b/Monitor/src/sim/deviations.js
@@ -0,0 +1,54 @@
+import { EPS, nearby, nextBoundary, protectionAt } from './common.js';
+
+export function markFirstRadio(s, order) {
+  const d = s.deviations.find(d => d.type === 'F1' && !d.triggered
+    && d.when.ops.includes(order.op.op) && order.landsT > order.issuedT);
+  if (d) {
+    d.triggered = true;
+    d.orderId = order.id;
+    order.ignored = true;
+  }
+}
+
+export function confirmDeviation(s, order, outcome) {
+  const d = s.deviations.find(d => d.type === 'F1' && d.orderId === order.id);
+  if (d && outcome === 'notDone' && s.t < nextBoundary(order.landedT) - EPS) d.caught = true;
+}
+
+export function boundaryAllowance(s, zone) {
+  const d = s.deviations.find(d => d.type === 'F2');
+  if (!d) return zone.fromFt;
+  if (d.triggered) return d.zone === zone.id && !d.caught ? zone.fromFt + d.overshootFt : zone.fromFt;
+  d.triggered = true;
+  d.zone = zone.id;
+  d.caught = nearby(s, zone.fromFt) || !!s.crews.exc.hold || !!s.crews.exc.stop;
+  if (!d.caught) {
+    s.finesUsd += s.scenario.rules.permitFineUsd;
+    s.spentUsd += s.scenario.rules.permitFineUsd;
+  }
+  return d.caught ? zone.fromFt : zone.fromFt + d.overshootFt;
+}
+
+export function inspectProtection(s, stationFt) {
+  const p = protectionAt(s, stationFt);
+  if (!p) return;
+  for (const d of s.deviations.filter(d => d.type === 'F3')) {
+    const e = s.events.find(e => e.id === d.when.eventId);
+    if (!e?.fired && !(e.stationFt >= p.fromFt && e.stationFt <= p.toFt)) d.inspected = true;
+  }
+}
+
+export function eventDeviations(s, event) {
+  for (const d of s.deviations.filter(d => d.type === 'F3' && d.when.eventId === event.id)) {
+    const missedStretch = s.protections.some(p => event.stationFt < p.fromFt || event.stationFt > p.toFt);
+    if (missedStretch && !protectionAt(s, event.stationFt)) {
+      d.triggered = true;
+      d.caught = !!d.inspected;
+    }
+  }
+}
+
+// WO-02 reserves F5's firstLend hook but specifies no delay behaviour in these stages.
+export function firstLend(s) {
+  for (const d of s.deviations.filter(d => d.type === 'F5' && !d.triggered)) d.triggered = true;
+}
diff --git a/Monitor/src/sim/events.js b/Monitor/src/sim/events.js
new file mode 100644
index 0000000000000000000000000000000000000000..6dd5563652a7dc396feceb828526a2aa0cbb007a
--- /dev/null
+++ b/Monitor/src/sim/events.js
@@ -0,0 +1,54 @@
+import { CLEARING_DAY_STEP, EPS, emit, protectionAt } from './common.js';
+import { eventDeviations } from './deviations.js';
+import { finishRain } from './rain.js';
+
+export function clearingDays(s, event, machine) {
+  const size = s.catalog.machines[machine].sizeClass;
+  const severity = event.protection ? event.severityByProtection[event.protection] ?? 1 : 1;
+  return Math.round(event.durationDaysByExcavator[size] * severity / CLEARING_DAY_STEP) * CLEARING_DAY_STEP;
+}
+
+export function availableResponses(s) {
+  return s.events.flatMap(event => (event.fired && !event.resolved
+    || event.forecast && s.t >= event.forecast.inboxDay - 1 && !event.resolved)
+    ? (event.options ?? []).map(option => ({ event, option })) : []);
+}
+
+export function updateEvents(s) {
+  for (const event of s.events) {
+    if (event.forecast && !event.forecastSent && s.t >= event.forecast.inboxDay - 1 - EPS) {
+      event.forecastSent = true;
+      s.inbox.push({ day: event.forecast.inboxDay - 1, from: 'Forecast', subject: 'Weather', body: event.forecast.text });
+    }
+    if (!event.fired) {
+      const trigger = event.trigger;
+      const ready = trigger.kind === 'day' ? s.t >= trigger.day - 1 - EPS
+        : trigger.kind === 'crewReaches' ? s.crews[trigger.crew].pos >= trigger.ft - EPS
+          : trigger.kind === 'zoneSigned' && s.permits[trigger.zone].signed;
+      if (!ready) continue;
+      event.fired = true;
+      event.firedT = s.t;
+      event.protection = protectionAt(s, event.stationFt)?.kind ?? null;
+      event.shownCard = event.protection && event.cardWhenProtected ? event.cardWhenProtected : event.card;
+      event.endsT = event.type === 'P1' ? null : s.t + event.durationDays;
+      if (event.type === 'A2') event.openFt = Math.max(0, s.crews.exc.pos - s.crews.back.pos);
+      s.speed = 'slow';
+      emit(s, 'event', { eventId: event.id, day: s.t, zone: event.zone, stationFt: event.stationFt,
+        card: event.shownCard, seats: event.visibleTo });
+      eventDeviations(s, event);
+    }
+    if (event.resolved || event.endsT == null || s.t < event.endsT - EPS) continue;
+    if (event.type === 'A2') {
+      if (!event.rainEnded) finishRain(s, event);
+      if (s.t < event.reworkEndsT - EPS) continue;
+    }
+    event.resolved = true;
+    event.resolvedT = s.t;
+  }
+  s.scenario.inbox.forEach((item, index) => {
+    if (!s.inboxDelivered.includes(index) && s.t >= item.day - 1 - EPS) {
+      s.inboxDelivered.push(index);
+      s.inbox.push({ ...item, day: item.day - 1 });
+    }
+  });
+}
diff --git a/Monitor/src/sim/goldens.js b/Monitor/src/sim/goldens.js
new file mode 100644
index 0000000000000000000000000000000000000000..ce65be5aa7cf577060421114bfd74dc7913f9f98
--- /dev/null
+++ b/Monitor/src/sim/goldens.js
@@ -0,0 +1,40 @@
+import { readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { loadCatalog } from '../common/catalog.js';
+import { CREW_IDS } from './common.js';
+import { createSim } from './sim.js';
+
+// Data/goldens/no_events.json _doc: finish/idle 0.1 day, cost $500, peak 10 ft.
+const TOLERANCE = { days: 0.1, cost: 500, feet: 10 };
+export function runGoldens(goldens, catalog) {
+  return Object.entries(goldens.cases).map(([name, entry]) => {
+    const scenario = {
+      id: name, seed: 0, capFt: entry.input.capFt,
+      job: { lengthFt: goldens.lengthFt, stationEveryFt: 100, zones: [{ id: 1, fromFt: 0, toFt: goldens.lengthFt }] },
+      crews: CREW_IDS.map(id => ({ id, name: id, machine: entry.input.machines[id], startDay: entry.input.startDay[id] })),
+      plan: {}, permits: { cards: [] }, inspections: { required: false, cards: [] },
+      rules: { overheadRate: catalog.money.overheadRate }, events: [], deviations: [], inbox: [], lines: [],
+    };
+    const sim = createSim(scenario, catalog, { pure: true });
+    // The oracle uses a 300-day guard; this is a harness limit, not a game rule.
+    while (!sim.done && sim.t < 300) sim.tick(goldens.dt);
+    const actual = sim.result, expected = entry.expected;
+    const deltas = actual ? { finishDay: actual.finishDay - expected.finishDay,
+      idleDays: Object.fromEntries(CREW_IDS.map(id => [id, actual.idleDays[id] - expected.idleDays[id]])),
+      crewCostUsd: actual.crewCostUsd - expected.crewCostUsd, peakOpenTrenchFt: actual.peakOpenTrenchFt - expected.peakOpenTrenchFt } : null;
+    const pass = !!deltas && Math.abs(deltas.finishDay) <= TOLERANCE.days
+      && CREW_IDS.every(id => Math.abs(deltas.idleDays[id]) <= TOLERANCE.days)
+      && Math.abs(deltas.crewCostUsd) <= TOLERANCE.cost && Math.abs(deltas.peakOpenTrenchFt) <= TOLERANCE.feet;
+    return { name, pass, deltas };
+  });
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  try {
+    const results = runGoldens(JSON.parse(readFileSync(process.argv[2], 'utf8')), loadCatalog());
+    for (const { name, pass, deltas } of results) console.log(`${pass ? 'PASS' : 'FAIL'} ${name} deltas=${JSON.stringify(deltas,
+      (key, value) => typeof value === 'number' ? Number(value.toFixed(3)) : value)}`);
+    process.exitCode = results.every(result => result.pass) ? 0 : 1;
+  } catch (error) { console.error(error.message); process.exitCode = 1; }
+}
diff --git a/Monitor/src/sim/headless.js b/Monitor/src/sim/headless.js
index 9d8a98aa91f81a56b6553e5e79acdfde0ba3a33d..9c1fbcc73bd9a325ebb9657a89f8d4b16eaf83c3
--- a/Monitor/src/sim/headless.js
+++ b/Monitor/src/sim/headless.js
@@ -1,5 +1,70 @@
-import { log } from '../common/log.js';
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { loadCatalog } from '../common/catalog.js';
+import { loadScenario } from '../scenario/load.js';
+import { DT, EPS } from './common.js';
+import { createSim } from './sim.js';
 
-log.info('Usage: npm.cmd --prefix Monitor run headless');
-log.warn('Headless simulation is a stub until WO-02.');
-process.exitCode = 2;
+// WO-02 transcript precision and safety-stop allowance.
+const TRANSCRIPT_DECIMALS = 3;
+const SAFETY_DAYS = 5;
+export const roundedJSON = value => JSON.stringify(value, (key, v) =>
+  typeof v === 'number' ? Number(v.toFixed(TRANSCRIPT_DECIMALS)) : v, 2) + '\n';
+
+export function runHeadless(scenario, catalog, script = [], { pure = false } = {}) {
+  const sim = createSim(scenario, catalog, { pure });
+  const commands = script.map((entry, index) => ({ ...entry, index })).sort((a, b) => a.t - b.t || a.index - b.index);
+  const transcript = { scenario: scenario.id, seed: scenario.seed, snapshots: [], messages: [], result: null };
+  let index = 0, snapshotDay = -1;
+  const drain = () => { for (const message of sim.drain()) transcript.messages.push({ t: sim.t, message }); };
+  while (!sim.done && sim.t <= scenario.plan.deadlineDay + SAFETY_DAYS) {
+    while (index < commands.length && commands[index].t <= sim.t + EPS) {
+      const { seat, cmd } = commands[index++];
+      const reply = sim.apply(seat, cmd);
+      transcript.messages.push({ t: sim.t, message: { t: reply.ok ? 'ack' : 'nack', v: 1, id: cmd.id, ...reply } });
+      drain();
+    }
+    const day = Math.floor(sim.t + EPS);
+    if (day > snapshotDay) { transcript.snapshots.push(sim.view('facilitator')); snapshotDay = day; }
+    drain();
+    if (sim.speed === 'paused') {
+      transcript.safetyStop = { t: sim.t, reason: 'paused without a same-time resume' };
+      break;
+    }
+    sim.tick(DT);
+    drain();
+  }
+  transcript.result = sim.result;
+  if (!sim.done && !transcript.safetyStop) transcript.safetyStop = { t: sim.t, reason: 'time limit' };
+  return transcript;
+}
+
+function main(args) {
+  const [path, ...options] = args;
+  if (!path || path.startsWith('--')) {
+    console.log('Usage: node headless.js <scenario.json> [--script <script.json>] [--out <transcript.json>] [--pure]');
+    return 2;
+  }
+  let scriptPath, out, pure = false;
+  for (let i = 0; i < options.length; i++) {
+    if (options[i] === '--pure') pure = true;
+    else if (options[i] === '--script' && options[i + 1]) scriptPath = options[++i];
+    else if (options[i] === '--out' && options[i + 1]) out = options[++i];
+    else throw new Error(`Unknown or incomplete option: ${options[i]}`);
+  }
+  const catalog = loadCatalog(), scenario = loadScenario(path, { catalog });
+  const script = scriptPath ? JSON.parse(readFileSync(scriptPath, 'utf8')) : [];
+  const transcript = runHeadless(scenario, catalog, script, { pure });
+  if (out) {
+    mkdirSync(dirname(resolve(out)), { recursive: true });
+    writeFileSync(out, roundedJSON(transcript));
+    console.log(`${scenario.id}: ${transcript.result?.lost ?? 'finished'} t=${transcript.result?.finishDay ?? transcript.snapshots.at(-1)?.t}`);
+  } else process.stdout.write(roundedJSON(transcript));
+  return transcript.safetyStop ? 1 : 0;
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
+  try { process.exitCode = main(process.argv.slice(2)); }
+  catch (error) { console.error(error.message); process.exitCode = 1; }
+}
diff --git a/Monitor/src/sim/money.js b/Monitor/src/sim/money.js
new file mode 100644
index 0000000000000000000000000000000000000000..b6c62df11d50bcecc02b6f7155bef418a2fd243f
--- /dev/null
+++ b/Monitor/src/sim/money.js
@@ -0,0 +1,34 @@
+import { CREW_IDS, EPS } from './common.js';
+
+export const billing = (s, c) => s.t >= c.startDay - 1 - EPS && (c.finishT == null || c.finishT > s.t + EPS)
+  && !(c.demobBillingEndsT != null && s.t >= c.demobBillingEndsT - EPS);
+
+export function accrue(s, dt) {
+  const overhead = 1 + s.scenario.rules.overheadRate;
+  let crewDaily = 0;
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    if (billing(s, c)) {
+      c.onsite += dt;
+      crewDaily += s.catalog.machines[c.machine].dailyUsd;
+    }
+  }
+  const protectionDaily = s.protections.reduce((sum, p) => sum
+    + (CREW_IDS.some(id => {
+      const c = s.crews[id];
+      return c.moved > EPS && c.pos >= p.fromFt && c.pos <= p.toFt;
+    }) ? s.catalog.protection[p.kind].dailyUsd : 0), 0);
+  const hiredDaily = s.deliveries.filter(d => d.hired && d.arrived && !d.released)
+    .reduce((sum, d) => sum + s.catalog.machines[d.machine].dailyUsd, 0);
+  const optionDaily = s.payments.reduce((sum, p) => sum + p.perDayUsd, 0);
+  s.crewCostUsd += crewDaily * dt * overhead;
+  s.spentUsd += (crewDaily + protectionDaily + hiredDaily) * dt * overhead + optionDaily * dt;
+}
+
+export function buyMachine(s, machine) {
+  s.spentUsd += s.catalog.machines[machine].priceUsd + s.scenario.rules.mobilizationUsd;
+}
+
+export function releaseMachine(s, machine) {
+  s.spentUsd -= s.catalog.machines[machine].priceUsd * s.catalog.orders.releaseRefundFraction;
+}
diff --git a/Monitor/src/sim/orders.js b/Monitor/src/sim/orders.js
new file mode 100644
index 0000000000000000000000000000000000000000..7057820b14ac948b0d1aaacebe46dc3485ed42f3
--- /dev/null
+++ b/Monitor/src/sim/orders.js
@@ -0,0 +1,198 @@
+import { CREW_IDS, EPS, activeCollapse, displayDay, nearby, nextBoundary, travelDays, voice } from './common.js';
+import { markFirstRadio, firstLend } from './deviations.js';
+import { availableResponses, clearingDays } from './events.js';
+import { buyMachine, releaseMachine } from './money.js';
+import { validateInspection, validatePermit, updateHoldPoints } from './permits.js';
+
+const OFFICE_OPS = new Set(['setStart', 'enterPermit', 'enterInspection', 'pay']);
+const CREW_OPS = new Set(['setStart', 'hold', 'resume', 'demob', 'remob']);
+const PLAN_OPS = new Set([...CREW_OPS, ...OFFICE_OPS, 'lend', 'order', 'protect', 'radio']);
+const positive = n => Number.isFinite(n) && n > 0;
+const owns = (object, key) => typeof key === 'string' && Object.hasOwn(object, key) && !key.startsWith('_');
+const ownerOf = (s, machine) => CREW_IDS.find(id => s.crews[id].machine === machine);
+export const landingTime = (s, crew) => s.pure || crew && nearby(s, s.crews[crew].pos) ? s.t : nextBoundary(s.t);
+
+export function validateOp(s, op) {
+  if (!op || !PLAN_OPS.has(op.op)) return 'unknown operation';
+  if (CREW_OPS.has(op.op) && !CREW_IDS.includes(op.crew)) return 'unknown crew';
+  const c = s.crews[op.crew];
+  if (op.op === 'setStart') {
+    if (s.scenario.plan.locked || c.locked) return 'plan locked';
+    if (s.t >= c.startDay - 1 - EPS) return 'crew already started';
+    if (!Number.isInteger(op.day) || op.day < displayDay(s.t)) return 'invalid start day';
+  }
+  if (op.op === 'hold' && (op.days != null && !positive(op.days)
+    || op.fromDay != null && (!Number.isInteger(op.fromDay) || op.fromDay < displayDay(s.t)))) return 'invalid hold';
+  if (op.op === 'lend') {
+    const owner = ownerOf(s, op.machine);
+    if (!owner || s.crews[owner].lentAway || s.loans.some(l => l.fromCrew === owner && l.phase !== 'returned')) return 'machine unavailable';
+    if (!CREW_IDS.includes(op.toCrew) || op.toCrew === owner || !positive(op.days)) return 'invalid lend';
+  }
+  if (op.op === 'protect' || op.op === 'order') {
+    if (!s.scenario.plan.preparationAllowed) return 'not in the budget';
+    if (op.op === 'order') {
+      if (!owns(s.catalog.machines, op.machine)) return 'unknown machine';
+      if (op.rush) return 'rush unavailable';
+    } else {
+      if (!owns(s.catalog.protection, op.kind)) return 'unknown protection';
+      if (s.catalog.protection[op.kind].reactOnly) return 'no such response now';
+      if (op.kind === 'trench_slope' && (s.catalog.cities[s.scenario.city].slopeRefused
+        || s.catalog.protection[op.kind].refusedInCities?.includes(s.scenario.city))) return 'slope refused';
+      if (!Number.isFinite(op.fromFt) || !Number.isFinite(op.toFt) || op.fromFt < 0
+        || op.toFt > s.scenario.job.lengthFt || op.fromFt >= op.toFt) return 'invalid stretch';
+    }
+  }
+  if (op.op === 'pay') {
+    const response = availableResponses(s).find(r => r.option.key === op.item);
+    if (!response) return 'no such response now';
+    if (op.item === 'hire_excavator' && (!owns(s.catalog.machines, op.machine)
+      || s.catalog.machines[op.machine].crew !== 'exc')) return 'unknown machine';
+    if (op.item === 'clear_own' && s.crews.exc.lentAway) return 'machine unavailable';
+  }
+  if (op.op === 'enterPermit') return validatePermit(s, op);
+  if (op.op === 'enterInspection') return validateInspection(s, op);
+  if (op.op === 'radio' && !s.orders.some(order => order.id === op.orderId)) return 'order not on file';
+}
+
+function startLoan(s, op) {
+  const fromCrew = ownerOf(s, op.machine);
+  const event = fromCrew === 'exc' && op.toCrew === 'pipe' ? activeCollapse(s) : null;
+  const loan = { machine: op.machine, fromCrew, toCrew: op.toCrew, phase: 'outbound',
+    arrivesT: s.t + travelDays(s.crews[fromCrew].pos, s.crews[op.toCrew].pos), days: op.days,
+    eventId: event?.id ?? null };
+  s.crews[fromCrew].lentAway = true;
+  s.loans.push(loan);
+  if (event) event.option = 'clear_own';
+  firstLend(s);
+}
+
+function purchase(s, machine, event) {
+  buyMachine(s, machine);
+  s.deliveries.push({ machine, crew: s.catalog.machines[machine].crew, issuedT: s.t,
+    arrivesT: s.t + s.catalog.machines[machine].leadDays.normal + s.catalog.cities[s.scenario.city].leadDelayDays,
+    hired: !!event, eventId: event?.id ?? null, arrived: false, released: false });
+}
+
+function pay(s, op) {
+  const { event, option } = availableResponses(s).find(r => r.option.key === op.item);
+  event.option = op.item;
+  if (op.item === 'hire_excavator') {
+    purchase(s, op.machine, event);
+    return;
+  }
+  s.spentUsd += option.cost.usd;
+  s.payments.push({ item: op.item, paidT: s.t, perDayUsd: option.cost.perDayUsd });
+  if (option.effect.lend) {
+    const fromCrew = option.effect.lend.machineOf;
+    issueOrder(s, { op: 'lend', machine: s.crews[fromCrew].machine,
+      toCrew: option.effect.lend.toCrew, days: clearingDays(s, event, s.crews[fromCrew].machine) });
+  }
+  if (option.effect.resumeAfterDays != null) event.endsT = s.t + option.effect.resumeAfterDays;
+  if (option.effect.rainRateRestore) {
+    event.pumpPaidT = s.t;
+    event.restore = option.effect.rainRateRestore;
+    event.reworkMultiplier = option.effect.reworkMultiplier;
+  }
+}
+
+function applyLanded(s, order) {
+  const op = order.op, c = s.crews[order.crew];
+  if (op.op === 'hold') {
+    const fromT = Math.max(s.t, op.fromDay != null ? op.fromDay - 1 : s.t);
+    c.hold = { fromT, untilT: op.days != null ? fromT + op.days : null };
+    c.arguing = false;
+    c.stop = null;
+  } else if (op.op === 'resume') {
+    c.hold = c.stop = null;
+  } else if (op.op === 'lend') startLoan(s, op);
+  else if (op.op === 'protect') s.protections.push({ kind: op.kind, fromFt: op.fromFt, toFt: op.toFt, placedT: s.t });
+  else if (op.op === 'demob') {
+    c.demobilized = true;
+    c.demobBillingEndsT = nextBoundary(s.t);
+    c.arguing = false;
+  } else if (op.op === 'remob') {
+    s.spentUsd += s.scenario.rules.demobFeeUsd;
+    c.remobT = s.t + s.catalog.cities[s.scenario.city].remobilizationDelayDays;
+  }
+  order.appliedT = s.t;
+}
+
+export function issueOrder(s, op) {
+  if (op.op === 'radio') {
+    const order = s.orders.find(order => order.id === op.orderId);
+    order.issuedT = s.t;
+    order.landsT = landingTime(s, order.crew);
+    order.status = 'sent';
+    order.ignored = false;
+    order.reissued = true;
+    // Acknowledging an already-applied order must not buy or lend twice.
+    order.alreadyApplied = order.appliedT != null;
+    return;
+  }
+  const crew = op.crew ?? (op.op === 'lend' ? ownerOf(s, op.machine)
+    : op.op === 'order' ? s.catalog.machines[op.machine].crew : op.op === 'protect' ? 'exc' : null);
+  const order = { id: `o-${s.nextOrderId++}`, op: { ...op }, crew, issuedT: s.t,
+    landsT: OFFICE_OPS.has(op.op) ? s.t : landingTime(s, crew), status: 'sent' };
+  s.orders.push(order);
+  if (!s.pure) markFirstRadio(s, order);
+  if (op.op === 'protect') s.spentUsd += s.catalog.protection[op.kind].priceUsd;
+  if (op.op === 'order') purchase(s, op.machine);
+  if (op.op === 'hold') voice(s, 'holdCommitted', ['plan']);
+  if (op.op === 'demob') voice(s, 'demobCommitted', ['plan']);
+  if (!OFFICE_OPS.has(op.op)) return;
+  if (op.op === 'setStart') {
+    s.crews[op.crew].startDay = op.day;
+    s.plannedLines[op.crew].startDay = op.day;
+  } else if (op.op === 'enterPermit') s.permits[op.zone].entered = true;
+  else if (op.op === 'enterInspection') {
+    s.inspections[op.zone].cleared = true;
+    updateHoldPoints(s);
+  } else if (op.op === 'pay') pay(s, op);
+  order.appliedT = order.landedT = s.t;
+  order.status = 'landed';
+}
+
+export function updateOrders(s) {
+  for (const order of s.orders) {
+    if (order.status !== 'sent' || s.t < order.landsT - EPS) continue;
+    order.status = 'landed';
+    order.landedT = s.t;
+    voice(s, 'orderLanded', ['plan']);
+    if (!order.ignored && !order.alreadyApplied) applyLanded(s, order);
+  }
+  for (const loan of s.loans) {
+    if (loan.phase === 'outbound' && s.t >= loan.arrivesT - EPS) {
+      loan.phase = 'working';
+      const event = s.events.find(e => e.id === loan.eventId);
+      loan.returnsT = s.t + (event ? clearingDays(s, event, loan.machine) : loan.days);
+      if (event) { event.clearingT = s.t; event.endsT = loan.returnsT; }
+    }
+    if (loan.phase === 'working' && s.t >= loan.returnsT - EPS) {
+      loan.phase = 'returning';
+      loan.homeT = s.t + travelDays(s.crews[loan.toCrew].pos, s.crews[loan.fromCrew].pos);
+    }
+    if (loan.phase === 'returning' && s.t >= loan.homeT - EPS) {
+      loan.phase = 'returned';
+      s.crews[loan.fromCrew].lentAway = false;
+    }
+  }
+  for (const delivery of s.deliveries) {
+    if (!delivery.arrived && s.t >= delivery.arrivesT - EPS) {
+      delivery.arrived = true;
+      if (delivery.hired) {
+        const event = s.events.find(e => e.id === delivery.eventId);
+        event.clearingT = s.t;
+        event.endsT = s.t + clearingDays(s, event, delivery.machine);
+        delivery.releaseT = event.endsT;
+      } else {
+        const crew = s.crews[delivery.crew];
+        releaseMachine(s, crew.machine);
+        crew.machine = delivery.machine;
+      }
+    }
+    if (delivery.hired && delivery.arrived && !delivery.released && s.t >= delivery.releaseT - EPS) {
+      delivery.released = true;
+      releaseMachine(s, delivery.machine);
+    }
+  }
+}
diff --git a/Monitor/src/sim/permits.js b/Monitor/src/sim/permits.js
new file mode 100644
index 0000000000000000000000000000000000000000..4cb6b0afa25390897873b28fbc6c2baeecf8c8db
--- /dev/null
+++ b/Monitor/src/sim/permits.js
@@ -0,0 +1,45 @@
+import { EPS } from './common.js';
+import { boundaryAllowance } from './deviations.js';
+
+export function validatePermit(s, op) {
+  const card = s.scenario.permits.cards.find(card => card.zone === op.zone);
+  if (!card || card.code !== op.code) return 'code not on file';
+  if (!s.permits[op.zone].entered && Object.values(s.permits).filter(p => p.entered && !p.signed).length
+      >= s.scenario.permits.openZoneLimit) return `city limit: ${s.scenario.permits.openZoneLimit} zones open`;
+}
+
+export function validateInspection(s, op) {
+  const card = s.scenario.inspections.cards.find(card => card.zone === op.zone);
+  if (!card || card.number !== op.number) return 'code not on file';
+}
+
+export function excavationLimit(s, desired) {
+  const zone = s.scenario.job.zones.find(z => !s.permits[z.id].entered);
+  if (!zone) return s.scenario.job.lengthFt;
+  let limit = zone.fromFt;
+  if (desired >= limit - EPS && s.crews.exc.pos >= limit - EPS) limit = boundaryAllowance(s, zone);
+  // An already excavated F2 stretch is never rolled back by a later gate calculation.
+  return Math.max(s.crews.exc.pos, limit);
+}
+
+export function backfillLimit(s) {
+  if (!s.scenario.inspections.required) return s.scenario.job.lengthFt;
+  return s.scenario.job.zones.find(z => !s.inspections[z.id].cleared)?.toFt ?? s.scenario.job.lengthFt;
+}
+
+export function updateHoldPoints(s) {
+  for (const zone of s.scenario.job.zones) {
+    const inspection = s.inspections[zone.id];
+    if (s.crews.back.pos >= zone.toFt - EPS) {
+      if (!inspection.reported && s.scenario.inspections.required) {
+        inspection.reported = true;
+        // WO-02: both authored Texas stages return this compaction result.
+        s.inbox.push({ day: s.t, from: 'City inspector', subject: `Zone ${zone.id} compaction`, body: 'passed' });
+      }
+      if (inspection.cleared || !s.scenario.inspections.required) s.permits[zone.id].signed = true;
+    }
+  }
+}
+
+export const finalInspectionEntered = s => !s.scenario.inspections.required
+  || s.inspections[s.scenario.job.zones.at(-1).id].cleared;
diff --git a/Monitor/src/sim/rain.js b/Monitor/src/sim/rain.js
new file mode 100644
index 0000000000000000000000000000000000000000..5df93c2110b4353e48d9beeda076522c71de9901
--- /dev/null
+++ b/Monitor/src/sim/rain.js
@@ -0,0 +1,28 @@
+// WO-02 A2 rework rule: one authored duration per commenced 500 ft of open trench.
+export const REWORK_CHUNK_FT = 500;
+
+export function reworkDuration(openFt, daysPer500Ft, multiplier = 1) {
+  return Math.ceil(openFt / REWORK_CHUNK_FT) * daysPer500Ft * multiplier;
+}
+
+export function rainMultiplier(s, crewId) {
+  return s.events.filter(e => e.type === 'A2' && e.fired && !e.rainEnded)
+    .reduce((mult, e) => mult * (e.restore?.includes(crewId) ? 1 : 1 - e.rateDrop), 1);
+}
+
+export function finishRain(s, event) {
+  event.rainEnded = true;
+  event.reworkDays = reworkDuration(event.openFt, event.rework?.daysPer500Ft
+    ?? s.scenario.rules.rainReworkDaysPer500Ft,
+  event.rework?.pumpHalves && event.pumpPaidT != null && event.pumpPaidT < event.endsT
+    ? event.reworkMultiplier : 1);
+  event.reworkEndsT = event.endsT + event.reworkDays;
+}
+
+export const rainOrRework = s => s.events.some(e => e.type === 'A2' && e.fired && !e.resolved);
+export const pipeReworking = s => s.events.some(e => e.type === 'A2' && e.rainEnded && !e.resolved);
+export function sky(s) {
+  if (s.events.some(e => e.type === 'A2' && e.fired && !e.rainEnded)) return 'rain';
+  return s.events.some(e => !e.fired && e.forecast && s.t >= e.forecast.skyFromDay - 1)
+    ? 'towersSouth' : 'clear';
+}
diff --git a/Monitor/src/sim/sim.js b/Monitor/src/sim/sim.js
new file mode 100644
index 0000000000000000000000000000000000000000..145c4b2dec9c5f4d7bb402d244e2c2c28e47bc76
--- /dev/null
+++ b/Monitor/src/sim/sim.js
@@ -0,0 +1,197 @@
+import { makeRng } from '../common/rng.js';
+import { CREW_IDS, DT, EPS, copy, draftState, emit, voice } from './common.js';
+import { refreshCrews, moveCrews, updateMood } from './crews.js';
+import { detectConflicts, resolveConflicts, validateConflictCommit } from './conflict.js';
+import { updateEvents } from './events.js';
+import { accrue } from './money.js';
+import { issueOrder, updateOrders, validateOp } from './orders.js';
+import { finalInspectionEntered, updateHoldPoints } from './permits.js';
+import { applySite, updateTruck } from './site.js';
+import { view } from './views.js';
+
+function initialState(scenario, catalog, pure) {
+  const crews = Object.fromEntries(CREW_IDS.map(id => {
+    const crew = scenario.crews.find(c => c.id === id);
+    return [id, { ...crew, pos: 0, work: 0, onsite: 0, finishT: null,
+      rate: catalog.machines[crew.machine].rateFtPerDay, mult: 0, status: 'idle',
+      mood: 0, waitDays: 0, hold: null, stop: null, arguing: false, demobilized: false, lentAway: false }];
+  }));
+  const state = {
+    scenario, catalog, pure, rngState: makeRng(scenario.seed).state(),
+    t: 0, speed: 'full', pausedSpeed: 'full', done: false, result: null, crews,
+    capFt: scenario.capFt ?? null, orders: [], nextOrderId: 1, loans: [], deliveries: [], payments: [],
+    protections: [], events: copy(scenario.events ?? []), deviations: copy(scenario.deviations ?? []), conflicts: [],
+    permits: Object.fromEntries(scenario.job.zones.map(z => [z.id, { entered: pure || scenario.permits.heldBy === 'pm',
+      signed: false, number: scenario.permits.cards.find(c => c.zone === z.id)?.number }])),
+    inspections: Object.fromEntries(scenario.job.zones.map(z => [z.id, { cleared: pure || !scenario.inspections.required,
+      reported: false, number: scenario.inspections.cards.find(c => c.zone === z.id)?.number }])),
+    truck: { stationFt: 0, moving: false, dismounted: false }, flags: [], inbox: [], inboxDelivered: [], pmLines: [],
+    messages: [], changeLog: [], spentUsd: 0, crewCostUsd: 0, finesUsd: 0, peakOpenTrenchFt: 0,
+    actualLines: Object.fromEntries(CREW_IDS.map(id => [id, [{ t: 0, ft: 0 }]])),
+    plannedLines: Object.fromEntries(CREW_IDS.map(id => [id, { startDay: crews[id].startDay, rate: crews[id].rate, holds: [],
+      segments: [{ fromT: crews[id].startDay - 1, rate: crews[id].rate }] }])),
+    reportedLines: Object.fromEntries(CREW_IDS.map(id => [id, [{ t: 0, ft: 0 }]])),
+  };
+  if (!pure) { voice(state, 'stageStart', ['plan', 'site']); updateEvents(state); }
+  refreshCrews(state);
+  return state;
+}
+
+function recordActual(s) {
+  for (const id of CREW_IDS) {
+    if (s.actualLines[id].at(-1).t !== s.t) s.actualLines[id].push({ t: s.t, ft: s.crews[id].pos });
+  }
+}
+
+function report(s) {
+  const feetByCrew = Object.fromEntries(CREW_IDS.map(id => [id, Math.floor(s.crews[id].pos + EPS)]));
+  const notes = CREW_IDS.map(id => `${s.crews[id].name}: ${feetByCrew[id] - s.reportedLines[id].at(-1).ft} ft today`);
+  for (const id of CREW_IDS) s.reportedLines[id].push({ t: s.t, ft: feetByCrew[id] });
+  const item = { day: s.t, feetByCrew, spendUsd: s.spentUsd, notes };
+  s.inbox.push({ ...item, from: 'Daily report', subject: `Day ${s.t}` });
+  emit(s, 'report', { ...item, seats: ['plan', 'facilitator'] });
+}
+
+function finish(s) {
+  const lost = s.pure ? null : s.spentUsd > s.scenario.plan.budgetUsd ? 'budget'
+    : s.t > s.scenario.plan.deadlineDay - 1 + EPS ? 'deadline' : null;
+  const complete = s.crews.back.finishT != null && (s.pure || finalInspectionEntered(s));
+  if (!lost && !complete) return;
+  recordActual(s);
+  const idleDays = Object.fromEntries(CREW_IDS.map(id => [id, Math.max(0, s.crews[id].onsite - s.crews[id].work)]));
+  const planned = Object.fromEntries(CREW_IDS.map(id => {
+    const line = s.plannedLines[id];
+    let t = line.startDay - 1, ft = 0;
+    const points = [{ t, ft }];
+    for (const hold of [...line.holds].sort((a, b) => a.fromT - b.fromT)) {
+      ft = Math.min(s.scenario.job.lengthFt, ft + Math.max(0, hold.fromT - t) * line.rate);
+      t = Math.max(t, hold.fromT); points.push({ t, ft });
+      t = Math.max(t, hold.untilT ?? s.t); points.push({ t, ft });
+    }
+    points.push({ t: t + (s.scenario.job.lengthFt - ft) / line.rate, ft: s.scenario.job.lengthFt });
+    return [id, points];
+  }));
+  s.done = true;
+  s.result = {
+    ...(lost ? { lost } : { finishDay: s.crews.back.finishT }), promisedDay: s.scenario.plan.promisedFinishDay,
+    budgetUsd: s.scenario.plan.budgetUsd, spentUsd: s.spentUsd, crewCostUsd: s.crewCostUsd,
+    idleDays, idleCrewDays: CREW_IDS.reduce((total, id) => total + idleDays[id], 0),
+    peakOpenTrenchFt: s.peakOpenTrenchFt, finesUsd: s.finesUsd,
+    deviationsCaught: s.deviations.filter(d => d.triggered && d.caught).length,
+    deviationsMissed: s.deviations.filter(d => d.triggered && !d.caught).length,
+    events: s.events.filter(e => e.fired).map(e => ({ id: e.id, day: e.firedT, option: e.option ?? null,
+      daysLost: e.type === 'A2' ? e.durationDays * e.rateDrop + (e.reworkDays ?? 0)
+        : ((e.resolvedT ?? s.t) - e.firedT) * e.rateDrop, protection: e.protection })),
+    changeLog: copy(s.changeLog), lines: { planned, actual: copy(s.actualLines) },
+  };
+  if (!s.pure) {
+    voice(s, 'stageEnd', ['plan', 'site']);
+    emit(s, 'result', { stage: s.scenario.id, ...s.result, seats: ['plan', 'site', 'facilitator'] });
+  }
+}
+
+export function tickState(state, dt) {
+  if (state.done || state.speed === 'paused') return state;
+  const s = draftState(state);
+  if (!s.pure) { updateTruck(s); updateOrders(s); updateEvents(s); }
+  refreshCrews(s);
+  if (!s.pure) detectConflicts(s);
+  moveCrews(s, dt);
+  accrue(s, dt);
+  if (!s.pure) updateMood(s, dt);
+  // Quantizing arithmetic noise preserves exact shift boundaries across JS engines.
+  s.t = Number((s.t + dt).toFixed(10));
+  if (!s.pure) {
+    updateTruck(s); updateOrders(s); updateHoldPoints(s); updateEvents(s);
+  }
+  if (Math.floor(s.t + EPS) > Math.floor(state.t + EPS)) {
+    recordActual(s);
+    if (!s.pure) report(s);
+  }
+  finish(s);
+  return s;
+}
+
+function commit(state, ops) {
+  if (!Array.isArray(ops)) return { reason: 'invalid commit' };
+  const conflictReason = validateConflictCommit(state, ops);
+  if (conflictReason) return { reason: conflictReason };
+  const s = draftState(state);
+  for (const op of ops) {
+    const reason = validateOp(s, op);
+    if (reason) return { reason };
+    // Staging on the draft validates sequential office actions without any partial commit.
+    issueOrder(s, op);
+  }
+  resolveConflicts(s);
+  for (const id of CREW_IDS) {
+    if (!ops.some(op => op.op === 'hold' && op.crew === id)) s.crews[id].stop = null;
+  }
+  for (const op of ops) {
+    if (op.op === 'hold') {
+      const order = s.orders.findLast(order => order.op.op === 'hold' && order.crew === op.crew);
+      const fromT = Math.max(order.landsT, op.fromDay != null ? op.fromDay - 1 : order.landsT);
+      s.plannedLines[op.crew].holds.push({ fromT, untilT: op.days == null ? null : fromT + op.days });
+    }
+  }
+  updateOrders(s);
+  updateHoldPoints(s);
+  refreshCrews(s);
+  s.changeLog.push({ day: s.t, ops: copy(ops) });
+  if (s.speed === 'paused') s.pausedSpeed = 'full'; else s.speed = 'full';
+  finish(s);
+  return { state: s };
+}
+
+export function createSim(scenario, catalog, { pure = false } = {}) {
+  // JSON copying also accepts the WO-01 loader's frozen scenario with derived functions.
+  const source = copy(scenario), fleet = copy(catalog);
+  let state = initialState(source, fleet, pure);
+  return {
+    get t() { return state.t; }, get speed() { return state.speed; },
+    get done() { return state.done; }, get result() { return copy(state.result); },
+    tick(dt = DT) {
+      if (!Number.isFinite(dt) || dt <= 0) throw new RangeError('dt must be positive');
+      let remaining = dt;
+      while (remaining > EPS && !state.done && state.speed !== 'paused') {
+        const step = Math.min(DT, remaining);
+        state = tickState(state, step);
+        remaining -= step;
+      }
+    },
+    apply(seat, cmd) {
+      if (!cmd || typeof cmd !== 'object') return { ok: false, reason: 'invalid command' };
+      if (seat === 'facilitator') {
+        if (cmd.action === 'load' && cmd.stage !== source.id) return { ok: false, reason: 'stage not loaded' };
+        if (cmd.action === 'reset' || cmd.action === 'load') state = initialState(source, fleet, pure);
+        else if (cmd.action === 'pause') {
+          state = draftState(state);
+          if (state.speed !== 'paused') state.pausedSpeed = state.speed;
+          state.speed = 'paused';
+        } else if (cmd.action === 'start' || cmd.action === 'resume') {
+          state = draftState(state); state.speed = state.pausedSpeed;
+        } else return { ok: false, reason: 'unknown control' };
+        return { ok: true, appliedDay: state.t };
+      }
+      if (state.done) return { ok: false, reason: 'stage ended' };
+      if (seat === 'plan' && cmd.action === 'commit') {
+        const result = commit(state, cmd.ops);
+        if (result.reason) {
+          if (result.reason === 'not in the budget') {
+            state = draftState(state); voice(state, 'prepRefused', ['plan']);
+          }
+          return { ok: false, reason: result.reason };
+        }
+        state = result.state;
+      } else if (seat === 'site') {
+        const draft = draftState(state), reason = applySite(draft, cmd);
+        if (reason) return { ok: false, reason };
+        state = draft;
+      } else return { ok: false, reason: 'action unavailable for seat' };
+      return { ok: true, appliedDay: state.t };
+    },
+    view: seat => view(state, seat),
+    drain() { const messages = copy(state.messages); state = { ...state, messages: [] }; return messages; },
+    serialize: () => copy(state),
+  };
+}
diff --git a/Monitor/src/sim/site.js b/Monitor/src/sim/site.js
new file mode 100644
index 0000000000000000000000000000000000000000..e8a21639d28b74ec188688f4bc3133378c83ba57
--- /dev/null
+++ b/Monitor/src/sim/site.js
@@ -0,0 +1,81 @@
+import { CREW_IDS, EPS, HOURS_PER_DAY, activeCollapse, crewAt, emit, nearby, travelDays, voice, zoneAt } from './common.js';
+import { confirmDeviation, inspectProtection } from './deviations.js';
+import { inspectionText, stakeAt } from './views.js';
+
+const TARGETS = new Set(['wall', 'water', 'pipe', 'machine', 'protection', 'board', 'sky', 'ticket', 'crew']);
+export function applySite(s, cmd) {
+  const truck = s.truck;
+  if (cmd.action === 'moveTo') {
+    if (truck.moving || truck.dismounted) return 'mount before moving';
+    if (!Number.isFinite(cmd.stationFt) || cmd.stationFt < 0 || cmd.stationFt > s.scenario.job.lengthFt) return 'invalid station';
+    truck.fromFt = truck.stationFt;
+    truck.toFt = cmd.stationFt;
+    truck.departT = s.t;
+    truck.arrivesT = s.t + travelDays(truck.stationFt, cmd.stationFt);
+    truck.moving = truck.arrivesT > s.t;
+    return;
+  }
+  if (cmd.action === 'mount' || cmd.action === 'dismount') {
+    if (truck.moving) return 'truck moving';
+    truck.dismounted = cmd.action === 'dismount';
+    return;
+  }
+  if (!truck.dismounted || truck.moving) return 'dismount first';
+  if (cmd.action === 'inspect') {
+    if (!TARGETS.has(cmd.target)) return 'unknown inspection target';
+    const ft = stakeAt(s, truck.stationFt);
+    if (cmd.target === 'protection') inspectProtection(s, ft);
+    const event = activeCollapse(s);
+    if (event && stakeAt(s, event.stationFt) === ft) event.inspected = true;
+    emit(s, 'inspection', { id: cmd.id, target: cmd.target, text: inspectionText(s, cmd.target), seats: ['site'] });
+    return;
+  }
+  if (cmd.action === 'flag') {
+    // Protocol caps authored notes at 40 characters.
+    const MAX_NOTE_LENGTH = 40;
+    if (!Number.isFinite(cmd.stationFt) || cmd.stationFt < 0 || cmd.stationFt > s.scenario.job.lengthFt
+      || cmd.note != null && (typeof cmd.note !== 'string' || cmd.note.length > MAX_NOTE_LENGTH)) return 'invalid flag';
+    s.flags.push({ stationFt: cmd.stationFt, day: s.t, ...(cmd.note ? { note: cmd.note } : {}) });
+    return;
+  }
+  if (cmd.action === 'stopWork') {
+    if (zoneAt(s, truck.stationFt)?.id !== cmd.zone) return 'outside zone';
+    for (const id of CREW_IDS) {
+      const c = s.crews[id];
+      if (zoneAt(s, c.pos)?.id === cmd.zone) c.stop = { zone: cmd.zone,
+        fromT: s.t + s.scenario.rules.stopWorkReachHours / HOURS_PER_DAY };
+    }
+    return;
+  }
+  if (cmd.action === 'confirm') {
+    const order = s.orders.find(order => order.id === cmd.orderId);
+    if (!order?.crew || order.landedT == null || order.status === 'sent'
+      || !nearby(s, s.crews[order.crew].pos)) return 'order not landed here';
+    if (!['done', 'notDone'].includes(cmd.outcome)) return 'invalid outcome';
+    order.status = cmd.outcome === 'done' ? 'confirmed' : 'notCarriedOut';
+    confirmDeviation(s, order, cmd.outcome);
+    if (cmd.outcome === 'notDone') voice(s, 'orderNotDone', ['plan']);
+    return;
+  }
+  if (cmd.action === 'listen') {
+    const c = crewAt(s);
+    if (c?.arguing) {
+      const conflict = s.conflicts.find(conflict => conflict.trailing === c.id || conflict.leader === c.id);
+      voice(s, 'conflict', ['site'], [conflict.trailing, conflict.leader]);
+    } else if (c && (c.status === 'held' || c.status === 'stopped') && c.mood > 0) {
+      voice(s, `heldDay${c.mood}`, ['site'], [c.id]);
+    } else emit(s, 'inspection', { id: cmd.id, target: 'crew', text: 'Nothing to hear.', seats: ['site'] });
+    return;
+  }
+  return 'unknown action';
+}
+
+export function updateTruck(s) {
+  const truck = s.truck;
+  if (!truck.moving) return;
+  if (s.t >= truck.arrivesT - EPS) {
+    truck.stationFt = truck.toFt;
+    truck.moving = false;
+  } else truck.stationFt = truck.fromFt + (truck.toFt - truck.fromFt)
+    * (s.t - truck.departT) / (truck.arrivesT - truck.departT);
+}
diff --git a/Monitor/src/sim/views.js b/Monitor/src/sim/views.js
new file mode 100644
index 0000000000000000000000000000000000000000..8ce12a7e1c78036367afecb05c6241613c7ecd39
--- /dev/null
+++ b/Monitor/src/sim/views.js
@@ -0,0 +1,137 @@
+import { CREW_IDS, EPS, LEADER, MOODS, NEAR_FT, activeCollapse, copy, crewAt,
+  displayDay, nearby, protectionAt, zoneAt } from './common.js';
+import { availableResponses } from './events.js';
+import { rainOrRework, sky } from './rain.js';
+
+const clean = value => Array.isArray(value) ? value.map(clean) : value && typeof value === 'object'
+  ? Object.fromEntries(Object.entries(value).filter(([key]) => !key.startsWith('_')).map(([key, v]) => [key, clean(v)])) : value;
+export const stakeAt = (s, ft) => Math.round(ft / s.scenario.job.stationEveryFt) * s.scenario.job.stationEveryFt;
+const collapseHere = (s, ft) => {
+  const event = activeCollapse(s);
+  return event && stakeAt(s, event.stationFt) === stakeAt(s, ft);
+};
+const groundAt = (s, ft) => s.scenario.ground.segments.find(segment => ft >= segment.fromFt && ft <= segment.toFt);
+
+export function trenchAt(s, stationFt) {
+  const passed = id => s.crews[id].pos > stationFt + EPS || s.crews[id].finishT != null;
+  const state = !passed('exc') ? 'undug' : !passed('pipe') ? 'open' : !passed('back') ? 'piped' : 'backfilled';
+  const open = state === 'open' || state === 'piped';
+  const p = protectionAt(s, stationFt);
+  return { stationFt, state,
+    water: collapseHere(s, stationFt) || open && rainOrRework(s) ? 'standing'
+      : open && groundAt(s, stationFt)?.seepage ? 'seep' : 'none',
+    wall: collapseHere(s, stationFt) ? 'slumped' : 'sound',
+    protection: p ? p.kind.replace('trench_', '') : 'none', pipeDamage: 'none' };
+}
+
+export function crewText(s, c) {
+  if (!c) return 'No machine within sight.';
+  let text = 'Working.';
+  if (c.status === 'demobilized') text = 'Demobilized.';
+  else if (c.status === 'arguing') {
+    const conflict = s.conflicts.find(conflict => !conflict.resolved
+      && (conflict.trailing === c.id || conflict.leader === c.id));
+    const other = conflict && s.crews[conflict.trailing === c.id ? conflict.leader : conflict.trailing];
+    text = `Arguing with ${other?.name ?? s.crews[LEADER[c.id]]?.name ?? c.name}.`;
+  } else if (c.status === 'stopped') text = 'Stopped: stop-work.';
+  else if (c.status === 'held') text = `Held by the office since Day ${displayDay(c.hold.fromT)}.`;
+  else if (c.status === 'idle') text = `Idle, waiting on ${s.crews[LEADER[c.id]]?.name ?? c.name}.`;
+  return `${text} ${MOODS[c.mood]}`;
+}
+
+export function inspectionText(s, target) {
+  const ft = stakeAt(s, s.truck.stationFt), c = crewAt(s), p = protectionAt(s, ft);
+  const zone = zoneAt(s, ft);
+  const segment = groundAt(s, ft);
+  if (target === 'wall') {
+    if (collapseHere(s, ft)) return 'Wall slumped into the trench.';
+    if (s.crews.exc.pos <= ft + EPS) return 'Not excavated here yet.';
+    return segment?.indicator.wall ?? s.scenario.ground.defaultIndicator.wall;
+  }
+  if (target === 'water') {
+    if (trenchAt(s, ft).water === 'standing') return 'Standing water in the trench bottom.';
+    return segment?.indicator.water ?? s.scenario.ground.defaultIndicator.water;
+  }
+  if (target === 'machine') {
+    if (!c) return 'No machine within sight.';
+    const machine = s.catalog.machines[c.machine];
+    return `${c.name}: ${machine.label}, plate ${machine.sizeClass}`;
+  }
+  if (target === 'protection') return p
+    ? `${s.catalog.protection[p.kind].label} in place, ${p.fromFt} to ${p.toFt}` : 'No protection here.';
+  if (target === 'board') {
+    const permit = s.permits[zone.id], inspection = s.inspections[zone.id];
+    return `Zone ${zone.id} board: ${permit.entered ? `permit ${permit.number}` : 'no permit posted'}`
+      + (inspection.cleared ? `; inspection ${inspection.number}` : '');
+  }
+  if (target === 'sky') return { clear: 'Clear.', towersSouth: 'Towers building to the south.', rain: 'Rain.' }[sky(s)];
+  if (target === 'ticket') {
+    const delivery = s.deliveries.find(d => !d.arrived);
+    return delivery ? `Delivery ticket: ${s.catalog.machines[delivery.machine].label}, due Day ${displayDay(delivery.arrivesT)}`
+      : 'No truck at the gate.';
+  }
+  if (target === 'crew') return crewText(s, c);
+  if (target === 'pipe') return s.crews.back.pos > ft + EPS ? 'Backfilled.'
+    : s.crews.pipe.pos > ft + EPS ? 'Pipe laid, open trench.' : 'No pipe here yet.';
+}
+
+export function publicOrder(order) {
+  // The radio log carries the issued instruction, not whether the crew obeyed it.
+  return { id: order.id, op: order.op, crew: order.crew, issuedDay: order.issuedT,
+    landsDay: order.landsT, status: order.status };
+}
+
+export function planView(s) {
+  return {
+    plannedLines: s.plannedLines,
+    responses: availableResponses(s).map(({ event, option }) => ({ key: option.key, label: option.label,
+      cost: option.cost, eventTitle: event.card.title })),
+    reportedLines: s.reportedLines,
+    budget: { budgetUsd: s.scenario.plan.budgetUsd, spentUsd: s.spentUsd, committedUsd: s.spentUsd,
+      deadlineDay: s.scenario.plan.deadlineDay, promisedDay: s.scenario.plan.promisedFinishDay },
+    inbox: s.inbox, radioLog: s.orders.map(publicOrder),
+    catalog: { machines: Object.fromEntries(Object.entries(s.catalog.machines).filter(([key]) => !key.startsWith('_'))
+      .map(([key, machine]) => [key, { ...clean(machine), leadDays: { normal: machine.leadDays.normal
+        + s.catalog.cities[s.scenario.city].leadDelayDays } }])), protection: clean(s.catalog.protection) },
+    permits: s.scenario.job.zones.map(z => ({ zone: z.id, entered: s.permits[z.id].entered,
+      ...(s.permits[z.id].entered ? { number: s.permits[z.id].number } : {}) })),
+    inspections: s.scenario.job.zones.map(z => ({ zone: z.id, cleared: s.inspections[z.id].cleared })),
+    flags: s.flags, draft: [],
+    uncertainty: Object.fromEntries(CREW_IDS.map(id => {
+      const report = s.reportedLines[id].at(-1);
+      const estimate = report.ft + s.plannedLines[id].rate * Math.max(0, s.t - Math.max(report.t, s.plannedLines[id].startDay - 1));
+      const band = s.t <= report.t + EPS ? 0 : s.scenario.rules.uncertaintyBandFt;
+      return [id, { estimateFt: Math.min(s.scenario.job.lengthFt, estimate),
+        fromFt: Math.max(0, estimate - band), toFt: Math.min(s.scenario.job.lengthFt, estimate + band), asOfT: report.t }];
+    })), pmLines: s.pmLines,
+  };
+}
+
+export function siteView(s) {
+  const trench = [];
+  for (let ft = 0; ft <= s.scenario.job.lengthFt; ft += s.scenario.job.stationEveryFt) trench.push(trenchAt(s, ft));
+  const localEvent = s.events.find(e => e.fired && !e.resolved
+    && (e.zone == null || e.zone === zoneAt(s, s.truck.stationFt)?.id || e.inspected));
+  return {
+    truck: { stationFt: s.truck.stationFt, moving: s.truck.moving, dismounted: s.truck.dismounted },
+    crews: CREW_IDS.map(id => { const c = s.crews[id], size = s.catalog.machines[c.machine].sizeClass;
+      return { id, stationFt: c.pos, status: c.status, machinePlate: size[0].toUpperCase() + size.slice(1), moodLevel: c.mood }; }),
+    trench, boards: s.scenario.job.zones.map(z => ({ zone: z.id,
+      permitNumber: s.permits[z.id].entered ? s.permits[z.id].number : null,
+      inspectionNumber: s.inspections[z.id].cleared ? s.inspections[z.id].number : null })),
+    sky: sky(s), gate: { trucksWaiting: s.deliveries.filter(d => !d.arrived).length },
+    activeEvent: localEvent ? { id: localEvent.id, card: localEvent.shownCard } : null,
+    orders: s.orders.filter(order => order.crew && order.landedT != null && order.status !== 'confirmed'
+      && nearby(s, s.crews[order.crew].pos)).map(publicOrder),
+  };
+}
+
+export function view(s, seat) {
+  if (seat === 'plan') return copy(planView(s));
+  if (seat === 'site') return copy(siteView(s));
+  if (seat === 'facilitator') {
+    const { messages, ...state } = s;
+    return copy({ ...state, plan: planView(s), site: siteView(s) });
+  }
+  throw new Error('unknown seat');
+}

