diff --git a/Monitor/src/sim/common.js b/Monitor/src/sim/common.js
new file mode 100644
index 0000000000000000000000000000000000000000..179e795c5da02aeed538d0f05dd52e7aa560459b
--- /dev/null
+++ b/Monitor/src/sim/common.js
@@ -0,0 +1,46 @@
+// WO-02 crew order, precision, haul-road speed, proximity and mood conventions.
+export const CREW_IDS = ['exc', 'pipe', 'back'];
+export const LEADER = { pipe: 'exc', back: 'pipe' };
+export const DT = 0.01;
+export const EPS = 1e-6;
+export const NEAR_FT = 100;
+export const HAUL_FT_PER_HOUR = 1500;
+export const HOURS_PER_DAY = 24;
+export const MAX_MOOD = 3;
+export const MOODS = ['calm', 'grumbling', 'angry', 'furious'];
+// WO-02: conflicts look one day ahead; P1 durations round to half days.
+export const CONFLICT_LOOKAHEAD_DAYS = 1;
+export const CLEARING_DAY_STEP = 0.5;
+export const travelDays = (a, b) => Math.abs(a - b) / HAUL_FT_PER_HOUR / HOURS_PER_DAY;
+export const displayDay = t => Math.floor(t + EPS) + 1;
+export const nextBoundary = t => Math.floor(t + EPS) + 1;
+export const copy = value => JSON.parse(JSON.stringify(value));
+export const zoneAt = (s, ft) => s.scenario.job.zones.find(z => ft >= z.fromFt
+  && (ft < z.toFt || ft === s.scenario.job.lengthFt));
+export const nearby = (s, ft) => s.truck.dismounted && !s.truck.moving
+  && Math.abs(s.truck.stationFt - ft) <= NEAR_FT;
+export const crewAt = s => CREW_IDS.map(id => s.crews[id])
+  .filter(c => Math.abs(c.pos - s.truck.stationFt) <= NEAR_FT)
+  .sort((a, b) => Math.abs(a.pos - s.truck.stationFt) - Math.abs(b.pos - s.truck.stationFt))[0];
+export const protectionAt = (s, ft) => s.protections.find(p => ft >= p.fromFt && ft <= p.toFt);
+export const activeCollapse = s => s.events.find(e => e.type === 'P1' && e.fired && !e.resolved);
+export const emit = (s, type, fields) => s.messages.push({ t: type, v: 1, ...fields });
+
+export function voice(s, trigger, seats, crewIds) {
+  const lines = s.scenario.lines.filter(line => line.trigger === trigger
+    && (!crewIds || crewIds.includes(line.speaker.replace('foreman_', ''))));
+  if (!lines.length) return;
+  emit(s, 'voice', { lineIds: lines.map(line => line.id), seats });
+  s.pmLines.push(...lines.filter(line => line.speaker === 'pm').map(line => line.text));
+}
+
+// Reducers own this draft; source state and caller-owned scenario/catalog stay untouched.
+// Histories are append-only, so copying their outer arrays avoids repeatedly cloning points.
+export function draftState(s) {
+  const { scenario, catalog, actualLines, plannedLines, inbox, changeLog, messages, ...dynamic } = s;
+  return {
+    ...structuredClone(dynamic), scenario, catalog,
+    actualLines: Object.fromEntries(CREW_IDS.map(id => [id, [...actualLines[id]]])),
+    plannedLines: copy(plannedLines), inbox: [...inbox], changeLog: [...changeLog], messages: [...messages],
+  };
+}
diff --git a/Monitor/src/sim/conflict.js b/Monitor/src/sim/conflict.js
new file mode 100644
index 0000000000000000000000000000000000000000..c2c23dc20222e52908a39ab61fe65f6b50f5a5a4
--- /dev/null
+++ b/Monitor/src/sim/conflict.js
@@ -0,0 +1,34 @@
+import { LEADER, EPS, CONFLICT_LOOKAHEAD_DAYS, emit, voice } from './common.js';
+
+export function detectConflicts(s) {
+  for (const [trailingId, leaderId] of Object.entries(LEADER)) {
+    const trailing = s.crews[trailingId], leader = s.crews[leaderId];
+    const key = `${trailingId}:${leaderId}`;
+    if (s.conflicts.some(c => c.pair === key) || trailing.mult <= 0 || trailing.pos >= leader.pos - EPS) continue;
+    if (trailing.pos + trailing.rate * trailing.mult * CONFLICT_LOOKAHEAD_DAYS
+      <= leader.pos + leader.rate * leader.mult * CONFLICT_LOOKAHEAD_DAYS + EPS) continue;
+    s.conflicts.push({ pair: key, trailing: trailingId, leader: leaderId, firedT: s.t, resolved: false });
+    trailing.arguing = leader.arguing = true;
+    trailing.mult = leader.mult = 0;
+    trailing.status = leader.status = 'arguing';
+    s.speed = 'slow';
+    voice(s, 'conflict', ['site'], [trailingId, leaderId]);
+    emit(s, 'event', { eventId: `conflict_${trailingId}_${leaderId}`, day: s.t,
+      stationFt: trailing.pos, zone: null, seats: ['site'],
+      card: { title: 'Crews stopped', facts: [`${trailing.name} and ${leader.name} foremen are arguing.`] } });
+  }
+}
+
+export function validateConflictCommit(s, ops) {
+  if (s.conflicts.some(c => !c.resolved && !ops.some(op => op.crew === c.trailing
+    && (op.op === 'hold' || op.op === 'demob')))) return 'conflict: hold or demobilize the trailing crew';
+}
+
+export function resolveConflicts(s) {
+  for (const conflict of s.conflicts.filter(c => !c.resolved)) {
+    conflict.resolved = true;
+    conflict.resolvedT = s.t;
+    // The trailing crew waits for its field order; only the leader resumes at commit.
+    s.crews[conflict.leader].arguing = false;
+  }
+}
diff --git a/Monitor/src/sim/crews.js b/Monitor/src/sim/crews.js
new file mode 100644
index 0000000000000000000000000000000000000000..c845c0fc3381453af124ea410b302caa3c30df2c
--- /dev/null
+++ b/Monitor/src/sim/crews.js
@@ -0,0 +1,79 @@
+import { CREW_IDS, LEADER, EPS, MAX_MOOD, voice } from './common.js';
+import { excavationLimit, backfillLimit, finalInspectionEntered } from './permits.js';
+import { rainMultiplier, pipeReworking } from './rain.js';
+
+export function refreshCrews(s) {
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    if (c.hold?.untilT != null && s.t >= c.hold.untilT - EPS) c.hold = null;
+    if (c.remobT != null && s.t >= c.remobT - EPS) {
+      c.demobilized = false;
+      c.demobBillingEndsT = null;
+      c.remobT = null;
+    }
+    c.rate = s.catalog.machines[c.machine].rateFtPerDay;
+    for (const loan of s.loans.filter(l => l.toCrew === id && l.phase === 'working' && !l.eventId)) {
+      c.rate += s.catalog.machines[loan.machine].rateFtPerDay;
+    }
+    const held = c.hold && s.t >= c.hold.fromT - EPS;
+    const stopped = c.stop && s.t >= c.stop.fromT - EPS;
+    c.status = c.demobilized ? 'demobilized' : c.arguing ? 'arguing'
+      : stopped ? 'stopped' : held ? 'held' : 'working';
+    c.mult = 1;
+    if (s.t < c.startDay - 1 - EPS || c.finishT != null) { c.mult = 0; c.status = 'idle'; }
+    if (c.demobilized || c.arguing || stopped || held || c.lentAway) c.mult = 0;
+    if (!s.pure) {
+      c.mult *= rainMultiplier(s, id);
+      for (const event of s.events.filter(e => e.fired && !e.resolved && e.type !== 'A2'
+        && (e.hits === id || e.hits === 'all'))) c.mult *= 1 - event.rateDrop;
+      if (id === 'pipe' && pipeReworking(s)) c.mult = 0;
+    }
+    if (!c.mult && c.status === 'working') c.status = 'idle';
+  }
+}
+
+export function moveCrews(s, dt) {
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    if (s.t < c.startDay - 1 - EPS || c.finishT != null) continue;
+    const leader = LEADER[id] && s.crews[LEADER[id]];
+    let limit = Math.min(s.scenario.job.lengthFt, leader?.pos ?? s.scenario.job.lengthFt);
+    let desired = c.pos + c.rate * c.mult * dt;
+    c.idleReason = null;
+    if (s.pure && id === 'exc' && s.capFt != null) limit = Math.min(limit, s.crews.back.pos + s.capFt);
+    if (!s.pure && id === 'exc') {
+      const permitLimit = excavationLimit(s, c.mult > 0 ? desired : c.pos);
+      limit = Math.min(limit, permitLimit);
+      if (desired > permitLimit || c.pos >= permitLimit - EPS && permitLimit < s.scenario.job.lengthFt) c.idleReason = 'idleNoPermit';
+    }
+    if (!s.pure && id === 'back') {
+      const holdPoint = backfillLimit(s);
+      limit = Math.min(limit, holdPoint);
+      if (desired > holdPoint || c.pos >= holdPoint - EPS && !finalInspectionEntered(s)) c.idleReason = 'idleHoldPoint';
+    }
+    desired = Math.max(c.pos, Math.min(desired, limit));
+    const moved = desired - c.pos;
+    c.work += moved / c.rate;
+    c.pos = desired;
+    c.moved = moved;
+    if (leader && moved < c.rate * c.mult * dt - EPS && !c.idleReason) c.idleReason = 'leader';
+    if (c.status === 'working' && moved < EPS) c.status = 'idle';
+    if (c.pos >= s.scenario.job.lengthFt - EPS
+      && (id !== 'back' || s.pure || finalInspectionEntered(s))) c.finishT = s.t + dt;
+  }
+  s.peakOpenTrenchFt = Math.max(s.peakOpenTrenchFt, s.crews.exc.pos - s.crews.back.pos);
+}
+
+export function updateMood(s, dt) {
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    const held = c.status === 'held' || c.status === 'stopped';
+    const waiting = held || c.idleReason === 'leader';
+    c.waitDays = waiting ? c.waitDays + dt : 0;
+    const level = Math.min(MAX_MOOD, Math.floor((c.waitDays + EPS) / s.scenario.rules.moodStepDays));
+    if (held && level > c.mood) {
+      for (let mood = c.mood + 1; mood <= level; mood++) voice(s, `heldDay${mood}`, ['site'], [id]);
+    }
+    c.mood = level;
+  }
+}
diff --git a/Monitor/src/sim/deviations.js b/Monitor/src/sim/deviations.js
new file mode 100644
index 0000000000000000000000000000000000000000..a8d8c1fd2481639761e94bf1135e0aba3cd5e9f7
--- /dev/null
+++ b/Monitor/src/sim/deviations.js
@@ -0,0 +1,54 @@
+import { EPS, nearby, nextBoundary, protectionAt } from './common.js';
+
+export function markFirstRadio(s, order) {
+  const d = s.deviations.find(d => d.type === 'F1' && !d.triggered
+    && d.when.ops.includes(order.op.op) && order.landsT > order.issuedT);
+  if (d) {
+    d.triggered = true;
+    d.orderId = order.id;
+    order.ignored = true;
+  }
+}
+
+export function confirmDeviation(s, order, outcome) {
+  const d = s.deviations.find(d => d.type === 'F1' && d.orderId === order.id);
+  if (d && outcome === 'notDone' && s.t < nextBoundary(order.landedT) - EPS) d.caught = true;
+}
+
+export function boundaryAllowance(s, zone) {
+  const d = s.deviations.find(d => d.type === 'F2');
+  if (!d) return zone.fromFt;
+  if (d.triggered) return d.zone === zone.id && !d.caught ? zone.fromFt + d.overshootFt : zone.fromFt;
+  d.triggered = true;
+  d.zone = zone.id;
+  d.caught = nearby(s, zone.fromFt) || !!s.crews.exc.hold || !!s.crews.exc.stop;
+  if (!d.caught) {
+    s.finesUsd += s.scenario.rules.permitFineUsd;
+    s.spentUsd += s.scenario.rules.permitFineUsd;
+  }
+  return d.caught ? zone.fromFt : zone.fromFt + d.overshootFt;
+}
+
+export function inspectProtection(s, stationFt) {
+  const p = protectionAt(s, stationFt);
+  if (!p) return;
+  for (const d of s.deviations.filter(d => d.type === 'F3')) {
+    const e = s.events.find(e => e.id === d.when.eventId);
+    if (!e?.fired && !(e.stationFt >= p.fromFt && e.stationFt <= p.toFt)) d.inspected = true;
+  }
+}
+
+export function eventDeviations(s, event) {
+  for (const d of s.deviations.filter(d => d.type === 'F3' && d.when.eventId === event.id)) {
+    const missedStretch = s.protections.some(p => event.stationFt < p.fromFt || event.stationFt > p.toFt);
+    if (missedStretch && !protectionAt(s, event.stationFt)) {
+      d.triggered = true;
+      d.caught = !!d.inspected;
+    }
+  }
+}
+
+// WO-02 reserves F5's firstLend hook but specifies no delay behaviour in these stages.
+export function firstLend(s) {
+  for (const d of s.deviations.filter(d => d.type === 'F5' && !d.triggered)) d.triggered = true;
+}
diff --git a/Monitor/src/sim/events.js b/Monitor/src/sim/events.js
new file mode 100644
index 0000000000000000000000000000000000000000..6dd5563652a7dc396feceb828526a2aa0cbb007a
--- /dev/null
+++ b/Monitor/src/sim/events.js
@@ -0,0 +1,54 @@
+import { CLEARING_DAY_STEP, EPS, emit, protectionAt } from './common.js';
+import { eventDeviations } from './deviations.js';
+import { finishRain } from './rain.js';
+
+export function clearingDays(s, event, machine) {
+  const size = s.catalog.machines[machine].sizeClass;
+  const severity = event.protection ? event.severityByProtection[event.protection] ?? 1 : 1;
+  return Math.round(event.durationDaysByExcavator[size] * severity / CLEARING_DAY_STEP) * CLEARING_DAY_STEP;
+}
+
+export function availableResponses(s) {
+  return s.events.flatMap(event => (event.fired && !event.resolved
+    || event.forecast && s.t >= event.forecast.inboxDay - 1 && !event.resolved)
+    ? (event.options ?? []).map(option => ({ event, option })) : []);
+}
+
+export function updateEvents(s) {
+  for (const event of s.events) {
+    if (event.forecast && !event.forecastSent && s.t >= event.forecast.inboxDay - 1 - EPS) {
+      event.forecastSent = true;
+      s.inbox.push({ day: event.forecast.inboxDay - 1, from: 'Forecast', subject: 'Weather', body: event.forecast.text });
+    }
+    if (!event.fired) {
+      const trigger = event.trigger;
+      const ready = trigger.kind === 'day' ? s.t >= trigger.day - 1 - EPS
+        : trigger.kind === 'crewReaches' ? s.crews[trigger.crew].pos >= trigger.ft - EPS
+          : trigger.kind === 'zoneSigned' && s.permits[trigger.zone].signed;
+      if (!ready) continue;
+      event.fired = true;
+      event.firedT = s.t;
+      event.protection = protectionAt(s, event.stationFt)?.kind ?? null;
+      event.shownCard = event.protection && event.cardWhenProtected ? event.cardWhenProtected : event.card;
+      event.endsT = event.type === 'P1' ? null : s.t + event.durationDays;
+      if (event.type === 'A2') event.openFt = Math.max(0, s.crews.exc.pos - s.crews.back.pos);
+      s.speed = 'slow';
+      emit(s, 'event', { eventId: event.id, day: s.t, zone: event.zone, stationFt: event.stationFt,
+        card: event.shownCard, seats: event.visibleTo });
+      eventDeviations(s, event);
+    }
+    if (event.resolved || event.endsT == null || s.t < event.endsT - EPS) continue;
+    if (event.type === 'A2') {
+      if (!event.rainEnded) finishRain(s, event);
+      if (s.t < event.reworkEndsT - EPS) continue;
+    }
+    event.resolved = true;
+    event.resolvedT = s.t;
+  }
+  s.scenario.inbox.forEach((item, index) => {
+    if (!s.inboxDelivered.includes(index) && s.t >= item.day - 1 - EPS) {
+      s.inboxDelivered.push(index);
+      s.inbox.push({ ...item, day: item.day - 1 });
+    }
+  });
+}
diff --git a/Monitor/src/sim/money.js b/Monitor/src/sim/money.js
new file mode 100644
index 0000000000000000000000000000000000000000..4b431b5f3c968c6dc598c65d3edd32292eaaea83
--- /dev/null
+++ b/Monitor/src/sim/money.js
@@ -0,0 +1,34 @@
+import { CREW_IDS, EPS } from './common.js';
+
+export const billing = (s, c) => s.t >= c.startDay - 1 - EPS && c.finishT == null
+  && !(c.demobBillingEndsT != null && s.t >= c.demobBillingEndsT - EPS);
+
+export function accrue(s, dt) {
+  const overhead = 1 + s.scenario.rules.overheadRate;
+  let crewDaily = 0;
+  for (const id of CREW_IDS) {
+    const c = s.crews[id];
+    if (billing(s, c)) {
+      c.onsite += dt;
+      crewDaily += s.catalog.machines[c.machine].dailyUsd;
+    }
+  }
+  const protectionDaily = s.protections.reduce((sum, p) => sum
+    + (CREW_IDS.some(id => {
+      const c = s.crews[id];
+      return c.mult > 0 && c.pos >= p.fromFt && c.pos <= p.toFt;
+    }) ? s.catalog.protection[p.kind].dailyUsd : 0), 0);
+  const hiredDaily = s.deliveries.filter(d => d.hired && d.arrived && !d.released)
+    .reduce((sum, d) => sum + s.catalog.machines[d.machine].dailyUsd, 0);
+  const optionDaily = s.payments.reduce((sum, p) => sum + p.perDayUsd, 0);
+  s.crewCostUsd += crewDaily * dt * overhead;
+  s.spentUsd += (crewDaily + protectionDaily + hiredDaily) * dt * overhead + optionDaily * dt;
+}
+
+export function buyMachine(s, machine) {
+  s.spentUsd += s.catalog.machines[machine].priceUsd + s.scenario.rules.mobilizationUsd;
+}
+
+export function releaseMachine(s, machine) {
+  s.spentUsd -= s.catalog.machines[machine].priceUsd * s.catalog.orders.releaseRefundFraction;
+}
diff --git a/Monitor/src/sim/orders.js b/Monitor/src/sim/orders.js
new file mode 100644
index 0000000000000000000000000000000000000000..7057820b14ac948b0d1aaacebe46dc3485ed42f3
--- /dev/null
+++ b/Monitor/src/sim/orders.js
@@ -0,0 +1,198 @@
+import { CREW_IDS, EPS, activeCollapse, displayDay, nearby, nextBoundary, travelDays, voice } from './common.js';
+import { markFirstRadio, firstLend } from './deviations.js';
+import { availableResponses, clearingDays } from './events.js';
+import { buyMachine, releaseMachine } from './money.js';
+import { validateInspection, validatePermit, updateHoldPoints } from './permits.js';
+
+const OFFICE_OPS = new Set(['setStart', 'enterPermit', 'enterInspection', 'pay']);
+const CREW_OPS = new Set(['setStart', 'hold', 'resume', 'demob', 'remob']);
+const PLAN_OPS = new Set([...CREW_OPS, ...OFFICE_OPS, 'lend', 'order', 'protect', 'radio']);
+const positive = n => Number.isFinite(n) && n > 0;
+const owns = (object, key) => typeof key === 'string' && Object.hasOwn(object, key) && !key.startsWith('_');
+const ownerOf = (s, machine) => CREW_IDS.find(id => s.crews[id].machine === machine);
+export const landingTime = (s, crew) => s.pure || crew && nearby(s, s.crews[crew].pos) ? s.t : nextBoundary(s.t);
+
+export function validateOp(s, op) {
+  if (!op || !PLAN_OPS.has(op.op)) return 'unknown operation';
+  if (CREW_OPS.has(op.op) && !CREW_IDS.includes(op.crew)) return 'unknown crew';
+  const c = s.crews[op.crew];
+  if (op.op === 'setStart') {
+    if (s.scenario.plan.locked || c.locked) return 'plan locked';
+    if (s.t >= c.startDay - 1 - EPS) return 'crew already started';
+    if (!Number.isInteger(op.day) || op.day < displayDay(s.t)) return 'invalid start day';
+  }
+  if (op.op === 'hold' && (op.days != null && !positive(op.days)
+    || op.fromDay != null && (!Number.isInteger(op.fromDay) || op.fromDay < displayDay(s.t)))) return 'invalid hold';
+  if (op.op === 'lend') {
+    const owner = ownerOf(s, op.machine);
+    if (!owner || s.crews[owner].lentAway || s.loans.some(l => l.fromCrew === owner && l.phase !== 'returned')) return 'machine unavailable';
+    if (!CREW_IDS.includes(op.toCrew) || op.toCrew === owner || !positive(op.days)) return 'invalid lend';
+  }
+  if (op.op === 'protect' || op.op === 'order') {
+    if (!s.scenario.plan.preparationAllowed) return 'not in the budget';
+    if (op.op === 'order') {
+      if (!owns(s.catalog.machines, op.machine)) return 'unknown machine';
+      if (op.rush) return 'rush unavailable';
+    } else {
+      if (!owns(s.catalog.protection, op.kind)) return 'unknown protection';
+      if (s.catalog.protection[op.kind].reactOnly) return 'no such response now';
+      if (op.kind === 'trench_slope' && (s.catalog.cities[s.scenario.city].slopeRefused
+        || s.catalog.protection[op.kind].refusedInCities?.includes(s.scenario.city))) return 'slope refused';
+      if (!Number.isFinite(op.fromFt) || !Number.isFinite(op.toFt) || op.fromFt < 0
+        || op.toFt > s.scenario.job.lengthFt || op.fromFt >= op.toFt) return 'invalid stretch';
+    }
+  }
+  if (op.op === 'pay') {
+    const response = availableResponses(s).find(r => r.option.key === op.item);
+    if (!response) return 'no such response now';
+    if (op.item === 'hire_excavator' && (!owns(s.catalog.machines, op.machine)
+      || s.catalog.machines[op.machine].crew !== 'exc')) return 'unknown machine';
+    if (op.item === 'clear_own' && s.crews.exc.lentAway) return 'machine unavailable';
+  }
+  if (op.op === 'enterPermit') return validatePermit(s, op);
+  if (op.op === 'enterInspection') return validateInspection(s, op);
+  if (op.op === 'radio' && !s.orders.some(order => order.id === op.orderId)) return 'order not on file';
+}
+
+function startLoan(s, op) {
+  const fromCrew = ownerOf(s, op.machine);
+  const event = fromCrew === 'exc' && op.toCrew === 'pipe' ? activeCollapse(s) : null;
+  const loan = { machine: op.machine, fromCrew, toCrew: op.toCrew, phase: 'outbound',
+    arrivesT: s.t + travelDays(s.crews[fromCrew].pos, s.crews[op.toCrew].pos), days: op.days,
+    eventId: event?.id ?? null };
+  s.crews[fromCrew].lentAway = true;
+  s.loans.push(loan);
+  if (event) event.option = 'clear_own';
+  firstLend(s);
+}
+
+function purchase(s, machine, event) {
+  buyMachine(s, machine);
+  s.deliveries.push({ machine, crew: s.catalog.machines[machine].crew, issuedT: s.t,
+    arrivesT: s.t + s.catalog.machines[machine].leadDays.normal + s.catalog.cities[s.scenario.city].leadDelayDays,
+    hired: !!event, eventId: event?.id ?? null, arrived: false, released: false });
+}
+
+function pay(s, op) {
+  const { event, option } = availableResponses(s).find(r => r.option.key === op.item);
+  event.option = op.item;
+  if (op.item === 'hire_excavator') {
+    purchase(s, op.machine, event);
+    return;
+  }
+  s.spentUsd += option.cost.usd;
+  s.payments.push({ item: op.item, paidT: s.t, perDayUsd: option.cost.perDayUsd });
+  if (option.effect.lend) {
+    const fromCrew = option.effect.lend.machineOf;
+    issueOrder(s, { op: 'lend', machine: s.crews[fromCrew].machine,
+      toCrew: option.effect.lend.toCrew, days: clearingDays(s, event, s.crews[fromCrew].machine) });
+  }
+  if (option.effect.resumeAfterDays != null) event.endsT = s.t + option.effect.resumeAfterDays;
+  if (option.effect.rainRateRestore) {
+    event.pumpPaidT = s.t;
+    event.restore = option.effect.rainRateRestore;
+    event.reworkMultiplier = option.effect.reworkMultiplier;
+  }
+}
+
+function applyLanded(s, order) {
+  const op = order.op, c = s.crews[order.crew];
+  if (op.op === 'hold') {
+    const fromT = Math.max(s.t, op.fromDay != null ? op.fromDay - 1 : s.t);
+    c.hold = { fromT, untilT: op.days != null ? fromT + op.days : null };
+    c.arguing = false;
+    c.stop = null;
+  } else if (op.op === 'resume') {
+    c.hold = c.stop = null;
+  } else if (op.op === 'lend') startLoan(s, op);
+  else if (op.op === 'protect') s.protections.push({ kind: op.kind, fromFt: op.fromFt, toFt: op.toFt, placedT: s.t });
+  else if (op.op === 'demob') {
+    c.demobilized = true;
+    c.demobBillingEndsT = nextBoundary(s.t);
+    c.arguing = false;
+  } else if (op.op === 'remob') {
+    s.spentUsd += s.scenario.rules.demobFeeUsd;
+    c.remobT = s.t + s.catalog.cities[s.scenario.city].remobilizationDelayDays;
+  }
+  order.appliedT = s.t;
+}
+
+export function issueOrder(s, op) {
+  if (op.op === 'radio') {
+    const order = s.orders.find(order => order.id === op.orderId);
+    order.issuedT = s.t;
+    order.landsT = landingTime(s, order.crew);
+    order.status = 'sent';
+    order.ignored = false;
+    order.reissued = true;
+    // Acknowledging an already-applied order must not buy or lend twice.
+    order.alreadyApplied = order.appliedT != null;
+    return;
+  }
+  const crew = op.crew ?? (op.op === 'lend' ? ownerOf(s, op.machine)
+    : op.op === 'order' ? s.catalog.machines[op.machine].crew : op.op === 'protect' ? 'exc' : null);
+  const order = { id: `o-${s.nextOrderId++}`, op: { ...op }, crew, issuedT: s.t,
+    landsT: OFFICE_OPS.has(op.op) ? s.t : landingTime(s, crew), status: 'sent' };
+  s.orders.push(order);
+  if (!s.pure) markFirstRadio(s, order);
+  if (op.op === 'protect') s.spentUsd += s.catalog.protection[op.kind].priceUsd;
+  if (op.op === 'order') purchase(s, op.machine);
+  if (op.op === 'hold') voice(s, 'holdCommitted', ['plan']);
+  if (op.op === 'demob') voice(s, 'demobCommitted', ['plan']);
+  if (!OFFICE_OPS.has(op.op)) return;
+  if (op.op === 'setStart') {
+    s.crews[op.crew].startDay = op.day;
+    s.plannedLines[op.crew].startDay = op.day;
+  } else if (op.op === 'enterPermit') s.permits[op.zone].entered = true;
+  else if (op.op === 'enterInspection') {
+    s.inspections[op.zone].cleared = true;
+    updateHoldPoints(s);
+  } else if (op.op === 'pay') pay(s, op);
+  order.appliedT = order.landedT = s.t;
+  order.status = 'landed';
+}
+
+export function updateOrders(s) {
+  for (const order of s.orders) {
+    if (order.status !== 'sent' || s.t < order.landsT - EPS) continue;
+    order.status = 'landed';
+    order.landedT = s.t;
+    voice(s, 'orderLanded', ['plan']);
+    if (!order.ignored && !order.alreadyApplied) applyLanded(s, order);
+  }
+  for (const loan of s.loans) {
+    if (loan.phase === 'outbound' && s.t >= loan.arrivesT - EPS) {
+      loan.phase = 'working';
+      const event = s.events.find(e => e.id === loan.eventId);
+      loan.returnsT = s.t + (event ? clearingDays(s, event, loan.machine) : loan.days);
+      if (event) { event.clearingT = s.t; event.endsT = loan.returnsT; }
+    }
+    if (loan.phase === 'working' && s.t >= loan.returnsT - EPS) {
+      loan.phase = 'returning';
+      loan.homeT = s.t + travelDays(s.crews[loan.toCrew].pos, s.crews[loan.fromCrew].pos);
+    }
+    if (loan.phase === 'returning' && s.t >= loan.homeT - EPS) {
+      loan.phase = 'returned';
+      s.crews[loan.fromCrew].lentAway = false;
+    }
+  }
+  for (const delivery of s.deliveries) {
+    if (!delivery.arrived && s.t >= delivery.arrivesT - EPS) {
+      delivery.arrived = true;
+      if (delivery.hired) {
+        const event = s.events.find(e => e.id === delivery.eventId);
+        event.clearingT = s.t;
+        event.endsT = s.t + clearingDays(s, event, delivery.machine);
+        delivery.releaseT = event.endsT;
+      } else {
+        const crew = s.crews[delivery.crew];
+        releaseMachine(s, crew.machine);
+        crew.machine = delivery.machine;
+      }
+    }
+    if (delivery.hired && delivery.arrived && !delivery.released && s.t >= delivery.releaseT - EPS) {
+      delivery.released = true;
+      releaseMachine(s, delivery.machine);
+    }
+  }
+}
