import { createHost } from '../src/host/core.js';
import { loadCatalogFromObject } from '../src/common/catalog.js';
import { loadScenarioFromObject } from '../src/scenario/load.js';
import { drawQR } from './qr.js';

export async function connectLevel1() {
  const $ = id => document.getElementById(id);
  async function json(path) {
    const response = await fetch(path);
    if (!response.ok) throw new Error(`${path}: ${response.status}`);
    return response.json();
  }
  const catalog = loadCatalogFromObject(await json('Data/catalog.json'));
  const scenario = loadScenarioFromObject(await json('Data/Scenarios/level1_texas.json'), catalog);
  const core = createHost({ scenario, catalog });
  const runId = crypto.randomUUID();
  // Use the slice's six-character room names and its existing PeerJS transport.
  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const roomCode = [...crypto.getRandomValues(new Uint8Array(6))]
    .map(value => alphabet[value % alphabet.length]).join('');
  const roomURL = new URL('site.html', location.href);
  roomURL.searchParams.set('room', roomCode);
  $('room-code').textContent = roomCode;
  $('room-link').href = roomURL.href;
  drawQR($('room-qr'), roomURL.href);
  const transport = LobTransport.host(core, { runId, roomCode,
    onRoom() { $('room-status').textContent = 'Room ready'; $('room-status').dataset.ready = 'true'; },
    onStatus(text) { $('room-status').textContent = text; $('room-status').dataset.ready = 'false'; },
  });
  const socket = LobTransport.direct(core);
  let relay, closed = false;
  const relayStatus = text => { $('relay-status').textContent = text; };
  // Relay discovery never delays the local simulation or the independent QR path.
  fetch('Data/relay.json', { signal: AbortSignal.timeout(5000) })
    .then(response => { if (!response.ok) throw new Error('Relay config unavailable'); return response.json(); })
    .then(config => {
      if (!closed) relay = LobTransport.relayHost(core, { url: config.relay, roomCode, onStatus: relayStatus });
    }).catch(() => { if (!closed) relayStatus('Relay: unavailable'); });
  addEventListener('pagehide', () => {
    closed = true; socket.close(); transport.close(); relay?.close(); core.close();
  }, { once: true });
  return socket;
}
const SEATS = new Set(['plan', 'site', 'rules', 'facilitator']);
export function createClients({ state, welcome, command, changed = () => {}, allowControl = () => false }) {
  const clients = new Map(), connections = new Set();
  const send = (socket, message) => {
    socket.send(message);
  };
  const broadcast = () => {
    const views = new Map();
    for (const [socket, client] of clients) {
      if (!views.has(client.seat)) views.set(client.seat, state(client.seat));
      send(socket, views.get(client.seat));
    }
  };
  function attach(socket) {
    connections.add(socket);
    socket.onClose(() => { clients.delete(socket); connections.delete(socket); changed(); });
    socket.onMessage(message => {
      if (!message || message.v !== 1) return;
      if (message.t === 'hello') {
        if (!SEATS.has(message.seat) || clients.has(socket)) return;
        const mirror = [...clients.values()].some(c => c.seat === message.seat && !c.mirror);
        clients.set(socket, { seat: message.seat, client: message.client, mirror });
        send(socket, { t: 'welcome', v: 1, protocol: 1, seat: message.seat, mirror,
          stage: state(message.seat).stage, state: state(message.seat) });
        welcome(socket, message.seat, send);
        changed();
        return;
      }
      if (message.t !== 'cmd' && message.t !== 'ctrl') {
        console.warn('Unknown message type:', message.t);
        return;
      }
      const client = clients.get(socket);
      let reason;
      if (!client) reason = 'hello required';
      else if (client.mirror) reason = 'mirror';
      else if (message.t === 'ctrl' && client.seat !== 'facilitator' && !allowControl(client.seat, message.action)
        || message.t === 'cmd' && (message.seat !== client.seat || client.seat === 'facilitator')) {
        reason = 'action unavailable for seat';
      }
      if (reason) { send(socket, { t: 'nack', v: 1, id: message.id, reason }); return; }
      command(socket, client.seat, message, send);
    });
  }
  return {
    attach, broadcast,
    siteClient: () => [...clients.values()].find(c => c.seat === 'site' && !c.mirror)?.client ?? null,
    connected: () => [...new Set([...clients.values()].filter(c => !c.mirror).map(c => c.seat))],
    sendEach(makeMessage) {
      for (const [socket, client] of clients) {
        const message = makeMessage(client.seat);
        if (message) send(socket, message);
      }
    },
    deliver(message, requester) {
      for (const [socket, client] of clients) {
        if (message.t === 'inspection') {
          if (socket === requester) send(socket, message);
        } else {
          const seats = message.t === 'report' ? ['plan', 'facilitator']
            : message.t === 'result' ? message.seats ?? ['plan', 'site', 'facilitator'] : message.seats ?? [];
          if (seats.includes(client.seat)) send(socket, message);
        }
      }
    },
    close() { for (const socket of connections) socket.close(); connections.clear(); clients.clear(); },
  };
}
