function Compile-Assembly([string]$name, [string]$folder, [string[]]$references, [string]$defines = 'UNITY_EDITOR;UNITY_6000_3_OR_NEWER;UNITY_INCLUDE_TESTS') {
    # Match Unity's declared assembly graph; a broad compiler reference set can hide missing asmdef references.
    $definition = Get-ChildItem -LiteralPath $folder -Filter '*.asmdef' | Select-Object -First 1
    if ($definition) {
        $asm = Get-Content -LiteralPath $definition.FullName -Raw | ConvertFrom-Json
        $references = @($baseReferences)
        if (!$asm.noEngineReferences) { $references += $engineReferences }
        foreach ($dependency in $asm.references) {
            $compiled = Join-Path $scratch ($dependency + '.dll')
            $androidDependency = Join-Path $scratch ($dependency + '.Android.dll')
            if ($defines -match 'UNITY_ANDROID' -and $defines -notmatch 'UNITY_EDITOR' -and (Test-Path -LiteralPath $androidDependency)) { $compiled = $androidDependency }
            $references += $(if (Test-Path -LiteralPath $compiled) { $compiled } else { 'Library/ScriptAssemblies/' + $dependency + '.dll' })
        }
        if ($asm.optionalUnityReferences -contains 'TestAssemblies') {
            $references += 'Library/ScriptAssemblies/UnityEngine.TestRunner.dll', 'Library/ScriptAssemblies/UnityEditor.TestRunner.dll'
        }
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.XR;
using Meta.XR.BuildingBlocks;
using Oculus.Interaction;
using Oculus.Interaction.Input;
using Oculus.Interaction.Locomotion;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;

namespace LOBOver.Editor
{
    public static class BuildingBlocksSetup
    {
        // SDK core and interaction.ovr Editor/BlockDataIds.cs; names alone never establish block presence.
        private const string InteractionId = "81f55626-5fad-45e9-a1df-184f330da7ba";
        public static readonly string[] DemoNames = { "[BuildingBlock] Cube", "Poke Interaction" };

        [MenuItem("LOB Over/Setup/Check Building Blocks")]
        public static void CheckMenu() => CheckPlay();

        public static bool CheckPlay()
        {
            if (!File.Exists(PlaySceneBuilder.ScenePath))
            { Debug.LogError("LOB Over: Assets/Scenes/Play.unity is missing; Bryan must save his Building Blocks scene there."); return false; }
            var scene = SceneManager.GetSceneByPath(PlaySceneBuilder.ScenePath);
            var preview = !scene.IsValid() || !scene.isLoaded;
            if (preview) scene = EditorSceneManager.OpenPreviewScene(PlaySceneBuilder.ScenePath);
            try { return Check(scene); }
            finally { if (preview) EditorSceneManager.ClosePreviewScene(scene); }
        }

        public static List<string> Missing(Scene scene)
        {
            var missing = new List<string>();
            var rig = XRRig.Components<OVRCameraRig>(scene).FirstOrDefault();
            var blocks = XRRig.Components<BuildingBlock>(scene);
            void Need(bool present, string name) { if (!present) missing.Add(name); }
            Need(rig != null && rig.centerEyeAnchor != null && rig.GetComponent<OVRManager>() != null, "Camera Rig");
            Need(XRRig.Components<OVRPassthroughLayer>(scene).Length > 0, "Passthrough");
            foreach (var side in new[] { Handedness.Left, Handedness.Right })
            {
                var controller = XRRig.Components<FromOVRControllerDataSource>(scene).Any(c => HasSide(c, side))
                    || XRRig.Components<OVRControllerHelper>(scene).Any(c => c.m_controller == (side == Handedness.Left ? OVRInput.Controller.LTouch : OVRInput.Controller.RTouch));
                Need(controller && rig != null && (side == Handedness.Left ? rig.leftControllerAnchor : rig.rightControllerAnchor) != null,
                    "Controller Tracking (" + side.ToString().ToLowerInvariant() + ")");
            }
            Need((blocks.Any(block => block.BlockId == InteractionId) || XRRig.Components<RayInteractor>(scene).Length > 0)
                && XRRig.Components<RayInteractor>(scene).Length > 0 && XRRig.Components<PokeInteractor>(scene).Length > 0, "Interactions Rig");
            foreach (var side in new[] { Handedness.Left, Handedness.Right })
            {
                var hand = XRRig.Components<FromOVRHandDataSource>(scene).Any(c => HasSide(c, side))
                    || XRRig.Components<OVRHand>(scene).Any(c => c.GetHand() == (side == Handedness.Left ? OVRPlugin.Hand.HandLeft : OVRPlugin.Hand.HandRight));
                Need(hand && rig != null && (side == Handedness.Left ? rig.leftHandAnchor : rig.rightHandAnchor) != null,
                    "Hand Tracking (" + side.ToString().ToLowerInvariant() + ")");
            }
            return missing;
        }
        private static bool HasSide(Component source, Handedness side)
        {
            using var serialized = new SerializedObject(source);
            return serialized.FindProperty("_handedness")?.intValue == (int)side;
        }
        public static bool Check(Scene scene, bool level1 = true)
        {
            var missing = Missing(scene);
            foreach (var name in new[] { "Camera Rig", "Passthrough", "Controller Tracking (left)", "Controller Tracking (right)",
                "Interactions Rig", "Hand Tracking (left)", "Hand Tracking (right)" })
            {
                if (missing.Contains(name)) Debug.LogError("LOB Over: MISSING " + name + "; add it from Building Blocks.");
                else Debug.Log("LOB Over: PRESENT " + name);
            }
            foreach (var layer in XRRig.Components<OVRPassthroughLayer>(scene))
                Debug.Log("LOB Over: Passthrough layer " + PathOf(layer.transform) + (layer.GetComponent<OVRCameraRig>() != null ? " (additional rig layer; preserved)" : ""));
            var forbidden = level1 ? Forbidden(scene) : new List<string>();
            foreach (var name in forbidden) Debug.LogError("LOB Over: remove " + name + " in the Building Blocks window before building Play.unity.");
            return missing.Count == 0 && forbidden.Count == 0;
        }
        public static List<string> Forbidden(Scene scene)
        {
            var result = new List<string>();
            if (XRRig.Components<BuildingBlock>(scene).Any(b => b.BlockId == XRRig.RealHandsId)
                || XRRig.Components<Transform>(scene).Any(t => t.name.IndexOf("Real Hands", StringComparison.OrdinalIgnoreCase) >= 0)) result.Add("Real Hands");
            if (XRRig.Components<Component>(scene).Any(c => c != null && c.GetType().Name == "EnableUnpremultipliedAlpha")) result.Add("EnableUnpremultipliedAlpha (Real Hands)");
            var layers = XRRig.Components<OVRPassthroughLayer>(scene);
            if (layers.Length > 1) result.Add("extra Passthrough layers: " + string.Join(", ", layers.Select(l => PathOf(l.transform))));
            result.AddRange(Demos(scene).Select(d => "demo " + PathOf(d.transform)));
            return result;
        }
        public static IEnumerable<GameObject> Demos(Scene scene) => XRRig.Components<Transform>(scene)
            .Where(t => DemoNames.Contains(t.name) || t.name.StartsWith("[BuildingBlock]", StringComparison.Ordinal)
                && t.name.IndexOf("demo", StringComparison.OrdinalIgnoreCase) >= 0).Select(t => t.gameObject);

        [MenuItem("LOB Over/Setup/Configure Building Blocks")]
        public static void ConfigureMenu()
        {
            if (!File.Exists(PlaySceneBuilder.ScenePath)) { CheckPlay(); return; }
            var scene = PlaySceneBuilder.OpenExisting();
            if (!Check(scene)) return;
            Configure(scene);
            EditorSceneManager.SaveScene(scene);
        }
        public static void Configure(Scene scene)
        {
            foreach (var component in XRRig.Components<Behaviour>(scene))
            {
                // Include the SDK's event broadcasters/connections: enabled listeners could still move a disabled locomotor.
                if (component != null && component.GetType().Namespace == "Oculus.Interaction.Locomotion" && BelongsToBlocks(component)) // missing-script components come back null
                {
                    if (component is FirstPersonLocomotor locomotor && locomotor.GravityFactor != 0)
                        Change(locomotor, "GravityFactor", locomotor.GravityFactor, 0f, () => locomotor.GravityFactor = 0);
                    if (component.enabled) Change(component, "enabled", true, false, () => component.enabled = false);
                }
            }
            foreach (var manager in XRRig.Components<OVRManager>(scene).Where(BelongsToBlocks))
            {
                if (manager.trackingOriginType != OVRManager.TrackingOrigin.FloorLevel)
                    Change(manager, "trackingOriginType", manager.trackingOriginType, OVRManager.TrackingOrigin.FloorLevel,
                        () => manager.trackingOriginType = OVRManager.TrackingOrigin.FloorLevel);
                if (!manager.isInsightPassthroughEnabled)
                    Change(manager, "isInsightPassthroughEnabled", false, true, () => manager.isInsightPassthroughEnabled = true);
            }
            foreach (var layer in XRRig.Components<OVRPassthroughLayer>(scene).Where(l => BelongsToBlocks(l) && l.GetComponent<OVRCameraRig>() == null)) // the Passthrough block's layer; the rig's own is an old-builder leftover
            {
                if (!layer.enabled) Change(layer, "enabled", false, true, () => layer.enabled = true);
                if (layer.hidden) Change(layer, "hidden", true, false, () => layer.hidden = false);
                // Installed SDK 207 SyncToOverlay always sets Underlay/int.MaxValue; it exposes no overlay-type field.
                Debug.Log("LOB Over: " + PathOf(layer.transform) + " uses SDK-enforced Underlay (SyncToOverlay); preserved.");
            }
            foreach (var rig in XRRig.Components<OVRCameraRig>(scene))
            {
                var camera = rig.centerEyeAnchor == null ? null : rig.centerEyeAnchor.GetComponent<Camera>();
                if (camera == null) continue;
                if (camera.clearFlags != CameraClearFlags.SolidColor)
                    Change(camera, "clearFlags", camera.clearFlags, CameraClearFlags.SolidColor, () => camera.clearFlags = CameraClearFlags.SolidColor);
                if (camera.backgroundColor != Color.clear)
                    Change(camera, "backgroundColor", camera.backgroundColor, Color.clear, () => camera.backgroundColor = Color.clear);
                if (camera.allowHDR) Change(camera, "allowHDR", true, false, () => camera.allowHDR = false);
            }
        }
        private static bool BelongsToBlocks(Component component) => component.GetComponentInParent<BuildingBlock>(true) != null
            || component.GetComponentInParent<OVRCameraRig>(true) != null;
        private static void Change(UnityEngine.Object target, string property, object before, object after, Action apply)
        {
            Undo.RecordObject(target, "Configure Building Blocks"); apply(); EditorUtility.SetDirty(target);
            var component = target as Component;
            var owner = component == null ? (GameObject)target : component.gameObject;
            PrefabUtility.RecordPrefabInstancePropertyModifications(target);
            EditorSceneManager.MarkSceneDirty(owner.scene);
            Debug.Log("LOB Over: " + PathOf(owner.transform) + "/" + target.GetType().Name + "." + property + ": " + before + " -> " + after);
        }
        private static string PathOf(Transform target) => target.parent == null ? target.name : PathOf(target.parent) + "/" + target.name;
    }
}

using System;
using System.IO;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.World;
using LOBOver.XR;
using Meta.XR.BuildingBlocks;
using Newtonsoft.Json.Linq;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.SceneManagement;
using Object = UnityEngine.Object;

namespace LOBOver.Editor
{
    public static class SiteSceneBuilder
    {
        public const string ScenePath = "Assets/LOBOver/Scenes/Site.unity";
        private const float HubFloorSize = 20; // WO-S6 item 6, metres.
        [MenuItem("LOB Over/Build/Site Scene")]
        public static void BuildMenu()
        {
            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return;
            Build();
        }
        public static Scene OpenExisting()
        {
            var scene = SceneManager.GetSceneByPath(ScenePath);
            if (!scene.IsValid() || !scene.isLoaded) scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
            SceneManager.SetActiveScene(scene); return scene;
        }
        private static readonly string[] LegacyRoots = { "ControllerPointer", "Director", "MRDiorama", "StartPanel",
            "FullScaleRoot", "VRSite", "Sun", "Global Volume", "DesktopPreview" };
        private static readonly string[] OwnedRoots = { "[LOBOver] Lighting", "[LOBOver] Director", "[LOBOver] Hub",
            "[LOBOver] Site", "[LOBOver] Start", "[LOBOver] Preview" };
        public static Scene Build(bool saveScene = true)
        {
            if (!File.Exists(ScenePath))
            {
                var empty = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Additive);
                Directory.CreateDirectory("Assets/LOBOver/Scenes");
                EditorSceneManager.SaveScene(empty, ScenePath);
                Debug.LogError("LOB Over: add the blocks listed by Check Building Blocks, then run Site Scene again.");
                BuildingBlocksSetup.Check(empty); return empty;
            }
            var scene = OpenExisting();
            if (!BuildingBlocksSetup.Check(scene, false)) throw new InvalidOperationException("Site Scene stopped: add the missing Building Blocks.");
            var replaced = scene.GetRootGameObjects().Where(root => OwnedRoots.Contains(root.name)
                || LegacyRoots.Contains(root.name)).ToArray();
            // Validate the entire deletion set before changing anything, including accidentally nested blocks.
            foreach (var root in replaced)
                if (root.GetComponentInChildren<BuildingBlock>(true) != null || root.GetComponentInChildren<OVRCameraRig>(true) != null
                    || root.GetComponentsInChildren<Transform>(true).Any(t => t.name.StartsWith("[BuildingBlock]", StringComparison.Ordinal) || t.name == "OVRCameraRig"))
                    throw new InvalidOperationException("Site Scene stopped: protected block/rig under " + root.name + ". Nothing removed.");
            foreach (var root in replaced) Object.DestroyImmediate(root);
            DataSync.Sync();
            var lighting = new GameObject("[LOBOver] Lighting").transform;
            var site = new GameObject("[LOBOver] Site").transform;
            var full = WorldDrawing.Group("FullScaleWorld", site).transform;
            var hub = new GameObject("[LOBOver] Hub").transform;
            // WO-S6: invisible 20 m square floor, top exactly at tracked floor y=0.
            var floor = WorldDrawing.Group("TrackedFloor", hub).AddComponent<BoxCollider>();
            floor.size = new Vector3(HubFloorSize, 0.1f, HubFloorSize); floor.center = new Vector3(0, -0.05f, 0);
            WorldDrawing.Group("ModelAnchor", hub); WorldDrawing.Group("PMStandeePlaceholder", hub);
            var assets = SiteAssetBuilder.Build();
            var light = WorldDrawing.Group("Sun", lighting).AddComponent<Light>(); light.type = LightType.Directional;
            light.color = new Color(1, 0.94f, 0.82f); light.intensity = 1.2f; light.shadows = LightShadows.Soft;
            light.transform.rotation = Quaternion.Euler(48, -35, 0); RenderSettings.sun = light;
            RenderSettings.ambientMode = AmbientMode.Trilight; RenderSettings.ambientSkyColor = new Color(0.65f, 0.75f, 0.85f);
            RenderSettings.ambientEquatorColor = new Color(0.48f, 0.5f, 0.52f); RenderSettings.ambientGroundColor = new Color(0.25f, 0.23f, 0.2f);
            RenderSettings.skybox = AssetDatabase.GetBuiltinExtraResource<Material>("Default-Skybox.mat");
            var volume = WorldDrawing.Group("Global Volume", lighting).AddComponent<Volume>(); volume.isGlobal = true;
            volume.sharedProfile = SiteAssetBuilder.Required<VolumeProfile>("Assets/Settings/DefaultVolumeProfile.asset");
            BuildGround(assets, full);
            var gate = WorldDrawing.Group("Gate", full); gate.transform.position = new Vector3(-20, 0, WorldUnits.RoadZ);
            for (var i = 0; i < 2; i++)
            {
                var barrier = (GameObject)PrefabUtility.InstantiatePrefab(assets.barrier); barrier.name = "GateBarrier_" + (i + 1);
                barrier.transform.SetParent(gate.transform, false); barrier.transform.localPosition = new Vector3(0, 0, i == 0 ? -3.5f : 3.5f);
            }
            var cone = (GameObject)PrefabUtility.InstantiatePrefab(assets.cone); cone.name = "GateCone";
            cone.transform.SetParent(gate.transform, false); cone.transform.localPosition = new Vector3(0, 0, 2.5f);
            var ticket = WorldDrawing.Box("GateTicket", gate.transform, new Vector3(0, 1.5f, 3), new Vector3(0.7f, 0.5f, 0.04f), assets.steel);
            InspectTarget.Attach(ticket, "ticket");
            var gateText = WorldDrawing.Text("GateText", gate.transform, new Vector3(0, 1.5f, 2.96f), new Vector2(0.65f, 0.45f), 0.08f, assets.font);
            var trailer = WorldDrawing.Box("Trailer", full, new Vector3(-15, 1.5f, 14), new Vector3(6, 3, 3), SiteAssetBuilder.Material("Repair_SiteCabin"));
            var siteBoard = Board("TrailerBoard", new Vector3(-15, 1.9f, 12.44f), new Vector2(2, 1), assets).AddComponent<TrailerBoard>();
            var planBoard = Board("PlanPanel", new Vector3(-15, 1.9f, 15.56f), new Vector2(3, 1.5f), assets).AddComponent<PlanPanel>();
            planBoard.transform.rotation = Quaternion.Euler(0, 180, 0);
            // Boards remain at unit scale; parenting preserves their world dimensions.
            siteBoard.transform.SetParent(trailer.transform, true); planBoard.transform.SetParent(trailer.transform, true);
            var sign = WorldDrawing.Group("JobSign", full); sign.transform.position = new Vector3(-20, 0, 10);
            for (var side = -1; side <= 1; side += 2) WorldDrawing.Box("TimberPost", sign.transform, new Vector3(side * 0.45f, 0.9f, 0), new Vector3(0.08f, 1.8f, 0.08f), assets.timber);
            WorldDrawing.Box("SignBoard", sign.transform, new Vector3(0, 1.6f, 0), new Vector3(1.2f, 0.8f, 0.05f), assets.steel);
            var jobSign = sign.AddComponent<JobSign>(); jobSign.label = WorldDrawing.Text("Job", sign.transform, new Vector3(0, 1.6f, -0.04f), new Vector2(1.1f, 0.7f), 0.1f, assets.font);
            var director = new GameObject("[LOBOver] Director").AddComponent<Director>();
            director.gameObject.AddComponent<XRRig>(); director.gameObject.AddComponent<XRRuntimeSettings>();
            var world = WorldDrawing.Group("SiteWorld", full).AddComponent<SiteWorld>(); world.director = director; world.assets = assets;
            world.trailerBoard = siteBoard; world.planPanel = planBoard; world.jobSign = jobSign; world.gateText = gateText;
            world.truck = new GameObject("SiteTruck").transform; world.truck.SetParent(world.transform, false); world.truck.localPosition = new Vector3(0, 0, WorldUnits.RoadZ);
            var truckFrame = WorldDrawing.Box("TruckFrame", world.truck, new Vector3(-1, 0.55f, 0), new Vector3(2.2f, 0.3f, 2), assets.steel);
            // Preview marker only; the XR cab and its comfort presentation belong to WO-S4.
            var previewPrefab = BuildPreviewPrefab();
            var preview = ((GameObject)PrefabUtility.InstantiatePrefab(previewPrefab)).GetComponent<DesktopPreview>(); preview.name = "[LOBOver] Preview"; preview.gameObject.tag = "EditorOnly";
            preview.director = director; preview.world = world;
            preview.previewCamera.transform.position = new Vector3(160, 9, 20); preview.previewCamera.transform.LookAt(new Vector3(140, -0.5f, 0));
            world.sky = BuildSky(assets, preview.previewCamera.transform); world.sky.transform.SetParent(full, true);
            // Metadata appears in Edit mode without putting a facilitator view in any player board.
            var source = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json")); jobSign.Apply((JObject)source["job"]["sign"]);
            // The XR extension has its own asmdef under the WO-S4-allowed Start folder.
            var extension = Type.GetType("LOBOver.Start.Editor.XRSceneSetup, LOBOver.XR.Editor", true);
            extension.GetMethod("Build").Invoke(null, new object[] { world, preview, assets });
            SiteAssetBuilder.ConvertPrefabMaterials();
            foreach (var root in scene.GetRootGameObjects().Where(root => OwnedRoots.Contains(root.name)))
                SiteAssetBuilder.ConvertRendererMaterials(root);
            Selection.activeGameObject = world.gameObject;
            if (saveScene)
            {
                Directory.CreateDirectory("Assets/LOBOver/Scenes");
                if (!EditorSceneManager.SaveScene(scene, ScenePath)) throw new IOException("Could not save " + ScenePath);
                EditorBuildSettings.scenes = new[] { new EditorBuildSettingsScene(ScenePath, true) }
                    .Concat(EditorBuildSettings.scenes.Where(s => s.path != ScenePath)).ToArray();
            }
            AssetDatabase.SaveAssets(); Debug.Log("LOB Over: Site Scene built. Press Play, choose a mode, then Start."); return scene;
        }
        private static void BuildGround(WorldAssets assets, Transform parent)
        {
            // WO-08: 1200 x 200 m terrain. Separate banks leave the 1.2 m trench visible down to its floor.
            var ground = WorldDrawing.Group("Ground", parent);
            const float length = 1200, width = 200, corridor = WorldUnits.TrenchWidth;
            for (var side = -1; side <= 1; side += 2)
                WorldDrawing.Box(side < 0 ? "FarBank" : "NearBank", ground.transform, new Vector3(500, -1, side * (width + corridor) / 4),
                    new Vector3(length, 2, (width - corridor) / 2), assets.soil);
            WorldDrawing.Box("Subsoil", ground.transform, new Vector3(500, -2.1f, 0), new Vector3(length, 0.2f, width), assets.soil);
            WorldDrawing.Box("BeforeTrench", ground.transform, new Vector3(-50, -1, 0), new Vector3(100, 2, corridor), assets.soil);
            // Initial slice length; stations beyond it are generated when a longer stage loads.
            WorldDrawing.Box("Road", parent, new Vector3(460, 0.015f, WorldUnits.RoadZ), new Vector3(980, 0.03f, 8), SiteAssetBuilder.Material("AccessRoad"));
            WorldDrawing.Group("TrenchCorridor", parent);
        }
        private static GameObject Board(string name, Vector3 position, Vector2 size, WorldAssets assets)
        {
            var root = new GameObject(name); root.transform.position = position;
            WorldDrawing.Box("Face", root.transform, Vector3.zero, new Vector3(size.x, size.y, 0.06f), assets.steel); return root;
        }
        private static GameObject BuildPreviewPrefab()
        {
            var root = new GameObject("DesktopPreview");
            try
            {
                var preview = root.AddComponent<DesktopPreview>();
                var cameraObject = new GameObject("DesktopFlyCamera"); cameraObject.transform.SetParent(root.transform, false);
                preview.previewCamera = cameraObject.AddComponent<Camera>(); preview.previewCamera.nearClipPlane = 0.05f; preview.previewCamera.farClipPlane = 6000;
                preview.previewCamera.fieldOfView = 65; cameraObject.tag = "MainCamera"; preview.previewCamera.depth = 10;
                return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Prefabs + "DesktopPreview.prefab");
            }
            finally { Object.DestroyImmediate(root); }
        }
        private static SiteSky BuildSky(WorldAssets assets, Transform observer)
        {
            var sky = new GameObject("SiteSky").AddComponent<SiteSky>(); sky.observer = observer;
            var rainObject = new GameObject("Rain"); rainObject.transform.SetParent(sky.transform, false);
            var rain = rainObject.AddComponent<ParticleSystem>(); rain.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
            var main = rain.main; main.loop = true; main.playOnAwake = false; main.startLifetime = 1.2f; main.startSpeed = 24; main.startSize = 0.035f;
            main.maxParticles = 1800; main.simulationSpace = ParticleSystemSimulationSpace.World;
            var emission = rain.emission; emission.rateOverTime = 1000;
            var shape = rain.shape; shape.shapeType = ParticleSystemShapeType.Box; shape.scale = new Vector3(24, 24, 1);
            rainObject.transform.rotation = Quaternion.Euler(90, 0, 0);
            var renderer = rain.GetComponent<ParticleSystemRenderer>(); renderer.sharedMaterial = assets.rain;
            renderer.renderMode = ParticleSystemRenderMode.Stretch; renderer.lengthScale = 5; renderer.velocityScale = 0.02f;
            sky.rain = rain; rainObject.SetActive(false);
            var clouds = new GameObject("TowersSouth"); clouds.transform.SetParent(sky.transform, false); clouds.transform.localPosition = new Vector3(450, 180, -2000);
            sky.cloudBank = clouds.transform;
            for (var i = 0; i < 9; i++)
            {
                var cloud = new GameObject("Cumulus_" + i); cloud.transform.SetParent(clouds.transform, false);
                cloud.transform.localPosition = new Vector3((i - 4) * 150, i % 3 * 45, 0);
                cloud.AddComponent<MeshFilter>().sharedMesh = CloudMesh(); cloud.AddComponent<MeshRenderer>().sharedMaterial = assets.cloud;
            }
            clouds.SetActive(false);
            var dome = GameObject.CreatePrimitive(PrimitiveType.Sphere); dome.name = "SkyInspectDome";
            dome.transform.SetParent(sky.transform, false); dome.transform.localScale = Vector3.one * 10000;
            var source = dome.GetComponent<MeshFilter>().sharedMesh; var path = SiteAssetBuilder.Art + "SkyDome.asset";
            var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
            if (mesh == null)
            {
                mesh = Object.Instantiate(source); mesh.name = "InwardSkyDome"; var triangles = mesh.triangles;
                for (var i = 0; i < triangles.Length; i += 3) { var a = triangles[i]; triangles[i] = triangles[i + 2]; triangles[i + 2] = a; }
                mesh.triangles = triangles; mesh.RecalculateNormals(); AssetDatabase.CreateAsset(mesh, path);
            }
            Object.DestroyImmediate(dome.GetComponent<Collider>()); Object.DestroyImmediate(dome.GetComponent<Renderer>()); Object.DestroyImmediate(dome.GetComponent<MeshFilter>());
            dome.AddComponent<MeshCollider>().sharedMesh = mesh; InspectTarget.Attach(dome, "sky"); return sky;
        }
        private static Mesh CloudMesh()
        {
            var path = SiteAssetBuilder.Art + "Cumulus.asset"; var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
            if (mesh != null) return mesh;
            const int edges = 48; var vertices = new Vector3[edges + 1]; var triangles = new int[edges * 3];
            for (var i = 0; i < edges; i++)
            {
                var angle = i * Mathf.PI * 2 / edges; var radius = 1 + 0.12f * Mathf.Cos(angle * 7);
                vertices[i + 1] = new Vector3(Mathf.Cos(angle) * radius * 170, Mathf.Sin(angle) * radius * 70, 0);
                triangles[i * 3] = 0; triangles[i * 3 + 1] = (i + 1) % edges + 1; triangles[i * 3 + 2] = i + 1;
            }
            mesh = new Mesh { name = "Cumulus", vertices = vertices, triangles = triangles }; mesh.RecalculateNormals(); mesh.RecalculateBounds();
            AssetDatabase.CreateAsset(mesh, path); return mesh;
        }
        [MenuItem("LOB Over/Debug/Screenshot")]
        public static void Screenshot()
        {
            var folder = Path.GetFullPath("Monitor/out/unity"); Directory.CreateDirectory(folder);
            var path = Path.Combine(folder, "site-" + DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".png");
            ScreenCapture.CaptureScreenshot(path); Debug.Log("Screenshot: " + path);
        }
    }
}


