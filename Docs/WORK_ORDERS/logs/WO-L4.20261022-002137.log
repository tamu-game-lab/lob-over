using System.Collections.Generic;
using System.Linq;
#if UNITY_EDITOR || !UNITY_ANDROID
using LOBOver.Runtime;
#endif
using LOBOver.Sim;
using Newtonsoft.Json.Linq;
using TMPro;
using UnityEngine;

namespace LOBOver.World
{
    public sealed class SiteWorld : MonoBehaviour
    {
#if UNITY_EDITOR || !UNITY_ANDROID
        public Director director;
        public PlanPanel planPanel;
#endif
        public WorldAssets assets;
        public TrailerBoard trailerBoard;
        public JobSign jobSign;
        public SiteSky sky;
        public TextMeshPro gateText;
        public Transform truck;
        public SiteView CurrentView { get; private set; }
        public int CellCount => cells.Count;
        public int BoardCount => boards.Count;
        public int CrewCount => crews.Count;
        public double LengthFt { get; private set; }
        private readonly Dictionary<int, StationCell> cells = new Dictionary<int, StationCell>();
        private readonly Dictionary<int, Transform> stakes = new Dictionary<int, Transform>();
        private readonly Dictionary<int, ZoneBoard> boards = new Dictionary<int, ZoneBoard>();
        private readonly Dictionary<string, CrewRig> crews = new Dictionary<string, CrewRig>();
        private JArray zones;
        private Transform generated;
        public StationCell CellAt(int feet) => cells.TryGetValue(Mathf.FloorToInt(feet / WorldUnits.StationFeet) * (int)WorldUnits.StationFeet, out var cell) ? cell : null;
        public CrewRig Crew(string id) => crews.TryGetValue(id, out var crew) ? crew : null;
        public Transform StakeAt(int feet) => stakes.TryGetValue(feet, out var stake) ? stake : null;
        public ZoneBoard Board(int zone) => boards.TryGetValue(zone, out var board) ? board : null;
        public int ZoneAt(double feet) => (int)zones.OfType<JObject>().First(z => feet >= (double)z["fromFt"] && (feet < (double)z["toFt"] || feet == LengthFt))["id"];

#if UNITY_EDITOR || !UNITY_ANDROID
        private void OnEnable()
        {
            if (director == null) return;
            director.Loaded += OnLoaded; director.ViewsChanged += OnViews; director.Result += OnResult;
            if (director.Ready) { OnLoaded(); if (director.SiteView != null) OnViews(director.SiteView, director.PlanView); }
        }
        private void OnDisable()
        {
            if (director == null) return;
            director.Loaded -= OnLoaded; director.ViewsChanged -= OnViews; director.Result -= OnResult;
        }
        private void OnLoaded() => Configure(director.Job, director.DeadlineDay);
        private void OnViews(SiteView site, PlanView plan)
        {
            Apply(site, director.DisplayDay); planPanel.Apply(plan, director.TimeDays);
        }
        private void OnResult(JObject value) => planPanel.ShowResult(value);
#endif
        public void Configure(JObject job, double deadline)
        {
            if (generated != null) WorldDrawing.Remove(generated.gameObject);
            generated = WorldDrawing.Group("GeneratedSite", transform).transform;
            cells.Clear(); stakes.Clear(); boards.Clear(); crews.Clear(); CurrentView = null;
            LengthFt = (double)job["lengthFt"]; zones = (JArray)job["zones"].DeepClone();
            if (jobSign != null && job["sign"] is JObject sign) jobSign.Apply(sign);
            var boundaries = zones.OfType<JObject>().ToDictionary(z => (int)z["id"], z => (double)z["fromFt"]);
            if (trailerBoard != null) trailerBoard.Configure(assets, LengthFt, deadline, boundaries);
#if UNITY_EDITOR || !UNITY_ANDROID
            if (planPanel != null) planPanel.Configure(assets, LengthFt, deadline);
#endif
            if (sky != null) { if (sky.State != null) sky.Apply("clear"); else sky.Configure(assets); }
        }
        public void Apply(SiteView view, int displayDay)
        {
            if (generated == null) throw new System.InvalidOperationException("Configure SiteWorld before applying a view");
            if (cells.Count == 0) Build(view);
            CurrentView = view;
            foreach (var cell in view.trench) if (cells.TryGetValue((int)cell.stationFt, out var target)) target.Apply(cell);
            foreach (var crew in view.crews) crews[crew.id].Apply(crew);
            var arguing = WorldUnits.CrewIds.Select(id => crews[id]).Where(crew => crew.Status == "arguing").ToArray();
            foreach (var crew in crews.Values) crew.FaceArgument(arguing.FirstOrDefault(other => other != crew && crew.Status == "arguing")?.transform);
            foreach (var board in view.boards) boards[(int)board.zone].Apply(board);
            if (sky != null) sky.Apply(view.sky);
            if (gateText != null) gateText.text = "Trucks waiting: " + view.gate.trucksWaiting;
            if (truck != null) truck.localPosition = new Vector3((float)view.truck.stationFt * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
            if (trailerBoard != null) trailerBoard.Apply(view, displayDay);
        }
        private void Build(SiteView view)
        {
            foreach (var sample in view.trench)
            {
                // The endpoint is a stake, not an extra 100 ft of trench.
                if (sample.stationFt >= LengthFt) continue;
                var cell = Instantiate(assets.cellPrefab, generated); cell.Initialize(sample.stationFt, assets);
                cells[(int)sample.stationFt] = cell; stakes[(int)sample.stationFt] = cell.stake;
                if (!assets.detailedSite)
                {
                    var spoil = Instantiate(assets.spoil, generated); spoil.name = "Spoil_" + (int)sample.stationFt;
                    spoil.transform.localPosition = new Vector3((float)sample.stationFt * WorldUnits.MetresPerFoot + WorldUnits.CellLength / 2, 0, -3);
                }
            }
            if (assets.detailedSite)
            {
                var endpointStake = SiteDetailDrawing.Stake(generated, assets, out var endpointText);
                endpointStake.localPosition += Vector3.right * (float)LengthFt * WorldUnits.MetresPerFoot;
                endpointText.text = WorldUnits.Station(LengthFt); stakes[(int)LengthFt] = endpointStake;
            }
            else
            {
            var endpoint = WorldDrawing.Box("Stake_" + (int)LengthFt, generated, new Vector3((float)LengthFt * WorldUnits.MetresPerFoot, 0.55f, 1.2f), new Vector3(0.08f, 1.1f, 0.08f), assets.timber);
            var label = WorldDrawing.Text("Station", endpoint.transform, new Vector3(0, 0.6f, 0), new Vector2(1.5f, 0.4f), 0.3f, assets.font);
            // Text cannot inherit the thin post's scale.
            label.transform.SetParent(generated, true); label.transform.localScale = Vector3.one;
            label.transform.localPosition = endpoint.transform.localPosition + Vector3.up * 0.6f; label.transform.localRotation = Quaternion.Euler(0, 180, 0);
            label.text = WorldUnits.Station(LengthFt); stakes[(int)LengthFt] = endpoint.transform;
            }
            foreach (var zone in zones.OfType<JObject>())
            {
                var root = WorldDrawing.Group("ZoneBoard", generated); root.transform.localPosition = new Vector3((float)zone["fromFt"] * WorldUnits.MetresPerFoot, 0, 1.8f);
                root.transform.localRotation = Quaternion.Euler(0, 180, 0);
                BoardBox("Post", root.transform, new Vector3(0, 1, 0), new Vector3(0.1f, 2, 0.1f), assets.timber);
                var face = BoardBox("Board", root.transform, new Vector3(0, 1.8f, 0), new Vector3(1, 1.5f, 0.06f), assets.steel);
                InspectTarget.Attach(face, "board"); var board = root.AddComponent<ZoneBoard>();
                board.label = WorldDrawing.Text("Permit", root.transform, new Vector3(0, 1.8f, -0.05f), new Vector2(0.9f, 1.3f), 0.12f, assets.font);
                if (assets.detailedSite) board.label.fontSharedMaterial = assets.siteText;
                board.Initialize((int)zone["id"]); boards[board.Zone] = board;
            }
            foreach (var id in WorldUnits.CrewIds)
            { var crew = Instantiate(assets.crewPrefab, generated); crew.Initialize(id, assets); crews[id] = crew; }
        }
        private GameObject BoardBox(string name, Transform parent, Vector3 position, Vector3 size, Material material)
            => assets.detailedSite ? SiteDetailDrawing.Block(name, parent, position, size, material)
                : WorldDrawing.Box(name, parent, position, size, material);
    }
}

using TMPro;
using UnityEngine;

namespace LOBOver.World
{
    public static class SiteDetailDrawing
    {
        // WO-L4 item 5: lath, lettering, pipe and water dimensions in metres.
        public const float StakeHeight = 1.2f, StakeWidth = 0.05f, LetterHeight = 0.04f, WaterHeight = 0.3f, BeddingDepth = 0.1f;
        public static GameObject Mesh(string name, Transform parent, Mesh mesh, Material material, Vector3 position = default)
        {
            var root = WorldDrawing.Group(name, parent); root.transform.localPosition = position;
            root.AddComponent<MeshFilter>().sharedMesh = mesh; root.AddComponent<MeshRenderer>().sharedMaterial = material; return root;
        }
        public static GameObject Block(string name, Transform parent, Vector3 position, Vector3 size, Material material)
        {
            var obj = WorldDrawing.Box(name, parent, position, size, material);
            var collider = obj.GetComponent<Collider>(); collider.enabled = false;
            if (Application.isPlaying) Object.Destroy(collider); else Object.DestroyImmediate(collider);
            return obj;
        }
        public static Transform Stake(Transform parent, WorldAssets assets, out TextMeshPro text)
        {
            var root = WorldDrawing.Group("StationStake", parent).transform; root.localPosition = new Vector3(0, 0, 1.2f);
            Block("WoodenLath", root, Vector3.up * StakeHeight / 2, new Vector3(StakeWidth, StakeHeight, 0.025f), assets.timber);
            var flag = Block("PinkFlagging", root, new Vector3(0.07f, 1.12f, 0), new Vector3(0.18f, 0.05f, 0.003f), assets.flagging);
            flag.transform.localRotation = Quaternion.Euler(0, 20, -12);
            Block("StationSign", root, new Vector3(0, 0.9f, 0), new Vector3(0.34f, 0.12f, 0.018f), assets.steel);
            text = WorldDrawing.Text("Station", root, new Vector3(0, 0.9f, 0.012f), new Vector2(0.31f, 0.1f), LetterHeight, assets.font);
            text.transform.localRotation = Quaternion.Euler(0, 180, 0); text.alignment = TextAlignmentOptions.Center;
            text.fontSize = LetterHeight * 10 * assets.font.faceInfo.pointSize / Mathf.Max(1, assets.font.faceInfo.capLine);
            text.fontSharedMaterial = assets.siteText; return root;
        }
        public static void Cell(StationCell cell, WorldAssets a)
        {
            var root = cell.transform; var depth = WorldUnits.TrenchDepth;
            cell.surfaceMaterial = a.soil; cell.openMaterial = a.trench; cell.pipeMaterial = a.bedding; cell.backfillMaterial = a.backfill;
            cell.surface = Mesh("Surface", root, a.stripMesh, a.soil);
            cell.floor = Mesh("Floor", root, a.stripMesh, a.trench, Vector3.down * depth);
            cell.walls = WorldDrawing.Group("Walls", root);
            cell.nearWall = Mesh("NearWall", cell.walls.transform, a.wallNearMesh, a.trench).transform;
            cell.farWall = Mesh("FarWall", cell.walls.transform, a.wallFarMesh, a.trench).transform;
            cell.pipes = WorldDrawing.Group("Pipes", root);
            Mesh("GravelBedding", cell.pipes.transform, a.stripMesh, a.bedding, Vector3.down * (depth - BeddingDepth));
            // WO-L4 rejection 1: three 24-sided builder sections, 288 pipe triangles per cell.
            for (var i = 0; i < 3; i++)
            {
                var pipe = Object.Instantiate(a.pipe, cell.pipes.transform); pipe.name = "LaidPipe_" + i;
                pipe.transform.localPosition = new Vector3(WorldUnits.CellLength * (i + 0.5f) / 3, -depth + BeddingDepth, 0);
            }
            cell.wetBand = WorldDrawing.Group("SeepBand", root);
            foreach (var side in new[] { -1, 1 })
                Block("WetLowerWall", cell.wetBand.transform, new Vector3(WorldUnits.CellLength / 2, -depth + 0.25f, side * 0.54f),
                    new Vector3(WorldUnits.CellLength, 0.5f, 0.005f), a.wetSoil);
            cell.water = Mesh("StandingWater", root, a.stripMesh, a.waterSurface, Vector3.down * (depth - WaterHeight));
            cell.slump = Mesh("SlumpedWall", root, a.slumpMesh, a.trench);
            Mesh("LooseCollapseMaterial", cell.slump.transform, a.windrowMesh, a.spoilSurface,
                new Vector3(0, -depth, 0)).transform.localScale = new Vector3(1, 0.2f, 0.16f);
            cell.spoilWindrow = Mesh("SpoilWindrow", root, a.windrowMesh, a.spoilSurface);
            cell.collapseProps = WorldDrawing.Group("CollapseProps", root);
            Prop(a.barrier, cell.collapseProps.transform, new Vector3(WorldUnits.CellLength / 2, 0, 2.1f));
            foreach (var x in new[] { 1f, WorldUnits.CellLength - 1 }) Prop(a.cone, cell.collapseProps.transform, new Vector3(x, 0, 2.2f));
            cell.box = Protection(root, "TrenchBox", a.steel); cell.shoring = Protection(root, "Shoring", a.timber);
            cell.stake = Stake(root, a, out cell.stationText);
            foreach (var obj in new[] { cell.floor, cell.walls, cell.pipes, cell.wetBand, cell.water, cell.slump, cell.box, cell.shoring, cell.spoilWindrow, cell.collapseProps }) obj.SetActive(false);
        }
        private static GameObject Protection(Transform parent, string name, Material material)
        {
            var root = WorldDrawing.Group(name, parent);
            foreach (var side in new[] { -1, 1 }) Block("Panel", root.transform, new Vector3(WorldUnits.CellLength / 2, -0.9f, side * 0.5f),
                new Vector3(WorldUnits.CellLength, 1.7f, 0.06f), material);
            for (var i = 0; i < 3; i++) Block("Strut", root.transform, new Vector3((i + 0.5f) * WorldUnits.CellLength / 3, -0.3f, 0), new Vector3(0.1f, 0.1f, 1), material);
            return root;
        }
        public static GameObject Prop(GameObject prefab, Transform parent, Vector3 position)
        {
            if (prefab == null) return null;
            var prop = Object.Instantiate(prefab, parent); prop.transform.localPosition = position; return prop;
        }
        public static void CrewSurroundings(Transform crew, WorldAssets assets)
        {
            var props = WorldDrawing.Group("CrewSurroundings", crew).transform;
            Prop(assets.spoil, props, new Vector3(-5, 0, -5));
            // WO-L4: fence every 10 m, 60 m each side, outside the four metre road.
            for (var x = -60; x <= 60; x += 10) Prop(assets.fence, props, new Vector3(x, 0, WorldUnits.RoadZ + 3));
        }
        public static GameObject MachinePerimeter(GameObject machine, Transform crew, WorldAssets assets)
        {
            var props = WorldDrawing.Group("MachinePerimeter", crew);
            var renderers = machine.GetComponentsInChildren<Renderer>(); if (renderers.Length == 0) return props;
            var bounds = renderers[0].bounds; foreach (var r in renderers) bounds.Encapsulate(r.bounds);
            foreach (var x in new[] { bounds.min.x - 0.6f, bounds.max.x + 0.6f }) foreach (var z in new[] { bounds.min.z - 0.6f, bounds.max.z + 0.6f })
            {
                var position = crew.InverseTransformPoint(new Vector3(x, bounds.min.y, z)); position.y = 0;
                Prop(assets.cone, props.transform, position);
            }
            var barrier = crew.InverseTransformPoint(new Vector3(bounds.center.x, bounds.min.y, bounds.max.z + 1)); barrier.y = 0;
            Prop(assets.barrier, props.transform, barrier); return props;
        }
    }
}

Shader "LOBOver/SiteSky"
{
    Properties
    {
        _Cube ("Imported sky", Cube) = "" {}
        _UseCube ("Use imported sky", Float) = 0
        _Exposure ("Exposure", Float) = 1
        _Rotation ("Cubemap rotation", Float) = 0
        [HideInInspector] _SunDirection ("Cubemap sun direction", Vector) = (0,1,0,0)
        _Zenith ("Zenith", Color) = (0.16,0.32,0.53,1)
        _Horizon ("Horizon haze", Color) = (0.68,0.73,0.75,1)
    }
    SubShader
    {
        Tags { "RenderPipeline"="UniversalPipeline" "Queue"="Background" "RenderType"="Opaque" }
        Pass
        {
            Cull Front ZWrite Off ZTest LEqual
            HLSLPROGRAM
            #pragma vertex Vert
            #pragma fragment Frag
            #pragma multi_compile_instancing
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
            TEXTURECUBE(_Cube); SAMPLER(sampler_Cube);
            CBUFFER_START(UnityPerMaterial)
                half4 _Zenith, _Horizon;
                float _UseCube, _Exposure, _Rotation;
            CBUFFER_END
            // Weather is shared by the dome and all site surfaces, including future materialization.
            float _SiteRain, _SiteCloudBank;
            struct Attributes { float4 positionOS : POSITION; UNITY_VERTEX_INPUT_INSTANCE_ID };
            struct Varyings { float4 positionCS : SV_POSITION; float3 direction : TEXCOORD0; UNITY_VERTEX_OUTPUT_STEREO };
            float Hash(float2 p) { return frac(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
            float Noise(float2 p)
            {
                float2 i=floor(p), f=frac(p); f=f*f*(3-2*f);
                return lerp(lerp(Hash(i),Hash(i+float2(1,0)),f.x),lerp(Hash(i+float2(0,1)),Hash(i+1),f.x),f.y);
            }
            float Fbm(float2 p) { return Noise(p)*0.57+Noise(p*2.03)*0.28+Noise(p*4.07)*0.15; }
            Varyings Vert(Attributes input)
            {
                Varyings output; UNITY_SETUP_INSTANCE_ID(input); UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO(output);
                output.positionCS=TransformObjectToHClip(input.positionOS.xyz);
                output.positionCS.z=UNITY_RAW_FAR_CLIP_VALUE*output.positionCS.w;
                output.direction=TransformObjectToWorldDir(input.positionOS.xyz); return output;
            }
            half4 Frag(Varyings input) : SV_Target
            {
                UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(input);
                float3 d=normalize(input.direction);
                half3 col=lerp(_Horizon.rgb,_Zenith.rgb,pow(saturate(d.y),0.45));
                if (_UseCube>0.5)
                {
                    float a=radians(_Rotation); float s=sin(a), c=cos(a);
                    float3 q=float3(c*d.x-s*d.z,d.y,s*d.x+c*d.z);
                    col=SAMPLE_TEXTURECUBE(_Cube,sampler_Cube,q).rgb*_Exposure;
                }
                else
                {
                    float2 uv=d.xz/max(0.12,d.y);
                    float cloud=Fbm(uv*1.2+_Time.y*float2(0.002,0.0007));
                    cloud=lerp(cloud,Fbm(uv*2.7+_Time.y*float2(-0.001,0.0015)),0.3);
                    col=lerp(col,half3(0.91,0.91,0.88),smoothstep(0.5,0.72,cloud)*smoothstep(0,0.15,d.y));
                    // URP's direction points toward the sun: minus the directional light's forward.
                    Light sun=GetMainLight(); float alignment=saturate(dot(d,sun.direction));
                    col+=sun.color*(pow(alignment,1100)*0.8+pow(alignment,48)*0.12)*(1-_SiteRain);
                }
                float bank=smoothstep(0.25,0.8,-d.z)*(1-smoothstep(0.12,0.42,d.y));
                col=lerp(col,half3(0.36,0.40,0.44),saturate(_SiteCloudBank*bank*0.7+_SiteRain*0.45));
                col=lerp(col,_Horizon.rgb,pow(1-saturate(abs(d.y)*3),4)*0.7);
                return half4(col,1);
            }
            ENDHLSL
        }
    }
}

using System;
using System.Collections.Generic;
using System.Linq;
using UnityEditor;
using UnityEngine;

namespace LOBOver.Editor
{
    public static class SiteGeometryBuilder
    {
        // WO-L4 items 4-5, metres. X covers the existing 0..914.4 m site plus its approaches.
        public const float MinX = -100, MaxX = 1100, HalfWidth = 100, FineStep = 2, CoarseStep = 10;
        public const float FineRadius = 30, FlatRadius = 8, Relief = 0.6f, Horizon = 3000;
        public const float RoadWidth = 4, RutDepth = 0.06f, SpoilHeight = 1, SpoilBreak = 30;
        public const int PipeSides = 24; // WO-L4 rejection 1: at most 400 triangles per laid cell.
        public const float PipeDiameter = 0.3f; // WO-L4 item 10, outside diameter.
        private const float HalfTrench = World.WorldUnits.TrenchWidth / 2;
        private static float Noise(float x, float z) => (Mathf.PerlinNoise(x * 0.017f + 23, z * 0.017f + 73) * 0.57f
            + Mathf.PerlinNoise(x * 0.037f + 9, z * 0.037f + 31) * 0.28f + Mathf.PerlinNoise(x * 0.081f + 59, z * 0.081f + 11) * 0.15f) * 2 - 1;
        public static float Height(float x, float z)
        {
            var distance = Mathf.Min(Mathf.Abs(z), Mathf.Abs(z - World.WorldUnits.RoadZ));
            var height = Relief * Noise(x, z) * Mathf.SmoothStep(0, 1, (distance - FlatRadius) / 14);
            var road = z - World.WorldUnits.RoadZ;
            var ruts = Mathf.Exp(-Mathf.Pow((road - 0.85f) / 0.3f, 2)) + Mathf.Exp(-Mathf.Pow((road + 0.85f) / 0.3f, 2));
            return height - RutDepth * ruts;
        }
        public static Color Paint(float x, float z)
        {
            var edge = Noise(x * 7, z * 7) * 0.8f;
            var gravel = 1 - Mathf.SmoothStep(0, 1, (Mathf.Abs(z - World.WorldUnits.RoadZ) - RoadWidth / 2 + edge) / 1.4f);
            var dirt = 1 - Mathf.SmoothStep(0, 1, (Mathf.Abs(z) - 12 + edge) / 3);
            return new Color(dirt * (1 - gravel), gravel, (1 - dirt) * (1 - gravel), 1);
        }
        public static Mesh Ground()
        {
            var builder = new MeshData();
            foreach (var side in new[] { -1, 1 })
            {
                // Fine bank rows terminate at a shared coarse edge. The zipper stitches 2 m to
                // 10 m without T-junctions; relief and splat weights are continuous at the join.
                var rows = new List<(float z, float step)>();
                for (var z = HalfTrench; z < FineRadius; z += FineStep) rows.Add((z, FineStep));
                // Additional road rows keep both shallow wheel ruts in the geometry.
                if (side > 0) foreach (var z in new[] { 4f, 5.15f, 6f, 6.85f, 8f }) rows.Add((z, FineStep));
                rows.Add((FineRadius, FineStep));
                for (var z = FineRadius + CoarseStep; z <= HalfWidth; z += CoarseStep) rows.Add((z, CoarseStep));
                var sorted = rows.OrderBy(r => r.z).ToArray();
                int[] previous = null; float[] previousX = null;
                foreach (var row in sorted)
                {
                    var count = Mathf.RoundToInt((MaxX - MinX) / row.step) + 1;
                    var ids = new int[count]; var xs = new float[count];
                    for (var i = 0; i < count; i++)
                    {
                        var x = xs[i] = MinX + i * row.step; var z = side * row.z;
                        ids[i] = builder.Vertex(new Vector3(x, Height(x, z), z), Paint(x, z));
                    }
                    if (previous != null)
                    {
                        var a = 0; var b = 0;
                        while (a < previous.Length - 1 || b < ids.Length - 1)
                        {
                            if (a < previous.Length - 1 && (b == ids.Length - 1 || previousX[a + 1] <= xs[b + 1]))
                            { builder.Triangle(previous[a], previous[a + 1], ids[b], side > 0); a++; }
                            else { builder.Triangle(previous[a], ids[b + 1], ids[b], side > 0); b++; }
                        }
                    }
                    previous = ids; previousX = xs;
                }
            }
            builder.Quad(new Vector3(MinX, 0, -HalfTrench), new Vector3(0, 0, -HalfTrench), new Vector3(0, 0, HalfTrench), new Vector3(MinX, 0, HalfTrench));
            // The host-driven Surface is the only lid over a station. Never let a bank
            // triangle bridge the cut, including after changes to the stitching rows.
            builder.CutTrench();
            return Save("GroundRelief", builder.Mesh());
        }
        public static Mesh HorizonMesh()
        {
            var b = new MeshData();
            // Four strips start at the exact terrain boundary. A gentle skirt avoids a crack
            // where the coarse edge has relief; fog hides the remote outer edge.
            for (var x = MinX; x < MaxX; x += CoarseStep) foreach (var side in new[] { -1, 1 })
            {
                var a = new Vector3(x, Height(x, side * HalfWidth), side * HalfWidth);
                var c = new Vector3(x + CoarseStep, Height(x + CoarseStep, side * HalfWidth), side * HalfWidth);
                b.Quad(a, c, new Vector3(c.x, -1, side * Horizon), new Vector3(a.x, -1, side * Horizon), side > 0);
            }
            var edge = new List<float> { -Horizon, Horizon, -HalfTrench, HalfTrench, 4, 5.15f, 6, 6.85f, 8 };
            foreach (var side in new[] { -1, 1 })
            {
                for (var z = HalfTrench; z < FineRadius; z += FineStep) edge.Add(side * z);
                for (var z = FineRadius; z <= HalfWidth; z += CoarseStep) edge.Add(side * z);
            }
            var zs = edge.Distinct().OrderBy(z => z).ToArray();
            foreach (var x in new[] { MinX, MaxX }) for (var i = 0; i < zs.Length - 1; i++)
            {
                var z0 = zs[i]; var z1 = zs[i + 1]; var end = x == MinX ? -Horizon : Horizon;
                b.Quad(new Vector3(x, Mathf.Abs(z0) > HalfWidth ? -1 : Height(x, z0), z0), new Vector3(end, -1, z0),
                    new Vector3(end, -1, z1), new Vector3(x, Mathf.Abs(z1) > HalfWidth ? -1 : Height(x, z1), z1), x == MaxX);
            }
            return Save("Horizon", b.Mesh());
        }
        public static Mesh Strip()
        {
            var b = new MeshData(); b.Quad(new Vector3(0, 0, -HalfTrench), new Vector3(World.WorldUnits.CellLength, 0, -HalfTrench),
                new Vector3(World.WorldUnits.CellLength, 0, HalfTrench), new Vector3(0, 0, HalfTrench));
            return Save("TrenchStrip", b.Mesh());
        }
        public static Mesh Wall(int side)
        {
            var b = new MeshData(); const int slices = 24, levels = 6; // WO-L4 irregular wall presentation tessellation.
            for (var i = 0; i <= slices; i++) for (var j = 0; j <= levels; j++)
            {
                var x = World.WorldUnits.CellLength * i / slices; var y = -World.WorldUnits.TrenchDepth * j / levels;
                var offset = Mathf.Sin(j * Mathf.PI / levels) * Noise(x * 15, y * 17) * 0.07f;
                b.Vertex(new Vector3(x, y, side * (HalfTrench + offset)), Color.white);
            }
            for (var i = 0; i < slices; i++) for (var j = 0; j < levels; j++)
            {
                var a = i * (levels + 1) + j; var c = a + levels + 1;
                b.Triangle(a, c, a + 1, side < 0); b.Triangle(c, c + 1, a + 1, side < 0);
            }
            return Save(side < 0 ? "TrenchFarWall" : "TrenchNearWall", b.Mesh());
        }
        public static Mesh Windrow()
        {
            var b = new MeshData(); const int steps = 30, cross = 6;
            for (var i = 0; i <= steps; i++) for (var j = 0; j <= cross; j++)
            {
                var x = (SpoilBreak - 1) * i / steps + 0.5f; var v = j / (float)cross;
                var envelope = Mathf.Sin(v * Mathf.PI) * Mathf.SmoothStep(0, 1, Mathf.Min(x - 0.5f, SpoilBreak - 0.5f - x));
                b.Vertex(new Vector3(x, SpoilHeight * envelope * (0.85f + 0.15f * Noise(x * 10, v * 15)), -3 + (v - 0.5f) * 2.4f), Color.white);
            }
            for (var i = 0; i < steps; i++) for (var j = 0; j < cross; j++)
            { var a = i * (cross + 1) + j; var c = a + cross + 1; b.Triangle(a, a + 1, c); b.Triangle(c, a + 1, c + 1); }
            return Save("SpoilWindrow", b.Mesh());
        }
        public static Mesh Pipe()
        {
            // Three 96-triangle cylinders per cell = 288, including their end caps.
            var b = new MeshData(); var radius = PipeDiameter / 2;
            var halfLength = World.WorldUnits.CellLength / 6;
            for (var end = 0; end < 2; end++) for (var i = 0; i <= PipeSides; i++)
            {
                var angle = i * Mathf.PI * 2 / PipeSides;
                b.Vertex(new Vector3(end == 0 ? -halfLength : halfLength, radius + radius * Mathf.Cos(angle), radius * Mathf.Sin(angle)),
                    Color.white, new Vector2(end, i / (float)PipeSides));
            }
            for (var i = 0; i < PipeSides; i++)
            {
                var c = PipeSides + 1 + i;
                b.Triangle(i, i + 1, c); b.Triangle(c, i + 1, c + 1);
            }
            for (var end = 0; end < 2; end++)
            {
                var center = b.Vertex(new Vector3(end == 0 ? -halfLength : halfLength, radius, 0), Color.white, new Vector2(0.5f, 0.5f));
                for (var i = 0; i <= PipeSides; i++)
                {
                    var angle = i * Mathf.PI * 2 / PipeSides;
                    b.Vertex(new Vector3(end == 0 ? -halfLength : halfLength, radius + radius * Mathf.Cos(angle), radius * Mathf.Sin(angle)),
                        Color.white, new Vector2(0.5f + 0.5f * Mathf.Cos(angle), 0.5f + 0.5f * Mathf.Sin(angle)));
                }
                for (var i = 0; i < PipeSides; i++) b.Triangle(center, center + 1 + i, center + 2 + i, end == 0);
            }
            return Save("LaidPipe24", b.Mesh());
        }
        public static Mesh HeroPile()
        {
            // WO-L4 rejection 1 permits a builder mound with the scan's PBR maps.
            // 32 by 16 cells = 1,024 triangles, one metre tall like the accepted scan.
            const int along = 32, across = 16;
            var b = new MeshData();
            for (var i = 0; i <= along; i++) for (var j = 0; j <= across; j++)
            {
                var u = i / (float)along; var v = j / (float)across;
                var envelope = Mathf.Sin(u * Mathf.PI) * Mathf.Sin(v * Mathf.PI);
                var height = envelope * (1 + 0.12f * Noise(u * 80, v * 80) * (1 - envelope));
                b.Vertex(new Vector3((u - 0.5f) * 7, height, (v - 0.5f) * 3), Color.white);
            }
            for (var i = 0; i < along; i++) for (var j = 0; j < across; j++)
            {
                var a = i * (across + 1) + j; var c = a + across + 1;
                b.Triangle(a, a + 1, c); b.Triangle(c, a + 1, c + 1);
            }
            return Save("HeroSpoilMound", b.Mesh());
        }
        public static Mesh Collapse()
        {
            var b = new MeshData(); const int steps = 20;
            for (var i = 0; i <= steps; i++)
            {
                var x = World.WorldUnits.CellLength * i / steps;
                var h = 0.8f + 0.4f * Noise(x * 11, 2);
                b.Vertex(new Vector3(x, -World.WorldUnits.TrenchDepth, -HalfTrench), Color.white);
                b.Vertex(new Vector3(x, -World.WorldUnits.TrenchDepth + h, -HalfTrench), Color.white);
                b.Vertex(new Vector3(x, -World.WorldUnits.TrenchDepth + 0.08f, 0.25f + Noise(x * 7, 5) * 0.15f), Color.white);
            }
            for (var i = 0; i < steps; i++)
            { var a = i * 3; b.Triangle(a + 1, a + 2, a + 4); b.Triangle(a + 4, a + 2, a + 5); b.Triangle(a, a + 1, a + 3); b.Triangle(a + 3, a + 1, a + 4); }
            b.Triangle(0, 2, 1); b.Triangle(steps * 3, steps * 3 + 1, steps * 3 + 2);
            return Save("CollapsedWedge", b.Mesh());
        }
        public static Mesh Save(string name, Mesh mesh)
        {
            var path = SiteAssetBuilder.Art + "Generated/" + name + ".asset"; mesh.name = name;
            var old = AssetDatabase.LoadAssetAtPath<Mesh>(path);
            if (old == null) { AssetDatabase.CreateAsset(mesh, path); return mesh; }
            if (!old.vertices.SequenceEqual(mesh.vertices) || !old.triangles.SequenceEqual(mesh.triangles) || !old.colors.SequenceEqual(mesh.colors)
                || !old.uv.SequenceEqual(mesh.uv) || !old.normals.SequenceEqual(mesh.normals) || !old.tangents.SequenceEqual(mesh.tangents))
            { EditorUtility.CopySerialized(mesh, old); EditorUtility.SetDirty(old); }
            UnityEngine.Object.DestroyImmediate(mesh); return old;
        }
        private sealed class MeshData
        {
            private readonly List<Vector3> vertices = new List<Vector3>();
            private readonly List<Color> colors = new List<Color>();
            private readonly List<Vector2> uvs = new List<Vector2>();
            private readonly List<int> indices = new List<int>();
            public int Vertex(Vector3 v, Color c, Vector2? uv = null)
            { vertices.Add(v); colors.Add(c); uvs.Add(uv ?? new Vector2(v.x, v.z)); return vertices.Count - 1; }
            public void CutTrench()
            {
                for (var i = indices.Count - 3; i >= 0; i -= 3)
                {
                    var a = vertices[indices[i]]; var b = vertices[indices[i + 1]]; var c = vertices[indices[i + 2]];
                    if (Mathf.Max(a.x, Mathf.Max(b.x, c.x)) > 0
                        && Mathf.Min(a.z, Mathf.Min(b.z, c.z)) < HalfTrench
                        && Mathf.Max(a.z, Mathf.Max(b.z, c.z)) > -HalfTrench) indices.RemoveRange(i, 3);
                }
            }
            public void Triangle(int a, int b, int c, bool reverse = false) { indices.Add(a); indices.Add(reverse ? c : b); indices.Add(reverse ? b : c); }
            public void Quad(Vector3 a, Vector3 b, Vector3 c, Vector3 d, bool reverse = true)
            {
                var start = vertices.Count; foreach (var v in new[] { a, b, c, d }) Vertex(v, Paint(v.x, v.z));
                Triangle(start, start + 1, start + 2, reverse); Triangle(start, start + 2, start + 3, reverse);
            }
            public Mesh Mesh()
            {
                var mesh = new Mesh { indexFormat = vertices.Count > 65535 ? UnityEngine.Rendering.IndexFormat.UInt32 : UnityEngine.Rendering.IndexFormat.UInt16 };
                mesh.SetVertices(vertices); mesh.SetColors(colors); mesh.SetTriangles(indices, 0);
                mesh.SetUVs(0, uvs);
                mesh.RecalculateNormals(); mesh.RecalculateTangents(); mesh.RecalculateBounds(); return mesh;
            }
        }
    }
}


