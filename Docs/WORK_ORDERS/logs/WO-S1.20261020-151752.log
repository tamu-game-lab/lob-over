<script>
'use strict';
const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let state,result,sequence=0,stage,lastDay=0;
const socket=new WebSocket(`${location.protocol==='https:'?'wss':'ws'}://${location.host}/ws`);
socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'facilitator',client:'web'}));
socket.onclose=()=>{$('connection').textContent='Disconnected';};
function control(action){if(socket.readyState!==WebSocket.OPEN)return;$('feedback').textContent='';socket.send(JSON.stringify({t:'ctrl',v:1,id:'f-'+(++sequence),action,...(action==='load'?{stage:state.view.stage2}:{})}));}
for(const button of document.querySelectorAll('[data-action]'))button.onclick=()=>control(button.dataset.action);
function render(){
  const v=state.view;$('title').textContent=v.project.title+' / Facilitator';$('time').textContent=state.day.toFixed(2);$('day').textContent=state.displayDay;$('speed').textContent=state.speed;
  $('plan-view').textContent=JSON.stringify(v.plan,null,2);$('site-view').textContent=JSON.stringify(v.site,null,2);
  $('events').innerHTML='<tr><th>Event</th><th>Trigger</th><th>State</th><th>Variant</th></tr>'+v.events.map(e=>`<tr><td>${esc(e.card.title)}</td><td>${esc(JSON.stringify(e.trigger))}</td><td>${e.resolved?'resolved':e.fired?'active':'upcoming'}</td><td>${esc(e.protection??'—')}</td></tr>`).join('');
  $('deviations').innerHTML='<tr><th>Deviation</th><th>State</th><th>Order</th></tr>'+v.deviations.map(d=>`<tr><td>${esc(d.id)}</td><td>${d.caught?'caught':d.triggered?'triggered':'pending'}</td><td>${esc(d.orderId??'—')}</td></tr>`).join('');
}
function acceptState(message){if(state?.runId!==message.runId){result=null;$('result').textContent='—';}state=message;stage=message.stage;lastDay=message.day;render();}
socket.onmessage=event=>{const message=JSON.parse(event.data);if(message.t==='welcome'){$('connection').textContent=message.mirror?'Mirror · read only':'Connected';acceptState(message.state);}else if(message.t==='state')acceptState(message);else if(message.t==='nack')$('feedback').textContent=message.reason;else if(message.t==='result'){result=message;$('result').textContent=Object.entries(message).filter(([k,v])=>typeof v==='number'&&!['v','day'].includes(k)).map(([k,v])=>`${k}: ${Number(v.toFixed(2))}`).join(' · ');}};
</script></body></html>
