diff --git a/Relay/src/index.js b/Relay/src/index.js
new file mode 100644
index 0000000000000000000000000000000000000000..94053d55a862fb42b11086ae2578f8610499fd4e
--- /dev/null
+++ b/Relay/src/index.js
@@ -0,0 +1,123 @@
+import { DurableObject } from 'cloudflare:workers';
+
+// WO-L9: six characters, omitting ambiguous I, O, 0 and 1.
+const CODE = /^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$/;
+const SEATS = new Set(['site', 'plan', 'rules', 'facilitator']);
+const CLIENTS = new Set(['quest', 'web']);
+const directory = env => env.DIRECTORY.getByName('rooms');
+const room = (env, code) => env.ROOMS.getByName(code);
+const open = socket => socket.readyState === WebSocket.OPEN;
+const json = value => Response.json(value, { headers: {
+  'Access-Control-Allow-Origin': '*', 'Cache-Control': 'no-store',
+} });
+function parse(raw) {
+  if (typeof raw !== 'string') return null;
+  try { return JSON.parse(raw); } catch { return null; }
+}
+
+export default {
+  async fetch(request, env) {
+    const url = new URL(request.url);
+    if (request.method !== 'GET') return new Response('Method not allowed', { status: 405 });
+    if (url.pathname === '/rooms') return json(await directory(env).list());
+    const match = /^\/(host|join)\/([^/]+)$/.exec(url.pathname);
+    if (!match || !CODE.test(match[2])) return new Response('Unknown room path', { status: 404 });
+    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') {
+      return new Response('WebSocket required', { status: 426 });
+    }
+    if (match[1] === 'join' && (!SEATS.has(url.searchParams.get('seat')) || !CLIENTS.has(url.searchParams.get('client')))) {
+      return new Response('Unknown seat or client', { status: 400 });
+    }
+    return room(env, match[2]).fetch(request);
+  },
+};
+
+// Host sockets double as the directory entries. Their attachments survive
+// hibernation; an in-memory Map alone would silently forget idle open rooms.
+// Both DOs accept incoming sockets, so neither needs an outbound socket/timer
+// that would prevent hibernation. No Storage API, KV or message history is used.
+export class Directory extends DurableObject {
+  host(code) { return this.ctx.getWebSockets(code).find(open); }
+  list() {
+    return this.ctx.getWebSockets().filter(open).map(socket => {
+      const { code, host, since } = socket.deserializeAttachment();
+      return { code, host, since };
+    }).sort((a, b) => a.code.localeCompare(b.code));
+  }
+  hostInfo(code) { return this.host(code)?.deserializeAttachment() ?? null; }
+  fetch(request) {
+    const url = new URL(request.url), code = url.pathname.split('/').at(-1);
+    if (this.host(code)) return new Response('Room already has a host', { status: 409 });
+    const pair = new WebSocketPair();
+    this.ctx.acceptWebSocket(pair[1], [code]);
+    pair[1].serializeAttachment({ code, host: url.searchParams.get('name') || 'Browser',
+      since: Date.now(), session: crypto.randomUUID() });
+    return new Response(null, { status: 101, webSocket: pair[0] });
+  }
+  send(code, session, message) {
+    const socket = this.host(code);
+    if (!socket || socket.deserializeAttachment().session !== session) return false;
+    socket.send(JSON.stringify(message));
+    return true;
+  }
+  async webSocketMessage(socket, raw) {
+    const message = parse(raw);
+    if (!message || message.t !== 'relay' || typeof message.to !== 'string' || !('data' in message)) return;
+    const { code, session } = socket.deserializeAttachment();
+    await room(this.env, code).deliver(session, message.to, message.data);
+  }
+  async webSocketClose(socket) {
+    socket.close();
+    const { code, session } = socket.deserializeAttachment();
+    await room(this.env, code).hostLeft(session);
+  }
+  async webSocketError(socket) { await this.webSocketClose(socket); }
+}
+
+export class Room extends DurableObject {
+  async fetch(request) {
+    const url = new URL(request.url), code = url.pathname.split('/').at(-1);
+    // Rooms register their host with Directory, which owns the socket and list
+    // entry together. A second host is rejected atomically in that object.
+    if (url.pathname.startsWith('/host/')) return directory(this.env).fetch(request);
+    const host = await directory(this.env).hostInfo(code);
+    if (!host) return new Response('Room has no host', { status: 404 });
+    const pair = new WebSocketPair();
+    const client = { code, session: host.session, id: crypto.randomUUID(),
+      seat: url.searchParams.get('seat'), client: url.searchParams.get('client') };
+    this.ctx.acceptWebSocket(pair[1]);
+    pair[1].serializeAttachment(client);
+    if (!await this.notify(client, { event: 'join' })) pair[1].close(1000, 'host left');
+    return new Response(null, { status: 101, webSocket: pair[0] });
+  }
+  notify({ code, session, id, seat, client }, fields) {
+    return directory(this.env).send(code, session, { t: 'relay', from: id, seat, client, ...fields });
+  }
+  deliver(session, to, data) {
+    const raw = JSON.stringify(data);
+    for (const socket of this.ctx.getWebSockets()) {
+      const client = socket.deserializeAttachment();
+      if (open(socket) && client.session === session && (to === '*' || to === client.id)) socket.send(raw);
+    }
+  }
+  hostLeft(session) {
+    for (const socket of this.ctx.getWebSockets()) {
+      if (open(socket) && socket.deserializeAttachment().session === session) socket.close(1000, 'host left');
+    }
+    // Entries disappear immediately on close: no hostless entry can linger
+    // past WO-L9's ten-minute expiry, and /rooms only lists open host sockets.
+  }
+  async webSocketMessage(socket, raw) {
+    const data = parse(raw);
+    if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+    if (!await this.notify(socket.deserializeAttachment(), { data })) socket.close(1000, 'host left');
+  }
+  async webSocketClose(socket) {
+    const client = socket.deserializeAttachment();
+    if (client.left) return;
+    socket.serializeAttachment({ ...client, left: true });
+    socket.close();
+    await this.notify(client, { event: 'leave' });
+  }
+  async webSocketError(socket) { await this.webSocketClose(socket); }
+}
diff --git a/Relay/test/helpers.js b/Relay/test/helpers.js
new file mode 100644
index 0000000000000000000000000000000000000000..af6fad92088b509570e516ca997278f522cfab32
--- /dev/null
+++ b/Relay/test/helpers.js
@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { createServer } from 'node:net';
+import { fileURLToPath } from 'node:url';
+import WebSocket from 'ws';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+export async function startRelay() {
+  const reservation = createServer();
+  reservation.listen(0, '127.0.0.1'); await once(reservation, 'listening');
+  const port = reservation.address().port;
+  await new Promise(resolve => reservation.close(resolve));
+  assert.ok(![7331, 7333, 7341].includes(port));
+  const args = ['dev', '--local', '--ip', '127.0.0.1', '--port', String(port),
+    '--inspector-port', '0', '--show-interactive-dev-session=false'];
+  const command = process.platform === 'win32' ? process.env.ComSpec : root + 'node_modules/.bin/wrangler';
+  const commandArgs = process.platform === 'win32'
+    ? ['/d', '/s', '/c', `""${root}node_modules/.bin/wrangler.cmd" ${args.join(' ')}"`] : args;
+  const child = spawn(command, commandArgs, {
+    cwd: root, windowsHide: true, windowsVerbatimArguments: process.platform === 'win32', stdio: ['pipe', 'pipe', 'pipe'],
+    env: { ...process.env, WRANGLER_SEND_METRICS: 'false',
+      WRANGLER_LOG_PATH: root + '.wrangler/logs', CI: 'true' },
+  });
+  let logs = '', exited = false;
+  child.stdout.on('data', data => { logs += data; });
+  child.stderr.on('data', data => { logs += data; });
+  child.once('exit', () => { exited = true; });
+  const base = `http://127.0.0.1:${port}`;
+  async function close() {
+    if (exited) return;
+    const done = once(child, 'exit');
+    // Kill only this test's process tree, including Wrangler's workerd child.
+    if (process.platform === 'win32') {
+      const stop = spawn('taskkill', ['/pid', String(child.pid), '/t', '/f'], { windowsHide: true, stdio: 'ignore' });
+      await once(stop, 'exit');
+    } else child.kill('SIGTERM');
+    await done;
+  }
+  try {
+    await poll(async () => {
+      if (exited) throw new Error('Wrangler exited:\n' + logs);
+      try { return (await fetch(base + '/rooms', { signal: AbortSignal.timeout(1000) })).ok; }
+      catch { return false; }
+    }, 30_000);
+  } catch (error) { await close(); throw new Error(error.message + '\n' + logs); }
+  return { base, ws: base.replace('http:', 'ws:'), close, logs: () => logs };
+}
+
+export async function poll(check, timeout = 5000) {
+  const deadline = Date.now() + timeout;
+  do {
+    const result = await check();
+    if (result) return result;
+    await new Promise(resolve => setTimeout(resolve, 25));
+  } while (Date.now() < deadline);
+  throw new Error('Timed out waiting for test condition');
+}
+
+export async function connect(url, t) {
+  const socket = new WebSocket(url), messages = [];
+  let closed;
+  socket.on('message', raw => messages.push(JSON.parse(raw)));
+  socket.on('close', (code, reason) => { closed = { code, reason: String(reason) }; });
+  // Each test owns every socket and closes it even on assertion failure.
+  t.after(() => socket.terminate());
+  await once(socket, 'open');
+  return { socket, messages, send: message => socket.send(JSON.stringify(message)),
+    next: predicate => poll(() => {
+      const index = messages.findIndex(predicate);
+      return index < 0 ? false : messages.splice(index, 1)[0];
+    }),
+    closed: () => poll(() => closed),
+  };
+}
+
+export async function rejected(url, status) {
+  const socket = new WebSocket(url);
+  socket.on('error', () => {});
+  const [, response] = await once(socket, 'unexpected-response');
+  response.resume(); socket.terminate();
+  assert.equal(response.statusCode, status);
+}
diff --git a/Relay/test/relay.test.js b/Relay/test/relay.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..49f133d0b806dad8e53e81697a5b052e5e3dfffc
--- /dev/null
+++ b/Relay/test/relay.test.js
@@ -0,0 +1,61 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { startRelay, connect, rejected, poll } from './helpers.js';
+
+test('wrangler relay: list, two seats, routing, conflict, leave and host-left close', { timeout: 60_000 }, async t => {
+  const relay = await startRelay();
+  try {
+    const list = () => fetch(relay.base + '/rooms').then(response => response.json());
+    assert.deepEqual(await list(), []);
+    assert.equal((await fetch(relay.base + '/rooms')).headers.get('access-control-allow-origin'), '*');
+    await rejected(relay.ws + '/join/K7MX2Q?seat=site&client=quest', 404);
+    await rejected(relay.ws + '/host/INVALID', 404);
+    const before = Date.now();
+    const host = await connect(relay.ws + '/host/K7MX2Q?name=Test%20Mac', t);
+    const rooms = await list();
+    assert.equal(rooms.length, 1);
+    assert.equal(rooms[0].code, 'K7MX2Q'); assert.equal(rooms[0].host, 'Test Mac');
+    assert.ok(rooms[0].since >= before && rooms[0].since <= Date.now());
+    await rejected(relay.ws + '/host/K7MX2Q', 409);
+    await rejected(relay.ws + '/join/K7MX2Q?seat=other&client=quest', 400);
+    await rejected(relay.ws + '/join/K7MX2Q?seat=site&client=other', 400);
+    const site = await connect(relay.ws + '/join/K7MX2Q?seat=site&client=quest', t);
+    const first = await host.next(message => message.event === 'join');
+    assert.equal(first.seat, 'site'); assert.equal(first.client, 'quest');
+    const plan = await connect(relay.ws + '/join/K7MX2Q?seat=plan&client=web', t);
+    const second = await host.next(message => message.event === 'join');
+    assert.notEqual(first.from, second.from);
+    const hello = { t: 'hello', v: 1, seat: 'site', client: 'quest' };
+    site.send(hello);
+    assert.deepEqual(await host.next(message => message.data?.t === 'hello'),
+      { t: 'relay', from: first.from, seat: 'site', client: 'quest', data: hello });
+    const command = { t: 'cmd', v: 1, id: 'p1', seat: 'plan', action: 'commit', ops: [] };
+    plan.send(command);
+    assert.deepEqual(await host.next(message => message.data?.id === 'p1'),
+      { t: 'relay', from: second.from, seat: 'plan', client: 'web', data: command });
+    host.send({ t: 'relay', to: first.from, data: { t: 'welcome', v: 1, seat: 'site' } });
+    assert.deepEqual(await site.next(message => message.t === 'welcome'), { t: 'welcome', v: 1, seat: 'site' });
+    host.send({ t: 'relay', to: '*', data: { t: 'state', v: 1, day: 0 } });
+    for (const seat of [site, plan]) assert.deepEqual(await seat.next(message => message.t === 'state'), { t: 'state', v: 1, day: 0 });
+    assert.deepEqual(plan.messages, [], 'targeted welcome did not leak to the second seat');
+    // Idle long enough for local workerd hibernation; the directory and seat
+    // attachments must still identify the same live room and connections.
+    await new Promise(resolve => setTimeout(resolve, 12_000));
+    assert.deepEqual(await list(), rooms);
+    site.send({ t: 'cmd', v: 1, id: 'after-idle' });
+    assert.equal((await host.next(message => message.data?.id === 'after-idle')).from, first.from);
+    plan.socket.close();
+    assert.deepEqual(await host.next(message => message.event === 'leave'),
+      { t: 'relay', event: 'leave', from: second.from, seat: 'plan', client: 'web' });
+    const rules = await connect(relay.ws + '/join/K7MX2Q?seat=rules&client=web', t);
+    await host.next(message => message.event === 'join');
+    host.socket.close();
+    for (const seat of [site, rules]) assert.deepEqual(await seat.closed(), { code: 1000, reason: 'host left' });
+    await poll(async () => (await list()).length === 0);
+    const replacement = await connect(relay.ws + '/host/K7MX2Q', t);
+    assert.equal((await list())[0].host, 'Browser');
+    replacement.socket.close();
+    await poll(async () => (await list()).length === 0);
+    t.diagnostic('Forwarding both ways, broadcast, joins/leaves, hibernation, CORS, 409 and host-left passed');
+  } finally { await relay.close(); }
+});
