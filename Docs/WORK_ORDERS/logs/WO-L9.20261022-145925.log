      send(message) { socket.emit('message', message); },
      onMessage(callback) { socket.write = callback; },
      onClose(callback) { socket.dispose = callback; },
      close() { socket.close(); },
    });
    setTimeout(() => socket.opened(), 0);
    return socket;
  }
