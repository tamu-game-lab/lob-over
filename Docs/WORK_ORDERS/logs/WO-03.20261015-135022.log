import { spawn } from 'node:child_process';
import { once } from 'node:events';
const host = spawn(process.execPath, ['Monitor/src/host/server.js', 'Data/Scenarios/stage1_texas.json'], {
  windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'],
});
let stderr = '';
host.stderr.on('data', data => { stderr += data; });
try {
  await new Promise((resolve, reject) => {
    let stdout = '';
    host.stdout.on('data', data => {
      stdout += data;
      if (stdout.includes('listening on 7331')) resolve();
    });
    host.once('error', reject);
    host.once('exit', code => reject(new Error("'`Host exited ${code}: ${stderr}`)));
  });
  for (const page of ['"'plan', 'site']) {
    const response = await fetch("'`http://localhost:7331/${page}.html`);
    console.log(`${page}.html: ${response.status}`);
    if (response.status !== 200) throw new Error('"'HTTP check failed');
    await response.text();
  }
  const probe = spawn(process.execPath, ['Monitor/out/pace.mjs'], { windowsHide: true, stdio: 'inherit' });
  const [code] = await once(probe, 'exit');
  if (code "'!== 0) throw new Error(`Pacing probe exited ${code}`);
} finally {
  if (host.exitCode === null && host.signalCode === null) {
    const exited = once(host, '"'exit');
    host.kill();
    await exited;
  }
  console.log('Pacing host stopped');
  if (stderr) console.error(stderr);
}
