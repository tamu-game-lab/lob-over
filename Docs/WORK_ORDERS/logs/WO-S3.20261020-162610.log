diff --git a/Assets/LOBOver/Runtime/Director/StreamingData.cs b/Assets/LOBOver/Runtime/Director/StreamingData.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8f8b0587cb3b359657212cd56fb247ebba11d9d9
--- /dev/null
+++ b/Assets/LOBOver/Runtime/Director/StreamingData.cs
@@ -0,0 +1,35 @@
+using System;
+using System.Collections;
+using System.IO;
+using UnityEngine;
+using UnityEngine.Networking;
+
+namespace LOBOver.Runtime
+{
+    public static class StreamingData
+    {
+        public static string Url(string relative)
+        {
+            var path = Application.streamingAssetsPath.TrimEnd('/') + "/" + relative;
+            return path.Contains("://") ? path : new Uri(path).AbsoluteUri;
+        }
+
+        public static IEnumerator ReadText(string relative, Action<string> loaded, Action<string> failed)
+        {
+#if UNITY_ANDROID && !UNITY_EDITOR
+            using (var request = UnityWebRequest.Get(Url(relative)))
+            {
+                yield return request.SendWebRequest();
+                if (request.result == UnityWebRequest.Result.Success) loaded(request.downloadHandler.text);
+                else failed(relative + ": " + request.error);
+            }
+#else
+            string value;
+            try { value = File.ReadAllText(Path.Combine(Application.streamingAssetsPath, relative)); }
+            catch (Exception error) { failed(relative + ": " + error.Message); yield break; }
+            loaded(value);
+            yield break;
+#endif
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/CrewRig.cs b/Assets/LOBOver/Runtime/World/CrewRig.cs
new file mode 100644
index 0000000000000000000000000000000000000000..020aca77b0552ceaae40a66460571da6eb80bb18
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/CrewRig.cs
@@ -0,0 +1,149 @@
+using System;
+using LOBOver.Sim;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class CrewRig : MonoBehaviour
+    {
+        public string Id { get; private set; }
+        public string Status { get; private set; }
+        public double StationFt { get; private set; }
+        public int MoodLevel { get; private set; }
+        public string MachinePlate { get; private set; }
+        public Transform Foreman => workers[0];
+        public Transform Partner => partner;
+        public string ForemanClip => clips[0];
+        public bool WorkingParticles => particles != null && particles.isPlaying;
+        public GameObject Machine => machine;
+        private WorldAssets assets;
+        private GameObject machine, effects;
+        private Animator[] machineAnimators;
+        private readonly Transform[] workers = new Transform[2]; // WO-08: two workers per machine.
+        private readonly Animator[] animators = new Animator[2];
+        private readonly string[] clips = new string[2];
+        private TextMeshPro plate;
+        private ParticleSystem particles;
+        private AudioSource engine, argument;
+        private Transform partner;
+        private Vector3 target, movementVelocity;
+        private float statusTime;
+        private bool positioned;
+        private readonly Vector3[] workerTargets = new Vector3[2], workerVelocities = new Vector3[2];
+        // Presentation cadence only; the mood level itself comes exclusively from SiteView.
+        private const float PointPeriodSeconds = 10; // WO-08 section 3.
+        private const float WorkingAlternateSeconds = 4;
+        private static readonly string[] MoodClips = { "Idle", "IdleAlternate", "Drink", "EquipmentCheck" };
+        private static readonly float[] MoodSpeeds = { 1, 0.9f, 0.8f, 0.7f };
+
+        public void Initialize(string id, WorldAssets source)
+        {
+            Id = id; assets = source; name = "Crew_" + id;
+            for (var i = 0; i < workers.Length; i++)
+            {
+                workers[i] = Instantiate(assets.worker, transform).transform; workers[i].name = i == 0 ? "Foreman" : "Worker";
+                animators[i] = workers[i].GetComponentInChildren<Animator>();
+                if (animators[i] != null) { animators[i].applyRootMotion = false; animators[i].cullingMode = AnimatorCullingMode.AlwaysAnimate; }
+                InspectTarget.Attach(workers[i].gameObject, "crew");
+            }
+            effects = Instantiate(assets.particles, transform); effects.name = "WorkParticles";
+            particles = effects.GetComponentInChildren<ParticleSystem>();
+            foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
+            plate = WorldDrawing.Text("MachinePlate", transform, new Vector3(-1, 2.5f, 1), new Vector2(4, 0.5f), 0.25f, assets.font);
+            plate.transform.localRotation = Quaternion.Euler(0, 180, 0);
+            engine = WorldDrawing.Sound(gameObject, true); argument = WorldDrawing.Sound(gameObject, true, 35);
+        }
+        public void Apply(CrewView view)
+        {
+            if (machine == null || !string.Equals(MachinePlate, view.machinePlate, StringComparison.OrdinalIgnoreCase))
+            {
+                var item = assets.Machine(Id, view.machinePlate);
+                if (item == null) throw new InvalidOperationException("No imported machine for " + Id + "/" + view.machinePlate);
+                WorldDrawing.Remove(machine); machine = Instantiate(item.prefab, transform); machine.name = "Machine";
+                InspectTarget.Attach(machine, "machine"); machineAnimators = machine.GetComponentsInChildren<Animator>();
+                foreach (var animator in machineAnimators) animator.applyRootMotion = false;
+                MachinePlate = view.machinePlate; plate.text = item.label;
+            }
+            var next = new Vector3((float)view.stationFt * WorldUnits.MetresPerFoot, 0, 0);
+            if (view.status == "demobilized") next += new Vector3(-WorldUnits.DemobBackMetres, 0, WorldUnits.RoadZ);
+            if (!positioned || Math.Abs(view.stationFt - StationFt) > WorldUnits.StationFeet)
+            { transform.localPosition = next; movementVelocity = Vector3.zero; positioned = true; }
+            target = next;
+            StationFt = view.stationFt; MoodLevel = Mathf.Clamp((int)view.moodLevel, 0, 3);
+            if (Status != view.status)
+            {
+                Status = view.status; statusTime = 0; Debug.Log(name + " " + Status, this);
+                var working = Status == "working";
+                foreach (var animator in machineAnimators) animator.speed = working ? 1 : 0;
+                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>())
+                    if (working && Application.isPlaying) effect.Play(); else effect.Stop(true, ParticleSystemStopBehavior.StopEmitting);
+                WorldDrawing.Loop(engine, working ? (Id == "exc" ? assets.excavation : Id == "back" ? assets.dozer : assets.idle) : Status == "demobilized" ? null : assets.idle);
+                WorldDrawing.Loop(argument, Status == "arguing" ? assets.conflict : null);
+            }
+            ApplyAnimations();
+        }
+        public void FaceArgument(Transform other)
+        {
+            partner = other;
+            SetWorkerTargets();
+        }
+        private void SetWorkerTargets()
+        {
+            for (var i = 0; i < workers.Length; i++)
+            {
+                // WO-08: workers stand 2 metres behind the working edge on the road side.
+                var goal = transform.parent.TransformPoint(target + new Vector3(-2, 0, 2 + i));
+                if (i == 0 && Status == "arguing" && partner != null)
+                {
+                    var other = partner.GetComponent<CrewRig>();
+                    var midpoint = (target + other.target) / 2;
+                    var side = string.CompareOrdinal(Id, other.Id) < 0 ? -1 : 1;
+                    goal = transform.parent.TransformPoint(midpoint + new Vector3(side * 0.65f, 0, 3));
+                }
+                workerTargets[i] = goal;
+            }
+        }
+        private void Update()
+        {
+            if (!positioned) return;
+            statusTime += Time.deltaTime;
+            // A continuous target must not restart a tween on every frame. Four damping periods
+            // settle a state change within the WO's half-second presentation interval.
+            transform.localPosition = Vector3.SmoothDamp(transform.localPosition, target, ref movementVelocity, WorldUnits.PoseSeconds / 4);
+            SetWorkerTargets();
+            for (var i = 0; i < workers.Length; i++)
+            {
+                workers[i].position = Vector3.SmoothDamp(workers[i].position, workerTargets[i], ref workerVelocities[i], WorldUnits.PoseSeconds / 4);
+                var facing = Status == "held" ? transform.parent.forward : transform.parent.right;
+                if (i == 0 && Status == "arguing" && partner != null)
+                    facing = partner.GetComponent<CrewRig>().Foreman.position - workers[i].position;
+                facing.y = 0;
+                if (facing.sqrMagnitude > 0.001f) workers[i].rotation = Quaternion.LookRotation(facing);
+            }
+            ApplyAnimations();
+        }
+        private bool ClipFinished(int index) => animators[index] == null || !animators[index].isActiveAndEnabled
+            || animators[index].GetCurrentAnimatorStateInfo(0).normalizedTime >= 1;
+        private void ApplyAnimations()
+        {
+            for (var i = 0; i < workers.Length; i++)
+            {
+                var clip = MoodClips[MoodLevel];
+                if (Status == "working") clip = ((int)(statusTime / WorkingAlternateSeconds) + i) % 2 == 0 ? "Walk" : "Inspect";
+                else if (Status == "held" && MoodLevel == 0) clip = "IdleAlternate";
+                else if (Status == "stopped" && (statusTime == 0 || clips[i] == "SignalHalt" && !ClipFinished(i))) clip = "SignalHalt";
+                else if (Status == "arguing") clip = i == 0 && string.CompareOrdinal(Id, partner == null ? "" : partner.GetComponent<CrewRig>().Id) < 0 ? "ConflictTalk" : "TalkAlternate";
+                else if (Status == "demobilized") clip = "Shelter";
+                else if (MoodLevel == 3 && statusTime >= PointPeriodSeconds && statusTime % PointPeriodSeconds < 1) clip = "SignalPoint";
+                if (clips[i] != clip)
+                {
+                    clips[i] = clip;
+                    if (animators[i] != null && animators[i].runtimeAnimatorController != null && animators[i].HasState(0, Animator.StringToHash(clip)))
+                        animators[i].Play(clip, 0, 0);
+                }
+                if (animators[i] != null) animators[i].speed = clip == MoodClips[MoodLevel] ? MoodSpeeds[MoodLevel] : 1;
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/DesktopPreview.cs b/Assets/LOBOver/Runtime/World/DesktopPreview.cs
new file mode 100644
index 0000000000000000000000000000000000000000..50d341382f914f44b12e118a8f09ba49d478f36c
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/DesktopPreview.cs
@@ -0,0 +1,173 @@
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using LOBOver.Runtime;
+using LOBOver.Sim;
+using Newtonsoft.Json.Linq;
+using UnityEngine;
+using UnityEngine.InputSystem;
+using UnityEngine.Networking;
+
+namespace LOBOver.World
+{
+    public sealed class DesktopPreview : MonoBehaviour
+    {
+        public Director director;
+        public SiteWorld world;
+        public Camera previewCamera;
+        public string LastInspection { get; private set; } = "";
+        public string LastCard { get; private set; } = "";
+        private string voiceText = "";
+        private float voiceUntil;
+        private double lastTruckStation;
+        private bool lastDismounted, hasTruck;
+        private readonly Queue<string> voiceQueue = new Queue<string>();
+        private Coroutine voiceRoutine;
+        private AudioSource voiceSource;
+        private GUIStyle hud;
+        // Preview-only camera controls, independent of the simulation clock.
+        private const float FlyMetresPerSecond = 12, FastMultiplier = 4, LookDegreesPerPixel = 0.12f;
+
+        private void OnEnable()
+        {
+#if UNITY_ANDROID && !UNITY_EDITOR
+            gameObject.SetActive(false);
+            return;
+#else
+            if (director == null) return;
+            director.Message += OnMessage; director.Voice += OnVoice; director.Loaded += Clear;
+            if (voiceSource == null) voiceSource = WorldDrawing.Sound(WorldDrawing.Group("VoiceAudio", transform), false);
+#endif
+        }
+        private void OnDisable()
+        {
+            if (director != null) { director.Message -= OnMessage; director.Voice -= OnVoice; director.Loaded -= Clear; }
+            Clear(); Cursor.lockState = CursorLockMode.None; Cursor.visible = true;
+        }
+        private void Clear()
+        {
+            LastInspection = ""; LastCard = ""; voiceText = ""; hasTruck = false; voiceQueue.Clear();
+            if (voiceRoutine != null) StopCoroutine(voiceRoutine);
+            voiceRoutine = null;
+            if (voiceSource != null) { voiceSource.Stop(); if (voiceSource.clip != null) Destroy(voiceSource.clip); voiceSource.clip = null; }
+        }
+        private void Update()
+        {
+            var keyboard = Keyboard.current; var mouse = Mouse.current;
+            if (keyboard == null || mouse == null) return;
+            var flying = mouse.rightButton.isPressed;
+            Cursor.lockState = flying ? CursorLockMode.Locked : CursorLockMode.None; Cursor.visible = !flying;
+            if (flying)
+            {
+                var delta = mouse.delta.ReadValue() * LookDegreesPerPixel;
+                var angles = previewCamera.transform.eulerAngles;
+                var pitch = angles.x > 180 ? angles.x - 360 : angles.x;
+                previewCamera.transform.rotation = Quaternion.Euler(Mathf.Clamp(pitch - delta.y, -85, 85), angles.y + delta.x, 0);
+                var move = new Vector3((keyboard.dKey.isPressed ? 1 : 0) - (keyboard.aKey.isPressed ? 1 : 0), 0,
+                    (keyboard.wKey.isPressed ? 1 : 0) - (keyboard.sKey.isPressed ? 1 : 0));
+                previewCamera.transform.Translate(move * FlyMetresPerSecond * (keyboard.leftShiftKey.isPressed || keyboard.rightShiftKey.isPressed ? FastMultiplier : 1) * Time.unscaledDeltaTime);
+            }
+            if (!director.Ready) return;
+            if (keyboard.spaceKey.wasPressedThisFrame) { if (director.Speed == "paused") director.Start(); else director.Pause(); }
+            if (keyboard.rKey.wasPressedThisFrame) director.Reset();
+            var view = director.SiteView;
+            if (view == null) return;
+            FollowTruck(view.truck);
+            // RMB scopes WASD to flight so D/S cannot also issue Site commands.
+            if (!flying)
+            {
+                if (keyboard.dKey.wasPressedThisFrame) Send(view.truck.dismounted ? "mount" : "dismount");
+                if (keyboard.sKey.wasPressedThisFrame) director.Send(new JObject { ["action"] = "stopWork", ["zone"] = world.ZoneAt(view.truck.stationFt) });
+            }
+            var digits = new[] { Key.Digit1, Key.Digit2, Key.Digit3, Key.Digit4, Key.Digit5, Key.Digit6, Key.Digit7, Key.Digit8, Key.Digit9 };
+            for (var i = 0; i < digits.Length; i++) if (keyboard[digits[i]].wasPressedThisFrame) Ride((i + 1) * WorldUnits.StationFeet);
+            if (keyboard.leftBracketKey.wasPressedThisFrame) Ride((Mathf.Round((float)view.truck.stationFt / WorldUnits.StationFeet) - 1) * WorldUnits.StationFeet);
+            if (keyboard.rightBracketKey.wasPressedThisFrame) Ride((Mathf.Round((float)view.truck.stationFt / WorldUnits.StationFeet) + 1) * WorldUnits.StationFeet);
+            if (keyboard.iKey.wasPressedThisFrame) Inspect();
+            if (keyboard.fKey.wasPressedThisFrame) director.Send(new JObject { ["action"] = "flag", ["stationFt"] = view.truck.stationFt, ["note"] = "" });
+            if (keyboard.cKey.wasPressedThisFrame) Confirm("done");
+            if (keyboard.nKey.wasPressedThisFrame) Confirm("notDone");
+            if (keyboard.lKey.wasPressedThisFrame) Send("listen");
+        }
+        private void FollowTruck(TruckView truck)
+        {
+            if (truck.moving) return;
+            if (hasTruck && (truck.stationFt != lastTruckStation || truck.dismounted != lastDismounted))
+            {
+                previewCamera.transform.position = world.transform.TransformPoint(new Vector3((float)truck.stationFt * WorldUnits.MetresPerFoot, 1.7f,
+                    truck.dismounted ? WorldUnits.TrenchWidth / 2 + 1.5f : WorldUnits.RoadZ));
+                previewCamera.transform.rotation = world.transform.rotation * Quaternion.Euler(12, 180, 0);
+            }
+            lastTruckStation = truck.stationFt; lastDismounted = truck.dismounted; hasTruck = true;
+        }
+        private void Ride(float station) => director.Send(new JObject { ["action"] = "moveTo", ["stationFt"] = Mathf.Clamp(station, 0, (float)world.LengthFt) });
+        private void Send(string action) => director.Send(new JObject { ["action"] = action });
+        private void Confirm(string outcome)
+        {
+            var order = director.SiteView.orders.FirstOrDefault();
+            if (order == null) { LastInspection = "no order landed here"; return; }
+            director.Send(new JObject { ["action"] = "confirm", ["orderId"] = order.id, ["outcome"] = outcome });
+        }
+        private void Inspect()
+        {
+            if (!Physics.Raycast(previewCamera.ViewportPointToRay(new Vector3(0.5f, 0.5f, 0)), out var hit, 6000, ~0, QueryTriggerInteraction.Collide)) return;
+            var target = hit.collider.GetComponentInParent<InspectTarget>();
+            if (target != null) director.Send(new JObject { ["action"] = "inspect", ["target"] = target.target });
+        }
+        private void OnMessage(JObject message)
+        {
+            var type = (string)message["t"];
+            if (type == "nack") LastInspection = (string)message["reason"];
+            if (!Director.ForSeat(message, "site")) return;
+            if (type == "inspection") LastInspection = (string)message["text"];
+            if (type == "event") LastCard = (string)message["card"]?["title"] + "\n" + string.Join("\n", message["card"]?["facts"]?.Values<string>() ?? Enumerable.Empty<string>());
+        }
+        private void OnVoice(JObject message)
+        {
+            if (!Director.ForSeat(message, "site")) return;
+            foreach (var id in message["lineIds"].Values<string>()) voiceQueue.Enqueue(id);
+            if (voiceRoutine == null) voiceRoutine = StartCoroutine(PlayVoice());
+        }
+        private IEnumerator PlayVoice()
+        {
+            while (voiceQueue.Count > 0)
+            {
+                var id = voiceQueue.Dequeue(); var line = director.Lines.OfType<JObject>().FirstOrDefault(item => (string)item["id"] == id);
+                if (line == null) continue;
+                var speaker = (string)line["speaker"];
+                var crew = speaker.StartsWith("foreman_") ? world.Crew(speaker.Substring("foreman_".Length)) : null;
+                voiceSource.transform.position = crew == null ? previewCamera.transform.position : crew.transform.position;
+                voiceSource.spatialBlend = crew == null ? 0 : 1;
+                voiceText = (string)line["text"]; voiceUntil = Time.unscaledTime + 8;
+                var relative = "Voice/" + director.scenarioId + "/" + id + ".wav";
+#if !UNITY_ANDROID || UNITY_EDITOR
+                if (!File.Exists(Path.Combine(Application.streamingAssetsPath, relative))) continue;
+#endif
+                using (var request = UnityWebRequestMultimedia.GetAudioClip(StreamingData.Url(relative), AudioType.WAV))
+                {
+                    yield return request.SendWebRequest();
+                    if (request.result != UnityWebRequest.Result.Success) continue;
+                    var clip = DownloadHandlerAudioClip.GetContent(request); voiceSource.clip = clip; voiceSource.Play();
+                    voiceUntil = Time.unscaledTime + Mathf.Max(8, clip.length);
+                    while (voiceSource.isPlaying) yield return null;
+                    voiceSource.clip = null; Destroy(clip);
+                }
+            }
+            voiceRoutine = null;
+        }
+        private void OnGUI()
+        {
+            if (hud == null) hud = new GUIStyle(GUI.skin.box) { alignment = TextAnchor.UpperLeft, fontSize = 16, wordWrap = true, padding = new RectOffset(12, 12, 10, 10) };
+            var truck = director.SiteView?.truck;
+            var text = director.LoadError ?? (director.Ready ? "Day " + director.DisplayDay + "  ·  " + director.Speed + "\nTruck " + WorldUnits.Station(truck.stationFt)
+                + (truck.moving ? " driving" : truck.dismounted ? " dismounted" : " mounted") : "Loading site");
+            text += "\n" + LastInspection + "\n" + LastCard;
+            if (Time.unscaledTime < voiceUntil) text += "\n" + voiceText;
+            text += "\nRMB + WASD fly · Shift fast · 1–9 / [ ] ride\nD mount/dismount · I inspect · F flag · S stop\nC confirm · N not carried out · L listen · Space pause · R reset";
+            var width = Mathf.Min(520, Screen.width - 20);
+            GUI.Box(new Rect(10, 10, width, hud.CalcHeight(new GUIContent(text), width)), text, hud);
+            GUI.Label(new Rect(Screen.width / 2f - 6, Screen.height / 2f - 10, 20, 20), "+");
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/InspectTarget.cs b/Assets/LOBOver/Runtime/World/InspectTarget.cs
