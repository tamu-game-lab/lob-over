diff --git a/Assets/LOBOver/Runtime/World/PlanPanel.cs b/Assets/LOBOver/Runtime/World/PlanPanel.cs
new file mode 100644
index 0000000000000000000000000000000000000000..887a29e6163ea2dea1e3a686fd37897befa6edb2
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/PlanPanel.cs
@@ -0,0 +1,104 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using LOBOver.Sim;
+using Newtonsoft.Json.Linq;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    // Showcase only. During the study, the Plan seat uses the web page, away from the Site seat.
+    public sealed class PlanPanel : MonoBehaviour
+    {
+        private Chart chart;
+        private Transform drawing;
+        private readonly Dictionary<string, LineRenderer> planned = new Dictionary<string, LineRenderer>();
+        private readonly Dictionary<string, LineRenderer> reported = new Dictionary<string, LineRenderer>();
+        private TextMeshPro budget, inbox, radio, responses, keypad, result;
+        private LineRenderer promise, deadlineRule;
+        private double length, deadline;
+        private static readonly CultureInfo Format = CultureInfo.InvariantCulture;
+        public void Configure(WorldAssets assets, double lengthFt, double deadlineDay)
+        {
+            if (drawing != null) WorldDrawing.Remove(drawing.gameObject);
+            drawing = WorldDrawing.Group("PlanPlot", transform).transform;
+            planned.Clear(); reported.Clear(); length = lengthFt; deadline = deadlineDay;
+            chart = new Chart(drawing, assets, length, deadline, new Rect(-1.32f, -0.45f, 1.55f, 0.9f));
+            chart.Label("Title", "PLAN   exc / pipe / back   ·   thin: planned   thick: reported", new Vector2(0, 0.66f), new Vector2(2.8f, 0.13f), 0.06f);
+            budget = chart.Label("Budget", "", new Vector2(0, 0.53f), new Vector2(2.8f, 0.13f), 0.06f);
+            inbox = chart.Label("Inbox", "", new Vector2(0.88f, 0.32f), new Vector2(1.05f, 0.32f), 0.045f);
+            radio = chart.Label("Radio", "", new Vector2(0.88f, -0.02f), new Vector2(1.05f, 0.28f), 0.042f);
+            responses = chart.Label("Respond", "", new Vector2(0.88f, -0.3f), new Vector2(1.05f, 0.25f), 0.042f);
+            keypad = chart.Label("Keypad", "", new Vector2(0, -0.61f), new Vector2(2.8f, 0.14f), 0.045f);
+            result = chart.Label("Result", "", new Vector2(-0.55f, -0.2f), new Vector2(1.4f, 0.4f), 0.055f);
+            foreach (var text in new[] { inbox, radio, responses, keypad })
+            { text.enableAutoSizing = true; text.fontSizeMin = 2; text.fontSizeMax = text.fontSize; text.overflowMode = TextOverflowModes.Truncate; }
+            promise = chart.Rule("Promise", 1, true, Color.gray); deadlineRule = chart.Rule("Deadline", deadline, true, Color.white);
+            for (var i = 0; i < WorldUnits.CrewIds.Length; i++)
+            {
+                var id = WorldUnits.CrewIds[i];
+                planned[id] = WorldDrawing.Line("Planned_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.004f);
+                reported[id] = WorldDrawing.Line("Reported_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.01f);
+            }
+        }
+        public void Apply(PlanView view, double time)
+        {
+            if (chart == null) return;
+            var b = view.budget;
+            budget.text = string.Format(Format, "${0:N0} spent   ${1:N0} committed   ${2:N0} budget   |   promise {3}   deadline {4}", b.spentUsd, b.committedUsd, b.budgetUsd, b.promisedDay, b.deadlineDay);
+            promise.SetPositions(new[] { chart.Point(0, b.promisedDay), chart.Point(length, b.promisedDay) });
+            deadlineRule.SetPositions(new[] { chart.Point(0, b.deadlineDay), chart.Point(length, b.deadlineDay) });
+            foreach (var id in WorldUnits.CrewIds)
+            {
+                var projection = Project(view.plannedLines[id], length, Math.Max(time, deadline - 1));
+                planned[id].positionCount = projection.Count;
+                planned[id].SetPositions(projection.Select(p => chart.Point(p.ft, Math.Min(deadline, p.t + 1))).ToArray());
+                var steps = new List<Vector3>(); PointView previous = null;
+                foreach (var point in view.reportedLines[id])
+                {
+                    if (previous != null) steps.Add(chart.Point(previous.ft, point.t + 1));
+                    steps.Add(chart.Point(point.ft, point.t + 1)); previous = point;
+                }
+                reported[id].positionCount = steps.Count; reported[id].SetPositions(steps.ToArray());
+            }
+            inbox.text = "INBOX\n" + string.Join("\n", view.inbox.Skip(Math.Max(0, view.inbox.Count - 3)).Select(item =>
+                "Day " + item.day.ToString("0.##", Format) + " " + item.subject + ": " + (item.body ?? string.Join("; ", item.notes ?? new List<string>()))));
+            radio.text = "RADIO\n" + string.Join("\n", view.radioLog.Select(item => item.id + " " + item.crew + " " + (string)item.op?["op"] + " · " + item.status));
+            responses.text = "RESPOND\n" + string.Join("\n", view.responses.Select(item => item.label + " " + item.cost?.usd + " " + item.cost?.perDayUsd));
+            keypad.text = "KEYPAD   " + string.Join("   ", view.permits.Select(item => "ZONE " + item.zone + " permit: " + (item.entered ? item.number : "—")))
+                + "\n" + string.Join("   ", view.inspections.Select(item => "ZONE " + item.zone + " inspection: " + (item.cleared ? "entered" : "—")));
+        }
+        public void ShowResult(JObject value)
+        {
+            // Numerical outcome facts only; the Site board never receives the result or budget.
+            result.text = "Finish day: " + (value["finishDay"]?.ToString() ?? "—") + "\nSpent: $" + ((double?)value["spentUsd"] ?? 0).ToString("N0", Format)
+                + "\nIdle crew-days: " + ((double?)value["idleCrewDays"] ?? 0).ToString("0.0", Format)
+                + "\nPeak open trench: " + ((double?)value["peakOpenTrenchFt"] ?? 0).ToString("0", Format) + " ft";
+        }
+
+        // Mirrors Planning.PlannedPolylines using PlanView only, including holds and loans.
+        public static List<PointView> Project(PlannedLineView line, double length, double horizon)
+        {
+            var holds = line.holds ?? new List<HoldView>(); var loans = line.loans ?? new List<LoanView>();
+            var segments = line.segments ?? new List<SegmentView>(); var start = line.startDay - 1;
+            var breaks = new List<double> { start, horizon };
+            breaks.AddRange(segments.Select(s => s.fromT));
+            foreach (var hold in holds) { breaks.Add(hold.fromT); if (hold.untilT.HasValue) breaks.Add(hold.untilT.Value); }
+            foreach (var loan in loans) { breaks.Add(loan.fromT); breaks.Add(loan.untilT); }
+            double time = start, feet = 0;
+            var points = new List<PointView> { new PointView { t = start, ft = 0 } };
+            foreach (var next in breaks.Distinct().Where(t => t > start && t <= horizon).OrderBy(t => t))
+            {
+                var segment = segments.OrderBy(s => s.fromT).LastOrDefault(s => s.fromT <= time);
+                var rate = holds.Any(h => time >= h.fromT && (!h.untilT.HasValue || time < h.untilT)) ? 0
+                    : (segment == null ? line.rate : segment.rate) + loans.Where(l => time >= l.fromT && time < l.untilT).Sum(l => l.rate);
+                if (rate > 0 && feet + (next - time) * rate >= length)
+                { points.Add(new PointView { t = time + (length - feet) / rate, ft = length }); break; }
+                feet += (next - time) * rate; time = next; points.Add(new PointView { t = time, ft = feet });
+            }
+            return points;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/SiteSky.cs b/Assets/LOBOver/Runtime/World/SiteSky.cs
new file mode 100644
index 0000000000000000000000000000000000000000..190d902aed6448a4c8e6d131fcd90b1d70ca10b2
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/SiteSky.cs
@@ -0,0 +1,49 @@
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class SiteSky : MonoBehaviour
+    {
+        public ParticleSystem rain;
+        public Transform cloudBank;
+        public Transform observer;
+        public string State { get; private set; }
+        public bool Raining => rain.gameObject.activeSelf;
+        private WorldAssets assets;
+        private AudioSource bed;
+        private bool originalFog;
+        private Color originalFogColour;
+        private float originalFogDensity;
+        public void Configure(WorldAssets source)
+        {
+            assets = source;
+            if (bed == null) { bed = WorldDrawing.Sound(gameObject, true); bed.spatialBlend = 0; }
+            originalFog = RenderSettings.fog; originalFogColour = RenderSettings.fogColor; originalFogDensity = RenderSettings.fogDensity;
+            State = null; Apply("clear");
+        }
+        public void Apply(string state)
+        {
+            if (State == state) return;
+            State = state; var raining = state == "rain";
+            cloudBank.gameObject.SetActive(state == "towersSouth" || raining);
+            rain.gameObject.SetActive(raining);
+            if (raining && Application.isPlaying) rain.Play();
+            RenderSettings.fog = raining || originalFog;
+            RenderSettings.fogColor = raining ? new Color(0.48f, 0.5f, 0.52f) : originalFogColour;
+            RenderSettings.fogDensity = raining ? 0.006f : originalFogDensity;
+            WorldDrawing.Loop(bed, raining ? assets.rainfall : state == "towersSouth" ? assets.wind : null);
+        }
+        private void LateUpdate()
+        {
+            if (observer == null) return;
+            rain.transform.position = observer.position + Vector3.up * 12;
+            // WO-08: a cumulus billboard bank 2 km south of the site.
+            cloudBank.forward = (cloudBank.position - observer.position).normalized;
+        }
+        private void OnDestroy()
+        {
+            if (assets == null) return;
+            RenderSettings.fog = originalFog; RenderSettings.fogColor = originalFogColour; RenderSettings.fogDensity = originalFogDensity;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/SiteWorld.cs b/Assets/LOBOver/Runtime/World/SiteWorld.cs
new file mode 100644
index 0000000000000000000000000000000000000000..f390e2f3234ff421e637305c8b673b815191452b
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/SiteWorld.cs
@@ -0,0 +1,111 @@
+using System.Collections.Generic;
+using System.Linq;
+using LOBOver.Runtime;
+using LOBOver.Sim;
+using Newtonsoft.Json.Linq;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class SiteWorld : MonoBehaviour
+    {
+        public Director director;
+        public WorldAssets assets;
+        public TrailerBoard trailerBoard;
+        public PlanPanel planPanel;
+        public JobSign jobSign;
+        public SiteSky sky;
+        public TextMeshPro gateText;
+        public Transform truck;
+        public SiteView CurrentView { get; private set; }
+        public int CellCount => cells.Count;
+        public int BoardCount => boards.Count;
+        public int CrewCount => crews.Count;
+        public double LengthFt { get; private set; }
+        private readonly Dictionary<int, StationCell> cells = new Dictionary<int, StationCell>();
+        private readonly Dictionary<int, Transform> stakes = new Dictionary<int, Transform>();
+        private readonly Dictionary<int, ZoneBoard> boards = new Dictionary<int, ZoneBoard>();
+        private readonly Dictionary<string, CrewRig> crews = new Dictionary<string, CrewRig>();
+        private JArray zones;
+        private Transform generated;
+        public StationCell CellAt(int feet) => cells.TryGetValue(Mathf.FloorToInt(feet / WorldUnits.StationFeet) * (int)WorldUnits.StationFeet, out var cell) ? cell : null;
+        public CrewRig Crew(string id) => crews.TryGetValue(id, out var crew) ? crew : null;
+        public Transform StakeAt(int feet) => stakes.TryGetValue(feet, out var stake) ? stake : null;
+        public ZoneBoard Board(int zone) => boards.TryGetValue(zone, out var board) ? board : null;
+        public int ZoneAt(double feet) => (int)zones.OfType<JObject>().First(z => feet >= (double)z["fromFt"] && (feet < (double)z["toFt"] || feet == LengthFt))["id"];
+
+        private void OnEnable()
+        {
+            if (director == null) return;
+            director.Loaded += OnLoaded; director.ViewsChanged += OnViews; director.Result += OnResult;
+            if (director.Ready) { OnLoaded(); if (director.SiteView != null) OnViews(director.SiteView, director.PlanView); }
+        }
+        private void OnDisable()
+        {
+            if (director == null) return;
+            director.Loaded -= OnLoaded; director.ViewsChanged -= OnViews; director.Result -= OnResult;
+        }
+        private void OnLoaded() => Configure(director.Job, director.DeadlineDay);
+        private void OnViews(SiteView site, PlanView plan)
+        {
+            Apply(site, director.DisplayDay); planPanel.Apply(plan, director.TimeDays);
+        }
+        private void OnResult(JObject value) => planPanel.ShowResult(value);
+        public void Configure(JObject job, double deadline)
+        {
+            if (generated != null) WorldDrawing.Remove(generated.gameObject);
+            generated = WorldDrawing.Group("GeneratedSite", transform).transform;
+            cells.Clear(); stakes.Clear(); boards.Clear(); crews.Clear(); CurrentView = null;
+            LengthFt = (double)job["lengthFt"]; zones = (JArray)job["zones"].DeepClone();
+            jobSign.Apply((JObject)job["sign"]);
+            var boundaries = zones.OfType<JObject>().ToDictionary(z => (int)z["id"], z => (double)z["fromFt"]);
+            trailerBoard.Configure(assets, LengthFt, deadline, boundaries); planPanel.Configure(assets, LengthFt, deadline);
+            if (sky.State != null) sky.Apply("clear"); else sky.Configure(assets);
+        }
+        public void Apply(SiteView view, int displayDay)
+        {
+            if (generated == null) throw new System.InvalidOperationException("Configure SiteWorld before applying a view");
+            if (cells.Count == 0) Build(view);
+            CurrentView = view;
+            foreach (var cell in view.trench) if (cells.TryGetValue((int)cell.stationFt, out var target)) target.Apply(cell);
+            foreach (var crew in view.crews) crews[crew.id].Apply(crew);
+            var arguing = WorldUnits.CrewIds.Select(id => crews[id]).Where(crew => crew.Status == "arguing").ToArray();
+            foreach (var crew in crews.Values) crew.FaceArgument(arguing.FirstOrDefault(other => other != crew && crew.Status == "arguing")?.transform);
+            foreach (var board in view.boards) boards[(int)board.zone].Apply(board);
+            sky.Apply(view.sky); gateText.text = "Trucks waiting: " + view.gate.trucksWaiting;
+            truck.localPosition = new Vector3((float)view.truck.stationFt * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
+            trailerBoard.Apply(view, displayDay);
+        }
+        private void Build(SiteView view)
+        {
+            foreach (var sample in view.trench)
+            {
+                // The endpoint is a stake, not an extra 100 ft of trench.
+                if (sample.stationFt >= LengthFt) continue;
+                var cell = Instantiate(assets.cellPrefab, generated); cell.Initialize(sample.stationFt, assets);
+                cells[(int)sample.stationFt] = cell; stakes[(int)sample.stationFt] = cell.stake;
+                var spoil = Instantiate(assets.spoil, generated); spoil.name = "Spoil_" + (int)sample.stationFt;
+                spoil.transform.localPosition = new Vector3((float)sample.stationFt * WorldUnits.MetresPerFoot + WorldUnits.CellLength / 2, 0, -3);
+            }
+            var endpoint = WorldDrawing.Box("Stake_" + (int)LengthFt, generated, new Vector3((float)LengthFt * WorldUnits.MetresPerFoot, 0.55f, 1.2f), new Vector3(0.08f, 1.1f, 0.08f), assets.timber);
+            var label = WorldDrawing.Text("Station", endpoint.transform, new Vector3(0, 0.6f, 0), new Vector2(1.5f, 0.4f), 0.3f, assets.font);
+            // Text cannot inherit the thin post's scale.
+            label.transform.SetParent(generated, true); label.transform.localScale = Vector3.one;
+            label.transform.localPosition = endpoint.transform.localPosition + Vector3.up * 0.6f; label.transform.localRotation = Quaternion.Euler(0, 180, 0);
+            label.text = WorldUnits.Station(LengthFt); stakes[(int)LengthFt] = endpoint.transform;
+            foreach (var zone in zones.OfType<JObject>())
+            {
+                var root = WorldDrawing.Group("ZoneBoard", generated); root.transform.localPosition = new Vector3((float)zone["fromFt"] * WorldUnits.MetresPerFoot, 0, 1.8f);
+                root.transform.localRotation = Quaternion.Euler(0, 180, 0);
+                WorldDrawing.Box("Post", root.transform, new Vector3(0, 1, 0), new Vector3(0.1f, 2, 0.1f), assets.timber);
+                var face = WorldDrawing.Box("Board", root.transform, new Vector3(0, 1.8f, 0), new Vector3(1, 1.5f, 0.06f), assets.steel);
+                InspectTarget.Attach(face, "board"); var board = root.AddComponent<ZoneBoard>();
+                board.label = WorldDrawing.Text("Permit", root.transform, new Vector3(0, 1.8f, -0.05f), new Vector2(0.9f, 1.3f), 0.12f, assets.font);
+                board.Initialize((int)zone["id"]); boards[board.Zone] = board;
+            }
+            foreach (var id in WorldUnits.CrewIds)
+            { var crew = Instantiate(assets.crewPrefab, generated); crew.Initialize(id, assets); crews[id] = crew; }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/StationCell.cs b/Assets/LOBOver/Runtime/World/StationCell.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b7e4442922753ba6c2d9e1f9afde7d4c5c29d43b
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/StationCell.cs
@@ -0,0 +1,49 @@
+using LOBOver.Sim;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class StationCell : MonoBehaviour
+    {
+        public GameObject surface, floor, walls, pipes, wetBand, water, slump, box, shoring;
+        public Transform nearWall, farWall, stake;
+        public TextMeshPro stationText;
+        public Material openMaterial, pipeMaterial, backfillMaterial, surfaceMaterial;
+        public string State { get; private set; }
+        public string Water { get; private set; }
+        public string Wall { get; private set; }
+        public string Protection { get; private set; }
+        public double StationFt { get; private set; }
+        private AudioSource sound;
+        private WorldAssets assets;
+        private string lastKey;
+
+        public void Initialize(double feet, WorldAssets source)
+        {
+            StationFt = feet; assets = source; name = "Cell_" + WorldUnits.Station(feet);
+            transform.localPosition = new Vector3((float)feet * WorldUnits.MetresPerFoot, 0, 0);
+            stationText.text = WorldUnits.Station(feet); sound = WorldDrawing.Sound(gameObject, false);
+        }
+        public void Apply(TrenchView view)
+        {
+            var key = view.state + "/" + view.wall + "/" + view.water + "/" + view.protection + "/" + view.pipeDamage;
+            if (key == lastKey) return;
+            if (lastKey != null && Application.isPlaying)
+            {
+                if (view.wall == "slumped" && Wall != "slumped") sound.PlayOneShot(assets.collapse);
+                if (view.state == "piped" && State != "piped") sound.PlayOneShot(assets.pipeSetdown);
+            }
+            State = view.state; Water = view.water; Wall = view.wall; Protection = view.protection; lastKey = key;
+            var dug = State == "open" || State == "piped";
+            surface.SetActive(!dug); floor.SetActive(dug); walls.SetActive(dug); pipes.SetActive(State == "piped");
+            surface.GetComponent<Renderer>().sharedMaterial = State == "backfilled" ? backfillMaterial : surfaceMaterial;
+            floor.GetComponent<Renderer>().sharedMaterial = State == "piped" ? pipeMaterial : openMaterial;
+            wetBand.SetActive(dug && Water == "seep"); water.SetActive(dug && (Water == "standing" || Wall == "slumped"));
+            slump.SetActive(dug && Wall == "slumped"); box.SetActive(dug && Protection == "box"); shoring.SetActive(dug && Protection == "shoring");
+            nearWall.localRotation = Quaternion.Euler(Protection == "slope" ? 30 : 0, 0, 0);
+            farWall.localRotation = Quaternion.Euler(Protection == "slope" ? -30 : 0, 0, 0);
+            Debug.Log(name + " " + key, this);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/TrailerBoard.cs b/Assets/LOBOver/Runtime/World/TrailerBoard.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e22c6ae9dc9801da842c4b33851cbb0b99634aa8
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/TrailerBoard.cs
@@ -0,0 +1,76 @@
+using System.Collections.Generic;
+using LOBOver.Sim;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class TrailerBoard : MonoBehaviour
+    {
+        private readonly Dictionary<string, List<Vector3>> points = new Dictionary<string, List<Vector3>>();
+        private readonly Dictionary<string, LineRenderer> lines = new Dictionary<string, LineRenderer>();
+        private readonly Dictionary<int, LineRenderer> permits = new Dictionary<int, LineRenderer>();
+        private int lastDay = -1;
+        private Chart chart;
+        private Transform drawing;
+        public int LineCount => lines.Count;
+        public int PointCount(string crew) => points[crew].Count;
+
+        public void Configure(WorldAssets assets, double lengthFt, double deadline, Dictionary<int, double> boundaries)
+        {
+            if (drawing != null) WorldDrawing.Remove(drawing.gameObject);
+            drawing = WorldDrawing.Group("SitePlot", transform).transform;
+            points.Clear(); lines.Clear(); permits.Clear(); lastDay = -1;
+            chart = new Chart(drawing, assets, lengthFt, deadline, new Rect(-0.82f, -0.36f, 1.65f, 0.65f));
+            chart.Label("Title", "SITE  ·  actual feet / day", new Vector2(0, 0.42f), new Vector2(1.8f, 0.15f), 0.08f);
+            for (var i = 0; i < WorldUnits.CrewIds.Length; i++)
+            {
+                var id = WorldUnits.CrewIds[i]; points[id] = new List<Vector3>();
+                lines[id] = WorldDrawing.Line("Actual_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.009f);
+            }
+            foreach (var item in boundaries)
+                permits[item.Key] = chart.Rule("UnpostedZone_" + item.Key, item.Value, false, Color.gray);
+        }
+        public void Apply(SiteView view, int displayDay)
+        {
+            foreach (var board in view.boards) if (permits.TryGetValue((int)board.zone, out var rule)) rule.gameObject.SetActive(board.permitNumber == null);
+            if (displayDay == lastDay) return;
+            foreach (var crew in view.crews)
+            {
+                points[crew.id].Add(chart.Point(crew.stationFt, displayDay));
+                lines[crew.id].positionCount = points[crew.id].Count;
+                lines[crew.id].SetPositions(points[crew.id].ToArray());
+            }
+            lastDay = displayDay;
+        }
+    }
+
+    internal sealed class Chart
+    {
+        private readonly Transform root;
+        private readonly WorldAssets assets;
+        private readonly double length, deadline;
+        private readonly Rect area;
+        public Chart(Transform root, WorldAssets assets, double length, double deadline, Rect area)
+        {
+            this.root = root; this.assets = assets; this.length = length; this.deadline = deadline; this.area = area;
+            var axes = WorldDrawing.Line("Axes", root, assets.ink, Color.white, 0.005f);
+            axes.positionCount = 3; axes.SetPositions(new[] { Point(0, deadline), Point(0, 1), Point(length, 1) });
+            Label("StationAxis", "0 ft                       " + length + " ft", new Vector2(area.center.x, area.yMin - 0.045f), new Vector2(area.width, 0.1f), 0.045f);
+            Label("DayAxis", "Day " + deadline, new Vector2(area.xMin + 0.1f, area.yMax + 0.045f), new Vector2(0.3f, 0.1f), 0.045f);
+        }
+        public Vector3 Point(double feet, double day) => new Vector3(
+            area.xMin + (float)(feet / length) * area.width,
+            area.yMin + (float)((day - 1) / (deadline - 1)) * area.height, -0.065f);
+        public TMPro.TextMeshPro Label(string name, string value, Vector2 position, Vector2 size, float height)
+        {
+            var text = WorldDrawing.Text(name, root, new Vector3(position.x, position.y, -0.07f), size, height, assets.font);
+            text.text = value; return text;
+        }
+        public LineRenderer Rule(string name, double value, bool day, Color colour)
+        {
+            var line = WorldDrawing.Line(name, root, assets.ink, colour, 0.004f); line.positionCount = 2;
+            line.SetPositions(day ? new[] { Point(0, value), Point(length, value) } : new[] { Point(value, 1), Point(value, deadline) });
+            return line;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/WorldAssets.cs b/Assets/LOBOver/Runtime/World/WorldAssets.cs
new file mode 100644
index 0000000000000000000000000000000000000000..73c9a4726193a9b147e6e4682d81a27fa26d4a18
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/WorldAssets.cs
@@ -0,0 +1,84 @@
+using System;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    [Serializable] public sealed class MachineAsset
+    {
+        public string crew, plate, label;
+        public GameObject prefab;
+    }
+    public sealed class WorldAssets : ScriptableObject
+    {
+        public StationCell cellPrefab;
+        public CrewRig crewPrefab;
+        public GameObject worker, particles, spoil, barrier, cone;
+        public MachineAsset[] machines;
+        public TMP_FontAsset font;
+        public Material ink, soil, timber, steel, orange, cloud, rain;
+        public AudioClip wind, rainfall, excavation, dozer, idle, conflict, collapse, pipeSetdown;
+        public MachineAsset Machine(string crew, string plate) => Array.Find(machines,
+            item => item.crew == crew && string.Equals(item.plate, plate, StringComparison.OrdinalIgnoreCase));
+    }
+
+    public static class WorldUnits
+    {
+        // WO-08 sections 1-3: physical scale and station geometry.
+        public const float MetresPerFoot = 0.3048f, StationFeet = 100, CellLength = 30.48f;
+        public const float TrenchWidth = 1.2f, TrenchDepth = 1.8f, RoadZ = 6;
+        public const float PoseSeconds = 0.5f, DemobBackMetres = 60;
+        public static readonly string[] CrewIds = { "exc", "pipe", "back" };
+        // Crew identity colours, never status or decision feedback.
+        public static readonly Color[] CrewColours = { new Color(0.95f, 0.65f, 0.25f), new Color(0.4f, 0.7f, 1), new Color(0.85f, 0.65f, 0.95f) };
+        public static string Station(double feet) => ((int)Math.Floor(feet / 100)) + "+" + ((int)Math.Round(feet % 100)).ToString("00");
+    }
+
+    public static class WorldDrawing
+    {
+        public static GameObject Group(string name, Transform parent)
+        {
+            var obj = new GameObject(name); obj.transform.SetParent(parent, false); return obj;
+        }
+        public static GameObject Box(string name, Transform parent, Vector3 position, Vector3 size, Material material)
+        {
+            var obj = GameObject.CreatePrimitive(PrimitiveType.Cube); obj.name = name;
+            obj.transform.SetParent(parent, false); obj.transform.localPosition = position; obj.transform.localScale = size;
+            obj.GetComponent<Renderer>().sharedMaterial = material; return obj;
+        }
+        public static TextMeshPro Text(string name, Transform parent, Vector3 position, Vector2 size, float height, TMP_FontAsset font)
+        {
+            var obj = Group(name, parent); obj.transform.localPosition = position;
+            var text = obj.AddComponent<TextMeshPro>(); text.font = font;
+            text.fontSize = height * 100; text.color = new Color(0.95f, 0.94f, 0.9f);
+            text.alignment = TextAlignmentOptions.TopLeft; text.rectTransform.sizeDelta = size;
+            text.textWrappingMode = TextWrappingModes.Normal; text.overflowMode = TextOverflowModes.Overflow;
+            text.richText = false; return text;
+        }
+        public static LineRenderer Line(string name, Transform parent, Material material, Color colour, float width)
+        {
+            var line = Group(name, parent).AddComponent<LineRenderer>(); line.useWorldSpace = false;
+            line.sharedMaterial = material; line.startColor = line.endColor = colour;
+            line.startWidth = line.endWidth = width; line.positionCount = 0;
+            line.alignment = LineAlignment.TransformZ; return line;
+        }
+        public static AudioSource Sound(GameObject obj, bool loop, float distance = 50)
+        {
+            var audio = obj.AddComponent<AudioSource>(); audio.playOnAwake = false; audio.loop = loop;
+            audio.spatialBlend = 1; audio.rolloffMode = AudioRolloffMode.Linear; audio.minDistance = 2; audio.maxDistance = distance;
+            return audio;
+        }
+        public static void Loop(AudioSource audio, AudioClip clip)
+        {
+            if (audio.clip == clip) return;
+            audio.Stop(); audio.clip = clip;
+            if (clip != null && Application.isPlaying) audio.Play();
+        }
+        public static void Remove(GameObject obj)
+        {
+            if (obj == null) return;
+            obj.SetActive(false);
+            if (Application.isPlaying) UnityEngine.Object.Destroy(obj); else UnityEngine.Object.DestroyImmediate(obj);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/ZoneBoard.cs b/Assets/LOBOver/Runtime/World/ZoneBoard.cs
