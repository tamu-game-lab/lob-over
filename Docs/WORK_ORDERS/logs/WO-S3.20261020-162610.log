index 0000000000000000000000000000000000000000..bd34eee7d5e81cdc7ffbd235aeb3eab9a39eed33
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/StationCell.cs
@@ -0,0 +1,49 @@
+using LOBOver.Sim;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class StationCell : MonoBehaviour
+    {
+        public GameObject surface, floor, walls, pipes, wetBand, water, slump, box, shoring;
+        public Transform nearWall, farWall, stake;
+        public TextMeshPro stationText;
+        public Material openMaterial, pipeMaterial, backfillMaterial, surfaceMaterial;
+        public string State { get; private set; }
+        public string Water { get; private set; }
+        public string Wall { get; private set; }
+        public string Protection { get; private set; }
+        public double StationFt { get; private set; }
+        private AudioSource sound;
+        private WorldAssets assets;
+        private string lastKey;
+
+        public void Initialize(double feet, WorldAssets source)
+        {
+            StationFt = feet; assets = source; name = "Cell_" + WorldUnits.Station(feet);
+            transform.localPosition = new Vector3((float)feet * WorldUnits.MetresPerFoot, 0, 0);
+            stationText.text = WorldUnits.Station(feet); sound = WorldDrawing.Sound(gameObject, false);
+        }
+        public void Apply(TrenchView view)
+        {
+            var key = view.state + "/" + view.wall + "/" + view.water + "/" + view.protection + "/" + view.pipeDamage;
+            if (key == lastKey) return;
+            if (lastKey != null && Application.isPlaying)
+            {
+                if (view.wall == "slumped" && Wall != "slumped") sound.PlayOneShot(assets.collapse);
+                if (view.state == "piped" && State != "piped") sound.PlayOneShot(assets.pipeSetdown);
+            }
+            State = view.state; Water = view.water; Wall = view.wall; Protection = view.protection; lastKey = key;
+            var dug = State == "open" || State == "piped";
+            surface.SetActive(!dug); floor.SetActive(dug); walls.SetActive(dug); pipes.SetActive(State == "piped");
+            surface.GetComponent<Renderer>().sharedMaterial = State == "backfilled" ? backfillMaterial : surfaceMaterial;
+            floor.GetComponent<Renderer>().sharedMaterial = State == "piped" ? pipeMaterial : openMaterial;
+            wetBand.SetActive(dug && Water == "seep"); water.SetActive(dug && (Water == "standing" || Wall == "slumped"));
+            slump.SetActive(dug && Wall == "slumped"); box.SetActive(dug && Protection == "box"); shoring.SetActive(dug && Protection == "shoring");
+            nearWall.localRotation = Quaternion.Euler(Protection == "slope" ? -30 : 0, 0, 0);
+            farWall.localRotation = Quaternion.Euler(Protection == "slope" ? 30 : 0, 0, 0);
+            Debug.Log(name + " " + key, this);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/TrailerBoard.cs b/Assets/LOBOver/Runtime/World/TrailerBoard.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e22c6ae9dc9801da842c4b33851cbb0b99634aa8
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/TrailerBoard.cs
@@ -0,0 +1,76 @@
+using System.Collections.Generic;
+using LOBOver.Sim;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class TrailerBoard : MonoBehaviour
+    {
+        private readonly Dictionary<string, List<Vector3>> points = new Dictionary<string, List<Vector3>>();
+        private readonly Dictionary<string, LineRenderer> lines = new Dictionary<string, LineRenderer>();
+        private readonly Dictionary<int, LineRenderer> permits = new Dictionary<int, LineRenderer>();
+        private int lastDay = -1;
+        private Chart chart;
+        private Transform drawing;
+        public int LineCount => lines.Count;
+        public int PointCount(string crew) => points[crew].Count;
+
+        public void Configure(WorldAssets assets, double lengthFt, double deadline, Dictionary<int, double> boundaries)
+        {
+            if (drawing != null) WorldDrawing.Remove(drawing.gameObject);
+            drawing = WorldDrawing.Group("SitePlot", transform).transform;
+            points.Clear(); lines.Clear(); permits.Clear(); lastDay = -1;
+            chart = new Chart(drawing, assets, lengthFt, deadline, new Rect(-0.82f, -0.36f, 1.65f, 0.65f));
+            chart.Label("Title", "SITE  ·  actual feet / day", new Vector2(0, 0.42f), new Vector2(1.8f, 0.15f), 0.08f);
+            for (var i = 0; i < WorldUnits.CrewIds.Length; i++)
+            {
+                var id = WorldUnits.CrewIds[i]; points[id] = new List<Vector3>();
+                lines[id] = WorldDrawing.Line("Actual_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.009f);
+            }
+            foreach (var item in boundaries)
+                permits[item.Key] = chart.Rule("UnpostedZone_" + item.Key, item.Value, false, Color.gray);
+        }
+        public void Apply(SiteView view, int displayDay)
+        {
+            foreach (var board in view.boards) if (permits.TryGetValue((int)board.zone, out var rule)) rule.gameObject.SetActive(board.permitNumber == null);
+            if (displayDay == lastDay) return;
+            foreach (var crew in view.crews)
+            {
+                points[crew.id].Add(chart.Point(crew.stationFt, displayDay));
+                lines[crew.id].positionCount = points[crew.id].Count;
+                lines[crew.id].SetPositions(points[crew.id].ToArray());
+            }
+            lastDay = displayDay;
+        }
+    }
+
+    internal sealed class Chart
+    {
+        private readonly Transform root;
+        private readonly WorldAssets assets;
+        private readonly double length, deadline;
+        private readonly Rect area;
+        public Chart(Transform root, WorldAssets assets, double length, double deadline, Rect area)
+        {
+            this.root = root; this.assets = assets; this.length = length; this.deadline = deadline; this.area = area;
+            var axes = WorldDrawing.Line("Axes", root, assets.ink, Color.white, 0.005f);
+            axes.positionCount = 3; axes.SetPositions(new[] { Point(0, deadline), Point(0, 1), Point(length, 1) });
+            Label("StationAxis", "0 ft                       " + length + " ft", new Vector2(area.center.x, area.yMin - 0.045f), new Vector2(area.width, 0.1f), 0.045f);
+            Label("DayAxis", "Day " + deadline, new Vector2(area.xMin + 0.1f, area.yMax + 0.045f), new Vector2(0.3f, 0.1f), 0.045f);
+        }
+        public Vector3 Point(double feet, double day) => new Vector3(
+            area.xMin + (float)(feet / length) * area.width,
+            area.yMin + (float)((day - 1) / (deadline - 1)) * area.height, -0.065f);
+        public TMPro.TextMeshPro Label(string name, string value, Vector2 position, Vector2 size, float height)
+        {
+            var text = WorldDrawing.Text(name, root, new Vector3(position.x, position.y, -0.07f), size, height, assets.font);
+            text.text = value; return text;
+        }
+        public LineRenderer Rule(string name, double value, bool day, Color colour)
+        {
+            var line = WorldDrawing.Line(name, root, assets.ink, colour, 0.004f); line.positionCount = 2;
+            line.SetPositions(day ? new[] { Point(0, value), Point(length, value) } : new[] { Point(value, 1), Point(value, deadline) });
+            return line;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/WorldAssets.cs b/Assets/LOBOver/Runtime/World/WorldAssets.cs
new file mode 100644
index 0000000000000000000000000000000000000000..73c9a4726193a9b147e6e4682d81a27fa26d4a18
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/WorldAssets.cs
@@ -0,0 +1,84 @@
+using System;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    [Serializable] public sealed class MachineAsset
+    {
+        public string crew, plate, label;
+        public GameObject prefab;
+    }
+    public sealed class WorldAssets : ScriptableObject
+    {
+        public StationCell cellPrefab;
+        public CrewRig crewPrefab;
+        public GameObject worker, particles, spoil, barrier, cone;
+        public MachineAsset[] machines;
+        public TMP_FontAsset font;
+        public Material ink, soil, timber, steel, orange, cloud, rain;
+        public AudioClip wind, rainfall, excavation, dozer, idle, conflict, collapse, pipeSetdown;
+        public MachineAsset Machine(string crew, string plate) => Array.Find(machines,
+            item => item.crew == crew && string.Equals(item.plate, plate, StringComparison.OrdinalIgnoreCase));
+    }
+
+    public static class WorldUnits
+    {
+        // WO-08 sections 1-3: physical scale and station geometry.
+        public const float MetresPerFoot = 0.3048f, StationFeet = 100, CellLength = 30.48f;
+        public const float TrenchWidth = 1.2f, TrenchDepth = 1.8f, RoadZ = 6;
+        public const float PoseSeconds = 0.5f, DemobBackMetres = 60;
+        public static readonly string[] CrewIds = { "exc", "pipe", "back" };
+        // Crew identity colours, never status or decision feedback.
+        public static readonly Color[] CrewColours = { new Color(0.95f, 0.65f, 0.25f), new Color(0.4f, 0.7f, 1), new Color(0.85f, 0.65f, 0.95f) };
+        public static string Station(double feet) => ((int)Math.Floor(feet / 100)) + "+" + ((int)Math.Round(feet % 100)).ToString("00");
+    }
+
+    public static class WorldDrawing
+    {
+        public static GameObject Group(string name, Transform parent)
+        {
+            var obj = new GameObject(name); obj.transform.SetParent(parent, false); return obj;
+        }
+        public static GameObject Box(string name, Transform parent, Vector3 position, Vector3 size, Material material)
+        {
+            var obj = GameObject.CreatePrimitive(PrimitiveType.Cube); obj.name = name;
+            obj.transform.SetParent(parent, false); obj.transform.localPosition = position; obj.transform.localScale = size;
+            obj.GetComponent<Renderer>().sharedMaterial = material; return obj;
+        }
+        public static TextMeshPro Text(string name, Transform parent, Vector3 position, Vector2 size, float height, TMP_FontAsset font)
+        {
+            var obj = Group(name, parent); obj.transform.localPosition = position;
+            var text = obj.AddComponent<TextMeshPro>(); text.font = font;
+            text.fontSize = height * 100; text.color = new Color(0.95f, 0.94f, 0.9f);
+            text.alignment = TextAlignmentOptions.TopLeft; text.rectTransform.sizeDelta = size;
+            text.textWrappingMode = TextWrappingModes.Normal; text.overflowMode = TextOverflowModes.Overflow;
+            text.richText = false; return text;
+        }
+        public static LineRenderer Line(string name, Transform parent, Material material, Color colour, float width)
+        {
+            var line = Group(name, parent).AddComponent<LineRenderer>(); line.useWorldSpace = false;
+            line.sharedMaterial = material; line.startColor = line.endColor = colour;
+            line.startWidth = line.endWidth = width; line.positionCount = 0;
+            line.alignment = LineAlignment.TransformZ; return line;
+        }
+        public static AudioSource Sound(GameObject obj, bool loop, float distance = 50)
+        {
+            var audio = obj.AddComponent<AudioSource>(); audio.playOnAwake = false; audio.loop = loop;
+            audio.spatialBlend = 1; audio.rolloffMode = AudioRolloffMode.Linear; audio.minDistance = 2; audio.maxDistance = distance;
+            return audio;
+        }
+        public static void Loop(AudioSource audio, AudioClip clip)
+        {
+            if (audio.clip == clip) return;
+            audio.Stop(); audio.clip = clip;
+            if (clip != null && Application.isPlaying) audio.Play();
+        }
+        public static void Remove(GameObject obj)
+        {
+            if (obj == null) return;
+            obj.SetActive(false);
+            if (Application.isPlaying) UnityEngine.Object.Destroy(obj); else UnityEngine.Object.DestroyImmediate(obj);
+        }
+    }
+}
