index 0000000000000000000000000000000000000000..f677da448778befe29797fe9897e3e1bedeeaed5
--- /dev/null
+++ b/Assets/LOBOver/Editor/SiteAssetBuilder.cs
@@ -0,0 +1,191 @@
+using System;
+using System.IO;
+using System.Linq;
+using LOBOver.World;
+using Newtonsoft.Json.Linq;
+using TMPro;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Editor
+{
+    public static class SiteAssetBuilder
+    {
+        public const string Imported = "Assets/LOBGame/";
+        public const string Art = "Assets/LOBOver/Art/";
+        public const string Prefabs = "Assets/LOBOver/Prefabs/";
+        public const string Equipment = Imported + "_Project/Art/Prefabs/Equipment/";
+        public const string Worker = Imported + "_Project/Art/Prefabs/Workers/ProjectWorker.prefab";
+        public const string Pipe = Imported + "_Project/Art/ProjectSite/ProjectPipeSegment.prefab";
+        public static readonly string[] MachineNames = { "Excavator_Small", "Excavator_Standard", "Excavator_Large", "Crane_Standard", "Crane_Heavy", "Backfill_Small", "Backfill_Standard", "Backfill_Large" };
+        public static T Required<T>(string path) where T : Object => AssetDatabase.LoadAssetAtPath<T>(path) ?? throw new FileNotFoundException("Required imported asset: " + path);
+        public static Material Material(string name) => Required<Material>(Imported + "_Project/Art/ProjectSite/Materials/" + name + ".mat");
+        private static AudioClip Audio(string name, string extension = ".ogg") => Required<AudioClip>(Imported + "Audio/Construction/" + name + extension);
+        public static WorldAssets Build()
+        {
+            Directory.CreateDirectory(Art); Directory.CreateDirectory(Prefabs); Directory.CreateDirectory(Prefabs + "Imported"); AssetDatabase.Refresh();
+            var assets = AssetDatabase.LoadAssetAtPath<WorldAssets>(Art + "WorldAssets.asset");
+            if (assets == null) { assets = ScriptableObject.CreateInstance<WorldAssets>(); AssetDatabase.CreateAsset(assets, Art + "WorldAssets.asset"); }
+            assets.font = Font(); assets.soil = Material("Soil"); assets.timber = Material("Timber"); assets.steel = Material("StorageSteel"); assets.orange = Material("SafetyOrange");
+            assets.ink = OwnMaterial("Ink", Color.white, false, "Universal Render Pipeline/Particles/Unlit");
+            assets.cloud = OwnMaterial("Cloud", new Color(0.26f, 0.28f, 0.31f));
+            assets.rain = OwnMaterial("Rain", new Color(0.65f, 0.72f, 0.8f, 0.5f), true);
+            assets.wind = Audio("bed_open_wind"); assets.rainfall = Audio("bed_rain_open"); assets.excavation = Audio("exc_work_loop");
+            assets.dozer = Audio("dozer_engine_loop"); assets.idle = Audio("machine_idle_loop"); assets.conflict = Audio("conflict_murmur_loop");
+            assets.collapse = Audio("collapse_rumble_01", ".wav"); assets.pipeSetdown = Audio("pipe_setdown_01", ".wav");
+            assets.worker = CopyModel(Worker, "ProjectWorker", Vector3.zero, 0, true);
+            assets.particles = CopyModel(Imported + "_Project/Art/Prefabs/Effects/WorkParticles.prefab", "WorkParticles", Vector3.zero);
+            assets.spoil = CopyModel(Imported + "3D_Models/a-pile-of-sand/source/hromada_pisek_01_30k_uw/hromada_pisek_01_30k_uw.FBX", "Spoil", new Vector3(9, 1.5f, 3));
+            assets.barrier = CopyModel(Imported + "3D_Models/water-barriers/source/WaterBarriers_RED-WHITE.fbx", "WaterBarrier", new Vector3(2, 1, 0.5f));
+            assets.cone = CopyModel(Imported + "3D_Models/trafic-cone/source/vlc.prefab", "Cone", new Vector3(0.45f, 0.7f, 0.45f));
+            var catalog = JObject.Parse(File.ReadAllText("Data/catalog.json"));
+            assets.machines = MachineNames.Select(name =>
+            {
+                var key = name.ToLowerInvariant(); var data = catalog["machines"][key];
+                return new MachineAsset { crew = (string)data["crew"], plate = (string)data["sizeClass"], label = (string)data["label"],
+                    prefab = CopyModel(Equipment + name + ".prefab", name, Vector3.zero, 90, false, true) };
+            }).ToArray();
+            assets.cellPrefab = BuildCell(assets); assets.crewPrefab = BuildCrew();
+            EditorUtility.SetDirty(assets); AssetDatabase.SaveAssets(); return assets;
+        }
+        public static Material OwnMaterial(string name, Color colour, bool transparent = false, string shaderName = "Universal Render Pipeline/Unlit")
+        {
+            var path = Art + name + ".mat"; var material = AssetDatabase.LoadAssetAtPath<Material>(path);
+            if (material == null)
+            {
+                var shader = Shader.Find(shaderName) ?? throw new InvalidOperationException("Missing shader " + shaderName);
+                material = new Material(shader); AssetDatabase.CreateAsset(material, path);
+            }
+            material.SetColor("_BaseColor", colour);
+            if (transparent)
+            {
+                material.SetFloat("_Surface", 1); material.SetFloat("_Blend", 0); material.SetFloat("_ZWrite", 0);
+                material.SetInt("_SrcBlend", (int)BlendMode.SrcAlpha); material.SetInt("_DstBlend", (int)BlendMode.OneMinusSrcAlpha);
+                material.SetOverrideTag("RenderType", "Transparent"); material.EnableKeyword("_SURFACE_TYPE_TRANSPARENT"); material.renderQueue = (int)RenderQueue.Transparent;
+            }
+            EditorUtility.SetDirty(material); return material;
+        }
+        private static TMP_FontAsset Font()
+        {
+            var path = Art + "SiteFont.asset"; var font = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(path);
+            if (font != null) return font;
+            font = TMP_FontAsset.CreateFontAsset(Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf"));
+            font.name = "SiteFont"; font.TryAddCharacters(string.Concat(Enumerable.Range(32, 95).Select(value => (char)value)) + "—–·×");
+            AssetDatabase.CreateAsset(font, path);
+            foreach (var atlas in font.atlasTextures) AssetDatabase.AddObjectToAsset(atlas, font);
+            AssetDatabase.AddObjectToAsset(font.material, font); EditorUtility.SetDirty(font); return font;
+        }
+        public static void StripMissing(GameObject instance)
+        {
+            foreach (var child in instance.GetComponentsInChildren<Transform>(true)) GameObjectUtility.RemoveMonoBehavioursWithMissingScript(child.gameObject);
+        }
+        private static Bounds BoundsOf(GameObject obj)
+        {
+            var renderers = obj.GetComponentsInChildren<Renderer>().Where(renderer => !(renderer is ParticleSystemRenderer)).ToArray();
+            if (renderers.Length == 0) return new Bounds(obj.transform.position, Vector3.one);
+            var bounds = renderers[0].bounds; foreach (var renderer in renderers.Skip(1)) bounds.Encapsulate(renderer.bounds); return bounds;
+        }
+        private static GameObject CopyModel(string path, string name, Vector3 fit, float yaw = 0, bool worker = false, bool workingEdge = false)
+        {
+            var root = new GameObject(name);
+            try
+            {
+                var model = (GameObject)PrefabUtility.InstantiatePrefab(Required<GameObject>(path));
+                if (PrefabUtility.IsPartOfPrefabInstance(model)) PrefabUtility.UnpackPrefabInstance(model, PrefabUnpackMode.Completely, InteractionMode.AutomatedAction);
+                StripMissing(model); model.transform.SetParent(root.transform, false); model.transform.localRotation = Quaternion.Euler(0, yaw, 0);
+                if (worker)
+                {
+                    var animator = model.GetComponentInChildren<Animator>();
+                    if (animator != null) { animator.runtimeAnimatorController = Required<RuntimeAnimatorController>(Imported + "_Project/Art/ProjectSite/Animation/ProjectWorker.controller"); animator.applyRootMotion = false; }
+                }
+                var bounds = BoundsOf(model);
+                if (fit != Vector3.zero)
+                {
+                    model.transform.localScale = Vector3.Scale(model.transform.localScale, new Vector3(fit.x / bounds.size.x, fit.y / bounds.size.y, fit.z / bounds.size.z));
+                    bounds = BoundsOf(model);
+                }
+                model.transform.position -= new Vector3(workingEdge ? bounds.max.x : bounds.center.x, bounds.min.y, bounds.center.z);
+                if (model.GetComponentsInChildren<Collider>().Length == 0 && name != "WorkParticles")
+                {
+                    bounds = BoundsOf(model); var collider = root.AddComponent<BoxCollider>(); collider.center = bounds.center; collider.size = bounds.size;
+                }
+                return PrefabUtility.SaveAsPrefabAsset(root, Prefabs + "Imported/" + name + ".prefab");
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static CrewRig BuildCrew()
+        {
+            var root = new GameObject("CrewRig"); root.AddComponent<CrewRig>();
+            try { return PrefabUtility.SaveAsPrefabAsset(root, Prefabs + "CrewRig.prefab").GetComponent<CrewRig>(); }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static StationCell BuildCell(WorldAssets assets)
+        {
+            var root = new GameObject("StationCell"); var cell = root.AddComponent<StationCell>();
+            const float length = WorldUnits.CellLength, depth = WorldUnits.TrenchDepth, width = WorldUnits.TrenchWidth;
+            try
+            {
+                cell.surfaceMaterial = Material("Repair_Surface"); cell.openMaterial = Material("Repair_OpenTrench"); cell.pipeMaterial = Material("Repair_PipeBed"); cell.backfillMaterial = Material("Repair_Backfill");
+                cell.surface = WorldDrawing.Box("Surface", root.transform, new Vector3(length / 2, -0.05f, 0), new Vector3(length, 0.1f, width), cell.surfaceMaterial);
+                cell.floor = WorldDrawing.Box("Floor", root.transform, new Vector3(length / 2, -depth - 0.05f, 0), new Vector3(length, 0.1f, width), cell.openMaterial);
+                InspectTarget.Attach(cell.floor, "water");
+                cell.walls = WorldDrawing.Group("Walls", root.transform);
+                cell.nearWall = WorldDrawing.Box("NearWall", cell.walls.transform, new Vector3(length / 2, -depth / 2, width / 2), new Vector3(length, depth, 0.08f), assets.soil).transform;
+                cell.farWall = WorldDrawing.Box("FarWall", cell.walls.transform, new Vector3(length / 2, -depth / 2, -width / 2), new Vector3(length, depth, 0.08f), assets.soil).transform;
+                InspectTarget.Attach(cell.walls, "wall");
+                cell.pipes = WorldDrawing.Group("Pipes", root.transform);
+                var pipePrefab = CopyModel(Pipe, "ProjectPipeSegment", Vector3.zero);
+                for (var i = 0; i < 3; i++)
+                {
+                    var segment = (GameObject)PrefabUtility.InstantiatePrefab(pipePrefab); segment.transform.SetParent(cell.pipes.transform, false);
+                    var bounds = BoundsOf(segment); var size = bounds.size;
+                    if (size.z > size.x) segment.transform.localRotation = Quaternion.Euler(0, 90, 0);
+                    else if (size.y > size.x) segment.transform.localRotation = Quaternion.Euler(0, 0, 90);
+                    bounds = BoundsOf(segment);
+                    // Three equal segments span each 100 ft cell, retaining the prefab's pipe diameter.
+                    var stretch = WorldDrawing.Group("PipeLength", cell.pipes.transform); segment.transform.SetParent(stretch.transform, false);
+                    stretch.transform.localScale = new Vector3((length / 3) / bounds.size.x, 1, 1);
+                    bounds = BoundsOf(segment);
+                    stretch.transform.position += new Vector3(length * (i + 0.5f) / 3 - bounds.center.x, -depth - bounds.min.y, -bounds.center.z);
+                    InspectTarget.Attach(stretch, "pipe");
+                }
+                cell.wetBand = WorldDrawing.Box("SeepBand", root.transform, new Vector3(length / 2, -depth + 0.2f, -width / 2 + 0.05f), new Vector3(length, 0.4f, 0.01f), OwnMaterial("WetSoil", new Color(0.13f, 0.12f, 0.1f)));
+                InspectTarget.Attach(cell.wetBand, "water");
+                cell.water = WorldDrawing.Box("StandingWater", root.transform, new Vector3(length / 2, -depth + 0.2f, 0), new Vector3(length, 0.008f, width), OwnMaterial("Water", new Color(0.25f, 0.32f, 0.34f, 0.65f), true));
+                InspectTarget.Attach(cell.water, "water");
+                cell.slump = WorldDrawing.Group("SlumpedWall", root.transform); cell.slump.AddComponent<MeshFilter>().sharedMesh = SlumpMesh();
+                cell.slump.AddComponent<MeshRenderer>().sharedMaterial = assets.soil; cell.slump.AddComponent<MeshCollider>().sharedMesh = cell.slump.GetComponent<MeshFilter>().sharedMesh;
+                InspectTarget.Attach(cell.slump, "wall");
+                cell.box = Protection(root.transform, "TrenchBox", assets.steel, true); cell.shoring = Protection(root.transform, "Shoring", assets.timber, false);
+                var post = WorldDrawing.Box("Stake", root.transform, new Vector3(0, 0.55f, 1.2f), new Vector3(0.08f, 1.1f, 0.08f), assets.timber);
+                cell.stake = post.transform;
+                cell.stationText = WorldDrawing.Text("Station", root.transform, new Vector3(0, 1.3f, 1.25f), new Vector2(1.4f, 0.4f), 0.3f, assets.font);
+                cell.stationText.transform.localRotation = Quaternion.Euler(0, 180, 0);
+                foreach (var obj in new[] { cell.floor, cell.walls, cell.pipes, cell.wetBand, cell.water, cell.slump, cell.box, cell.shoring }) obj.SetActive(false);
+                return PrefabUtility.SaveAsPrefabAsset(root, Prefabs + "StationCell.prefab").GetComponent<StationCell>();
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static GameObject Protection(Transform parent, string name, Material material, bool steel)
+        {
+            var root = WorldDrawing.Group(name, parent);
+            for (var side = -1; side <= 1; side += 2)
+                WorldDrawing.Box("Panel", root.transform, new Vector3(WorldUnits.CellLength / 2, -0.9f, side * 0.5f), new Vector3(WorldUnits.CellLength, 1.7f, steel ? 0.06f : 0.1f), material);
+            for (var i = 0; i < 3; i++) WorldDrawing.Box("Strut", root.transform, new Vector3((i + 0.5f) * WorldUnits.CellLength / 3, -0.3f, 0), new Vector3(0.1f, 0.1f, 1), material);
+            InspectTarget.Attach(root, "protection"); return root;
+        }
+        private static Mesh SlumpMesh()
+        {
+            var path = Art + "Slump.asset"; var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
+            if (mesh != null) return mesh;
+            var end = WorldUnits.CellLength;
+            mesh = new Mesh { name = "Slump" };
+            mesh.vertices = new[] { new Vector3(0, -1.8f, -0.6f), new Vector3(0, -0.25f, -0.6f), new Vector3(0, -1.8f, 0.25f),
+                new Vector3(end, -1.8f, -0.6f), new Vector3(end, -0.25f, -0.6f), new Vector3(end, -1.8f, 0.25f) };
+            mesh.triangles = new[] { 0, 2, 1, 3, 4, 5, 0, 1, 4, 0, 4, 3, 1, 2, 5, 1, 5, 4, 2, 0, 3, 2, 3, 5 };
+            mesh.RecalculateNormals(); mesh.RecalculateBounds(); AssetDatabase.CreateAsset(mesh, path); return mesh;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Editor/SiteSceneBuilder.cs b/Assets/LOBOver/Editor/SiteSceneBuilder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b6af7f13cc4a4c80117711f59d2cfeb6de6b4279
--- /dev/null
+++ b/Assets/LOBOver/Editor/SiteSceneBuilder.cs
@@ -0,0 +1,168 @@
+using System;
+using System.IO;
+using LOBOver.Runtime;
+using LOBOver.World;
+using Newtonsoft.Json.Linq;
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.Rendering;
+using UnityEngine.SceneManagement;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Editor
+{
+    public static class SiteSceneBuilder
+    {
+        public const string ScenePath = "Assets/LOBOver/Scenes/Site.unity";
+        [MenuItem("LOB Over/Build/Site Scene")]
+        public static void BuildMenu()
+        {
+            if (!EditorSceneManager.SaveCurrentModifiedScenesIfUserWantsTo()) return;
+            Build();
+        }
+        public static Scene Build(bool saveScene = true)
+        {
+            DataSync.Sync(); var assets = SiteAssetBuilder.Build();
+            var scene = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);
+            var light = new GameObject("Sun").AddComponent<Light>(); light.type = LightType.Directional;
+            light.color = new Color(1, 0.94f, 0.82f); light.intensity = 1.2f; light.shadows = LightShadows.Soft;
+            light.transform.rotation = Quaternion.Euler(48, -35, 0); RenderSettings.sun = light;
+            RenderSettings.ambientMode = AmbientMode.Trilight; RenderSettings.ambientSkyColor = new Color(0.65f, 0.75f, 0.85f);
+            RenderSettings.ambientEquatorColor = new Color(0.48f, 0.5f, 0.52f); RenderSettings.ambientGroundColor = new Color(0.25f, 0.23f, 0.2f);
+            RenderSettings.skybox = AssetDatabase.GetBuiltinExtraResource<Material>("Default-Skybox.mat");
+            var volume = new GameObject("Global Volume").AddComponent<Volume>(); volume.isGlobal = true;
+            volume.sharedProfile = SiteAssetBuilder.Required<VolumeProfile>("Assets/Settings/DefaultVolumeProfile.asset");
+            BuildGround(assets);
+            var gate = new GameObject("Gate"); gate.transform.position = new Vector3(-20, 0, WorldUnits.RoadZ);
+            for (var i = 0; i < 2; i++)
+            {
+                var barrier = (GameObject)PrefabUtility.InstantiatePrefab(assets.barrier); barrier.name = "GateBarrier_" + (i + 1);
+                barrier.transform.SetParent(gate.transform, false); barrier.transform.localPosition = new Vector3(0, 0, i == 0 ? -3.5f : 3.5f);
+            }
+            var cone = (GameObject)PrefabUtility.InstantiatePrefab(assets.cone); cone.name = "GateCone";
+            cone.transform.SetParent(gate.transform, false); cone.transform.localPosition = new Vector3(0, 0, 2.5f);
+            var ticket = WorldDrawing.Box("GateTicket", gate.transform, new Vector3(0, 1.5f, 3), new Vector3(0.7f, 0.5f, 0.04f), assets.steel);
+            InspectTarget.Attach(ticket, "ticket");
+            var gateText = WorldDrawing.Text("GateText", gate.transform, new Vector3(0, 1.5f, 2.96f), new Vector2(0.65f, 0.45f), 0.08f, assets.font);
+            var trailer = WorldDrawing.Box("Trailer", null, new Vector3(-15, 1.5f, 14), new Vector3(6, 3, 3), SiteAssetBuilder.Material("Repair_SiteCabin"));
+            var siteBoard = Board("TrailerBoard", new Vector3(-15, 1.9f, 12.44f), new Vector2(2, 1), assets).AddComponent<TrailerBoard>();
+            var planBoard = Board("PlanPanel", new Vector3(-15, 1.9f, 15.56f), new Vector2(3, 1.5f), assets).AddComponent<PlanPanel>();
+            planBoard.transform.rotation = Quaternion.Euler(0, 180, 0);
+            // Boards remain at unit scale; parenting preserves their world dimensions.
+            siteBoard.transform.SetParent(trailer.transform, true); planBoard.transform.SetParent(trailer.transform, true);
+            var sign = new GameObject("JobSign"); sign.transform.position = new Vector3(-20, 0, 10);
+            for (var side = -1; side <= 1; side += 2) WorldDrawing.Box("TimberPost", sign.transform, new Vector3(side * 0.45f, 0.9f, 0), new Vector3(0.08f, 1.8f, 0.08f), assets.timber);
+            WorldDrawing.Box("SignBoard", sign.transform, new Vector3(0, 1.6f, 0), new Vector3(1.2f, 0.8f, 0.05f), assets.steel);
+            var jobSign = sign.AddComponent<JobSign>(); jobSign.label = WorldDrawing.Text("Job", sign.transform, new Vector3(0, 1.6f, -0.04f), new Vector2(1.1f, 0.7f), 0.1f, assets.font);
+            var director = new GameObject("Director").AddComponent<Director>();
+            var world = new GameObject("SiteWorld").AddComponent<SiteWorld>(); world.director = director; world.assets = assets;
+            world.trailerBoard = siteBoard; world.planPanel = planBoard; world.jobSign = jobSign; world.gateText = gateText;
+            world.truck = new GameObject("SiteTruck").transform; world.truck.SetParent(world.transform, false); world.truck.localPosition = new Vector3(0, 0, WorldUnits.RoadZ);
+            var truckFrame = WorldDrawing.Box("TruckFrame", world.truck, new Vector3(-1, 0.55f, 0), new Vector3(2.2f, 0.3f, 2), assets.steel);
+            // Preview marker only; the XR cab and its comfort presentation belong to WO-S4.
+            var previewPrefab = BuildPreviewPrefab();
+            var preview = ((GameObject)PrefabUtility.InstantiatePrefab(previewPrefab)).GetComponent<DesktopPreview>(); preview.name = "DesktopPreview";
+            preview.director = director; preview.world = world;
+            preview.previewCamera.transform.position = new Vector3(160, 9, 20); preview.previewCamera.transform.LookAt(new Vector3(140, -0.5f, 0));
+            world.sky = BuildSky(assets, preview.previewCamera.transform);
+            // Metadata appears in Edit mode without putting a facilitator view in any player board.
+            var source = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json")); jobSign.Apply((JObject)source["job"]["sign"]);
+            Selection.activeGameObject = world.gameObject;
+            if (saveScene)
+            {
+                Directory.CreateDirectory("Assets/LOBOver/Scenes");
+                if (!EditorSceneManager.SaveScene(scene, ScenePath)) throw new IOException("Could not save " + ScenePath);
+            }
+            AssetDatabase.SaveAssets(); Debug.Log("LOB Over: Site Scene built. Press Play for the slice."); return scene;
+        }
+        private static void BuildGround(WorldAssets assets)
+        {
+            // WO-08: 1200 x 200 m terrain. Separate banks leave the 1.2 m trench visible down to its floor.
+            var ground = new GameObject("Ground");
+            const float length = 1200, width = 200, corridor = WorldUnits.TrenchWidth;
+            for (var side = -1; side <= 1; side += 2)
+                WorldDrawing.Box(side < 0 ? "FarBank" : "NearBank", ground.transform, new Vector3(500, -1, side * (width + corridor) / 4),
+                    new Vector3(length, 2, (width - corridor) / 2), assets.soil);
+            WorldDrawing.Box("Subsoil", ground.transform, new Vector3(500, -2.1f, 0), new Vector3(length, 0.2f, width), assets.soil);
+            WorldDrawing.Box("BeforeTrench", ground.transform, new Vector3(-50, -1, 0), new Vector3(100, 2, corridor), assets.soil);
+            // Initial slice length; stations beyond it are generated when a longer stage loads.
+            WorldDrawing.Box("Road", null, new Vector3(460, 0.015f, WorldUnits.RoadZ), new Vector3(980, 0.03f, 8), SiteAssetBuilder.Material("AccessRoad"));
+            new GameObject("TrenchCorridor");
+        }
+        private static GameObject Board(string name, Vector3 position, Vector2 size, WorldAssets assets)
+        {
+            var root = new GameObject(name); root.transform.position = position;
+            WorldDrawing.Box("Face", root.transform, Vector3.zero, new Vector3(size.x, size.y, 0.06f), assets.steel); return root;
+        }
+        private static GameObject BuildPreviewPrefab()
+        {
+            var root = new GameObject("DesktopPreview");
+            try
+            {
+                var preview = root.AddComponent<DesktopPreview>();
+                var cameraObject = new GameObject("DesktopFlyCamera"); cameraObject.transform.SetParent(root.transform, false);
+                preview.previewCamera = cameraObject.AddComponent<Camera>(); preview.previewCamera.nearClipPlane = 0.05f; preview.previewCamera.farClipPlane = 6000;
+                preview.previewCamera.fieldOfView = 65; cameraObject.tag = "MainCamera"; cameraObject.AddComponent<AudioListener>();
+                return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Prefabs + "DesktopPreview.prefab");
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static SiteSky BuildSky(WorldAssets assets, Transform observer)
+        {
+            var sky = new GameObject("SiteSky").AddComponent<SiteSky>(); sky.observer = observer;
+            var rainObject = new GameObject("Rain"); rainObject.transform.SetParent(sky.transform, false);
+            var rain = rainObject.AddComponent<ParticleSystem>(); rain.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
+            var main = rain.main; main.loop = true; main.playOnAwake = false; main.startLifetime = 1.2f; main.startSpeed = 24; main.startSize = 0.035f;
+            main.maxParticles = 1800; main.simulationSpace = ParticleSystemSimulationSpace.World;
+            var emission = rain.emission; emission.rateOverTime = 1000;
+            var shape = rain.shape; shape.shapeType = ParticleSystemShapeType.Box; shape.scale = new Vector3(24, 24, 1);
+            rainObject.transform.rotation = Quaternion.Euler(90, 0, 0);
+            var renderer = rain.GetComponent<ParticleSystemRenderer>(); renderer.sharedMaterial = assets.rain;
+            renderer.renderMode = ParticleSystemRenderMode.Stretch; renderer.lengthScale = 5; renderer.velocityScale = 0.02f;
+            sky.rain = rain; rainObject.SetActive(false);
+            var clouds = new GameObject("TowersSouth"); clouds.transform.SetParent(sky.transform, false); clouds.transform.localPosition = new Vector3(450, 180, -2000);
+            sky.cloudBank = clouds.transform;
+            for (var i = 0; i < 9; i++)
+            {
+                var cloud = new GameObject("Cumulus_" + i); cloud.transform.SetParent(clouds.transform, false);
+                cloud.transform.localPosition = new Vector3((i - 4) * 150, i % 3 * 45, 0);
+                cloud.AddComponent<MeshFilter>().sharedMesh = CloudMesh(); cloud.AddComponent<MeshRenderer>().sharedMaterial = assets.cloud;
+            }
+            clouds.SetActive(false);
+            var dome = GameObject.CreatePrimitive(PrimitiveType.Sphere); dome.name = "SkyInspectDome";
+            dome.transform.SetParent(sky.transform, false); dome.transform.localScale = Vector3.one * 10000;
+            var source = dome.GetComponent<MeshFilter>().sharedMesh; var path = SiteAssetBuilder.Art + "SkyDome.asset";
+            var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
+            if (mesh == null)
+            {
+                mesh = Object.Instantiate(source); mesh.name = "InwardSkyDome"; var triangles = mesh.triangles;
+                for (var i = 0; i < triangles.Length; i += 3) { var a = triangles[i]; triangles[i] = triangles[i + 2]; triangles[i + 2] = a; }
+                mesh.triangles = triangles; mesh.RecalculateNormals(); AssetDatabase.CreateAsset(mesh, path);
+            }
+            Object.DestroyImmediate(dome.GetComponent<Collider>()); Object.DestroyImmediate(dome.GetComponent<Renderer>()); Object.DestroyImmediate(dome.GetComponent<MeshFilter>());
+            dome.AddComponent<MeshCollider>().sharedMesh = mesh; InspectTarget.Attach(dome, "sky"); return sky;
+        }
+        private static Mesh CloudMesh()
+        {
+            var path = SiteAssetBuilder.Art + "Cumulus.asset"; var mesh = AssetDatabase.LoadAssetAtPath<Mesh>(path);
+            if (mesh != null) return mesh;
+            const int edges = 48; var vertices = new Vector3[edges + 1]; var triangles = new int[edges * 3];
+            for (var i = 0; i < edges; i++)
+            {
+                var angle = i * Mathf.PI * 2 / edges; var radius = 1 + 0.12f * Mathf.Cos(angle * 7);
+                vertices[i + 1] = new Vector3(Mathf.Cos(angle) * radius * 170, Mathf.Sin(angle) * radius * 70, 0);
+                triangles[i * 3] = 0; triangles[i * 3 + 1] = (i + 1) % edges + 1; triangles[i * 3 + 2] = i + 1;
+            }
+            mesh = new Mesh { name = "Cumulus", vertices = vertices, triangles = triangles }; mesh.RecalculateNormals(); mesh.RecalculateBounds();
+            AssetDatabase.CreateAsset(mesh, path); return mesh;
+        }
+        [MenuItem("LOB Over/Debug/Screenshot")]
+        public static void Screenshot()
+        {
+            var folder = Path.GetFullPath("Monitor/out/unity"); Directory.CreateDirectory(folder);
+            var path = Path.Combine(folder, "site-" + DateTime.Now.ToString("yyyyMMdd-HHmmss") + ".png");
+            ScreenCapture.CaptureScreenshot(path); Debug.Log("Screenshot: " + path);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/Director/Director.cs b/Assets/LOBOver/Runtime/Director/Director.cs
new file mode 100644
index 0000000000000000000000000000000000000000..741b04ccc9c6460eaf8b8105818468001ba1a6f8
--- /dev/null
+++ b/Assets/LOBOver/Runtime/Director/Director.cs
@@ -0,0 +1,197 @@
+using System;
+using System.Collections;
+using System.IO;
+using System.Linq;
+using LOBOver.Sim;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using UnityEngine;
+using Simulation = LOBOver.Sim.Sim;
+
+namespace LOBOver.Runtime
+{
+    public sealed class Director : MonoBehaviour
+    {
+        public string scenarioId = "slice_texas";
+        public bool autoStart = true;
+        public SiteView SiteView { get; private set; }
+        public PlanView PlanView { get; private set; }
+        public JObject Job { get; private set; }
+        public JObject MachineCatalog { get; private set; }
+        public JArray Lines { get; private set; }
+        public double DeadlineDay { get; private set; }
+        public double TimeDays => simulation == null ? 0 : simulation.T;
+        // Same day boundary as Common.DisplayDay; view snapshots use simulation time instead.
+        public int DisplayDay => (int)Math.Floor(TimeDays + 1e-6) + 1;
+        public string Speed => simulation == null ? "paused" : simulation.Speed;
+        public bool Ready => simulation != null;
+        public bool Done => simulation != null && simulation.Done;
+        public string LoadError { get; private set; }
+        public string TranscriptPath { get; private set; }
+        public event Action Loaded;
+        public event Action<SiteView, PlanView> ViewsChanged;
+        public event Action<JObject> Message;
+        public event Action<JObject> Event;
+        public event Action<JObject> Voice;
+        public event Action<JObject> Result;
+
+        private Simulation simulation;
+        private Scenario scenario;
+        private Catalog catalog;
+        private Autoplan autoplan;
+        private Pacer pacer;
+        private Coroutine loading;
+        private double secondsFull, secondsSlow;
+        private JObject transcript;
+        private JArray snapshots, messages, commands;
+        private int lastSnapshot = -1;
+        private bool savedResult;
+
+        private void OnEnable() { if (!Ready && loading == null) Load(scenarioId); }
+
+        // Public Start is also Unity's lifecycle method. A slow Android load is started by OnEnable.
+        public void Start()
+        {
+            if (simulation == null || simulation.Done) return;
+            Apply("facilitator", new JObject { ["action"] = "start" });
+            Publish();
+        }
+        public void Pause()
+        {
+            if (simulation == null) return;
+            Apply("facilitator", new JObject { ["action"] = "pause" });
+            Publish(); SaveTranscript();
+        }
+        public void Reset()
+        {
+            if (scenario == null) return;
+            SaveTranscript(); Initialize();
+        }
+        public void Load(string id)
+        {
+            if (id != "slice_texas" && id != "stage1_texas" && id != "stage2_texas")
+                throw new ArgumentException("Unknown scenario: " + id, nameof(id));
+            SaveTranscript();
+            if (loading != null) StopCoroutine(loading);
+            pacer?.Close(); simulation = null; SiteView = null; PlanView = null;
+            scenarioId = id; LoadError = null;
+            loading = StartCoroutine(LoadFiles());
+        }
+        private IEnumerator LoadFiles()
+        {
+            string catalogText = null, scenarioText = null, scriptText = null;
+            Action<string> failed = error => { LoadError = error; Debug.LogError(error, this); };
+            yield return StreamingData.ReadText("Data/catalog.json", value => catalogText = value, failed);
+            if (LoadError != null) yield break;
+            yield return StreamingData.ReadText("Data/Scenarios/" + scenarioId + ".json", value => scenarioText = value, failed);
+            if (LoadError != null) yield break;
+            var script = scenarioId == "slice_texas" ? "slice_autoplan" : scenarioId == "stage1_texas" ? "stage1_pm_play" : "stage2_pull_play";
+            yield return StreamingData.ReadText("Data/scripts/" + script + ".json", value => scriptText = value, failed);
+            if (LoadError != null) yield break;
+            try
+            {
+                var source = JObject.Parse(scenarioText);
+                catalog = Catalog.Load(catalogText); scenario = Scenario.Load(scenarioText, catalog);
+                Job = (JObject)source["job"].DeepClone();
+                MachineCatalog = (JObject)JObject.Parse(catalogText)["machines"];
+                Lines = (JArray)source["lines"].DeepClone();
+                DeadlineDay = (double)source["plan"]["deadlineDay"];
+                secondsFull = (double)source["time"]["secondsPerDayFull"];
+                secondsSlow = (double)source["time"]["secondsPerDaySlow"];
+                if (secondsFull <= 0 || secondsSlow <= 0) throw new InvalidDataException("Scenario day lengths must be positive");
+                // Autoplan removes Site entries; the presenter retains every Site verb.
+                autoplan = new Autoplan(JArray.Parse(scriptText));
+                Initialize();
+            }
+            catch (Exception error) { failed(error.ToString()); }
+            loading = null;
+        }
+        private void Initialize()
+        {
+            pacer?.Close(); simulation = Simulation.Create(scenario, catalog); autoplan.Reset();
+            snapshots = new JArray(); messages = new JArray(); commands = new JArray();
+            transcript = new JObject { ["scenario"] = scenarioId, ["snapshots"] = snapshots,
+                ["messages"] = messages, ["commands"] = commands, ["result"] = null };
+            TranscriptPath = Path.Combine(Application.persistentDataPath, "transcripts",
+                scenarioId + "-" + DateTime.UtcNow.ToString("yyyyMMdd-HHmmss-fff") + ".json");
+            lastSnapshot = -1; savedResult = false;
+            pacer = new Pacer(() => simulation, AfterTick);
+            Loaded?.Invoke();
+            autoplan.Advance(simulation.T, Apply);
+            if (autoStart) Start(); else Publish();
+            Drain(); CaptureDay();
+        }
+        private void Update()
+        {
+            if (simulation == null) return;
+            // Pacer's 5/20-second day cadence is scaled to the scenario's full/slow seconds per day.
+            var baselineMs = (Speed == "slow" ? Pacer.SLOW_MS : Pacer.FULL_MS) / Pacer.STEP_DAYS;
+            var authoredMs = (Speed == "slow" ? secondsSlow : secondsFull) * 1000;
+            pacer.Advance(UnityEngine.Time.unscaledDeltaTime * 1000 * baselineMs / authoredMs);
+            Publish();
+        }
+        private void AfterTick()
+        {
+            autoplan.Advance(simulation.T, Apply); Drain(); CaptureDay();
+            if (simulation.Done && !savedResult) { savedResult = true; SaveTranscript(); }
+        }
+        private void Apply(string seat, JObject command)
+        {
+            var reply = simulation.Apply(seat, command);
+            commands.Add(new JObject { ["t"] = simulation.T, ["seat"] = seat, ["cmd"] = command.DeepClone() });
+            var acknowledgement = JObject.FromObject(reply);
+            acknowledgement["t"] = reply.Ok ? "ack" : "nack";
+            acknowledgement["id"] = command["id"];
+            messages.Add(new JObject { ["t"] = simulation.T, ["message"] = acknowledgement });
+            // Only the initiating seat receives its rejection text.
+            if (seat == "site") Message?.Invoke(acknowledgement);
+            Drain();
+        }
+        public void Send(JObject command)
+        {
+            if (simulation == null || command == null) return;
+            Apply("site", command); Publish();
+        }
+        public static bool ForSeat(JObject message, string seat) =>
+            message["seats"] is JArray seats && seats.Any(value => (string)value == seat);
+        private void Drain()
+        {
+            foreach (var message in simulation.Drain())
+            {
+                messages.Add(new JObject { ["t"] = message["day"] ?? new JValue(simulation.T), ["message"] = message.DeepClone() });
+                Message?.Invoke(message);
+                if ((string)message["t"] == "event") Event?.Invoke(message);
+                if ((string)message["t"] == "voice") Voice?.Invoke(message);
+                if ((string)message["t"] == "result") Result?.Invoke(message);
+            }
+        }
+        private void Publish()
+        {
+            SiteView = SiteView.From(simulation.View("site"));
+            PlanView = PlanView.From(simulation.View("plan"));
+            ViewsChanged?.Invoke(SiteView, PlanView);
+        }
+        private void CaptureDay()
+        {
+            var day = (int)Math.Floor(simulation.T + 1e-6);
+            if (day == lastSnapshot) return;
+            snapshots.Add(simulation.View("facilitator")); lastSnapshot = day;
+            SaveTranscript();
+        }
+        public void SaveTranscript()
+        {
+            if (transcript == null || simulation == null) return;
+            transcript["result"] = simulation.Result;
+            try
+            {
+                Directory.CreateDirectory(Path.GetDirectoryName(TranscriptPath));
+                File.WriteAllText(TranscriptPath, transcript.ToString(Formatting.Indented));
+            }
+            catch (IOException error) { Debug.LogWarning("Transcript: " + error.Message, this); }
+            catch (UnauthorizedAccessException error) { Debug.LogWarning("Transcript: " + error.Message, this); }
+        }
+        private void OnApplicationPause(bool paused) { if (paused) SaveTranscript(); }
+        private void OnDisable() { SaveTranscript(); }
+        private void OnDestroy() { pacer?.Close(); }
+    }
+}
