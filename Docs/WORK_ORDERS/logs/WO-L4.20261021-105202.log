from pathlib import Path
import struct,zlib
for path in Path('../LOB-Game/Assets/3D_Models/Tree').rglob('*.fbx'):
    data=path.read_bytes()
    if not data.startswith(b'Kaydara FBX Binary'):
        print(path.name, 'ASCII FBX; Editor will count triangles'); continue
    version=struct.unpack_from('<I',data,23)[0]
    fmt='<QQQB' if version>=7500 else '<IIIB'; header=struct.calcsize(fmt); totals=[0]
    def nodes(start,end):
        pos=start
        while pos+header<=end:
            stop,props,plen,nlen=struct.unpack_from(fmt,data,pos)
            if stop==0: break
            name=data[pos+header:pos+header+nlen].decode(errors='replace'); cur=pos+header+nlen
            if name=='PolygonVertexIndex' and data[cur:cur+1]==b'i':
                count,encoding,length=struct.unpack_from('<III',data,cur+1)
                raw=data[cur+13:cur+13+length]
                if encoding: raw=zlib.decompress(raw)
                indices=struct.unpack('<'+'i'*count,raw)
                totals[0]+=count-2*sum(v<0 for v in indices)
            child=pos+header+nlen+plen
            if child<stop: nodes(child,stop)
            pos=stop
    nodes(27,len(data))
    print(path.name, totals[0], 'triangles from FBX polygons')
