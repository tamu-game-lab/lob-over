        private static readonly string[] MoodClips = { "Idle", "IdleAlternate", "Drink", "EquipmentCheck" };
        private static readonly float[] MoodSpeeds = { 1, 0.9f, 0.8f, 0.7f };
        private void OnEnable()
        {
            if (engine != null && engine.clip != null) engine.Play();
            if (argument != null && argument.clip != null) argument.Play();
            if (Status == "working" && effects != null)
                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Play();
        }

        public void Initialize(string id, WorldAssets source)
        {
            Id = id; assets = source; name = "Crew_" + id;
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i] = Instantiate(assets.worker, transform).transform; workers[i].name = i == 0 ? "Foreman" : "Worker";
                animators[i] = workers[i].GetComponentInChildren<Animator>();
                if (animators[i] != null) { animators[i].applyRootMotion = false; animators[i].cullingMode = AnimatorCullingMode.AlwaysAnimate; }
                InspectTarget.Attach(workers[i].gameObject, "crew");
            }
            effects = Instantiate(assets.particles, transform); effects.name = "WorkParticles";
            particles = effects.GetComponentInChildren<ParticleSystem>();
            foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>()) effect.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
            plate = WorldDrawing.Text("MachinePlate", transform, new Vector3(-1, 2.5f, 1), new Vector2(4, 0.5f), 0.25f, assets.font);
            plate.transform.localRotation = Quaternion.Euler(0, 180, 0);
            engine = WorldDrawing.Sound(gameObject, true); argument = WorldDrawing.Sound(gameObject, true, 35);
        }
        public void Apply(CrewView view)
        {
            var machineChanged = machine == null || !string.Equals(MachinePlate, view.machinePlate, StringComparison.OrdinalIgnoreCase);
            if (machineChanged)
            {
                var item = assets.Machine(Id, view.machinePlate);
                if (item == null) throw new InvalidOperationException("No imported machine for " + Id + "/" + view.machinePlate);
                WorldDrawing.Remove(machine); machine = Instantiate(item.prefab, transform); machine.name = "Machine";
                InspectTarget.Attach(machine, "machine"); machineAnimators = machine.GetComponentsInChildren<Animator>();
                foreach (var animator in machineAnimators) animator.applyRootMotion = false;
                MachinePlate = view.machinePlate; plate.text = item.label;
            }
            var next = new Vector3((float)view.stationFt * WorldUnits.MetresPerFoot, 0, 0);
            if (view.status == "demobilized") next += new Vector3(-WorldUnits.DemobBackMetres, 0, WorldUnits.RoadZ);
            if (!positioned || Math.Abs(view.stationFt - StationFt) > WorldUnits.StationFeet)
            { transform.localPosition = next; movementVelocity = Vector3.zero; positioned = true; }
            target = next;
            StationFt = view.stationFt; MoodLevel = Mathf.Clamp((int)view.moodLevel, 0, 3);
            if (Status != view.status || machineChanged)
            {
                Status = view.status; statusTime = 0; Debug.Log(name + " " + Status, this);
                var working = Status == "working";
                foreach (var animator in machineAnimators)
                {
                    animator.speed = working ? 1 : 0;
                    var cycle = Id == "exc" ? "Dig" : "Cycle";
                    if (working && animator.runtimeAnimatorController != null && animator.HasState(0, Animator.StringToHash(cycle))) animator.Play(cycle, 0, 0);
                }
                foreach (var effect in effects.GetComponentsInChildren<ParticleSystem>())
                    if (working && Application.isPlaying && effect.gameObject.activeInHierarchy) effect.Play(); else effect.Stop(true, ParticleSystemStopBehavior.StopEmitting);
                WorldDrawing.Loop(engine, working ? (Id == "exc" ? assets.excavation : Id == "back" ? assets.dozer : assets.idle) : Status == "demobilized" ? null : assets.idle);
                WorldDrawing.Loop(argument, Status == "arguing" ? assets.conflict : null);
            }
            ApplyAnimations();
        }
        public void FaceArgument(Transform other)
        {
            partner = other;
            SetWorkerTargets();
        }
        private void SetWorkerTargets()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                // WO-08: workers stand 2 metres behind the working edge on the road side.
                var goal = transform.parent.TransformPoint(target + new Vector3(-2, 0, 2 + i));
                if (i == 0 && Status == "arguing" && partner != null)
                {
                    var other = partner.GetComponent<CrewRig>();
                    var midpoint = (target + other.target) / 2;
                    var side = string.CompareOrdinal(Id, other.Id) < 0 ? -1 : 1;
                    goal = transform.parent.TransformPoint(midpoint + new Vector3(side * 0.65f, 0, 3));
                }
                workerTargets[i] = goal;
            }
        }
        private void Update()
        {
            if (!positioned) return;
            statusTime += Time.deltaTime;
            // A continuous target must not restart a tween on every frame. Four damping periods
            // settle a state change within the WO's half-second presentation interval.
            transform.localPosition = Vector3.SmoothDamp(transform.localPosition, target, ref movementVelocity, WorldUnits.PoseSeconds / 4);
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i].position = Vector3.SmoothDamp(workers[i].position, workerTargets[i], ref workerVelocities[i], WorldUnits.PoseSeconds / 4);
                var facing = Status == "held" ? transform.parent.forward : transform.parent.right;
                if (i == 0 && Status == "arguing" && partner != null)
                    facing = partner.GetComponent<CrewRig>().Foreman.position - workers[i].position;
                facing.y = 0;
                if (facing.sqrMagnitude > 0.001f) workers[i].rotation = Quaternion.LookRotation(facing);
            }
            ApplyAnimations();
        }
        public void SnapPose()
        {
            if (!positioned) return;
            transform.localPosition = target; movementVelocity = Vector3.zero;
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            { workers[i].position = workerTargets[i]; workerVelocities[i] = Vector3.zero; }
        }
        private bool ClipFinished(int index) => animators[index] == null || !animators[index].isActiveAndEnabled
            || animators[index].GetCurrentAnimatorStateInfo(0).normalizedTime >= 1;
        private void ApplyAnimations()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                var clip = MoodClips[MoodLevel];
                if (Status == "working") clip = ((int)(statusTime / WorkingAlternateSeconds) + i) % 2 == 0 ? "Walk" : "Inspect";
                else if (Status == "held" && MoodLevel == 0) clip = "IdleAlternate";
                else if (Status == "stopped" && (statusTime == 0 || clips[i] == "SignalHalt" && !ClipFinished(i))) clip = "SignalHalt";
                else if (Status == "arguing") clip = i == 0 && string.CompareOrdinal(Id, partner == null ? "" : partner.GetComponent<CrewRig>().Id) < 0 ? "ConflictTalk" : "TalkAlternate";
                else if (Status == "demobilized") clip = "Shelter";
                else if (MoodLevel == 3 && statusTime >= PointPeriodSeconds && statusTime % PointPeriodSeconds < 1) clip = "SignalPoint";
                if (clips[i] != clip)
                {
                    clips[i] = clip;
                    if (animators[i] != null && animators[i].runtimeAnimatorController != null && animators[i].HasState(0, Animator.StringToHash(clip)))
                        animators[i].Play(clip, 0, 0);
                }
                if (animators[i] != null) animators[i].speed = clip == MoodClips[MoodLevel] ? MoodSpeeds[MoodLevel] : 1;
            }
        }
    }
}
using System.Collections.Generic;
using System.Linq;
#if UNITY_EDITOR || !UNITY_ANDROID
using LOBOver.Runtime;
#endif
using LOBOver.Sim;
using Newtonsoft.Json.Linq;
using TMPro;
using UnityEngine;

namespace LOBOver.World
{
    public sealed class SiteWorld : MonoBehaviour
    {
#if UNITY_EDITOR || !UNITY_ANDROID
        public Director director;
        public PlanPanel planPanel;
#endif
        public WorldAssets assets;
        public TrailerBoard trailerBoard;
        public JobSign jobSign;
        public SiteSky sky;
        public TextMeshPro gateText;
        public Transform truck;
        public SiteView CurrentView { get; private set; }
        public int CellCount => cells.Count;
        public int BoardCount => boards.Count;
        public int CrewCount => crews.Count;
        public double LengthFt { get; private set; }
        private readonly Dictionary<int, StationCell> cells = new Dictionary<int, StationCell>();
        private readonly Dictionary<int, Transform> stakes = new Dictionary<int, Transform>();
        private readonly Dictionary<int, ZoneBoard> boards = new Dictionary<int, ZoneBoard>();
        private readonly Dictionary<string, CrewRig> crews = new Dictionary<string, CrewRig>();
        private JArray zones;
        private Transform generated;
        public StationCell CellAt(int feet) => cells.TryGetValue(Mathf.FloorToInt(feet / WorldUnits.StationFeet) * (int)WorldUnits.StationFeet, out var cell) ? cell : null;
        public CrewRig Crew(string id) => crews.TryGetValue(id, out var crew) ? crew : null;
        public Transform StakeAt(int feet) => stakes.TryGetValue(feet, out var stake) ? stake : null;
        public ZoneBoard Board(int zone) => boards.TryGetValue(zone, out var board) ? board : null;
        public int ZoneAt(double feet) => (int)zones.OfType<JObject>().First(z => feet >= (double)z["fromFt"] && (feet < (double)z["toFt"] || feet == LengthFt))["id"];

#if UNITY_EDITOR || !UNITY_ANDROID
        private void OnEnable()
        {
            if (director == null) return;
            director.Loaded += OnLoaded; director.ViewsChanged += OnViews; director.Result += OnResult;
            if (director.Ready) { OnLoaded(); if (director.SiteView != null) OnViews(director.SiteView, director.PlanView); }
        }
        private void OnDisable()
        {
            if (director == null) return;
            director.Loaded -= OnLoaded; director.ViewsChanged -= OnViews; director.Result -= OnResult;
        }
        private void OnLoaded() => Configure(director.Job, director.DeadlineDay);
        private void OnViews(SiteView site, PlanView plan)
        {
            Apply(site, director.DisplayDay); planPanel.Apply(plan, director.TimeDays);
        }
        private void OnResult(JObject value) => planPanel.ShowResult(value);
#endif
        public void Configure(JObject job, double deadline)
        {
            if (generated != null) WorldDrawing.Remove(generated.gameObject);
            generated = WorldDrawing.Group("GeneratedSite", transform).transform;
            cells.Clear(); stakes.Clear(); boards.Clear(); crews.Clear(); CurrentView = null;
            LengthFt = (double)job["lengthFt"]; zones = (JArray)job["zones"].DeepClone();
            if (jobSign != null && job["sign"] is JObject sign) jobSign.Apply(sign);
            var boundaries = zones.OfType<JObject>().ToDictionary(z => (int)z["id"], z => (double)z["fromFt"]);
            if (trailerBoard != null) trailerBoard.Configure(assets, LengthFt, deadline, boundaries);
#if UNITY_EDITOR || !UNITY_ANDROID
            if (planPanel != null) planPanel.Configure(assets, LengthFt, deadline);
#endif
            if (sky != null) { if (sky.State != null) sky.Apply("clear"); else sky.Configure(assets); }
        }
        public void Apply(SiteView view, int displayDay)
        {
            if (generated == null) throw new System.InvalidOperationException("Configure SiteWorld before applying a view");
            if (cells.Count == 0) Build(view);
            CurrentView = view;
            foreach (var cell in view.trench) if (cells.TryGetValue((int)cell.stationFt, out var target)) target.Apply(cell);
            foreach (var crew in view.crews) crews[crew.id].Apply(crew);
            var arguing = WorldUnits.CrewIds.Select(id => crews[id]).Where(crew => crew.Status == "arguing").ToArray();
            foreach (var crew in crews.Values) crew.FaceArgument(arguing.FirstOrDefault(other => other != crew && crew.Status == "arguing")?.transform);
            foreach (var board in view.boards) boards[(int)board.zone].Apply(board);
            if (sky != null) sky.Apply(view.sky);
            if (gateText != null) gateText.text = "Trucks waiting: " + view.gate.trucksWaiting;
            if (truck != null) truck.localPosition = new Vector3((float)view.truck.stationFt * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
            if (trailerBoard != null) trailerBoard.Apply(view, displayDay);
        }
        private void Build(SiteView view)
        {
            foreach (var sample in view.trench)
            {
                // The endpoint is a stake, not an extra 100 ft of trench.
                if (sample.stationFt >= LengthFt) continue;
                var cell = Instantiate(assets.cellPrefab, generated); cell.Initialize(sample.stationFt, assets);
                cells[(int)sample.stationFt] = cell; stakes[(int)sample.stationFt] = cell.stake;
                var spoil = Instantiate(assets.spoil, generated); spoil.name = "Spoil_" + (int)sample.stationFt;
                spoil.transform.localPosition = new Vector3((float)sample.stationFt * WorldUnits.MetresPerFoot + WorldUnits.CellLength / 2, 0, -3);
            }
            var endpoint = WorldDrawing.Box("Stake_" + (int)LengthFt, generated, new Vector3((float)LengthFt * WorldUnits.MetresPerFoot, 0.55f, 1.2f), new Vector3(0.08f, 1.1f, 0.08f), assets.timber);
            var label = WorldDrawing.Text("Station", endpoint.transform, new Vector3(0, 0.6f, 0), new Vector2(1.5f, 0.4f), 0.3f, assets.font);
            // Text cannot inherit the thin post's scale.
            label.transform.SetParent(generated, true); label.transform.localScale = Vector3.one;
            label.transform.localPosition = endpoint.transform.localPosition + Vector3.up * 0.6f; label.transform.localRotation = Quaternion.Euler(0, 180, 0);
            label.text = WorldUnits.Station(LengthFt); stakes[(int)LengthFt] = endpoint.transform;
            foreach (var zone in zones.OfType<JObject>())
            {
                var root = WorldDrawing.Group("ZoneBoard", generated); root.transform.localPosition = new Vector3((float)zone["fromFt"] * WorldUnits.MetresPerFoot, 0, 1.8f);
                root.transform.localRotation = Quaternion.Euler(0, 180, 0);
                WorldDrawing.Box("Post", root.transform, new Vector3(0, 1, 0), new Vector3(0.1f, 2, 0.1f), assets.timber);
                var face = WorldDrawing.Box("Board", root.transform, new Vector3(0, 1.8f, 0), new Vector3(1, 1.5f, 0.06f), assets.steel);
                InspectTarget.Attach(face, "board"); var board = root.AddComponent<ZoneBoard>();
                board.label = WorldDrawing.Text("Permit", root.transform, new Vector3(0, 1.8f, -0.05f), new Vector2(0.9f, 1.3f), 0.12f, assets.font);
                board.Initialize((int)zone["id"]); boards[board.Zone] = board;
            }
            foreach (var id in WorldUnits.CrewIds)
            { var crew = Instantiate(assets.crewPrefab, generated); crew.Initialize(id, assets); crews[id] = crew; }
        }
    }
}
using LOBOver.Client;
using LOBOver.World;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class HostWorldPresenter : MonoBehaviour
    {
        public HostConnection connection;
        public SiteWorld world;
        public bool Frozen { get; set; }
        private string configuredRun, configuredStage;
        private object appliedView;
        private void Update() => Present();
        public void Present()
        {
            if (Frozen || connection.View == null || connection.Job == null) return;
            if (world.CurrentView == null || configuredRun != connection.RunId || configuredStage != connection.ScenarioId)
            {
                // Geometry comes from the host's public Site project, never a local scenario/simulator.
                world.Configure(connection.Job, 0);
                configuredRun = connection.RunId; configuredStage = connection.ScenarioId;
                appliedView = null;
            }
            if (ReferenceEquals(appliedView, connection.View)) return;
            world.Apply(connection.View, connection.DisplayDay);
            foreach (var crew in connection.View.crews)
                if (connection.CrewPresence.TryGetValue(crew.id, out var present)) world.Crew(crew.id).gameObject.SetActive(present);
            appliedView = connection.View;
        }
    }
}

