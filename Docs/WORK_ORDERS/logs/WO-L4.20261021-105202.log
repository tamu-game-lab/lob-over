+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using LOBOver.World;
+using TMPro;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering;
+
+namespace LOBOver.Editor
+{
+    public static class SiteMaterialBuilder
+    {
+        public const string Folder = SiteAssetBuilder.Art + "Materials/";
+        private static readonly Dictionary<Material, Material> Copies = new Dictionary<Material, Material>();
+        private static SiteTextureBuilder.Layer dirt, gravel, grass;
+        private static WorldAssets assets;
+        public static void Prepare(WorldAssets target)
+        {
+            assets = target; Copies.Clear(); Directory.CreateDirectory(Folder); Directory.CreateDirectory(SiteTextureBuilder.Folder);
+            AssetDatabase.Refresh(); dirt = SiteTextureBuilder.FindLayer("Dirt"); gravel = SiteTextureBuilder.FindLayer("Gravel"); grass = SiteTextureBuilder.FindLayer("Grass");
+            assets.soil = Surface("Soil", Color.white, dirt, true);
+            assets.road = Surface("AccessRoad", Color.white, gravel, true);
+            assets.ground = Surface("Ground", Color.white, dirt, true); assets.ground.EnableKeyword("_SPLAT"); assets.ground.SetFloat("_Splat", 1);
+            assets.ground.SetTexture("_GravelMap", gravel.albedo); assets.ground.SetTexture("_GravelNormal", gravel.normal); assets.ground.SetTexture("_GravelMask", gravel.mask);
+            assets.ground.SetTexture("_GrassMap", grass.albedo); assets.ground.SetTexture("_GrassNormal", grass.normal); assets.ground.SetTexture("_GrassMask", grass.mask);
+            assets.timber = Surface("Timber", new Color(0.60f, 0.43f, 0.24f), dirt);
+            assets.timber.SetTextureScale("_BaseMap", new Vector2(0.25f, 4));
+            assets.steel = Surface("StorageSteel", new Color(0.39f, 0.43f, 0.45f), gravel); assets.steel.SetFloat("_Metallic", 0.7f); assets.steel.DisableKeyword("_METALLICSPECGLOSSMAP");
+            assets.cabin = Surface("Repair_SiteCabin", new Color(0.74f, 0.72f, 0.64f), gravel);
+            assets.cabin.SetTextureScale("_BaseMap", new Vector2(4, 0.25f));
+            assets.glass = Surface("CabinWindow", new Color(0.09f, 0.15f, 0.18f), dirt); assets.glass.SetFloat("_Smoothness", 0.9f);
+            assets.orange = Surface("SafetyOrange", new Color(0.95f, 0.36f, 0.045f), dirt);
+            assets.flagging = Surface("PinkFlagging", new Color(1, 0.12f, 0.46f), dirt);
+            assets.trench = Surface("TrenchWall", Color.white, dirt, true);
+            var trenchPath = SiteAssetBuilder.Imported + "3D_Models/sophiaImports/";
+            var trenchAlbedo = Texture(trenchPath, "AlbedoTransparency");
+            if (trenchAlbedo != null)
+            {
+                assets.trench.SetTexture("_BaseMap", trenchAlbedo);
+                assets.trench.SetTexture("_BumpMap", SiteTextureBuilder.LinearCopy(Texture(trenchPath, "Normal"), true) ?? dirt.normal);
+                assets.trench.SetTexture("_MetallicGlossMap", SiteTextureBuilder.LinearCopy(Texture(trenchPath, "MetallicSmoothness"), false) ?? dirt.mask);
+            }
+            else Debug.LogWarning("WO-L4: sophiaImports is not imported yet; trench uses authored dirt until the next Play Scene build.");
+            assets.bedding = Surface("Bedding", Color.white, gravel, true);
+            // The supplied trench maps also cover the bed; gravel remains the physical bed geometry.
+            if (trenchAlbedo != null) CopySurface(assets.trench, assets.bedding);
+            assets.backfill = Surface("DisturbedBackfill", new Color(0.8f, 0.72f, 0.62f), dirt, true);
+            assets.wetSoil = Surface("WetTrench", new Color(0.2f, 0.19f, 0.17f), dirt, true); CopySurface(assets.trench, assets.wetSoil);
+            assets.wetSoil.SetFloat("_Smoothness", 0.8f);
+            assets.waterSurface = Surface("StandingWater", new Color(0.06f, 0.085f, 0.09f), dirt, true);
+            assets.waterSurface.SetFloat("_Smoothness", 0.95f); assets.waterSurface.SetFloat("_BumpScale", 0.08f);
+            assets.waterSurface.DisableKeyword("_METALLICSPECGLOSSMAP"); assets.waterSurface.SetFloat("_Metallic", 0.35f);
+            assets.spoilSurface = Surface("Spoil", Color.white, dirt, true);
+            var sand = SiteAssetBuilder.Imported + "3D_Models/a-pile-of-sand/";
+            assets.spoilSurface.SetTexture("_BaseMap", Texture(sand, "albedo") ?? dirt.albedo);
+            assets.spoilSurface.SetTexture("_BumpMap", SiteTextureBuilder.LinearCopy(Texture(sand, "NormalsMap"), true) ?? dirt.normal);
+            assets.spoilSurface.SetTexture("_OcclusionMap", SiteTextureBuilder.LinearCopy(Texture(sand, "occlusion"), false) ?? dirt.mask); assets.spoilSurface.EnableKeyword("_OCCLUSIONMAP");
+            assets.ink = Particle("Dust", new Color(0.65f, 0.54f, 0.40f, 0.4f));
+            assets.rain = Particle("Rain", new Color(0.6f, 0.67f, 0.7f, 0.3f));
+            assets.siteText = Surface("SiteLettering", new Color(0.96f, 0.95f, 0.88f), dirt);
+            assets.siteText.SetTexture("_BaseMap", assets.font.atlasTexture); assets.siteText.SetTexture("_MainTex", assets.font.atlasTexture);
+            assets.siteText.SetFloat("_GradientScale", assets.font.material.GetFloat("_GradientScale"));
+            assets.siteText.EnableKeyword("_ALPHATEST_ON"); assets.siteText.SetFloat("_AlphaClip", 1); assets.siteText.SetFloat("_Cutoff", 0.45f);
+            assets.siteText.SetTexture("_BumpMap", SiteTextureBuilder.Solid("FlatNormal", new Color(0.5f, 0.5f, 1, 1), false));
+            assets.siteText.DisableKeyword("_METALLICSPECGLOSSMAP");
+            assets.skyMaterial = Sky();
+            // Keep the established converted material identities usable by old prefab references.
+            foreach (var pair in new[] { ("Soil", assets.soil), ("AccessRoad", assets.road), ("Timber", assets.timber),
+                ("StorageSteel", assets.steel), ("Repair_SiteCabin", assets.cabin) })
+            {
+                var old = AssetDatabase.LoadAssetAtPath<Material>(SiteAssetBuilder.Converted + pair.Item1 + ".mat");
+                if (old == null) continue;
+                EditorUtility.CopySerialized(pair.Item2, old); old.name = pair.Item1; EditorUtility.SetDirty(old);
+            }
+        }
+        public static Material Surface(string name, Color color, SiteTextureBuilder.Layer layer = null, bool world = false)
+        {
+            layer ??= dirt;
+            var material = Get(Folder + name + ".mat", "LOBOver/SiteLit");
+            material.shaderKeywords = Array.Empty<string>(); material.SetColor("_BaseColor", color);
+            material.SetTexture("_BaseMap", layer.albedo); material.SetTexture("_BumpMap", layer.normal); material.SetTexture("_MetallicGlossMap", layer.mask);
+            material.SetTextureScale("_BaseMap", Vector2.one); material.SetTextureOffset("_BaseMap", Vector2.zero);
+            material.SetFloat("_Metallic", 0); material.SetFloat("_Smoothness", 0.4f); material.SetFloat("_BumpScale", 1);
+            material.SetFloat("_Splat", 0); material.SetFloat("_World", world ? 1 : 0); material.SetFloat("_TileMetres", Mathf.Min(layer.metres, 4));
+            material.SetFloat("_AlphaClip", 0); material.SetFloat("_UseAlphaMap", 0); material.SetFloat("_Cull", 2);
+            material.EnableKeyword("_METALLICSPECGLOSSMAP"); if (world) material.EnableKeyword("_WORLD");
+            return material;
+        }
+        public static Material Get(string path, string shaderName)
+        {
+            var shader = Shader.Find(shaderName) ?? throw new InvalidOperationException("Missing shader " + shaderName);
+            var material = AssetDatabase.LoadAssetAtPath<Material>(path);
+            if (material == null) { material = new Material(shader); AssetDatabase.CreateAsset(material, path); }
+            material.shader = shader; material.enableInstancing = true; EditorUtility.SetDirty(material); return material;
+        }
+        private static void CopySurface(Material from, Material to)
+        { foreach (var property in new[] { "_BaseMap", "_BumpMap", "_MetallicGlossMap" }) to.SetTexture(property, from.GetTexture(property)); }
+        private static Material Particle(string name, Color color)
+        {
+            var m = Get(Folder + name + ".mat", "Universal Render Pipeline/Particles/Unlit");
+            m.SetTexture("_BaseMap", SiteTextureBuilder.Dust()); m.SetColor("_BaseColor", color);
+            m.SetFloat("_Surface", 1); m.SetFloat("_Blend", 0); m.SetFloat("_ZWrite", 0);
+            m.SetInt("_SrcBlend", (int)BlendMode.SrcAlpha); m.SetInt("_DstBlend", (int)BlendMode.OneMinusSrcAlpha);
+            m.EnableKeyword("_SURFACE_TYPE_TRANSPARENT"); m.SetOverrideTag("RenderType", "Transparent"); m.renderQueue = (int)RenderQueue.Transparent;
+            return m;
+        }
+        public static Texture2D Texture(string folder, string token)
+        {
+            if (!AssetDatabase.IsValidFolder(folder.TrimEnd('/'))) return null;
+            var path = AssetDatabase.FindAssets("t:Texture2D", new[] { folder.TrimEnd('/') }).Select(AssetDatabase.GUIDToAssetPath)
+                .Where(p => Path.GetFileName(p).IndexOf(token, StringComparison.OrdinalIgnoreCase) >= 0).OrderBy(p => p, StringComparer.Ordinal).FirstOrDefault();
+            return path == null ? null : AssetDatabase.LoadAssetAtPath<Texture2D>(path);
+        }
+        public static void Convert(GameObject root)
+        {
+            foreach (var renderer in root.GetComponentsInChildren<Renderer>(true))
+            {
+                if (renderer is ParticleSystemRenderer particle)
+                { particle.sharedMaterial = assets.ink; particle.trailMaterial = assets.ink; continue; }
+                if (renderer.GetComponent<TMP_Text>() is TMP_Text text) { text.fontSharedMaterial = assets.siteText; continue; }
+                renderer.sharedMaterials = renderer.sharedMaterials.Select(Copy).ToArray();
+            }
+        }
+        public static Material Copy(Material source)
+        {
+            if (source == null) return assets.steel;
+            if (source.shader.name == "LOBOver/SiteLit") return source;
+            if (Copies.TryGetValue(source, out var previous)) return previous;
+            AssetDatabase.TryGetGUIDAndLocalFileIdentifier(source, out string guid, out long id);
+            var name = string.Concat(source.name.Select(c => Path.GetInvalidFileNameChars().Contains(c) ? '_' : c));
+            var copy = Get(SiteAssetBuilder.Converted + name + "-Site-" + guid + "-" + id + ".mat", "LOBOver/SiteLit");
+            var baseProperty = source.HasProperty("_BaseMap") ? "_BaseMap" : "_MainTex";
+            var colorProperty = source.HasProperty("_BaseColor") ? "_BaseColor" : "_Color";
+            var folder = Path.GetDirectoryName(AssetDatabase.GetAssetPath(source)).Replace('\\', '/');
+            Texture Map(string property) => source.HasProperty(property) ? source.GetTexture(property) : null;
+            var albedo = Map(baseProperty) ?? Texture(folder, "BaseColor") ?? Texture(folder, "Albedo") ?? dirt.albedo;
+            copy.shaderKeywords = Array.Empty<string>(); copy.SetTexture("_BaseMap", albedo);
+            copy.SetColor("_BaseColor", source.HasProperty(colorProperty) ? source.GetColor(colorProperty) : Color.white);
+            if (source.HasProperty(baseProperty)) { copy.SetTextureScale("_BaseMap", source.GetTextureScale(baseProperty)); copy.SetTextureOffset("_BaseMap", source.GetTextureOffset(baseProperty)); }
+            copy.SetTexture("_BumpMap", SiteTextureBuilder.LinearCopy((Map("_BumpMap") ?? Texture(folder, "Normal")) as Texture2D, true) ?? dirt.normal);
+            var metallic = Map("_MetallicGlossMap"); copy.SetTexture("_MetallicGlossMap", SiteTextureBuilder.LinearCopy(metallic as Texture2D, false) ?? dirt.mask);
+            copy.SetFloat("_Metallic", source.HasProperty("_Metallic") ? source.GetFloat("_Metallic") : 0);
+            copy.SetFloat("_Smoothness", source.HasProperty("_Smoothness") ? source.GetFloat("_Smoothness") : source.HasProperty("_Glossiness") ? source.GetFloat("_Glossiness") : 0.3f);
+            if (metallic != null) { copy.EnableKeyword("_METALLICSPECGLOSSMAP"); if (source.HasProperty("_GlossMapScale")) copy.SetFloat("_Smoothness", source.GetFloat("_GlossMapScale")); }
+            var occlusion = Map("_OcclusionMap") ?? Texture(folder, "Occlusion"); copy.SetTexture("_OcclusionMap", SiteTextureBuilder.LinearCopy(occlusion as Texture2D, false));
+            if (occlusion != null) copy.EnableKeyword("_OCCLUSIONMAP");
+            foreach (var property in new[] { "_BumpMap", "_MetallicGlossMap", "_OcclusionMap" })
+                if (source.HasProperty(property)) { copy.SetTextureScale(property, source.GetTextureScale(property)); copy.SetTextureOffset(property, source.GetTextureOffset(property)); }
+            copy.SetFloat("_World", 0); copy.SetFloat("_Splat", 0); copy.SetFloat("_UseAlphaMap", 0);
+            if (source.IsKeywordEnabled("_ALPHATEST_ON") || source.GetTag("RenderType", false) == "TransparentCutout")
+            { copy.EnableKeyword("_ALPHATEST_ON"); copy.SetFloat("_AlphaClip", 1); copy.SetFloat("_Cull", 0); }
+            Copies.Add(source, copy); return copy;
+        }
+        private static Material Sky()
+        {
+            var sky = Get(Folder + "SiteSky.mat", "LOBOver/SiteSky"); Cubemap cube = null; Material source = null;
+            var paths = AssetDatabase.FindAssets("t:Material", new[] { "Assets" }).Select(AssetDatabase.GUIDToAssetPath)
+                .Where(p => !p.StartsWith(SiteAssetBuilder.Art, StringComparison.Ordinal))
+                .OrderBy(p => p.Contains("Overcast") ? 0 : p.Contains("Epic_BlueSunset") ? 1 : 2).ThenBy(p => p, StringComparer.Ordinal);
+            foreach (var path in paths)
+            {
+                var candidate = AssetDatabase.LoadAssetAtPath<Material>(path);
+                if (candidate == null || candidate.shader == null || candidate.shader.name.IndexOf("Skybox", StringComparison.OrdinalIgnoreCase) < 0) continue;
+                foreach (var property in candidate.GetTexturePropertyNames())
+                    if (candidate.GetTexture(property) is Cubemap found) { cube = found; source = candidate; break; }
+                if (cube != null) break;
+            }
+            sky.SetTexture("_Cube", cube); sky.SetFloat("_UseCube", cube == null ? 0 : 1);
+            sky.SetFloat("_Exposure", source != null && source.HasProperty("_Exposure") ? source.GetFloat("_Exposure") : 1);
+            sky.SetFloat("_Rotation", source != null && source.HasProperty("_Rotation") ? source.GetFloat("_Rotation") : 0);
+            if (cube == null) Debug.LogWarning("WO-L4: no cubemap skybox material found; using the procedural SiteSky sun and clouds.");
+            return sky;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Editor/SiteModelBuilder.cs b/Assets/LOBOver/Editor/SiteModelBuilder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..766015b3f5189373b40f3c99d71c7fea1add7864
--- /dev/null
+++ b/Assets/LOBOver/Editor/SiteModelBuilder.cs
@@ -0,0 +1,156 @@
+using System;
+using System.IO;
+using System.Linq;
+using LOBOver.World;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Editor
+{
+    public static class SiteModelBuilder
+    {
+        private const float ScaleTolerance = 0.25f, WorkerHeight = 1.8f, CabHeight = 3.2f, PipeDiameter = 0.3f; // WO-L4 item 10.
+        private const int TreeTriangleLimit = 8000; // WO-L4 item 6, strict upper bound.
+        public static Bounds Bounds(GameObject root)
+        {
+            var renderers = root.GetComponentsInChildren<Renderer>(true).Where(r => !(r is ParticleSystemRenderer)).ToArray();
+            if (renderers.Length == 0) throw new InvalidOperationException("Imported model has no renderer: " + root.name);
+            var bounds = renderers[0].bounds; foreach (var renderer in renderers.Skip(1)) bounds.Encapsulate(renderer.bounds); return bounds;
+        }
+        public static GameObject Copy(GameObject source, string name, float height = 0, bool pipe = false, WorldAssets assets = null)
+        {
+            if (source == null) throw new FileNotFoundException("Required model " + name);
+            var root = new GameObject(name);
+            try
+            {
+                var model = (GameObject)PrefabUtility.InstantiatePrefab(source); model.transform.SetParent(root.transform, false);
+                if (PrefabUtility.IsPartOfPrefabInstance(model)) PrefabUtility.UnpackPrefabInstance(model, PrefabUnpackMode.Completely, InteractionMode.AutomatedAction);
+                SiteAssetBuilder.StripMissing(model);
+                foreach (var collider in root.GetComponentsInChildren<Collider>(true)) Object.DestroyImmediate(collider);
+                foreach (var light in root.GetComponentsInChildren<Light>(true)) Object.DestroyImmediate(light);
+                var bounds = Bounds(model);
+                if (pipe)
+                {
+                    if (bounds.size.z > bounds.size.x) model.transform.localRotation *= Quaternion.Euler(0, 90, 0);
+                    else if (bounds.size.y > bounds.size.x) model.transform.localRotation *= Quaternion.Euler(0, 0, 90);
+                    bounds = Bounds(model); var diameter = Mathf.Max(bounds.size.y, bounds.size.z);
+                    ScaleLog(name + " outside diameter", diameter, PipeDiameter); model.transform.localScale *= PipeDiameter / diameter;
+                }
+                else if (height > 0)
+                {
+                    var measured = bounds.size.y;
+                    if (name.StartsWith("Excavator", StringComparison.Ordinal))
+                    {
+                        var cab = model.GetComponentsInChildren<Renderer>(true).Where(r => r.name.IndexOf("cab", StringComparison.OrdinalIgnoreCase) >= 0).ToArray();
+                        if (cab.Length > 0) measured = cab.Max(r => r.bounds.max.y) - bounds.min.y;
+                    }
+                    ScaleLog(name + " height", measured, height); model.transform.localScale *= height / Mathf.Max(measured, 0.001f);
+                }
+                bounds = Bounds(model);
+                model.transform.position -= new Vector3(name.StartsWith("Excavator", StringComparison.Ordinal) || name.StartsWith("Crane", StringComparison.Ordinal)
+                    || name.StartsWith("Backfill", StringComparison.Ordinal) ? bounds.max.x : bounds.center.x, bounds.min.y, bounds.center.z);
+                SiteMaterialBuilder.Convert(root); Maps(root, AssetDatabase.GetAssetPath(source), assets);
+                foreach (var renderer in root.GetComponentsInChildren<Renderer>(true))
+                { renderer.receiveShadows = true; renderer.shadowCastingMode = ShadowCastingMode.On; }
+                return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Converted + "Play_" + name + ".prefab");
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static void ScaleLog(string name, float measured, float target)
+        {
+            if (Mathf.Abs(measured / target - 1) > ScaleTolerance)
+                Debug.LogWarning($"WO-L4 scale: {name} was {measured:F3} m; scaled to {target:F3} m (over 25% off).");
+        }
+        public static GameObject Model(string path, string name, float height, WorldAssets assets, bool optional = false, bool pipe = false)
+        {
+            var source = AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Imported + path);
+            if (source == null && optional) { Debug.LogWarning("WO-L4 optional import missing: " + path + "; rerun Play Scene after import."); return null; }
+            return Copy(source, name, height, pipe, assets);
+        }
+        public static void Populate(WorldAssets assets, WorldAssets legacy)
+        {
+            assets.worker = Copy(legacy.worker, "Worker", WorkerHeight, assets: assets);
+            assets.machines = legacy.machines.Select(m => new MachineAsset { crew = m.crew, label = m.label, plate = m.plate,
+                prefab = Copy(m.prefab, m.prefab.name, m.crew == "exc" ? CabHeight : 0, assets: assets) }).ToArray();
+            assets.pipe = Model("3D_Models/pipe/source/PIPE.fbx", "Pipe", 0, assets, pipe: true);
+            assets.spoil = Model("3D_Models/a-pile-of-sand/source/hromada_pisek_01_30k_uw/hromada_pisek_01_30k_uw.FBX", "HeroSpoil", 1, assets);
+            assets.cone = Copy(legacy.cone, "Cone", 0.7f, assets: assets);
+            assets.barrier = Copy(legacy.barrier, "WaterBarrier", 1, assets: assets);
+            const string props = "3D_Models/Construction Assets/Traffic Props/";
+            assets.fence = Model(props + "fence_long/fence_long.obj", "Fence", 1.8f, assets);
+            assets.jersey = Model(props + "jersey_barrier/jersey_barrier.obj", "Jersey", 0.9f, assets);
+            // Convert every material in the four additions, including FBX subassets, without
+            // changing importers or remaps in the read-only LOBGame copies.
+            foreach (var folder in new[] { "Tree", "sophiaImports", "traffic-props", "construction-site-barrier" })
+            {
+                var path = SiteAssetBuilder.Imported + "3D_Models/" + folder;
+                if (!AssetDatabase.IsValidFolder(path)) { Debug.LogWarning("WO-L4 optional import missing: " + path); continue; }
+                foreach (var guid in AssetDatabase.FindAssets("", new[] { path }).OrderBy(g => g, StringComparer.Ordinal))
+                    foreach (var material in AssetDatabase.LoadAllAssetsAtPath(AssetDatabase.GUIDToAssetPath(guid)).OfType<Material>()) SiteMaterialBuilder.Copy(material);
+            }
+            var newFence = Model("3D_Models/traffic-props/source/Traffic Props/Traffic Props/fence_long/fence_long.obj", "AddedFence", 1.8f, assets, true);
+            if (newFence != null) assets.fence = newFence;
+            var newBarrier = Model("3D_Models/construction-site-barrier/source/blocker.fbx", "ConstructionBarrier", 1, assets, true);
+            if (newBarrier != null) assets.barrier = newBarrier;
+            assets.tree = Tree(assets);
+        }
+        public static int Triangles(GameObject model) => model.GetComponentsInChildren<MeshFilter>(true).Sum(f => f.sharedMesh == null ? 0 : Enumerable.Range(0, f.sharedMesh.subMeshCount).Sum(i => (int)f.sharedMesh.GetIndexCount(i) / 3))
+            + model.GetComponentsInChildren<SkinnedMeshRenderer>(true).Sum(r => r.sharedMesh == null ? 0 : r.sharedMesh.triangles.Length / 3);
+        private static GameObject Tree(WorldAssets assets)
+        {
+            var paths = new[] { "Tree 2/fast-urban-tree/source/Fast-tree.fbx", "Tree 2/beech/beech.fbx", "Tree1/tree/source/TreeGenerator.fbx" };
+            var candidate = paths.Select(p => AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Imported + "3D_Models/Tree/" + p))
+                .Where(m => m != null && Triangles(m) > 0 && Triangles(m) < TreeTriangleLimit).OrderBy(Triangles).ThenBy(m => m.name, StringComparer.Ordinal).FirstOrDefault();
+            if (candidate == null) { Debug.LogWarning("WO-L4: no imported tree below 8,000 triangles; tree line omitted until import."); return null; }
+            Debug.Log("WO-L4 tree: " + candidate.name + ", " + Triangles(candidate) + " triangles.");
+            return Copy(candidate, "Tree", assets: assets);
+        }
+        private static void Maps(GameObject root, string path, WorldAssets assets)
+        {
+            if (assets == null) return;
+            if (path.Contains("a-pile-of-sand"))
+            {
+                // The hero keeps its scan UVs; only the procedural windrow uses world tiling.
+                var scan = SiteMaterialBuilder.Get(SiteMaterialBuilder.Folder + "HeroSpoil.mat", "LOBOver/SiteLit");
+                scan.CopyPropertiesFromMaterial(assets.spoilSurface); scan.DisableKeyword("_WORLD"); scan.SetFloat("_World", 0);
+                foreach (var r in root.GetComponentsInChildren<Renderer>()) r.sharedMaterials = r.sharedMaterials.Select(_ => scan).ToArray();
+                return;
+            }
+            var folder = Path.GetDirectoryName(path).Replace('\\', '/');
+            if (path.Contains("/pipe/")) folder = SiteAssetBuilder.Imported + "3D_Models/pipe/textures";
+            if (path.Contains("fast-urban-tree")) folder = SiteAssetBuilder.Imported + "3D_Models/Tree/Tree 2/fast-urban-tree/textures";
+            if (path.Contains("Tree1/tree")) folder = SiteAssetBuilder.Imported + "3D_Models/Tree/Tree1/tree/textures";
+            foreach (var material in root.GetComponentsInChildren<Renderer>().SelectMany(r => r.sharedMaterials).Distinct())
+            {
+                var albedo = SiteMaterialBuilder.Texture(folder, path.Contains("fast-urban-tree") ? "Fastcolor" : "BaseColor") ?? SiteMaterialBuilder.Texture(folder, "Albedo");
+                var normal = SiteMaterialBuilder.Texture(folder, "Normal");
+                if (path.Contains("/beech/"))
+                {
+                    var leaf = material.name.IndexOf("leaf", StringComparison.OrdinalIgnoreCase) >= 0;
+                    albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(folder + (leaf ? "/beech leaf.png" : "/bark01.png"));
+                    normal = SiteMaterialBuilder.Texture(folder, leaf ? "leaf_Normal" : "bark01_normal");
+                }
+                if (albedo != null) { material.SetTexture("_BaseMap", albedo); material.SetColor("_BaseColor", Color.white); }
+                if (normal != null) material.SetTexture("_BumpMap", SiteTextureBuilder.LinearCopy(normal, true));
+                var occlusion = SiteMaterialBuilder.Texture(folder, "Occlusion");
+                if (occlusion != null) { material.SetTexture("_OcclusionMap", SiteTextureBuilder.LinearCopy(occlusion, false)); material.EnableKeyword("_OCCLUSIONMAP"); }
+                if (path.Contains("/pipe/"))
+                {
+                    var metallic = SiteTextureBuilder.LinearCopy(SiteMaterialBuilder.Texture(folder, "Metallic"), false);
+                    var roughness = SiteTextureBuilder.LinearCopy(SiteMaterialBuilder.Texture(folder, "Roughness"), false);
+                    if (metallic != null && roughness != null)
+                    { material.SetTexture("_MetallicGlossMap", SiteTextureBuilder.MetallicRoughness(metallic, roughness)); material.SetFloat("_Smoothness", 1); material.EnableKeyword("_METALLICSPECGLOSSMAP"); }
+                }
+                if (path.Contains("/Tree/"))
+                {
+                    var alpha = SiteMaterialBuilder.Texture(folder, path.Contains("fast-urban-tree") ? "Fastmask" : "leaf_alpha");
+                    material.SetTexture("_AlphaMap", SiteTextureBuilder.LinearCopy(alpha, false)); material.SetFloat("_UseAlphaMap", alpha == null ? 0 : 1);
+                    material.EnableKeyword("_ALPHATEST_ON"); material.SetFloat("_AlphaClip", 1); material.SetFloat("_Cull", 0);
+                }
+                EditorUtility.SetDirty(material);
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Editor/SitePresentationBuilder.cs b/Assets/LOBOver/Editor/SitePresentationBuilder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..bfeff361ce697d4ecec834d2bd3a2552a5778b8b
--- /dev/null
+++ b/Assets/LOBOver/Editor/SitePresentationBuilder.cs
@@ -0,0 +1,137 @@
+using System.IO;
+using LOBOver.World;
+using UnityEditor;
+using UnityEngine;
+using UnityEngine.Rendering;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Editor
+{
+    public static class SitePresentationBuilder
+    {
+        public static readonly Color HorizonColour = new Color(0.68f, 0.73f, 0.75f);
+        public static WorldAssets BuildAssets()
+        {
+            var legacy = SiteAssetBuilder.Required<WorldAssets>(SiteAssetBuilder.Art + "WorldAssets.asset");
+            var path = SiteAssetBuilder.Art + "PlayWorldAssets.asset";
+            var assets = AssetDatabase.LoadAssetAtPath<WorldAssets>(path);
+            if (assets == null) { assets = ScriptableObject.CreateInstance<WorldAssets>(); AssetDatabase.CreateAsset(assets, path); }
+            EditorUtility.CopySerialized(legacy, assets); assets.name = "PlayWorldAssets"; assets.detailedSite = true;
+            Directory.CreateDirectory(SiteAssetBuilder.Converted); AssetDatabase.Refresh();
+            SiteMaterialBuilder.Prepare(assets); SiteModelBuilder.Populate(assets, legacy);
+            assets.groundMesh = SiteGeometryBuilder.Ground(); assets.horizonMesh = SiteGeometryBuilder.HorizonMesh();
+            assets.stripMesh = SiteGeometryBuilder.Strip(); assets.wallNearMesh = SiteGeometryBuilder.Wall(1); assets.wallFarMesh = SiteGeometryBuilder.Wall(-1);
+            assets.slumpMesh = SiteGeometryBuilder.Collapse(); assets.windrowMesh = SiteGeometryBuilder.Windrow();
+            assets.cellPrefab = Cell(assets); assets.crewPrefab = Crew(); assets.particles = Dust(assets);
+            EditorUtility.SetDirty(assets); AssetDatabase.SaveAssets(); return assets;
+        }
+        private static StationCell Cell(WorldAssets assets)
+        {
+            var root = new GameObject("DetailedStationCell");
+            try
+            {
+                var cell = root.AddComponent<StationCell>(); SiteDetailDrawing.Cell(cell, assets);
+                return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Converted + "Play_StationCell.prefab").GetComponent<StationCell>();
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static CrewRig Crew()
+        {
+            var root = new GameObject("DetailedCrewRig"); root.AddComponent<CrewRig>();
+            try { return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Converted + "Play_Crew.prefab").GetComponent<CrewRig>(); }
+            finally { Object.DestroyImmediate(root); }
+        }
+        private static GameObject Dust(WorldAssets assets)
+        {
+            var root = new GameObject("WorkParticles");
+            try
+            {
+                var ps = root.AddComponent<ParticleSystem>(); ps.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
+                var main = ps.main; main.loop = true; main.playOnAwake = false; main.startLifetime = 1.8f;
+                main.startSpeed = 0.35f; main.startSize = new ParticleSystem.MinMaxCurve(0.15f, 0.45f);
+                main.startColor = new Color(0.65f, 0.52f, 0.36f, 0.35f); main.maxParticles = 60;
+                var emission = ps.emission; emission.rateOverTime = 18;
+                var shape = ps.shape; shape.shapeType = ParticleSystemShapeType.Box; shape.scale = new Vector3(2, 0.15f, 1);
+                var alpha = ps.colorOverLifetime; alpha.enabled = true;
+                var gradient = new Gradient(); gradient.SetKeys(new[] { new GradientColorKey(Color.white, 0), new GradientColorKey(Color.white, 1) },
+                    new[] { new GradientAlphaKey(0, 0), new GradientAlphaKey(0.6f, 0.15f), new GradientAlphaKey(0, 1) }); alpha.color = gradient;
+                root.transform.localPosition = new Vector3(-1, 0.2f, 0);
+                var renderer = ps.GetComponent<ParticleSystemRenderer>(); renderer.sharedMaterial = assets.ink;
+                renderer.shadowCastingMode = ShadowCastingMode.Off; renderer.receiveShadows = false;
+                return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Converted + "Play_WorkParticles.prefab");
+            }
+            finally { Object.DestroyImmediate(root); }
+        }
+        public static SiteSky Build(Transform site, WorldAssets assets)
+        {
+            var ground = SiteDetailDrawing.Mesh("Ground", site, assets.groundMesh, assets.ground);
+            SiteDetailDrawing.Mesh("Horizon", site, assets.horizonMesh, assets.ground);
+            // Seal the corridor beyond the longest authored site without covering host-driven cells.
+            var after = SiteDetailDrawing.Mesh("BeyondTrench", site, assets.stripMesh, assets.soil, new Vector3(914.4f, 0, 0));
+            after.transform.localScale = new Vector3((SiteGeometryBuilder.MaxX - 914.4f) / WorldUnits.CellLength, 1, 1);
+            var sky = Sky(site, assets);
+            var trailer = WorldDrawing.Group("Trailer", site).transform; trailer.localPosition = new Vector3(-16, 0, 12);
+            SiteDetailDrawing.Block("Cabin", trailer, new Vector3(0, 1.5f, 0), new Vector3(7, 3, 2.8f), assets.cabin);
+            SiteDetailDrawing.Block("Roof", trailer, new Vector3(0, 3.08f, 0), new Vector3(7.25f, 0.16f, 3), assets.steel);
+            SiteDetailDrawing.Block("DoorFrame", trailer, new Vector3(-1.7f, 1.15f, -1.43f), new Vector3(1.05f, 2.3f, 0.06f), assets.steel);
+            SiteDetailDrawing.Block("Door", trailer, new Vector3(-1.7f, 1.15f, -1.47f), new Vector3(0.9f, 2.18f, 0.025f), assets.cabin);
+            SiteDetailDrawing.Block("DoorHandle", trailer, new Vector3(-1.36f, 1.1f, -1.5f), new Vector3(0.04f, 0.18f, 0.04f), assets.steel);
+            SiteDetailDrawing.Block("WindowFrame", trailer, new Vector3(1.35f, 1.75f, -1.44f), new Vector3(2.1f, 1.25f, 0.08f), assets.steel);
+            SiteDetailDrawing.Block("Window", trailer, new Vector3(1.35f, 1.75f, -1.49f), new Vector3(1.94f, 1.09f, 0.02f), assets.glass);
+            foreach (var x in new[] { -2.5f, 2.5f }) SiteDetailDrawing.Block("Support", trailer, new Vector3(x, 0.12f, 0), new Vector3(0.4f, 0.24f, 2.4f), assets.steel);
+            foreach (var z in new[] { WorldUnits.RoadZ - 3, WorldUnits.RoadZ + 3 })
+                SiteDetailDrawing.Prop(assets.jersey, site, new Vector3(-8, 0, z));
+            if (assets.tree != null)
+            {
+                // WO-L4: fewer than thirty instances, 80..120 m on the far side, with gaps.
+                for (var i = 0; i < 24; i++)
+                {
+                    if (i % 7 == 3) continue;
+                    var tree = SiteDetailDrawing.Prop(assets.tree, site, new Vector3(-70 + i * 49, 0, -80 - i * 17 % 40));
+                    tree.transform.localPosition += Vector3.up * SiteGeometryBuilder.Height(tree.transform.localPosition.x, tree.transform.localPosition.z);
+                    tree.transform.localRotation = Quaternion.Euler(0, i * 137, 0);
+                }
+            }
+            foreach (var renderer in site.GetComponentsInChildren<MeshRenderer>(true))
+            {
+                if (renderer.transform.IsChildOf(sky.transform)) continue;
+                // Trees remain instanced. The ground and cabin are builder-owned static geometry.
+                if (renderer.GetComponentInParent<LODGroup>() != null || renderer.transform.root != site.root) continue;
+                if (!renderer.transform.IsChildOf(trailer) && renderer.gameObject != ground && renderer.name != "Horizon" && renderer.name != "BeyondTrench") continue;
+                GameObjectUtility.SetStaticEditorFlags(renderer.gameObject, StaticEditorFlags.BatchingStatic);
+            }
+            return sky;
+        }
+        private static SiteSky Sky(Transform parent, WorldAssets assets)
+        {
+            var root = WorldDrawing.Group("SiteSky", parent); var sky = root.AddComponent<SiteSky>();
+            var dome = GameObject.CreatePrimitive(PrimitiveType.Sphere); dome.name = "SiteBackdrop"; dome.transform.SetParent(root.transform, false);
+            dome.transform.localPosition = new Vector3(500, 0, 0); dome.transform.localScale = Vector3.one * 10000;
+            Object.DestroyImmediate(dome.GetComponent<Collider>());
+            var renderer = dome.GetComponent<Renderer>(); renderer.sharedMaterial = assets.skyMaterial;
+            renderer.shadowCastingMode = ShadowCastingMode.Off; renderer.receiveShadows = false;
+            sky.dome = dome.transform;
+            sky.cloudBank = WorldDrawing.Group("CloudBank", root.transform).transform;
+            var rain = WorldDrawing.Group("Rain", root.transform).AddComponent<ParticleSystem>();
+            rain.Stop(true, ParticleSystemStopBehavior.StopEmittingAndClear);
+            var main = rain.main; main.loop = true; main.playOnAwake = false; main.startLifetime = 1.2f; main.startSpeed = 24;
+            main.startSize = 0.025f; main.maxParticles = 1200; main.simulationSpace = ParticleSystemSimulationSpace.World;
+            var emission = rain.emission; emission.rateOverTime = 800;
+            var shape = rain.shape; shape.shapeType = ParticleSystemShapeType.Box; shape.scale = new Vector3(24, 24, 1);
+            rain.transform.localRotation = Quaternion.Euler(90, 0, 0);
+            var particles = rain.GetComponent<ParticleSystemRenderer>(); particles.sharedMaterial = assets.rain;
+            particles.renderMode = ParticleSystemRenderMode.Stretch; particles.lengthScale = 5; particles.velocityScale = 0.02f;
+            particles.shadowCastingMode = ShadowCastingMode.Off; sky.rain = rain; rain.gameObject.SetActive(false); return sky;
+        }
+        public static void Lighting(Light sun)
+        {
+            sun.transform.rotation = Quaternion.Euler(48, -35, 0); sun.color = new Color(1, 0.93f, 0.82f);
+            sun.intensity = 1.2f; sun.shadows = LightShadows.Soft; sun.shadowCustomResolution = 2048;
+            RenderSettings.sun = sun; RenderSettings.ambientMode = AmbientMode.Trilight;
+            RenderSettings.ambientSkyColor = new Color(0.49f, 0.59f, 0.70f);
+            RenderSettings.ambientEquatorColor = HorizonColour * 0.65f; RenderSettings.ambientGroundColor = new Color(0.24f, 0.20f, 0.16f);
+            RenderSettings.fog = true; RenderSettings.fogMode = FogMode.Linear; RenderSettings.fogColor = HorizonColour;
+            RenderSettings.fogStartDistance = 300; RenderSettings.fogEndDistance = 2500;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Editor/SiteTextureBuilder.cs b/Assets/LOBOver/Editor/SiteTextureBuilder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ae4d47ef672b2e1c1bca8aa8f9d6992f7ca3216f
--- /dev/null
+++ b/Assets/LOBOver/Editor/SiteTextureBuilder.cs
@@ -0,0 +1,184 @@
+using System;
+using System.IO;
+using System.Linq;
+using UnityEditor;
+using UnityEngine;
+
+namespace LOBOver.Editor
+{
+    public static class SiteTextureBuilder
+    {
+        public const string Folder = SiteAssetBuilder.Art + "Generated/";
+        public const int Size = 1024, DustSize = 256; // WO-L4 item 3.
+        public sealed class Layer
+        {
+            public Texture2D albedo, normal, mask;
+            public float metres = 2;
+        }
+        public static Layer FindLayer(string kind)
+        {
+            // Prefer the named terrain pack, then any authored TerrainLayer with all surface maps.
+            var preferences = kind == "Dirt" ? new[] { "Muddy", "Soil_Rocks", "dirt", "soil", "mud" }
+                : kind == "Gravel" ? new[] { "Pebbles_A", "Pebbles_B", "Pebbles_C", "gravel", "pebbles" }
+                : new[] { "Grass_Dry", "dry_grass", "grass" };
+            var layers = AssetDatabase.FindAssets("t:TerrainLayer", new[] { "Assets" }).Select(AssetDatabase.GUIDToAssetPath)
+                .OrderBy(p => p, StringComparer.Ordinal).Select(AssetDatabase.LoadAssetAtPath<TerrainLayer>).ToArray();
+            foreach (var word in preferences)
+            {
+                var layer = layers.FirstOrDefault(l => l != null && l.diffuseTexture != null && l.normalMapTexture != null
+                    && l.name.IndexOf(word, StringComparison.OrdinalIgnoreCase) >= 0);
+                if (layer != null)
+                    return new Layer { albedo = layer.diffuseTexture, normal = layer.normalMapTexture,
+                        mask = layer.maskMapTexture ?? Solid("DryMask", new Color(0, 1, 0, 0.3f), false), metres = Mathf.Max(1, layer.tileSize.x) };
+            }
+            var textures = AssetDatabase.FindAssets("t:Texture2D", new[] { "Assets" }).Select(AssetDatabase.GUIDToAssetPath)
+                .Where(p => !p.StartsWith(Folder, StringComparison.Ordinal)).OrderBy(p => p, StringComparer.Ordinal).ToArray();
+            foreach (var word in preferences)
+            {
+                var albedo = textures.FirstOrDefault(p => Path.GetFileName(p).IndexOf(word, StringComparison.OrdinalIgnoreCase) >= 0
+                    && (p.IndexOf("basecolor", StringComparison.OrdinalIgnoreCase) >= 0 || p.IndexOf("albedo", StringComparison.OrdinalIgnoreCase) >= 0));
+                if (albedo == null) continue;
+                var normal = textures.FirstOrDefault(p => Path.GetDirectoryName(p) == Path.GetDirectoryName(albedo)
+                    && Path.GetFileName(p).IndexOf(word, StringComparison.OrdinalIgnoreCase) >= 0 && p.IndexOf("normal", StringComparison.OrdinalIgnoreCase) >= 0);
+                if (normal != null) return new Layer { albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(albedo),
+                    normal = AssetDatabase.LoadAssetAtPath<Texture2D>(normal), mask = Solid("DryMask", new Color(0, 1, 0, 0.3f), false) };
+            }
+            return Generate(kind);
+        }
+        public static Texture2D Solid(string name, Color colour, bool colourData = true)
+        {
+            var path = Folder + name + ".png";
+            var existing = AssetDatabase.LoadAssetAtPath<Texture2D>(path); if (existing != null) return existing;
+            return Write(path, Enumerable.Repeat(colour, 16).ToArray(), 4, colourData, false);
+        }
+        public static Texture2D Dust()
+        {
+            var path = Folder + "Dust.png"; var existing = AssetDatabase.LoadAssetAtPath<Texture2D>(path);
+            if (existing != null) return existing;
+            var pixels = new Color[DustSize * DustSize];
+            for (var y = 0; y < DustSize; y++) for (var x = 0; x < DustSize; x++)
+            {
+                var u = 2f * x / (DustSize - 1) - 1; var v = 2f * y / (DustSize - 1) - 1;
+                var alpha = Mathf.Pow(Mathf.Clamp01(1 - u * u - v * v), 3);
+                pixels[y * DustSize + x] = new Color(0.47f, 0.35f, 0.22f, alpha);
+            }
+            return Write(path, pixels, DustSize, true, false);
+        }
+        public static Texture2D LinearCopy(Texture2D source, bool normal)
+        {
+            if (source == null) return null;
+            var sourcePath = AssetDatabase.GetAssetPath(source);
+            // Terrain and sky packs are always referenced in place. Only LOBGame conversions
+            // may copy maps, and their source import settings are never changed.
+            if (!sourcePath.StartsWith(SiteAssetBuilder.Imported, StringComparison.Ordinal)) return source;
+            var path = SiteAssetBuilder.Converted + AssetDatabase.AssetPathToGUID(sourcePath) + (normal ? "_Normal" : "_Linear") + Path.GetExtension(sourcePath);
+            if (!File.Exists(path)) { File.Copy(sourcePath, path); AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceSynchronousImport); }
+            var importer = (TextureImporter)AssetImporter.GetAtPath(path);
+            var type = normal ? TextureImporterType.NormalMap : TextureImporterType.Default;
+            var android = importer.GetPlatformTextureSettings("Android");
+            if (importer.textureType != type || importer.sRGBTexture || !android.overridden || android.format != TextureImporterFormat.ASTC_6x6)
+            {
+                importer.textureType = type; importer.sRGBTexture = false;
+                importer.SetPlatformTextureSettings(new TextureImporterPlatformSettings { name = "Android", overridden = true,
+                    maxTextureSize = Size, format = TextureImporterFormat.ASTC_6x6 }); importer.SaveAndReimport();
+            }
+            return AssetDatabase.LoadAssetAtPath<Texture2D>(path);
+        }
+        public static Texture2D MetallicRoughness(Texture2D metallic, Texture2D roughness)
+        {
+            var path = SiteAssetBuilder.Converted + "Pipe_MetallicSmoothness.png";
+            var existing = AssetDatabase.LoadAssetAtPath<Texture2D>(path); if (existing != null) return existing;
+            var m = ReadLinear(metallic, Size); var r = ReadLinear(roughness, Size);
+            try
+            {
+                var metal = m.GetPixels(); var rough = r.GetPixels();
+                for (var i = 0; i < metal.Length; i++) metal[i] = new Color(metal[i].r, 1, 0, 1 - rough[i].r);
+                return Write(path, metal, Size, false, false);
+            }
+            finally { UnityEngine.Object.DestroyImmediate(m); UnityEngine.Object.DestroyImmediate(r); }
+        }
+        private static Texture2D ReadLinear(Texture2D texture, int size)
+        {
+            var rt = RenderTexture.GetTemporary(size, size, 0, RenderTextureFormat.ARGB32, RenderTextureReadWrite.Linear);
+            var previous = RenderTexture.active;
+            try
+            {
+                Graphics.Blit(texture, rt); RenderTexture.active = rt;
+                var result = new Texture2D(size, size, TextureFormat.RGBA32, false, true);
+                result.ReadPixels(new Rect(0, 0, size, size), 0, 0); result.Apply(); return result;
+            }
+            finally { RenderTexture.active = previous; RenderTexture.ReleaseTemporary(rt); }
+        }
+        public static Layer Generate(string kind)
+        {
+            var prefix = Folder + kind;
+            if (File.Exists(prefix + "_Albedo.png") && File.Exists(prefix + "_Normal.png") && File.Exists(prefix + "_Mask.png"))
+                return new Layer { albedo = AssetDatabase.LoadAssetAtPath<Texture2D>(prefix + "_Albedo.png"),
+                    normal = AssetDatabase.LoadAssetAtPath<Texture2D>(prefix + "_Normal.png"), mask = AssetDatabase.LoadAssetAtPath<Texture2D>(prefix + "_Mask.png") };
+            var heights = new float[Size * Size]; var colors = new Color[heights.Length]; var masks = new Color[heights.Length];
+            var low = kind == "Grass" ? new Color(0.25f, 0.27f, 0.13f) : kind == "Gravel" ? new Color(0.25f, 0.24f, 0.21f) : new Color(0.25f, 0.17f, 0.10f);
+            var high = kind == "Grass" ? new Color(0.60f, 0.53f, 0.30f) : kind == "Gravel" ? new Color(0.65f, 0.61f, 0.53f) : new Color(0.57f, 0.43f, 0.27f);
+            for (var y = 0; y < Size; y++) for (var x = 0; x < Size; x++)
+            {
+                var u = x / (float)(Size - 1); var v = y / (float)(Size - 1);
+                var height = Fbm(u, v, kind == "Grass" ? 96 : 12, kind == "Grass" ? 6 : 12);
+                if (kind == "Gravel") height = 0.65f * Worley(u, v, 48) + 0.35f * height;
+                var grain = Periodic(u, v, 256, 256);
+                heights[y * Size + x] = height;
+                colors[y * Size + x] = Color.Lerp(low, high, Mathf.Clamp01(height * 0.85f + grain * 0.15f));
+                masks[y * Size + x] = new Color(0, Mathf.Lerp(0.7f, 1, height), 0, Mathf.Lerp(0.12f, 0.38f, grain));
+            }
+            var normals = new Color[heights.Length];
+            for (var y = 0; y < Size; y++) for (var x = 0; x < Size; x++)
+            {
+                // Wrap the unique period (Size-1); duplicated last row/column is exactly seamless.
+                var left = (x + Size - 2) % (Size - 1); var right = (x + 1) % (Size - 1);
+                var down = (y + Size - 2) % (Size - 1); var up = (y + 1) % (Size - 1);
+                var n = new Vector3((heights[y * Size + left] - heights[y * Size + right]) * 5,
+                    (heights[down * Size + x] - heights[up * Size + x]) * 5, 1).normalized;
+                normals[y * Size + x] = new Color(n.x * 0.5f + 0.5f, n.y * 0.5f + 0.5f, n.z * 0.5f + 0.5f, 1);
+            }
+            return new Layer { albedo = Write(prefix + "_Albedo.png", colors, Size, true, false),
+                normal = Write(prefix + "_Normal.png", normals, Size, false, true), mask = Write(prefix + "_Mask.png", masks, Size, false, false) };
+        }
+        private static float Hash(int x, int y)
+        {
+            unchecked { uint n = (uint)(x * 374761393 + y * 668265263); n = (n ^ n >> 13) * 1274126177; return (n ^ n >> 16) / (float)uint.MaxValue; }
+        }
+        private static int Wrap(int x, int period) => (x % period + period) % period;
+        private static float Periodic(float u, float v, int nx, int ny)
+        {
+            var x = u * nx; var y = v * ny; var ix = Mathf.FloorToInt(x); var iy = Mathf.FloorToInt(y);
+            var fx = Mathf.SmoothStep(0, 1, x - ix); var fy = Mathf.SmoothStep(0, 1, y - iy);
+            return Mathf.Lerp(Mathf.Lerp(Hash(Wrap(ix, nx), Wrap(iy, ny)), Hash(Wrap(ix + 1, nx), Wrap(iy, ny)), fx),
+                Mathf.Lerp(Hash(Wrap(ix, nx), Wrap(iy + 1, ny)), Hash(Wrap(ix + 1, nx), Wrap(iy + 1, ny)), fx), fy);
+        }
+        private static float Fbm(float u, float v, int nx, int ny) => Periodic(u, v, nx, ny) * 0.57f
+            + Periodic(u, v, nx * 2, ny * 2) * 0.28f + Periodic(u, v, nx * 4, ny * 4) * 0.15f;
+        private static float Worley(float u, float v, int count)
+        {
+            var x = u * count; var y = v * count; var ix = Mathf.FloorToInt(x); var iy = Mathf.FloorToInt(y); var distance = 2f;
+            for (var j = -1; j <= 1; j++) for (var i = -1; i <= 1; i++)
+            {
+                var px = ix + i + Hash(Wrap(ix + i, count), Wrap(iy + j, count));
+                var py = iy + j + Hash(Wrap(iy + j, count) + 17, Wrap(ix + i, count));
+                distance = Mathf.Min(distance, Vector2.Distance(new Vector2(x, y), new Vector2(px, py)));
+            }
+            return Mathf.SmoothStep(0, 1, 1 - distance);
+        }
+        public static Texture2D Write(string path, Color[] pixels, int size, bool srgb, bool normal)
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(path));
+            var texture = new Texture2D(size, size, TextureFormat.RGBA32, false, !srgb);
+            texture.SetPixels(pixels); texture.Apply(); File.WriteAllBytes(path, texture.EncodeToPNG()); UnityEngine.Object.DestroyImmediate(texture);
+            AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceSynchronousImport);
+            var importer = (TextureImporter)AssetImporter.GetAtPath(path);
+            importer.sRGBTexture = srgb; importer.textureType = normal ? TextureImporterType.NormalMap : TextureImporterType.Default;
+            importer.wrapMode = TextureWrapMode.Repeat; importer.mipmapEnabled = true;
+            importer.alphaSource = TextureImporterAlphaSource.FromInput;
+            importer.SetPlatformTextureSettings(new TextureImporterPlatformSettings { name = "Android", overridden = true,
+                maxTextureSize = Size, format = TextureImporterFormat.ASTC_6x6 });
+            importer.SaveAndReimport(); return AssetDatabase.LoadAssetAtPath<Texture2D>(path);
+        }
+    }
+}
