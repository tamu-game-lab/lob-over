            pointer.AnyPress -= DismissCard; voice.MissingVoice -= MissingVoice;
            if (ride != null) StopCoroutine(ride);
            ride = null; if (engine != null) engine.Stop(); if (fade != null) fade.SetExplicitFade(0);
            wrist.gameObject.SetActive(false);
