using System.IO;
using System.Linq;
using LOBOver.Editor;
using LOBOver.Runtime;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using NUnit.Framework;
using UnityEditor;
using UnityEngine;
using UnityEngine.TestTools;

namespace LOBOver.Tests.Editor
{
    // PlayMode's setup names this class by string so its assembly has no runtime dependency on UnityEditor.
    public sealed class BuildSiteFixture : IPrebuildSetup
    {
        public void Setup() { SiteSceneBuilder.Build(); }
    }

    public sealed class SiteSceneBuilderTests
    {
        [Test]
        public void BuilderIsRepeatableAndWiresTheScene()
        {
            var sourceSoil = SiteAssetBuilder.Required<Material>(SiteAssetBuilder.Imported + "_Project/Art/ProjectSite/Materials/Soil.mat");
            var sourceBefore = EditorJsonUtility.ToJson(sourceSoil);
            SiteSceneBuilder.Build(false);
            var first = UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects().Select(o => o.name).OrderBy(n => n).ToArray();
            var firstMaterials = AssetDatabase.FindAssets("t:Material", new[] { SiteAssetBuilder.Converted.TrimEnd('/') }).OrderBy(guid => guid).ToArray();
            Assert.That(firstMaterials.Length, Is.GreaterThan(0));
            AssertBuiltMaterials();
            // Rebuilding must refresh stale generated properties without replacing the copy's GUID.
            SiteAssetBuilder.Material("Soil").SetColor("_BaseColor", Color.magenta);
            SiteSceneBuilder.Build(false);
            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
            CollectionAssert.AreEqual(firstMaterials, AssetDatabase.FindAssets("t:Material", new[] { SiteAssetBuilder.Converted.TrimEnd('/') }).OrderBy(guid => guid).ToArray());
            Assert.That(EditorJsonUtility.ToJson(sourceSoil), Is.EqualTo(sourceBefore), "LOB-Game's source material changed");
            AssertBuiltMaterials();
            foreach (var name in new[] { "Soil", "AccessRoad", "Repair_SiteCabin", "Timber", "StorageSteel", "Repair_Surface", "Repair_OpenTrench", "Repair_PipeBed", "Repair_Backfill" })
                AssertSurfaceCopy(name);
            CollectionAssert.AreEqual(first, scene.GetRootGameObjects().Select(o => o.name).OrderBy(n => n).ToArray());
            foreach (var name in new[] { "Sun", "Ground", "Road", "Gate", "Trailer", "JobSign", "Director", "SiteWorld", "DesktopPreview", "SiteSky", "Global Volume" })
                Assert.That(GameObject.Find(name), Is.Not.Null, name);
            Assert.That(Object.FindObjectsByType<Director>(FindObjectsSortMode.None).Length, Is.EqualTo(1));
            Assert.That(Object.FindObjectsByType<SiteWorld>(FindObjectsSortMode.None).Length, Is.EqualTo(1));
            Assert.That(Object.FindObjectsByType<AudioListener>(FindObjectsSortMode.None).Length, Is.EqualTo(1));
            Assert.That(GameObject.Find("Gate").transform.childCount, Is.EqualTo(5));
            Assert.That(GameObject.Find("Road").transform.localScale, Is.EqualTo(new Vector3(980, 0.03f, 8)));
            var world = Object.FindFirstObjectByType<SiteWorld>();
            Assert.That(world.director, Is.Not.Null); Assert.That(world.assets.machines.Length, Is.EqualTo(8));
            Assert.That(Vector3.Distance(world.trailerBoard.transform.Find("Face").lossyScale, new Vector3(2, 1, 0.06f)), Is.LessThan(0.0001f));
            Assert.That(Vector3.Distance(world.planPanel.transform.Find("Face").lossyScale, new Vector3(3, 1.5f, 0.06f)), Is.LessThan(0.0001f));
            var source = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json"));
            world.Configure((JObject)source["job"], (double)source["plan"]["deadlineDay"]);
            var transcript = JObject.Parse(File.ReadAllText("Data/transcripts/slice_play.json"));
            world.Apply(LOBOver.Sim.SiteView.From((JObject)transcript["snapshots"][1]["site"]), 2);
            Assert.That(world.CellCount, Is.EqualTo(30)); Assert.That(world.CrewCount, Is.EqualTo(3)); Assert.That(world.BoardCount, Is.EqualTo(2));
            Assert.That(world.StakeAt(3000), Is.Not.Null);
            Assert.That(world.transform.GetComponentsInChildren<Transform>().Count(t => t.name.StartsWith("Spoil_")), Is.EqualTo(30));
            foreach (var rig in world.GetComponentsInChildren<CrewRig>()) Assert.That(rig.GetComponentsInChildren<Animator>().Length, Is.GreaterThanOrEqualTo(2));
            AssertBuiltMaterials();
        }

        private static void AssertBuiltMaterials()
        {
            AssertMaterialReferences(SiteAssetBuilder.Required<WorldAssets>(SiteAssetBuilder.Art + "WorldAssets.asset"));
            foreach (var guid in AssetDatabase.FindAssets("t:Prefab", new[] { SiteAssetBuilder.Prefabs.TrimEnd('/') }))
                AssertHierarchyMaterials(SiteAssetBuilder.Required<GameObject>(AssetDatabase.GUIDToAssetPath(guid)));
            foreach (var root in UnityEngine.SceneManagement.SceneManager.GetActiveScene().GetRootGameObjects())
                AssertHierarchyMaterials(root);
        }
        private static void AssertHierarchyMaterials(GameObject root)
        {
            // Include disabled cells, crew renderers, particle trails and material fields used at runtime.
            foreach (var component in root.GetComponentsInChildren<Component>(true))
                if (component != null) AssertMaterialReferences(component);
        }
        private static void AssertMaterialReferences(Object owner)
        {
            using var serialized = new SerializedObject(owner);
            var property = serialized.GetIterator();
            while (property.Next(true))
            {
                if (property.propertyType != SerializedPropertyType.ObjectReference || !(property.objectReferenceValue is Material material)) continue;
                var context = owner.name + "/" + property.propertyPath + ": " + material.name;
                Assert.That(material.shader, Is.Not.Null, context);
                var shader = material.shader.name;
                Assert.That(shader == "Standard" || shader == "Standard (Specular setup)"
                    || shader.StartsWith("Legacy Shaders/", System.StringComparison.Ordinal) || shader == "Hidden/InternalErrorShader", Is.False, context + " uses " + shader);
                Assert.That(AssetDatabase.GetAssetPath(material).StartsWith(SiteAssetBuilder.Imported, System.StringComparison.Ordinal), Is.False, context + " still references LOB-Game");
            }
        }
        private static void AssertSurfaceCopy(string name)
        {
            var source = SiteAssetBuilder.Required<Material>(SiteAssetBuilder.Imported + "_Project/Art/ProjectSite/Materials/" + name + ".mat");
            var copy = SiteAssetBuilder.Material(name);
            Assert.That(copy, Is.Not.SameAs(source), name);
            Assert.That(AssetDatabase.GetAssetPath(copy), Is.EqualTo(SiteAssetBuilder.Converted + name + ".mat"));
            Assert.That(copy.shader.name, Is.EqualTo("Universal Render Pipeline/Lit"), name);
            Assert.That(Vector4.Distance(copy.GetColor("_BaseColor"), source.GetColor("_Color")), Is.LessThan(1e-5f), name); // a gamma round-trip leaves one float step (3e-8)
            AssertTextureCopy(source, "_MainTex", copy, "_BaseMap");
            AssertTextureCopy(source, "_BumpMap", copy, "_BumpMap");
            AssertTextureCopy(source, "_MetallicGlossMap", copy, "_MetallicGlossMap");
            var smoothness = source.GetTexture("_MetallicGlossMap") != null ? "_GlossMapScale" : "_Glossiness";
            Assert.That(copy.GetFloat("_Smoothness"), Is.EqualTo(source.GetFloat(smoothness)), name);
        }
        private static void AssertTextureCopy(Material source, string from, Material copy, string to)
        {
            Assert.That(copy.GetTexture(to), Is.EqualTo(source.GetTexture(from)), source.name + "/" + from);
            Assert.That(copy.GetTextureScale(to), Is.EqualTo(source.GetTextureScale(from)), source.name + "/" + from + " tiling");
            Assert.That(copy.GetTextureOffset(to), Is.EqualTo(source.GetTextureOffset(from)), source.name + "/" + from + " offset");
        }

        [Test]
        public void ImportedPathsAndCleanCopiesLoad()
        {
            var assets = SiteAssetBuilder.Build();
            foreach (var name in SiteAssetBuilder.MachineNames)
                Assert.That(AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Equipment + name + ".prefab"), Is.Not.Null, name);
            Assert.That(AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Worker), Is.Not.Null);
            Assert.That(AssetDatabase.LoadAssetAtPath<GameObject>(SiteAssetBuilder.Pipe), Is.Not.Null);
            var prefabs = assets.machines.Select(m => m.prefab).Concat(new[] { assets.worker, assets.cellPrefab.gameObject, assets.particles, assets.spoil, assets.cone, assets.barrier });
            foreach (var prefab in prefabs)
                foreach (var child in prefab.GetComponentsInChildren<Transform>(true))
                    Assert.That(GameObjectUtility.GetMonoBehavioursWithMissingScriptCount(child.gameObject), Is.Zero, prefab.name + "/" + child.name);
        }

        [Test]
        public void SyncCopiesExactCatalogScenariosScriptsAndVoice()
        {
            DataSync.Sync();
            Check("Data/catalog.json", "Data/catalog.json");
            foreach (var file in Directory.GetFiles("Data/Scenarios", "*.json")) Check(file, "Data/Scenarios/" + Path.GetFileName(file));
            foreach (var file in Directory.GetFiles("Monitor/test/scripts", "*.json")) Check(file, "Data/scripts/" + Path.GetFileName(file));
            foreach (var file in Directory.GetFiles("Voice", "*.wav", SearchOption.AllDirectories)) Check(file, file.Replace('\\', '/'));
        }
        private static void Check(string source, string relative) => CollectionAssert.AreEqual(File.ReadAllBytes(source), File.ReadAllBytes(Path.Combine(Application.streamingAssetsPath, relative)), source);
    }
}
using System.Collections;
using System.IO;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.Sim;
using LOBOver.Start;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using NUnit.Framework;
using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.TestTools;
using Simulation = LOBOver.Sim.Sim;

namespace LOBOver.Tests
{
    // The Site scene is builder output (LOB Over/Build/Site Scene, committed); a PrebuildSetup that rebuilt it
    // replaced the Test Runner's init scene and the run never started.
    public sealed class SiteWorldTests
    {
        private SiteWorld world;
        private JObject scenario, transcript;
        [UnitySetUp]
        public IEnumerator SetUp()
        {
#if UNITY_EDITOR
            SceneManager.sceneLoaded += DisableAutoplay;
            yield return UnityEditor.SceneManagement.EditorSceneManager.LoadSceneInPlayMode("Assets/LOBOver/Scenes/Site.unity", new LoadSceneParameters(LoadSceneMode.Single));
            SceneManager.sceneLoaded -= DisableAutoplay;
            world = Object.FindFirstObjectByType<SiteWorld>();
            scenario = JObject.Parse(File.ReadAllText(Path.Combine(Application.streamingAssetsPath, "Data/Scenarios/slice_texas.json")));
            transcript = JObject.Parse(File.ReadAllText(Path.Combine(Directory.GetParent(Application.dataPath).FullName, "Data/transcripts/slice_play.json")));
            world.Configure((JObject)scenario["job"], (double)scenario["plan"]["deadlineDay"]);
#else
            Assert.Ignore("The recorded fixture and builder run in Editor PlayMode; no headset required.");
            yield break;
#endif
        }
        private static void DisableAutoplay(Scene scene, LoadSceneMode mode)
        {
            Object.FindFirstObjectByType<Director>().gameObject.SetActive(false);
            var start = Object.FindFirstObjectByType<StartPanel>();
            start.enabled = false; start.fullScaleRoot.SetActive(true);
            start.rig.gameObject.SetActive(false); start.pointer.gameObject.SetActive(false);
            Object.FindFirstObjectByType<DesktopPreview>(FindObjectsInactive.Include).gameObject.SetActive(false);
        }
        [TearDown]
        public void TearDown() { SceneManager.sceneLoaded -= DisableAutoplay; }
        private void Feed(int day) => world.Apply(SiteView.From((JObject)transcript["snapshots"][day]["site"]), day + 1);
        private void Crew(string id, double station, string status, int mood = -1)
        {
            // Amendment 1 rounds the pipe position to 520; the recorded value is 520.2 ft.
            // Retain that exact value in the world; WO-S2's position comparison allows one foot.
            var crew = world.Crew(id); Assert.That(crew.StationFt, Is.EqualTo(station).Within(1), id + " station");
            Assert.That(crew.Status, Is.EqualTo(status), id + " status");
            if (mood >= 0) Assert.That(crew.MoodLevel, Is.EqualTo(mood), id + " mood");
        }
        private void Cell(string state, string wall, string water)
        {
            var cell = world.CellAt(520); Assert.That(cell.StationFt, Is.EqualTo(500));
            Assert.That(cell.State, Is.EqualTo(state)); Assert.That(cell.Wall, Is.EqualTo(wall)); Assert.That(cell.Water, Is.EqualTo(water));
            Assert.That(cell.slump.activeSelf, Is.EqualTo(wall == "slumped")); Assert.That(cell.water.activeSelf, Is.EqualTo(water == "standing"));
        }
        [UnityTest]
        public IEnumerator RecordedDaysDriveGeometryCrewsSkyAndBoards()
        {
            Feed(1); yield return null;
            Crew("exc", 220, "working"); Crew("pipe", 0, "working"); Crew("back", 0, "idle");
            Cell("undug", "sound", "none"); Assert.That(world.sky.State, Is.EqualTo("clear"));
            StringAssert.Contains("TX-0311", world.Board(1).Text); StringAssert.Contains("no permit posted", world.Board(2).Text);
            Feed(4); yield return null;
            Cell("piped", "slumped", "standing"); Crew("exc", 869, "stopped"); Crew("pipe", 520, "stopped"); Crew("back", 237.5, "working");
            Assert.That(world.CurrentView.activeEvent.id, Is.EqualTo("ev_p1"));
            Assert.That(world.CurrentView.truck.stationFt, Is.EqualTo(270)); Assert.That(world.CurrentView.truck.dismounted, Is.True);
            Assert.That(world.Crew("pipe").WorkingParticles, Is.False);
            Feed(5); yield return null;
            Crew("back", 272.5, "held"); Crew("exc", 869, "working", 1); Crew("pipe", 520, "idle"); Cell("piped", "slumped", "standing");
            Feed(9); yield return null;
            Cell("backfilled", "sound", "none"); Assert.That(world.sky.State, Is.EqualTo("rain")); Assert.That(world.sky.Raining, Is.True);
            Assert.That(world.sky.rain.isPlaying, Is.True); Assert.That(world.CurrentView.activeEvent.id, Is.EqualTo("ev_a2"));
            StringAssert.Contains("TX-0312", world.Board(2).Text);
            foreach (var id in WorldUnits.CrewIds) Assert.That(world.Crew(id).Status, Is.EqualTo("working"));
            Feed(16); yield return null;
            StringAssert.Contains("8403-5", world.Board(1).Text); Assert.That(world.sky.State, Is.EqualTo("clear")); Assert.That(world.sky.Raining, Is.False);
            Assert.That(world.trailerBoard.LineCount, Is.EqualTo(3));
            foreach (var id in WorldUnits.CrewIds) Assert.That(world.trailerBoard.PointCount(id), Is.EqualTo(5));
        }
        [UnityTest]
        public IEnumerator ReplayBothSeatsAt420ShowsFacingForemen()
        {
            var catalog = Catalog.Load(File.ReadAllText(Path.Combine(Application.streamingAssetsPath, "Data/catalog.json")));
            var sim = Simulation.Create(Scenario.Load(scenario.ToString(), catalog), catalog);
            var script = JArray.Parse(File.ReadAllText(Path.Combine(Application.streamingAssetsPath, "Data/scripts/slice_play.json")));
            var commands = script.OfType<JObject>().OrderBy(entry => (double)entry["t"]).ToArray();
            // Same fixed tick and stable, both-seat ordering as headless.js / Replay.cs (WO-S3 Amendment 1).
            const double dt = 0.01, epsilon = 1e-6, until = 4.20;
            var index = 0;
            while (sim.T <= until + epsilon)
            {
                while (index < commands.Length && (double)commands[index]["t"] <= sim.T + epsilon)
                { var entry = commands[index++]; sim.Apply((string)entry["seat"], (JObject)entry["cmd"]); sim.Drain(); }
                if (sim.T >= until - epsilon) break;
                Assert.That(sim.Speed, Is.Not.EqualTo("paused"), "Replay paused before the fixture time");
                sim.Tick(dt); sim.Drain();
            }
            world.Apply(SiteView.From(sim.View("site")), 5);
            yield return new WaitForSeconds(WorldUnits.PoseSeconds + 0.2f);
            Crew("pipe", 520, "arguing"); Crew("back", 272.5, "arguing"); Crew("exc", 869, "stopped");
            Assert.That(world.CurrentView.activeEvent.id, Is.EqualTo("ev_p1"));
            var pipe = world.Crew("pipe"); var back = world.Crew("back");
            Assert.That(pipe.Partner, Is.EqualTo(back.transform)); Assert.That(back.Partner, Is.EqualTo(pipe.transform));
            var towardBack = (back.Foreman.position - pipe.Foreman.position).normalized;
            Assert.That(Vector3.Dot(pipe.Foreman.forward, towardBack), Is.GreaterThan(0.99f));
            Assert.That(Vector3.Dot(back.Foreman.forward, -towardBack), Is.GreaterThan(0.99f));
            Assert.That((pipe.Foreman.position.x + back.Foreman.position.x) / 2, Is.EqualTo((pipe.StationFt + back.StationFt) / 2 * WorldUnits.MetresPerFoot).Within(0.05));
            CollectionAssert.AreEquivalent(new[] { "ConflictTalk", "TalkAlternate" }, new[] { pipe.ForemanClip, back.ForemanClip });
        }
    }
}
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.Sim;
using Newtonsoft.Json.Linq;
using UnityEngine;
using UnityEngine.InputSystem;
using UnityEngine.Networking;

namespace LOBOver.World
{
    public sealed class DesktopPreview : MonoBehaviour
    {
        public Director director;
        public SiteWorld world;
        public Camera previewCamera;
        public string LastInspection { get; private set; } = "";
        public string LastCard { get; private set; } = "";
        private string voiceText = "";
        private float voiceUntil;
        private double lastTruckStation;
        private bool lastDismounted, hasTruck;
        private readonly Queue<string> voiceQueue = new Queue<string>();
        private Coroutine voiceRoutine;
        private AudioSource voiceSource = null;
        private GUIStyle hud;
        // Preview-only camera controls, independent of the simulation clock.
        private const float FlyMetresPerSecond = 12, FastMultiplier = 4, LookDegreesPerPixel = 0.12f;

        private void OnEnable()
        {
#if UNITY_ANDROID && !UNITY_EDITOR
            gameObject.SetActive(false);
            return;
#else
            if (director == null) return;
            director.Message += OnMessage; director.Voice += OnVoice; director.Loaded += Clear;
            if (voiceSource == null) voiceSource = WorldDrawing.Sound(WorldDrawing.Group("VoiceAudio", transform), false);
#endif
        }
        private void OnDisable()
        {
            if (director != null) { director.Message -= OnMessage; director.Voice -= OnVoice; director.Loaded -= Clear; }
            Clear(); Cursor.lockState = CursorLockMode.None; Cursor.visible = true;
        }
        private void Clear()
        {
            LastInspection = ""; LastCard = ""; voiceText = ""; hasTruck = false; voiceQueue.Clear();
            if (voiceRoutine != null) StopCoroutine(voiceRoutine);
            voiceRoutine = null;
            if (voiceSource != null) { voiceSource.Stop(); if (voiceSource.clip != null) Destroy(voiceSource.clip); voiceSource.clip = null; }
        }
        private void Update()
        {
            var keyboard = Keyboard.current; var mouse = Mouse.current;
            if (keyboard == null || mouse == null) return;
            var flying = mouse.rightButton.isPressed;
            Cursor.lockState = flying ? CursorLockMode.Locked : CursorLockMode.None; Cursor.visible = !flying;
            if (flying)
            {
                var delta = mouse.delta.ReadValue() * LookDegreesPerPixel;
                var angles = previewCamera.transform.eulerAngles;
                var pitch = angles.x > 180 ? angles.x - 360 : angles.x;
                previewCamera.transform.rotation = Quaternion.Euler(Mathf.Clamp(pitch - delta.y, -85, 85), angles.y + delta.x, 0);
                var move = new Vector3((keyboard.dKey.isPressed ? 1 : 0) - (keyboard.aKey.isPressed ? 1 : 0), 0,
                    (keyboard.wKey.isPressed ? 1 : 0) - (keyboard.sKey.isPressed ? 1 : 0));
                previewCamera.transform.Translate(move * FlyMetresPerSecond * (keyboard.leftShiftKey.isPressed || keyboard.rightShiftKey.isPressed ? FastMultiplier : 1) * Time.unscaledDeltaTime);
            }
            if (!director.Ready) return;
            if (keyboard.spaceKey.wasPressedThisFrame) { if (director.Speed == "paused") director.Start(); else director.Pause(); }
            if (keyboard.rKey.wasPressedThisFrame) director.Reset();
            var view = director.SiteView;
            if (view == null) return;
            FollowTruck(view.truck);
            // RMB scopes WASD to flight so D/S cannot also issue Site commands.
            if (!flying)
            {
                if (keyboard.dKey.wasPressedThisFrame) Send(view.truck.dismounted ? "mount" : "dismount");
                if (keyboard.sKey.wasPressedThisFrame) director.Send(new JObject { ["action"] = "stopWork", ["zone"] = world.ZoneAt(view.truck.stationFt) });
            }
            var digits = new[] { Key.Digit1, Key.Digit2, Key.Digit3, Key.Digit4, Key.Digit5, Key.Digit6, Key.Digit7, Key.Digit8, Key.Digit9 };
            for (var i = 0; i < digits.Length; i++) if (keyboard[digits[i]].wasPressedThisFrame) Ride((i + 1) * WorldUnits.StationFeet);
            if (keyboard.leftBracketKey.wasPressedThisFrame) Ride((Mathf.Round((float)view.truck.stationFt / WorldUnits.StationFeet) - 1) * WorldUnits.StationFeet);
            if (keyboard.rightBracketKey.wasPressedThisFrame) Ride((Mathf.Round((float)view.truck.stationFt / WorldUnits.StationFeet) + 1) * WorldUnits.StationFeet);
            if (keyboard.iKey.wasPressedThisFrame) Inspect();
            if (keyboard.fKey.wasPressedThisFrame) director.Send(new JObject { ["action"] = "flag", ["stationFt"] = view.truck.stationFt, ["note"] = "" });
            if (keyboard.cKey.wasPressedThisFrame) Confirm("done");
            if (keyboard.nKey.wasPressedThisFrame) Confirm("notDone");
            if (keyboard.lKey.wasPressedThisFrame) Send("listen");
        }
        private void FollowTruck(TruckView truck)
        {
            if (truck.moving) return;
            if (hasTruck && (truck.stationFt != lastTruckStation || truck.dismounted != lastDismounted))
            {
                previewCamera.transform.position = world.transform.TransformPoint(new Vector3((float)truck.stationFt * WorldUnits.MetresPerFoot, 1.7f,
                    truck.dismounted ? WorldUnits.TrenchWidth / 2 + 1.5f : WorldUnits.RoadZ));
                previewCamera.transform.rotation = world.transform.rotation * Quaternion.Euler(12, 180, 0);
            }
            lastTruckStation = truck.stationFt; lastDismounted = truck.dismounted; hasTruck = true;
        }
        private void Ride(float station) => director.Send(new JObject { ["action"] = "moveTo", ["stationFt"] = Mathf.Clamp(station, 0, (float)world.LengthFt) });
        private void Send(string action) => director.Send(new JObject { ["action"] = action });
        private void Confirm(string outcome)
        {
            var order = director.SiteView.orders.FirstOrDefault(item => item.status == "landed");
            if (order == null) { LastInspection = "no order landed here"; return; }
            director.Send(new JObject { ["action"] = "confirm", ["orderId"] = order.id, ["outcome"] = outcome });
        }
        private void Inspect()
        {
            if (!Physics.Raycast(previewCamera.ViewportPointToRay(new Vector3(0.5f, 0.5f, 0)), out var hit, 6000, ~0, QueryTriggerInteraction.Collide)) return;
            var target = hit.collider.GetComponentInParent<InspectTarget>();
            if (target != null) director.Send(new JObject { ["action"] = "inspect", ["target"] = target.target });
        }
        private void OnMessage(JObject message)
        {
            var type = (string)message["t"];
            if (type == "nack") LastInspection = (string)message["reason"];
            if (!Director.ForSeat(message, "site")) return;
            if (type == "inspection") LastInspection = (string)message["text"];
            if (type == "event") LastCard = (string)message["card"]?["title"] + "\n" + string.Join("\n", message["card"]?["facts"]?.Values<string>() ?? Enumerable.Empty<string>());
        }
        private void OnVoice(JObject message)
        {
            if (!Director.ForSeat(message, "site")) return;
            foreach (var id in message["lineIds"].Values<string>()) voiceQueue.Enqueue(id);
            if (voiceRoutine == null) voiceRoutine = StartCoroutine(PlayVoice());
        }
        private IEnumerator PlayVoice()
        {
            yield return null;
            while (voiceQueue.Count > 0)
            {
                var id = voiceQueue.Dequeue(); var line = director.Lines.OfType<JObject>().FirstOrDefault(item => (string)item["id"] == id);
                if (line == null) continue;
                var speaker = (string)line["speaker"];
                var crew = speaker.StartsWith("foreman_") ? world.Crew(speaker.Substring("foreman_".Length)) : null;
                voiceSource.transform.position = crew == null ? previewCamera.transform.position : crew.transform.position;
                voiceSource.spatialBlend = crew == null ? 0 : 1;
                voiceText = (string)line["text"]; voiceUntil = Time.unscaledTime + 8;
                var relative = "Voice/" + director.scenarioId + "/" + id + ".wav";
#if !UNITY_ANDROID || UNITY_EDITOR
                if (!File.Exists(Path.Combine(Application.streamingAssetsPath, relative))) continue;
#endif
                using (var request = UnityWebRequestMultimedia.GetAudioClip(StreamingData.Url(relative), AudioType.WAV))
                {
                    yield return request.SendWebRequest();
                    if (request.result != UnityWebRequest.Result.Success) continue;
                    var clip = DownloadHandlerAudioClip.GetContent(request); voiceSource.clip = clip; voiceSource.Play();
                    voiceUntil = Time.unscaledTime + Mathf.Max(8, clip.length);
                    while (voiceSource.isPlaying) yield return null;
                    voiceSource.clip = null; Destroy(clip);
                }
            }
            voiceRoutine = null;
        }
        private void OnGUI()
        {
            if (hud == null) hud = new GUIStyle(GUI.skin.box) { alignment = TextAnchor.UpperLeft, fontSize = 16, wordWrap = true, padding = new RectOffset(12, 12, 10, 10) };
            var truck = director.SiteView?.truck;
            var text = director.LoadError ?? (director.Ready ? "Day " + director.DisplayDay + "  Â·  " + director.Speed + "\nTruck " + WorldUnits.Station(truck.stationFt)
                + (truck.moving ? " driving" : truck.dismounted ? " dismounted" : " mounted") : "Loading site");
            text += "\n" + LastInspection + "\n" + LastCard;
            if (Time.unscaledTime < voiceUntil) text += "\n" + voiceText;
            text += "\nRMB + WASD fly Â· Shift fast Â· 1â€“9 / [ ] ride\nD mount/dismount Â· I inspect Â· F flag Â· S stop\nC confirm Â· N not carried out Â· L listen Â· Space pause Â· R reset";
            var width = Mathf.Min(520, Screen.width - 20);
            GUI.Box(new Rect(10, 10, width, hud.CalcHeight(new GUIContent(text), width)), text, hud);
            GUI.Label(new Rect(Screen.width / 2f - 6, Screen.height / 2f - 10, 20, 20), "+");
        }
    }
}

