using System;
using LOBOver.World;
using UnityEngine;
using UnityEngine.InputSystem;

namespace LOBOver.VR
{
    public sealed class ControllerPointer : MonoBehaviour
    {
        public Transform rightHand;
        public Camera mouseCamera;
        public WorldAssets assets;
        public IInspectorInput Input { get; set; } = new OvrInput();
        public event Action<RaycastHit> TargetPressed;
        public event Action AnyPress;
        private LineRenderer line;
        public Ray PointingRay => new Ray(rightHand.position, rightHand.forward);
        private void Start()
        {
            line = WorldDrawing.Line("ControllerRay", transform, assets.ink, Color.white, 0.001f);
            line.useWorldSpace = true; line.positionCount = 2;
        }
        private void Update()
        {
            var ray = PointingRay; var pressed = Input.TriggerDown;
#if UNITY_EDITOR
            if (mouseCamera != null && Mouse.current != null && Mouse.current.leftButton.wasPressedThisFrame)
            { ray = mouseCamera.ScreenPointToRay(Mouse.current.position.ReadValue()); pressed = true; }
#endif
            var hitSomething = Physics.Raycast(ray, out var hit, 10, ~0, QueryTriggerInteraction.Collide);
            if (line != null)
            { line.SetPosition(0, ray.origin); line.SetPosition(1, hitSomething ? hit.point : ray.GetPoint(3)); }
            if (!pressed) return;
            AnyPress?.Invoke();
            if (!hitSomething) return;
            var button = hit.collider.GetComponentInParent<RayButton>();
            if (button != null) button.Press(); else TargetPressed?.Invoke(hit);
        }
    }
}
using System;
using LOBOver.World;
using TMPro;
using UnityEngine;

namespace LOBOver.VR
{
    public sealed class RayButton : MonoBehaviour
    {
        public TextMeshPro label;
        public Transform face;
        public AudioSource click;
        public bool Available = true;
        public Action Pressed;
        private float depressedUntil;
        // WO-09 section 5: 5 mm depression; the short click uses hydraulics_01.
        public void Press()
        {
            depressedUntil = Time.unscaledTime + 0.12f;
            if (click != null && click.clip != null) click.Play();
            Pressed?.Invoke();
        }
        private void Update()
        {
            if (face != null) face.localPosition = new Vector3(0, 0, Time.unscaledTime < depressedUntil ? 0.005f : 0);
            if (label != null) label.color = Available ? Color.white : Color.gray;
        }
        public static RayButton Create(Transform parent, string title, Vector3 position, Vector2 size, WorldAssets assets, AudioClip sound, Action action)
        {
            var root = WorldDrawing.Group(title, parent); root.transform.localPosition = position;
            var button = root.AddComponent<RayButton>();
            button.face = WorldDrawing.Box("SafetyOrange", root.transform, Vector3.zero, new Vector3(size.x, size.y, 0.01f), assets.orange).transform;
            button.label = WorldDrawing.Text("Label", root.transform, new Vector3(0, 0, -0.006f), size * 0.9f, size.y * 0.27f, assets.font);
            button.label.alignment = TextAlignmentOptions.Center; button.label.text = title;
            button.click = WorldDrawing.Sound(root, false, 2); button.click.clip = sound;
            button.Pressed = action; return button;
        }
    }
}
using UnityEngine;
namespace LOBOver.VR
{
    // Explicit, eye-locked comfort mask. No scene-load fade or world motion.
    public sealed class ComfortFade : MonoBehaviour
    {
        public Material material;
        private MeshRenderer blackout, vignette;
        private Mesh fullMesh, ringMesh;
        private MaterialPropertyBlock colour;
        private void Awake()
        {
            colour = new MaterialPropertyBlock();
            fullMesh = new Mesh { name = "Blackout" };
            fullMesh.vertices = new[] { new Vector3(-2, -2, 0.2f), new Vector3(2, -2, 0.2f), new Vector3(-2, 2, 0.2f), new Vector3(2, 2, 0.2f) };
            fullMesh.triangles = new[] { 0, 2, 1, 2, 3, 1 }; fullMesh.colors = new[] { Color.white, Color.white, Color.white, Color.white };
            blackout = Surface("Blackout", fullMesh);
            const int edges = 64;
            var vertices = new Vector3[edges * 2]; var colours = new Color[edges * 2]; var indices = new int[edges * 6];
            for (var i = 0; i < edges; i++)
            {
                var angle = i * Mathf.PI * 2 / edges; var direction = new Vector3(Mathf.Cos(angle), Mathf.Sin(angle), 0);
                vertices[i * 2] = direction * 0.12f + Vector3.forward * 0.19f;
                vertices[i * 2 + 1] = direction * 0.35f + Vector3.forward * 0.19f;
                colours[i * 2] = new Color(1, 1, 1, 0); colours[i * 2 + 1] = Color.white;
                var next = (i + 1) % edges * 2; var start = i * 6;
                indices[start] = i * 2; indices[start + 1] = next; indices[start + 2] = i * 2 + 1;
                indices[start + 3] = next; indices[start + 4] = next + 1; indices[start + 5] = i * 2 + 1;
            }
            ringMesh = new Mesh { name = "RideVignette", vertices = vertices, triangles = indices, colors = colours };
            vignette = Surface("Vignette", ringMesh); SetExplicitFade(0);
        }
        private MeshRenderer Surface(string name, Mesh mesh)
        {
            var obj = new GameObject(name); obj.transform.SetParent(transform, false);
            obj.AddComponent<MeshFilter>().sharedMesh = mesh; var renderer = obj.AddComponent<MeshRenderer>(); renderer.sharedMaterial = material;
            renderer.shadowCastingMode = UnityEngine.Rendering.ShadowCastingMode.Off; renderer.receiveShadows = false; return renderer;
        }
        public void SetExplicitFade(float value)
        {
            if (blackout == null) return;
            blackout.enabled = value > 0; colour.SetColor("_Color", new Color(0, 0, 0, value)); blackout.SetPropertyBlock(colour);
            // WO-09 section 7: vignette appears only during the fade, never during ordinary inspection.
            vignette.enabled = value > 0 && value < 1;
            colour.SetColor("_Color", new Color(0, 0, 0, Mathf.Sin(value * Mathf.PI))); vignette.SetPropertyBlock(colour);
        }
        private void OnDestroy() { if (fullMesh != null) Destroy(fullMesh); if (ringMesh != null) Destroy(ringMesh); }
    }
}
