--- /dev/null
+++ b/Assets/LOBOver/Runtime/XR/RigAnchorFollower.cs
@@ -0,0 +1,19 @@
+using UnityEngine;
+
+namespace LOBOver.XR
+{
+    // Only owned presentation objects follow anchors; the block hierarchy never changes.
+    public sealed class RigAnchorFollower : MonoBehaviour
+    {
+        public XRRig rig;
+        public bool leftWrist;
+        public Vector3 positionOffset, rotationOffset;
+        private void LateUpdate()
+        {
+            if (rig == null) return;
+            var anchor = leftWrist ? rig.LeftWrist : rig.CentreEye;
+            if (anchor == null) return;
+            transform.SetPositionAndRotation(anchor.TransformPoint(positionOffset), anchor.rotation * Quaternion.Euler(rotationOffset));
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/XR/XRRig.cs b/Assets/LOBOver/Runtime/XR/XRRig.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1d7c5d9a053f76f3300e73c49b7da23f7bdc00a5
--- /dev/null
+++ b/Assets/LOBOver/Runtime/XR/XRRig.cs
@@ -0,0 +1,85 @@
+using System.Collections.Generic;
+using System.Linq;
+using Meta.XR.BuildingBlocks;
+using Oculus.Interaction;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.XR;
+
+namespace LOBOver.XR
+{
+    // Read-only access to Bryan's blocks. Nothing here configures or moves their objects.
+    [DefaultExecutionOrder(-600)]
+    public sealed class XRRig : MonoBehaviour
+    {
+        public OVRCameraRig CameraRig { get; private set; }
+        public Transform CentreEye => CameraRig == null ? null : CameraRig.centerEyeAnchor;
+        public Transform LeftController => CameraRig == null ? null : CameraRig.leftControllerAnchor;
+        public Transform RightController => CameraRig == null ? null : CameraRig.rightControllerAnchor;
+        public Transform LeftHand => CameraRig == null ? null : CameraRig.leftHandAnchor;
+        public Transform RightHand => CameraRig == null ? null : CameraRig.rightHandAnchor;
+        public Transform LeftWrist => leftTrackedHand != null && leftTrackedHand.IsTracked ? LeftHand : LeftController;
+        public OVRPassthroughLayer Passthrough { get; private set; }
+        public RayInteractor[] Rays { get; private set; }
+        public PokeInteractor[] Pokes { get; private set; }
+        private readonly HashSet<string> reported = new HashSet<string>();
+        private OVRHand leftTrackedHand;
+        // Meta SDK's Real Hands block id (core/Editor/BuildingBlocks/BlockDataIds.cs).
+        public const string RealHandsId = "f547fe18-d477-46ec-bdf5-7208df19cb98";
+
+        public static T[] Components<T>(Scene scene) where T : Component => scene.GetRootGameObjects()
+            .SelectMany(root => root.GetComponentsInChildren<T>(true)).ToArray();
+        private void Awake() => Resolve();
+        public bool Resolve(bool logErrors = true)
+        {
+            var scene = gameObject.scene;
+            CameraRig = Components<OVRCameraRig>(scene).FirstOrDefault();
+            var blocks = Components<BuildingBlock>(scene);
+            var hands = Components<OVRHand>(scene);
+            leftTrackedHand = hands.FirstOrDefault(hand => hand.GetHand() == OVRPlugin.Hand.HandLeft);
+            // These block ids cover both the core and comprehensive ISDK tracking installations.
+            var controllerTracking = blocks.Any(block => block.BlockId == "5817f7c0-f2a5-45f9-a5ca-64264e0166e8"
+                || block.BlockId == "f10154e0-16b2-492f-97d0-6639f69e7df6")
+                || Components<Oculus.Interaction.Input.FromOVRControllerDataSource>(scene).Length >= 2;
+            var handTracking = blocks.Any(block => block.BlockId == "8b26b298-7bf4-490e-b245-a039c0184303"
+                || block.BlockId == "0393ca30-f2a9-4865-a40f-f9a68d01c3a9")
+                || Components<Oculus.Interaction.Input.FromOVRHandDataSource>(scene).Length >= 2;
+            // Prefer the explicit Passthrough block; the additional layer on the rig is preserved.
+            var layers = Components<OVRPassthroughLayer>(scene);
+            Passthrough = layers.FirstOrDefault(layer => layer.GetComponent<BuildingBlock>() != null
+                && layer.GetComponent<OVRCameraRig>() == null) ?? layers.FirstOrDefault();
+            Rays = Components<RayInteractor>(scene); Pokes = Components<PokeInteractor>(scene);
+            var valid = Require(CameraRig != null && CentreEye != null, "Camera Rig (centre eye)", logErrors);
+            valid &= Require(controllerTracking && LeftController != null, "Controller Tracking (left)", logErrors);
+            valid &= Require(controllerTracking && RightController != null, "Controller Tracking (right)", logErrors);
+            valid &= Require(handTracking && LeftHand != null, "Hand Tracking (left)", logErrors);
+            valid &= Require(handTracking && RightHand != null, "Hand Tracking (right)", logErrors);
+            valid &= Require(Passthrough != null, "Passthrough", logErrors);
+            valid &= Require(Rays.Length > 0 && Pokes.Length > 0, "Interactions Rig (ray and poke)", logErrors);
+            valid &= Require(Components<BuildingBlock>(scene).Any(block => block.BlockId == RealHandsId), "Real Hands", logErrors);
+            return valid;
+        }
+        private bool Require(bool present, string block, bool log)
+        {
+            if (!present && log && reported.Add(block)) Debug.LogError("LOB Over: missing " + block + "; add it from Building Blocks.", this);
+            return present;
+        }
+        public bool TryHeadPose(out Pose pose)
+        {
+            pose = default;
+            if (CentreEye == null) return false;
+#if UNITY_EDITOR
+            if (!OVRManager.isHmdPresent)
+            {
+                pose = new Pose(CentreEye.position, CentreEye.rotation);
+                return true;
+            }
+#endif
+            var device = InputDevices.GetDeviceAtXRNode(XRNode.Head);
+            if (!device.isValid || !device.TryGetFeatureValue(CommonUsages.isTracked, out var tracked) || !tracked) return false;
+            var position = CentreEye.position;
+            if (float.IsNaN(position.x) || float.IsNaN(position.y) || float.IsNaN(position.z)) return false;
+            pose = new Pose(position, CentreEye.rotation); return true;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/XR/XRRuntimeSettings.cs b/Assets/LOBOver/Runtime/XR/XRRuntimeSettings.cs
new file mode 100644
index 0000000000000000000000000000000000000000..fb8cd758246f7527d99b7983c73465a2125e7858
--- /dev/null
+++ b/Assets/LOBOver/Runtime/XR/XRRuntimeSettings.cs
@@ -0,0 +1,18 @@
+using System.Collections;
+using UnityEngine;
+
+namespace LOBOver.XR
+{
+    public sealed class XRRuntimeSettings : MonoBehaviour
+    {
+        private const float TargetRefreshRate = 72; // WO-S4 performance target, retained by WO-S6.
+        private IEnumerator Start()
+        {
+            // WO-S4 performance settings, centralized by WO-S6. No scene OVRManager fields.
+            while (!OVRManager.isHmdPresent || OVRManager.display == null) yield return null;
+            OVRManager.display.displayFrequency = TargetRefreshRate;
+            OVRManager.useDynamicFoveatedRendering = false;
+            OVRManager.foveatedRenderingLevel = OVRManager.FoveatedRenderingLevel.Medium;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Tests/CheckFoundation.py b/Assets/LOBOver/Tests/CheckFoundation.py
new file mode 100644
index 0000000000000000000000000000000000000000..ea1042ab564bcd349b8aa408afb16fc8cfa97765
--- /dev/null
+++ b/Assets/LOBOver/Tests/CheckFoundation.py
@@ -0,0 +1,22 @@
+"""WO-S6 source acceptance scan; requires only the installed Python standard library."""
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parents[1]
+files = [*root.joinpath("Editor").rglob("*.cs"), *root.joinpath("Runtime").rglob("*.cs")]
+errors = []
+for path in files:
+    source = path.read_text(encoding="utf-8-sig")
+    if re.search(r"AddComponent\s*<\s*OVR", source):
+        errors.append(f"{path}: adds an OVR component")
+    if re.search(r"Instantiate\s*\([^;]*(?:OVRCameraRig|rig\.gameObject)", source):
+        errors.append(f"{path}: copies a camera rig")
+    if "OVRInput." in source and "Physics.Raycast" in source:
+        errors.append(f"{path}: controller input and manual raycast coexist")
+    if re.search(r"\b(?:rig|CameraRig)\.transform\.(?:SetParent|RotateAround|position\s*=)", source):
+        errors.append(f"{path}: moves or reparents the rig")
+if root.joinpath("Runtime/VR/ControllerPointer.cs").exists():
+    errors.append("The custom ControllerPointer remains")
+if errors:
+    raise SystemExit("\n".join(errors))
+print(f"PASS: {len(files)} source files; no OVR component creation, rig copying/reparenting, or OVRInput raycasts; custom pointer removed.")
diff --git a/Assets/LOBOver/Tests/EditMode/BuildingBlocksTests.cs b/Assets/LOBOver/Tests/EditMode/BuildingBlocksTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ef535df73e467a167a63e622b632d387cbca9acd
--- /dev/null
+++ b/Assets/LOBOver/Tests/EditMode/BuildingBlocksTests.cs
@@ -0,0 +1,91 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Text.RegularExpressions;
+using LOBOver.Editor;
+using LOBOver.Start;
+using LOBOver.XR;
+using Meta.XR.BuildingBlocks;
+using NUnit.Framework;
+using Oculus.Interaction;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+
+namespace LOBOver.Tests.Editor
+{
+    public sealed class BuildingBlocksTests
+    {
+        [Test]
+        public void ExistingSiteHasEveryRequiredBlock()
+        {
+            var scene = SiteSceneBuilder.OpenExisting();
+            Assert.That(BuildingBlocksSetup.Missing(scene), Is.Empty);
+        }
+
+        [Test]
+        public void RebuildTwicePreservesBlocksRigAndUnownedRoots()
+        {
+            var scene = SiteSceneBuilder.OpenExisting();
+            var sentinel = new GameObject("[BuildingBlock] Test");
+            SceneManager.MoveGameObjectToScene(sentinel, scene);
+            var protectedTransforms = XRRig.Components<BuildingBlock>(scene).SelectMany(block => block.GetComponentsInChildren<Transform>(true))
+                .Concat(XRRig.Components<OVRCameraRig>(scene).SelectMany(rig => rig.GetComponentsInChildren<Transform>(true)))
+                .Append(sentinel.transform).Distinct().ToArray();
+            var before = protectedTransforms.Select(t => (t, id: t.GetInstanceID(), parent: t.parent, position: t.localPosition,
+                rotation: t.localRotation, scale: t.localScale, active: t.gameObject.activeSelf)).ToArray();
+            try
+            {
+                SiteSceneBuilder.Build(false); SiteSceneBuilder.Build(false);
+                foreach (var item in before)
+                {
+                    Assert.That(item.t, Is.Not.Null);
+                    Assert.That(item.t.GetInstanceID(), Is.EqualTo(item.id)); Assert.That(item.t.parent, Is.EqualTo(item.parent));
+                    Assert.That(item.t.localPosition, Is.EqualTo(item.position)); Assert.That(item.t.localRotation, Is.EqualTo(item.rotation));
+                    Assert.That(item.t.localScale, Is.EqualTo(item.scale)); Assert.That(item.t.gameObject.activeSelf, Is.EqualTo(item.active));
+                }
+                var roots = scene.GetRootGameObjects();
+                foreach (var name in new[] { "Lighting", "Director", "Hub", "Site", "Start", "Preview" })
+                    Assert.That(roots.Count(root => root.name == "[LOBOver] " + name), Is.EqualTo(1));
+                var floor = roots.Single(root => root.name == "[LOBOver] Hub").transform.Find("TrackedFloor").GetComponent<BoxCollider>();
+                Assert.That(floor.bounds.size.x, Is.EqualTo(20)); Assert.That(floor.bounds.size.z, Is.EqualTo(20));
+                Assert.That(floor.bounds.max.y, Is.EqualTo(0).Within(0.0001));
+                var start = XRRig.Components<StartPanel>(scene).Single();
+                var pointable = start.panel.GetComponent<PointableCanvas>();
+                Assert.That(pointable.Canvas.renderMode, Is.EqualTo(RenderMode.WorldSpace));
+                Assert.That(start.panel.GetComponent<RayInteractable>().PointableElement, Is.SameAs(pointable));
+                Assert.That(start.panel.GetComponent<PokeInteractable>().PointableElement, Is.SameAs(pointable));
+                Assert.That(start.panel.GetComponentInParent<OVRCameraRig>(), Is.Null);
+            }
+            finally { if (sentinel != null) UnityEngine.Object.DestroyImmediate(sentinel); }
+        }
+
+        [Test]
+        public void ConfigureIsIdempotentAndDisablesLocomotion()
+        {
+            var scene = SiteSceneBuilder.OpenExisting();
+            BuildingBlocksSetup.Configure(scene);
+            var components = XRRig.Components<Component>(scene).Where(c => c != null).ToArray();
+            var before = components.Select(UnityEditor.EditorJsonUtility.ToJson).ToArray();
+            BuildingBlocksSetup.Configure(scene);
+            CollectionAssert.AreEqual(before, components.Select(UnityEditor.EditorJsonUtility.ToJson).ToArray());
+            foreach (var behaviour in XRRig.Components<Behaviour>(scene).Where(c => c.GetType().Namespace == "Oculus.Interaction.Locomotion"))
+                Assert.That(behaviour.enabled, Is.False, behaviour.name);
+            foreach (var locomotor in XRRig.Components<Oculus.Interaction.Locomotion.FirstPersonLocomotor>(scene))
+                Assert.That(locomotor.GravityFactor, Is.Zero);
+        }
+
+        [Test]
+        public void SourcesNeverBuildRigsOrRaycastWithControllerInput()
+        {
+            foreach (var folder in new[] { "Editor", "Runtime" })
+                foreach (var file in Directory.GetFiles("Assets/LOBOver/" + folder, "*.cs", SearchOption.AllDirectories))
+                {
+                    var source = File.ReadAllText(file);
+                    Assert.That(Regex.IsMatch(source, @"AddComponent\s*<\s*" + "OVR"), Is.False, file);
+                    Assert.That(Regex.IsMatch(source, @"Instantiate\s*\([^;]*(?:" + "OVRCameraRig|rig.gameObject)"), Is.False, file);
+                    Assert.That(source.Contains("OVRInput.") && source.Contains("Physics.Raycast"), Is.False, file);
+                }
+            Assert.That(File.Exists("Assets/LOBOver/Runtime/VR/" + "ControllerPointer.cs"), Is.False);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Tests/PlayMode/BuildingBlocksStabilityTests.cs b/Assets/LOBOver/Tests/PlayMode/BuildingBlocksStabilityTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..b0123d88dd8c8e51de046593e686ff088a7a1c85
--- /dev/null
+++ b/Assets/LOBOver/Tests/PlayMode/BuildingBlocksStabilityTests.cs
@@ -0,0 +1,43 @@
+using System.Collections;
+using LOBOver.Start;
+using LOBOver.XR;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.TestTools;
+
+namespace LOBOver.Tests
+{
+    public sealed class BuildingBlocksStabilityTests
+    {
+        [UnityTest]
+        public IEnumerator RigAndStartPanelStayStillForThreeSecondsWithoutHeadset()
+        {
+#if UNITY_EDITOR
+            yield return UnityEditor.SceneManagement.EditorSceneManager.LoadSceneInPlayMode(
+                "Assets/LOBOver/Scenes/Site.unity", new LoadSceneParameters(LoadSceneMode.Single));
+            var start = Object.FindFirstObjectByType<StartPanel>();
+            var rig = Object.FindFirstObjectByType<XRRig>();
+            Assert.That(rig.CameraRig, Is.Not.Null);
+            for (var frame = 0; frame < 120 && !start.Placed; frame++) yield return null;
+            Assert.That(start.Placed, Is.True, "Start panel never received its first head pose");
+            Assert.That(start.panel.gameObject.activeInHierarchy, Is.True);
+            var y = rig.CameraRig.transform.position.y; var position = start.panel.position; var rotation = start.panel.rotation;
+            Debug.Log("WO-S6 rig y at 0 s: " + y.ToString("F4"));
+            var until = Time.realtimeSinceStartup + 3;
+            while (Time.realtimeSinceStartup < until)
+            {
+                Assert.That(rig.CameraRig.transform.position.y, Is.EqualTo(y).Within(0.01));
+                Assert.That(Vector3.Distance(start.panel.position, position), Is.LessThan(0.0001f));
+                Assert.That(Quaternion.Angle(start.panel.rotation, rotation), Is.LessThan(0.001f));
+                yield return null;
+            }
+            Debug.Log("WO-S6 rig y at 3 s: " + rig.CameraRig.transform.position.y.ToString("F4"));
+            start.PlaceOnce(new Pose(position + Vector3.one, Quaternion.Euler(0, 90, 0)));
+            Assert.That(start.panel.position, Is.EqualTo(position), "A later pose moved the placed panel");
+#else
+            Assert.Ignore("Editor no-headset stability check"); yield break;
+#endif
+        }
+    }
+}

