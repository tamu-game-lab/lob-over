+    click *= CLICK_RELATIVE_PEAK * np.max(np.abs(filtered)) / np.max(np.abs(click))
+    gap = np.zeros(round(CLICK_GAP_SECONDS * SAMPLE_RATE))
+    return np.concatenate((click, gap, filtered, gap, click))
+
+
+def create_pipeline():
+    import spacy
