.pm{display:flex;align-items:end;position:relative;flex:1;min-height:145px;margin-top:9px;border-top:1px solid #72807a;padding-top:7px;gap:8px}.portrait-frame{align-self:stretch;position:relative;width:39%;flex-shrink:0;overflow:hidden;background:radial-gradient(ellipse at bottom,#79897e80,transparent 70%)}#pm-portrait{position:absolute;left:50%;bottom:0;transform:translateX(-50%);width:185%;height:112%;object-fit:contain;object-position:center bottom}.pm-message{align-self:center;flex:1;min-width:0;padding-right:4px}.pm-label{color:#bdc8bf;font-size:10px;letter-spacing:.13em;text-transform:uppercase;margin-bottom:9px}.pm-label strong{display:block;color:#f0ead8;font:600 18px var(--display);letter-spacing:0;text-transform:none}#pm-bubble{position:relative;color:#35413a;background:#f4ecd9;padding:12px 14px;border-radius:4px;box-shadow:0 3px 0 #14212666;font-size:clamp(12px,.95vw,16px);line-height:1.45}#pm-bubble:before{content:"";position:absolute;left:-8px;bottom:15px;border-top:8px solid transparent;border-bottom:8px solid transparent;border-right:9px solid #f4ecd9}#feedback{position:absolute;left:15px;right:15px;bottom:9px;font-size:12px;background:#263638;color:#f1e2cb}#feedback:empty{display:none}
.reports{min-height:0;display:flex;gap:17px;background:#d7d0bb;border:1px solid #a5a88e;border-radius:3px;padding:12px 16px;box-shadow:0 3px 5px #111b1e66}.reports-heading{width:110px;flex-shrink:0;align-self:center}.reports h2{font-size:18px;line-height:1.15}.reports-heading p{font-size:10px;margin-top:6px;color:#626959}#reports{display:flex;gap:10px;flex:1;min-width:0;align-items:stretch;overflow:hidden;list-style:none;padding:0;margin:0}.report{flex:1;min-width:0;padding:8px 10px;background:#f7f0df;border-left:1px dashed #9f9d83;box-shadow:1px 2px 3px #797c6229;font-size:11px;line-height:1.55}.report-day{font:600 14px var(--display);display:block;border-bottom:1px solid #d8d7bf;margin-bottom:4px;padding-bottom:3px}.report-crew{display:block;white-space:nowrap}.report-crew:before{content:"";display:inline-block;width:4px;height:9px;background:var(--crew);margin-right:5px}.report-separator{display:none}.report-empty{font-size:12px;align-self:center;color:#717460}.report-new{outline:1px solid #a5a88e}
@media(min-width:1650px){body{grid-template-rows:105px minmax(0,1fr) 160px;gap:24px;padding:0 30px 24px}header{gap:30px}h1{font-size:32px}h1 small{font-size:13px}.connection{min-width:210px}.clock{font-size:14px}.site{font-size:13px}.console{padding:22px}.console-heading{margin-bottom:16px}#crews{gap:14px}.crew-card{padding:16px;grid-template-columns:minmax(0,1fr) 160px}.crew-name{font-size:22px}.foreman{font-size:15px}.crew-meta{font-size:14px}.order-state{font-size:12px}.crew-switch{font-size:15px}.pm{min-height:210px}.report{font-size:14px;padding:10px 14px}.report-day{font-size:17px}.reports-heading{width:145px}.reports h2{font-size:22px}.legend{font-size:12px}.board{padding:24px}.eyebrow{font-size:12px}}
</style></head>
<body>
<header>
  <div class="brand"><h1>LOB, Over <small>Level 1 Â· Texas water main</small></h1></div>
  <div class="calendar" id="calendar" aria-label="Day 1"><span>DAY</span><strong id="day">1</strong></div>
  <div class="connection"><div class="clock" id="clock" data-speed="paused" role="status">Paused</div><div class="site"><svg class="radio-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14v13H5zM8 8V2m3 10h5m-5 4h5M2 4v4m20-4v4"/></svg><span id="site-status">Waiting for the headset</span></div></div>
  <div class="header-actions"><a href="/level1/rules.pdf" target="_blank" rel="noopener">Rules page â†—</a><button class="mute" id="mute" aria-pressed="false" aria-label="Mute all sound">â™ª Mute</button><button class="main-button" id="start" disabled>Start</button></div>
</header>
<main>
  <section class="board" aria-labelledby="board-title"><div class="eyebrow">Site office / Line of balance</div><h2 id="board-title">The PM's plan: promised Day 18</h2>
    <div class="legend"><span><i class="dashed"></i>PM's plan</span><span><i></i><span id="actual-label">Reported through yesterday</span></span><span id="previous-label" hidden><i class="faint"></i>Previous run Â· 25%</span></div>
    <div class="chart-wrap"><svg id="chart" viewBox="0 0 1000 590" role="img" aria-label="Days across from Day 1 at the left, stations up from 0+00 to 30+00"><g id="grid"></g><g id="previous-lines"></g><g id="planned-lines"></g><g id="reported-lines"></g><g id="ruler" hidden><rect x="-5" y="38" width="10" height="486" fill="#8c7958" fill-opacity=".18"/><path d="M0 38V524" stroke="#71634a" stroke-width="1.4"/><text id="today-label" x="0" y="28" text-anchor="middle">Today</text></g></svg></div>
    <div class="stamp" id="result" hidden><div class="eyebrow">Run record</div><div id="finish"></div><div class="eyebrow" style="margin-top:12px">Idle crew-days</div><div id="idle"></div></div>
  </section>
  <aside class="console" aria-labelledby="console-title"><div class="console-heading"><h2 id="console-title">Crew radio</h2><span>PLAN / TRANSMIT</span></div><div id="crews"></div>
    <section class="pm" aria-label="Project manager"><div class="portrait-frame"><img id="pm-portrait" src="img/clipboard_Final.png" alt="The project manager holding a clipboard"></div><div class="pm-message"><div class="pm-label">From the site office<strong>The PM</strong></div><p id="pm-bubble" role="status" hidden></p></div><p id="feedback" role="status"></p></section>
  </aside>
</main>
<section class="reports" aria-labelledby="reports-title"><div class="reports-heading"><div class="eyebrow">Incoming</div><h2 id="reports-title">Daily reports</h2><p>Latest at the right â†’</p></div><ol id="reports" aria-live="polite"><li class="report-empty">Awaiting the first daily report.</li></ol></section>
<script src="lib/transport.js"></script><script src="lib/play-audio.js"></script>
<script>
'use strict';
const $=id=>document.getElementById(id), CREWS=['exc','pipe','back'];
// WO-L3: shared crew inks and presentation timings; none affect the host clock.
const COLORS={exc:'#E0A800',pipe:'#2E86C1',back:'#D35400'};
const TAPE_MS=3000, WORRIED_MS=4000, TYPE_MS=600, COUNT_MS=1000, REPORT_LIMIT=5;
// Docs/LEVEL1.md, The job: all three crews use one Standard machine.
const MACHINE='Standard', REPORT_NAMES={exc:'Excavation',pipe:'Pipe',back:'Backfill'};
const esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const station=ft=>Math.floor(ft/100)+'+'+String(Math.round(ft%100)).padStart(2,'0');
const number=value=>Math.round(value).toLocaleString('en-US');
let state, result, sequence=0, mirror=false, starting=false, connected=true, hasStarted=false;
let chartKey='', gridKey='', drawn={}, lastTotals={}, lastReportDay=0, voiceText='', worried=false, worriedTimer, countFrame;
const heldSince={}, pending=new Map(), switching=new Map(), tapeTimers=new Map(), typing=new Map();
const audio=LobOfficeAudio.create(text=>{voiceText=text;$('pm-bubble').textContent=text;$('pm-bubble').hidden=!text;portrait();});
const socket=LobTransport.connect();
socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'plan',client:'web'}));
socket.onclose=()=>{connected=false;starting=false;switching.clear();$('feedback').textContent='Connection to the game closed.';if(state)render();};
function send(t,action,fields={},onAck,crew){
  if(socket.readyState!==WebSocket.OPEN)return false;
  const id='l1-'+(++sequence);pending.set(id,{onAck,crew});
  socket.send(JSON.stringify({t,v:1,id,seat:'plan',action,...fields}));return true;
}
function portrait(){
  const name=worried?'worriedSurprise.png':voiceText?'explaining_Final.png':'clipboard_Final.png';
  const img=$('pm-portrait');if(!img.src.endsWith(name))img.src='img/'+name;
  img.alt=worried?'The project manager looking worried':voiceText?'The project manager speaking':'The project manager holding a clipboard';
}
$('mute').onclick=()=>{const muted=audio.toggleMute();$('mute').setAttribute('aria-pressed',String(muted));$('mute').setAttribute('aria-label',muted?'Unmute all sound':'Mute all sound');$('mute').textContent=muted?'â™ª Muted':'â™ª Mute';};
$('start').onclick=()=>{
  audio.sound('click');starting=true;$('start').disabled=true;$('feedback').textContent='';
  if(result)send('ctrl','reset',{},()=>send('ctrl','start'));
  else send('ctrl','start');
};
$('crews').onclick=event=>{
  const button=event.target.closest('[data-crew]'),crew=button?.dataset.crew;
  if(!crew||mirror||result||!connected||switching.has(crew))return;
  switching.set(crew,!state.view.held[crew]);renderCrews();audio.sound('switch');
  if(!send('cmd','commit',{ops:[{op:state.view.held[crew]?'resume':'hold',crew}]},null,crew)){switching.delete(crew);renderCrews();}
};
function makeCrews(){
  $('crews').innerHTML=state.view.crews.map(c=>`<article class="crew-card" id="crew-${c.id}" style="--crew:${COLORS[c.id]}"><div><div class="crew-name">${esc(c.name)}<span class="foreman">${esc(c.foreman)}</span></div><div class="crew-meta">${MACHINE} Â· <strong>${c.rate} ft / day</strong> Â· Start Day ${c.startDay}</div></div><div><button type="button" role="switch" class="crew-switch" data-crew="${c.id}" aria-label="Hold ${esc(c.name)}" aria-checked="false"><span class="go">GO</span><span class="hold">HOLD</span></button><div class="order-state"><i class="lamp" aria-hidden="true"></i><span id="order-${c.id}">Go</span></div></div><div class="refusal" id="refusal-${c.id}" role="status" hidden></div></article>`).join('');
}
function renderCrews(){
  for(const c of state.view.crews){
    const held=state.view.held[c.id],button=document.querySelector(`[data-crew="${c.id}"]`);
    if(held&&heldSince[c.id]===undefined)heldSince[c.id]=state.displayDay;
    if(!held)delete heldSince[c.id];
    button.setAttribute('aria-checked',String(switching.get(c.id)??held));
    button.disabled=mirror||!!result||!connected||switching.has(c.id);
    $('crew-'+c.id).dataset.held=String(held);
    $('order-'+c.id).textContent=held?'Holding since Day '+heldSince[c.id]:'Go';
  }
}
function drawChart(){
  const v=state.view,length=v.project.job.lengthFt,previous=result?result.previousRun?.lines.actual:v.previousRun;
  const actual=result?.lines.actual??v.reportedLines,planned=result?.lines.planned??v.plannedPolylines;
  const all=[...Object.values(actual).flat(),...Object.values(previous??{}).flat()];
  const maxDay=Math.max(v.promisedDay+3,state.displayDay,...all.map(p=>Math.ceil(p.t+1)));
  const x=t=>65+t/(maxDay-1)*850,y=ft=>524-ft/length*486;
  const nextGrid=JSON.stringify([length,maxDay,v.project.job.zones]);
  if(gridKey!==nextGrid){
    let grid=v.project.job.zones.map((z,i)=>`<rect class="zone-band" x="65" y="${y(z.toFt)}" width="850" height="${y(z.fromFt)-y(z.toFt)}" fill="${i%2?'#b3bea5':'#bda47b'}" opacity=".12"/><text class="zone-label" x="928" y="${y((z.fromFt+z.toFt)/2)+4}">ZONE ${z.id}</text>`).join('');
    for(let ft=0;ft<=length;ft+=v.project.job.stationEveryFt){
      const major=ft%500===0;grid+=`<line x1="65" x2="915" y1="${y(ft)}" y2="${y(ft)}" stroke="#7f8870" stroke-opacity="${major?.3:.12}"/>`;
      if(major)grid+=`<text class="station-label" x="53" y="${y(ft)+4}" text-anchor="end">${station(ft)}</text>`;
    }
    for(let day=1;day<=maxDay;day++)grid+=`<line x1="${x(day-1)}" x2="${x(day-1)}" y1="38" y2="524" stroke="#7f8870" stroke-opacity=".2"/><text class="day-label" x="${x(day-1)}" y="549" text-anchor="middle">${day}</text>`;
    grid+=`<text x="490" y="578" text-anchor="middle">Day</text><path d="M${x(v.promisedDay-1)} 38V524" stroke="#776c52" stroke-dasharray="3 5"/>`;
    $('grid').innerHTML=grid;gridKey=nextGrid;
  }
  const nextKey=JSON.stringify([nextGrid,planned,actual,previous]);
  if(chartKey!==nextKey){
    const line=(id,points,kind,opacity=1,extra='')=>points?.length>1?`<polyline data-line="${id}" data-kind="${kind}" points="${points.map(p=>`${x(p.t)},${y(p.ft)}`).join(' ')}" fill="none" stroke="${COLORS[id]}" stroke-width="${kind==='plan'?2.5:3.5}" stroke-linecap="round" stroke-linejoin="round" ${kind==='plan'?'stroke-dasharray="9 7"':''} opacity="${opacity}" ${extra}/>`:'';
    $('previous-lines').innerHTML=CREWS.map(id=>line(id,previous?.[id],'previous',.25)).join('');
    $('planned-lines').innerHTML=CREWS.map(id=>line(id,planned[id],'plan')).join('');
    $('reported-lines').innerHTML=CREWS.map(id=>{
      const points=actual[id],old=drawn[id]??[],extendsOld=old.length&&points.length>old.length&&old.every((p,i)=>p.t===points[i].t&&p.ft===points[i].ft);
      if(!result&&extendsOld)return line(id,old,'actual')+line(id,points.slice(old.length-1),'segment',1,'class="ink-segment" pathLength="1"');
      return line(id,points,'actual');
    }).join('');
    chartKey=nextKey;drawn=structuredClone(actual);
  }
  $('previous-label').hidden=!previous;$('ruler').toggleAttribute('hidden',!hasStarted);
  $('ruler').style.transform=`translateX(${x(state.displayDay-1)}px)`;
  $('today-label').textContent='Day '+state.displayDay;
}
function render(){
  const v=state.view,day=Number.isFinite(result?.finishDay)?Math.floor(result.finishDay+1e-6)+1:state.displayDay;
  if($('day').textContent!==String(day)){
    $('day').textContent=day;$('calendar').setAttribute('aria-label','Day '+day);
    $('calendar').classList.remove('flip');void $('calendar').offsetWidth;$('calendar').classList.add('flip');audio.sound('tick');
  }
  $('clock').textContent=state.speed==='slow'?'Field is slow today':state.speed==='paused'?'Paused':'Running';$('clock').dataset.speed=state.speed;
  $('site-status').textContent=v.siteClient==='quest'?'Headset connected':v.siteClient==='web'?'Site connected in a browser':'Waiting for the headset';
  $('actual-label').textContent=result?'Actual work':'Reported through yesterday';
  $('start').textContent=result?'Run again':'Start';$('start').disabled=!connected||mirror||starting||(!result&&state.speed!=='paused');
  $('board-title').textContent=hasStarted?'Texas water main Â· Crew reports':`The PM's plan: promised Day ${v.promisedDay}`;
  renderCrews();drawChart();
}
function resetPresentation(){
  result=null;hasStarted=false;drawn={};chartKey='';lastTotals={};lastReportDay=0;
  for(const crew of CREWS)delete heldSince[crew];
  pending.clear();switching.clear();for(const timer of tapeTimers.values())clearTimeout(timer);tapeTimers.clear();
  for(const frame of typing.values())cancelAnimationFrame(frame);typing.clear();
  clearTimeout(worriedTimer);cancelAnimationFrame(countFrame);worried=false;audio.reset();
  $('result').hidden=true;$('feedback').textContent='';$('reports').innerHTML='<li class="report-empty">Awaiting the first daily report.</li>';
}
function acceptState(message){
  const newRun=state?.runId!==message.runId,wasSlow=state?.speed==='slow';
  if(newRun)resetPresentation();
  state=message;if(newRun)makeCrews();
  if(state.speed!=='paused'){starting=false;hasStarted=true;}
  if(state.speed==='slow'&&!wasSlow){
    worried=true;portrait();audio.sound('hiss');clearTimeout(worriedTimer);
    worriedTimer=setTimeout(()=>{worried=false;portrait();},WORRIED_MS);
  }
  render();
}
function report(message){
  if(message.day<=lastReportDay)return;
  const pieces=[`Day ${message.day}`,...CREWS.map(id=>`${REPORT_NAMES[id]} +${number(message.feetByCrew[id]-(lastTotals[id]??0))} ft (${number(message.feetByCrew[id])})`)];
  lastTotals={...message.feetByCrew};lastReportDay=message.day;
  $('reports').querySelector('.report-empty')?.remove();$('reports').querySelector('.report-new')?.classList.remove('report-new');
  const item=document.createElement('li');item.className='report report-new';item.dataset.day=message.day;
  pieces.forEach((text,i)=>{const span=document.createElement('span');span.className=i?'report-crew':'report-day';if(i)span.style.setProperty('--crew',COLORS[CREWS[i-1]]);item.append(span);if(i<pieces.length-1){const separator=document.createElement('span');separator.className='report-separator';separator.textContent=' Â· ';item.append(separator);}});
  $('reports').append(item);
  while($('reports').children.length>REPORT_LIMIT){const oldest=$('reports').firstElementChild;cancelAnimationFrame(typing.get(oldest));typing.delete(oldest);oldest.remove();}
  const spans=[...item.querySelectorAll('.report-day,.report-crew')],total=pieces.join('').length,start=performance.now();let lastClick=-1;
  function type(now){
    let remaining=Math.floor(Math.min(1,(now-start)/TYPE_MS)*total);
    spans.forEach((span,i)=>{span.textContent=pieces[i].slice(0,Math.max(0,remaining));remaining-=pieces[i].length;});
    const click=Math.floor((now-start)/75);if(click!==lastClick){audio.sound('teletype');lastClick=click;}
    if(now-start<TYPE_MS)typing.set(item,requestAnimationFrame(type));else typing.delete(item);
  }
  typing.set(item,requestAnimationFrame(type));
}
function showResult(message){
  result=message;starting=false;$('result').hidden=false;
  $('finish').textContent=Number.isFinite(result.finishDay)?`Finished Day ${Math.floor(result.finishDay+1e-6)+1} Â· Promised Day ${result.promisedDay}`:`Run ended Â· Promised Day ${result.promisedDay}`;
  $('idle').innerHTML=state.view.crews.map(c=>`<div class="idle-crew" style="--crew:${COLORS[c.id]}">${esc(c.name)}<strong class="idle-count" id="idle-${c.id}">0</strong></div>`).join('');
  cancelAnimationFrame(countFrame);const start=performance.now();
  function count(now){const progress=Math.min(1,(now-start)/COUNT_MS);for(const id of CREWS)$('idle-'+id).textContent=Number((result.idleDays[id]*progress).toFixed(2));if(progress<1)countFrame=requestAnimationFrame(count);}
  countFrame=requestAnimationFrame(count);render();
}
socket.onmessage=event=>{
  const message=JSON.parse(event.data);
  if(message.t==='welcome'){mirror=message.mirror;acceptState(message.state);}
  else if(message.t==='state')acceptState(message);
  else if(message.t==='ack'||message.t==='nack'){
    const request=pending.get(message.id);pending.delete(message.id);
    if(request?.crew)switching.delete(request.crew);
    if(message.t==='nack'){
      starting=false;
      if(request?.crew){const tape=$('refusal-'+request.crew);tape.textContent=message.reason;tape.hidden=false;clearTimeout(tapeTimers.get(request.crew));tapeTimers.set(request.crew,setTimeout(()=>{tape.hidden=true;},TAPE_MS));}
      else $('feedback').textContent=message.reason;
      render();
    }else request?.onAck?.();
  }else if(message.t==='voice')audio.play(message,state.stage);
  else if(message.t==='report')report(message);
  else if(message.t==='result')showResult(message);
};
</script></body></html>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOB, Over - Showcase host</title><style>
:root{font:14px/1.45 system-ui,sans-serif;color:#283942;background:#eeeae2}*{box-sizing:border-box}body{margin:0}header{background:#303c48;color:white;padding:18px 26px;display:flex;justify-content:space-between;align-items:center}h1{font-size:21px;margin:0}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase}main{padding:18px 24px;max-width:1600px;margin:auto}.panel{padding:16px;background:#fffdf8;border:1px solid #c7cec9;margin-bottom:16px}h2{font-size:15px;margin:0 0 10px}.controls{display:flex;flex-wrap:wrap;gap:9px}button,a{font:inherit;padding:9px 13px;border:1px solid #8b999f;border-radius:3px;background:#fffdf8;color:inherit;cursor:pointer;text-decoration:none}button:hover,a:hover{background:#e7edf0}.primary{background:#2b4758;color:white}.metrics{display:flex;gap:35px;margin-top:18px}.metrics b{display:block;font:600 24px ui-monospace,monospace}.metrics span{font-size:12px}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}pre{font:12px/1.5 ui-monospace,monospace;white-space:pre-wrap;overflow:auto;max-height:340px;padding:12px;background:#f0f1ec}summary{font-weight:600;cursor:pointer}table{width:100%;border-collapse:collapse;font-size:13px}td,th{text-align:left;border-bottom:1px solid #d4dcd8;padding:8px}#feedback{min-height:20px}#result{white-space:pre-wrap}@media(max-width:750px){.two{grid-template-columns:1fr}main{padding:12px}}
select,input{font:inherit;padding:8px;max-width:100%}label{display:flex;align-items:center;gap:8px}.showcase{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:24px}.setup{display:flex;flex-direction:column;gap:14px}.room{text-align:center}.room b{display:block;font:600 40px ui-monospace,monospace;letter-spacing:.12em}.room canvas{width:196px;height:196px;max-width:100%}.room a{display:block;padding:3px;border:0;font-size:12px;overflow-wrap:anywhere}#room-status{font-size:12px}#script-file{width:260px}.metrics{flex-wrap:wrap;gap:24px}@media(max-width:650px){.showcase{grid-template-columns:1fr}.room{border-top:1px solid #c7cec9;padding-top:14px}}
</style></head><body><header><div><div class="eyebrow">LOB, Over / Session controls</div><h1 id="title">Facilitator</h1></div><small id="connection">Connecting</small></header><main>
<section class="panel showcase"><div class="setup"><h2>Showcase session</h2>
<label>Scenario <select id="scenario"><option value="slice_texas">Slice &middot; Texas</option><option value="stage1_texas">Stage 1 &middot; Texas</option><option value="stage2_texas">Stage 2 &middot; Texas</option></select></label>
<label><input id="autoplan" type="checkbox" checked>Autoplan</label>
<label><input id="guided" type="checkbox">Guided</label>
<label>Guide <select id="guide-picker"><option value="slice_guided">Slice Â· guided playthrough</option></select></label>
<label>Replay <select id="script"><option value="slice_autoplan">Slice &middot; autoplan</option><option value="slice_play">Slice &middot; play</option><option value="slice_pull_play">Slice &middot; pull play</option><option value="stage1_pm_play">Stage 1 &middot; PM play</option><option value="stage2_pull_play">Stage 2 &middot; pull play</option></select></label>
<label>Script file <input id="script-file" type="file" accept=".json,application/json"></label>
<div class="controls"><a id="open-plan" target="_blank" href="plan.html">Open Plan tab</a><a id="open-site" target="_blank" href="site.html">Open Site tab</a><a id="open-rules" target="_blank" href="rules.html">Open Rules tab</a><a id="manual" target="_blank" href="manual/slice_texas.pdf">Field manual</a><a href="howto.html" target="_blank">How to play</a></div>
<label><input id="fast" type="checkbox">Fast pacing</label><small>Keep this host tab open for the session.</small></div>
<div class="room"><span>Phone room code</span><b id="room-code"></b><canvas id="room-qr" role="img" aria-label="Scan to open the Site seat"></canvas><a id="room-link">Open Site by room code</a><a id="rules-room-link">Open Rules by room code</a><div id="room-status" role="status">Connecting to room server</div></div></section>
<section class="panel"><div class="controls"><button id="start" class="primary" data-action="start">Start</button><button id="pause" data-action="pause">Pause</button><button id="resume" data-action="resume">Resume</button><button id="reset" data-action="reset">Reset</button><a id="download" href="#" download>Download transcript</a></div><div class="metrics"><div><span>Simulation t</span><b id="time">0.00</b></div><div><span>Display day</span><b id="day">1</b></div><div><span>Speed</span><b id="speed">paused</b></div></div><p id="autoplan-status">autoplan: off</p><p id="feedback" role="status"></p></section>
<div class="two"><section class="panel"><h2>Events</h2><table id="events"></table></section><section class="panel"><h2>Deviation states</h2><table id="deviations"></table></section></div>
<div class="two"><section class="panel"><details open><summary>Plan view JSON</summary><pre id="plan-view"></pre></details></section><section class="panel"><details open><summary>Site view JSON</summary><pre id="site-view"></pre></details></section></div><section class="panel"><h2>Result</h2><div id="result">â€”</div></section></main>
<script src="lib/transport.js"></script>
<script src="lib/guide.js"></script>
<script type="module">
'use strict';
const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let state,result,sequence=0,stage,lastDay=0;
const { createHost, roundedJSON } = await import('./src/host/core.js');
const { loadCatalogFromObject } = await import('./src/common/catalog.js');
const { loadScenarioFromObject } = await import('./src/scenario/load.js');
const { drawQR } = await import('./lib/qr.js');
async function json(path) { const response=await fetch(path);if(!response.ok)throw new Error(`${path}: ${response.status}`);return response.json(); }
const catalog=loadCatalogFromObject(await json('Data/catalog.json'));
const stages=await Promise.all(['slice_texas','stage1_texas','stage2_texas'].map(async id=>loadScenarioFromObject(await json(`Data/Scenarios/${id}.json`),catalog)));
const scripts=new Map(await Promise.all([...$('script').options].map(async option=>[option.value,await json(`Data/scripts/${option.value}.json`)])));
const guides=new Map(await Promise.all([...$('guide-picker').options].map(async option=>[option.value,await json(`Data/Guides/${option.value}.json`)])));
const core=createHost({scenario:stages[0],catalog,stages,autoplan:scripts.get('slice_autoplan'),allowFast:true});
const runId=crypto.randomUUID();localStorage.setItem('lob-over-run',runId);
for(const seat of ['plan','site','rules'])$('open-'+seat).href=`${seat}.html?run=${encodeURIComponent(runId)}`;
const alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
const roomCode=[...crypto.getRandomValues(new Uint8Array(6))].map(value=>alphabet[value%alphabet.length]).join('');
$('room-code').textContent=roomCode;
const roomURL=new URL('site.html',location.href);roomURL.searchParams.set('room',roomCode);
$('room-link').href=roomURL.href;drawQR($('room-qr'),roomURL.href);
const rulesRoomURL=new URL('rules.html',location.href);rulesRoomURL.searchParams.set('room',roomCode);$('rules-room-link').href=rulesRoomURL.href;
const transports=LobTransport.host(core,{runId,roomCode,
 onRoom:()=>{$('room-status').textContent='Room ready';$('room-status').dataset.ready='true';},
 onStatus:text=>{$('room-status').textContent=text;$('room-status').dataset.ready='false';}});
const socket=LobTransport.direct(core);
LobGuide.attach(socket,'facilitator');
globalThis.showcase={core,runId,roomCode};
addEventListener('pagehide',()=>{core.close();transports.close();if(localStorage.getItem('lob-over-run')===runId)localStorage.removeItem('lob-over-run');},{once:true});
socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'facilitator',client:'web'}));
socket.onclose=()=>{$('connection').textContent='Disconnected';};
function control(action){if(socket.readyState!==WebSocket.OPEN)return;$('feedback').textContent='';socket.send(JSON.stringify({t:'ctrl',v:1,id:'f-'+(++sequence),action,...(action==='load'?{stage:state.view.stage2}:{})}));}
for(const button of document.querySelectorAll('[data-action]'))button.onclick=()=>control(button.dataset.action);
function render(){
  const v=state.view;const ap=v.autoplan;$('autoplan-status').textContent=!ap?.enabled?'autoplan: off':ap.nextT===null?'autoplan: complete':`autoplan: next at t ${ap.nextT.toFixed(2)}`;$('title').textContent=v.project.title+' / Facilitator';$('time').textContent=state.day.toFixed(2);$('day').textContent=state.displayDay;$('speed').textContent=state.speed;
  $('plan-view').textContent=JSON.stringify(v.plan,null,2);$('site-view').textContent=JSON.stringify(v.site,null,2);
  $('events').innerHTML='<tr><th>Event</th><th>Trigger</th><th>State</th><th>Variant</th></tr>'+v.events.map(e=>`<tr><td>${esc(e.card.title)}</td><td>${esc(JSON.stringify(e.trigger))}</td><td>${e.resolved?'resolved':e.fired?'active':'upcoming'}</td><td>${esc(e.protection??'â€”')}</td></tr>`).join('');
  $('deviations').innerHTML='<tr><th>Deviation</th><th>State</th><th>Order</th></tr>'+v.deviations.map(d=>`<tr><td>${esc(d.id)}</td><td>${d.caught?'caught':d.triggered?'triggered':'pending'}</td><td>${esc(d.orderId??'â€”')}</td></tr>`).join('');
}
function acceptState(message){if(state?.runId!==message.runId){result=null;$('result').textContent='â€”';}state=message;stage=message.stage;lastDay=message.day;render();}
socket.onmessage=event=>{const message=JSON.parse(event.data);if(message.t==='welcome'){$('connection').textContent=message.mirror?'Mirror Â· read only':'Connected';acceptState(message.state);}else if(message.t==='state')acceptState(message);else if(message.t==='nack')$('feedback').textContent=message.reason;else if(message.t==='result'){result=message;$('result').textContent=Object.entries(message).filter(([k,v])=>typeof v==='number'&&!['v','day'].includes(k)).map(([k,v])=>`${k}: ${Number(v.toFixed(2))}`).join(' Â· ');}};
$('autoplan').onchange=()=>core.enableAutoplan($('autoplan').checked);
function chooseGuide(){
 const definition=guides.get($('guide-picker').value);
 if($('guided').checked&&definition.scenario!==$('scenario').value){$('guided').checked=false;$('feedback').textContent='Guide is for '+definition.scenario;}
 if($('guided').checked){$('autoplan').checked=false;core.enableAutoplan(false);}
 core.setGuide($('guided').checked?definition:null);$('fast').checked=false;
}
$('guided').onchange=chooseGuide;$('guide-picker').onchange=chooseGuide;
function chooseScript(){core.setAutoplan(scripts.get($('script').value),$('autoplan').checked);core.reset();$('fast').checked=false;}
$('script').onchange=chooseScript;
$('scenario').onchange=()=>{core.load($('scenario').value);$('script').value=({slice_texas:'slice_autoplan',stage1_texas:'stage1_pm_play',stage2_texas:'stage2_pull_play'})[$('scenario').value];chooseScript();chooseGuide();$('manual').href=`manual/${$('scenario').value}.pdf`;};
$('script-file').onchange=async()=>{
 const file=$('script-file').files[0];if(!file)return;
 try{const script=JSON.parse(await file.text());const {createAutoplan}=await import('./src/host/autoplan.js');createAutoplan(script);
 scripts.set('uploaded',script);let option=$('script').querySelector('[value="uploaded"]');if(!option){option=new Option('','uploaded');$('script').add(option);}option.textContent=file.name;$('script').value='uploaded';chooseScript();}
 catch(error){$('feedback').textContent=error.message;}
};
$('fast').onchange=()=>core.setFast($('fast').checked);
$('reset').addEventListener('click',()=>{$('fast').checked=false;});
$('download').onclick=()=>{const url=URL.createObjectURL(new Blob([roundedJSON(core.transcript)],{type:'application/json'}));$('download').href=url;$('download').download=core.transcript.scenario+'.json';setTimeout(()=>URL.revokeObjectURL(url),1000);};
</script></body></html>
/* WO-S1: protocol-compatible sockets; PeerJS 1.5.4 is vendored beside this file. */
(() => {
  let peerLibrary;
  function loadPeer() {
    if (globalThis.Peer) return Promise.resolve();
    return peerLibrary ??= new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = new URL('lib/peerjs.min.js', document.baseURI);
      script.onload = resolve;
      script.onerror = () => reject(new Error('PeerJS library unavailable'));
      document.head.append(script);
    });
  }
  class Socket extends EventTarget {
    readyState = 0;
    emit(type, data) {
      const event = type === 'message' ? new MessageEvent(type, { data: JSON.stringify(data) }) : new Event(type);
      this['on' + type]?.(event);
      this.dispatchEvent(event);
    }
    opened() { if (this.readyState === 0) { this.readyState = 1; this.emit('open'); } }
    send(raw) { if (this.readyState === 1) this.write(JSON.parse(raw)); }
    close() {
      if (this.readyState === 3) return;
      this.readyState = 3; this.dispose?.(); this.emit('close');
    }
  }
  const channelName = run => 'lob-over-' + run;
  const peerId = room => 'lob-over-' + room.toUpperCase();
  function local(run) {
    const socket = new Socket(), id = crypto.randomUUID(), channel = new BroadcastChannel(channelName(run));
    const post = (kind, message) => channel.postMessage({ to: 'host', id, kind, message });
    const retry = setInterval(() => post('connect'), 500);
    socket.write = message => post('message', message);
    socket.dispose = () => { clearInterval(retry); post('close'); channel.close(); };
    channel.onmessage = ({ data }) => {
      if (data.to !== id) return;
      if (data.kind === 'connected') { clearInterval(retry); socket.opened(); }
      if (data.kind === 'message') socket.emit('message', data.message);
      if (data.kind === 'close') socket.close();
    };
    queueMicrotask(() => post('connect'));
    addEventListener('pagehide', () => socket.close(), { once: true });
    return socket;
  }
  function room(code) {
    const socket = new Socket();
    loadPeer().then(() => {
      if (socket.readyState === 3) return;
      const peer = new Peer();
      socket.dispose = () => peer.destroy();
      peer.on('error', () => socket.close());
      peer.on('open', () => {
        const connection = peer.connect(peerId(code), { reliable: true });
        socket.write = message => connection.send(message);
        connection.on('open', () => socket.opened());
        connection.on('data', message => socket.emit('message', message));
        connection.on('close', () => socket.close());
        connection.on('error', () => socket.close());
      });
    }).catch(() => socket.close());
    addEventListener('pagehide', () => socket.close(), { once: true });
    return socket;
  }
  function connect() {
    const query = new URLSearchParams(location.search);
    if (query.has('ws')) {
      const endpoint = query.get('ws').replace(/^wss?:\/\//, '').replace(/\/ws\/?$/, '');
      return new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${endpoint}/ws`);
    }
    if (query.has('room')) return room(query.get('room'));
    const run = query.get('run') || localStorage.getItem('lob-over-run');
    if (run) return local(run);
    return new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws`);
  }
  function host(core, { runId, roomCode, onRoom, onStatus }) {
    const channel = new BroadcastChannel(channelName(runId)), connections = new Map();
    let peer, closed = false;
    channel.onmessage = ({ data }) => {
      if (data.to !== 'host') return;
      let connection = connections.get(data.id);
      if (data.kind === 'connect') {
        if (!connection) {
          connection = {
            send(message) { channel.postMessage({ to: data.id, kind: 'message', message }); },
            onMessage(callback) { this.receive = callback; },
            onClose(callback) { this.closed = callback; },
            close() {
              channel.postMessage({ to: data.id, kind: 'close' });
              this.closed(); connections.delete(data.id);
            },
          };
          connections.set(data.id, connection); core.attach(connection);
        }
        channel.postMessage({ to: data.id, kind: 'connected' });
      } else if (data.kind === 'message') connection?.receive(data.message);
      else if (data.kind === 'close') connection?.close();
    };
    loadPeer().then(() => {
      if (closed) return;
      peer = new Peer(peerId(roomCode));
      peer.on('open', () => onRoom(roomCode));
      peer.on('disconnected', () => onStatus('Room server disconnected'));
      peer.on('error', error => onStatus('Room unavailable: ' + error.type));
      peer.on('connection', connection => {
        // Install handlers before acknowledging the data-channel open.
        core.attach({
          send(message) { if (connection.open) connection.send(message); },
          onMessage(callback) { connection.on('data', callback); },
          onClose(callback) { connection.on('close', callback); },
          close() { connection.close(); },
        });
        connection.on('error', () => connection.close());
      });
    }).catch(error => onStatus(error.message));
    return { close() {
      closed = true;
      for (const connection of connections.values()) connection.close();
      channel.close(); peer?.destroy();
    } };
  }
  // The facilitator has the same message interface even though it owns the core.
  function direct(core) {
    const socket = new Socket();
    core.attach({
      send(message) { socket.emit('message', message); },
      onMessage(callback) { socket.write = callback; },
      onClose(callback) { socket.dispose = callback; },
      close() { socket.close(); },
    });
    setTimeout(() => socket.opened(), 0);
    return socket;
  }
  globalThis.LobTransport = { connect, host, direct };
})();

