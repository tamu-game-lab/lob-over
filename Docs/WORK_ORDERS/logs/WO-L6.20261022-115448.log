  pending.clear();switching.clear();for(const timer of tapeTimers.values())clearTimeout(timer);tapeTimers.clear();
  for(const frame of typing.values())cancelAnimationFrame(frame);typing.clear();
  clearTimeout(worriedTimer);cancelAnimationFrame(countFrame);worried=false;audio.reset();
  $('result').hidden=true;$('feedback').textContent='';$('reports').innerHTML='<li class="report-empty">Awaiting the first daily report.</li>';
}
function acceptState(message){
  const newRun=state?.runId!==message.runId,wasSlow=state?.speed==='slow';
  if(newRun)resetPresentation();
  state=message;if(newRun)makeCrews();
  if(state.speed!=='paused'){starting=false;hasStarted=true;}
  if(state.speed==='slow'&&!wasSlow){
    worried=true;portrait();audio.sound('hiss');clearTimeout(worriedTimer);
    worriedTimer=setTimeout(()=>{worried=false;portrait();},WORRIED_MS);
  }
  render();
}
function report(message){
  if(message.day<=lastReportDay)return;
  const pieces=[`Day ${message.day}`,...CREWS.map(id=>`${REPORT_NAMES[id]} +${number(message.feetByCrew[id]-(lastTotals[id]??0))} ft (${number(message.feetByCrew[id])})`)];
  lastTotals={...message.feetByCrew};lastReportDay=message.day;
  $('reports').querySelector('.report-empty')?.remove();$('reports').querySelector('.report-new')?.classList.remove('report-new');
  const item=document.createElement('li');item.className='report report-new';item.dataset.day=message.day;
  pieces.forEach((text,i)=>{const span=document.createElement('span');span.className=i?'report-crew':'report-day';if(i)span.style.setProperty('--crew',COLORS[CREWS[i-1]]);item.append(span);if(i<pieces.length-1){const separator=document.createElement('span');separator.className='report-separator';separator.textContent=' · ';item.append(separator);}});
  $('reports').append(item);
  while($('reports').children.length>REPORT_LIMIT){const oldest=$('reports').firstElementChild;cancelAnimationFrame(typing.get(oldest));typing.delete(oldest);oldest.remove();}
  const spans=[...item.querySelectorAll('.report-day,.report-crew')],total=pieces.join('').length,start=performance.now();let lastClick=-1;
  function type(now){
    let remaining=Math.floor(Math.min(1,(now-start)/TYPE_MS)*total);
    spans.forEach((span,i)=>{span.textContent=pieces[i].slice(0,Math.max(0,remaining));remaining-=pieces[i].length;});
    const click=Math.floor((now-start)/75);if(click!==lastClick){audio.sound('teletype');lastClick=click;}
    if(now-start<TYPE_MS)typing.set(item,requestAnimationFrame(type));else typing.delete(item);
  }
  typing.set(item,requestAnimationFrame(type));
}
function showResult(message){
  result=message;starting=false;$('result').hidden=false;
  $('finish').textContent=Number.isFinite(result.finishDay)?`Finished Day ${Math.floor(result.finishDay+1e-6)+1} · Promised Day ${result.promisedDay}`:`Run ended · Promised Day ${result.promisedDay}`;
  $('idle').innerHTML=state.view.crews.map(c=>`<div class="idle-crew" style="--crew:${COLORS[c.id]}">${esc(c.name)}<strong class="idle-count" id="idle-${c.id}">0</strong></div>`).join('');
  cancelAnimationFrame(countFrame);const start=performance.now();
  function count(now){const progress=Math.min(1,(now-start)/COUNT_MS);for(const id of CREWS)$('idle-'+id).textContent=Number((result.idleDays[id]*progress).toFixed(2));if(progress<1)countFrame=requestAnimationFrame(count);}
  countFrame=requestAnimationFrame(count);render();
}
socket.onmessage=event=>{
  const message=JSON.parse(event.data);
  if(message.t==='welcome'){mirror=message.mirror;acceptState(message.state);}
  else if(message.t==='state')acceptState(message);
  else if(message.t==='ack'||message.t==='nack'){
    const request=pending.get(message.id);pending.delete(message.id);
    if(request?.crew)switching.delete(request.crew);
    if(message.t==='nack'){
      starting=false;
      if(request?.crew){const tape=$('refusal-'+request.crew);tape.textContent=message.reason;tape.hidden=false;clearTimeout(tapeTimers.get(request.crew));tapeTimers.set(request.crew,setTimeout(()=>{tape.hidden=true;},TAPE_MS));}
      else $('feedback').textContent=message.reason;
      render();
    }else request?.onAck?.();
  }else if(message.t==='voice')audio.play(message,state.stage);
  else if(message.t==='report')report(message);
  else if(message.t==='result')showResult(message);
};
</script></body></html>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOB, Over - Showcase host</title><style>
:root{font:14px/1.45 system-ui,sans-serif;color:#283942;background:#eeeae2}*{box-sizing:border-box}body{margin:0}header{background:#303c48;color:white;padding:18px 26px;display:flex;justify-content:space-between;align-items:center}h1{font-size:21px;margin:0}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase}main{padding:18px 24px;max-width:1600px;margin:auto}.panel{padding:16px;background:#fffdf8;border:1px solid #c7cec9;margin-bottom:16px}h2{font-size:15px;margin:0 0 10px}.controls{display:flex;flex-wrap:wrap;gap:9px}button,a{font:inherit;padding:9px 13px;border:1px solid #8b999f;border-radius:3px;background:#fffdf8;color:inherit;cursor:pointer;text-decoration:none}button:hover,a:hover{background:#e7edf0}.primary{background:#2b4758;color:white}.metrics{display:flex;gap:35px;margin-top:18px}.metrics b{display:block;font:600 24px ui-monospace,monospace}.metrics span{font-size:12px}.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}pre{font:12px/1.5 ui-monospace,monospace;white-space:pre-wrap;overflow:auto;max-height:340px;padding:12px;background:#f0f1ec}summary{font-weight:600;cursor:pointer}table{width:100%;border-collapse:collapse;font-size:13px}td,th{text-align:left;border-bottom:1px solid #d4dcd8;padding:8px}#feedback{min-height:20px}#result{white-space:pre-wrap}@media(max-width:750px){.two{grid-template-columns:1fr}main{padding:12px}}
select,input{font:inherit;padding:8px;max-width:100%}label{display:flex;align-items:center;gap:8px}.showcase{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:24px}.setup{display:flex;flex-direction:column;gap:14px}.room{text-align:center}.room b{display:block;font:600 40px ui-monospace,monospace;letter-spacing:.12em}.room canvas{width:196px;height:196px;max-width:100%}.room a{display:block;padding:3px;border:0;font-size:12px;overflow-wrap:anywhere}#room-status{font-size:12px}#script-file{width:260px}.metrics{flex-wrap:wrap;gap:24px}@media(max-width:650px){.showcase{grid-template-columns:1fr}.room{border-top:1px solid #c7cec9;padding-top:14px}}
</style></head><body><header><div><div class="eyebrow">LOB, Over / Session controls</div><h1 id="title">Facilitator</h1></div><small id="connection">Connecting</small></header><main>
<section class="panel showcase"><div class="setup"><h2>Showcase session</h2>
<label>Scenario <select id="scenario"><option value="slice_texas">Slice &middot; Texas</option><option value="stage1_texas">Stage 1 &middot; Texas</option><option value="stage2_texas">Stage 2 &middot; Texas</option></select></label>
<label><input id="autoplan" type="checkbox" checked>Autoplan</label>
<label><input id="guided" type="checkbox">Guided</label>
<label>Guide <select id="guide-picker"><option value="slice_guided">Slice · guided playthrough</option></select></label>
<label>Replay <select id="script"><option value="slice_autoplan">Slice &middot; autoplan</option><option value="slice_play">Slice &middot; play</option><option value="slice_pull_play">Slice &middot; pull play</option><option value="stage1_pm_play">Stage 1 &middot; PM play</option><option value="stage2_pull_play">Stage 2 &middot; pull play</option></select></label>
<label>Script file <input id="script-file" type="file" accept=".json,application/json"></label>
<div class="controls"><a id="open-plan" target="_blank" href="plan.html">Open Plan tab</a><a id="open-site" target="_blank" href="site.html">Open Site tab</a><a id="open-rules" target="_blank" href="rules.html">Open Rules tab</a><a id="manual" target="_blank" href="manual/slice_texas.pdf">Field manual</a><a href="howto.html" target="_blank">How to play</a></div>
<label><input id="fast" type="checkbox">Fast pacing</label><small>Keep this host tab open for the session.</small></div>
<div class="room"><span>Phone room code</span><b id="room-code"></b><canvas id="room-qr" role="img" aria-label="Scan to open the Site seat"></canvas><a id="room-link">Open Site by room code</a><a id="rules-room-link">Open Rules by room code</a><div id="room-status" role="status">Connecting to room server</div></div></section>
<section class="panel"><div class="controls"><button id="start" class="primary" data-action="start">Start</button><button id="pause" data-action="pause">Pause</button><button id="resume" data-action="resume">Resume</button><button id="reset" data-action="reset">Reset</button><a id="download" href="#" download>Download transcript</a></div><div class="metrics"><div><span>Simulation t</span><b id="time">0.00</b></div><div><span>Display day</span><b id="day">1</b></div><div><span>Speed</span><b id="speed">paused</b></div></div><p id="autoplan-status">autoplan: off</p><p id="feedback" role="status"></p></section>
<div class="two"><section class="panel"><h2>Events</h2><table id="events"></table></section><section class="panel"><h2>Deviation states</h2><table id="deviations"></table></section></div>
<div class="two"><section class="panel"><details open><summary>Plan view JSON</summary><pre id="plan-view"></pre></details></section><section class="panel"><details open><summary>Site view JSON</summary><pre id="site-view"></pre></details></section></div><section class="panel"><h2>Result</h2><div id="result">—</div></section></main>
<script src="lib/transport.js"></script>
<script src="lib/guide.js"></script>
<script type="module">
'use strict';
const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let state,result,sequence=0,stage,lastDay=0;
const { createHost, roundedJSON } = await import('./src/host/core.js');
const { loadCatalogFromObject } = await import('./src/common/catalog.js');
const { loadScenarioFromObject } = await import('./src/scenario/load.js');
const { drawQR } = await import('./lib/qr.js');
async function json(path) { const response=await fetch(path);if(!response.ok)throw new Error(`${path}: ${response.status}`);return response.json(); }
const catalog=loadCatalogFromObject(await json('Data/catalog.json'));
const stages=await Promise.all(['slice_texas','stage1_texas','stage2_texas'].map(async id=>loadScenarioFromObject(await json(`Data/Scenarios/${id}.json`),catalog)));
const scripts=new Map(await Promise.all([...$('script').options].map(async option=>[option.value,await json(`Data/scripts/${option.value}.json`)])));
const guides=new Map(await Promise.all([...$('guide-picker').options].map(async option=>[option.value,await json(`Data/Guides/${option.value}.json`)])));
const core=createHost({scenario:stages[0],catalog,stages,autoplan:scripts.get('slice_autoplan'),allowFast:true});
const runId=crypto.randomUUID();localStorage.setItem('lob-over-run',runId);
for(const seat of ['plan','site','rules'])$('open-'+seat).href=`${seat}.html?run=${encodeURIComponent(runId)}`;
const alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
const roomCode=[...crypto.getRandomValues(new Uint8Array(6))].map(value=>alphabet[value%alphabet.length]).join('');
$('room-code').textContent=roomCode;
const roomURL=new URL('site.html',location.href);roomURL.searchParams.set('room',roomCode);
$('room-link').href=roomURL.href;drawQR($('room-qr'),roomURL.href);
const rulesRoomURL=new URL('rules.html',location.href);rulesRoomURL.searchParams.set('room',roomCode);$('rules-room-link').href=rulesRoomURL.href;
const transports=LobTransport.host(core,{runId,roomCode,
 onRoom:()=>{$('room-status').textContent='Room ready';$('room-status').dataset.ready='true';},
 onStatus:text=>{$('room-status').textContent=text;$('room-status').dataset.ready='false';}});
const socket=LobTransport.direct(core);
LobGuide.attach(socket,'facilitator');
globalThis.showcase={core,runId,roomCode};
addEventListener('pagehide',()=>{core.close();transports.close();if(localStorage.getItem('lob-over-run')===runId)localStorage.removeItem('lob-over-run');},{once:true});
socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'facilitator',client:'web'}));
socket.onclose=()=>{$('connection').textContent='Disconnected';};
function control(action){if(socket.readyState!==WebSocket.OPEN)return;$('feedback').textContent='';socket.send(JSON.stringify({t:'ctrl',v:1,id:'f-'+(++sequence),action,...(action==='load'?{stage:state.view.stage2}:{})}));}
for(const button of document.querySelectorAll('[data-action]'))button.onclick=()=>control(button.dataset.action);
function render(){
  const v=state.view;const ap=v.autoplan;$('autoplan-status').textContent=!ap?.enabled?'autoplan: off':ap.nextT===null?'autoplan: complete':`autoplan: next at t ${ap.nextT.toFixed(2)}`;$('title').textContent=v.project.title+' / Facilitator';$('time').textContent=state.day.toFixed(2);$('day').textContent=state.displayDay;$('speed').textContent=state.speed;
  $('plan-view').textContent=JSON.stringify(v.plan,null,2);$('site-view').textContent=JSON.stringify(v.site,null,2);
  $('events').innerHTML='<tr><th>Event</th><th>Trigger</th><th>State</th><th>Variant</th></tr>'+v.events.map(e=>`<tr><td>${esc(e.card.title)}</td><td>${esc(JSON.stringify(e.trigger))}</td><td>${e.resolved?'resolved':e.fired?'active':'upcoming'}</td><td>${esc(e.protection??'—')}</td></tr>`).join('');
  $('deviations').innerHTML='<tr><th>Deviation</th><th>State</th><th>Order</th></tr>'+v.deviations.map(d=>`<tr><td>${esc(d.id)}</td><td>${d.caught?'caught':d.triggered?'triggered':'pending'}</td><td>${esc(d.orderId??'—')}</td></tr>`).join('');
}
function acceptState(message){if(state?.runId!==message.runId){result=null;$('result').textContent='—';}state=message;stage=message.stage;lastDay=message.day;render();}
socket.onmessage=event=>{const message=JSON.parse(event.data);if(message.t==='welcome'){$('connection').textContent=message.mirror?'Mirror · read only':'Connected';acceptState(message.state);}else if(message.t==='state')acceptState(message);else if(message.t==='nack')$('feedback').textContent=message.reason;else if(message.t==='result'){result=message;$('result').textContent=Object.entries(message).filter(([k,v])=>typeof v==='number'&&!['v','day'].includes(k)).map(([k,v])=>`${k}: ${Number(v.toFixed(2))}`).join(' · ');}};
$('autoplan').onchange=()=>core.enableAutoplan($('autoplan').checked);
function chooseGuide(){
 const definition=guides.get($('guide-picker').value);
 if($('guided').checked&&definition.scenario!==$('scenario').value){$('guided').checked=false;$('feedback').textContent='Guide is for '+definition.scenario;}
 if($('guided').checked){$('autoplan').checked=false;core.enableAutoplan(false);}
 core.setGuide($('guided').checked?definition:null);$('fast').checked=false;
}
$('guided').onchange=chooseGuide;$('guide-picker').onchange=chooseGuide;
function chooseScript(){core.setAutoplan(scripts.get($('script').value),$('autoplan').checked);core.reset();$('fast').checked=false;}
$('script').onchange=chooseScript;
$('scenario').onchange=()=>{core.load($('scenario').value);$('script').value=({slice_texas:'slice_autoplan',stage1_texas:'stage1_pm_play',stage2_texas:'stage2_pull_play'})[$('scenario').value];chooseScript();chooseGuide();$('manual').href=`manual/${$('scenario').value}.pdf`;};
$('script-file').onchange=async()=>{
 const file=$('script-file').files[0];if(!file)return;
 try{const script=JSON.parse(await file.text());const {createAutoplan}=await import('./src/host/autoplan.js');createAutoplan(script);
 scripts.set('uploaded',script);let option=$('script').querySelector('[value="uploaded"]');if(!option){option=new Option('','uploaded');$('script').add(option);}option.textContent=file.name;$('script').value='uploaded';chooseScript();}
 catch(error){$('feedback').textContent=error.message;}
};
$('fast').onchange=()=>core.setFast($('fast').checked);
$('reset').addEventListener('click',()=>{$('fast').checked=false;});
$('download').onclick=()=>{const url=URL.createObjectURL(new Blob([roundedJSON(core.transcript)],{type:'application/json'}));$('download').href=url;$('download').download=core.transcript.scenario+'.json';setTimeout(()=>URL.revokeObjectURL(url),1000);};
</script></body></html>

