+connect().catch(error=>{connected=false;$('feedback').textContent='Game unavailable: '+error.message;$('start').disabled=true;});
 </script></body></html>
diff --git a/Play LOB Over.command b/Play LOB Over.command
new file mode 100644
index 0000000000000000000000000000000000000000..21239a28cc24a989a3c57e60b1affb3a319dae7b
--- /dev/null
+++ b/Play LOB Over.command
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+cd -- "$(dirname -- "${BASH_SOURCE[0]}")" || exit 1
+
+if ! command -v node >/dev/null 2>&1; then
+  export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
+fi
+if ! command -v node >/dev/null 2>&1 || ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)'; then
+  echo "Install Node.js 20 or newer from https://nodejs.org"
+  read -r -n 1 -p "Press any key to close. "
+  echo
+  exit 1
+fi
+
+if [[ ! -d Monitor/node_modules ]]; then
+  (cd Monitor && npm ci) || { echo "Dependencies could not be installed."; exit 1; }
+fi
+
+# WO-L6: USB is optional; a missing or disconnected device cannot block Wi-Fi.
+adb_path=$(command -v adb 2>/dev/null || true)
+if [[ -z "$adb_path" && -x "$HOME/Library/Android/sdk/platform-tools/adb" ]]; then
+  adb_path="$HOME/Library/Android/sdk/platform-tools/adb"
+fi
+if [[ -n "$adb_path" ]]; then
+  while read -r serial status rest; do
+    if [[ "${status%$'\r'}" == device ]]; then
+      "$adb_path" -s "$serial" reverse tcp:7331 tcp:7331 >/dev/null 2>&1 || true
+    fi
+  done < <("$adb_path" devices 2>/dev/null)
+fi
+
+node Monitor/src/host/server.js Data/Scenarios/level1_texas.json --discovery &
+host_pid=$!
+cleanup() {
+  kill "$host_pid" 2>/dev/null || true
+  wait "$host_pid" 2>/dev/null || true
+}
+trap cleanup EXIT
+trap 'exit 130' INT
+trap 'exit 143' TERM
+
+# Poll the actual listener before opening the page, without requiring curl.
+if ! node --input-type=module -e '
+  import net from "node:net";
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const ready = await new Promise(resolve => {
+      const socket = net.connect(7331, "127.0.0.1");
+      socket.setTimeout(200);
+      const finish = ok => { socket.destroy(); resolve(ok); };
+      socket.once("connect", () => finish(true));
+      socket.once("error", () => finish(false));
+      socket.once("timeout", () => finish(false));
+    });
+    if (ready) process.exit(0);
+    await new Promise(resolve => setTimeout(resolve, 200));
+  }
+  process.exit(1);
+' || ! kill -0 "$host_pid" 2>/dev/null; then
+  echo "The game host did not start on port 7331."
+  exit 1
+fi
+
+url=http://localhost:7331/play.html
+case "$OSTYPE" in
+  darwin*) open "$url" ;;
+  msys*|cygwin*) start "" "$url" ;;
+  *) xdg-open "$url" ;;
+esac
+echo "Press Ctrl-C to end the game"
+wait "$host_pid"
diff --git a/README.md b/README.md
index 3e8f58a157fa2f26e1f962fd644c6f4633b3843e..d4a309bba993ad0f47b363a9ff904e67cc2803a5
--- a/README.md
+++ b/README.md
@@ -6,6 +6,16 @@
 
 This folder is everything the orchestrator (Claude Code, Fable 5.1) and the implementer (Codex, Astra) need to start. Its contents go into the root of the new Unity project, beside `Assets/`. Setup is `Docs/SETUP_CHECKLIST.md`; the launch is section D there.
 
+## Presenting from a Mac
+
+1. Install Node.js 20 or newer from https://nodejs.org, then clone with git: `git clone https://github.com/tamu-game-lab/lob-over.git`. A downloaded zip carries Gatekeeper's quarantine. If the launcher will not open, right-click > Open, or run `bash "Play LOB Over.command"` in Terminal from the repository folder.
+2. Double-click `Play LOB Over.command`. It installs dependencies on the first run, starts Level 1 and opens the Plan page. Allow node through the macOS firewall prompt. Leave Terminal open; press Ctrl-C there to end the game.
+3. Put the Mac and headset on the same network. When the venue's Wi-Fi blocks discovery, use a phone hotspot or the USB cable. For the cable, install adb with `brew install android-platform-tools`, connect the headset and allow USB debugging, then run the launcher.
+
+For a phone or second laptop as Site, open [Level 1, no headset](https://tamu-game-lab.github.io/lob-over/play.html?host=browser), share the Site room code or QR, and press Start. Keep the Plan tab open. The headset joins only a game started with Play LOB Over on a PC or Mac.
+
+To build the complete showcase locally, run `node Showcase/build.mjs`. The publishing script uses this build too.
+
 ## What is where
 
 | Path | What | Who writes it |
diff --git a/Showcase/build.mjs b/Showcase/build.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..560817c25a603b2d273b7a7c6ca5cb9fd022d567
--- /dev/null
+++ b/Showcase/build.mjs
@@ -0,0 +1,22 @@
+import { cp, mkdir } from 'node:fs/promises';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { resolve } from 'node:path';
+import { build as buildShowcase, dist } from '../Monitor/src/showcase/build.js';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+
+// WO-L6 adds Level 1 to the existing stages without changing their build inputs.
+export async function build() {
+  await buildShowcase();
+  for (const name of ['play.html', 'img']) {
+    await cp(resolve(root, 'Monitor/web', name), resolve(dist, name), { recursive: true });
+  }
+  await mkdir(resolve(dist, 'level1'), { recursive: true });
+  for (const name of ['rules.pdf', 'rules.html']) {
+    await cp(resolve(root, 'Paper/out/level1', name), resolve(dist, 'level1', name));
+  }
+  await cp(resolve(root, 'Voice/level1_texas'), resolve(dist, 'Voice/level1_texas'), { recursive: true });
+  console.log('Level 1 included: play.html, img/, rules and Voice/level1_texas/');
+}
+
+if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) await build();
