// WO-02 crew order, precision, haul-road speed, proximity and mood conventions.
export const CREW_IDS = ['exc', 'pipe', 'back'];
export const LEADER = { pipe: 'exc', back: 'pipe' };
export const DT = 0.01;
export const EPS = 1e-6;
export const NEAR_FT = 100;
export const HAUL_FT_PER_HOUR = 1500;
export const HOURS_PER_DAY = 24;
export const MAX_MOOD = 3;
export const MOODS = ['calm', 'grumbling', 'angry', 'furious'];
// WO-02: conflicts look one day ahead; P1 durations round to half days.
export const CONFLICT_LOOKAHEAD_DAYS = 1;
export const CLEARING_DAY_STEP = 0.5;
export const travelDays = (a, b) => Math.abs(a - b) / HAUL_FT_PER_HOUR / HOURS_PER_DAY;
export const displayDay = t => Math.floor(t + EPS) + 1;
export const nextBoundary = t => Math.floor(t + EPS) + 1;
export const copy = value => JSON.parse(JSON.stringify(value));
export const zoneAt = (s, ft) => s.scenario.job.zones.find(z => ft >= z.fromFt
  && (ft < z.toFt || ft === s.scenario.job.lengthFt));
export const nearby = (s, ft) => s.truck.dismounted && !s.truck.moving
  && Math.abs(s.truck.stationFt - ft) <= NEAR_FT;
export const crewAt = s => CREW_IDS.map(id => s.crews[id])
  .filter(c => Math.abs(c.pos - s.truck.stationFt) <= NEAR_FT)
  .sort((a, b) => Math.abs(a.pos - s.truck.stationFt) - Math.abs(b.pos - s.truck.stationFt))[0];
export const protectionAt = (s, ft) => Number.isFinite(ft)
  ? s.protections.find(p => ft >= p.fromFt && ft <= p.toFt) : undefined;
export const activeCollapse = s => s.events.find(e => e.type === 'P1' && e.fired && !e.resolved);
export const emit = (s, type, fields) => s.messages.push({ t: type, v: 1, day: s.t, ...fields });

export function voice(s, trigger, seats, crewIds) {
  const lines = s.scenario.lines.filter(line => line.trigger === trigger
    && (!crewIds || crewIds.includes(line.speaker.replace('foreman_', ''))));
  if (!lines.length) return;
  emit(s, 'voice', { lineIds: lines.map(line => line.id), seats });
  s.pmLines.push(...lines.filter(line => line.speaker === 'pm').map(line => line.text));
}

// Reducers own this draft; source state and caller-owned scenario/catalog stay untouched.
// Histories are append-only, so copying their outer arrays avoids repeatedly cloning points.
export function draftState(s) {
  const { scenario, catalog, actualLines, plannedLines, inbox, changeLog, messages, ...dynamic } = s;
  return {
    ...structuredClone(dynamic), scenario, catalog,
    actualLines: Object.fromEntries(CREW_IDS.map(id => [id, [...actualLines[id]]])),
    plannedLines: copy(plannedLines), inbox: [...inbox], changeLog: [...changeLog], messages: [...messages],
  };
}
import { CREW_IDS, EPS } from './common.js';

// Projections use issued instructions and catalog rates, never live field positions.
export function plannedRate(line, t) {
  if (t < line.startDay - 1) return 0;
  if (line.holds.some(h => t >= h.fromT && (h.untilT == null || t < h.untilT))) return 0;
  const segment = [...line.segments].sort((a, b) => a.fromT - b.fromT).findLast(segment => segment.fromT <= t);
  const extra = (line.loans ?? []).filter(loan => t >= loan.fromT && t < loan.untilT)
    .reduce((sum, loan) => sum + loan.rate, 0);
  return (segment?.rate ?? line.rate) + extra;
}

export function plannedPolylines(s) {
  return Object.fromEntries(CREW_IDS.map(id => {
    const line = s.plannedLines[id];
    const breaks = [...new Set([line.startDay - 1, ...line.segments.map(segment => segment.fromT),
      ...line.holds.flatMap(h => h.untilT == null ? [h.fromT] : [h.fromT, h.untilT]),
      ...(line.loans ?? []).flatMap(loan => [loan.fromT, loan.untilT])])]
      .filter(t => t >= line.startDay - 1).sort((a, b) => a - b);
    let t = line.startDay - 1, ft = 0;
    const points = [{ t, ft }];
    for (const next of breaks.slice(1)) {
      const rate = plannedRate(line, t);
      if (rate > 0 && ft + (next - t) * rate >= s.scenario.job.lengthFt) {
        points.push({ t: t + (s.scenario.job.lengthFt - ft) / rate, ft: s.scenario.job.lengthFt });
        return [id, points];
      }
      ft += (next - t) * rate; t = next; points.push({ t, ft });
    }
    const rate = plannedRate(line, t + EPS);
    if (rate > 0) points.push({ t: t + (s.scenario.job.lengthFt - ft) / rate, ft: s.scenario.job.lengthFt });
    else if (s.t > t) points.push({ t: s.t, ft });
    return [id, points];
  }));
}

export function projectOrder(s, order) {
  const op = order.op, line = s.plannedLines[order.crew];
  if (op.op === 'hold' || op.op === 'demob') {
    const fromT = Math.max(order.landsT, op.fromDay != null ? op.fromDay - 1 : order.landsT);
    line.holds.push({ fromT, untilT: op.days == null ? null : fromT + op.days, kind: op.op });
  }
  if (op.op === 'resume' || op.op === 'remob') {
    const untilT = order.landsT + (op.op === 'remob' ? s.catalog.cities[s.scenario.city].remobilizationDelayDays : 0);
    for (const hold of line.holds) {
      if ((op.op === 'resume' ? hold.kind === 'hold' : hold.kind === 'demob')
        && (hold.untilT == null || hold.untilT > untilT)) hold.untilT = Math.max(hold.fromT, untilT);
    }
  }
  if (op.op === 'order') {
    const machine = s.catalog.machines[op.machine];
    line.segments.push({ fromT: order.issuedT + machine.leadDays.normal + s.catalog.cities[s.scenario.city].leadDelayDays,
      rate: machine.rateFtPerDay });
  }
  if (op.op === 'lend') {
    const fromT = order.landsT, untilT = fromT + op.days;
    line.holds.push({ fromT, untilT, kind: 'lend' });
    if (!s.events.some(e => e.type === 'P1' && e.fired && !e.resolved && order.crew === 'exc' && op.toCrew === 'pipe')) {
      const recipient = s.plannedLines[op.toCrew];
      recipient.loans ??= [];
      recipient.loans.push({ fromT, untilT, rate: s.catalog.machines[op.machine].rateFtPerDay });
    }
  }
}
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { loadCatalog } from '../common/catalog.js';
import { CREW_IDS } from './common.js';
import { createSim } from './sim.js';

// Data/goldens/no_events.json _doc: finish/idle 0.1 day, cost $500, peak 10 ft.
const TOLERANCE = { days: 0.1, cost: 500, feet: 10 };
export function runGoldens(goldens, catalog) {
  return Object.entries(goldens.cases).map(([name, entry]) => {
    const scenario = {
      id: name, seed: 0, capFt: entry.input.capFt,
      job: { lengthFt: goldens.lengthFt, stationEveryFt: 100, zones: [{ id: 1, fromFt: 0, toFt: goldens.lengthFt }] },
      crews: CREW_IDS.map(id => ({ id, name: id, machine: entry.input.machines[id], startDay: entry.input.startDay[id] })),
      plan: {}, permits: { cards: [] }, inspections: { required: false, cards: [] },
      rules: { overheadRate: catalog.money.overheadRate }, events: [], deviations: [], inbox: [], lines: [],
    };
    const sim = createSim(scenario, catalog, { pure: true });
    // The oracle uses a 300-day guard; this is a harness limit, not a game rule.
    while (!sim.done && sim.t < 300) sim.tick(goldens.dt);
    const actual = sim.result, expected = entry.expected;
    const deltas = actual ? { finishDay: actual.finishDay - expected.finishDay,
      idleDays: Object.fromEntries(CREW_IDS.map(id => [id, actual.idleDays[id] - expected.idleDays[id]])),
      crewCostUsd: actual.crewCostUsd - expected.crewCostUsd, peakOpenTrenchFt: actual.peakOpenTrenchFt - expected.peakOpenTrenchFt } : null;
    const pass = !!deltas && Math.abs(deltas.finishDay) <= TOLERANCE.days
      && CREW_IDS.every(id => Math.abs(deltas.idleDays[id]) <= TOLERANCE.days)
      && Math.abs(deltas.crewCostUsd) <= TOLERANCE.cost && Math.abs(deltas.peakOpenTrenchFt) <= TOLERANCE.feet;
    return { name, pass, deltas };
  });
}

if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
  try {
    const results = runGoldens(JSON.parse(readFileSync(process.argv[2], 'utf8')), loadCatalog());
    for (const { name, pass, deltas } of results) console.log(`${pass ? 'PASS' : 'FAIL'} ${name} deltas=${JSON.stringify(deltas,
      (key, value) => typeof value === 'number' ? Number(value.toFixed(3)) : value)}`);
    process.exitCode = results.every(result => result.pass) ? 0 : 1;
  } catch (error) { console.error(error.message); process.exitCode = 1; }
}
