    if (order.status !== 'sent' || s.t < order.landsT - EPS) continue;
    order.status = 'landed';
    order.landedT = s.t;
    voice(s, 'orderLanded', ['plan']);
    if (!order.ignored && !order.alreadyApplied) applyLanded(s, order);
