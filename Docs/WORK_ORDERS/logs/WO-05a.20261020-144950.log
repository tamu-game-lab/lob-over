import { EPS, nearby, nextBoundary, protectionAt } from './common.js';

export function markFirstRadio(s, order) {
  const d = s.deviations.find(d => d.type === 'F1' && !d.triggered
    && d.when.ops.includes(order.op.op) && order.landsT > order.issuedT);
  if (d) {
    d.triggered = true;
    d.orderId = order.id;
    order.ignored = true;
  }
}

export function confirmDeviation(s, order, outcome) {
  const d = s.deviations.find(d => d.type === 'F1' && d.orderId === order.id);
  if (d && outcome === 'notDone' && s.t < nextBoundary(order.landedT) - EPS) d.caught = true;
}

export function boundaryAllowance(s, zone) {
  const d = s.deviations.find(d => d.type === 'F2');
  if (!d) return zone.fromFt;
  if (d.triggered) return d.zone === zone.id && !d.caught ? zone.fromFt + d.overshootFt : zone.fromFt;
  d.triggered = true;
  d.zone = zone.id;
  d.caught = nearby(s, zone.fromFt) || !!s.crews.exc.hold || !!s.crews.exc.stop;
  if (!d.caught) {
    s.finesUsd += s.scenario.rules.permitFineUsd;
    s.spentUsd += s.scenario.rules.permitFineUsd;
  }
  return d.caught ? zone.fromFt : zone.fromFt + d.overshootFt;
}

export function inspectProtection(s, stationFt) {
  const p = protectionAt(s, stationFt);
  if (!p) return;
  for (const d of s.deviations.filter(d => d.type === 'F3')) {
    const e = s.events.find(e => e.id === d.when.eventId);
    if (!e?.fired && !(e.stationFt >= p.fromFt && e.stationFt <= p.toFt)) d.inspected = true;
  }
}

export function eventDeviations(s, event) {
  for (const d of s.deviations.filter(d => d.type === 'F3' && d.when.eventId === event.id)) {
    const missedStretch = s.protections.some(p => event.stationFt < p.fromFt || event.stationFt > p.toFt);
    if (missedStretch && !protectionAt(s, event.stationFt)) {
      d.triggered = true;
      d.caught = !!d.inspected;
    }
  }
}

// WO-02 reserves F5's firstLend hook but specifies no delay behaviour in these stages.
export function firstLend(s) {
  for (const d of s.deviations.filter(d => d.type === 'F5' && !d.triggered)) d.triggered = true;
}
import { EPS } from './common.js';
import { boundaryAllowance } from './deviations.js';

export function validatePermit(s, op) {
  const card = s.scenario.permits.cards.find(card => card.zone === op.zone);
  if (!card || card.code !== op.code) return 'code not on file';
  if (!s.permits[op.zone].entered && Object.values(s.permits).filter(p => p.entered && !p.signed).length
      >= s.scenario.permits.openZoneLimit) return `city limit: ${s.scenario.permits.openZoneLimit} zones open`;
}

export function validateInspection(s, op) {
  const card = s.scenario.inspections.cards.find(card => card.zone === op.zone);
  if (!card || card.number !== op.number) return 'code not on file';
}

export function excavationLimit(s, desired) {
  const zone = s.scenario.job.zones.find(z => !s.permits[z.id].entered);
  if (!zone) return s.scenario.job.lengthFt;
  let limit = zone.fromFt;
  if (desired >= limit - EPS && s.crews.exc.pos >= limit - EPS) limit = boundaryAllowance(s, zone);
  // An already excavated F2 stretch is never rolled back by a later gate calculation.
  return Math.max(s.crews.exc.pos, limit);
}

export function backfillLimit(s) {
  if (!s.scenario.inspections.required) return s.scenario.job.lengthFt;
  return s.scenario.job.zones.find(z => !s.inspections[z.id].cleared)?.toFt ?? s.scenario.job.lengthFt;
}

export function updateHoldPoints(s) {
  for (const zone of s.scenario.job.zones) {
    const inspection = s.inspections[zone.id];
    if (s.crews.back.pos >= zone.toFt - EPS) {
      if (!inspection.reported && s.scenario.inspections.required) {
        inspection.reported = true;
        // WO-02: both authored Texas stages return this compaction result.
        s.inbox.push({ day: s.t, from: 'City inspector', subject: `Zone ${zone.id} compaction`, body: 'passed' });
      }
      if (inspection.cleared || !s.scenario.inspections.required) s.permits[zone.id].signed = true;
    }
  }
}

export const finalInspectionEntered = s => !s.scenario.inspections.required
  || s.inspections[s.scenario.job.zones.at(-1).id].cleared;
import { CREW_IDS, EPS, activeCollapse, displayDay, nearby, nextBoundary, travelDays, voice } from './common.js';
import { markFirstRadio, firstLend } from './deviations.js';
import { availableResponses, clearingDays } from './events.js';
import { buyMachine, releaseMachine } from './money.js';
import { validateInspection, validatePermit, updateHoldPoints } from './permits.js';
import { projectOrder } from './planning.js';

const OFFICE_OPS = new Set(['setStart', 'enterPermit', 'enterInspection', 'pay']);
const CREW_OPS = new Set(['setStart', 'hold', 'resume', 'demob', 'remob']);
const PLAN_OPS = new Set([...CREW_OPS, ...OFFICE_OPS, 'lend', 'order', 'protect', 'radio']);
const positive = n => Number.isFinite(n) && n > 0;
const owns = (object, key) => typeof key === 'string' && Object.hasOwn(object, key) && !key.startsWith('_');
const ownerOf = (s, machine) => CREW_IDS.find(id => s.crews[id].machine === machine);
export const landingTime = (s, crew) => s.pure || crew && nearby(s, s.crews[crew].pos) ? s.t : nextBoundary(s.t);

export function validateOp(s, op) {
  if (!op || !PLAN_OPS.has(op.op)) return 'unknown operation';
  if (CREW_OPS.has(op.op) && !CREW_IDS.includes(op.crew)) return 'unknown crew';
  const c = s.crews[op.crew];
  if (op.op === 'setStart') {
    if (s.scenario.plan.locked || c.locked) return 'plan locked';
    if (s.t >= c.startDay - 1 - EPS) return 'crew already started';
    if (!Number.isInteger(op.day) || op.day < displayDay(s.t)) return 'invalid start day';
  }
  if (op.op === 'hold' && (op.days != null && !positive(op.days)
    || op.fromDay != null && (!Number.isInteger(op.fromDay) || op.fromDay < displayDay(s.t)))) return 'invalid hold';
  if (op.op === 'lend') {
    const owner = ownerOf(s, op.machine);
    if (!owner || s.crews[owner].lentAway || s.loans.some(l => l.fromCrew === owner && l.phase !== 'returned')
      || s.orders.some(order => order.op.op === 'lend' && order.op.machine === op.machine
        && order.appliedT == null)) return 'machine unavailable';
    if (!CREW_IDS.includes(op.toCrew) || op.toCrew === owner || !positive(op.days)) return 'invalid lend';
  }
  if (op.op === 'protect' || op.op === 'order') {
    if (!s.scenario.plan.preparationAllowed) return 'not in the budget';
    if (op.op === 'order') {
      if (!owns(s.catalog.machines, op.machine)) return 'unknown machine';
      if (op.rush) return 'rush unavailable';
    } else {
      if (!owns(s.catalog.protection, op.kind)) return 'unknown protection';
      if (s.catalog.protection[op.kind].reactOnly) return 'no such response now';
      if (op.kind === 'trench_slope' && (s.catalog.cities[s.scenario.city].slopeRefused
        || s.catalog.protection[op.kind].refusedInCities?.includes(s.scenario.city))) return 'slope refused';
      if (!Number.isFinite(op.fromFt) || !Number.isFinite(op.toFt) || op.fromFt < 0
        || op.toFt > s.scenario.job.lengthFt || op.fromFt >= op.toFt) return 'invalid stretch';
    }
  }
  if (op.op === 'pay') {
    const response = availableResponses(s).find(r => r.option.key === op.item);
    if (!response) return 'no such response now';
    if (op.item === 'hire_excavator' && (!owns(s.catalog.machines, op.machine)
      || s.catalog.machines[op.machine].crew !== 'exc')) return 'unknown machine';
    if (op.item === 'clear_own' && s.crews.exc.lentAway) return 'machine unavailable';
  }
  if (op.op === 'enterPermit') return validatePermit(s, op);
  if (op.op === 'enterInspection') return validateInspection(s, op);
  if (op.op === 'radio' && !s.orders.some(order => order.id === op.orderId)) return 'order not on file';
}

function startLoan(s, op) {
  const fromCrew = ownerOf(s, op.machine);
  const event = fromCrew === 'exc' && op.toCrew === 'pipe' ? activeCollapse(s) : null;
  const loan = { machine: op.machine, fromCrew, toCrew: op.toCrew, phase: 'outbound',
    arrivesT: s.t + travelDays(s.crews[fromCrew].pos, s.crews[op.toCrew].pos), days: op.days,
    eventId: event?.id ?? null };
  s.crews[fromCrew].lentAway = true;
  s.loans.push(loan);
  if (event) event.option = 'clear_own';
  firstLend(s);
}

function purchase(s, machine, event) {
  buyMachine(s, machine);
  s.deliveries.push({ machine, crew: s.catalog.machines[machine].crew, issuedT: s.t,
    arrivesT: s.t + s.catalog.machines[machine].leadDays.normal + s.catalog.cities[s.scenario.city].leadDelayDays,
    hired: !!event, eventId: event?.id ?? null, arrived: false, released: false });
}

function pay(s, op) {
  const { event, option } = availableResponses(s).find(r => r.option.key === op.item);
  event.option = op.item;
  if (op.item === 'hire_excavator') {
    purchase(s, op.machine, event);
    return;
  }
  s.spentUsd += option.cost.usd;
  s.payments.push({ item: op.item, paidT: s.t, perDayUsd: option.cost.perDayUsd });
  if (option.effect.lend) {
    const fromCrew = option.effect.lend.machineOf;
    issueOrder(s, { op: 'lend', machine: s.crews[fromCrew].machine,
      toCrew: option.effect.lend.toCrew, days: clearingDays(s, event, s.crews[fromCrew].machine) });
  }
  if (option.effect.resumeAfterDays != null) event.endsT = s.t + option.effect.resumeAfterDays;
  if (option.effect.rainRateRestore) {
