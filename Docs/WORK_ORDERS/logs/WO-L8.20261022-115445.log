"""WO-S6 source acceptance scan; requires only the installed Python standard library."""
from pathlib import Path
import re

root = Path(__file__).resolve().parents[1]
files = [*root.joinpath("Editor").rglob("*.cs"), *root.joinpath("Runtime").rglob("*.cs")]
errors = []
for path in files:
    source = path.read_text(encoding="utf-8-sig")
    if re.search(r"AddComponent\s*<\s*OVR", source):
        errors.append(f"{path}: adds an OVR component")
    if re.search(r"Instantiate\s*\([^;]*(?:OVRCameraRig|rig\.gameObject)", source):
        errors.append(f"{path}: copies a camera rig")
    if "OVRInput." in source and "Physics.Raycast" in source:
        errors.append(f"{path}: controller input and manual raycast coexist")
    if re.search(r"\b(?:rig|CameraRig)\.transform\.(?:SetParent|RotateAround|position\s*=)", source):
        errors.append(f"{path}: moves or reparents the rig")
if root.joinpath("Runtime/VR/ControllerPointer.cs").exists():
    errors.append("The custom ControllerPointer remains")
if errors:
    raise SystemExit("\n".join(errors))
print(f"PASS: {len(files)} source files; no OVR component creation, rig copying/reparenting, or OVRInput raycasts; custom pointer removed.")
using LOBOver.XR;
using Oculus.Interaction;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class CrewButton : MonoBehaviour
    {
        public WarpController warp;
        public string crew;
        public bool goToSite;
        public AudioSource click;
        public bool Available => warp != null && (!goToSite && string.IsNullOrEmpty(crew)
            ? warp.InSite || warp.Busy
            : !warp.Busy && !warp.InSite && warp.connection.Connected && !warp.connection.Mirror && warp.connection.View != null);
        private InteractionSurface surface;
        private Renderer face;
        private MaterialPropertyBlock tint;
        private Color normalColour;
        private void OnEnable()
        {
            surface = GetComponent<InteractionSurface>();
            if (surface != null) surface.Selected += Press;
            face = transform.Find("Face")?.GetComponent<Renderer>();
            if (face != null)
            {
                tint = new MaterialPropertyBlock();
                normalColour = face.sharedMaterial.GetColor("_BaseColor");
            }
        }
        private void OnDisable() { if (surface != null) surface.Selected -= Press; }
        private void Update()
        {
            var ray = GetComponent<RayInteractable>(); var poke = GetComponent<PokeInteractable>();
            if (ray != null) ray.enabled = Available;
            if (poke != null) poke.enabled = Available;
            if (face != null)
            {
                var grey = normalColour.grayscale;
                tint.SetColor("_BaseColor", warp != null && warp.Busy && !!goToSite && string.IsNullOrEmpty(crew)
                    ? new Color(grey, grey, grey, 1) : normalColour);
                face.SetPropertyBlock(tint);
            }
        }
        private void Press(Vector3 ignored)
        {
            if (!Available) return;
            var accepted = goToSite ? warp.GoToSite() : string.IsNullOrEmpty(crew) ? warp.Back() : warp.Visit(crew);
            if (accepted && click != null && click.clip != null) click.Play();
        }
    }
}
