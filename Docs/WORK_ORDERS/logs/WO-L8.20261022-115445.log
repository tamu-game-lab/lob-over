diff --git a/Assets/LOBOver/Editor/PlayPanelsBuilder.cs b/Assets/LOBOver/Editor/PlayPanelsBuilder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..5e638d0f1b4ef4dd6e9f905a9f4907d239a8de2c
--- /dev/null
+++ b/Assets/LOBOver/Editor/PlayPanelsBuilder.cs
@@ -0,0 +1,81 @@
+using LOBOver.Play;
+using LOBOver.World;
+using LOBOver.XR;
+using Oculus.Interaction;
+using Oculus.Interaction.HandGrab;
+using TMPro;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace LOBOver.Editor
+{
+    public static class PlayPanelsBuilder
+    {
+        public static void Build(Transform client, Transform wrist, HostVoice voice, HostWorldPresenter presenter,
+            WarpController warp, XRRig rig, Light sun, WorldAssets assets, Material dark, Material button)
+        {
+            var log = client.gameObject.AddComponent<SpeechLog>();
+            log.voice = voice; log.presenter = presenter; log.rig = rig; log.warp = warp; log.cardMaterial = dark;
+            var panel = WorldDrawing.Group("[LOBOver] SpeechLog", null);
+            panel.SetActive(false); log.panel = panel.transform;
+            var back = WorldDrawing.Box("OpaqueCard", panel.transform, Vector3.zero, new Vector3(SpeechLog.Width, SpeechLog.Height, 0.01f), dark);
+            Object.DestroyImmediate(back.GetComponent<Collider>());
+            var body = panel.AddComponent<Rigidbody>(); body.isKinematic = true; body.useGravity = false;
+            var collider = panel.AddComponent<BoxCollider>(); collider.size = new Vector3(SpeechLog.Width, SpeechLog.Height, 0.025f);
+            var grabbable = panel.AddComponent<Grabbable>(); grabbable.InjectOptionalTargetTransform(panel.transform);
+            grabbable.InjectOptionalRigidbody(body); grabbable.InjectOptionalThrowWhenUnselected(false); grabbable.MaxGrabPoints = 1;
+            // OneGrabTranslateTransformer cannot rotate; the SDK's free one-grab transformer supports both without scaling.
+            grabbable.InjectOptionalOneGrabTransformer(panel.AddComponent<OneGrabFreeTransformer>());
+            var controller = panel.AddComponent<GrabInteractable>(); controller.InjectRigidbody(body); controller.InjectOptionalPointableElement(grabbable);
+            var hand = panel.AddComponent<HandGrabInteractable>(); hand.InjectRigidbody(body); hand.InjectOptionalPointableElement(grabbable);
+            var canvasObject = new GameObject("LogCanvas", typeof(RectTransform), typeof(Canvas), typeof(GraphicRaycaster));
+            canvasObject.transform.SetParent(panel.transform, false); canvasObject.transform.localPosition = new Vector3(0, 0, -0.008f);
+            // Pixel-sized UI at a fixed metre scale keeps TMP cap heights and Interaction SDK canvas input consistent.
+            canvasObject.transform.localScale = Vector3.one * 0.001f;
+            var canvas = canvasObject.GetComponent<Canvas>(); canvas.renderMode = RenderMode.WorldSpace;
+            canvas.GetComponent<RectTransform>().sizeDelta = new Vector2(500, 350);
+            log.header = Text("Clock", canvas.transform, assets, new Vector2(350, 60), new Vector2(-60, 135));
+            log.header.fontSize = FontSize(assets, SpeechLog.Letters);
+            var viewport = new GameObject("Viewport", typeof(RectTransform), typeof(Image), typeof(RectMask2D));
+            viewport.transform.SetParent(canvas.transform, false);
+            var viewportRect = viewport.GetComponent<RectTransform>(); viewportRect.sizeDelta = new Vector2(460, 240); viewportRect.anchoredPosition = new Vector2(0, -25);
+            viewport.GetComponent<Image>().color = new Color(0.035f, 0.045f, 0.06f, 1);
+            var history = Text("LastTwentyLines", viewport.transform, assets, new Vector2(450, 240), Vector2.zero);
+            history.rectTransform.anchorMin = new Vector2(0, 1); history.rectTransform.anchorMax = new Vector2(1, 1);
+            history.rectTransform.pivot = new Vector2(0.5f, 1); history.rectTransform.sizeDelta = new Vector2(-10, 0);
+            history.rectTransform.anchoredPosition = Vector2.zero; history.fontSize = FontSize(assets, SpeechLog.Letters);
+            var fit = history.gameObject.AddComponent<ContentSizeFitter>(); fit.verticalFit = ContentSizeFitter.FitMode.PreferredSize;
+            log.history = history;
+            var scroll = viewport.AddComponent<ScrollRect>(); scroll.viewport = viewportRect; scroll.content = history.rectTransform;
+            scroll.horizontal = false; scroll.vertical = true; scroll.movementType = ScrollRect.MovementType.Clamped;
+            log.scroll = scroll; InteractionSurface.Canvas(canvas);
+            LogButton(wrist, "Log", new Vector3(0.12f, 0, 0), log, assets, button);
+            LogButton(panel.transform, "Close", new Vector3(0.185f, 0.135f, -0.015f), log, assets, button);
+            var cycle = client.gameObject.AddComponent<SiteDayCycle>(); cycle.connection = presenter.connection;
+            cycle.warp = warp; cycle.rig = rig; cycle.sun = sun; log.clock = cycle;
+            var caption = WorldDrawing.Text("[LOBOver] DayCaption", null, Vector3.zero, new Vector2(2, 0.4f), SiteDayCycle.CaptionHeight, assets.font);
+            caption.fontSize = SiteDayCycle.CaptionHeight * 10 * assets.font.faceInfo.pointSize / Mathf.Max(1, assets.font.faceInfo.capLine);
+            caption.alignment = TextAlignmentOptions.Center; caption.gameObject.SetActive(false); cycle.caption = caption;
+        }
+        private static float FontSize(WorldAssets assets, float metres) => metres * 1000 * assets.font.faceInfo.pointSize / Mathf.Max(1, assets.font.faceInfo.capLine);
+        private static TextMeshProUGUI Text(string name, Transform parent, WorldAssets assets, Vector2 size, Vector2 position)
+        {
+            var obj = new GameObject(name, typeof(RectTransform)); obj.transform.SetParent(parent, false);
+            var text = obj.AddComponent<TextMeshProUGUI>(); text.font = assets.font; text.color = Color.white;
+            text.rectTransform.sizeDelta = size; text.rectTransform.anchoredPosition = position;
+            text.alignment = TextAlignmentOptions.TopLeft; text.textWrappingMode = TextWrappingModes.Normal;
+            text.richText = true; return text;
+        }
+        private static void LogButton(Transform parent, string title, Vector3 position, SpeechLog log, WorldAssets assets, Material material)
+        {
+            var root = WorldDrawing.Group(title, parent); root.transform.localPosition = position;
+            var size = new Vector2(0.11f, 0.06f); // XR_RENDERING minimum reachable button.
+            var face = WorldDrawing.Box("Face", root.transform, Vector3.zero, new Vector3(size.x, size.y, 0.006f), material);
+            Object.DestroyImmediate(face.GetComponent<Collider>());
+            var text = WorldDrawing.Text("Label", root.transform, new Vector3(0, 0, -0.005f), size, SpeechLog.Letters, assets.font);
+            text.fontSize = SpeechLog.Letters * 10 * assets.font.faceInfo.pointSize / Mathf.Max(1, assets.font.faceInfo.capLine);
+            text.text = title; text.alignment = TextAlignmentOptions.Center;
+            InteractionSurface.Button(root, size); root.AddComponent<LogButton>().log = log;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/Play/CrewAttention.cs b/Assets/LOBOver/Runtime/Play/CrewAttention.cs
new file mode 100644
index 0000000000000000000000000000000000000000..41e389b5b8ec4779580e669e52e0c7d19cdba01b
--- /dev/null
+++ b/Assets/LOBOver/Runtime/Play/CrewAttention.cs
@@ -0,0 +1,75 @@
+using System.Collections.Generic;
+using LOBOver.World;
+using UnityEngine;
+
+namespace LOBOver.Play
+{
+    public sealed class CrewAttention : MonoBehaviour
+    {
+        public WarpController warp;
+        public HostWorldPresenter presenter;
+        public Material ringMaterial;
+        // WO-L8 items 4 and 8. The radius/width describe the thin ground marker, not game state.
+        public const float DwellSeconds = 2, RevealSeconds = 0.6f, RingRadius = 2, RingWidth = 0.025f;
+        public string Candidate { get; private set; }
+        public float Dwell { get; private set; }
+        private readonly Dictionary<CrewRig, LineRenderer> rings = new Dictionary<CrewRig, LineRenderer>();
+        private readonly Dictionary<Renderer, float> reveals = new Dictionary<Renderer, float>();
+        private readonly HashSet<Renderer> visible = new HashSet<Renderer>();
+        private readonly MaterialPropertyBlock properties = new MaterialPropertyBlock();
+        private void Update()
+        {
+            if (!warp.InSite || warp.Busy) { Candidate = null; Dwell = 0; return; }
+            var head = warp.rig.ViewEye;
+            var ray = new Ray(head.position, head.forward);
+            CrewRig looking = null; var nearest = float.PositiveInfinity;
+            foreach (var id in WorldUnits.CrewIds)
+            {
+                var crew = presenter.world.Crew(id);
+                if (crew == null || !crew.gameObject.activeInHierarchy) continue;
+                if (!rings.TryGetValue(crew, out var ring))
+                {
+                    ring = WorldDrawing.Line("Attention", crew.transform, ringMaterial, Color.white, RingWidth);
+                    ring.positionCount = 49; ring.loop = true; ring.alignment = LineAlignment.View;
+                    for (var i = 0; i < ring.positionCount; i++)
+                    { var angle = i * Mathf.PI * 2 / (ring.positionCount - 1); ring.SetPosition(i, new Vector3(Mathf.Cos(angle) * RingRadius, 0.03f, Mathf.Sin(angle) * RingRadius)); }
+                    rings[crew] = ring;
+                }
+                var colour = WorldUnits.CrewColours[System.Array.IndexOf(WorldUnits.CrewIds, id)];
+                ring.startColor = ring.endColor = colour * (id == warp.AttendedCrew ? 1 : 0.25f);
+                foreach (var renderer in crew.GetComponentsInChildren<Renderer>())
+                {
+                    if (renderer is ParticleSystemRenderer || renderer is LineRenderer || renderer.GetComponent<TMPro.TMP_Text>() != null) continue;
+                    var worker = renderer.transform.IsChildOf(crew.Foreman) || HasWorkerAncestor(renderer.transform, crew.transform);
+                    if (!worker && (crew.Machine == null || !renderer.transform.IsChildOf(crew.Machine.transform))) continue;
+                    if (renderer.bounds.IntersectRay(ray, out var distance) && distance < nearest) { nearest = distance; looking = crew; }
+                    var inView = Vector3.Angle(head.forward, renderer.bounds.center - head.position) < 60;
+                    if (inView && visible.Add(renderer)) reveals[renderer] = warp.Progress == 1 ? Time.unscaledTime : Time.unscaledTime - RevealSeconds;
+                    if (reveals.TryGetValue(renderer, out var start))
+                    {
+                        renderer.GetPropertyBlock(properties);
+                        properties.SetFloat("_SpawnProgress", Mathf.Clamp01((Time.unscaledTime - start) / RevealSeconds));
+                        renderer.SetPropertyBlock(properties);
+                    }
+                }
+            }
+            var candidate = looking == null ? null : looking.Id;
+            if (candidate != Candidate) { Candidate = candidate; Dwell = 0; }
+            if (Candidate == null || Candidate == warp.AttendedCrew) { Dwell = 0; return; }
+            Dwell += Time.unscaledDeltaTime;
+            if (Dwell >= DwellSeconds && warp.Attend(Candidate)) Dwell = 0;
+        }
+        private static bool HasWorkerAncestor(Transform item, Transform crew)
+        {
+            while (item != null && item != crew) { if (item.name == "Worker") return true; item = item.parent; }
+            return false;
+        }
+        public void PrimeVisible()
+        {
+            visible.Clear(); reveals.Clear();
+            // The entry wave already reveals these; only later arrivals need the local 0.6 s effect.
+            foreach (var renderer in presenter.world.GetComponentsInChildren<Renderer>())
+                if (Vector3.Angle(warp.rig.ViewEye.forward, renderer.bounds.center - warp.rig.ViewEye.position) < 60) visible.Add(renderer);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/Play/SiteDayCycle.cs b/Assets/LOBOver/Runtime/Play/SiteDayCycle.cs
new file mode 100644
index 0000000000000000000000000000000000000000..fffa6f71b310bd454a04009a57c946542ef4a031
--- /dev/null
+++ b/Assets/LOBOver/Runtime/Play/SiteDayCycle.cs
@@ -0,0 +1,87 @@
+using LOBOver.Client;
+using LOBOver.XR;
+using Newtonsoft.Json.Linq;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.Play
+{
+    public sealed class SiteDayCycle : MonoBehaviour
+    {
+        public HostConnection connection;
+        public WarpController warp;
+        public XRRig rig;
+        public Light sun;
+        public TextMeshPro caption;
+        // LEVEL1.md clock; WO-L8 item 7 lighting and caption timing.
+        public const float FullDaySeconds = 4, SlowDaySeconds = 15, DuskStart = 0.85f, DuskBrightness = 0.25f;
+        public const float DawnSeconds = 0.3f, CaptionSeconds = 1.5f, CaptionAhead = 2, CaptionHeight = 0.2f;
+        public const float HorizonDegrees = 20;
+        public string Speed { get; private set; } = "paused";
+        public float Fraction { get; private set; }
+        public float Brightness { get; private set; } = 1;
+        public float DaylightIntensity { get; private set; }
+        private double day;
+        private float receivedAt, dawnAt = -100, captionUntil;
+        private int displayDay = -1;
+        private Color daylightColour, ambientSky, ambientEquator, ambientGround, fog;
+        private string run;
+        private void OnEnable()
+        {
+            connection.Message += Receive;
+            DaylightIntensity = sun.intensity; daylightColour = sun.color;
+            ambientSky = RenderSettings.ambientSkyColor; ambientEquator = RenderSettings.ambientEquatorColor;
+            ambientGround = RenderSettings.ambientGroundColor; fog = RenderSettings.fogColor;
+            Shader.SetGlobalFloat("_SiteDayActive", 1);
+        }
+        private void OnDisable()
+        {
+            connection.Message -= Receive;
+            sun.intensity = DaylightIntensity; sun.color = daylightColour;
+            RenderSettings.ambientSkyColor = ambientSky; RenderSettings.ambientEquatorColor = ambientEquator;
+            RenderSettings.ambientGroundColor = ambientGround; RenderSettings.fogColor = fog;
+            Shader.SetGlobalFloat("_SiteDusk", 0); Shader.SetGlobalFloat("_SiteDayActive", 0);
+        }
+        private void Receive(JObject message)
+        {
+            if ((string)message["t"] == "welcome") message = message["state"] as JObject;
+            if (message?["day"] == null) return;
+            if (run != connection.RunId) { displayDay = -1; run = connection.RunId; }
+            day = (double)message["day"]; receivedAt = Time.unscaledTime;
+            Speed = (string)message["speed"] ?? "paused";
+            var next = (int)System.Math.Floor(day) + 1;
+            if (displayDay > 0 && next != displayDay)
+            {
+                dawnAt = Time.unscaledTime; captionUntil = dawnAt + CaptionSeconds;
+                if (rig.TryHeadPose(out var pose))
+                {
+                    var position = pose.position + pose.rotation * Vector3.forward * CaptionAhead;
+                    caption.transform.SetPositionAndRotation(position, Quaternion.LookRotation(position - pose.position));
+                }
+                caption.text = "Day " + next;
+            }
+            displayDay = next;
+        }
+        public static float BrightnessAt(float fraction) => Mathf.Lerp(1, DuskBrightness, Mathf.Clamp01((fraction - DuskStart) / (1 - DuskStart)));
+        private void Update()
+        {
+            var seconds = Speed == "slow" ? SlowDaySeconds : FullDaySeconds;
+            var fraction = (float)(day - System.Math.Floor(day));
+            Fraction = Mathf.Clamp01(fraction + (Speed == "paused" || !connection.Connected ? 0 : (Time.unscaledTime - receivedAt) / seconds));
+            Brightness = Time.unscaledTime - dawnAt < DawnSeconds
+                ? Mathf.Lerp(DuskBrightness, 1, (Time.unscaledTime - dawnAt) / DawnSeconds) : BrightnessAt(Fraction);
+            var dusk = (1 - Brightness) / (1 - DuskBrightness);
+            sun.intensity = DaylightIntensity * Brightness;
+            sun.color = Color.Lerp(daylightColour, new Color(1, 0.52f, 0.28f), dusk);
+            var angle = Mathf.Lerp(HorizonDegrees, 180 - HorizonDegrees, Fraction) * Mathf.Deg2Rad;
+            var towardSun = warp.site.rotation * new Vector3(Mathf.Cos(angle), Mathf.Sin(angle), 0);
+            sun.transform.rotation = Quaternion.LookRotation(-towardSun, Vector3.forward);
+            Shader.SetGlobalFloat("_SiteDusk", dusk);
+            RenderSettings.ambientSkyColor = ambientSky * Mathf.Lerp(1, 0.4f, dusk);
+            RenderSettings.ambientEquatorColor = ambientEquator * Mathf.Lerp(1, 0.4f, dusk);
+            RenderSettings.ambientGroundColor = ambientGround * Mathf.Lerp(1, 0.4f, dusk);
+            RenderSettings.fogColor = Color.Lerp(fog, new Color(0.26f, 0.24f, 0.31f), dusk);
+            caption.gameObject.SetActive(warp.InSite && !warp.Busy && Time.unscaledTime < captionUntil);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/Play/SpeechLog.cs b/Assets/LOBOver/Runtime/Play/SpeechLog.cs
new file mode 100644
index 0000000000000000000000000000000000000000..59311b7c4a51821a5dd7d4cbfd402d1535a091ca
--- /dev/null
+++ b/Assets/LOBOver/Runtime/Play/SpeechLog.cs
@@ -0,0 +1,117 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using LOBOver.World;
+using LOBOver.XR;
+using TMPro;
+using UnityEngine;
+using UnityEngine.UI;
+
+namespace LOBOver.Play
+{
+    public sealed class SpeechLog : MonoBehaviour
+    {
+        public HostVoice voice;
+        public HostWorldPresenter presenter;
+        public WarpController warp;
+        public XRRig rig;
+        public Transform panel;
+        public TMP_Text header, history;
+        public ScrollRect scroll;
+        public Material cardMaterial;
+        // WO-L8 items 5-6, metres / seconds / retained lines.
+        public const int LineLimit = 20, BubbleLimit = 2;
+        public const float Width = 0.5f, Height = 0.35f, Ahead = 1, BelowEye = 0.15f;
+        public const float Letters = 0.015f, BubbleLetters = 0.02f, BubbleDistance = 10, AboveHead = 0.4f, TailSeconds = 2;
+        public sealed class Entry { public int Day; public string Crew, Speaker, Text; }
+        public IReadOnlyList<Entry> Lines => lines;
+        public int BubbleCount => bubbles.Count;
+        public bool Open => panel.gameObject.activeSelf;
+        private readonly List<Entry> lines = new List<Entry>();
+        private readonly List<Bubble> bubbles = new List<Bubble>();
+        private sealed class Bubble { public Transform Root; public CrewRig Crew; public float Until; }
+        private bool placed;
+        private string run;
+        private void OnEnable() { voice.Speaking += Show; voice.Cleared += Clear; }
+        private void OnDisable() { voice.Speaking -= Show; voice.Cleared -= Clear; ClearBubbles(); }
+        private void Clear()
+        {
+            ClearBubbles();
+            if (run == presenter.connection.RunId) return;
+            run = presenter.connection.RunId; lines.Clear(); if (history != null) history.text = "";
+        }
+        private void ClearBubbles()
+        { foreach (var bubble in bubbles) if (bubble.Root != null) Destroy(bubble.Root.gameObject); bubbles.Clear(); }
+        private void Show(string speaker, string text, int day, float duration)
+        {
+            if (string.IsNullOrEmpty(text)) return;
+            var crewId = HostVoice.CrewId(speaker);
+            var name = crewId == "exc" ? "Ray" : crewId == "pipe" ? "Marcus" : crewId == "back" ? "Dana" : speaker;
+            var entry = new Entry { Day = day, Crew = crewId, Speaker = name, Text = text };
+            lines.Add(entry); if (lines.Count > LineLimit) lines.RemoveAt(0);
+            history.text = string.Join("\n\n", lines.Select(line => "Day " + line.Day + "  <color=#" + Colour(line.Crew) + ">" + line.Speaker
+                + "</color>\n<noparse>" + line.Text + "</noparse>"));
+            Canvas.ForceUpdateCanvases(); scroll.verticalNormalizedPosition = 0;
+            var crew = presenter.world.Crew(crewId);
+            if (crew == null) return;
+            while (bubbles.Count >= BubbleLimit) { Destroy(bubbles[0].Root.gameObject); bubbles.RemoveAt(0); }
+            var root = WorldDrawing.Group("Speech_" + name, transform).transform;
+            var card = WorldDrawing.Box("Card", root, Vector3.zero, new Vector3(1.25f, 0.32f, 0.012f), cardMaterial);
+            Destroy(card.GetComponent<Collider>());
+            var label = WorldDrawing.Text("Words", root, new Vector3(0, 0, -0.009f), new Vector2(1.17f, 0.28f), BubbleLetters, presenter.world.assets.font);
+            label.richText = true; label.alignment = TextAlignmentOptions.TopLeft;
+            var face = label.font.faceInfo; label.fontSize = BubbleLetters * 10 * face.pointSize / Mathf.Max(1, face.capLine);
+            label.text = "<color=#" + Colour(crewId) + ">" + name + "</color>\n<color=#FFFFFF><noparse>" + text + "</noparse></color>";
+            label.ForceMeshUpdate();
+            var height = Mathf.Max(0.14f, label.preferredHeight + 0.05f);
+            label.rectTransform.sizeDelta = new Vector2(1.17f, height - 0.04f);
+            card.transform.localScale = new Vector3(1.25f, height, 0.012f);
+            bubbles.Add(new Bubble { Root = root, Crew = crew, Until = Time.unscaledTime + duration + TailSeconds });
+        }
+        private static string Colour(string crew)
+        {
+            var index = Array.IndexOf(WorldUnits.CrewIds, crew);
+            return ColorUtility.ToHtmlStringRGB(index < 0 ? Color.white : WorldUnits.CrewColours[index]);
+        }
+        public void Toggle()
+        {
+            if (Open) { panel.gameObject.SetActive(false); return; }
+            if (!rig.TryHeadPose(out var pose)) return;
+            var toPanel = panel.position - pose.position;
+            var inView = Vector3.Angle(pose.rotation * Vector3.forward, toPanel) < 60
+                && Vector3.Dot(panel.forward, toPanel) > 0;
+            if (!placed || !inView)
+            {
+                var forward = Vector3.ProjectOnPlane(pose.rotation * Vector3.forward, Vector3.up).normalized;
+                if (forward.sqrMagnitude < 0.1f) forward = Vector3.forward;
+                var position = pose.position + forward * Ahead - Vector3.up * BelowEye;
+                panel.SetPositionAndRotation(position, Quaternion.LookRotation(position - pose.position)); placed = true;
+            }
+            panel.gameObject.SetActive(true);
+        }
+        private void LateUpdate()
+        {
+            header.text = "Day " + presenter.connection.DisplayDay + "  " + (clock != null && clock.Speed == "slow" ? "Field slow" : "Running");
+            if (!warp.InSite || warp.Busy) panel.gameObject.SetActive(false);
+            foreach (var bubble in bubbles.ToArray())
+            {
+                if (bubble.Crew == null || Time.unscaledTime >= bubble.Until)
+                { if (bubble.Root != null) Destroy(bubble.Root.gameObject); bubbles.Remove(bubble); continue; }
+                bubble.Root.gameObject.SetActive(warp.InSite && !warp.Busy && bubble.Crew.gameObject.activeInHierarchy);
+                var bounds = SiteGround.Bounds(bubble.Crew.Foreman);
+                bubble.Root.position = new Vector3(bounds.center.x, bounds.max.y + AboveHead, bounds.center.z);
+                bubble.Root.rotation = Quaternion.LookRotation(bubble.Root.position - rig.ViewEye.position);
+                bubble.Root.localScale = Vector3.one * (Vector3.Distance(bubble.Root.position, rig.ViewEye.position) / BubbleDistance);
+            }
+        }
+        public SiteDayCycle clock;
+    }
+    public sealed class LogButton : MonoBehaviour
+    {
+        public SpeechLog log;
+        private InteractionSurface surface;
+        private void OnEnable() { surface = GetComponent<InteractionSurface>(); surface.Selected += Press; }
+        private void OnDisable() { if (surface != null) surface.Selected -= Press; }
+        private void Press(Vector3 ignored) => log.Toggle();
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/SiteGround.cs b/Assets/LOBOver/Runtime/World/SiteGround.cs
new file mode 100644
index 0000000000000000000000000000000000000000..6de862eea01f9203dd66535128ab691698c06ab9
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/SiteGround.cs
@@ -0,0 +1,50 @@
+using System.Linq;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public static class SiteGround
+    {
+        // WO-L4 ground generator, shared by the builder and WO-L8 placement.
+        public const float FlatRadius = 8, Relief = 0.6f, RutDepth = 0.06f;
+        public static float Noise(float x, float z) => (Mathf.PerlinNoise(x * 0.017f + 23, z * 0.017f + 73) * 0.57f
+            + Mathf.PerlinNoise(x * 0.037f + 9, z * 0.037f + 31) * 0.28f + Mathf.PerlinNoise(x * 0.081f + 59, z * 0.081f + 11) * 0.15f) * 2 - 1;
+        public static float GroundHeight(float x, float z)
+        {
+            var distance = Mathf.Min(Mathf.Abs(z), Mathf.Abs(z - WorldUnits.RoadZ));
+            var height = Relief * Noise(x, z) * Mathf.SmoothStep(0, 1, (distance - FlatRadius) / 14);
+            var road = z - WorldUnits.RoadZ;
+            return height - RutDepth * (Mathf.Exp(-Mathf.Pow((road - 0.85f) / 0.3f, 2)) + Mathf.Exp(-Mathf.Pow((road + 0.85f) / 0.3f, 2)));
+        }
+        public static Bounds Bounds(Transform root)
+        {
+            var renderers = root.GetComponentsInChildren<Renderer>(true).Where(r => !(r is ParticleSystemRenderer) && r.GetComponent<TMPro.TMP_Text>() == null).ToArray();
+            var bounds = renderers.Length == 0 ? new Bounds(root.position, Vector3.zero) : renderers[0].bounds;
+            foreach (var renderer in renderers.Skip(1)) bounds.Encapsulate(renderer.bounds);
+            return bounds;
+        }
+    }
+
+    // One marker per placed object, not per piece of a machine or cabin. Trench parts have their own depths.
+    public sealed class GroundedObject : MonoBehaviour
+    {
+        public Transform groundSpace;
+        public bool followsAnimation;
+        public static GroundedObject Place(GameObject obj, Transform space, bool animated = false)
+        {
+            var item = obj.GetComponent<GroundedObject>() ?? obj.AddComponent<GroundedObject>();
+            item.groundSpace = space; item.followsAnimation = animated; item.Settle(); return item;
+        }
+        public float Clearance
+        {
+            get
+            {
+                var bounds = SiteGround.Bounds(transform);
+                var point = groundSpace.InverseTransformPoint(bounds.center);
+                return bounds.min.y - groundSpace.TransformPoint(new Vector3(point.x, SiteGround.GroundHeight(point.x, point.z), point.z)).y;
+            }
+        }
+        public void Settle() { if (groundSpace != null) transform.position -= Vector3.up * Clearance; }
+        private void LateUpdate() { if (followsAnimation) Settle(); }
+    }
+}
diff --git a/Assets/LOBOver/Runtime/World/StageLayout.cs b/Assets/LOBOver/Runtime/World/StageLayout.cs
new file mode 100644
index 0000000000000000000000000000000000000000..999f9342088f8f02f4f0d687223a787f4257b769
--- /dev/null
+++ b/Assets/LOBOver/Runtime/World/StageLayout.cs
@@ -0,0 +1,80 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using LOBOver.Sim;
+using TMPro;
+using UnityEngine;
+
+namespace LOBOver.World
+{
+    public sealed class StageLayout : MonoBehaviour
+    {
+        // WO-L8 items 2-3. Slot sign is in the viewer's right direction; local X faces left.
+        public const float BaseGap = 8, MetresPerGapFoot = 0.02f, MaxSlot = 30, CaughtSlot = 4;
+        public const float CrawlSpeed = 1, Extent = 120, CellMetres = 6, StakeLetters = 0.06f;
+        // Far-bank staging leaves the maximum slot inside the head's +/-60 degree sector.
+        public const float MachineBank = -14;
+        public SiteWorld world;
+        private readonly List<StationCell> cells = new List<StationCell>();
+        private readonly Dictionary<string, Transform> stakes = new Dictionary<string, Transform>();
+        private readonly Dictionary<string, TextMeshPro> labels = new Dictionary<string, TextMeshPro>();
+        public static float Slot(string id, double excavation, double pipe, double backfill)
+        {
+            if (id == "pipe") return 0;
+            var gap = Math.Max(0, id == "exc" ? excavation - pipe : pipe - backfill);
+            if (id == "back" && gap == 0) return -CaughtSlot;
+            var distance = Mathf.Min(MaxSlot, BaseGap + MetresPerGapFoot * (float)gap);
+            return id == "exc" ? distance : -distance;
+        }
+        public Vector3 Target(CrewView crew, SiteView view) => new Vector3(-Slot(crew.id,
+            view.crews.First(c => c.id == "exc").stationFt, view.crews.First(c => c.id == "pipe").stationFt,
+            view.crews.First(c => c.id == "back").stationFt), 0, MachineBank);
+        public void Build(Transform parent, WorldAssets assets)
+        {
+            cells.Clear(); stakes.Clear(); labels.Clear();
+            for (var x = -Extent; x < Extent; x += CellMetres)
+            {
+                var cell = Instantiate(assets.stageCellPrefab, parent); cell.Initialize(0, assets);
+                cell.name = "StageCell_" + x; cell.transform.localPosition = new Vector3(x, 0, 0);
+                cell.stationText.text = ""; cells.Add(cell);
+            }
+            foreach (var id in WorldUnits.CrewIds)
+            {
+                var stake = SiteDetailDrawing.Stake(parent, assets, out var label);
+                label.fontSize = StakeLetters * 10 * assets.font.faceInfo.pointSize / Mathf.Max(1, assets.font.faceInfo.capLine);
+                label.rectTransform.sizeDelta = new Vector2(0.48f, 0.12f);
+                stake.Find("StationSign").localScale = new Vector3(0.52f, 0.16f, 0.018f);
+                stakes[id] = stake; labels[id] = label;
+            }
+            for (var x = -Extent; x <= Extent; x += 10)
+                SiteDetailDrawing.Prop(assets.fence, parent, new Vector3(x, 0, WorldUnits.RoadZ + 3));
+        }
+        private void LateUpdate() => Refresh();
+        public void Refresh()
+        {
+            var view = world.CurrentView;
+            if (view == null || cells.Count == 0) return;
+            var exc = world.Crew("exc").transform.localPosition.x;
+            var pipe = world.Crew("pipe").transform.localPosition.x;
+            var back = world.Crew("back").transform.localPosition.x;
+            foreach (var cell in cells)
+            {
+                var x = cell.transform.localPosition.x + CellMetres / 2;
+                var state = x < exc ? "undug" : x < pipe ? "open" : x < back ? "piped" : "backfilled";
+                var pipeFront = view.crews.First(c => c.id == "pipe").stationFt;
+                var real = view.trench.OrderBy(c => Math.Abs(c.stationFt - pipeFront)).FirstOrDefault();
+                // The visible pipe-front cell carries the host's live collapse/water, never an invented event.
+                var atPipe = pipe >= cell.transform.localPosition.x && pipe < cell.transform.localPosition.x + CellMetres;
+                if (atPipe && real != null && (real.wall == "slumped" || real.water != "none")) state = "open";
+                cell.Apply(new TrenchView { state = state, wall = atPipe ? real?.wall ?? "sound" : "sound",
+                    water = atPipe ? real?.water ?? "none" : "none", protection = atPipe ? real?.protection ?? "none" : "none", pipeDamage = "none" });
+            }
+            foreach (var id in WorldUnits.CrewIds)
+            {
+                var crew = world.Crew(id);
+                stakes[id].localPosition = new Vector3(crew.transform.localPosition.x, 0, 1.2f);
+                labels[id].text = WorldUnits.Station(crew.StationFt);
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Tests/EditMode/StagePresentationTests.cs b/Assets/LOBOver/Tests/EditMode/StagePresentationTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..cbe8662ebde3d1989e7755e3623d846131b0ddc3
--- /dev/null
+++ b/Assets/LOBOver/Tests/EditMode/StagePresentationTests.cs
@@ -0,0 +1,112 @@
+using System;
+using System.IO;
+using System.Linq;
+using LOBOver.Editor;
+using LOBOver.Play;
+using LOBOver.Sim;
+using LOBOver.World;
+using Newtonsoft.Json.Linq;
+using NUnit.Framework;
+using Oculus.Interaction;
+using Oculus.Interaction.HandGrab;
+using UnityEngine;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Tests.Editor
+{
+    public sealed class StagePresentationTests
+    {
+        [Test]
+        public void AllMachineVariantsAndWorkersHavePhysicalBounds()
+        {
+            var assets = SitePresentationBuilder.BuildAssets();
+            foreach (var item in assets.machines)
+            {
+                var instance = Object.Instantiate(item.prefab);
+                try
+                {
+                    var bounds = SiteModelBuilder.Bounds(instance);
+                    var target = SiteModelBuilder.MachineSize(item.crew, item.plate);
+                    Assert.That(bounds.size.x, Is.EqualTo(target.x).Within(target.x * 0.1f), item.crew + "/" + item.plate + " length");
+                    var cab = instance.GetComponentsInChildren<Renderer>(true).Where(r => r.name.IndexOf("cab", StringComparison.OrdinalIgnoreCase) >= 0).ToArray();
+                    var roof = cab.Length > 0 ? cab.Max(r => r.bounds.max.y) - bounds.min.y : bounds.size.y;
+                    Assert.That(roof, Is.EqualTo(target.y).Within(target.y * 0.1f), item.crew + "/" + item.plate + " roof");
+                    Assert.That(bounds.min.y, Is.EqualTo(0).Within(0.05f));
+                }
+                finally { Object.DestroyImmediate(instance); }
+            }
+            foreach (var item in new[] { (assets.worker, new Vector3(0, 1.8f, 0)), (assets.pipe, new Vector3(6, 0.3f, 0.3f)) })
+            {
+                var instance = Object.Instantiate(item.Item1);
+                try
+                {
+                    var bounds = SiteModelBuilder.Bounds(instance);
+                    for (var axis = 0; axis < 3; axis++) if (item.Item2[axis] > 0)
+                        Assert.That(bounds.size[axis], Is.EqualTo(item.Item2[axis]).Within(item.Item2[axis] * 0.1f));
+                    Assert.That(bounds.min.y, Is.EqualTo(0).Within(0.05f));
+                }
+                finally { Object.DestroyImmediate(instance); }
+            }
+        }
+        [TestCase(0, 0, 0, 8, -4)]
+        [TestCase(1000, 500, 250, 18, -13)]
+        [TestCase(3000, 1500, 0, 30, -30)]
+        public void SlotsFollowRealGapsAndCap(double exc, double pipe, double back, float right, float left)
+        {
+            Assert.That(StageLayout.Slot("exc", exc, pipe, back), Is.EqualTo(right));
+            Assert.That(StageLayout.Slot("pipe", exc, pipe, back), Is.Zero);
+            Assert.That(StageLayout.Slot("back", exc, pipe, back), Is.EqualTo(left));
+        }
+        [Test]
+        public void BuilderAndRuntimeObjectsRestOnTheSameTerrain()
+        {
+            var scene = PlaySceneBuilder.Build(false);
+            var site = scene.GetRootGameObjects().Single(r => r.name == "[LOBOver] Site");
+            var world = site.GetComponentInChildren<SiteWorld>(true);
+            var job = JObject.Parse(File.ReadAllText("Data/Scenarios/slice_texas.json"));
+            var recorded = JObject.Parse(File.ReadAllText("Data/transcripts/slice_play.json"));
+            world.Configure((JObject)job["job"], 0);
+            foreach (var day in new[] { 1, 4, 5, 9, 16 })
+            {
+                world.Apply(SiteView.From((JObject)recorded["snapshots"][day]["site"]), day + 1);
+                foreach (var id in WorldUnits.CrewIds) world.Crew(id).SnapPose();
+                world.stage.Refresh();
+                var objects = site.GetComponentsInChildren<GroundedObject>(true);
+                Assert.That(objects.Length, Is.GreaterThan(50), "Grounding covers machines, workers, piles, roadside props, cabin and trees");
+                foreach (var item in objects) Assert.That(item.Clearance, Is.EqualTo(0).Within(0.05f), day + ": " + item.name);
+                foreach (var crew in site.GetComponentsInChildren<CrewRig>(true))
+                {
+                    Assert.That(crew.Machine.GetComponent<GroundedObject>(), Is.Not.Null);
+                    Assert.That(crew.Foreman.GetComponent<GroundedObject>(), Is.Not.Null);
+                    var position = crew.transform.localPosition;
+                    Assert.That(position.z, Is.LessThan(-WorldUnits.TrenchWidth / 2), "Machine on far bank");
+                }
+            }
+            foreach (var vertex in world.assets.groundMesh.vertices)
+                Assert.That(vertex.y, Is.EqualTo(SiteGround.GroundHeight(vertex.x, vertex.z)).Within(0.0001f));
+            Assert.That(world.assets.groundMesh.bounds.min.x, Is.LessThanOrEqualTo(-120));
+            Assert.That(world.assets.groundMesh.bounds.max.x, Is.GreaterThanOrEqualTo(120));
+        }
+        [Test]
+        public void OneSiteButtonAndLogHaveSpecifiedDimensionsAndGrabComponents()
+        {
+            var scene = PlaySceneBuilder.Build(false);
+            var hub = scene.GetRootGameObjects().SelectMany(r => r.GetComponentsInChildren<HubPanel>(true)).Single();
+            var buttons = hub.panel.GetComponentsInChildren<CrewButton>(true);
+            Assert.That(buttons.Length, Is.EqualTo(1)); Assert.That(buttons[0].goToSite, Is.True); Assert.That(buttons[0].crew, Is.Empty);
+            Assert.That(buttons[0].GetComponentInChildren<TMPro.TMP_Text>().text, Is.EqualTo("Go to the site"));
+            var log = hub.GetComponent<SpeechLog>();
+            Assert.That(log.panel.GetComponent<Grabbable>().MaxGrabPoints, Is.EqualTo(1));
+            Assert.That(log.panel.GetComponent<HandGrabInteractable>(), Is.Not.Null);
+            Assert.That(log.panel.GetComponent<GrabInteractable>(), Is.Not.Null);
+            Assert.That(log.panel.GetComponent<GrabFreeTransformer>(), Is.Not.Null);
+            Assert.That(log.panel.GetComponent<Rigidbody>().isKinematic, Is.True);
+            Assert.That(log.panel.Find("OpaqueCard").localScale, Is.EqualTo(new Vector3(0.5f, 0.35f, 0.01f)));
+            Assert.That(log.panel.GetComponentInChildren<PointableCanvas>(true), Is.Not.Null);
+            var cap = log.history.fontSize * log.history.font.faceInfo.capLine / log.history.font.faceInfo.pointSize * 0.001f;
+            Assert.That(cap, Is.GreaterThanOrEqualTo(0.015f - 0.00001f));
+            Assert.That(SiteDayCycle.BrightnessAt(0.85f), Is.EqualTo(1));
+            Assert.That(SiteDayCycle.BrightnessAt(1), Is.EqualTo(0.25f));
+        }
+    }
+}
diff --git a/Assets/LOBOver/Tests/PlayMode/StageHostTests.cs b/Assets/LOBOver/Tests/PlayMode/StageHostTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e17d888482fe19b57f62578ff14622ad6c1d9f06
--- /dev/null
+++ b/Assets/LOBOver/Tests/PlayMode/StageHostTests.cs
@@ -0,0 +1,178 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using LOBOver.Client;
+using LOBOver.Play;
+using LOBOver.World;
+using LOBOver.XR;
+using Newtonsoft.Json.Linq;
+using NUnit.Framework;
+using Oculus.Interaction;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.TestTools;
+using Object = UnityEngine.Object;
+
+namespace LOBOver.Tests
+{
+    public sealed class StageHostTests
+    {
+        private HostConnection connection;
+        private WarpController warp;
+        private PlayPreview preview;
+        private AudioClip clip;
+        private readonly List<JObject> commands = new List<JObject>();
+        [UnitySetUp]
+        public IEnumerator Setup()
+        {
+#if UNITY_EDITOR
+            yield return Level1HostTests.Control("reset");
+            HostConnection.TestEndpointOverride = "ws://127.0.0.1:7333/ws";
+            SceneManager.sceneLoaded += SetHead;
+            yield return UnityEditor.SceneManagement.EditorSceneManager.LoadSceneInPlayMode("Assets/Scenes/Play.unity", new LoadSceneParameters(LoadSceneMode.Single));
+            SceneManager.sceneLoaded -= SetHead; HostConnection.TestEndpointOverride = null;
+            connection = Object.FindFirstObjectByType<HostConnection>(); warp = Object.FindFirstObjectByType<WarpController>();
+            preview = Object.FindFirstObjectByType<PlayPreview>();
+            connection.CommandSent += commands.Add;
+            clip = AudioClip.Create("L8 speech test", 24000, 1, 24000, false);
+            Object.FindFirstObjectByType<HostVoice>().ClipOverride = _ => clip;
+            yield return Until(() => connection.Connected && connection.View != null && Object.FindFirstObjectByType<HubPanel>().Placed, 10);
+#else
+            Assert.Ignore("WO-L8 requires the orchestrator's Editor and loopback test host."); yield break;
+#endif
+        }
+        private static void SetHead(Scene scene, LoadSceneMode mode)
+        {
+            var rig = XRRig.Components<OVRCameraRig>(scene).Single(); rig.enabled = false;
+            rig.centerEyeAnchor.SetPositionAndRotation(new Vector3(0.8f, 1.65f, -0.4f), Quaternion.Euler(0, 23, 0));
+        }
+        private static IEnumerator Until(Func<bool> condition, float seconds)
+        {
+            var end = Time.realtimeSinceStartup + seconds;
+            while (!condition() && Time.realtimeSinceStartup < end) yield return null;
+            Assert.That(condition(), Is.True, "L8 timed out after " + seconds + " seconds");
+        }
+        private static void Press(Component button)
+        {
+            var ray = button.GetComponent<RayInteractable>();
+            var pose = new Pose(button.transform.position, button.transform.rotation);
+            ray.PublishPointerEvent(new PointerEvent(88, PointerEventType.Select, pose));
+            ray.PublishPointerEvent(new PointerEvent(88, PointerEventType.Unselect, pose));
+        }
+        [UnityTest]
+        public IEnumerator DayFiveStageSpeechLogAttentionAndDuskThroughTheHead()
+        {
+            var hub = Object.FindFirstObjectByType<HubPanel>();
+            var buttons = hub.panel.GetComponentsInChildren<CrewButton>();
+            Assert.That(buttons.Length, Is.EqualTo(1)); Assert.That(buttons[0].goToSite, Is.True); Assert.That(buttons[0].crew, Is.Empty);
+            Capture("hub");
+            yield return Level1HostTests.Control("day5");
+            yield return Until(() => connection.DisplayDay == 5, 3);
+            var head = warp.rig.CentreEye; var entryPosition = head.position; var entryRotation = head.rotation;
+            Press(buttons[0]); yield return Until(() => !warp.Busy && warp.InSite, 3);
+            Assert.That(head.position, Is.EqualTo(entryPosition)); Assert.That(head.rotation, Is.EqualTo(entryRotation));
+            Assert.That(warp.AttendedCrew, Is.EqualTo("pipe"));
+            var crews = warp.presenter.world;
+            var view = connection.View;
+            foreach (var id in WorldUnits.CrewIds)
+            {
+                var crew = crews.Crew(id);
+                var expected = StageLayout.Slot(id, view.crews.Single(c => c.id == "exc").stationFt,
+                    view.crews.Single(c => c.id == "pipe").stationFt, view.crews.Single(c => c.id == "back").stationFt);
+                var right = entryRotation * Vector3.right;
+                Assert.That(Vector3.Dot(crew.transform.position - entryPosition, right), Is.EqualTo(expected).Within(0.05f), id + " slot");
+                Assert.That(Vector3.Angle(entryRotation * Vector3.forward, Vector3.ProjectOnPlane(crew.transform.position - entryPosition, Vector3.up)), Is.LessThanOrEqualTo(60), id);
+                Assert.That(crew.Machine.GetComponent<GroundedObject>().Clearance, Is.EqualTo(0).Within(0.05));
+                Assert.That(crew.Foreman.GetComponent<GroundedObject>().Clearance, Is.EqualTo(0).Within(0.05));
+            }
+            var trench = warp.site.TransformPoint(Vector3.zero);
+            Assert.That(Vector3.Dot(trench - entryPosition, entryRotation * Vector3.forward), Is.EqualTo(6).Within(0.001));
+            Capture("site");
+            // Real travel completion uses the unchanged host clock, including while a crew is arguing.
+            yield return Level1HostTests.Control("resume");
+            yield return Until(() => commands.Any(c => (string)c["action"] == "dismount"), 3);
+            yield return Level1HostTests.Control("pause");
+            var log = Object.FindFirstObjectByType<SpeechLog>();
+            var before = log.Lines.Count;
+            yield return Level1HostTests.Control("exchange");
+            yield return Until(() => log.Lines.Count > before && log.BubbleCount > 0, 8);
+            Assert.That(log.Lines.Last().Text, Is.Not.Empty); Assert.That(log.BubbleCount, Is.LessThanOrEqualTo(2));
+            var bubble = log.transform.GetComponentsInChildren<Transform>().First(t => t.name.StartsWith("Speech_", StringComparison.Ordinal));
+            var speaker = crews.Crew(log.Lines.Last().Crew);
+            Assert.That(bubble.position.y - SiteGround.Bounds(speaker.Foreman).max.y, Is.EqualTo(0.4f).Within(0.05));
+            foreach (var crew in WorldUnits.CrewIds.Select(crews.Crew).Where(c => c.Status == "arguing"))
+            {
+                Assert.That(crew.Partner, Is.Not.Null);
+                var toPartner = crew.Partner.GetComponent<CrewRig>().Foreman.position - crew.Foreman.position;
+                Assert.That(Vector3.Dot(crew.Foreman.forward, toPartner.normalized), Is.GreaterThan(0.9));
+            }
+            Capture("argument");
+            Press(warp.wrist.GetComponentInChildren<LogButton>()); yield return null;
+            Assert.That(log.Open, Is.True);
+            Assert.That(Vector3.Distance(head.position, log.panel.position), Is.LessThanOrEqualTo(1.2));
+            Assert.That(Vector3.Dot(log.panel.forward, (log.panel.position - head.position).normalized), Is.GreaterThan(0.99));
+            Capture("log");
+            // Exercise the SDK transformer with pointer events: translation, rotation, release, no scale.
+            var grabbed = log.panel.GetComponent<Grabbable>(); var initial = new Pose(log.panel.position, log.panel.rotation);
+            grabbed.ProcessPointerEvent(new PointerEvent(91, PointerEventType.Select, initial)); yield return null;
+            var moved = new Pose(initial.position + Vector3.right * 0.1f, Quaternion.AngleAxis(15, Vector3.up) * initial.rotation);
+            grabbed.ProcessPointerEvent(new PointerEvent(91, PointerEventType.Move, moved)); yield return null;
+            grabbed.ProcessPointerEvent(new PointerEvent(91, PointerEventType.Unselect, moved)); yield return null;
+            Assert.That(Vector3.Distance(log.panel.position, initial.position), Is.GreaterThan(0.05f));
+            Assert.That(Quaternion.Angle(log.panel.rotation, initial.rotation), Is.GreaterThan(5));
+            Assert.That(log.panel.localScale, Is.EqualTo(Vector3.one));
+            var left = log.panel.position; log.Toggle(); log.Toggle(); Assert.That(log.panel.position, Is.EqualTo(left));
+            log.Toggle(); log.panel.position = head.position - head.forward * 3; log.Toggle();
+            Assert.That(Vector3.Distance(head.position, log.panel.position), Is.LessThanOrEqualTo(1.2)); log.Toggle();
+            var moves = commands.Count(c => (string)c["action"] == "moveTo");
+            var exc = crews.Crew("exc"); var station = exc.StationFt;
+            head.rotation = Quaternion.LookRotation(SiteGround.Bounds(exc.Machine.transform).center - head.position);
+            yield return Until(() => commands.Count(c => (string)c["action"] == "moveTo") > moves, 3);
+            yield return new WaitForSecondsRealtime(2.2f);
+            Assert.That(commands.Count(c => (string)c["action"] == "moveTo"), Is.EqualTo(moves + 1));
+            Assert.That((double)commands.Last(c => (string)c["action"] == "moveTo")["stationFt"], Is.EqualTo(station));
+            head.rotation = entryRotation;
+            var cycle = Object.FindFirstObjectByType<SiteDayCycle>();
+            yield return Level1HostTests.Control("resume");
+            yield return Until(() => cycle.Fraction >= 0.99f, 18);
+            Assert.That(cycle.sun.intensity / cycle.DaylightIntensity, Is.InRange(0.25, 0.32)); Capture("dusk");
+            var day = connection.DisplayDay;
+            yield return Until(() => connection.DisplayDay > day, 2);
+            yield return new WaitForSecondsRealtime(0.35f);
+            Assert.That(cycle.sun.intensity / cycle.DaylightIntensity, Is.EqualTo(1).Within(0.05));
+            Assert.That(cycle.caption.gameObject.activeSelf, Is.True); Assert.That(cycle.caption.text, Is.EqualTo("Day " + connection.DisplayDay));
+            yield return Level1HostTests.Control("pause");
+            LogAssert.NoUnexpectedReceived();
+        }
+        private void Capture(string name)
+        {
+#if UNITY_EDITOR
+            const string folder = "Monitor/out/unity";
+            Directory.CreateDirectory(folder); PlayPreview.EnsureRoom(folder + "/room.png");
+            var room = new Texture2D(2, 2, TextureFormat.RGBA32, false);
+            Texture2D frame = null, composite = null;
+            try
+            {
+                Assert.That(room.LoadImage(File.ReadAllBytes(folder + "/room.png")), Is.True);
+                frame = preview.CaptureFrame(); composite = PlayPreview.CompositeFrame(frame, room);
+                Assert.That(preview.view.transform.parent, Is.EqualTo(warp.rig.CentreEye));
+                Assert.That(preview.view.transform.localPosition, Is.EqualTo(Vector3.zero));
+                Assert.That(preview.view.transform.localRotation, Is.EqualTo(Quaternion.identity));
+                File.WriteAllBytes(folder + "/l8-" + name + "-raw.png", frame.EncodeToPNG());
+                File.WriteAllBytes(folder + "/l8-" + name + ".png", composite.EncodeToPNG());
+                File.WriteAllBytes(folder + "/l8-" + name + "-composite.png", composite.EncodeToPNG());
+            }
+            finally { Object.DestroyImmediate(room); if (frame != null) Object.DestroyImmediate(frame); if (composite != null) Object.DestroyImmediate(composite); }
+#endif
+        }
+        [TearDown]
+        public void Cleanup()
+        {
+            SceneManager.sceneLoaded -= SetHead; HostConnection.TestEndpointOverride = null;
+            if (connection != null) { connection.CommandSent -= commands.Add; connection.enabled = false; }
+            if (clip != null) Object.Destroy(clip); commands.Clear();
+        }
+    }
+}

