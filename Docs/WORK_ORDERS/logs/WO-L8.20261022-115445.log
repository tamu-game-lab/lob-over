using System.Collections.Generic;
using LOBOver.World;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class CrewAttention : MonoBehaviour
    {
        public WarpController warp;
        public HostWorldPresenter presenter;
        public Material ringMaterial;
        // WO-L8 items 4 and 8. The radius/width describe the thin ground marker, not game state.
        public const float DwellSeconds = 2, RevealSeconds = 0.6f, RingRadius = 2, RingWidth = 0.025f;
        public string Candidate { get; private set; }
        public float Dwell { get; private set; }
        private readonly Dictionary<CrewRig, LineRenderer> rings = new Dictionary<CrewRig, LineRenderer>();
        private readonly Dictionary<Renderer, float> reveals = new Dictionary<Renderer, float>();
        private readonly HashSet<Renderer> visible = new HashSet<Renderer>();
        private readonly MaterialPropertyBlock properties = new MaterialPropertyBlock();
        private void Update()
        {
            if (!warp.InSite || warp.Busy) { Candidate = null; Dwell = 0; return; }
            var head = warp.rig.ViewEye;
            var ray = new Ray(head.position, head.forward);
            CrewRig looking = null; var nearest = float.PositiveInfinity;
            foreach (var id in WorldUnits.CrewIds)
            {
                var crew = presenter.world.Crew(id);
                if (crew == null || !crew.gameObject.activeInHierarchy) continue;
                if (!rings.TryGetValue(crew, out var ring))
                {
                    ring = WorldDrawing.Line("Attention", crew.transform, ringMaterial, Color.white, RingWidth);
                    ring.positionCount = 49; ring.loop = true; ring.alignment = LineAlignment.View;
                    for (var i = 0; i < ring.positionCount; i++)
                    { var angle = i * Mathf.PI * 2 / (ring.positionCount - 1); ring.SetPosition(i, new Vector3(Mathf.Cos(angle) * RingRadius, 0.03f, Mathf.Sin(angle) * RingRadius)); }
                    rings[crew] = ring;
                }
                var colour = WorldUnits.CrewColours[System.Array.IndexOf(WorldUnits.CrewIds, id)];
                ring.GetPropertyBlock(properties);
                properties.SetColor("_BaseColor", colour * (id == warp.AttendedCrew ? 1 : 0.25f)); ring.SetPropertyBlock(properties);
                foreach (var renderer in crew.GetComponentsInChildren<Renderer>())
                {
                    if (renderer is ParticleSystemRenderer || renderer is LineRenderer || renderer.GetComponent<TMPro.TMP_Text>() != null) continue;
                    var worker = renderer.transform.IsChildOf(crew.Foreman) || HasWorkerAncestor(renderer.transform, crew.transform);
                    if (!worker && (crew.Machine == null || !renderer.transform.IsChildOf(crew.Machine.transform))) continue;
                    if (renderer.bounds.IntersectRay(ray, out var distance) && distance < nearest) { nearest = distance; looking = crew; }
                    var inView = Vector3.Angle(head.forward, renderer.bounds.center - head.position) < 60;
                    if (inView && visible.Add(renderer)) reveals[renderer] = warp.Progress == 1 ? Time.unscaledTime : Time.unscaledTime - RevealSeconds;
                    if (reveals.TryGetValue(renderer, out var start))
                    {
                        renderer.GetPropertyBlock(properties);
                        properties.SetFloat("_SpawnProgress", Mathf.Clamp01((Time.unscaledTime - start) / RevealSeconds));
                        renderer.SetPropertyBlock(properties);
                    }
                }
            }
            var candidate = looking == null ? null : looking.Id;
            if (candidate != Candidate) { Candidate = candidate; Dwell = 0; }
            if (Candidate == null || Candidate == warp.AttendedCrew) { Dwell = 0; return; }
            Dwell += Time.unscaledDeltaTime;
            if (Dwell >= DwellSeconds && warp.Attend(Candidate)) Dwell = 0;
        }
        private static bool HasWorkerAncestor(Transform item, Transform crew)
        {
            while (item != null && item != crew) { if (item.name == "Worker") return true; item = item.parent; }
            return false;
        }
        public void PrimeVisible()
        {
            visible.Clear(); reveals.Clear();
            // The entry wave already reveals these; only later arrivals need the local 0.6 s effect.
            foreach (var renderer in presenter.world.GetComponentsInChildren<Renderer>(true))
                {
                var crew = renderer.GetComponentInParent<CrewRig>();
                if (crew != null && crew.gameObject.activeSelf && Vector3.Angle(warp.rig.ViewEye.forward, renderer.bounds.center - warp.rig.ViewEye.position) < 60) visible.Add(renderer);
            }
        }
    }
}



