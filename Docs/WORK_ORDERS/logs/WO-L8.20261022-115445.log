            var evt = new PointerEvent(77, PointerEventType.Select, pose);
            if (poke) button.GetComponent<PokeInteractable>().PublishPointerEvent(evt);
            else button.GetComponent<RayInteractable>().PublishPointerEvent(evt);
        }
