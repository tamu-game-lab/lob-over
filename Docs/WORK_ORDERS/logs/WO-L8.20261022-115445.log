        private void SetWorkerTargets()
        {
            for (var i = 0; i < workers.Length; i++)
            {
                // WO-08: workers stand 2 metres behind the working edge on the road side.
                var goal = transform.parent.TransformPoint((staged ? new Vector3(transform.localPosition.x + 2, 0, -1.8f - i) : target + new Vector3(-2, 0, 2 + i)));
                if (i == 0 && Status == "arguing" && partner != null)
                {
                    var other = partner.GetComponent<CrewRig>();
                    var midpoint = (transform.localPosition + other.transform.localPosition) / 2;
                    if (staged) midpoint.z = -1.8f;
                    var side = string.CompareOrdinal(Id, other.Id) < 0 ? -1 : 1;
                    goal = transform.parent.TransformPoint(midpoint + new Vector3(side * 0.65f, 0, staged ? 0 : 3));
                }
                workerTargets[i] = goal;
            }
        }
        private void Update()
        {
            if (!positioned) return;
            if (assets.detailedSite && Time.unscaledTime >= nextDistanceCheck)
            {
                nextDistanceCheck = Time.unscaledTime + DistanceCheckSeconds;
                if (rig == null) rig = FindFirstObjectByType<XRRig>();
                if (rig != null) RefreshDistancePresentation(rig.ViewEye);
            }
            statusTime += Time.deltaTime;
            // A continuous target must not restart a tween on every frame. Four damping periods
            // settle a state change within the WO's half-second presentation interval.
            transform.localPosition = staged ? Vector3.MoveTowards(transform.localPosition, target, StageLayout.CrawlSpeed * Time.deltaTime)
                : Vector3.SmoothDamp(transform.localPosition, target, ref movementVelocity, WorldUnits.PoseSeconds / 4);
            SetWorkerTargets();
            for (var i = 0; i < workers.Length; i++)
            {
                workers[i].position = Vector3.SmoothDamp(workers[i].position, workerTargets[i], ref workerVelocities[i], WorldUnits.PoseSeconds / 4);
                var facing = Status == "held" ? transform.parent.forward : (staged ? -transform.parent.right : transform.parent.right);
                if (i == 0 && Status == "arguing" && partner != null)
                    facing = partner.GetComponent<CrewRig>().Foreman.position - workers[i].position;
                facing.y = 0;
                if (facing.sqrMagnitude > 0.001f) workers[i].rotation = Quaternion.LookRotation(facing);
            }
            if (assets.detailedSite) foreach (var item in GetComponentsInChildren<GroundedObject>()) item.Settle();
            ApplyAnimations();
        }
        public void RefreshDistancePresentation(Transform head)
        {
            if (head == null || assets == null || !assets.detailedSite) return;
            var distanceSquared = (transform.position - head.position).sqrMagnitude;
            var mode = distanceSquared <= ShadowMetres * ShadowMetres ? ShadowCastingMode.On : ShadowCastingMode.Off;
            shadowRenderers ??= GetComponentsInChildren<Renderer>(true);
            foreach (var renderer in shadowRenderers)
                if (renderer != null && !(renderer is ParticleSystemRenderer) && renderer.shadowCastingMode != mode) renderer.shadowCastingMode = mode;
            if (machineLod != null) machineLod.ForceLOD(distanceSquared <= MachineDetailMetres * MachineDetailMetres ? 0 : 1);
        }
