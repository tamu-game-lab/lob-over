using LOBOver.Client;
using LOBOver.World;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class HostWorldPresenter : MonoBehaviour
    {
        public HostConnection connection;
        public SiteWorld world;
        public bool Frozen { get; set; }
        private string configuredRun, configuredStage;
        private object appliedView;
        private void Update() => Present();
        public void Present()
        {
            if (Frozen || connection.View == null || connection.Job == null) return;
            if (world.CurrentView == null || configuredRun != connection.RunId || configuredStage != connection.ScenarioId)
            {
                // Geometry comes from the host's public Site project, never a local scenario/simulator.
                world.Configure(connection.Job, 0);
                configuredRun = connection.RunId; configuredStage = connection.ScenarioId;
                appliedView = null;
            }
            if (ReferenceEquals(appliedView, connection.View)) return;
            world.Apply(connection.View, connection.DisplayDay);
            foreach (var crew in connection.View.crews)
                if (connection.CrewPresence.TryGetValue(crew.id, out var present)) world.Crew(crew.id).gameObject.SetActive(present);
            appliedView = connection.View;
        }
    }
}
using System.Collections;
using System.Collections.Generic;
using LOBOver.Client;
using LOBOver.XR;
using TMPro;
using UnityEngine;
using UnityEngine.XR;

namespace LOBOver.Play
{
    public sealed class HubPanel : MonoBehaviour
    {
        public HostConnection connection;
        public XRRig rig;
        public WarpController warp;
        public Transform panel;
        public TextMeshPro status;
        public bool Placed { get; private set; }
        // WO-L2 hub dimensions and first-pose placement, in metres.
        public const float Width = 0.40f, Ahead = 0.55f, BelowEye = 0.15f;
        public const float TitleHeight = 0.025f, TextHeight = 0.015f;
        public const float ButtonWidth = 0.36f, ButtonHeight = 0.06f;
        private readonly List<XRInputSubsystem> inputs = new List<XRInputSubsystem>();
        private OVRDisplay display;
        private bool placementPending;
        private void OnEnable()
        {
            connection.Changed += Refresh;
            if (warp != null) warp.Changed += Refresh;
            SubsystemManager.GetSubsystems(inputs);
            foreach (var input in inputs) input.trackingOriginUpdated += TrackingOriginUpdated;
            placementPending = !Placed;
        }
        private IEnumerator Start()
        {
            panel.gameObject.SetActive(false);
            Refresh();
            while (!Placed) { TryPlace(); yield return null; }
        }
        private void Update()
        {
            if (display != OVRManager.display)
            {
                if (display != null) display.RecenteredPose -= Recenter;
                display = OVRManager.display;
                if (display != null) display.RecenteredPose += Recenter;
            }
            if (placementPending) TryPlace();
        }
        private void OnDisable()
        {
            connection.Changed -= Refresh;
            if (warp != null) warp.Changed -= Refresh;
            foreach (var input in inputs) input.trackingOriginUpdated -= TrackingOriginUpdated;
            if (display != null) display.RecenteredPose -= Recenter;
            display = null;
        }
        private void TrackingOriginUpdated(XRInputSubsystem ignored) => Recenter();
        public void Recenter() => placementPending = true;
        private void TryPlace()
        {
            if (rig == null || !rig.TryHeadPose(out var pose)) return;
            var forward = Vector3.ProjectOnPlane(pose.rotation * Vector3.forward, Vector3.up).normalized;
            if (forward.sqrMagnitude < 0.1f) forward = Vector3.forward;
            var position = pose.position + forward * Ahead - Vector3.up * BelowEye;
            panel.SetPositionAndRotation(position, Quaternion.LookRotation(position - pose.position));
            panel.gameObject.SetActive(true); Placed = true; placementPending = false;
        }
        private void Refresh()
        {
            status.text = warp != null && warp.Busy ? "Warping..."
                : !connection.Connected ? "Looking for the game. Start it on the PC with Play LOB Over."
                : !connection.Started ? "Connected to " + connection.Hostname + ". Waiting for Plan to press Start."
                : "Day " + connection.DisplayDay;
        }
    }
}
using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.Client;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using UnityEngine;
using UnityEngine.Networking;

namespace LOBOver.Play
{
    public sealed class HostVoice : MonoBehaviour
    {
        public HostConnection connection;
        public SiteWorld world;
        public WarpController warp;
        public AudioSource source;
        // Docs/LEVEL1 Voices and WO-L2 spatial sound distances.
        public const float TurnGapSeconds = 0.3f, ClearMetres = 40, SilentMetres = 120;
        public event Action<string, int, bool> TurnPlayback;
        public bool Playing => source != null && source.isPlaying;
        public Func<string, AudioClip> ClipOverride { private get; set; }
        private readonly Queue<Turn> turns = new Queue<Turn>();
        private Coroutine playback;
        private AudioClip ownedClip;
        private string run, scenario;
        private sealed class Turn { public string Stage, Line, Speaker; public int Number; }
        private void OnEnable() { connection.Message += Receive; connection.Changed += ConnectionChanged; }
        private void OnDisable() { connection.Message -= Receive; connection.Changed -= ConnectionChanged; Clear(); }
        private void ConnectionChanged()
        {
            if (!connection.Connected || run != connection.RunId || scenario != connection.ScenarioId) Clear();
            run = connection.RunId; scenario = connection.ScenarioId;
        }
        private void Clear()
        {
            if (playback != null) StopCoroutine(playback);
            playback = null; turns.Clear();
            if (source != null) { source.Stop(); source.clip = null; }
            if (ownedClip != null) { Destroy(ownedClip); ownedClip = null; }
        }
        private void Receive(JObject message)
        {
            if ((string)message["t"] != "voice" || !VoiceTurn.SafeId(connection.ScenarioId)) return;
            if (message["seats"] is JArray seats && !seats.Values<string>().Contains("site")) return;
            foreach (var turn in VoiceTurn.Read(message))
            {
                if (CrewId(turn.Speaker) == null) continue;
                turns.Enqueue(new Turn { Stage = connection.ScenarioId, Line = turn.LineId, Speaker = turn.Speaker, Number = turn.Number });
            }
            if (playback == null && turns.Count > 0) playback = StartCoroutine(Play());
        }
        private static string CrewId(string speaker)
        {
            switch (speaker)
            {
                case "foreman_exc": case "ray": case "Ray": return "exc";
                case "foreman_pipe": case "marcus": case "Marcus": return "pipe";
                case "foreman_back": case "dana": case "Dana": return "back";
                default: return null;
            }
        }
        private IEnumerator Play()
        {
            yield return null;
            while (turns.Count > 0)
            {
                var turn = turns.Dequeue();
                var relative = "Voice/" + turn.Stage + "/" + turn.Line + "_" + turn.Number + ".wav";
                AudioClip clip = ClipOverride?.Invoke(relative);
                var owned = clip == null;
                if (clip == null)
                {
                    var path = Application.streamingAssetsPath.TrimEnd('/') + "/" + relative;
                    var url = path.Contains("://") ? path : new Uri(path).AbsoluteUri;
                    using var request = UnityWebRequestMultimedia.GetAudioClip(url, AudioType.WAV);
                    yield return request.SendWebRequest();
                    if (request.result != UnityWebRequest.Result.Success)
                    { Debug.LogWarning("LOB Over voice clip: " + relative + ": " + request.error); continue; }
                    clip = DownloadHandlerAudioClip.GetContent(request);
                }
                if (owned) ownedClip = clip;
                source.clip = clip;
                Position(turn.Speaker); source.Play(); TurnPlayback?.Invoke(turn.Line, turn.Number, true);
                while (source.isPlaying) { Position(turn.Speaker); yield return null; }
                TurnPlayback?.Invoke(turn.Line, turn.Number, false); source.clip = null;
                if (owned) { Destroy(clip); ownedClip = null; }
                yield return new WaitForSecondsRealtime(TurnGapSeconds);
            }
            playback = null;
        }
        private void Position(string speaker)
        {
            var crew = world.Crew(CrewId(speaker));
            if (crew != null) source.transform.position = crew.Foreman.position;
            source.mute = crew == null || !warp.site.gameObject.activeInHierarchy;
        }
    }
}
using LOBOver.XR;
using Oculus.Interaction;
using UnityEngine;

namespace LOBOver.Play
{
    public sealed class CrewButton : MonoBehaviour
    {
        public WarpController warp;
        public string crew;
        public AudioSource click;
        public bool Available => warp != null && (string.IsNullOrEmpty(crew)
            ? warp.InSite || warp.Busy
            : !warp.Busy && !warp.InSite && warp.connection.Connected && !warp.connection.Mirror && warp.connection.View != null);
        private InteractionSurface surface;
        private Renderer face;
        private MaterialPropertyBlock tint;
        private Color normalColour;
        private void OnEnable()
        {
            surface = GetComponent<InteractionSurface>();
            if (surface != null) surface.Selected += Press;
            face = transform.Find("Face")?.GetComponent<Renderer>();
            if (face != null)
            {
                tint = new MaterialPropertyBlock();
                normalColour = face.sharedMaterial.GetColor("_BaseColor");
            }
        }
        private void OnDisable() { if (surface != null) surface.Selected -= Press; }
        private void Update()
        {
            var ray = GetComponent<RayInteractable>(); var poke = GetComponent<PokeInteractable>();
            if (ray != null) ray.enabled = Available;
            if (poke != null) poke.enabled = Available;
            if (face != null)
            {
                var grey = normalColour.grayscale;
                tint.SetColor("_BaseColor", warp != null && warp.Busy && !string.IsNullOrEmpty(crew)
                    ? new Color(grey, grey, grey, 1) : normalColour);
                face.SetPropertyBlock(tint);
            }
        }
        private void Press(Vector3 ignored)
        {
            if (!Available) return;
            var accepted = string.IsNullOrEmpty(crew) ? warp.Back() : warp.Visit(crew);
            if (accepted && click != null && click.clip != null) click.Play();
        }
    }
}

