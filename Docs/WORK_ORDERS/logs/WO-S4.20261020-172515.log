using System;
using System.Collections;
using System.IO;
using System.Linq;
using LOBOver.Sim;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using UnityEngine;
using Simulation = LOBOver.Sim.Sim;

namespace LOBOver.Runtime
{
    public sealed class Director : MonoBehaviour
    {
        public string scenarioId = "slice_texas";
        public SiteView SiteView { get; private set; }
        public PlanView PlanView { get; private set; }
        public JObject Job { get; private set; }
        public JObject MachineCatalog { get; private set; }
        public JArray Lines { get; private set; }
        public double DeadlineDay { get; private set; }
        public double TimeDays => simulation == null ? 0 : simulation.T;
        // Same day boundary as Common.DisplayDay; view snapshots use simulation time instead.
        public int DisplayDay => (int)Math.Floor(TimeDays + 1e-6) + 1;
        public string Speed => simulation == null ? "paused" : simulation.Speed;
        public bool Ready => simulation != null;
        public bool Done => simulation != null && simulation.Done;
        public string LoadError { get; private set; }
        public string TranscriptPath { get; private set; }
        public event Action Loaded;
        public event Action<SiteView, PlanView> ViewsChanged;
        public event Action<JObject> Message;
        public event Action<JObject> Event;
        public event Action<JObject> Voice;
        public event Action<JObject> Result;

        private Simulation simulation;
        private Scenario scenario;
        private Catalog catalog;
        private Autoplan autoplan;
        private Pacer pacer;
        private Coroutine loading;
        private double secondsFull, secondsSlow;
        private JObject transcript;
        private JArray snapshots, messages, commands;
        private int lastSnapshot = -1;
        private bool savedResult;

        private void OnEnable() { if (!Ready && loading == null) Load(scenarioId); }

        // Public Start is also Unity's lifecycle method. A slow Android load is started by OnEnable.
        public void Start()
        {
            if (simulation == null || simulation.Done) return;
            Apply("facilitator", new JObject { ["action"] = "start" });
            Publish();
        }
        public void Pause()
        {
            if (simulation == null) return;
            Apply("facilitator", new JObject { ["action"] = "pause" });
            Publish(); SaveTranscript();
        }
        public void Reset()
        {
            if (scenario == null) return;
            SaveTranscript(); Initialize();
        }
        public void Load(string id)
        {
            if (id != "slice_texas" && id != "stage1_texas" && id != "stage2_texas")
                throw new ArgumentException("Unknown scenario: " + id, nameof(id));
            SaveTranscript();
            if (loading != null) StopCoroutine(loading);
            pacer?.Close(); simulation = null; SiteView = null; PlanView = null;
            scenarioId = id; LoadError = null;
            loading = StartCoroutine(LoadFiles());
        }
        private IEnumerator LoadFiles()
        {
            // Let scene subscribers attach before File-backed Editor reads can finish.
            yield return null;
            string catalogText = null, scenarioText = null, scriptText = null;
            Action<string> failed = error => { LoadError = error; Debug.LogError(error, this); };
            yield return StreamingData.ReadText("Data/catalog.json", value => catalogText = value, failed);
            if (LoadError != null) yield break;
            yield return StreamingData.ReadText("Data/Scenarios/" + scenarioId + ".json", value => scenarioText = value, failed);
            if (LoadError != null) yield break;
            var script = scenarioId == "slice_texas" ? "slice_autoplan" : scenarioId == "stage1_texas" ? "stage1_pm_play" : "stage2_pull_play";
            yield return StreamingData.ReadText("Data/scripts/" + script + ".json", value => scriptText = value, failed);
            if (LoadError != null) yield break;
            try
            {
                var source = JObject.Parse(scenarioText);
                catalog = Catalog.Load(catalogText); scenario = Scenario.Load(scenarioText, catalog);
                Job = (JObject)source["job"].DeepClone();
                MachineCatalog = (JObject)JObject.Parse(catalogText)["machines"];
                Lines = (JArray)source["lines"].DeepClone();
                DeadlineDay = (double)source["plan"]["deadlineDay"];
                secondsFull = (double)source["time"]["secondsPerDayFull"];
                secondsSlow = (double)source["time"]["secondsPerDaySlow"];
                if (secondsFull <= 0 || secondsSlow <= 0) throw new InvalidDataException("Scenario day lengths must be positive");
                // Autoplan removes Site entries; the presenter retains every Site verb.
                autoplan = new Autoplan(JArray.Parse(scriptText));
                Initialize();
            }
            catch (Exception error) { failed(error.ToString()); }
            loading = null;
        }
        private void Initialize()
        {
            pacer?.Close(); simulation = Simulation.Create(scenario, catalog); autoplan.Reset();
            snapshots = new JArray(); messages = new JArray(); commands = new JArray();
            transcript = new JObject { ["scenario"] = scenarioId, ["snapshots"] = snapshots,
                ["messages"] = messages, ["commands"] = commands, ["result"] = null };
            TranscriptPath = Path.Combine(Application.persistentDataPath, "transcripts",
                scenarioId + "-" + DateTime.UtcNow.ToString("yyyyMMdd-HHmmss-fff") + ".json");
            lastSnapshot = -1; savedResult = false;
            pacer = new Pacer(() => simulation, AfterTick);
            Loaded?.Invoke();
            autoplan.Advance(simulation.T, Apply);
            Start();
            Drain(); CaptureDay();
        }
        private void Update()
        {
            if (simulation == null) return;
            // Pacer's 5/20-second day cadence is scaled to the scenario's full/slow seconds per day.
            var baselineMs = (Speed == "slow" ? Pacer.SLOW_MS : Pacer.FULL_MS) / Pacer.STEP_DAYS;
            var authoredMs = (Speed == "slow" ? secondsSlow : secondsFull) * 1000;
            pacer.Advance(UnityEngine.Time.unscaledDeltaTime * 1000 * baselineMs / authoredMs);
            Publish();
        }
        private void AfterTick()
        {
            autoplan.Advance(simulation.T, Apply); Drain(); CaptureDay();
            if (simulation.Done && !savedResult) { savedResult = true; SaveTranscript(); }
        }
        private void Apply(string seat, JObject command)
        {
            var reply = simulation.Apply(seat, command);
            commands.Add(new JObject { ["t"] = simulation.T, ["seat"] = seat, ["cmd"] = command.DeepClone() });
            var acknowledgement = JObject.FromObject(reply);
            acknowledgement["t"] = reply.Ok ? "ack" : "nack";
            acknowledgement["id"] = command["id"];
            messages.Add(new JObject { ["t"] = simulation.T, ["message"] = acknowledgement });
            // Only the initiating seat receives its rejection text.
            if (seat == "site") Message?.Invoke(acknowledgement);
            Drain();
        }
        public void Send(JObject command)
        {
            if (simulation == null || command == null) return;
            Apply("site", command); Publish();
        }
        public static bool ForSeat(JObject message, string seat) =>
            message["seats"] is JArray seats && seats.Any(value => (string)value == seat);
        private void Drain()
        {
            foreach (var message in simulation.Drain())
            {
                messages.Add(new JObject { ["t"] = message["day"] ?? new JValue(simulation.T), ["message"] = message.DeepClone() });
                Message?.Invoke(message);
                if ((string)message["t"] == "event") Event?.Invoke(message);
                if ((string)message["t"] == "voice") Voice?.Invoke(message);
                if ((string)message["t"] == "result") Result?.Invoke(message);
            }
        }
        private void Publish()
        {
            SiteView = SiteView.From(simulation.View("site"));
            PlanView = PlanView.From(simulation.View("plan"));
            ViewsChanged?.Invoke(SiteView, PlanView);
        }
        private void CaptureDay()
        {
            var day = (int)Math.Floor(simulation.T + 1e-6);
            if (day == lastSnapshot) return;
            snapshots.Add(simulation.View("facilitator")); lastSnapshot = day;
            SaveTranscript();
        }
        public void SaveTranscript()
        {
            if (transcript == null || simulation == null) return;
            transcript["result"] = simulation.Result;
            try
            {
                Directory.CreateDirectory(Path.GetDirectoryName(TranscriptPath));
                File.WriteAllText(TranscriptPath, transcript.ToString(Formatting.Indented));
            }
            catch (IOException error) { Debug.LogWarning("Transcript: " + error.Message, this); }
            catch (UnauthorizedAccessException error) { Debug.LogWarning("Transcript: " + error.Message, this); }
        }
        private void OnApplicationPause(bool paused) { if (paused) SaveTranscript(); }
        private void OnDisable()
        {
            SaveTranscript();
            if (loading != null) { StopCoroutine(loading); loading = null; }
        }
        private void OnDestroy() { pacer?.Close(); }
    }
}
using System;
using System.Collections;
using System.IO;
using UnityEngine;
using UnityEngine.Networking;

namespace LOBOver.Runtime
{
    public static class StreamingData
    {
        public static string Url(string relative)
        {
            var path = Application.streamingAssetsPath.TrimEnd('/') + "/" + relative;
            return path.Contains("://") ? path : new Uri(path).AbsoluteUri;
        }

        public static IEnumerator ReadText(string relative, Action<string> loaded, Action<string> failed)
        {
#if UNITY_ANDROID && !UNITY_EDITOR
            using (var request = UnityWebRequest.Get(Url(relative)))
            {
                yield return request.SendWebRequest();
                if (request.result == UnityWebRequest.Result.Success) loaded(request.downloadHandler.text);
                else failed(relative + ": " + request.error);
            }
#else
            string value;
            try { value = File.ReadAllText(Path.Combine(Application.streamingAssetsPath, relative)); }
            catch (Exception error) { failed(relative + ": " + error.Message); yield break; }
            loaded(value);
            yield break;
#endif
        }
    }
}
using System.Collections.Generic;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.Sim;
using Newtonsoft.Json.Linq;
using TMPro;
using UnityEngine;

namespace LOBOver.World
{
    public sealed class SiteWorld : MonoBehaviour
    {
        public Director director;
        public WorldAssets assets;
        public TrailerBoard trailerBoard;
        public PlanPanel planPanel;
        public JobSign jobSign;
        public SiteSky sky;
        public TextMeshPro gateText;
        public Transform truck;
        public SiteView CurrentView { get; private set; }
        public int CellCount => cells.Count;
        public int BoardCount => boards.Count;
        public int CrewCount => crews.Count;
        public double LengthFt { get; private set; }
        private readonly Dictionary<int, StationCell> cells = new Dictionary<int, StationCell>();
        private readonly Dictionary<int, Transform> stakes = new Dictionary<int, Transform>();
        private readonly Dictionary<int, ZoneBoard> boards = new Dictionary<int, ZoneBoard>();
        private readonly Dictionary<string, CrewRig> crews = new Dictionary<string, CrewRig>();
        private JArray zones;
        private Transform generated;
        public StationCell CellAt(int feet) => cells.TryGetValue(Mathf.FloorToInt(feet / WorldUnits.StationFeet) * (int)WorldUnits.StationFeet, out var cell) ? cell : null;
        public CrewRig Crew(string id) => crews.TryGetValue(id, out var crew) ? crew : null;
        public Transform StakeAt(int feet) => stakes.TryGetValue(feet, out var stake) ? stake : null;
        public ZoneBoard Board(int zone) => boards.TryGetValue(zone, out var board) ? board : null;
        public int ZoneAt(double feet) => (int)zones.OfType<JObject>().First(z => feet >= (double)z["fromFt"] && (feet < (double)z["toFt"] || feet == LengthFt))["id"];

        private void OnEnable()
        {
            if (director == null) return;
            director.Loaded += OnLoaded; director.ViewsChanged += OnViews; director.Result += OnResult;
            if (director.Ready) { OnLoaded(); if (director.SiteView != null) OnViews(director.SiteView, director.PlanView); }
        }
        private void OnDisable()
        {
            if (director == null) return;
            director.Loaded -= OnLoaded; director.ViewsChanged -= OnViews; director.Result -= OnResult;
        }
        private void OnLoaded() => Configure(director.Job, director.DeadlineDay);
        private void OnViews(SiteView site, PlanView plan)
        {
            Apply(site, director.DisplayDay); planPanel.Apply(plan, director.TimeDays);
        }
        private void OnResult(JObject value) => planPanel.ShowResult(value);
        public void Configure(JObject job, double deadline)
        {
            if (generated != null) WorldDrawing.Remove(generated.gameObject);
            generated = WorldDrawing.Group("GeneratedSite", transform).transform;
            cells.Clear(); stakes.Clear(); boards.Clear(); crews.Clear(); CurrentView = null;
            LengthFt = (double)job["lengthFt"]; zones = (JArray)job["zones"].DeepClone();
            jobSign.Apply((JObject)job["sign"]);
            var boundaries = zones.OfType<JObject>().ToDictionary(z => (int)z["id"], z => (double)z["fromFt"]);
            trailerBoard.Configure(assets, LengthFt, deadline, boundaries); planPanel.Configure(assets, LengthFt, deadline);
            if (sky.State != null) sky.Apply("clear"); else sky.Configure(assets);
        }
        public void Apply(SiteView view, int displayDay)
        {
            if (generated == null) throw new System.InvalidOperationException("Configure SiteWorld before applying a view");
            if (cells.Count == 0) Build(view);
            CurrentView = view;
            foreach (var cell in view.trench) if (cells.TryGetValue((int)cell.stationFt, out var target)) target.Apply(cell);
            foreach (var crew in view.crews) crews[crew.id].Apply(crew);
            var arguing = WorldUnits.CrewIds.Select(id => crews[id]).Where(crew => crew.Status == "arguing").ToArray();
            foreach (var crew in crews.Values) crew.FaceArgument(arguing.FirstOrDefault(other => other != crew && crew.Status == "arguing")?.transform);
            foreach (var board in view.boards) boards[(int)board.zone].Apply(board);
            sky.Apply(view.sky); gateText.text = "Trucks waiting: " + view.gate.trucksWaiting;
            truck.localPosition = new Vector3((float)view.truck.stationFt * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
            trailerBoard.Apply(view, displayDay);
        }
        private void Build(SiteView view)
        {
            foreach (var sample in view.trench)
            {
                // The endpoint is a stake, not an extra 100 ft of trench.
                if (sample.stationFt >= LengthFt) continue;
                var cell = Instantiate(assets.cellPrefab, generated); cell.Initialize(sample.stationFt, assets);
                cells[(int)sample.stationFt] = cell; stakes[(int)sample.stationFt] = cell.stake;
                var spoil = Instantiate(assets.spoil, generated); spoil.name = "Spoil_" + (int)sample.stationFt;
                spoil.transform.localPosition = new Vector3((float)sample.stationFt * WorldUnits.MetresPerFoot + WorldUnits.CellLength / 2, 0, -3);
            }
            var endpoint = WorldDrawing.Box("Stake_" + (int)LengthFt, generated, new Vector3((float)LengthFt * WorldUnits.MetresPerFoot, 0.55f, 1.2f), new Vector3(0.08f, 1.1f, 0.08f), assets.timber);
            var label = WorldDrawing.Text("Station", endpoint.transform, new Vector3(0, 0.6f, 0), new Vector2(1.5f, 0.4f), 0.3f, assets.font);
            // Text cannot inherit the thin post's scale.
            label.transform.SetParent(generated, true); label.transform.localScale = Vector3.one;
            label.transform.localPosition = endpoint.transform.localPosition + Vector3.up * 0.6f; label.transform.localRotation = Quaternion.Euler(0, 180, 0);
            label.text = WorldUnits.Station(LengthFt); stakes[(int)LengthFt] = endpoint.transform;
            foreach (var zone in zones.OfType<JObject>())
            {
                var root = WorldDrawing.Group("ZoneBoard", generated); root.transform.localPosition = new Vector3((float)zone["fromFt"] * WorldUnits.MetresPerFoot, 0, 1.8f);
                root.transform.localRotation = Quaternion.Euler(0, 180, 0);
                WorldDrawing.Box("Post", root.transform, new Vector3(0, 1, 0), new Vector3(0.1f, 2, 0.1f), assets.timber);
                var face = WorldDrawing.Box("Board", root.transform, new Vector3(0, 1.8f, 0), new Vector3(1, 1.5f, 0.06f), assets.steel);
                InspectTarget.Attach(face, "board"); var board = root.AddComponent<ZoneBoard>();
                board.label = WorldDrawing.Text("Permit", root.transform, new Vector3(0, 1.8f, -0.05f), new Vector2(0.9f, 1.3f), 0.12f, assets.font);
                board.Initialize((int)zone["id"]); boards[board.Zone] = board;
            }
            foreach (var id in WorldUnits.CrewIds)
            { var crew = Instantiate(assets.crewPrefab, generated); crew.Initialize(id, assets); crews[id] = crew; }
        }
    }
}
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.Sim;
using Newtonsoft.Json.Linq;
using UnityEngine;
using UnityEngine.InputSystem;
using UnityEngine.Networking;

namespace LOBOver.World
{
    public sealed class DesktopPreview : MonoBehaviour
    {
        public Director director;
        public SiteWorld world;
        public Camera previewCamera;
        public string LastInspection { get; private set; } = "";
        public string LastCard { get; private set; } = "";
        private string voiceText = "";
        private float voiceUntil;
        private double lastTruckStation;
        private bool lastDismounted, hasTruck;
        private readonly Queue<string> voiceQueue = new Queue<string>();
        private Coroutine voiceRoutine;
        private AudioSource voiceSource = null;
        private GUIStyle hud;
        // Preview-only camera controls, independent of the simulation clock.
        private const float FlyMetresPerSecond = 12, FastMultiplier = 4, LookDegreesPerPixel = 0.12f;

        private void OnEnable()
        {
#if UNITY_ANDROID && !UNITY_EDITOR
            gameObject.SetActive(false);
            return;
#else
            if (director == null) return;
            director.Message += OnMessage; director.Voice += OnVoice; director.Loaded += Clear;
            if (voiceSource == null) voiceSource = WorldDrawing.Sound(WorldDrawing.Group("VoiceAudio", transform), false);
#endif
        }
        private void OnDisable()
        {
            if (director != null) { director.Message -= OnMessage; director.Voice -= OnVoice; director.Loaded -= Clear; }
            Clear(); Cursor.lockState = CursorLockMode.None; Cursor.visible = true;
        }
        private void Clear()
        {
            LastInspection = ""; LastCard = ""; voiceText = ""; hasTruck = false; voiceQueue.Clear();
            if (voiceRoutine != null) StopCoroutine(voiceRoutine);
            voiceRoutine = null;
            if (voiceSource != null) { voiceSource.Stop(); if (voiceSource.clip != null) Destroy(voiceSource.clip); voiceSource.clip = null; }
        }
        private void Update()
        {
            var keyboard = Keyboard.current; var mouse = Mouse.current;
            if (keyboard == null || mouse == null) return;
            var flying = mouse.rightButton.isPressed;
            Cursor.lockState = flying ? CursorLockMode.Locked : CursorLockMode.None; Cursor.visible = !flying;
            if (flying)
            {
                var delta = mouse.delta.ReadValue() * LookDegreesPerPixel;
                var angles = previewCamera.transform.eulerAngles;
                var pitch = angles.x > 180 ? angles.x - 360 : angles.x;
                previewCamera.transform.rotation = Quaternion.Euler(Mathf.Clamp(pitch - delta.y, -85, 85), angles.y + delta.x, 0);
                var move = new Vector3((keyboard.dKey.isPressed ? 1 : 0) - (keyboard.aKey.isPressed ? 1 : 0), 0,
                    (keyboard.wKey.isPressed ? 1 : 0) - (keyboard.sKey.isPressed ? 1 : 0));
                previewCamera.transform.Translate(move * FlyMetresPerSecond * (keyboard.leftShiftKey.isPressed || keyboard.rightShiftKey.isPressed ? FastMultiplier : 1) * Time.unscaledDeltaTime);
            }
            if (!director.Ready) return;
            if (keyboard.spaceKey.wasPressedThisFrame) { if (director.Speed == "paused") director.Start(); else director.Pause(); }
            if (keyboard.rKey.wasPressedThisFrame) director.Reset();
            var view = director.SiteView;
            if (view == null) return;
            FollowTruck(view.truck);
            // RMB scopes WASD to flight so D/S cannot also issue Site commands.
            if (!flying)
            {
                if (keyboard.dKey.wasPressedThisFrame) Send(view.truck.dismounted ? "mount" : "dismount");
                if (keyboard.sKey.wasPressedThisFrame) director.Send(new JObject { ["action"] = "stopWork", ["zone"] = world.ZoneAt(view.truck.stationFt) });
            }
            var digits = new[] { Key.Digit1, Key.Digit2, Key.Digit3, Key.Digit4, Key.Digit5, Key.Digit6, Key.Digit7, Key.Digit8, Key.Digit9 };
            for (var i = 0; i < digits.Length; i++) if (keyboard[digits[i]].wasPressedThisFrame) Ride((i + 1) * WorldUnits.StationFeet);
            if (keyboard.leftBracketKey.wasPressedThisFrame) Ride((Mathf.Round((float)view.truck.stationFt / WorldUnits.StationFeet) - 1) * WorldUnits.StationFeet);
            if (keyboard.rightBracketKey.wasPressedThisFrame) Ride((Mathf.Round((float)view.truck.stationFt / WorldUnits.StationFeet) + 1) * WorldUnits.StationFeet);
            if (keyboard.iKey.wasPressedThisFrame) Inspect();
            if (keyboard.fKey.wasPressedThisFrame) director.Send(new JObject { ["action"] = "flag", ["stationFt"] = view.truck.stationFt, ["note"] = "" });
            if (keyboard.cKey.wasPressedThisFrame) Confirm("done");
            if (keyboard.nKey.wasPressedThisFrame) Confirm("notDone");
            if (keyboard.lKey.wasPressedThisFrame) Send("listen");
        }
        private void FollowTruck(TruckView truck)
        {
            if (truck.moving) return;
            if (hasTruck && (truck.stationFt != lastTruckStation || truck.dismounted != lastDismounted))
            {
                previewCamera.transform.position = world.transform.TransformPoint(new Vector3((float)truck.stationFt * WorldUnits.MetresPerFoot, 1.7f,
                    truck.dismounted ? WorldUnits.TrenchWidth / 2 + 1.5f : WorldUnits.RoadZ));
                previewCamera.transform.rotation = world.transform.rotation * Quaternion.Euler(12, 180, 0);
            }
            lastTruckStation = truck.stationFt; lastDismounted = truck.dismounted; hasTruck = true;
        }
        private void Ride(float station) => director.Send(new JObject { ["action"] = "moveTo", ["stationFt"] = Mathf.Clamp(station, 0, (float)world.LengthFt) });
        private void Send(string action) => director.Send(new JObject { ["action"] = action });
        private void Confirm(string outcome)
        {
            var order = director.SiteView.orders.FirstOrDefault(item => item.status == "landed");
            if (order == null) { LastInspection = "no order landed here"; return; }
            director.Send(new JObject { ["action"] = "confirm", ["orderId"] = order.id, ["outcome"] = outcome });
        }
        private void Inspect()
        {
            if (!Physics.Raycast(previewCamera.ViewportPointToRay(new Vector3(0.5f, 0.5f, 0)), out var hit, 6000, ~0, QueryTriggerInteraction.Collide)) return;
            var target = hit.collider.GetComponentInParent<InspectTarget>();
            if (target != null) director.Send(new JObject { ["action"] = "inspect", ["target"] = target.target });
        }
        private void OnMessage(JObject message)
        {
            var type = (string)message["t"];
            if (type == "nack") LastInspection = (string)message["reason"];
            if (!Director.ForSeat(message, "site")) return;
            if (type == "inspection") LastInspection = (string)message["text"];
            if (type == "event") LastCard = (string)message["card"]?["title"] + "\n" + string.Join("\n", message["card"]?["facts"]?.Values<string>() ?? Enumerable.Empty<string>());
        }
        private void OnVoice(JObject message)
        {
            if (!Director.ForSeat(message, "site")) return;
            foreach (var id in message["lineIds"].Values<string>()) voiceQueue.Enqueue(id);
            if (voiceRoutine == null) voiceRoutine = StartCoroutine(PlayVoice());
        }
        private IEnumerator PlayVoice()
        {
            yield return null;
            while (voiceQueue.Count > 0)
            {
                var id = voiceQueue.Dequeue(); var line = director.Lines.OfType<JObject>().FirstOrDefault(item => (string)item["id"] == id);
                if (line == null) continue;
                var speaker = (string)line["speaker"];
                var crew = speaker.StartsWith("foreman_") ? world.Crew(speaker.Substring("foreman_".Length)) : null;
                voiceSource.transform.position = crew == null ? previewCamera.transform.position : crew.transform.position;
                voiceSource.spatialBlend = crew == null ? 0 : 1;
                voiceText = (string)line["text"]; voiceUntil = Time.unscaledTime + 8;
                var relative = "Voice/" + director.scenarioId + "/" + id + ".wav";
#if !UNITY_ANDROID || UNITY_EDITOR
                if (!File.Exists(Path.Combine(Application.streamingAssetsPath, relative))) continue;
#endif
                using (var request = UnityWebRequestMultimedia.GetAudioClip(StreamingData.Url(relative), AudioType.WAV))
                {
                    yield return request.SendWebRequest();
                    if (request.result != UnityWebRequest.Result.Success) continue;
                    var clip = DownloadHandlerAudioClip.GetContent(request); voiceSource.clip = clip; voiceSource.Play();
                    voiceUntil = Time.unscaledTime + Mathf.Max(8, clip.length);
                    while (voiceSource.isPlaying) yield return null;
                    voiceSource.clip = null; Destroy(clip);
                }
            }
            voiceRoutine = null;
        }
        private void OnGUI()
        {
            if (hud == null) hud = new GUIStyle(GUI.skin.box) { alignment = TextAnchor.UpperLeft, fontSize = 16, wordWrap = true, padding = new RectOffset(12, 12, 10, 10) };
            var truck = director.SiteView?.truck;
            var text = director.LoadError ?? (director.Ready ? "Day " + director.DisplayDay + "  Â·  " + director.Speed + "\nTruck " + WorldUnits.Station(truck.stationFt)
                + (truck.moving ? " driving" : truck.dismounted ? " dismounted" : " mounted") : "Loading site");
            text += "\n" + LastInspection + "\n" + LastCard;
            if (Time.unscaledTime < voiceUntil) text += "\n" + voiceText;
            text += "\nRMB + WASD fly Â· Shift fast Â· 1â€“9 / [ ] ride\nD mount/dismount Â· I inspect Â· F flag Â· S stop\nC confirm Â· N not carried out Â· L listen Â· Space pause Â· R reset";
            var width = Mathf.Min(520, Screen.width - 20);
            GUI.Box(new Rect(10, 10, width, hud.CalcHeight(new GUIContent(text), width)), text, hud);
            GUI.Label(new Rect(Screen.width / 2f - 6, Screen.height / 2f - 10, 20, 20), "+");
        }
    }
}

