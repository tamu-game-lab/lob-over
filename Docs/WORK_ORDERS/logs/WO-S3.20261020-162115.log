using System;
using System.Collections.Generic;
using System.Linq;
using Newtonsoft.Json;
using Newtonsoft.Json.Linq;
using static LOBOver.Sim.Common;
using static LOBOver.Sim.Json;

namespace LOBOver.Sim
{
    public sealed class ApplyResult
    {
        [JsonProperty("ok")] public bool Ok { get; }
        [JsonProperty("appliedDay", NullValueHandling = NullValueHandling.Ignore)] public double? AppliedDay { get; }
        [JsonProperty("reason", NullValueHandling = NullValueHandling.Ignore)] public string Reason { get; }
        internal ApplyResult(double day) { Ok = true; AppliedDay = day; }
        internal ApplyResult(string reason) { Reason = reason; }
    }

    public sealed class Sim
    {
        private State state;
        private readonly JObject source, fleet;
        private readonly bool pure;
        public double T => state.t;
        public string Speed => state.speed;
        public bool Done => state.done;
        public JObject Result => state.result.Copy();

        // WO-05a: alternatives to these authored switches are intentionally unsupported.
        private static readonly JObject SUPPORTED_RULES = O("orderLagShifts", 1, "heldCrewBills", true,
            "conflictRule", "crossWithinNextDay", "conflictBehaviour", "stopAndArgue", "unpermittedBoundary", "idleAndBill",
            "pumpHalvesRework", true, "likelihoodRollsApply", false);
        private const double SUPPORTED_SHIFTS_PER_DAY = 1;
        private const int TIME_DECIMALS = 10; // sim.js quantizes tick boundary arithmetic.

        private Sim(Scenario scenario, Catalog catalog, bool pure)
        {
            source = scenario.Data.Copy(); fleet = catalog.Data.Copy(); this.pure = pure;
            foreach (var rule in SUPPORTED_RULES.Properties())
            {
                var actual = source.Obj("rules").Get(rule.Name);
                if (pure && actual == null) continue;
                var matches = rule.Value.Type == JTokenType.Integer ? source.Obj("rules").Finite(rule.Name) && source.Obj("rules").N(rule.Name) == (double)rule.Value
                    : JToken.DeepEquals(actual, rule.Value);
                if (!matches) throw new ArgumentException("Unsupported rules." + rule.Name + ": expected " + rule.Value.ToString(Formatting.None)
                    + ", got " + (actual?.ToString(Formatting.None) ?? "undefined"));
            }
            var time = source.Obj("time");
            if (!(pure && time.Get("shiftsPerDay") == null) && (!time.Finite("shiftsPerDay") || time.N("shiftsPerDay") != SUPPORTED_SHIFTS_PER_DAY))
                throw new ArgumentException("Unsupported time.shiftsPerDay: expected 1, got " + (time.Get("shiftsPerDay")?.ToString(Formatting.None) ?? "undefined"));
            state = InitialState(source, fleet, pure);
        }
        public static Sim Create(Scenario scenario, Catalog catalog, bool pure = false)
        {
            if (scenario == null) throw new ArgumentNullException(nameof(scenario));
            if (catalog == null) throw new ArgumentNullException(nameof(catalog));
            return new Sim(scenario, catalog, pure);
        }
        private static State InitialState(JObject scenario, JObject catalog, bool pure)
        {
            var s = new State { scenario = scenario, catalog = catalog, pure = pure, rngState = new Rng(scenario.N("seed")).State,
                capFt = scenario.NullableN("capFt"), truck = O("stationFt", 0, "moving", false, "dismounted", false),
                events = scenario.Rows("events").Select(e => e.Copy()).ToList(), deviations = scenario.Rows("deviations").Select(d => d.Copy()).ToList() };
            foreach (var id in CREW_IDS)
            {
                var authored = scenario.Rows("crews").First(c => c.S("id") == id);
                var c = new Crew { id = id, name = authored.S("name"), machine = authored.S("machine"), startDay = authored.N("startDay"), locked = authored.B("locked"),
                    rate = s.Machine(authored.S("machine")).N("rateFtPerDay") };
                s.crews[id] = c;
                s.actualLines[id] = new List<JObject> { O("t", 0, "ft", 0) };
                s.reportedLines[id] = new List<JObject> { O("t", 0, "ft", 0) };
                s.plannedLines[id] = O("startDay", c.startDay, "rate", c.rate, "holds", new JArray(), "segments", new JArray(O("fromT", c.startDay - 1, "rate", c.rate)));
            }
            foreach (var z in s.Zones)
            {
                var key = State.ZoneKey(z);
                s.permits[key] = O("entered", pure || scenario.Obj("permits").S("heldBy") == "pm", "signed", false);
                var permit = scenario.Obj("permits").Rows("cards").FirstOrDefault(c => c.N("zone") == z.N("id"));
                if (permit != null) s.permits[key]["number"] = permit["number"];
                s.inspections[key] = O("cleared", pure || !scenario.Obj("inspections").B("required"), "reported", false);
                var inspection = scenario.Obj("inspections").Rows("cards").FirstOrDefault(c => c.N("zone") == z.N("id"));
                if (inspection != null) s.inspections[key]["number"] = inspection["number"];
            }
            if (!pure) { Voice(s, "stageStart", new[] { "plan", "site" }); Events.UpdateEvents(s); }
            Crews.RefreshCrews(s);
            return s;
        }
        private static void RecordActual(State s)
        {
            foreach (var id in CREW_IDS)
                if (s.actualLines[id].Last().N("t") != s.t) s.actualLines[id].Add(O("t", s.t, "ft", s.crews[id].pos));
        }
        private static void Report(State s)
        {
            var feet = new JObject();
            foreach (var id in CREW_IDS) feet[id] = Math.Floor(s.crews[id].pos + EPS);
            var notes = CREW_IDS.Select(id => s.crews[id].name + ": " + F(feet.N(id) - s.reportedLines[id].Last().N("ft")) + " ft today").ToArray();
            foreach (var id in CREW_IDS) s.reportedLines[id].Add(O("t", s.t, "ft", feet[id]));
            var item = O("day", s.t, "feetByCrew", feet, "spendUsd", s.spentUsd, "notes", notes);
            var inbox = item.Copy(); inbox["from"] = "Daily report"; inbox["subject"] = "Day " + F(s.t); s.inbox.Add(inbox);
            item["seats"] = new JArray("plan", "facilitator"); Emit(s, "report", item);
        }
        private static void Finish(State s)
        {
            var lost = s.pure ? null : s.spentUsd > s.Plan.N("budgetUsd") ? "budget" : s.t > s.Plan.N("deadlineDay") - 1 + EPS ? "deadline" : null;
            var complete = s.crews["back"].finishT != null && (s.pure || Permits.FinalInspectionEntered(s));
            if (lost == null && !complete) return;
            RecordActual(s);
            var idleDays = new JObject(); double idleCrewDays = 0;
            foreach (var id in CREW_IDS) { var idle = Math.Max(0, s.crews[id].onsite - s.crews[id].work); idleDays[id] = idle; idleCrewDays += idle; }
            s.done = true;
            var result = lost != null ? O("lost", lost) : O("finishDay", s.crews["back"].finishT);
            if (s.Plan.Has("promisedFinishDay")) result["promisedDay"] = s.Plan["promisedFinishDay"];
            if (s.Plan.Has("budgetUsd")) result["budgetUsd"] = s.Plan["budgetUsd"];
            result["spentUsd"] = s.spentUsd; result["crewCostUsd"] = s.crewCostUsd;
            result["idleDays"] = idleDays; result["idleCrewDays"] = idleCrewDays;
            result["peakOpenTrenchFt"] = s.peakOpenTrenchFt; result["finesUsd"] = s.finesUsd;
            result["deviationsCaught"] = s.deviations.Count(d => d.B("triggered") && d.B("caught"));
            result["deviationsMissed"] = s.deviations.Count(d => d.B("triggered") && !d.B("caught"));
            result["events"] = new JArray(s.events.Where(e => e.B("fired")).Select(e => O("id", e["id"], "day", e["firedT"], "option", e.Get("option"),
                "daysLost", e.S("type") == "A2" ? e.N("durationDays") * e.N("rateDrop") + e.N("reworkDays") : (e.N("resolvedT", s.t) - e.N("firedT")) * e.N("rateDrop"),
                "protection", e["protection"])));
            result["changeLog"] = Token(s.changeLog);
            result["lines"] = O("planned", Planning.PlannedPolylines(s), "actual", s.actualLines);
            s.result = result;
            if (!s.pure)
            {
                Voice(s, "stageEnd", new[] { "plan", "site" });
                var message = O("stage", s.scenario["id"]);
                foreach (var field in result.Properties()) message[field.Name] = field.Value.DeepClone();
                message["seats"] = new JArray("plan", "site", "facilitator"); Emit(s, "result", message);
            }
        }
        private static State TickState(State state, double dt)
        {
            if (state.done || state.speed == "paused") return state;
            var s = state.Draft();
            if (!s.pure) { Site.UpdateTruck(s); Orders.UpdateOrders(s); Events.UpdateEvents(s); }
            Crews.RefreshCrews(s);
            if (!s.pure) Conflict.DetectConflicts(s);
            Crews.MoveCrews(s, dt); Money.Accrue(s, dt);
            if (!s.pure) Crews.UpdateMood(s, dt);
            s.t = Math.Round(s.t + dt, TIME_DECIMALS, MidpointRounding.AwayFromZero);
            if (!s.pure)
            { Site.UpdateTruck(s); Orders.UpdateOrders(s); Permits.UpdateHoldPoints(s); Events.UpdateEvents(s); Crews.RefreshCrews(s); }
            if (Math.Floor(s.t + EPS) > Math.Floor(state.t + EPS)) { RecordActual(s); if (!s.pure) Report(s); }
            Finish(s);
            return s;
        }
        private static (State State, string Reason) Commit(State state, JArray ops)
        {
            if (ops == null) return (null, "invalid commit");
            var conflictReason = Conflict.ValidateConflictCommit(state, ops);
            if (conflictReason != null) return (null, conflictReason);
            var s = state.Draft();
            foreach (var token in ops)
            {
                var op = token as JObject; var reason = Orders.ValidateOp(s, op);
                if (reason != null) return (null, reason);
                Orders.IssueOrder(s, op);
            }
            Conflict.ResolveConflicts(s);
            foreach (var id in CREW_IDS)
                if (s.crews[id].stop != null && !ops.Any(op => (op.S("op") == "hold" || op.S("op") == "resume") && op.S("crew") == id)
                    && !s.orders.Any(o => o.Obj("op").S("op") == "resume" && o.S("crew") == id && !o.Has("appliedT")))
                    Orders.IssueOrder(s, O("op", "resume", "crew", id));
            s.pendingStops.Clear(); Orders.UpdateOrders(s); Permits.UpdateHoldPoints(s);
            if (s.crews["back"].finishT == null && s.crews["back"].pos >= s.Length - EPS && Permits.FinalInspectionEntered(s)) s.crews["back"].finishT = s.t;
            Crews.RefreshCrews(s);
            var change = O("day", s.t, "ops", ops); if (ops.Count == 0) change["note"] = "no change"; s.changeLog.Add(change);
            if (s.speed == "paused") s.pausedSpeed = "full"; else s.speed = "full";
            Finish(s);
            return (s, null);
        }
        public void Tick(double dt = DT)
        {
            if (!double.IsFinite(dt) || dt <= 0) throw new ArgumentOutOfRangeException(nameof(dt), "dt must be positive");
            var remaining = dt;
            while (remaining > EPS && !state.done && state.speed != "paused")
            {
                var step = Math.Min(DT, remaining); state = TickState(state, step); remaining -= step;
            }
        }
        public ApplyResult Apply(string seat, JObject cmd)
        {
            if (cmd == null) return new ApplyResult("invalid command");
            var action = cmd.S("action");
            if (seat == "facilitator")
            {
                if (action == "load" && cmd.S("stage") != source.S("id")) return new ApplyResult("stage not loaded");
                if (action == "reset" || action == "load") state = InitialState(source, fleet, pure);
                else if (action == "pause")
                { state = state.Draft(); if (state.speed != "paused") state.pausedSpeed = state.speed; state.speed = "paused"; }
                else if (action == "start" || action == "resume") { state = state.Draft(); state.speed = state.pausedSpeed; }
                else return new ApplyResult("unknown control");
                return new ApplyResult(state.t);
            }
            if (state.done) return new ApplyResult("stage ended");
            if (seat == "plan" && action == "commit")
            {
                var result = Commit(state, cmd["ops"] as JArray);
                if (result.Reason != null)
                {
                    if (result.Reason == "not in the budget") { state = state.Draft(); Voice(state, "prepRefused", new[] { "plan" }); }
                    return new ApplyResult(result.Reason);
                }
                state = result.State;
            }
            else if (seat == "site")
            {
                var draft = state.Draft(); var reason = Site.ApplySite(draft, cmd);
                if (reason != null) return new ApplyResult(reason);
                state = draft;
            }
            else return new ApplyResult("action unavailable for seat");
            return new ApplyResult(state.t);
        }
        public JObject View(string seat) => Views.View(state, seat);
        public List<JObject> Drain()
        {
            var messages = state.messages.Select(m => m.Copy()).ToList();
            state.messages = new List<JObject>(); return messages;
        }
        public JObject Serialize() => JObject.FromObject(state);
    }
}
using System;
using System.Linq;
using Newtonsoft.Json.Linq;
using static LOBOver.Sim.Common;
using static LOBOver.Sim.Json;

namespace LOBOver.Sim
{
    internal static class Views
    {
        private static JToken Clean(JToken value)
        {
            if (value is JArray array) return new JArray(array.Select(Clean));
            if (value is JObject obj) return new JObject(obj.Properties().Where(p => !p.Name.StartsWith("_", StringComparison.Ordinal)).Select(p => new JProperty(p.Name, Clean(p.Value))));
            return value.DeepClone();
        }
        internal static double StakeAt(State s, double ft) => Math.Floor(ft / s.Job.N("stationEveryFt") + 0.5) * s.Job.N("stationEveryFt");
        private static bool CollapseHere(State s, double ft)
        {
            var e = ActiveCollapse(s); return e != null && StakeAt(s, e.N("stationFt")) == StakeAt(s, ft);
        }
        private static JObject GroundAt(State s, double ft) => s.scenario.Obj("ground").Rows("segments").FirstOrDefault(x => ft >= x.N("fromFt") && ft <= x.N("toFt"));
        internal static JObject TrenchAt(State s, double stationFt)
        {
            bool Passed(string id) => s.crews[id].pos > stationFt + EPS || s.crews[id].finishT != null;
            var state = !Passed("exc") ? "undug" : !Passed("pipe") ? "open" : !Passed("back") ? "piped" : "backfilled";
            var open = state == "open" || state == "piped"; var p = ProtectionAt(s, stationFt);
            return O("stationFt", stationFt, "state", state,
                "water", CollapseHere(s, stationFt) || open && Rain.RainOrRework(s) ? "standing" : open && GroundAt(s, stationFt).B("seepage") ? "seep" : "none",
                "wall", CollapseHere(s, stationFt) ? "slumped" : "sound", "protection", p != null ? p.S("kind").Replace("trench_", "") : "none", "pipeDamage", "none");
        }
        internal static string CrewText(State s, Crew c)
        {
            if (c == null) return "No machine within sight.";
            var text = "Working.";
            var leader = Leader(c.id) == null ? null : s.crews[Leader(c.id)];
            if (c.status == "demobilized") text = "Demobilized.";
            else if (c.status == "arguing")
            {
                var conflict = s.conflicts.FirstOrDefault(x => !x.B("resolved") && (x.S("trailing") == c.id || x.S("leader") == c.id));
                var other = conflict == null ? null : s.crews[conflict.S("trailing") == c.id ? conflict.S("leader") : conflict.S("trailing")];
                text = "Arguing with " + (other?.name ?? leader?.name ?? c.name) + ".";
            }
            else if (c.status == "stopped") text = "Stopped: stop-work.";
            else if (c.status == "held") text = "Held by the office since Day " + F(DisplayDay(c.hold.N("fromT"))) + ".";
            else if (c.status == "idle") text = "Idle, waiting on " + (leader?.name ?? c.name) + ".";
            return text + " " + MOODS[(int)c.mood];
        }
        internal static string InspectionText(State s, string target)
        {
            var ft = StakeAt(s, s.truck.N("stationFt")); var c = CrewAt(s); var p = ProtectionAt(s, ft);
            var zone = ZoneAt(s, ft); var segment = GroundAt(s, ft);
            if (target == "wall")
            {
                if (CollapseHere(s, ft)) return "Wall slumped into the trench.";
                if (s.crews["exc"].pos <= ft + EPS) return "Not excavated here yet.";
                return segment.Obj("indicator").S("wall") ?? s.scenario.Obj("ground").Obj("defaultIndicator").S("wall");
            }
            if (target == "water")
            {
                if (TrenchAt(s, ft).S("water") == "standing") return "Standing water in the trench bottom.";
                return segment.Obj("indicator").S("water") ?? s.scenario.Obj("ground").Obj("defaultIndicator").S("water");
            }
            if (target == "machine")
            {
                var machine = c == null ? null : s.Machine(c.machine);
                return machine == null ? "No machine within sight." : c.name + ": " + machine.S("label") + ", plate " + machine.S("sizeClass");
            }
            if (target == "protection") return p == null ? "No protection here." : s.catalog.Obj("protection").Obj(p.S("kind")).S("label") + " in place, " + F(p.N("fromFt")) + " to " + F(p.N("toFt"));
            if (target == "board")
            {
                var permit = s.permits[State.ZoneKey(zone)]; var inspection = s.inspections[State.ZoneKey(zone)];
                return "Zone " + F(zone.N("id")) + " board: " + (permit.B("entered") ? "permit " + permit.S("number") : "no permit posted")
                    + (inspection.B("cleared") ? "; inspection " + inspection.S("number") : "");
            }
            if (target == "sky") return Rain.Sky(s) == "rain" ? "Rain." : Rain.Sky(s) == "towersSouth" ? "Towers building to the south." : "Clear.";
            if (target == "ticket")
            {
                var delivery = s.deliveries.FirstOrDefault(d => !d.B("arrived"));
                return delivery == null ? "No truck at the gate." : "Delivery ticket: " + s.Machine(delivery.S("machine")).S("label") + ", due Day " + F(DisplayDay(delivery.N("arrivesT")));
            }
            if (target == "crew") return CrewText(s, c);
            if (target == "pipe") return s.crews["back"].pos > ft + EPS ? "Backfilled." : s.crews["pipe"].pos > ft + EPS ? "Pipe laid, open trench." : "No pipe here yet.";
            return null;
        }
        internal static JObject PublicOrder(JObject order) => O("id", order["id"], "op", order["op"], "crew", order["crew"], "issuedDay", order["issuedT"], "landsDay", order["landsT"], "status", order["status"]);
        internal static JObject PlanView(State s)
        {
            var machines = new JObject();
            foreach (var entry in s.catalog.Obj("machines").Properties().Where(p => !p.Name.StartsWith("_", StringComparison.Ordinal)))
            {
                var machine = (JObject)Clean(entry.Value);
                machine["leadDays"] = O("normal", entry.Value.Obj("leadDays").N("normal") + s.City.N("leadDelayDays"));
                machines[entry.Name] = machine;
            }
            var permits = new JArray(); var inspections = new JArray();
            foreach (var z in s.Zones)
            {
                var permit = s.permits[State.ZoneKey(z)];
                var item = O("zone", z["id"], "entered", permit["entered"]);
                if (permit.B("entered") && permit.Has("number")) item["number"] = permit["number"];
                permits.Add(item); inspections.Add(O("zone", z["id"], "cleared", s.inspections[State.ZoneKey(z)]["cleared"]));
            }
            var uncertainty = new JObject();
            foreach (var id in CREW_IDS)
            {
                var report = s.reportedLines[id].Last(); var line = s.plannedLines[id];
                var estimate = report.N("ft") + Planning.PlannedRate(line, s.t) * Math.Max(0, s.t - Math.Max(report.N("t"), line.N("startDay") - 1));
                var band = s.t <= report.N("t") + EPS ? 0 : s.Rules.N("uncertaintyBandFt");
                uncertainty[id] = O("estimateFt", Math.Min(s.Length, estimate), "fromFt", Math.Max(0, estimate - band), "toFt", Math.Min(s.Length, estimate + band), "asOfT", report["t"]);
            }
            return O("plannedLines", s.plannedLines,
                "responses", new JArray(Events.AvailableResponses(s).Select(r => O("key", r.Option["key"], "label", r.Option["label"], "cost", r.Option["cost"], "eventTitle", r.Event.Obj("card")["title"]))),
                "reportedLines", s.reportedLines, "budget", O("budgetUsd", s.Plan["budgetUsd"], "spentUsd", s.spentUsd, "committedUsd", s.spentUsd,
                    "deadlineDay", s.Plan["deadlineDay"], "promisedDay", s.Plan["promisedFinishDay"]),
                "inbox", s.inbox, "radioLog", new JArray(s.orders.Select(PublicOrder)), "catalog", O("machines", machines, "protection", Clean(s.catalog["protection"])),
                "permits", permits, "inspections", inspections, "flags", s.flags, "draft", new JArray(), "uncertainty", uncertainty, "pmLines", s.pmLines);
        }
        internal static JObject SiteView(State s)
        {
            var trench = new JArray();
            for (double ft = 0; ft <= s.Length; ft += s.Job.N("stationEveryFt")) trench.Add(TrenchAt(s, ft));
            var local = s.events.FirstOrDefault(e => e.B("fired") && !e.B("resolved") && (!e.Has("zone")
                || e.N("zone") == ZoneAt(s, s.truck.N("stationFt")).N("id", double.NaN) || e.B("inspected")));
            return O("truck", O("stationFt", s.truck["stationFt"], "moving", s.truck["moving"], "dismounted", s.truck["dismounted"]),
                "crews", new JArray(CREW_IDS.Select(id =>
                {
                    var c = s.crews[id]; var size = s.Machine(c.machine).S("sizeClass");
                    return O("id", id, "stationFt", c.pos, "status", c.status, "machinePlate", string.IsNullOrEmpty(size) ? null : char.ToUpperInvariant(size[0]) + size.Substring(1), "moodLevel", c.mood);
                })), "trench", trench,
                "boards", new JArray(s.Zones.Select(z => O("zone", z["id"], "permitNumber", s.permits[State.ZoneKey(z)].B("entered") ? s.permits[State.ZoneKey(z)].Get("number") : null,
                    "inspectionNumber", s.inspections[State.ZoneKey(z)].B("cleared") ? s.inspections[State.ZoneKey(z)].Get("number") : null))),
                "sky", Rain.Sky(s), "gate", O("trucksWaiting", s.deliveries.Count(d => !d.B("arrived"))),
                "activeEvent", local == null ? null : O("id", local["id"], "card", local["shownCard"]),
                "orders", new JArray(s.orders.Where(o => o.S("crew") != null && o.Has("landedT") && o.S("status") != "sent" && o.S("status") != "confirmed"
                    && Nearby(s, s.crews[o.S("crew")].pos)).Select(PublicOrder)));
        }
        internal static JObject View(State s, string seat)
        {
            if (seat == "plan") return PlanView(s);
            if (seat == "site") return SiteView(s);
            if (seat == "facilitator")
            {
                var state = JObject.FromObject(s); state.Remove("messages");
                state["deviations"] = new JArray(s.deviations.Select(d => { var result = d.Copy(); result["state"] = !d.B("triggered") ? "armed" : d.B("caught") ? "caught" : "missed"; return result; }));
                state["plan"] = PlanView(s); state["site"] = SiteView(s); return state;
            }
            throw new ArgumentException("unknown seat");
        }
    }
}
using System;
using System.Collections.Generic;
using System.Linq;
using Newtonsoft.Json.Linq;

namespace LOBOver.Sim
{
    public sealed class Autoplan
    {
        private readonly List<JObject> commands;
        private int index;
        public bool Enabled { get; private set; }
        public double? NextT => index < commands.Count ? commands[index].N("t") : (double?)null;
        public JObject Status => Json.O("enabled", Enabled, "nextT", NextT);
        public Autoplan(JArray script = null, bool? enabled = null)
        {
            script = script == null ? new JArray() : (JArray)script.DeepClone();
            Enabled = enabled ?? script.Count > 0;
            for (var i = 0; i < script.Count; i++)
            {
                var entry = script[i];
                if (!entry.Finite("t") || entry.N("t") < 0 || !new[] { "plan", "site", "facilitator" }.Contains(entry.S("seat"))
                    || entry.Obj("cmd").Get("action")?.Type != JTokenType.String) throw new ArgumentException("Invalid autoplan entry " + (i + 1));
            }
            // LINQ's stable sort preserves script order at equal times, like autoplan.js.
            commands = script.OfType<JObject>().Where(e => e.S("seat") != "site").OrderBy(e => e.N("t")).ToList();
        }
        public void SetEnabled(bool value) => Enabled = value;
        public void Reset() => index = 0;
        public void Advance(double time, Action<string, JObject> apply)
        {
            if (apply == null) throw new ArgumentNullException(nameof(apply));
            while (Enabled && index < commands.Count && commands[index].N("t") <= time + Common.EPS)
            { var entry = commands[index++]; apply(entry.S("seat"), entry.Obj("cmd").Copy()); }
        }
    }
}
using System;

namespace LOBOver.Sim
{
    /// <summary>The director supplies elapsed milliseconds; no timers or clocks enter the simulation.</summary>
    public sealed class Pacer
    {
        // Monitor/src/host/pacing.js, WO-03: cadence and bounded catch-up.
        public const double STEP_DAYS = 0.01, FULL_MS = 50, SLOW_MS = 200, FAST_MS = 2, STATE_MS = 250;
        public const int MAX_CATCH_UP_STEPS = 20;
        private readonly Func<Sim> getSim;
        private readonly Action afterTick;
        private Sim currentSim;
        private double? stepMs;
        private double remainderMs;
        private bool fast, closed;
        public Pacer(Func<Sim> getSim, Action afterTick = null)
        { this.getSim = getSim ?? throw new ArgumentNullException(nameof(getSim)); this.afterTick = afterTick ?? (() => { }); }
        private double? Interval(Sim sim) => closed || sim.Done || sim.Speed == "paused" ? (double?)null : fast ? FAST_MS : sim.Speed == "slow" ? SLOW_MS : FULL_MS;
        public void Sync()
        {
            var sim = getSim(); var nextMs = Interval(sim);
            if (!ReferenceEquals(sim, currentSim) || nextMs != stepMs)
            { currentSim = sim; stepMs = nextMs; remainderMs = 0; }
        }
        public void SetFast(bool value) { fast = value; Sync(); }
        public void Close() { closed = true; Sync(); }
        public int Advance(double elapsedMilliseconds)
        {
            if (!double.IsFinite(elapsedMilliseconds) || elapsedMilliseconds < 0) throw new ArgumentOutOfRangeException(nameof(elapsedMilliseconds));
            Sync();
            if (stepMs == null) return 0;
            var sim = currentSim; var interval = stepMs.Value;
            remainderMs += elapsedMilliseconds;
            var due = Math.Floor(remainderMs / interval);
            // Preserve only the fractional step after a stall, as pacing.js does.
            remainderMs -= due * interval;
            var ticks = 0;
            for (var i = 0; i < Math.Min(due, MAX_CATCH_UP_STEPS); i++)
            {
                sim.Tick(STEP_DAYS); ticks++; afterTick();
                if (!ReferenceEquals(getSim(), sim) || Interval(sim) != interval) break;
            }
            Sync();
            return ticks;
        }
    }
}

