        await page.locator('#lend-crew').selectOption(op.toCrew);
        await page.locator('#lend-days').fill(String(op.days)); await page.locator('#add-lend').click();
      } else if (op.op === 'hold') {
        await page.locator('#hold-crew').selectOption(op.crew);
