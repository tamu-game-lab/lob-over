      const root = manual ? MANUALS : voice ? VOICE : WEB;
      const path = resolve(root, manual ? `${manual[1]}/manual.${manual[2]}`
        : voice ? pathname.slice('/Voice/'.length) : `.${pathname === '/' ? '/plan.html' : pathname}`);
      const rel = relative(root, path);
