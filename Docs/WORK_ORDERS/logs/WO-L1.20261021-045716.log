// WO-02 crew order, precision, haul-road speed, proximity and mood conventions.
export const CREW_IDS = ['exc', 'pipe', 'back'];
export const LEADER = { pipe: 'exc', back: 'pipe' };
export const DT = 0.01;
export const EPS = 1e-6;
export const NEAR_FT = 100;
export const HAUL_FT_PER_HOUR = 1500;
export const HOURS_PER_DAY = 24;
export const MAX_MOOD = 3;
export const MOODS = ['calm', 'grumbling', 'angry', 'furious'];
// WO-02: conflicts look one day ahead; P1 durations round to half days.
export const CONFLICT_LOOKAHEAD_DAYS = 1;
export const CLEARING_DAY_STEP = 0.5;
export const travelDays = (a, b) => Math.abs(a - b) / HAUL_FT_PER_HOUR / HOURS_PER_DAY;
export const displayDay = t => Math.floor(t + EPS) + 1;
export const nextBoundary = t => Math.floor(t + EPS) + 1;
export const copy = value => JSON.parse(JSON.stringify(value));
export const zoneAt = (s, ft) => s.scenario.job.zones.find(z => ft >= z.fromFt
  && (ft < z.toFt || ft === s.scenario.job.lengthFt));
export const nearby = (s, ft) => s.truck.dismounted && !s.truck.moving
  && Math.abs(s.truck.stationFt - ft) <= NEAR_FT;
export const crewAt = s => CREW_IDS.map(id => s.crews[id])
  .filter(c => Math.abs(c.pos - s.truck.stationFt) <= NEAR_FT)
  .sort((a, b) => Math.abs(a.pos - s.truck.stationFt) - Math.abs(b.pos - s.truck.stationFt))[0];
export const protectionAt = (s, ft) => Number.isFinite(ft)
  ? s.protections.find(p => ft >= p.fromFt && ft <= p.toFt) : undefined;
export const activeCollapse = s => s.events.find(e => e.type === 'P1' && e.fired && !e.resolved);
export const emit = (s, type, fields) => s.messages.push({ t: type, v: 1, day: s.t, ...fields });

export function voice(s, trigger, seats, crewIds) {
  const lines = s.scenario.lines.filter(line => line.trigger === trigger
    && (!crewIds || crewIds.includes(line.speaker.replace('foreman_', ''))));
  if (!lines.length) return;
  emit(s, 'voice', { lineIds: lines.map(line => line.id), seats });
  s.pmLines.push(...lines.filter(line => line.speaker === 'pm').map(line => line.text));
}

// Reducers own this draft; source state and caller-owned scenario/catalog stay untouched.
// Histories are append-only, so copying their outer arrays avoids repeatedly cloning points.
export function draftState(s) {
  const { scenario, catalog, actualLines, plannedLines, inbox, changeLog, messages, ...dynamic } = s;
  return {
    ...structuredClone(dynamic), scenario, catalog,
    actualLines: Object.fromEntries(CREW_IDS.map(id => [id, [...actualLines[id]]])),
    plannedLines: copy(plannedLines), inbox: [...inbox], changeLog: [...changeLog], messages: [...messages],
  };
}
import { makeRng } from '../common/rng.js';
import { CREW_IDS, DT, EPS, copy, draftState, emit, voice } from './common.js';
import { refreshCrews, moveCrews, updateMood } from './crews.js';
import { detectConflicts, resolveConflicts, validateConflictCommit } from './conflict.js';
import { updateEvents } from './events.js';
import { accrue } from './money.js';
import { issueOrder, updateOrders, validateOp } from './orders.js';
import { finalInspectionEntered, updateHoldPoints } from './permits.js';
import { plannedPolylines } from './planning.js';
import { applySite, updateTruck } from './site.js';
import { view } from './views.js';

// WO-05a: these authored Texas switches have no alternative implementation.
const SUPPORTED_RULES = {
  orderLagShifts: 1, heldCrewBills: true, conflictRule: 'crossWithinNextDay',
  conflictBehaviour: 'stopAndArgue', unpermittedBoundary: 'idleAndBill',
  pumpHalvesRework: true, likelihoodRollsApply: false,
};
const SUPPORTED_SHIFTS_PER_DAY = 1; // Authored scenario time.shiftsPerDay.

function initialState(scenario, catalog, pure) {
  const crews = Object.fromEntries(CREW_IDS.map(id => {
    const crew = scenario.crews.find(c => c.id === id);
    return [id, { ...crew, pos: 0, work: 0, onsite: 0, finishT: null,
      rate: catalog.machines[crew.machine]?.rateFtPerDay ?? 0, mult: 0, status: 'idle',
      mood: 0, waitDays: 0, workingDays: 0, hold: null, stop: null, arguing: false, demobilized: false, lentAway: false }];
  }));
  const state = {
    scenario, catalog, pure, rngState: makeRng(scenario.seed).state(),
    t: 0, speed: 'full', pausedSpeed: 'full', done: false, result: null, crews,
    capFt: scenario.capFt ?? null, orders: [], nextOrderId: 1, loans: [], deliveries: [], payments: [],
    protections: [], events: copy(scenario.events ?? []), deviations: copy(scenario.deviations ?? []), conflicts: [], pendingStops: {},
    permits: Object.fromEntries(scenario.job.zones.map(z => [z.id, { entered: pure || scenario.permits.heldBy === 'pm',
      signed: false, number: scenario.permits.cards.find(c => c.zone === z.id)?.number }])),
    inspections: Object.fromEntries(scenario.job.zones.map(z => [z.id, { cleared: pure || !scenario.inspections.required,
      reported: false, number: scenario.inspections.cards.find(c => c.zone === z.id)?.number }])),
    truck: { stationFt: 0, moving: false, dismounted: false }, flags: [], inbox: [], inboxDelivered: [], pmLines: [],
    messages: [], changeLog: [], spentUsd: 0, crewCostUsd: 0, finesUsd: 0, peakOpenTrenchFt: 0,
    actualLines: Object.fromEntries(CREW_IDS.map(id => [id, [{ t: 0, ft: 0 }]])),
    plannedLines: Object.fromEntries(CREW_IDS.map(id => [id, { startDay: crews[id].startDay, rate: crews[id].rate, holds: [],
      segments: [{ fromT: crews[id].startDay - 1, rate: crews[id].rate }] }])),
    reportedLines: Object.fromEntries(CREW_IDS.map(id => [id, [{ t: 0, ft: 0 }]])),
  };
  if (!pure) { voice(state, 'stageStart', ['plan', 'site']); updateEvents(state); }
  refreshCrews(state);
  return state;
}

function recordActual(s) {
  for (const id of CREW_IDS) {
    if (s.actualLines[id].at(-1).t !== s.t) s.actualLines[id].push({ t: s.t, ft: s.crews[id].pos });
  }
}

function report(s) {
  const feetByCrew = Object.fromEntries(CREW_IDS.map(id => [id, Math.floor(s.crews[id].pos + EPS)]));
  const notes = CREW_IDS.map(id => `${s.crews[id].name}: ${feetByCrew[id] - s.reportedLines[id].at(-1).ft} ft today`);
  for (const id of CREW_IDS) s.reportedLines[id].push({ t: s.t, ft: feetByCrew[id] });
  const item = { day: s.t, feetByCrew, spendUsd: s.spentUsd, notes };
  s.inbox.push({ ...item, from: 'Daily report', subject: `Day ${s.t}` });
  emit(s, 'report', { ...item, seats: ['plan', 'facilitator'] });
}

function finish(s) {
  const lost = s.pure ? null : s.spentUsd > s.scenario.plan.budgetUsd ? 'budget'
    : s.t > s.scenario.plan.deadlineDay - 1 + EPS ? 'deadline' : null;
  const complete = s.crews.back.finishT != null && (s.pure || finalInspectionEntered(s));
  if (!lost && !complete) return;
  recordActual(s);
  const idleDays = Object.fromEntries(CREW_IDS.map(id => [id, Math.max(0, s.crews[id].onsite - s.crews[id].work)]));
  const planned = plannedPolylines(s);
  s.done = true;
  s.result = {
    ...(lost ? { lost } : { finishDay: s.crews.back.finishT }), promisedDay: s.scenario.plan.promisedFinishDay,
    budgetUsd: s.scenario.plan.budgetUsd, spentUsd: s.spentUsd, crewCostUsd: s.crewCostUsd,
    idleDays, idleCrewDays: CREW_IDS.reduce((total, id) => total + idleDays[id], 0),
    peakOpenTrenchFt: s.peakOpenTrenchFt, finesUsd: s.finesUsd,
    deviationsCaught: s.deviations.filter(d => d.triggered && d.caught).length,
    deviationsMissed: s.deviations.filter(d => d.triggered && !d.caught).length,
    events: s.events.filter(e => e.fired).map(e => ({ id: e.id, day: e.firedT, option: e.option ?? null,
      daysLost: e.type === 'A2' ? e.durationDays * e.rateDrop + (e.reworkDays ?? 0)
        : ((e.resolvedT ?? s.t) - e.firedT) * e.rateDrop, protection: e.protection })),
    changeLog: copy(s.changeLog), lines: { planned, actual: copy(s.actualLines) },
  };
  if (!s.pure) {
    voice(s, 'stageEnd', ['plan', 'site']);
    emit(s, 'result', { stage: s.scenario.id, ...s.result, seats: ['plan', 'site', 'facilitator'] });
  }
}

export function tickState(state, dt) {
  if (state.done || state.speed === 'paused') return state;
  const s = draftState(state);
  if (!s.pure) { updateTruck(s); updateOrders(s); updateEvents(s); }
  refreshCrews(s);
  if (!s.pure) detectConflicts(s);
  moveCrews(s, dt);
  accrue(s, dt);
  if (!s.pure) updateMood(s, dt);
  // Quantizing arithmetic noise preserves exact shift boundaries across JS engines.
  s.t = Number((s.t + dt).toFixed(10));
  if (!s.pure) {
    updateTruck(s); updateOrders(s); updateHoldPoints(s); updateEvents(s);
    refreshCrews(s);
  }
  if (Math.floor(s.t + EPS) > Math.floor(state.t + EPS)) {
    recordActual(s);
    if (!s.pure) report(s);
  }
  finish(s);
  return s;
}

function commit(state, ops) {
  if (!Array.isArray(ops)) return { reason: 'invalid commit' };
  const conflictReason = validateConflictCommit(state, ops);
  if (conflictReason) return { reason: conflictReason };
  const s = draftState(state);
  for (const op of ops) {
    const reason = validateOp(s, op);
    if (reason) return { reason };
    // Staging on the draft validates sequential office actions without any partial commit.
    issueOrder(s, op);
  }
  resolveConflicts(s);
  for (const id of CREW_IDS) {
    if (s.crews[id].stop && !ops.some(op => ['hold', 'resume'].includes(op.op) && op.crew === id)
      && !s.orders.some(order => order.op.op === 'resume' && order.crew === id && order.appliedT == null)) {
      issueOrder(s, { op: 'resume', crew: id });
    }
  }
  s.pendingStops = {};
  updateOrders(s);
  updateHoldPoints(s);
  if (s.crews.back.finishT == null && s.crews.back.pos >= s.scenario.job.lengthFt - EPS
    && finalInspectionEntered(s)) s.crews.back.finishT = s.t;
  refreshCrews(s);
  s.changeLog.push({ day: s.t, ops: copy(ops), ...(ops.length ? {} : { note: 'no change' }) });
  if (s.speed === 'paused') s.pausedSpeed = 'full'; else s.speed = 'full';
  finish(s);
  return { state: s };
}

export function createSim(scenario, catalog, { pure = false } = {}) {
  // The pure oracle omits full-model switches; explicitly changed values still fail.
  for (const [key, expected] of Object.entries(SUPPORTED_RULES)) {
    const actual = scenario.rules?.[key];
    if (!(pure && actual === undefined) && actual !== expected) {
      throw new Error(`Unsupported rules.${key}: expected ${JSON.stringify(expected)}, got ${JSON.stringify(actual)}`);
    }
  }
  const shifts = scenario.time?.shiftsPerDay;
  if (!(pure && shifts === undefined) && shifts !== SUPPORTED_SHIFTS_PER_DAY) {
    throw new Error(`Unsupported time.shiftsPerDay: expected ${SUPPORTED_SHIFTS_PER_DAY}, got ${JSON.stringify(shifts)}`);
  }
  // JSON copying also accepts the WO-01 loader's frozen scenario with derived functions.
  const source = copy(scenario), fleet = copy(catalog);
  let state = initialState(source, fleet, pure);
  return {
    get t() { return state.t; }, get speed() { return state.speed; },
    get done() { return state.done; }, get result() { return copy(state.result); },
    tick(dt = DT) {
      if (!Number.isFinite(dt) || dt <= 0) throw new RangeError('dt must be positive');
      let remaining = dt;
      while (remaining > EPS && !state.done && state.speed !== 'paused') {
        const step = Math.min(DT, remaining);
        state = tickState(state, step);
        remaining -= step;
      }
    },
    apply(seat, cmd) {
      if (!cmd || typeof cmd !== 'object') return { ok: false, reason: 'invalid command' };
      if (seat === 'facilitator') {
        if (cmd.action === 'load' && cmd.stage !== source.id) return { ok: false, reason: 'stage not loaded' };
        if (cmd.action === 'reset' || cmd.action === 'load') state = initialState(source, fleet, pure);
        else if (cmd.action === 'pause') {
          state = draftState(state);
          if (state.speed !== 'paused') state.pausedSpeed = state.speed;
          state.speed = 'paused';
        } else if (cmd.action === 'start' || cmd.action === 'resume') {
          state = draftState(state); state.speed = state.pausedSpeed;
        } else return { ok: false, reason: 'unknown control' };
        return { ok: true, appliedDay: state.t };
      }
      if (state.done) return { ok: false, reason: 'stage ended' };
      if (seat === 'plan' && cmd.action === 'commit') {
        const result = commit(state, cmd.ops);
        if (result.reason) {
          if (result.reason === 'not in the budget') {
            state = draftState(state); voice(state, 'prepRefused', ['plan']);
          }
          return { ok: false, reason: result.reason };
        }
        state = result.state;
      } else if (seat === 'site') {
        const draft = draftState(state), reason = applySite(draft, cmd);
        if (reason) return { ok: false, reason };
        state = draft;
      } else return { ok: false, reason: 'action unavailable for seat' };
      return { ok: true, appliedDay: state.t };
    },
    view: seat => view(state, seat),
    drain() { const messages = copy(state.messages); state = { ...state, messages: [] }; return messages; },
    serialize: () => copy(state),
  };
}
import { CREW_IDS, LEADER, EPS, MAX_MOOD, voice } from './common.js';
import { excavationLimit, backfillLimit, finalInspectionEntered } from './permits.js';
import { rainMultiplier, pipeReworking } from './rain.js';

const MOOD_RECOVERY_DAYS = 1; // WO-05a (a): mood falls only after a full day of work.

export function refreshCrews(s) {
  for (const id of CREW_IDS) {
    const c = s.crews[id];
    // WO-05a (f): the stop reaches an unstarted crew only on its scheduled day.
    if (s.pendingStops[id] && s.t >= c.startDay - 1 - EPS) {
      c.stop = s.pendingStops[id];
      delete s.pendingStops[id];
    }
    if (c.hold?.untilT != null && s.t >= c.hold.untilT - EPS) c.hold = null;
    if (c.remobT != null && s.t >= c.remobT - EPS) {
      c.demobilized = false;
      c.demobBillingEndsT = null;
      c.remobT = null;
    }
    c.rate = s.catalog.machines[c.machine]?.rateFtPerDay ?? 0;
    for (const loan of s.loans.filter(l => l.toCrew === id && l.phase === 'working' && !l.eventId)) {
      c.rate += s.catalog.machines[loan.machine].rateFtPerDay;
    }
    const held = c.hold && s.t >= c.hold.fromT - EPS;
    const stopped = c.stop && s.t >= c.stop.fromT - EPS;
    c.status = c.demobilized ? 'demobilized' : c.arguing ? 'arguing'
      : stopped ? 'stopped' : held ? 'held' : 'working';
    c.mult = 1;
    if (s.t < c.startDay - 1 - EPS || c.finishT != null) { c.mult = 0; c.status = 'idle'; }
    if (c.demobilized || c.arguing || stopped || held || c.lentAway || c.rate === 0) c.mult = 0;
    if (!s.pure) {
      c.mult *= rainMultiplier(s, id);
      for (const event of s.events.filter(e => e.fired && !e.resolved && e.type !== 'A2'
        && (e.hits === id || e.hits === 'all'))) c.mult *= 1 - event.rateDrop;
      if (id === 'pipe' && pipeReworking(s)) c.mult = 0;
    }
    if (!c.mult && c.status === 'working') c.status = 'idle';
    if (c.status === 'working' && c.idleReason && c.moved < EPS) c.status = 'idle';
  }
}

export function moveCrews(s, dt) {
  for (const id of CREW_IDS) {
    const c = s.crews[id];
    if (s.t < c.startDay - 1 - EPS || c.finishT != null) continue;
    const leader = LEADER[id] && s.crews[LEADER[id]];
    let limit = Math.min(s.scenario.job.lengthFt, leader?.pos ?? s.scenario.job.lengthFt);
    let desired = c.pos + c.rate * c.mult * dt;
    c.idleReason = null;
    if (s.pure && id === 'exc' && s.capFt != null) limit = Math.min(limit, s.crews.back.pos + s.capFt);
    if (!s.pure && id === 'exc') {
      const permitLimit = excavationLimit(s, c.mult > 0 ? desired : c.pos);
      limit = Math.min(limit, permitLimit);
      if (desired > permitLimit || c.pos >= permitLimit - EPS && permitLimit < s.scenario.job.lengthFt) c.idleReason = 'idleNoPermit';
    }
    if (!s.pure && id === 'back') {
      const holdPoint = backfillLimit(s);
      limit = Math.min(limit, holdPoint);
      if (desired > holdPoint || c.pos >= holdPoint - EPS && !finalInspectionEntered(s)) c.idleReason = 'idleHoldPoint';
    }
    desired = Math.max(c.pos, Math.min(desired, limit));
    const moved = desired - c.pos;
    if (moved > 0) c.work += moved / c.rate;
    c.pos = desired;
    c.moved = moved;
    if (leader && moved < c.rate * c.mult * dt - EPS && !c.idleReason) c.idleReason = 'leader';
    if (c.status === 'working' && moved < EPS) c.status = 'idle';
    if (c.pos >= s.scenario.job.lengthFt - EPS
      && (id !== 'back' || s.pure || finalInspectionEntered(s))) c.finishT = s.t + dt;
  }
  s.peakOpenTrenchFt = Math.max(s.peakOpenTrenchFt, s.crews.exc.pos - s.crews.back.pos);
}

export function updateMood(s, dt) {
  for (const id of CREW_IDS) {
    const c = s.crews[id];
    if (s.t < c.startDay - 1 - EPS) continue;
    const held = c.status === 'held' || c.status === 'stopped';
    const waiting = held || c.idleReason === 'leader';
    c.waitDays = waiting ? c.waitDays + dt : 0;
    const level = Math.min(MAX_MOOD, Math.floor((c.waitDays + EPS) / s.scenario.rules.moodStepDays));
    if (held && level > c.mood) {
      for (let mood = c.mood + 1; mood <= level; mood++) voice(s, `heldDay${mood}`, ['site'], [id]);
    }
    c.workingDays = c.status === 'working' && c.moved > EPS ? c.workingDays + dt : 0;
    c.mood = c.workingDays >= MOOD_RECOVERY_DAYS - EPS ? 0 : Math.max(c.mood, level);
  }
}
import { LEADER, EPS, CONFLICT_LOOKAHEAD_DAYS, emit, voice } from './common.js';

export function detectConflicts(s) {
  for (const [trailingId, leaderId] of Object.entries(LEADER)) {
    const trailing = s.crews[trailingId], leader = s.crews[leaderId];
    const key = `${trailingId}:${leaderId}`;
    // A completed leader has left the workfront; the job endpoint cannot be crossed.
    if (leader.finishT != null || s.conflicts.some(c => c.pair === key)
      || trailing.mult <= 0 || trailing.pos >= leader.pos - EPS) continue;
    if (trailing.pos + trailing.rate * trailing.mult * CONFLICT_LOOKAHEAD_DAYS
      <= leader.pos + leader.rate * leader.mult * CONFLICT_LOOKAHEAD_DAYS + EPS) continue;
    s.conflicts.push({ pair: key, trailing: trailingId, leader: leaderId, firedT: s.t, resolved: false });
    trailing.arguing = leader.arguing = true;
    trailing.mult = leader.mult = 0;
    trailing.status = leader.status = 'arguing';
    s.speed = 'slow';
    voice(s, 'conflict', ['site'], [trailingId, leaderId]);
    emit(s, 'event', { eventId: `conflict_${trailingId}_${leaderId}`, day: s.t,
      stationFt: trailing.pos, zone: null, seats: ['site'],
      card: { title: 'Crews stopped', facts: [`${trailing.name} and ${leader.name} foremen are arguing.`] } });
  }
}

export function validateConflictCommit(s, ops) {
  if (s.conflicts.some(c => !c.resolved && !ops.some(op => op?.crew === c.trailing
    && (op.op === 'hold' || op.op === 'demob')))) return 'conflict: hold or demobilize the trailing crew';
}

export function resolveConflicts(s) {
  for (const conflict of s.conflicts.filter(c => !c.resolved)) {
    conflict.resolved = true;
    conflict.resolvedT = s.t;
    // The trailing crew waits for its field order; only the leader resumes at commit.
    s.crews[conflict.leader].arguing = false;
  }
}

