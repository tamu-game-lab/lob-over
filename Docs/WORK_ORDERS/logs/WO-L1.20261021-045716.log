// Data/goldens/no_events.json _doc: finish/idle 0.1 day, cost $500, peak 10 ft.
const TOLERANCE = { days: 0.1, cost: 500, feet: 10 };
export function runGoldens(goldens, catalog) {
  return Object.entries(goldens.cases).map(([name, entry]) => {
    const scenario = {
      id: name, seed: 0, capFt: entry.input.capFt,
      job: { lengthFt: goldens.lengthFt, stationEveryFt: 100, zones: [{ id: 1, fromFt: 0, toFt: goldens.lengthFt }] },
      crews: CREW_IDS.map(id => ({ id, name: id, machine: entry.input.machines[id], startDay: entry.input.startDay[id] })),
      plan: {}, permits: { cards: [] }, inspections: { required: false, cards: [] },
      rules: { overheadRate: catalog.money.overheadRate }, events: [], deviations: [], inbox: [], lines: [],
    };
    const sim = createSim(scenario, catalog, { pure: true });
    // The oracle uses a 300-day guard; this is a harness limit, not a game rule.
    while (!sim.done && sim.t < 300) sim.tick(goldens.dt);
    const actual = sim.result, expected = entry.expected;
    const deltas = actual ? { finishDay: actual.finishDay - expected.finishDay,
      idleDays: Object.fromEntries(CREW_IDS.map(id => [id, actual.idleDays[id] - expected.idleDays[id]])),
      crewCostUsd: actual.crewCostUsd - expected.crewCostUsd, peakOpenTrenchFt: actual.peakOpenTrenchFt - expected.peakOpenTrenchFt } : null;
    const pass = !!deltas && Math.abs(deltas.finishDay) <= TOLERANCE.days
      && CREW_IDS.every(id => Math.abs(deltas.idleDays[id]) <= TOLERANCE.days)
      && Math.abs(deltas.crewCostUsd) <= TOLERANCE.cost && Math.abs(deltas.peakOpenTrenchFt) <= TOLERANCE.feet;
    return { name, pass, deltas };
  });
}

if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
  try {
    const results = runGoldens(JSON.parse(readFileSync(process.argv[2], 'utf8')), loadCatalog());
    for (const { name, pass, deltas } of results) console.log(`${pass ? 'PASS' : 'FAIL'} ${name} deltas=${JSON.stringify(deltas,
      (key, value) => typeof value === 'number' ? Number(value.toFixed(3)) : value)}`);
    process.exitCode = results.every(result => result.pass) ? 0 : 1;
  } catch (error) { console.error(error.message); process.exitCode = 1; }
}
const SEATS = new Set(['plan', 'site', 'rules', 'facilitator']);
export function createClients({ state, welcome, command, changed = () => {} }) {
  const clients = new Map(), connections = new Set();
  const send = (socket, message) => {
    socket.send(message);
  };
  const broadcast = () => {
    const views = new Map();
    for (const [socket, client] of clients) {
      if (!views.has(client.seat)) views.set(client.seat, state(client.seat));
      send(socket, views.get(client.seat));
    }
  };
  function attach(socket) {
    connections.add(socket);
    socket.onClose(() => { clients.delete(socket); connections.delete(socket); changed(); });
    socket.onMessage(message => {
      if (!message || message.v !== 1) return;
      if (message.t === 'hello') {
        if (!SEATS.has(message.seat) || clients.has(socket)) return;
        const mirror = [...clients.values()].some(c => c.seat === message.seat && !c.mirror);
        clients.set(socket, { seat: message.seat, mirror });
        send(socket, { t: 'welcome', v: 1, protocol: 1, seat: message.seat, mirror,
          stage: state(message.seat).stage, state: state(message.seat) });
        welcome(socket, message.seat, send);
        changed();
        return;
      }
      if (message.t !== 'cmd' && message.t !== 'ctrl') {
        console.warn('Unknown message type:', message.t);
        return;
      }
      const client = clients.get(socket);
      let reason;
      if (!client) reason = 'hello required';
      else if (client.mirror) reason = 'mirror';
      else if (message.t === 'ctrl' && client.seat !== 'facilitator'
        || message.t === 'cmd' && (message.seat !== client.seat || client.seat === 'facilitator')) {
        reason = 'action unavailable for seat';
      }
      if (reason) { send(socket, { t: 'nack', v: 1, id: message.id, reason }); return; }
      command(socket, client.seat, message, send);
    });
  }
  return {
    attach, broadcast,
    connected: () => [...new Set([...clients.values()].filter(c => !c.mirror).map(c => c.seat))],
    sendEach(makeMessage) {
      for (const [socket, client] of clients) {
        const message = makeMessage(client.seat);
        if (message) send(socket, message);
      }
    },
    deliver(message, requester) {
      for (const [socket, client] of clients) {
        if (message.t === 'inspection') {
          if (socket === requester) send(socket, message);
        } else {
          const seats = message.t === 'report' ? ['plan', 'facilitator']
            : message.t === 'result' ? message.seats ?? ['plan', 'site', 'facilitator'] : message.seats ?? [];
          if (seats.includes(client.seat)) send(socket, message);
        }
      }
    },
    close() { for (const socket of connections) socket.close(); connections.clear(); clients.clear(); },
  };
}
