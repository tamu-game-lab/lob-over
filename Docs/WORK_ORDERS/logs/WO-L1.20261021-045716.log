import { EPS, nearby, nextBoundary, protectionAt } from './common.js';

export function markFirstRadio(s, order) {
  const d = s.deviations.find(d => d.type === 'F1' && !d.triggered
    && d.when.ops.includes(order.op.op) && order.landsT > order.issuedT);
  if (d) {
    d.triggered = true;
    d.orderId = order.id;
    order.ignored = true;
  }
}

export function confirmDeviation(s, order, outcome) {
  const d = s.deviations.find(d => d.type === 'F1' && d.orderId === order.id);
  if (d && outcome === 'notDone' && s.t < nextBoundary(order.landedT) - EPS) d.caught = true;
}

export function boundaryAllowance(s, zone) {
  // WO-05a O10: F2 requires crossing from another zone, not starting the job.
  if (!s.scenario.job.zones.some(previous => previous.toFt === zone.fromFt)) return zone.fromFt;
  const d = s.deviations.find(d => d.type === 'F2');
  if (!d) return zone.fromFt;
  if (d.triggered) return d.zone === zone.id && !d.caught ? zone.fromFt + d.overshootFt : zone.fromFt;
  d.triggered = true;
  d.zone = zone.id;
  d.caught = nearby(s, zone.fromFt) || !!s.crews.exc.hold || !!s.crews.exc.stop;
  if (!d.caught) {
    s.finesUsd += s.scenario.rules.permitFineUsd;
    s.spentUsd += s.scenario.rules.permitFineUsd;
  }
  return d.caught ? zone.fromFt : zone.fromFt + d.overshootFt;
}

export function inspectProtection(s, stationFt) {
  const p = protectionAt(s, stationFt);
  if (!p) return;
  for (const d of s.deviations.filter(d => d.type === 'F3')) {
    const e = s.events.find(e => e.id === d.when.eventId);
    if (!e?.fired && !(e.stationFt >= p.fromFt && e.stationFt <= p.toFt)) d.inspected = true;
  }
}

export function eventDeviations(s, event) {
  for (const d of s.deviations.filter(d => d.type === 'F3' && d.when.eventId === event.id)) {
    const missedStretch = s.protections.some(p => event.stationFt < p.fromFt || event.stationFt > p.toFt);
    if (missedStretch && !protectionAt(s, event.stationFt)) {
      d.triggered = true;
      d.caught = !!d.inspected;
    }
  }
}

// WO-02 reserves F5's firstLend hook but specifies no delay behaviour in these stages.
export function firstLend(s) {
  for (const d of s.deviations.filter(d => d.type === 'F5' && !d.triggered)) d.triggered = true;
}
import { CREW_IDS, EPS } from './common.js';

export const billing = (s, c) => s.t >= c.startDay - 1 - EPS && (c.finishT == null || c.finishT > s.t + EPS)
  && !(c.demobBillingEndsT != null && s.t >= c.demobBillingEndsT - EPS);

export function accrue(s, dt) {
  const overhead = 1 + s.scenario.rules.overheadRate;
  let crewDaily = 0;
  for (const id of CREW_IDS) {
    const c = s.crews[id];
    if (billing(s, c)) {
      c.onsite += dt;
      crewDaily += s.catalog.machines[c.machine]?.dailyUsd ?? 0;
    }
  }
  const protectionDaily = s.protections.reduce((sum, p) => sum
    + (CREW_IDS.some(id => {
      const c = s.crews[id];
      return c.mult > 0 && c.moved > EPS && c.pos >= p.fromFt && c.pos <= p.toFt;
    }) ? s.catalog.protection[p.kind].dailyUsd : 0), 0);
  const hiredDaily = s.deliveries.filter(d => d.hired && d.arrived && !d.released)
    .reduce((sum, d) => sum + s.catalog.machines[d.machine].dailyUsd, 0);
  const optionDaily = s.payments.reduce((sum, p) => sum + p.perDayUsd, 0);
  s.crewCostUsd += crewDaily * dt * overhead;
  s.spentUsd += (crewDaily + protectionDaily + hiredDaily) * dt * overhead + optionDaily * dt;
}

export function buyMachine(s, machine) {
  s.spentUsd += s.catalog.machines[machine].priceUsd + s.scenario.rules.mobilizationUsd;
}

export function releaseMachine(s, machine) {
  if (!machine) return;
  s.spentUsd -= s.catalog.machines[machine].priceUsd * s.catalog.orders.releaseRefundFraction;
}
import { EPS } from './common.js';
import { boundaryAllowance } from './deviations.js';

export function validatePermit(s, op) {
  const card = s.scenario.permits.cards.find(card => card.zone === op.zone);
  if (!card || card.code !== op.code) return 'code not on file';
  if (!s.permits[op.zone].entered && Object.values(s.permits).filter(p => p.entered && !p.signed).length
      >= s.scenario.permits.openZoneLimit) return `city limit: ${s.scenario.permits.openZoneLimit} zones open`;
}

export function validateInspection(s, op) {
  const card = s.scenario.inspections.cards.find(card => card.zone === op.zone);
  if (!card || card.number !== op.number) return 'code not on file';
}

export function excavationLimit(s, desired) {
  const zone = s.scenario.job.zones.find(z => !s.permits[z.id].entered);
  if (!zone) return s.scenario.job.lengthFt;
  let limit = zone.fromFt;
  if (desired >= limit - EPS && s.crews.exc.pos >= limit - EPS) limit = boundaryAllowance(s, zone);
  // An already excavated F2 stretch is never rolled back by a later gate calculation.
  return Math.max(s.crews.exc.pos, limit);
}

export function backfillLimit(s) {
  if (!s.scenario.inspections.required) return s.scenario.job.lengthFt;
  return s.scenario.job.zones.find(z => !s.inspections[z.id].cleared)?.toFt ?? s.scenario.job.lengthFt;
}

export function updateHoldPoints(s) {
  for (const zone of s.scenario.job.zones) {
    const inspection = s.inspections[zone.id];
    if (s.crews.back.pos >= zone.toFt - EPS) {
      if (!inspection.reported && s.scenario.inspections.required) {
        inspection.reported = true;
        // WO-02: both authored Texas stages return this compaction result.
        s.inbox.push({ day: s.t, from: 'City inspector', subject: `Zone ${zone.id} compaction`, body: 'passed' });
      }
      if (inspection.cleared || !s.scenario.inspections.required) s.permits[zone.id].signed = true;
    }
  }
}

export const finalInspectionEntered = s => !s.scenario.inspections.required
  || s.inspections[s.scenario.job.zones.at(-1).id].cleared;
import { CREW_IDS, EPS } from './common.js';

// Projections use issued instructions and catalog rates, never live field positions.
export function plannedRate(line, t) {
  if (t < line.startDay - 1) return 0;
  if (line.holds.some(h => t >= h.fromT && (h.untilT == null || t < h.untilT))) return 0;
  const segment = [...line.segments].sort((a, b) => a.fromT - b.fromT).findLast(segment => segment.fromT <= t);
  const extra = (line.loans ?? []).filter(loan => t >= loan.fromT && t < loan.untilT)
    .reduce((sum, loan) => sum + loan.rate, 0);
  return (segment?.rate ?? line.rate) + extra;
}

export function plannedPolylines(s) {
  return Object.fromEntries(CREW_IDS.map(id => {
    const line = s.plannedLines[id];
    const breaks = [...new Set([line.startDay - 1, ...line.segments.map(segment => segment.fromT),
      ...line.holds.flatMap(h => h.untilT == null ? [h.fromT] : [h.fromT, h.untilT]),
      ...(line.loans ?? []).flatMap(loan => [loan.fromT, loan.untilT])])]
      .filter(t => t >= line.startDay - 1).sort((a, b) => a - b);
    let t = line.startDay - 1, ft = 0;
    const points = [{ t, ft }];
    for (const next of breaks.slice(1)) {
      const rate = plannedRate(line, t);
      if (rate > 0 && ft + (next - t) * rate >= s.scenario.job.lengthFt) {
        points.push({ t: t + (s.scenario.job.lengthFt - ft) / rate, ft: s.scenario.job.lengthFt });
        return [id, points];
      }
      ft += (next - t) * rate; t = next; points.push({ t, ft });
    }
    const rate = plannedRate(line, t + EPS);
    if (rate > 0) points.push({ t: t + (s.scenario.job.lengthFt - ft) / rate, ft: s.scenario.job.lengthFt });
    else if (s.t > t) points.push({ t: s.t, ft });
    return [id, points];
  }));
}

export function projectOrder(s, order) {
  const op = order.op, line = s.plannedLines[order.crew];
  if (op.op === 'hold' || op.op === 'demob') {
    const fromT = Math.max(order.landsT, op.fromDay != null ? op.fromDay - 1 : order.landsT);
    line.holds.push({ fromT, untilT: op.days == null ? null : fromT + op.days, kind: op.op });
  }
  if (op.op === 'resume' || op.op === 'remob') {
    const untilT = order.landsT + (op.op === 'remob' ? s.catalog.cities[s.scenario.city].remobilizationDelayDays : 0);
    for (const hold of line.holds) {
      if ((op.op === 'resume' ? hold.kind === 'hold' : hold.kind === 'demob')
        && (hold.untilT == null || hold.untilT > untilT)) hold.untilT = Math.max(hold.fromT, untilT);
    }
  }
  if (op.op === 'order') {
    const machine = s.catalog.machines[op.machine];
    line.segments.push({ fromT: order.issuedT + machine.leadDays.normal + s.catalog.cities[s.scenario.city].leadDelayDays,
      rate: machine.rateFtPerDay });
  }
  if (op.op === 'lend') {
    const fromT = order.landsT, untilT = fromT + op.days;
    line.holds.push({ fromT, untilT, kind: 'lend' });
    if (!s.events.some(e => e.type === 'P1' && e.fired && !e.resolved && order.crew === 'exc' && op.toCrew === 'pipe')) {
      const recipient = s.plannedLines[op.toCrew];
      recipient.loans ??= [];
      recipient.loans.push({ fromT, untilT, rate: s.catalog.machines[op.machine].rateFtPerDay });
    }
  }
}
// WO-02 A2 rework rule: one authored duration per commenced 500 ft of open trench.
export const REWORK_CHUNK_FT = 500;

export function reworkDuration(openFt, daysPer500Ft, multiplier = 1) {
  return Math.ceil(openFt / REWORK_CHUNK_FT) * daysPer500Ft * multiplier;
}

export function rainMultiplier(s, crewId) {
  return s.events.filter(e => e.type === 'A2' && e.fired && !e.rainEnded)
    .reduce((mult, e) => mult * (e.restore?.includes(crewId) ? 1 : 1 - e.rateDrop), 1);
}

export function finishRain(s, event) {
  event.rainEnded = true;
  event.reworkDays = reworkDuration(event.openFt, event.rework?.daysPer500Ft
    ?? s.scenario.rules.rainReworkDaysPer500Ft,
  event.rework?.pumpHalves && event.pumpPaidT != null && event.pumpPaidT < event.endsT
    ? event.reworkMultiplier : 1);
  event.reworkEndsT = event.endsT + event.reworkDays;
}

export const rainOrRework = s => s.events.some(e => e.type === 'A2' && e.fired && !e.resolved);
export const pipeReworking = s => s.events.some(e => e.type === 'A2' && e.rainEnded && !e.resolved);
export function sky(s) {
  if (s.events.some(e => e.type === 'A2' && e.fired && !e.rainEnded)) return 'rain';
  return s.events.some(e => !e.fired && e.forecast && s.t >= e.forecast.skyFromDay - 1)
    ? 'towersSouth' : 'clear';
}
import { CREW_IDS, EPS, HOURS_PER_DAY, activeCollapse, crewAt, emit, nearby, travelDays, voice, zoneAt } from './common.js';
import { confirmDeviation, inspectProtection } from './deviations.js';
import { inspectionText, stakeAt } from './views.js';

const TARGETS = new Set(['wall', 'water', 'pipe', 'machine', 'protection', 'board', 'sky', 'ticket', 'crew']);
export function applySite(s, cmd) {
  const truck = s.truck;
  if (cmd.action === 'moveTo') {
    if (truck.moving || truck.dismounted) return 'mount before moving';
    if (!Number.isFinite(cmd.stationFt) || cmd.stationFt < 0 || cmd.stationFt > s.scenario.job.lengthFt) return 'invalid station';
    truck.fromFt = truck.stationFt;
    truck.toFt = cmd.stationFt;
    truck.departT = s.t;
    truck.arrivesT = s.t + travelDays(truck.stationFt, cmd.stationFt);
    truck.moving = truck.arrivesT > s.t;
    return;
  }
  if (cmd.action === 'mount' || cmd.action === 'dismount') {
    if (truck.moving) return 'truck moving';
    truck.dismounted = cmd.action === 'dismount';
    return;
  }
  if (!truck.dismounted || truck.moving) return 'dismount first';
  if (cmd.action === 'inspect') {
    if (!TARGETS.has(cmd.target)) return 'unknown inspection target';
    const ft = stakeAt(s, truck.stationFt);
    if (cmd.target === 'protection') inspectProtection(s, ft);
    const event = activeCollapse(s);
    if (event && stakeAt(s, event.stationFt) === ft) event.inspected = true;
    emit(s, 'inspection', { id: cmd.id, target: cmd.target, text: inspectionText(s, cmd.target), seats: ['site'] });
    return;
  }
  if (cmd.action === 'flag') {
    // Protocol caps authored notes at 40 characters.
    const MAX_NOTE_LENGTH = 40;
    if (!Number.isFinite(cmd.stationFt) || cmd.stationFt < 0 || cmd.stationFt > s.scenario.job.lengthFt
      || cmd.note != null && (typeof cmd.note !== 'string' || cmd.note.length > MAX_NOTE_LENGTH)) return 'invalid flag';
    s.flags.push({ stationFt: cmd.stationFt, day: s.t, ...(cmd.note ? { note: cmd.note } : {}) });
    return;
  }
  if (cmd.action === 'stopWork') {
    if (zoneAt(s, truck.stationFt)?.id !== cmd.zone) return 'outside zone';
    const stop = { zone: cmd.zone, fromT: s.t + s.scenario.rules.stopWorkReachHours / HOURS_PER_DAY };
    for (const id of CREW_IDS) {
      const c = s.crews[id];
      if (zoneAt(s, c.pos)?.id !== cmd.zone) continue;
      if (s.t >= c.startDay - 1 - EPS) c.stop = { ...stop };
      else s.pendingStops[id] = { ...stop };
    }
    return;
  }
  if (cmd.action === 'confirm') {
    const order = s.orders.find(order => order.id === cmd.orderId);
    if (!order?.crew || order.landedT == null || order.status === 'sent'
      || !nearby(s, s.crews[order.crew].pos)) return 'order not landed here';
    if (!['done', 'notDone'].includes(cmd.outcome)) return 'invalid outcome';
    order.status = cmd.outcome === 'done' ? 'confirmed' : 'notCarriedOut';
    confirmDeviation(s, order, cmd.outcome);
    if (cmd.outcome === 'notDone') voice(s, 'orderNotDone', ['plan']);
    return;
  }
  if (cmd.action === 'listen') {
    const c = crewAt(s);
    if (c?.arguing) {
      const conflict = s.conflicts.find(conflict => conflict.trailing === c.id || conflict.leader === c.id);
      voice(s, 'conflict', ['site'], [conflict.trailing, conflict.leader]);
    } else if (c && (c.status === 'held' || c.status === 'stopped') && c.mood > 0) {
      voice(s, `heldDay${c.mood}`, ['site'], [c.id]);
    } else emit(s, 'inspection', { id: cmd.id, target: 'crew', text: 'Nothing to hear.', seats: ['site'] });
    return;
  }
  return 'unknown action';
}

export function updateTruck(s) {
  const truck = s.truck;
  if (!truck.moving) return;
  if (s.t >= truck.arrivesT - EPS) {
    truck.stationFt = truck.toFt;
    truck.moving = false;
  } else truck.stationFt = truck.fromFt + (truck.toFt - truck.fromFt)
    * (s.t - truck.departT) / (truck.arrivesT - truck.departT);
}

