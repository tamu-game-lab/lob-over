+      ...(speaker.startsWith('foreman_') ? { stationFt: s.crews[speaker.replace('foreman_', '')].pos } : {}) }));
+    const seats = turns.every(turn => ['pm', 'radio'].includes(turn.speaker)) ? ['plan'] : ['site'];
