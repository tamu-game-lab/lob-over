diff --git a/Monitor/src/host/discovery.js b/Monitor/src/host/discovery.js
new file mode 100644
index 0000000000000000000000000000000000000000..6dfa4b32963ce4ac2cf42e56aecc80fda1842dad
--- /dev/null
+++ b/Monitor/src/host/discovery.js
@@ -0,0 +1,33 @@
+import { createSocket } from 'node:dgram';
+import { networkInterfaces, hostname } from 'node:os';
+
+// WO-L1 discovery protocol and real-time beacon cadence (outside the simulation).
+export const DISCOVERY_PORT = 7332;
+const BEACON_MS = 2000;
+export const ipv4Interfaces = () => Object.values(networkInterfaces()).flat()
+  .filter(entry => entry.family === 'IPv4' && !entry.internal);
+const broadcastAddress = ({ address, netmask }) => address.split('.').map((part, i) =>
+  Number(part) | (255 ^ Number(netmask.split('.')[i]))).join('.');
+
+export async function startDiscovery(port, { interfaces = ipv4Interfaces(), name = hostname(),
+  destinationPort = DISCOVERY_PORT } = {}) {
+  const packet = Buffer.from(`LOBOVER 1 ${port} ${name}`);
+  const sockets = [];
+  for (const entry of interfaces) {
+    const socket = createSocket('udp4');
+    socket.on('error', error => console.error(`Discovery ${entry.address}: ${error.message}`));
+    const bound = await new Promise(resolve => {
+      socket.once('error', () => resolve(false));
+      socket.bind(0, entry.address, () => resolve(true));
+    });
+    if (!bound) { socket.close(); continue; }
+    socket.setBroadcast(true);
+    sockets.push({ socket, address: broadcastAddress(entry) });
+  }
+  const send = () => {
+    for (const { socket, address } of sockets) socket.send(packet, destinationPort, address);
+  };
+  send();
+  const timer = setInterval(send, BEACON_MS);
+  return { close() { clearInterval(timer); for (const { socket } of sockets) socket.close(); } };
+}
diff --git a/Monitor/src/host/launch.ps1 b/Monitor/src/host/launch.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..7451d68b8a4835d237a60a7325e4ff0c95510e27
--- /dev/null
+++ b/Monitor/src/host/launch.ps1
@@ -0,0 +1,31 @@
+# WO-L1: USB is optional; Wi-Fi discovery remains available when adb is absent.
+$adbCommand = Get-Command adb.exe -ErrorAction SilentlyContinue
+$adbPath = if ($adbCommand) { $adbCommand.Source } else { $null }
+if (-not $adbPath) {
+    $editors = Join-Path $env:ProgramFiles 'Unity/Hub/Editor'
+    $adbPath = Get-ChildItem -Path "$editors/*/Editor/Data/PlaybackEngines/AndroidPlayer/SDK/platform-tools/adb.exe" -ErrorAction SilentlyContinue |
+        Select-Object -First 1 -ExpandProperty FullName
+}
+if ($adbPath) {
+    try {
+        & $adbPath devices 2>$null | ForEach-Object {
+            if ($_ -match '^(\S+)\s+device$') {
+                & $adbPath -s $Matches[1] reverse tcp:7331 tcp:7331 2>$null | Out-Null
+            }
+        }
+    } catch { }
+}
+# The helper opens the browser only after the foreground Node host is listening.
+$opener = @'
+for ($attempt = 0; $attempt -lt 100; $attempt++) {
+    $client = New-Object System.Net.Sockets.TcpClient
+    try {
+        $client.Connect('127.0.0.1', 7331)
+        $client.Close()
+        Start-Process 'http://localhost:7331/play.html'
+        exit
+    } catch { $client.Close(); Start-Sleep -Milliseconds 200 }
+}
+'@
+$encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($opener))
+Start-Process powershell.exe -WindowStyle Hidden -ArgumentList '-NoProfile', '-EncodedCommand', $encoded
