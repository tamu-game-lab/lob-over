+@echo off
+setlocal
+cd /d "%~dp0"
+where node >nul 2>nul
+if errorlevel 1 (
+  echo Node.js is missing. Install Node.js 20 or newer from https://nodejs.org then run this file again.
+  pause
+  exit /b 1
+)
+if not exist "Monitor\node_modules" (
+  pushd Monitor
+  call npm.cmd ci
+  if errorlevel 1 (
+    popd
+    echo Dependencies could not be installed.
+    pause
+    exit /b 1
+  )
+  popd
+)
+powershell -NoProfile -ExecutionPolicy Bypass -File "Monitor\src\host\launch.ps1"
+node Monitor/src/host/server.js Data/Scenarios/level1_texas.json --discovery
+if errorlevel 1 pause
diff --git a/Tools/voice/README.md b/Tools/voice/README.md
index 88803cd3f3c37ee9f7cd7ed97fa4b4983413a7d2..9ecdddd5a440f83f4112aeed3408bca40c17841b
--- a/Tools/voice/README.md
+++ b/Tools/voice/README.md
@@ -8,3 +8,9 @@
 Defaults: PM `am_onyx` (mature American male), radio `af_sarah` (neutral American female), three distinct male foremen.
 Replace any placeholder with a recorded 24 kHz mono WAV at the same filename; leave its manifest entry and avoid `--force`.
 Generation uses cached models offline, PM speed 1.0, radio speed 1.1, 150 ms edge silence, -3 dBFS peaks and radio-only filtering/clicks.
+
+Level 1: `.venv\Scripts\python Tools/voice/make_voice.py Data/Scenarios/level1_texas.json`.
+Use that interpreter explicitly; do not change PATH globally. A sheet containing exchanges
+writes every utterance as `<lineId>_<n>.wav` (one-based, including single-turn lines).
