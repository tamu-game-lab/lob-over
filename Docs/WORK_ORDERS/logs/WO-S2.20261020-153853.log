diff --git a/Sim/LOBOver.Sim.Tests/AutoplanTests.cs b/Sim/LOBOver.Sim.Tests/AutoplanTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3d587a23dcb62123caae8f138b2eab13afd06b19
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/AutoplanTests.cs
@@ -0,0 +1,38 @@
+using System;
+using System.Collections.Generic;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    public sealed class AutoplanTests
+    {
+        [Fact]
+        public void StableTimingSkipsSiteAndCopiesCommands()
+        {
+            var script = JArray.Parse(@"[
+                { 't': 2, 'seat': 'plan', 'cmd': { 'action': 'commit', 'id': 'later', 'ops': [] } },
+                { 't': 1, 'seat': 'plan', 'cmd': { 'action': 'commit', 'id': 'first', 'ops': [] } },
+                { 't': 1, 'seat': 'site', 'cmd': { 'action': 'dismount', 'id': 'human' } },
+                { 't': 1, 'seat': 'facilitator', 'cmd': { 'action': 'pause', 'id': 'second' } }]");
+            var autoplan = new Autoplan(script); script[1]["cmd"]["id"] = "mutated";
+            var calls = new List<string>();
+            void Apply(string seat, JObject cmd) { calls.Add(seat + ":" + (string)cmd["id"]); cmd["id"] = "mutated in callback"; }
+            autoplan.Advance(0.9, Apply); Assert.Empty(calls);
+            autoplan.Advance(1 - 0.0000005, Apply);
+            Assert.Equal(new[] { "plan:first", "facilitator:second" }, calls);
+            Assert.Equal(2, autoplan.NextT);
+            autoplan.SetEnabled(false); autoplan.Advance(3, Apply); Assert.Equal(2, calls.Count);
+            autoplan.SetEnabled(true); autoplan.Advance(3, Apply); Assert.Equal("plan:later", calls[2]); Assert.Null(autoplan.NextT);
+            autoplan.Reset(); calls.Clear(); autoplan.Advance(1, Apply);
+            Assert.Equal(new[] { "plan:first", "facilitator:second" }, calls);
+        }
+        [Fact]
+        public void ValidationAlsoCoversSkippedSiteEntries()
+        {
+            Assert.Throws<ArgumentException>(() => new Autoplan(JArray.Parse("[{'t':-1,'seat':'site','cmd':{'action':'mount'}}]")));
+            Assert.Throws<ArgumentException>(() => new Autoplan(JArray.Parse("[{'t':0,'seat':'rules','cmd':{'action':'mount'}}]")));
+            Assert.False(new Autoplan().Enabled);
+        }
+    }
+}
diff --git a/Sim/LOBOver.Sim.Tests/CommandsTests.cs b/Sim/LOBOver.Sim.Tests/CommandsTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..9db7f53047af5d18f8aa2f96324bd40dc03af1c2
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/CommandsTests.cs
@@ -0,0 +1,57 @@
+using System;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    public sealed class CommandsTests
+    {
+        [Fact]
+        public void InvalidOfficeActionRollsBackWholeCommit()
+        {
+            var sim = Replay.Create("stage2_texas");
+            var before = sim.Serialize();
+            var reply = sim.Apply("plan", JObject.Parse(@"{'action':'commit','ops':[
+                {'op':'setStart','crew':'back','day':20},
+                {'op':'enterPermit','zone':1,'code':'not on file'}]}"));
+            Assert.False(reply.Ok); Assert.Equal("code not on file", reply.Reason);
+            Assert.True(JToken.DeepEquals(before, sim.Serialize()));
+        }
+        [Fact]
+        public void JsonNumberZoneIdsDoNotDependOnIntegerTokenEncoding()
+        {
+            var sim = Replay.Create("stage2_texas");
+            var source = JObject.Parse(Replay.Read("Data/Scenarios/stage2_texas.json"));
+            var code = source["permits"]["cards"][0]["code"];
+            var number = source["inspections"]["cards"][0]["number"];
+            var reply = sim.Apply("plan", new JObject { ["action"] = "commit", ["ops"] = new JArray(
+                new JObject { ["op"] = "enterPermit", ["zone"] = 1.0, ["code"] = code },
+                new JObject { ["op"] = "enterInspection", ["zone"] = 1.0, ["number"] = number }) });
+            Assert.True(reply.Ok, reply.Reason);
+            Assert.True((bool)sim.View("plan")["permits"][0]["entered"]);
+            Assert.True((bool)sim.View("plan")["inspections"][0]["cleared"]);
+        }
+        [Fact]
+        public void CrewWithoutOwnMachineUsesLentRate()
+        {
+            var sim = Replay.Create("stage1_texas", data =>
+            {
+                data["crews"][1]["machine"] = null;
+                data["crews"][1]["startDay"] = 1;
+                data["events"] = new JArray(); data["deviations"] = new JArray();
+            });
+            Assert.True(sim.Apply("site", JObject.Parse("{'action':'dismount'}")).Ok);
+            var reply = sim.Apply("plan", JObject.Parse(@"{'action':'commit','ops':[
+                {'op':'lend','machine':'excavator_standard','toCrew':'pipe','days':1}]}"));
+            Assert.True(reply.Ok, reply.Reason); sim.Tick(0.01);
+            var expectedRate = (double)JObject.Parse(Replay.Read("Data/catalog.json"))["machines"]["excavator_standard"]["rateFtPerDay"];
+            Assert.Equal(expectedRate, (double)sim.Serialize()["crews"]["pipe"]["rate"]);
+        }
+        [Fact]
+        public void UnsupportedRuleSwitchThrowsBeforePlay()
+        {
+            var error = Assert.Throws<ArgumentException>(() => Replay.Create(edit: data => data["rules"]["orderLagShifts"] = 2));
+            Assert.Contains("Unsupported rules.orderLagShifts", error.Message);
+        }
+    }
+}
