diff --git a/Assets/LOBOver/Sim/Common.cs b/Assets/LOBOver/Sim/Common.cs
new file mode 100644
index 0000000000000000000000000000000000000000..7f779e83e9244ff6307dd232810532cc8f8ed976
--- /dev/null
+++ b/Assets/LOBOver/Sim/Common.cs
@@ -0,0 +1,132 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace LOBOver.Sim
+{
+    // JSON helpers preserve the authored field names and missing/null distinction.
+    internal static class Json
+    {
+        internal static JToken Get(this JToken value, string key) => value is JObject obj ? obj[key] : null;
+        internal static bool Has(this JToken value, string key) => value.Get(key) != null && value.Get(key).Type != JTokenType.Null;
+        internal static double N(this JToken value, string key, double fallback = 0) => value.Has(key) ? (double)value.Get(key) : fallback;
+        internal static double? NullableN(this JToken value, string key) => value.Has(key) ? (double?)value.Get(key) : null;
+        internal static string S(this JToken value, string key) => (string)value.Get(key);
+        internal static bool B(this JToken value, string key) => value.Get(key)?.Type == JTokenType.Boolean && (bool)value.Get(key);
+        internal static JObject Obj(this JToken value, string key) => value.Get(key) as JObject;
+        internal static IEnumerable<JObject> Rows(this JToken value, string key) => (value.Get(key) as JArray ?? new JArray()).OfType<JObject>();
+        internal static bool Includes(this JToken value, string key, string text) => (value.Get(key) as JArray)?.Any(x => x.Type == JTokenType.String && (string)x == text) == true;
+        internal static bool Finite(this JToken value, string key) => value.Get(key) is JValue v
+            && (v.Type == JTokenType.Integer || v.Type == JTokenType.Float) && double.IsFinite((double)v);
+        internal static bool Integer(this JToken value, string key) => value.Finite(key) && value.N(key) == Math.Floor(value.N(key));
+        internal static JObject Copy(this JObject value) => value == null ? null : (JObject)value.DeepClone();
+        internal static JToken Token(object value) => value == null ? JValue.CreateNull() : value is JToken token ? token.DeepClone() : JToken.FromObject(value);
+        internal static JObject O(params object[] pairs)
+        {
+            var result = new JObject();
+            for (var i = 0; i < pairs.Length; i += 2) result[(string)pairs[i]] = Token(pairs[i + 1]);
+            return result;
+        }
+        internal static string F(double number) => number.ToString("G", CultureInfo.InvariantCulture);
+    }
+
+    internal static class Common
+    {
+        // Monitor/src/sim/common.js, WO-02: crew order, precision, travel and mood.
+        internal static readonly string[] CREW_IDS = { "exc", "pipe", "back" };
+        internal static readonly string[] MOODS = { "calm", "grumbling", "angry", "furious" };
+        internal const double DT = 0.01, EPS = 1e-6, NEAR_FT = 100, HAUL_FT_PER_HOUR = 1500, HOURS_PER_DAY = 24;
+        internal const double MAX_MOOD = 3, CONFLICT_LOOKAHEAD_DAYS = 1, CLEARING_DAY_STEP = 0.5;
+        internal static string Leader(string id) => id == "pipe" ? "exc" : id == "back" ? "pipe" : null;
+        internal static double TravelDays(double a, double b) => Math.Abs(a - b) / HAUL_FT_PER_HOUR / HOURS_PER_DAY;
+        internal static double DisplayDay(double t) => Math.Floor(t + EPS) + 1;
+        internal static double NextBoundary(double t) => Math.Floor(t + EPS) + 1;
+        internal static JObject ZoneAt(State s, double ft) => s.Zones.FirstOrDefault(z => ft >= z.N("fromFt") && (ft < z.N("toFt") || ft == s.Length));
+        internal static bool Nearby(State s, double ft) => s.truck.B("dismounted") && !s.truck.B("moving") && Math.Abs(s.truck.N("stationFt") - ft) <= NEAR_FT;
+        internal static Crew CrewAt(State s) => CREW_IDS.Select(id => s.crews[id]).Where(c => Math.Abs(c.pos - s.truck.N("stationFt")) <= NEAR_FT)
+            .OrderBy(c => Math.Abs(c.pos - s.truck.N("stationFt"))).FirstOrDefault();
+        internal static JObject ProtectionAt(State s, double? ft) => ft.HasValue && double.IsFinite(ft.Value)
+            ? s.protections.FirstOrDefault(p => ft >= p.N("fromFt") && ft <= p.N("toFt")) : null;
+        internal static JObject ActiveCollapse(State s) => s.events.FirstOrDefault(e => e.S("type") == "P1" && e.B("fired") && !e.B("resolved"));
+        internal static void Emit(State s, string type, JObject fields)
+        {
+            var message = Json.O("t", type, "v", 1, "day", s.t);
+            foreach (var field in fields.Properties()) message[field.Name] = field.Value.DeepClone();
+            s.messages.Add(message);
+        }
+        internal static void Voice(State s, string trigger, string[] seats, string[] crewIds = null)
+        {
+            var lines = s.scenario.Rows("lines").Where(line => line.S("trigger") == trigger
+                && (crewIds == null || crewIds.Contains(line.S("speaker").Replace("foreman_", "")))).ToList();
+            if (lines.Count == 0) return;
+            Emit(s, "voice", Json.O("lineIds", lines.Select(line => line.S("id")), "seats", seats));
+            s.pmLines.AddRange(lines.Where(line => line.S("speaker") == "pm").Select(line => line.S("text")));
+        }
+    }
+
+    internal sealed class Crew
+    {
+        public string id, name, machine, status = "idle", idleReason;
+        public double startDay, pos, work, onsite, rate, mult, mood, waitDays, workingDays, moved;
+        public double? finishT, remobT, demobBillingEndsT;
+        public bool locked, arguing, demobilized, lentAway;
+        public JObject hold, stop;
+        internal Crew Copy()
+        {
+            var c = (Crew)MemberwiseClone();
+            c.hold = hold.Copy(); c.stop = stop.Copy();
+            return c;
+        }
+    }
+
+    internal sealed class State
+    {
+        public JObject scenario, catalog, result, truck;
+        public bool pure, done;
+        public uint rngState;
+        public double t, spentUsd, crewCostUsd, finesUsd, peakOpenTrenchFt;
+        public double? capFt;
+        public string speed = "full", pausedSpeed = "full";
+        public int nextOrderId = 1;
+        public Dictionary<string, Crew> crews = new Dictionary<string, Crew>();
+        public Dictionary<string, JObject> pendingStops = new Dictionary<string, JObject>();
+        public Dictionary<string, JObject> permits = new Dictionary<string, JObject>(), inspections = new Dictionary<string, JObject>();
+        public Dictionary<string, JObject> plannedLines = new Dictionary<string, JObject>();
+        public Dictionary<string, List<JObject>> actualLines = new Dictionary<string, List<JObject>>(), reportedLines = new Dictionary<string, List<JObject>>();
+        public List<JObject> orders = new List<JObject>(), loans = new List<JObject>(), deliveries = new List<JObject>(), payments = new List<JObject>();
+        public List<JObject> protections = new List<JObject>(), events = new List<JObject>(), deviations = new List<JObject>(), conflicts = new List<JObject>();
+        public List<JObject> flags = new List<JObject>(), inbox = new List<JObject>(), messages = new List<JObject>(), changeLog = new List<JObject>();
+        public List<int> inboxDelivered = new List<int>();
+        public List<string> pmLines = new List<string>();
+        [JsonIgnore] internal JObject Job => scenario.Obj("job");
+        [JsonIgnore] internal JObject Rules => scenario.Obj("rules");
+        [JsonIgnore] internal JObject Plan => scenario.Obj("plan");
+        [JsonIgnore] internal JObject City => catalog.Obj("cities").Obj(scenario.S("city"));
+        [JsonIgnore] internal IEnumerable<JObject> Zones => Job.Rows("zones");
+        [JsonIgnore] internal double Length => Job.N("lengthFt");
+        internal JObject Machine(string key) => key == null ? null : catalog.Obj("machines").Obj(key);
+        internal static string ZoneKey(JToken obj, string key = "id") => Json.F(obj.N(key));
+
+        // Reducers own a draft. Authored data and append-only history entries are shared.
+        internal State Draft()
+        {
+            var s = (State)MemberwiseClone();
+            s.crews = Common.CREW_IDS.ToDictionary(id => id, id => crews[id].Copy());
+            s.truck = truck.Copy(); s.result = result.Copy();
+            s.pendingStops = CloneMap(pendingStops); s.permits = CloneMap(permits); s.inspections = CloneMap(inspections);
+            s.plannedLines = CloneMap(plannedLines);
+            s.orders = CloneList(orders); s.loans = CloneList(loans); s.deliveries = CloneList(deliveries); s.payments = CloneList(payments);
+            s.protections = CloneList(protections); s.events = CloneList(events); s.deviations = CloneList(deviations); s.conflicts = CloneList(conflicts);
+            s.flags = CloneList(flags); s.inboxDelivered = new List<int>(inboxDelivered); s.pmLines = new List<string>(pmLines);
+            s.actualLines = Common.CREW_IDS.ToDictionary(id => id, id => new List<JObject>(actualLines[id]));
+            s.reportedLines = Common.CREW_IDS.ToDictionary(id => id, id => new List<JObject>(reportedLines[id]));
+            s.inbox = new List<JObject>(inbox); s.messages = new List<JObject>(messages); s.changeLog = new List<JObject>(changeLog);
+            return s;
+        }
+        private static Dictionary<string, JObject> CloneMap(Dictionary<string, JObject> map) => map.ToDictionary(p => p.Key, p => p.Value.Copy());
+        private static List<JObject> CloneList(List<JObject> list) => list.Select(x => x.Copy()).ToList();
+    }
+}
diff --git a/Assets/LOBOver/Sim/Conflict.cs b/Assets/LOBOver/Sim/Conflict.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8d64c2b850fd8d9183b0eb7f3f78f8bfa175f0c4
--- /dev/null
+++ b/Assets/LOBOver/Sim/Conflict.cs
@@ -0,0 +1,42 @@
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Conflict
+    {
+        internal static void DetectConflicts(State s)
+        {
+            foreach (var trailingId in CREW_IDS.Skip(1))
+            {
+                var leaderId = Leader(trailingId);
+                var trailing = s.crews[trailingId]; var leader = s.crews[leaderId];
+                var key = trailingId + ":" + leaderId;
+                if (leader.finishT != null || s.conflicts.Any(c => c.S("pair") == key) || trailing.mult <= 0 || trailing.pos >= leader.pos - EPS) continue;
+                if (trailing.pos + trailing.rate * trailing.mult * CONFLICT_LOOKAHEAD_DAYS
+                    <= leader.pos + leader.rate * leader.mult * CONFLICT_LOOKAHEAD_DAYS + EPS) continue;
+                s.conflicts.Add(O("pair", key, "trailing", trailingId, "leader", leaderId, "firedT", s.t, "resolved", false));
+                trailing.arguing = leader.arguing = true;
+                trailing.mult = leader.mult = 0; trailing.status = leader.status = "arguing";
+                s.speed = "slow";
+                Voice(s, "conflict", new[] { "site" }, new[] { trailingId, leaderId });
+                Emit(s, "event", O("eventId", "conflict_" + trailingId + "_" + leaderId, "day", s.t,
+                    "stationFt", trailing.pos, "zone", null, "seats", new[] { "site" },
+                    "card", O("title", "Crews stopped", "facts", new[] { trailing.name + " and " + leader.name + " foremen are arguing." })));
+            }
+        }
+        internal static string ValidateConflictCommit(State s, JArray ops) => s.conflicts.Any(c => !c.B("resolved")
+            && !ops.Any(op => op.S("crew") == c.S("trailing") && (op.S("op") == "hold" || op.S("op") == "demob")))
+            ? "conflict: hold or demobilize the trailing crew" : null;
+        internal static void ResolveConflicts(State s)
+        {
+            foreach (var c in s.conflicts.Where(c => !c.B("resolved")))
+            {
+                c["resolved"] = true; c["resolvedT"] = s.t;
+                s.crews[c.S("leader")].arguing = false;
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Crews.cs b/Assets/LOBOver/Sim/Crews.cs
new file mode 100644
index 0000000000000000000000000000000000000000..dcf26943ff2b68f04efc38f6ad0846b624f80290
--- /dev/null
+++ b/Assets/LOBOver/Sim/Crews.cs
@@ -0,0 +1,92 @@
+using System;
+using System.Linq;
+using static LOBOver.Sim.Common;
+
+namespace LOBOver.Sim
+{
+    internal static class Crews
+    {
+        private const double MOOD_RECOVERY_DAYS = 1; // WO-05a (a): a full working day.
+        internal static void RefreshCrews(State s)
+        {
+            foreach (var id in CREW_IDS)
+            {
+                var c = s.crews[id];
+                if (s.pendingStops.TryGetValue(id, out var stop) && s.t >= c.startDay - 1 - EPS)
+                { c.stop = stop; s.pendingStops.Remove(id); }
+                if (c.hold.Has("untilT") && s.t >= c.hold.N("untilT") - EPS) c.hold = null;
+                if (c.remobT != null && s.t >= c.remobT - EPS)
+                { c.demobilized = false; c.demobBillingEndsT = null; c.remobT = null; }
+                c.rate = s.Machine(c.machine).N("rateFtPerDay");
+                foreach (var loan in s.loans.Where(l => l.S("toCrew") == id && l.S("phase") == "working" && !l.Has("eventId")))
+                    c.rate += s.Machine(loan.S("machine")).N("rateFtPerDay");
+                var held = c.hold != null && s.t >= c.hold.N("fromT") - EPS;
+                var stopped = c.stop != null && s.t >= c.stop.N("fromT") - EPS;
+                c.status = c.demobilized ? "demobilized" : c.arguing ? "arguing" : stopped ? "stopped" : held ? "held" : "working";
+                c.mult = 1;
+                if (s.t < c.startDay - 1 - EPS || c.finishT != null) { c.mult = 0; c.status = "idle"; }
+                if (c.demobilized || c.arguing || stopped || held || c.lentAway || c.rate == 0) c.mult = 0;
+                if (!s.pure)
+                {
+                    c.mult *= Rain.RainMultiplier(s, id);
+                    foreach (var e in s.events.Where(e => e.B("fired") && !e.B("resolved") && e.S("type") != "A2"
+                        && (e.S("hits") == id || e.S("hits") == "all"))) c.mult *= 1 - e.N("rateDrop");
+                    if (id == "pipe" && Rain.PipeReworking(s)) c.mult = 0;
+                }
+                if (c.mult == 0 && c.status == "working") c.status = "idle";
+                if (c.status == "working" && c.idleReason != null && c.moved < EPS) c.status = "idle";
+            }
+        }
+
+        internal static void MoveCrews(State s, double dt)
+        {
+            foreach (var id in CREW_IDS)
+            {
+                var c = s.crews[id];
+                if (s.t < c.startDay - 1 - EPS || c.finishT != null) continue;
+                var leader = Leader(id) == null ? null : s.crews[Leader(id)];
+                var limit = Math.Min(s.Length, leader?.pos ?? s.Length);
+                var desired = c.pos + c.rate * c.mult * dt;
+                c.idleReason = null;
+                if (s.pure && id == "exc" && s.capFt != null) limit = Math.Min(limit, s.crews["back"].pos + s.capFt.Value);
+                if (!s.pure && id == "exc")
+                {
+                    var permitLimit = Permits.ExcavationLimit(s, c.mult > 0 ? desired : c.pos);
+                    limit = Math.Min(limit, permitLimit);
+                    if (desired > permitLimit || c.pos >= permitLimit - EPS && permitLimit < s.Length) c.idleReason = "idleNoPermit";
+                }
+                if (!s.pure && id == "back")
+                {
+                    var holdPoint = Permits.BackfillLimit(s);
+                    limit = Math.Min(limit, holdPoint);
+                    if (desired > holdPoint || c.pos >= holdPoint - EPS && !Permits.FinalInspectionEntered(s)) c.idleReason = "idleHoldPoint";
+                }
+                desired = Math.Max(c.pos, Math.Min(desired, limit));
+                var moved = desired - c.pos;
+                if (moved > 0) c.work += moved / c.rate;
+                c.pos = desired; c.moved = moved;
+                if (leader != null && moved < c.rate * c.mult * dt - EPS && c.idleReason == null) c.idleReason = "leader";
+                if (c.status == "working" && moved < EPS) c.status = "idle";
+                if (c.pos >= s.Length - EPS && (id != "back" || s.pure || Permits.FinalInspectionEntered(s))) c.finishT = s.t + dt;
+            }
+            s.peakOpenTrenchFt = Math.Max(s.peakOpenTrenchFt, s.crews["exc"].pos - s.crews["back"].pos);
+        }
+
+        internal static void UpdateMood(State s, double dt)
+        {
+            foreach (var id in CREW_IDS)
+            {
+                var c = s.crews[id];
+                if (s.t < c.startDay - 1 - EPS) continue;
+                var held = c.status == "held" || c.status == "stopped";
+                var waiting = held || c.idleReason == "leader";
+                c.waitDays = waiting ? c.waitDays + dt : 0;
+                var level = Math.Min(MAX_MOOD, Math.Floor((c.waitDays + EPS) / s.Rules.N("moodStepDays")));
+                if (held && level > c.mood)
+                    for (var mood = c.mood + 1; mood <= level; mood++) Voice(s, "heldDay" + Json.F(mood), new[] { "site" }, new[] { id });
+                c.workingDays = c.status == "working" && c.moved > EPS ? c.workingDays + dt : 0;
+                c.mood = c.workingDays >= MOOD_RECOVERY_DAYS - EPS ? 0 : Math.Max(c.mood, level);
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Deviations.cs b/Assets/LOBOver/Sim/Deviations.cs
new file mode 100644
index 0000000000000000000000000000000000000000..56edb0755e98c0627459cf22862b02a92cad8b5e
--- /dev/null
+++ b/Assets/LOBOver/Sim/Deviations.cs
@@ -0,0 +1,58 @@
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+
+namespace LOBOver.Sim
+{
+    internal static class Deviations
+    {
+        internal static void MarkFirstRadio(State s, JObject order)
+        {
+            var d = s.deviations.FirstOrDefault(d => d.S("type") == "F1" && !d.B("triggered")
+                && d.Obj("when").Includes("ops", order.Obj("op").S("op")) && order.N("landsT") > order.N("issuedT"));
+            if (d == null) return;
+            d["triggered"] = true; d["orderId"] = order["id"]; order["ignored"] = true;
+        }
+        internal static void ConfirmDeviation(State s, JObject order, string outcome)
+        {
+            var d = s.deviations.FirstOrDefault(d => d.S("type") == "F1" && d.S("orderId") == order.S("id"));
+            if (d != null && outcome == "notDone" && s.t < NextBoundary(order.N("landedT")) - EPS) d["caught"] = true;
+        }
+        internal static double BoundaryAllowance(State s, JObject zone)
+        {
+            // WO-05a O10: only a boundary between zones can trigger F2.
+            if (!s.Zones.Any(previous => previous.N("toFt") == zone.N("fromFt"))) return zone.N("fromFt");
+            var d = s.deviations.FirstOrDefault(d => d.S("type") == "F2");
+            if (d == null) return zone.N("fromFt");
+            if (d.B("triggered")) return d.N("zone") == zone.N("id") && !d.B("caught") ? zone.N("fromFt") + d.N("overshootFt") : zone.N("fromFt");
+            d["triggered"] = true; d["zone"] = zone["id"];
+            d["caught"] = Nearby(s, zone.N("fromFt")) || s.crews["exc"].hold != null || s.crews["exc"].stop != null;
+            if (!d.B("caught")) { s.finesUsd += s.Rules.N("permitFineUsd"); s.spentUsd += s.Rules.N("permitFineUsd"); }
+            return d.B("caught") ? zone.N("fromFt") : zone.N("fromFt") + d.N("overshootFt");
+        }
+        internal static void InspectProtection(State s, double stationFt)
+        {
+            var p = ProtectionAt(s, stationFt);
+            if (p == null) return;
+            foreach (var d in s.deviations.Where(d => d.S("type") == "F3"))
+            {
+                var e = s.events.First(e => e.S("id") == d.Obj("when").S("eventId"));
+                if (!e.B("fired") && !(e.N("stationFt") >= p.N("fromFt") && e.N("stationFt") <= p.N("toFt"))) d["inspected"] = true;
+            }
+        }
+        internal static void EventDeviations(State s, JObject e)
+        {
+            foreach (var d in s.deviations.Where(d => d.S("type") == "F3" && d.Obj("when").S("eventId") == e.S("id")))
+            {
+                var missedStretch = s.protections.Any(p => e.N("stationFt") < p.N("fromFt") || e.N("stationFt") > p.N("toFt"));
+                if (missedStretch && ProtectionAt(s, e.NullableN("stationFt")) == null)
+                { d["triggered"] = true; d["caught"] = d.B("inspected"); }
+            }
+        }
+        // WO-02 reserves F5 without specifying any delay in the authored stages.
+        internal static void FirstLend(State s)
+        {
+            foreach (var d in s.deviations.Where(d => d.S("type") == "F5" && !d.B("triggered"))) d["triggered"] = true;
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Events.cs b/Assets/LOBOver/Sim/Events.cs
new file mode 100644
index 0000000000000000000000000000000000000000..663b2b7280c67941ee318b4c54e65957ef0df244
--- /dev/null
+++ b/Assets/LOBOver/Sim/Events.cs
@@ -0,0 +1,68 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Events
+    {
+        internal static double ClearingDays(State s, JObject e, string machine)
+        {
+            var size = s.Machine(machine).S("sizeClass");
+            var severity = e.Has("protection") ? e.Obj("severityByProtection").N(e.S("protection"), 1) : 1;
+            // JavaScript Math.round chooses the upper integer at a positive half.
+            return Math.Floor(e.Obj("durationDaysByExcavator").N(size) * severity / CLEARING_DAY_STEP + 0.5) * CLEARING_DAY_STEP;
+        }
+        internal static IEnumerable<(JObject Event, JObject Option)> AvailableResponses(State s) => s.events
+            .Where(e => e.B("fired") && !e.B("resolved") || e.Has("forecast") && s.t >= e.Obj("forecast").N("inboxDay") - 1 && !e.B("resolved"))
+            .SelectMany(e => e.Rows("options").Select(option => (e, option)));
+        internal static void UpdateEvents(State s)
+        {
+            foreach (var e in s.events)
+            {
+                var forecast = e.Obj("forecast");
+                if (forecast != null && !e.B("forecastSent") && s.t >= forecast.N("inboxDay") - 1 - EPS)
+                {
+                    e["forecastSent"] = true;
+                    s.inbox.Add(O("day", forecast.N("inboxDay") - 1, "from", "Forecast", "subject", "Weather", "body", forecast["text"]));
+                }
+                if (!e.B("fired"))
+                {
+                    var trigger = e.Obj("trigger");
+                    var ready = trigger.S("kind") == "day" ? s.t >= trigger.N("day") - 1 - EPS
+                        : trigger.S("kind") == "crewReaches" ? s.crews[trigger.S("crew")].pos >= trigger.N("ft") - EPS
+                        : trigger.S("kind") == "zoneSigned" && s.permits[State.ZoneKey(trigger, "zone")].B("signed");
+                    if (!ready) continue;
+                    e["fired"] = true; e["firedT"] = s.t;
+                    e["protection"] = ProtectionAt(s, e.NullableN("stationFt"))?.Get("kind") ?? JValue.CreateNull();
+                    e["shownCard"] = (e.Has("protection") && e.Has("cardWhenProtected") ? e["cardWhenProtected"] : e["card"]).DeepClone();
+                    e["endsT"] = e.S("type") == "P1" ? JValue.CreateNull() : new JValue(s.t + e.N("durationDays"));
+                    if (e.S("type") == "A2") e["openFt"] = Math.Max(0, s.crews["exc"].pos - s.crews["back"].pos);
+                    s.speed = "slow";
+                    Emit(s, "event", O("eventId", e["id"], "day", s.t, "zone", e["zone"], "stationFt", e["stationFt"], "card", e["shownCard"], "seats", e["visibleTo"]));
+                    Deviations.EventDeviations(s, e);
+                }
+                if (e.B("resolved") || !e.Has("endsT") || s.t < e.N("endsT") - EPS) continue;
+                if (e.S("type") == "A2")
+                {
+                    if (!e.B("rainEnded")) Rain.FinishRain(s, e);
+                    if (s.t < e.N("reworkEndsT") - EPS) continue;
+                }
+                e["resolved"] = true; e["resolvedT"] = s.t;
+            }
+            var index = 0;
+            foreach (var item in s.scenario.Rows("inbox"))
+            {
+                if (!s.inboxDelivered.Contains(index) && s.t >= item.N("day") - 1 - EPS)
+                {
+                    s.inboxDelivered.Add(index);
+                    var delivered = item.Copy(); delivered["day"] = item.N("day") - 1; s.inbox.Add(delivered);
+                }
+                index++;
+            }
+        }
+    }
+}
