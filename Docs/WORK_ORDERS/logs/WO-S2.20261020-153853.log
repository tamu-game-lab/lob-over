diff --git a/Sim/LOBOver.Sim.Tests/PacerTests.cs b/Sim/LOBOver.Sim.Tests/PacerTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..db699c0910cfe525161d8d0b19389fe3c86d18af
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/PacerTests.cs
@@ -0,0 +1,59 @@
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    public sealed class PacerTests
+    {
+        private static Sim Full() => Replay.Create(edit: data => { data["events"] = new JArray(); data["deviations"] = new JArray(); });
+        private static Sim Slow() => Replay.Create(edit: data => data["events"][0]["trigger"] = new JObject { ["kind"] = "day", ["day"] = 1 });
+        [Theory]
+        [InlineData(false, 0.2)]
+        [InlineData(true, 0.05)]
+        public void ElapsedTimeProducesFixedSteps(bool slow, double expected)
+        {
+            var sim = slow ? Slow() : Full(); var callbacks = 0;
+            var pacer = new Pacer(() => sim, () => callbacks++);
+            for (var i = 0; i < 100; i++) { pacer.Advance(10); pacer.Sync(); }
+            Assert.Equal(expected, sim.T, 10); Assert.Equal((int)(expected / Pacer.STEP_DAYS), callbacks);
+        }
+        [Fact]
+        public void StallCapsBacklogAndPreservesOnlyRemainder()
+        {
+            var sim = Full(); var pacer = new Pacer(() => sim);
+            Assert.Equal(20, pacer.Advance(5025)); Assert.Equal(0.2, sim.T, 10);
+            Assert.Equal(0, pacer.Advance(24)); Assert.Equal(1, pacer.Advance(1)); Assert.Equal(0.21, sim.T, 10);
+        }
+        [Fact]
+        public void PauseResumeReplacementAndCloseDiscardInactiveTime()
+        {
+            var sim = Full(); var pacer = new Pacer(() => sim);
+            pacer.Advance(75); Assert.Equal(0.01, sim.T);
+            sim.Apply("facilitator", new JObject { ["action"] = "pause" }); pacer.Sync(); Assert.Equal(0, pacer.Advance(1000));
+            sim.Apply("facilitator", new JObject { ["action"] = "resume" }); pacer.Sync();
+            Assert.Equal(0, pacer.Advance(49)); Assert.Equal(1, pacer.Advance(1));
+            pacer.Advance(25); sim = Full(); pacer.Sync();
+            Assert.Equal(0, pacer.Advance(49)); Assert.Equal(1, pacer.Advance(1));
+            pacer.Close(); Assert.Equal(0, pacer.Advance(1000)); Assert.Equal(0.01, sim.T);
+        }
+        [Fact]
+        public void EventStopsCatchupBeforeNewSpeedTakesEffect()
+        {
+            var sim = Replay.Create(edit: data => data["events"][0]["trigger"] = new JObject { ["kind"] = "day", ["day"] = 1.01 });
+            var pacer = new Pacer(() => sim);
+            Assert.Equal(1, pacer.Advance(500)); Assert.Equal("slow", sim.Speed);
+            Assert.Equal(0, pacer.Advance(199)); Assert.Equal(1, pacer.Advance(1));
+        }
+        [Fact]
+        public void FastCompletionAndReplacementStopCurrentBatch()
+        {
+            var sim = Full(); var callbacks = 0;
+            var pacer = new Pacer(() => sim, () => { if (++callbacks == 10) sim = Full(); });
+            pacer.SetFast(true); Assert.Equal(5, pacer.Advance(10)); Assert.Equal(5, pacer.Advance(30)); Assert.Equal(0, sim.T);
+            Assert.Equal(1, pacer.Advance(2));
+            var finishing = Replay.Create(edit: data => { data["plan"]["budgetUsd"] = 1; data["events"] = new JArray(); });
+            var end = new Pacer(() => finishing); end.SetFast(true);
+            Assert.Equal(1, end.Advance(100)); Assert.True(finishing.Done); Assert.Equal(0, end.Advance(1000));
+        }
+    }
+}
diff --git a/Sim/LOBOver.Sim.Tests/ParityTests.cs b/Sim/LOBOver.Sim.Tests/ParityTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..68751c66487352a758c4a42e753ee3042635bcf7
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/ParityTests.cs
@@ -0,0 +1,57 @@
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    public sealed class ParityTests
+    {
+        public static IEnumerable<object[]> Transcripts() => Replay.Names.Select(name => new object[] { name });
+        [Theory, MemberData(nameof(Transcripts))]
+        public void RecordedJavaScriptTranscriptMatches(string name)
+        {
+            var expected = Replay.Expected(name); var actual = Replay.Run(name).Transcript;
+            Assert.Null(actual["safetyStop"]);
+            var snapshots = (JArray)expected["snapshots"]; Assert.Equal(snapshots.Count, ((JArray)actual["snapshots"]).Count);
+            for (var day = 0; day < snapshots.Count; day++)
+            {
+                var e = snapshots[day]; var a = actual["snapshots"][day]; var path = name + ".day" + day;
+                Replay.Near(e["t"], a["t"], 0.001, path + ".t"); Replay.Equal(e["speed"], a["speed"], path + ".speed");
+                foreach (var id in Replay.CrewIds)
+                {
+                    Replay.Near(e["crews"][id]["pos"], a["crews"][id]["pos"], 1, path + ".crews." + id + ".pos");
+                    Replay.Equal(e["crews"][id]["status"], a["crews"][id]["status"], path + ".crews." + id + ".status");
+                    Replay.Near(e["crews"][id]["mood"], a["crews"][id]["mood"], 0, path + ".crews." + id + ".mood");
+                }
+                Replay.Compare(e["site"]["trench"], a["site"]["trench"], path + ".trench", 0);
+                Replay.Compare(e["site"]["boards"], a["site"]["boards"], path + ".boards", 0);
+                Replay.Compare(e["site"]["truck"], a["site"]["truck"], path + ".truck");
+                Replay.Near(e["spentUsd"], a["spentUsd"], 100, path + ".spentUsd");
+                // Also guard all public fields, including projections, response costs and orders.
+                Replay.Compare(e["plan"], a["plan"], path + ".plan");
+                Replay.Compare(e["site"], a["site"], path + ".site");
+            }
+            var em = ((JArray)expected["messages"]).OfType<JObject>().ToArray(); var am = ((JArray)actual["messages"]).OfType<JObject>().ToArray();
+            Assert.Equal(em.Length, am.Length);
+            for (var i = 0; i < em.Length; i++)
+            {
+                var path = name + ".messages[" + i + "]"; var e = em[i]["message"]; var a = am[i]["message"];
+                Replay.Equal(e["t"], a["t"], path + ".type");
+                Replay.Near(em[i]["t"], am[i]["t"], 0.02, path + ".t");
+                if ((string)e["t"] == "event")
+                { Replay.Equal(e["eventId"], a["eventId"], path + ".eventId"); Replay.Equal(e["card"]["title"], a["card"]["title"], path + ".title"); }
+                if ((string)e["t"] == "nack")
+                { Replay.Equal(e["id"], a["id"], path + ".id"); Replay.Equal(e["reason"], a["reason"], path + ".reason"); }
+                Replay.Compare(e, a, path + ".message");
+            }
+            var er = expected["result"]; var ar = actual["result"];
+            Replay.Equal(er["lost"], ar["lost"], name + ".result.lost");
+            if (er["finishDay"] != null) Replay.Near(er["finishDay"], ar["finishDay"], 0.05, name + ".result.finishDay");
+            Replay.Near(er["idleCrewDays"], ar["idleCrewDays"], 0.1, name + ".result.idleCrewDays");
+            Replay.Near(er["peakOpenTrenchFt"], ar["peakOpenTrenchFt"], 5, name + ".result.peakOpenTrenchFt");
+            foreach (var field in new[] { "finesUsd", "deviationsCaught", "deviationsMissed" }) Replay.Near(er[field], ar[field], 0, name + ".result." + field);
+            Replay.Compare(er, ar, name + ".result");
+        }
+    }
+}
diff --git a/Sim/LOBOver.Sim.Tests/Replay.cs b/Sim/LOBOver.Sim.Tests/Replay.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2f1078ca2fdb9024734640eea0e095df03a9a155
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/Replay.cs
@@ -0,0 +1,94 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    internal static class Replay
+    {
+        // headless.js: fixed tick, script epsilon and safety allowance.
+        internal const double Dt = 0.01, Epsilon = 1e-6, SafetyDays = 5;
+        internal static readonly string[] CrewIds = { "exc", "pipe", "back" };
+        internal static readonly string[] Names = { "slice_play", "slice_pull_play", "slice_autoplan", "stage1_pm_play", "stage2_pull_play", "stage1_noaction" };
+        internal static string Root { get; } = FindRoot();
+        private static string FindRoot()
+        {
+            var directory = new DirectoryInfo(AppContext.BaseDirectory);
+            while (directory != null && !File.Exists(Path.Combine(directory.FullName, "Data", "catalog.json"))) directory = directory.Parent;
+            return directory?.FullName ?? throw new InvalidOperationException("Run from the LOB-OVER checkout");
+        }
+        internal static string Read(string path) => File.ReadAllText(Path.Combine(Root, path));
+        internal static Catalog Catalog() => LOBOver.Sim.Catalog.Load(Read("Data/catalog.json"));
+        internal static Sim Create(string stage = "slice_texas", Action<JObject> edit = null)
+        {
+            var catalog = Catalog(); var data = JObject.Parse(Read("Data/Scenarios/" + stage + ".json")); edit?.Invoke(data);
+            return Sim.Create(Scenario.Load(data.ToString(), catalog), catalog);
+        }
+        internal static JObject Expected(string name) => JObject.Parse(Read("Data/transcripts/" + name + ".json"));
+        internal static (JObject Transcript, JObject Serialized) Run(string name, Action<Sim> inspect = null)
+        {
+            var stage = name.StartsWith("slice", StringComparison.Ordinal) ? "slice_texas" : name.StartsWith("stage1", StringComparison.Ordinal) ? "stage1_texas" : "stage2_texas";
+            var script = name == "stage1_noaction" ? new JArray() : JArray.Parse(Read("Monitor/test/scripts/" + name + ".json"));
+            var commands = script.OfType<JObject>().OrderBy(c => (double)c["t"]).ToArray();
+            var sim = Create(stage); var source = JObject.Parse(Read("Data/Scenarios/" + stage + ".json"));
+            var snapshots = new JArray(); var messages = new JArray();
+            var transcript = new JObject { ["scenario"] = stage, ["seed"] = source["seed"], ["snapshots"] = snapshots, ["messages"] = messages, ["result"] = null };
+            var index = 0; double snapshotDay = -1;
+            void Drain()
+            {
+                foreach (var message in sim.Drain()) messages.Add(new JObject { ["t"] = message["day"] ?? new JValue(sim.T), ["message"] = message });
+            }
+            while (!sim.Done && sim.T <= (double)source["plan"]["deadlineDay"] + SafetyDays)
+            {
+                while (index < commands.Length && (double)commands[index]["t"] <= sim.T + Epsilon)
+                {
+                    var entry = commands[index++]; var cmd = (JObject)entry["cmd"];
+                    var reply = sim.Apply((string)entry["seat"], cmd);
+                    var message = new JObject { ["t"] = reply.Ok ? "ack" : "nack", ["v"] = 1 };
+                    if (cmd["id"] != null) message["id"] = cmd["id"];
+                    foreach (var field in JObject.FromObject(reply).Properties()) message[field.Name] = field.Value.DeepClone();
+                    messages.Add(new JObject { ["t"] = sim.T, ["message"] = message });
+                    Drain();
+                }
+                var day = Math.Floor(sim.T + Epsilon);
+                if (day > snapshotDay) { snapshots.Add(sim.View("facilitator")); snapshotDay = day; inspect?.Invoke(sim); }
+                Drain();
+                if (sim.Speed == "paused") { transcript["safetyStop"] = new JObject { ["t"] = sim.T, ["reason"] = "paused without a same-time resume" }; break; }
+                sim.Tick(Dt); Drain();
+            }
+            transcript["result"] = sim.Result;
+            if (!sim.Done && transcript["safetyStop"] == null) transcript["safetyStop"] = new JObject { ["t"] = sim.T, ["reason"] = "time limit" };
+            return (transcript, sim.Serialize());
+        }
+        internal static void Near(JToken expected, JToken actual, double tolerance, string path)
+        {
+            Assert.True(expected != null && actual != null, path + ": missing value");
+            var e = (double)expected; var a = (double)actual;
+            Assert.True(double.IsFinite(a) && Math.Abs(e - a) <= tolerance, $"{path}: expected {e:R}, actual {a:R}, tolerance {tolerance}");
+        }
+        internal static void Equal(JToken expected, JToken actual, string path)
+        { Assert.True(JToken.DeepEquals(expected, actual), $"{path}: expected {expected?.ToString(Formatting.None) ?? "missing"}, actual {actual?.ToString(Formatting.None) ?? "missing"}"); }
+        internal static void Compare(JToken expected, JToken actual, string path, double numericTolerance = 0.001)
+        {
+            if (expected is JObject obj)
+            {
+                Assert.True(actual is JObject, path + ": expected object");
+                Assert.True(obj.Properties().Select(p => p.Name).OrderBy(x => x).SequenceEqual(((JObject)actual).Properties().Select(p => p.Name).OrderBy(x => x)),
+                    path + ": object keys differ");
+                foreach (var p in obj.Properties()) Compare(p.Value, actual[p.Name], path + "." + p.Name, numericTolerance);
+            }
+            else if (expected is JArray array)
+            {
+                Assert.True(actual is JArray, path + ": expected array");
+                Assert.True(array.Count == ((JArray)actual).Count, path + ": array lengths differ");
+                for (var i = 0; i < array.Count; i++) Compare(array[i], actual[i], path + "[" + i + "]", numericTolerance);
+            }
+            else if (expected?.Type == JTokenType.Float || expected?.Type == JTokenType.Integer) Near(expected, actual, numericTolerance, path);
+            else Equal(expected, actual, path);
+        }
+    }
+}
diff --git a/Sim/LOBOver.Sim.Tests/RngTests.cs b/Sim/LOBOver.Sim.Tests/RngTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1e18eb217f8c67e29b8ac2a5705b01b5efd762b4
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/RngTests.cs
@@ -0,0 +1,29 @@
+using System;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    public sealed class RngTests
+    {
+        [Fact]
+        public void HundredDrawsMatchJavaScriptBitExactly()
+        {
+            var expected = JArray.Parse(Replay.Read("Sim/LOBOver.Sim.Tests/fixtures/rng_seed_20261020.json")); var rng = new Rng(20261020);
+            Assert.Equal(100, expected.Count);
+            foreach (var value in expected) Assert.Equal(BitConverter.DoubleToInt64Bits((double)value), BitConverter.DoubleToInt64Bits(rng.Next()));
+            var resumed = new Rng(rng.State);
+            for (var i = 0; i < 100; i++) Assert.Equal(rng.Next(), resumed.Next());
+        }
+        [Fact]
+        public void InvalidSeedsBoundsAndEmptyPicksAreRejected()
+        {
+            foreach (var seed in new[] { -1d, 0.5, double.NaN, double.PositiveInfinity, 4294967296d }) Assert.Throws<ArgumentOutOfRangeException>(() => new Rng(seed));
+            var rng = new Rng(0);
+            Assert.Throws<ArgumentOutOfRangeException>(() => rng.Int(2, 1));
+            Assert.Throws<ArgumentOutOfRangeException>(() => rng.Int(0, 0.5));
+            Assert.Throws<ArgumentException>(() => rng.Pick(Array.Empty<int>()));
+            Assert.Equal(7, rng.Int(7, 7)); Assert.Equal("only", rng.Pick(new[] { "only" }));
+        }
+    }
+}
diff --git a/Sim/LOBOver.Sim.Tests/ViewFilterTests.cs b/Sim/LOBOver.Sim.Tests/ViewFilterTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c4ff09fe44cdd1e60b2f262cf8d4ce4fdc2a3768
--- /dev/null
+++ b/Sim/LOBOver.Sim.Tests/ViewFilterTests.cs
@@ -0,0 +1,52 @@
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace LOBOver.Sim.Tests
+{
+    public sealed class ViewFilterTests
+    {
+        private static readonly Regex Forbidden = new Regex(@"correct|wrong|score|well done|good job|should have|right choice", RegexOptions.IgnoreCase);
+        public static IEnumerable<object[]> Transcripts() => Replay.Names.Select(name => new object[] { name });
+        [Theory, MemberData(nameof(Transcripts))]
+        public void EveryDayFiltersSeatsAndEveryMessageAvoidsVerdicts(string name)
+        {
+            var run = Replay.Run(name, sim =>
+            {
+                var plan = sim.View("plan"); var site = sim.View("site");
+                var planKeys = plan.DescendantsAndSelf().OfType<JProperty>().Select(p => p.Name).ToArray();
+                foreach (var key in new[] { "pos", "crews", "truck", "trench", "activeEvent", "hiddenVariant" }) Assert.DoesNotContain(key, planKeys);
+                var siteKeys = site.DescendantsAndSelf().OfType<JProperty>().Select(p => p.Name).ToArray();
+                foreach (var key in new[] { "budget", "budgetUsd", "spentUsd", "committedUsd", "plannedLines", "uncertainty", "cost" }) Assert.DoesNotContain(key, siteKeys);
+                Assert.False(Forbidden.IsMatch(plan.ToString(Formatting.None)), name + ": Plan contains verdict text");
+                Assert.False(Forbidden.IsMatch(site.ToString(Formatting.None)), name + ": Site contains verdict text");
+                var typedPlan = PlanView.From(plan); var typedSite = SiteView.From(site);
+                Assert.Equal(3, typedSite.crews.Count);
+                Assert.Equal((double)site["truck"]["stationFt"], typedSite.truck.stationFt);
+                Assert.Equal((double)plan["budget"]["spentUsd"], typedPlan.budget.spentUsd);
+                Assert.Equal(((JArray)site["trench"]).Count, typedSite.trench.Count);
+                Assert.Equal(((JArray)plan["radioLog"]).Count, typedPlan.radioLog.Count);
+                var active = site["activeEvent"] as JObject;
+                Assert.Equal((string)active?["card"]?["title"], typedSite.activeEvent?.card.title);
+            });
+            foreach (var envelope in run.Transcript["messages"])
+                Assert.False(Forbidden.IsMatch(envelope["message"].ToString(Formatting.None)), name + ": message contains verdict text");
+        }
+        [Fact]
+        public void PlanReportsStayHistoricalWhileSiteMoves()
+        {
+            var sim = Replay.Create("stage1_texas");
+            sim.Tick(1);
+            var report = sim.View("plan")["reportedLines"].DeepClone();
+            var before = (double)sim.View("site")["crews"][0]["stationFt"];
+            sim.Tick(0.25);
+            Assert.True((double)sim.View("site")["crews"][0]["stationFt"] > before);
+            Assert.True(JToken.DeepEquals(report, sim.View("plan")["reportedLines"]));
+            sim.Tick(0.75);
+            Assert.False(JToken.DeepEquals(report, sim.View("plan")["reportedLines"]));
+        }
+    }
+}
