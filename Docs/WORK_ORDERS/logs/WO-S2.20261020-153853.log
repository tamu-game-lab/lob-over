diff --git a/Assets/LOBOver/Sim/Money.cs b/Assets/LOBOver/Sim/Money.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c5e49782881ada1fe9eff17cc33b30e1b1fa295f
--- /dev/null
+++ b/Assets/LOBOver/Sim/Money.cs
@@ -0,0 +1,35 @@
+using System.Linq;
+using static LOBOver.Sim.Common;
+
+namespace LOBOver.Sim
+{
+    internal static class Money
+    {
+        internal static bool Billing(State s, Crew c) => s.t >= c.startDay - 1 - EPS && (c.finishT == null || c.finishT > s.t + EPS)
+            && !(c.demobBillingEndsT != null && s.t >= c.demobBillingEndsT - EPS);
+        internal static void Accrue(State s, double dt)
+        {
+            var overhead = 1 + s.Rules.N("overheadRate");
+            double crewDaily = 0;
+            foreach (var id in CREW_IDS)
+            {
+                var c = s.crews[id];
+                if (Billing(s, c)) { c.onsite += dt; crewDaily += s.Machine(c.machine).N("dailyUsd"); }
+            }
+            double protectionDaily = 0;
+            foreach (var p in s.protections)
+                if (CREW_IDS.Any(id => { var c = s.crews[id]; return c.mult > 0 && c.moved > EPS && c.pos >= p.N("fromFt") && c.pos <= p.N("toFt"); }))
+                    protectionDaily += s.catalog.Obj("protection").Obj(p.S("kind")).N("dailyUsd");
+            double hiredDaily = 0, optionDaily = 0;
+            foreach (var d in s.deliveries.Where(d => d.B("hired") && d.B("arrived") && !d.B("released"))) hiredDaily += s.Machine(d.S("machine")).N("dailyUsd");
+            foreach (var p in s.payments) optionDaily += p.N("perDayUsd");
+            s.crewCostUsd += crewDaily * dt * overhead;
+            s.spentUsd += (crewDaily + protectionDaily + hiredDaily) * dt * overhead + optionDaily * dt;
+        }
+        internal static void BuyMachine(State s, string machine) => s.spentUsd += s.Machine(machine).N("priceUsd") + s.Rules.N("mobilizationUsd");
+        internal static void ReleaseMachine(State s, string machine)
+        {
+            if (machine != null) s.spentUsd -= s.Machine(machine).N("priceUsd") * s.catalog.Obj("orders").N("releaseRefundFraction");
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Orders.cs b/Assets/LOBOver/Sim/Orders.cs
new file mode 100644
index 0000000000000000000000000000000000000000..14f2df06e20e20f52f92f3b22691885a7af9735c
--- /dev/null
+++ b/Assets/LOBOver/Sim/Orders.cs
@@ -0,0 +1,206 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Orders
+    {
+        private static readonly HashSet<string> OFFICE_OPS = new HashSet<string> { "setStart", "enterPermit", "enterInspection", "pay" };
+        private static readonly HashSet<string> CREW_OPS = new HashSet<string> { "setStart", "hold", "resume", "demob", "remob" };
+        private static readonly HashSet<string> PLAN_OPS = new HashSet<string>(CREW_OPS.Concat(OFFICE_OPS).Concat(new[] { "lend", "order", "protect", "radio" }));
+        private static bool Positive(JObject op, string key) => op.Finite(key) && op.N(key) > 0;
+        private static bool Owns(JObject obj, string key) => key != null && !key.StartsWith("_", StringComparison.Ordinal) && obj.Property(key) != null;
+        private static string OwnerOf(State s, string machine) => CREW_IDS.FirstOrDefault(id => s.crews[id].machine == machine);
+        private static bool MachineCommitted(State s, string machine) => s.orders.Any(order => order.Obj("op").S("op") == "lend"
+            && order.Obj("op").S("machine") == machine && !order.Has("appliedT"));
+        internal static double LandingTime(State s, string crew) => s.pure || crew != null && Nearby(s, s.crews[crew].pos) ? s.t : NextBoundary(s.t);
+        internal static string ValidateOp(State s, JObject op)
+        {
+            if (op == null || !PLAN_OPS.Contains(op.S("op"))) return "unknown operation";
+            var name = op.S("op"); var crewId = op.S("crew");
+            if (CREW_OPS.Contains(name) && !CREW_IDS.Contains(crewId)) return "unknown crew";
+            var c = crewId != null && s.crews.TryGetValue(crewId, out var crew) ? crew : null;
+            if (name == "setStart")
+            {
+                if (s.Plan.B("locked") || c.locked) return "plan locked";
+                if (s.t >= c.startDay - 1 - EPS) return "crew already started";
+                if (!op.Integer("day") || op.N("day") < DisplayDay(s.t)) return "invalid start day";
+            }
+            if (name == "hold" && (op.Has("days") && !Positive(op, "days")
+                || op.Has("fromDay") && (!op.Integer("fromDay") || op.N("fromDay") < DisplayDay(s.t)))) return "invalid hold";
+            if (name == "lend")
+            {
+                if (MachineCommitted(s, op.S("machine"))) return "machine already committed";
+                var owner = OwnerOf(s, op.S("machine"));
+                if (owner == null || s.crews[owner].lentAway || s.loans.Any(l => l.S("fromCrew") == owner && l.S("phase") != "returned")) return "machine unavailable";
+                if (!CREW_IDS.Contains(op.S("toCrew")) || op.S("toCrew") == owner || !Positive(op, "days")) return "invalid lend";
+            }
+            if (name == "protect" || name == "order")
+            {
+                if (!s.Plan.B("preparationAllowed")) return "not in the budget";
+                if (name == "order")
+                {
+                    if (!Owns(s.catalog.Obj("machines"), op.S("machine"))) return "unknown machine";
+                    if (op.B("rush")) return "rush unavailable";
+                }
+                else
+                {
+                    if (!Owns(s.catalog.Obj("protection"), op.S("kind"))) return "unknown protection";
+                    var protection = s.catalog.Obj("protection").Obj(op.S("kind"));
+                    if (protection.B("reactOnly")) return "no such response now";
+                    if (op.S("kind") == "trench_slope" && (s.City.B("slopeRefused") || protection.Includes("refusedInCities", s.scenario.S("city")))) return "slope refused";
+                    if (!op.Finite("fromFt") || !op.Finite("toFt") || op.N("fromFt") < 0 || op.N("toFt") > s.Length || op.N("fromFt") >= op.N("toFt")) return "invalid stretch";
+                }
+            }
+            if (name == "pay")
+            {
+                if (op.S("item") == "clear_own" && MachineCommitted(s, s.crews["exc"].machine)) return "machine already committed";
+                if (!Events.AvailableResponses(s).Any(r => r.Option.S("key") == op.S("item"))) return "no such response now";
+                if (op.S("item") == "hire_excavator" && (!Owns(s.catalog.Obj("machines"), op.S("machine")) || s.Machine(op.S("machine")).S("crew") != "exc")) return "unknown machine";
+                if (op.S("item") == "clear_own" && s.crews["exc"].lentAway) return "machine unavailable";
+            }
+            if (name == "enterPermit") return Permits.ValidatePermit(s, op);
+            if (name == "enterInspection") return Permits.ValidateInspection(s, op);
+            if (name == "radio" && !s.orders.Any(order => order.S("id") == op.S("orderId"))) return "order not on file";
+            return null;
+        }
+        private static void StartLoan(State s, JObject op)
+        {
+            var fromCrew = OwnerOf(s, op.S("machine"));
+            var e = fromCrew == "exc" && op.S("toCrew") == "pipe" ? ActiveCollapse(s) : null;
+            s.loans.Add(O("machine", op["machine"], "fromCrew", fromCrew, "toCrew", op["toCrew"], "phase", "outbound",
+                "arrivesT", s.t + TravelDays(s.crews[fromCrew].pos, s.crews[op.S("toCrew")].pos), "days", op["days"], "eventId", e?.Get("id")));
+            s.crews[fromCrew].lentAway = true;
+            if (e != null) e["option"] = "clear_own";
+            Deviations.FirstLend(s);
+        }
+        private static void Purchase(State s, string machine, JObject e = null)
+        {
+            Money.BuyMachine(s, machine);
+            s.deliveries.Add(O("machine", machine, "crew", s.Machine(machine)["crew"], "issuedT", s.t,
+                "arrivesT", s.t + s.Machine(machine).Obj("leadDays").N("normal") + s.City.N("leadDelayDays"),
+                "hired", e != null, "eventId", e?.Get("id"), "arrived", false, "released", false));
+        }
+        private static void Pay(State s, JObject op)
+        {
+            var response = Events.AvailableResponses(s).First(r => r.Option.S("key") == op.S("item"));
+            var e = response.Event; var option = response.Option; var effect = option.Obj("effect");
+            e["option"] = op["item"];
+            if (op.S("item") == "hire_excavator") { Purchase(s, op.S("machine"), e); return; }
+            s.spentUsd += option.Obj("cost").N("usd");
+            s.payments.Add(O("item", op["item"], "paidT", s.t, "perDayUsd", option.Obj("cost")["perDayUsd"]));
+            if (effect.Has("lend"))
+            {
+                var fromCrew = effect.Obj("lend").S("machineOf");
+                IssueOrder(s, O("op", "lend", "machine", s.crews[fromCrew].machine, "toCrew", effect.Obj("lend")["toCrew"],
+                    "days", Events.ClearingDays(s, e, s.crews[fromCrew].machine)));
+            }
+            if (effect.Has("resumeAfterDays")) e["endsT"] = s.t + effect.N("resumeAfterDays");
+            if (effect.Has("rainRateRestore"))
+            { e["pumpPaidT"] = s.t; e["restore"] = effect["rainRateRestore"].DeepClone(); e["reworkMultiplier"] = effect["reworkMultiplier"]; }
+        }
+        private static void ApplyLanded(State s, JObject order)
+        {
+            var op = order.Obj("op"); var name = op.S("op");
+            var c = order.S("crew") == null ? null : s.crews[order.S("crew")];
+            if (name == "hold")
+            {
+                var fromT = Math.Max(s.t, op.Has("fromDay") ? op.N("fromDay") - 1 : s.t);
+                c.hold = O("fromT", fromT, "untilT", op.Has("days") ? (double?)(fromT + op.N("days")) : null);
+                c.arguing = false; c.stop = null;
+            }
+            else if (name == "resume") { c.hold = null; c.stop = null; }
+            else if (name == "lend") StartLoan(s, op);
+            else if (name == "protect") s.protections.Add(O("kind", op["kind"], "fromFt", op["fromFt"], "toFt", op["toFt"], "placedT", s.t));
+            else if (name == "demob") { c.demobilized = true; c.demobBillingEndsT = NextBoundary(s.t); c.arguing = false; }
+            else if (name == "remob") c.remobT = s.t + s.City.N("remobilizationDelayDays");
+            order["appliedT"] = s.t;
+        }
+        internal static void IssueOrder(State s, JObject op)
+        {
+            var name = op.S("op");
+            if (name == "radio")
+            {
+                var previous = s.orders.First(order => order.S("id") == op.S("orderId"));
+                previous["issuedT"] = s.t; previous["landsT"] = LandingTime(s, previous.S("crew"));
+                previous["status"] = "sent"; previous["ignored"] = false; previous["reissued"] = true;
+                previous["alreadyApplied"] = previous.Has("appliedT");
+                return;
+            }
+            var crew = op.S("crew") ?? (name == "lend" ? OwnerOf(s, op.S("machine"))
+                : name == "order" ? s.Machine(op.S("machine")).S("crew") : name == "protect" ? "exc" : null);
+            var order = O("id", "o-" + s.nextOrderId++, "op", op, "crew", crew, "issuedT", s.t,
+                "landsT", OFFICE_OPS.Contains(name) ? s.t : LandingTime(s, crew), "status", "sent");
+            s.orders.Add(order);
+            Planning.ProjectOrder(s, order);
+            if (!s.pure) Deviations.MarkFirstRadio(s, order);
+            if (name == "protect") s.spentUsd += s.catalog.Obj("protection").Obj(op.S("kind")).N("priceUsd");
+            if (name == "order") Purchase(s, op.S("machine"));
+            if (name == "remob") s.spentUsd += s.Rules.N("demobFeeUsd");
+            if (name == "hold") Voice(s, "holdCommitted", new[] { "plan" });
+            if (name == "demob") Voice(s, "demobCommitted", new[] { "plan" });
+            if (!OFFICE_OPS.Contains(name)) return;
+            if (name == "setStart")
+            {
+                s.crews[op.S("crew")].startDay = op.N("day");
+                s.plannedLines[op.S("crew")]["startDay"] = op["day"];
+                s.plannedLines[op.S("crew")]["segments"][0]["fromT"] = op.N("day") - 1;
+            }
+            else if (name == "enterPermit") s.permits[State.ZoneKey(op, "zone")]["entered"] = true;
+            else if (name == "enterInspection") { s.inspections[State.ZoneKey(op, "zone")]["cleared"] = true; Permits.UpdateHoldPoints(s); }
+            else if (name == "pay") Pay(s, op);
+            order["appliedT"] = s.t; order["landedT"] = s.t; order["status"] = "landed";
+        }
+        internal static void UpdateOrders(State s)
+        {
+            foreach (var order in s.orders)
+            {
+                if (order.S("status") != "sent" || s.t < order.N("landsT") - EPS) continue;
+                order["status"] = "landed"; order["landedT"] = s.t;
+                Voice(s, "orderLanded", new[] { "plan" });
+                if (!order.B("ignored") && !order.B("alreadyApplied")) ApplyLanded(s, order);
+            }
+            foreach (var loan in s.loans)
+            {
+                if (loan.S("phase") == "outbound" && s.t >= loan.N("arrivesT") - EPS)
+                {
+                    loan["phase"] = "working";
+                    var e = s.events.FirstOrDefault(e => e.S("id") == loan.S("eventId"));
+                    loan["returnsT"] = s.t + (e != null ? Events.ClearingDays(s, e, loan.S("machine")) : loan.N("days"));
+                    if (e != null) { e["clearingT"] = s.t; e["endsT"] = loan["returnsT"]; }
+                }
+                if (loan.S("phase") == "working" && s.t >= loan.N("returnsT") - EPS)
+                {
+                    loan["phase"] = "returning";
+                    loan["homeT"] = s.t + TravelDays(s.crews[loan.S("toCrew")].pos, s.crews[loan.S("fromCrew")].pos);
+                }
+                if (loan.S("phase") == "returning" && s.t >= loan.N("homeT") - EPS)
+                { loan["phase"] = "returned"; s.crews[loan.S("fromCrew")].lentAway = false; }
+            }
+            foreach (var delivery in s.deliveries)
+            {
+                if (!delivery.B("arrived") && s.t >= delivery.N("arrivesT") - EPS)
+                {
+                    delivery["arrived"] = true;
+                    if (delivery.B("hired"))
+                    {
+                        var e = s.events.First(e => e.S("id") == delivery.S("eventId"));
+                        e["clearingT"] = s.t; e["endsT"] = s.t + Events.ClearingDays(s, e, delivery.S("machine"));
+                        delivery["releaseT"] = e["endsT"];
+                    }
+                    else
+                    {
+                        var crew = s.crews[delivery.S("crew")];
+                        Money.ReleaseMachine(s, crew.machine); crew.machine = delivery.S("machine");
+                    }
+                }
+                if (delivery.B("hired") && delivery.B("arrived") && !delivery.B("released") && s.t >= delivery.N("releaseT") - EPS)
+                { delivery["released"] = true; Money.ReleaseMachine(s, delivery.S("machine")); }
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Permits.cs b/Assets/LOBOver/Sim/Permits.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c17f74d4321dcf202b408fe80c3ffea3f684355f
--- /dev/null
+++ b/Assets/LOBOver/Sim/Permits.cs
@@ -0,0 +1,51 @@
+using System;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Permits
+    {
+        internal static string ValidatePermit(State s, JObject op)
+        {
+            var card = s.scenario.Obj("permits").Rows("cards").FirstOrDefault(c => JToken.DeepEquals(c["zone"], op["zone"]));
+            if (card == null || !JToken.DeepEquals(card["code"], op["code"])) return "code not on file";
+            if (!s.permits[State.ZoneKey(op, "zone")].B("entered") && s.Zones.Count(z => s.permits[State.ZoneKey(z)].B("entered") && !s.permits[State.ZoneKey(z)].B("signed"))
+                >= s.scenario.Obj("permits").N("openZoneLimit")) return "city limit: " + F(s.scenario.Obj("permits").N("openZoneLimit")) + " zones open";
+            return null;
+        }
+        internal static string ValidateInspection(State s, JObject op)
+        {
+            var card = s.scenario.Obj("inspections").Rows("cards").FirstOrDefault(c => JToken.DeepEquals(c["zone"], op["zone"]));
+            return card == null || !JToken.DeepEquals(card["number"], op["number"]) ? "code not on file" : null;
+        }
+        internal static double ExcavationLimit(State s, double desired)
+        {
+            var zone = s.Zones.FirstOrDefault(z => !s.permits[State.ZoneKey(z)].B("entered"));
+            if (zone == null) return s.Length;
+            var limit = zone.N("fromFt");
+            if (desired >= limit - EPS && s.crews["exc"].pos >= limit - EPS) limit = Deviations.BoundaryAllowance(s, zone);
+            return Math.Max(s.crews["exc"].pos, limit);
+        }
+        internal static double BackfillLimit(State s) => !s.scenario.Obj("inspections").B("required") ? s.Length
+            : s.Zones.FirstOrDefault(z => !s.inspections[State.ZoneKey(z)].B("cleared")).N("toFt", s.Length);
+        internal static void UpdateHoldPoints(State s)
+        {
+            foreach (var zone in s.Zones)
+            {
+                var inspection = s.inspections[State.ZoneKey(zone)];
+                if (s.crews["back"].pos < zone.N("toFt") - EPS) continue;
+                if (!inspection.B("reported") && s.scenario.Obj("inspections").B("required"))
+                {
+                    inspection["reported"] = true;
+                    // WO-02: both authored Texas stages use this compaction fact.
+                    s.inbox.Add(O("day", s.t, "from", "City inspector", "subject", "Zone " + F(zone.N("id")) + " compaction", "body", "passed"));
+                }
+                if (inspection.B("cleared") || !s.scenario.Obj("inspections").B("required")) s.permits[State.ZoneKey(zone)]["signed"] = true;
+            }
+        }
+        internal static bool FinalInspectionEntered(State s) => !s.scenario.Obj("inspections").B("required") || s.inspections[State.ZoneKey(s.Zones.Last())].B("cleared");
+    }
+}
diff --git a/Assets/LOBOver/Sim/Planning.cs b/Assets/LOBOver/Sim/Planning.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ffbbd9907562b85452c19c31e735ede56494485c
--- /dev/null
+++ b/Assets/LOBOver/Sim/Planning.cs
@@ -0,0 +1,91 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Planning
+    {
+        // Issued instructions and catalog rates, never live crew positions.
+        internal static double PlannedRate(JObject line, double t)
+        {
+            if (t < line.N("startDay") - 1) return 0;
+            if (line.Rows("holds").Any(h => t >= h.N("fromT") && (!h.Has("untilT") || t < h.N("untilT")))) return 0;
+            var segment = line.Rows("segments").OrderBy(x => x.N("fromT")).LastOrDefault(x => x.N("fromT") <= t);
+            double extra = 0;
+            foreach (var loan in line.Rows("loans").Where(l => t >= l.N("fromT") && t < l.N("untilT"))) extra += loan.N("rate");
+            return segment.N("rate", line.N("rate")) + extra;
+        }
+        internal static JObject PlannedPolylines(State s)
+        {
+            var result = new JObject();
+            foreach (var id in CREW_IDS)
+            {
+                var line = s.plannedLines[id];
+                var breaks = new List<double> { line.N("startDay") - 1 };
+                breaks.AddRange(line.Rows("segments").Select(x => x.N("fromT")));
+                foreach (var h in line.Rows("holds")) { breaks.Add(h.N("fromT")); if (h.Has("untilT")) breaks.Add(h.N("untilT")); }
+                foreach (var loan in line.Rows("loans")) { breaks.Add(loan.N("fromT")); breaks.Add(loan.N("untilT")); }
+                breaks = breaks.Distinct().Where(t => t >= line.N("startDay") - 1).OrderBy(t => t).ToList();
+                var time = line.N("startDay") - 1; double ft = 0;
+                var points = new JArray(O("t", time, "ft", ft));
+                var complete = false;
+                foreach (var next in breaks.Skip(1))
+                {
+                    var rate = PlannedRate(line, time);
+                    if (rate > 0 && ft + (next - time) * rate >= s.Length)
+                    {
+                        points.Add(O("t", time + (s.Length - ft) / rate, "ft", s.Length));
+                        complete = true; break;
+                    }
+                    ft += (next - time) * rate; time = next; points.Add(O("t", time, "ft", ft));
+                }
+                if (!complete)
+                {
+                    var rate = PlannedRate(line, time + EPS);
+                    if (rate > 0) points.Add(O("t", time + (s.Length - ft) / rate, "ft", s.Length));
+                    else if (s.t > time) points.Add(O("t", s.t, "ft", ft));
+                }
+                result[id] = points;
+            }
+            return result;
+        }
+        internal static void ProjectOrder(State s, JObject order)
+        {
+            var op = order.Obj("op");
+            var line = order.S("crew") == null ? null : s.plannedLines[order.S("crew")];
+            var name = op.S("op");
+            if (name == "hold" || name == "demob")
+            {
+                var fromT = Math.Max(order.N("landsT"), op.Has("fromDay") ? op.N("fromDay") - 1 : order.N("landsT"));
+                ((JArray)line["holds"]).Add(O("fromT", fromT, "untilT", op.Has("days") ? (double?)(fromT + op.N("days")) : null, "kind", name));
+            }
+            if (name == "resume" || name == "remob")
+            {
+                var untilT = order.N("landsT") + (name == "remob" ? s.City.N("remobilizationDelayDays") : 0);
+                foreach (var hold in line.Rows("holds"))
+                    if ((name == "resume" ? hold.S("kind") == "hold" : hold.S("kind") == "demob") && (!hold.Has("untilT") || hold.N("untilT") > untilT))
+                        hold["untilT"] = Math.Max(hold.N("fromT"), untilT);
+            }
+            if (name == "order")
+            {
+                var machine = s.Machine(op.S("machine"));
+                ((JArray)line["segments"]).Add(O("fromT", order.N("issuedT") + machine.Obj("leadDays").N("normal") + s.City.N("leadDelayDays"), "rate", machine.N("rateFtPerDay")));
+            }
+            if (name == "lend")
+            {
+                var fromT = order.N("landsT"); var untilT = fromT + op.N("days");
+                ((JArray)line["holds"]).Add(O("fromT", fromT, "untilT", untilT, "kind", "lend"));
+                if (!s.events.Any(e => e.S("type") == "P1" && e.B("fired") && !e.B("resolved") && order.S("crew") == "exc" && op.S("toCrew") == "pipe"))
+                {
+                    var recipient = s.plannedLines[op.S("toCrew")];
+                    if (!recipient.Has("loans")) recipient["loans"] = new JArray();
+                    ((JArray)recipient["loans"]).Add(O("fromT", fromT, "untilT", untilT, "rate", s.Machine(op.S("machine")).N("rateFtPerDay")));
+                }
+            }
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Rain.cs b/Assets/LOBOver/Sim/Rain.cs
new file mode 100644
index 0000000000000000000000000000000000000000..466a17a20b472ab502fa3ed1531c2413849247d4
--- /dev/null
+++ b/Assets/LOBOver/Sim/Rain.cs
@@ -0,0 +1,34 @@
+using System;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace LOBOver.Sim
+{
+    internal static class Rain
+    {
+        private const double REWORK_CHUNK_FT = 500; // WO-02 A2: commenced 500 ft.
+        internal static double ReworkDuration(double openFt, double daysPer500Ft, double multiplier = 1)
+            => Math.Ceiling(openFt / REWORK_CHUNK_FT) * daysPer500Ft * multiplier;
+        internal static double RainMultiplier(State s, string crewId)
+        {
+            double mult = 1;
+            foreach (var e in s.events.Where(e => e.S("type") == "A2" && e.B("fired") && !e.B("rainEnded")))
+                mult *= e.Includes("restore", crewId) ? 1 : 1 - e.N("rateDrop");
+            return mult;
+        }
+        internal static void FinishRain(State s, JObject e)
+        {
+            e["rainEnded"] = true;
+            e["reworkDays"] = ReworkDuration(e.N("openFt"), e.Obj("rework").N("daysPer500Ft", s.Rules.N("rainReworkDaysPer500Ft")),
+                e.Obj("rework").B("pumpHalves") && e.Has("pumpPaidT") && e.N("pumpPaidT") < e.N("endsT") ? e.N("reworkMultiplier") : 1);
+            e["reworkEndsT"] = e.N("endsT") + e.N("reworkDays");
+        }
+        internal static bool RainOrRework(State s) => s.events.Any(e => e.S("type") == "A2" && e.B("fired") && !e.B("resolved"));
+        internal static bool PipeReworking(State s) => s.events.Any(e => e.S("type") == "A2" && e.B("rainEnded") && !e.B("resolved"));
+        internal static string Sky(State s)
+        {
+            if (s.events.Any(e => e.S("type") == "A2" && e.B("fired") && !e.B("rainEnded"))) return "rain";
+            return s.events.Any(e => !e.B("fired") && e.Has("forecast") && s.t >= e.Obj("forecast").N("skyFromDay") - 1) ? "towersSouth" : "clear";
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Rng.cs b/Assets/LOBOver/Sim/Rng.cs
new file mode 100644
index 0000000000000000000000000000000000000000..dcb04c448d7fec4a1cfdbb382b4f7db7d3d16019
--- /dev/null
+++ b/Assets/LOBOver/Sim/Rng.cs
@@ -0,0 +1,43 @@
+using System;
+using System.Collections.Generic;
+
+namespace LOBOver.Sim
+{
+    public sealed class Rng
+    {
+        // Monitor/src/common/rng.js: Mulberry32's unsigned word and divisor.
+        private const uint Increment = 0x6d2b79f5;
+        private const double WordRange = 0x100000000;
+        private const double MaxSafeInteger = 9007199254740991;
+        public uint State { get; private set; }
+        public Rng(double seed)
+        {
+            if (!double.IsFinite(seed) || seed != Math.Floor(seed) || seed < 0 || seed > uint.MaxValue)
+                throw new ArgumentOutOfRangeException(nameof(seed), "RNG seed must be an unsigned 32-bit integer");
+            State = (uint)seed;
+        }
+        public double Next()
+        {
+            unchecked
+            {
+                State += Increment;
+                var value = State;
+                value = (value ^ (value >> 15)) * (value | 1);
+                value ^= value + (value ^ (value >> 7)) * (value | 61);
+                return (value ^ (value >> 14)) / WordRange;
+            }
+        }
+        public double Int(double lo, double hi)
+        {
+            bool Safe(double n) => double.IsFinite(n) && n == Math.Floor(n) && Math.Abs(n) <= MaxSafeInteger;
+            if (!Safe(lo) || !Safe(hi) || lo > hi || !Safe(hi - lo + 1))
+                throw new ArgumentOutOfRangeException(nameof(lo), "RNG integer bounds must be ordered safe integers");
+            return lo + Math.Floor(Next() * (hi - lo + 1));
+        }
+        public T Pick<T>(IReadOnlyList<T> array)
+        {
+            if (array == null || array.Count == 0) throw new ArgumentException("RNG pick requires a non-empty array");
+            return array[(int)Int(0, array.Count - 1)];
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Scenario.cs b/Assets/LOBOver/Sim/Scenario.cs
new file mode 100644
index 0000000000000000000000000000000000000000..497ab69c58e2af71e463d5e079ea688c9df86a55
--- /dev/null
+++ b/Assets/LOBOver/Sim/Scenario.cs
@@ -0,0 +1,41 @@
+using System;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace LOBOver.Sim
+{
+    public sealed class Catalog
+    {
+        internal JObject Data { get; }
+        private Catalog(JObject data) { Data = data; }
+        public static Catalog Load(string json) => new Catalog(JObject.Parse(json));
+    }
+
+    public sealed class Scenario
+    {
+        internal JObject Data { get; }
+        private Scenario(JObject data) { Data = data; }
+        public static Scenario Load(string json, Catalog catalog)
+        {
+            if (catalog == null) throw new ArgumentNullException(nameof(catalog));
+            var data = JObject.Parse(json);
+            var job = data.Obj("job") ?? throw new ArgumentException("Scenario requires job");
+            // WO-01 loader-derived JSON fields; functions are not part of serialization.
+            const double StationEveryFt = 100;
+            var stations = new JArray();
+            if (!job.Finite("lengthFt") || job.N("lengthFt") <= 0) throw new ArgumentException("Invalid job.lengthFt");
+            for (double ft = 0; ft <= job.N("lengthFt"); ft += StationEveryFt) stations.Add(ft);
+            data["stations"] = stations;
+            double dailyFleetUsd = 0;
+            foreach (var id in Common.CREW_IDS)
+            {
+                var crew = data.Rows("crews").FirstOrDefault(c => c.S("id") == id) ?? throw new ArgumentException("Missing crew " + id);
+                var machine = catalog.Data.Obj("machines").Obj(crew.S("machine"));
+                // The full model also supports a crew whose own machine is absent.
+                if (machine != null) dailyFleetUsd += machine.N("dailyUsd");
+            }
+            data["dailyFleetUsd"] = dailyFleetUsd;
+            return new Scenario(data);
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Sim.cs b/Assets/LOBOver/Sim/Sim.cs
new file mode 100644
index 0000000000000000000000000000000000000000..ebc4b20417f2580d545d6fcfed21efc4ff45116c
--- /dev/null
+++ b/Assets/LOBOver/Sim/Sim.cs
@@ -0,0 +1,227 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    public sealed class ApplyResult
+    {
+        [JsonProperty("ok")] public bool Ok { get; }
+        [JsonProperty("appliedDay", NullValueHandling = NullValueHandling.Ignore)] public double? AppliedDay { get; }
+        [JsonProperty("reason", NullValueHandling = NullValueHandling.Ignore)] public string Reason { get; }
+        internal ApplyResult(double day) { Ok = true; AppliedDay = day; }
+        internal ApplyResult(string reason) { Reason = reason; }
+    }
+
+    public sealed class Sim
+    {
+        private State state;
+        private readonly JObject source, fleet;
+        private readonly bool pure;
+        public double T => state.t;
+        public string Speed => state.speed;
+        public bool Done => state.done;
+        public JObject Result => state.result.Copy();
+
+        // WO-05a: alternatives to these authored switches are intentionally unsupported.
+        private static readonly JObject SUPPORTED_RULES = O("orderLagShifts", 1, "heldCrewBills", true,
+            "conflictRule", "crossWithinNextDay", "conflictBehaviour", "stopAndArgue", "unpermittedBoundary", "idleAndBill",
+            "pumpHalvesRework", true, "likelihoodRollsApply", false);
+        private const double SUPPORTED_SHIFTS_PER_DAY = 1;
+        private const int TIME_DECIMALS = 10; // sim.js quantizes tick boundary arithmetic.
+
+        private Sim(Scenario scenario, Catalog catalog, bool pure)
+        {
+            source = scenario.Data.Copy(); fleet = catalog.Data.Copy(); this.pure = pure;
+            foreach (var rule in SUPPORTED_RULES.Properties())
+            {
+                var actual = source.Obj("rules").Get(rule.Name);
+                if (pure && actual == null) continue;
+                var matches = rule.Value.Type == JTokenType.Integer ? source.Obj("rules").Finite(rule.Name) && source.Obj("rules").N(rule.Name) == (double)rule.Value
+                    : JToken.DeepEquals(actual, rule.Value);
+                if (!matches) throw new ArgumentException("Unsupported rules." + rule.Name + ": expected " + rule.Value.ToString(Formatting.None)
+                    + ", got " + (actual?.ToString(Formatting.None) ?? "undefined"));
+            }
+            var time = source.Obj("time");
+            if (!(pure && time.Get("shiftsPerDay") == null) && (!time.Finite("shiftsPerDay") || time.N("shiftsPerDay") != SUPPORTED_SHIFTS_PER_DAY))
+                throw new ArgumentException("Unsupported time.shiftsPerDay: expected 1, got " + (time.Get("shiftsPerDay")?.ToString(Formatting.None) ?? "undefined"));
+            state = InitialState(source, fleet, pure);
+        }
+        public static Sim Create(Scenario scenario, Catalog catalog, bool pure = false)
+        {
+            if (scenario == null) throw new ArgumentNullException(nameof(scenario));
+            if (catalog == null) throw new ArgumentNullException(nameof(catalog));
+            return new Sim(scenario, catalog, pure);
+        }
+        private static State InitialState(JObject scenario, JObject catalog, bool pure)
+        {
+            var s = new State { scenario = scenario, catalog = catalog, pure = pure, rngState = new Rng(scenario.N("seed")).State,
+                capFt = scenario.NullableN("capFt"), truck = O("stationFt", 0, "moving", false, "dismounted", false),
+                events = scenario.Rows("events").Select(e => e.Copy()).ToList(), deviations = scenario.Rows("deviations").Select(d => d.Copy()).ToList() };
+            foreach (var id in CREW_IDS)
+            {
+                var authored = scenario.Rows("crews").First(c => c.S("id") == id);
+                var c = new Crew { id = id, name = authored.S("name"), machine = authored.S("machine"), startDay = authored.N("startDay"), locked = authored.B("locked"),
+                    rate = s.Machine(authored.S("machine")).N("rateFtPerDay") };
+                s.crews[id] = c;
+                s.actualLines[id] = new List<JObject> { O("t", 0, "ft", 0) };
+                s.reportedLines[id] = new List<JObject> { O("t", 0, "ft", 0) };
+                s.plannedLines[id] = O("startDay", c.startDay, "rate", c.rate, "holds", new JArray(), "segments", new JArray(O("fromT", c.startDay - 1, "rate", c.rate)));
+            }
+            foreach (var z in s.Zones)
+            {
+                var key = State.ZoneKey(z);
+                s.permits[key] = O("entered", pure || scenario.Obj("permits").S("heldBy") == "pm", "signed", false);
+                var permit = scenario.Obj("permits").Rows("cards").FirstOrDefault(c => c.N("zone") == z.N("id"));
+                if (permit != null) s.permits[key]["number"] = permit["number"];
+                s.inspections[key] = O("cleared", pure || !scenario.Obj("inspections").B("required"), "reported", false);
+                var inspection = scenario.Obj("inspections").Rows("cards").FirstOrDefault(c => c.N("zone") == z.N("id"));
+                if (inspection != null) s.inspections[key]["number"] = inspection["number"];
+            }
+            if (!pure) { Voice(s, "stageStart", new[] { "plan", "site" }); Events.UpdateEvents(s); }
+            Crews.RefreshCrews(s);
+            return s;
+        }
+        private static void RecordActual(State s)
+        {
+            foreach (var id in CREW_IDS)
+                if (s.actualLines[id].Last().N("t") != s.t) s.actualLines[id].Add(O("t", s.t, "ft", s.crews[id].pos));
+        }
+        private static void Report(State s)
+        {
+            var feet = new JObject();
+            foreach (var id in CREW_IDS) feet[id] = Math.Floor(s.crews[id].pos + EPS);
+            var notes = CREW_IDS.Select(id => s.crews[id].name + ": " + F(feet.N(id) - s.reportedLines[id].Last().N("ft")) + " ft today").ToArray();
+            foreach (var id in CREW_IDS) s.reportedLines[id].Add(O("t", s.t, "ft", feet[id]));
+            var item = O("day", s.t, "feetByCrew", feet, "spendUsd", s.spentUsd, "notes", notes);
+            var inbox = item.Copy(); inbox["from"] = "Daily report"; inbox["subject"] = "Day " + F(s.t); s.inbox.Add(inbox);
+            item["seats"] = new JArray("plan", "facilitator"); Emit(s, "report", item);
+        }
+        private static void Finish(State s)
+        {
+            var lost = s.pure ? null : s.spentUsd > s.Plan.N("budgetUsd") ? "budget" : s.t > s.Plan.N("deadlineDay") - 1 + EPS ? "deadline" : null;
+            var complete = s.crews["back"].finishT != null && (s.pure || Permits.FinalInspectionEntered(s));
+            if (lost == null && !complete) return;
+            RecordActual(s);
+            var idleDays = new JObject(); double idleCrewDays = 0;
+            foreach (var id in CREW_IDS) { var idle = Math.Max(0, s.crews[id].onsite - s.crews[id].work); idleDays[id] = idle; idleCrewDays += idle; }
+            s.done = true;
+            var result = lost != null ? O("lost", lost) : O("finishDay", s.crews["back"].finishT);
+            if (s.Plan.Has("promisedFinishDay")) result["promisedDay"] = s.Plan["promisedFinishDay"];
+            if (s.Plan.Has("budgetUsd")) result["budgetUsd"] = s.Plan["budgetUsd"];
+            result["spentUsd"] = s.spentUsd; result["crewCostUsd"] = s.crewCostUsd;
+            result["idleDays"] = idleDays; result["idleCrewDays"] = idleCrewDays;
+            result["peakOpenTrenchFt"] = s.peakOpenTrenchFt; result["finesUsd"] = s.finesUsd;
+            result["deviationsCaught"] = s.deviations.Count(d => d.B("triggered") && d.B("caught"));
+            result["deviationsMissed"] = s.deviations.Count(d => d.B("triggered") && !d.B("caught"));
+            result["events"] = new JArray(s.events.Where(e => e.B("fired")).Select(e => O("id", e["id"], "day", e["firedT"], "option", e.Get("option"),
+                "daysLost", e.S("type") == "A2" ? e.N("durationDays") * e.N("rateDrop") + e.N("reworkDays") : (e.N("resolvedT", s.t) - e.N("firedT")) * e.N("rateDrop"),
+                "protection", e["protection"])));
+            result["changeLog"] = Token(s.changeLog);
+            result["lines"] = O("planned", Planning.PlannedPolylines(s), "actual", s.actualLines);
+            s.result = result;
+            if (!s.pure)
+            {
+                Voice(s, "stageEnd", new[] { "plan", "site" });
+                var message = O("stage", s.scenario["id"]);
+                foreach (var field in result.Properties()) message[field.Name] = field.Value.DeepClone();
+                message["seats"] = new JArray("plan", "site", "facilitator"); Emit(s, "result", message);
+            }
+        }
+        private static State TickState(State state, double dt)
+        {
+            if (state.done || state.speed == "paused") return state;
+            var s = state.Draft();
+            if (!s.pure) { Site.UpdateTruck(s); Orders.UpdateOrders(s); Events.UpdateEvents(s); }
+            Crews.RefreshCrews(s);
+            if (!s.pure) Conflict.DetectConflicts(s);
+            Crews.MoveCrews(s, dt); Money.Accrue(s, dt);
+            if (!s.pure) Crews.UpdateMood(s, dt);
+            s.t = Math.Round(s.t + dt, TIME_DECIMALS, MidpointRounding.AwayFromZero);
+            if (!s.pure)
+            { Site.UpdateTruck(s); Orders.UpdateOrders(s); Permits.UpdateHoldPoints(s); Events.UpdateEvents(s); Crews.RefreshCrews(s); }
+            if (Math.Floor(s.t + EPS) > Math.Floor(state.t + EPS)) { RecordActual(s); if (!s.pure) Report(s); }
+            Finish(s);
+            return s;
+        }
+        private static (State State, string Reason) Commit(State state, JArray ops)
+        {
+            if (ops == null) return (null, "invalid commit");
+            var conflictReason = Conflict.ValidateConflictCommit(state, ops);
+            if (conflictReason != null) return (null, conflictReason);
+            var s = state.Draft();
+            foreach (var token in ops)
+            {
+                var op = token as JObject; var reason = Orders.ValidateOp(s, op);
+                if (reason != null) return (null, reason);
+                Orders.IssueOrder(s, op);
+            }
+            Conflict.ResolveConflicts(s);
+            foreach (var id in CREW_IDS)
+                if (s.crews[id].stop != null && !ops.Any(op => (op.S("op") == "hold" || op.S("op") == "resume") && op.S("crew") == id)
+                    && !s.orders.Any(o => o.Obj("op").S("op") == "resume" && o.S("crew") == id && !o.Has("appliedT")))
+                    Orders.IssueOrder(s, O("op", "resume", "crew", id));
+            s.pendingStops.Clear(); Orders.UpdateOrders(s); Permits.UpdateHoldPoints(s);
+            if (s.crews["back"].finishT == null && s.crews["back"].pos >= s.Length - EPS && Permits.FinalInspectionEntered(s)) s.crews["back"].finishT = s.t;
+            Crews.RefreshCrews(s);
+            var change = O("day", s.t, "ops", ops); if (ops.Count == 0) change["note"] = "no change"; s.changeLog.Add(change);
+            if (s.speed == "paused") s.pausedSpeed = "full"; else s.speed = "full";
+            Finish(s);
+            return (s, null);
+        }
+        public void Tick(double dt = DT)
+        {
+            if (!double.IsFinite(dt) || dt <= 0) throw new ArgumentOutOfRangeException(nameof(dt), "dt must be positive");
+            var remaining = dt;
+            while (remaining > EPS && !state.done && state.speed != "paused")
+            {
+                var step = Math.Min(DT, remaining); state = TickState(state, step); remaining -= step;
+            }
+        }
+        public ApplyResult Apply(string seat, JObject cmd)
+        {
+            if (cmd == null) return new ApplyResult("invalid command");
+            var action = cmd.S("action");
+            if (seat == "facilitator")
+            {
+                if (action == "load" && cmd.S("stage") != source.S("id")) return new ApplyResult("stage not loaded");
+                if (action == "reset" || action == "load") state = InitialState(source, fleet, pure);
+                else if (action == "pause")
+                { state = state.Draft(); if (state.speed != "paused") state.pausedSpeed = state.speed; state.speed = "paused"; }
+                else if (action == "start" || action == "resume") { state = state.Draft(); state.speed = state.pausedSpeed; }
+                else return new ApplyResult("unknown control");
+                return new ApplyResult(state.t);
+            }
+            if (state.done) return new ApplyResult("stage ended");
+            if (seat == "plan" && action == "commit")
+            {
+                var result = Commit(state, cmd["ops"] as JArray);
+                if (result.Reason != null)
+                {
+                    if (result.Reason == "not in the budget") { state = state.Draft(); Voice(state, "prepRefused", new[] { "plan" }); }
+                    return new ApplyResult(result.Reason);
+                }
+                state = result.State;
+            }
+            else if (seat == "site")
+            {
+                var draft = state.Draft(); var reason = Site.ApplySite(draft, cmd);
+                if (reason != null) return new ApplyResult(reason);
+                state = draft;
+            }
+            else return new ApplyResult("action unavailable for seat");
+            return new ApplyResult(state.t);
+        }
+        public JObject View(string seat) => Views.View(state, seat);
+        public List<JObject> Drain()
+        {
+            var messages = state.messages.Select(m => m.Copy()).ToList();
+            state.messages = new List<JObject>(); return messages;
+        }
+        public JObject Serialize() => JObject.FromObject(state);
+    }
+}
diff --git a/Assets/LOBOver/Sim/Site.cs b/Assets/LOBOver/Sim/Site.cs
new file mode 100644
index 0000000000000000000000000000000000000000..951603da33c38bba374eb9bca33f2a814d9a44e8
--- /dev/null
+++ b/Assets/LOBOver/Sim/Site.cs
@@ -0,0 +1,99 @@
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Site
+    {
+        private static readonly HashSet<string> TARGETS = new HashSet<string> { "wall", "water", "pipe", "machine", "protection", "board", "sky", "ticket", "crew" };
+        private const int MAX_NOTE_LENGTH = 40; // PROTOCOL.md: Site flag notes.
+        internal static string ApplySite(State s, JObject cmd)
+        {
+            var truck = s.truck; var action = cmd.S("action");
+            if (action == "moveTo")
+            {
+                if (truck.B("moving") || truck.B("dismounted")) return "mount before moving";
+                if (!cmd.Finite("stationFt") || cmd.N("stationFt") < 0 || cmd.N("stationFt") > s.Length) return "invalid station";
+                truck["fromFt"] = truck["stationFt"]; truck["toFt"] = cmd["stationFt"]; truck["departT"] = s.t;
+                truck["arrivesT"] = s.t + TravelDays(truck.N("stationFt"), cmd.N("stationFt"));
+                truck["moving"] = truck.N("arrivesT") > s.t;
+                return null;
+            }
+            if (action == "mount" || action == "dismount")
+            {
+                if (truck.B("moving")) return "truck moving";
+                truck["dismounted"] = action == "dismount"; return null;
+            }
+            if (!truck.B("dismounted") || truck.B("moving")) return "dismount first";
+            if (action == "inspect")
+            {
+                if (!TARGETS.Contains(cmd.S("target"))) return "unknown inspection target";
+                var ft = Views.StakeAt(s, truck.N("stationFt"));
+                if (cmd.S("target") == "protection") Deviations.InspectProtection(s, ft);
+                var e = ActiveCollapse(s);
+                if (e != null && Views.StakeAt(s, e.N("stationFt")) == ft) e["inspected"] = true;
+                var reply = O("target", cmd["target"], "text", Views.InspectionText(s, cmd.S("target")), "seats", new[] { "site" });
+                if (cmd.Property("id") != null) reply["id"] = cmd["id"];
+                Emit(s, "inspection", reply); return null;
+            }
+            if (action == "flag")
+            {
+                if (!cmd.Finite("stationFt") || cmd.N("stationFt") < 0 || cmd.N("stationFt") > s.Length
+                    || cmd.Has("note") && (cmd["note"].Type != JTokenType.String || cmd.S("note").Length > MAX_NOTE_LENGTH)) return "invalid flag";
+                var flag = O("stationFt", cmd["stationFt"], "day", s.t);
+                if (!string.IsNullOrEmpty(cmd.S("note"))) flag["note"] = cmd["note"];
+                s.flags.Add(flag); return null;
+            }
+            if (action == "stopWork")
+            {
+                if (!cmd.Finite("zone") || ZoneAt(s, truck.N("stationFt")).N("id", double.NaN) != cmd.N("zone")) return "outside zone";
+                var stop = O("zone", cmd["zone"], "fromT", s.t + s.Rules.N("stopWorkReachHours") / HOURS_PER_DAY);
+                foreach (var id in CREW_IDS)
+                {
+                    var c = s.crews[id];
+                    if (ZoneAt(s, c.pos).N("id", double.NaN) != cmd.N("zone")) continue;
+                    if (s.t >= c.startDay - 1 - EPS) c.stop = stop.Copy(); else s.pendingStops[id] = stop.Copy();
+                }
+                return null;
+            }
+            if (action == "confirm")
+            {
+                var order = s.orders.FirstOrDefault(o => o.S("id") == cmd.S("orderId"));
+                if (order.S("crew") == null || !order.Has("landedT") || order.S("status") == "sent" || !Nearby(s, s.crews[order.S("crew")].pos)) return "order not landed here";
+                if (cmd.S("outcome") != "done" && cmd.S("outcome") != "notDone") return "invalid outcome";
+                order["status"] = cmd.S("outcome") == "done" ? "confirmed" : "notCarriedOut";
+                Deviations.ConfirmDeviation(s, order, cmd.S("outcome"));
+                if (cmd.S("outcome") == "notDone") Voice(s, "orderNotDone", new[] { "plan" });
+                return null;
+            }
+            if (action == "listen")
+            {
+                var c = CrewAt(s);
+                if (c?.arguing == true)
+                {
+                    var conflict = s.conflicts.First(x => x.S("trailing") == c.id || x.S("leader") == c.id);
+                    Voice(s, "conflict", new[] { "site" }, new[] { conflict.S("trailing"), conflict.S("leader") });
+                }
+                else if (c != null && (c.status == "held" || c.status == "stopped") && c.mood > 0) Voice(s, "heldDay" + F(c.mood), new[] { "site" }, new[] { c.id });
+                else
+                {
+                    var reply = O("target", "crew", "text", "Nothing to hear.", "seats", new[] { "site" });
+                    if (cmd.Property("id") != null) reply["id"] = cmd["id"];
+                    Emit(s, "inspection", reply);
+                }
+                return null;
+            }
+            return "unknown action";
+        }
+        internal static void UpdateTruck(State s)
+        {
+            var truck = s.truck;
+            if (!truck.B("moving")) return;
+            if (s.t >= truck.N("arrivesT") - EPS) { truck["stationFt"] = truck["toFt"]; truck["moving"] = false; }
+            else truck["stationFt"] = truck.N("fromFt") + (truck.N("toFt") - truck.N("fromFt")) * (s.t - truck.N("departT")) / (truck.N("arrivesT") - truck.N("departT"));
+        }
+    }
+}
diff --git a/Assets/LOBOver/Sim/Views.cs b/Assets/LOBOver/Sim/Views.cs
new file mode 100644
index 0000000000000000000000000000000000000000..585d6393e6c1a785a42be0dd6daafc2f7591a23d
--- /dev/null
+++ b/Assets/LOBOver/Sim/Views.cs
@@ -0,0 +1,151 @@
+using System;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using static LOBOver.Sim.Common;
+using static LOBOver.Sim.Json;
+
+namespace LOBOver.Sim
+{
+    internal static class Views
+    {
+        private static JToken Clean(JToken value)
+        {
+            if (value is JArray array) return new JArray(array.Select(Clean));
+            if (value is JObject obj) return new JObject(obj.Properties().Where(p => !p.Name.StartsWith("_", StringComparison.Ordinal)).Select(p => new JProperty(p.Name, Clean(p.Value))));
+            return value.DeepClone();
+        }
+        internal static double StakeAt(State s, double ft) => Math.Floor(ft / s.Job.N("stationEveryFt") + 0.5) * s.Job.N("stationEveryFt");
+        private static bool CollapseHere(State s, double ft)
+        {
+            var e = ActiveCollapse(s); return e != null && StakeAt(s, e.N("stationFt")) == StakeAt(s, ft);
+        }
+        private static JObject GroundAt(State s, double ft) => s.scenario.Obj("ground").Rows("segments").FirstOrDefault(x => ft >= x.N("fromFt") && ft <= x.N("toFt"));
+        internal static JObject TrenchAt(State s, double stationFt)
+        {
+            bool Passed(string id) => s.crews[id].pos > stationFt + EPS || s.crews[id].finishT != null;
+            var state = !Passed("exc") ? "undug" : !Passed("pipe") ? "open" : !Passed("back") ? "piped" : "backfilled";
+            var open = state == "open" || state == "piped"; var p = ProtectionAt(s, stationFt);
+            return O("stationFt", stationFt, "state", state,
+                "water", CollapseHere(s, stationFt) || open && Rain.RainOrRework(s) ? "standing" : open && GroundAt(s, stationFt).B("seepage") ? "seep" : "none",
+                "wall", CollapseHere(s, stationFt) ? "slumped" : "sound", "protection", p != null ? p.S("kind").Replace("trench_", "") : "none", "pipeDamage", "none");
+        }
+        internal static string CrewText(State s, Crew c)
+        {
+            if (c == null) return "No machine within sight.";
+            var text = "Working.";
+            var leader = Leader(c.id) == null ? null : s.crews[Leader(c.id)];
+            if (c.status == "demobilized") text = "Demobilized.";
+            else if (c.status == "arguing")
+            {
+                var conflict = s.conflicts.FirstOrDefault(x => !x.B("resolved") && (x.S("trailing") == c.id || x.S("leader") == c.id));
+                var other = conflict == null ? null : s.crews[conflict.S("trailing") == c.id ? conflict.S("leader") : conflict.S("trailing")];
+                text = "Arguing with " + (other?.name ?? leader?.name ?? c.name) + ".";
+            }
+            else if (c.status == "stopped") text = "Stopped: stop-work.";
+            else if (c.status == "held") text = "Held by the office since Day " + F(DisplayDay(c.hold.N("fromT"))) + ".";
+            else if (c.status == "idle") text = "Idle, waiting on " + (leader?.name ?? c.name) + ".";
+            return text + " " + MOODS[(int)c.mood];
+        }
+        internal static string InspectionText(State s, string target)
+        {
+            var ft = StakeAt(s, s.truck.N("stationFt")); var c = CrewAt(s); var p = ProtectionAt(s, ft);
+            var zone = ZoneAt(s, ft); var segment = GroundAt(s, ft);
+            if (target == "wall")
+            {
+                if (CollapseHere(s, ft)) return "Wall slumped into the trench.";
+                if (s.crews["exc"].pos <= ft + EPS) return "Not excavated here yet.";
+                return segment.Obj("indicator").S("wall") ?? s.scenario.Obj("ground").Obj("defaultIndicator").S("wall");
+            }
+            if (target == "water")
+            {
+                if (TrenchAt(s, ft).S("water") == "standing") return "Standing water in the trench bottom.";
+                return segment.Obj("indicator").S("water") ?? s.scenario.Obj("ground").Obj("defaultIndicator").S("water");
+            }
+            if (target == "machine")
+            {
+                var machine = c == null ? null : s.Machine(c.machine);
+                return machine == null ? "No machine within sight." : c.name + ": " + machine.S("label") + ", plate " + machine.S("sizeClass");
+            }
+            if (target == "protection") return p == null ? "No protection here." : s.catalog.Obj("protection").Obj(p.S("kind")).S("label") + " in place, " + F(p.N("fromFt")) + " to " + F(p.N("toFt"));
+            if (target == "board")
+            {
+                var permit = s.permits[State.ZoneKey(zone)]; var inspection = s.inspections[State.ZoneKey(zone)];
+                return "Zone " + F(zone.N("id")) + " board: " + (permit.B("entered") ? "permit " + permit.S("number") : "no permit posted")
+                    + (inspection.B("cleared") ? "; inspection " + inspection.S("number") : "");
+            }
+            if (target == "sky") return Rain.Sky(s) == "rain" ? "Rain." : Rain.Sky(s) == "towersSouth" ? "Towers building to the south." : "Clear.";
+            if (target == "ticket")
+            {
+                var delivery = s.deliveries.FirstOrDefault(d => !d.B("arrived"));
+                return delivery == null ? "No truck at the gate." : "Delivery ticket: " + s.Machine(delivery.S("machine")).S("label") + ", due Day " + F(DisplayDay(delivery.N("arrivesT")));
+            }
+            if (target == "crew") return CrewText(s, c);
+            if (target == "pipe") return s.crews["back"].pos > ft + EPS ? "Backfilled." : s.crews["pipe"].pos > ft + EPS ? "Pipe laid, open trench." : "No pipe here yet.";
+            return null;
+        }
+        internal static JObject PublicOrder(JObject order) => O("id", order["id"], "op", order["op"], "crew", order["crew"], "issuedDay", order["issuedT"], "landsDay", order["landsT"], "status", order["status"]);
+        internal static JObject PlanView(State s)
+        {
+            var machines = new JObject();
+            foreach (var entry in s.catalog.Obj("machines").Properties().Where(p => !p.Name.StartsWith("_", StringComparison.Ordinal)))
+            {
+                var machine = (JObject)Clean(entry.Value);
+                machine["leadDays"] = O("normal", entry.Value.Obj("leadDays").N("normal") + s.City.N("leadDelayDays"));
+                machines[entry.Name] = machine;
+            }
+            var permits = new JArray(); var inspections = new JArray();
+            foreach (var z in s.Zones)
+            {
+                var permit = s.permits[State.ZoneKey(z)];
+                var item = O("zone", z["id"], "entered", permit["entered"]);
+                if (permit.B("entered") && permit.Has("number")) item["number"] = permit["number"];
+                permits.Add(item); inspections.Add(O("zone", z["id"], "cleared", s.inspections[State.ZoneKey(z)]["cleared"]));
+            }
+            var uncertainty = new JObject();
+            foreach (var id in CREW_IDS)
+            {
+                var report = s.reportedLines[id].Last(); var line = s.plannedLines[id];
+                var estimate = report.N("ft") + Planning.PlannedRate(line, s.t) * Math.Max(0, s.t - Math.Max(report.N("t"), line.N("startDay") - 1));
+                var band = s.t <= report.N("t") + EPS ? 0 : s.Rules.N("uncertaintyBandFt");
+                uncertainty[id] = O("estimateFt", Math.Min(s.Length, estimate), "fromFt", Math.Max(0, estimate - band), "toFt", Math.Min(s.Length, estimate + band), "asOfT", report["t"]);
+            }
+            return O("plannedLines", s.plannedLines,
+                "responses", new JArray(Events.AvailableResponses(s).Select(r => O("key", r.Option["key"], "label", r.Option["label"], "cost", r.Option["cost"], "eventTitle", r.Event.Obj("card")["title"]))),
+                "reportedLines", s.reportedLines, "budget", O("budgetUsd", s.Plan["budgetUsd"], "spentUsd", s.spentUsd, "committedUsd", s.spentUsd,
+                    "deadlineDay", s.Plan["deadlineDay"], "promisedDay", s.Plan["promisedFinishDay"]),
+                "inbox", s.inbox, "radioLog", new JArray(s.orders.Select(PublicOrder)), "catalog", O("machines", machines, "protection", Clean(s.catalog["protection"])),
+                "permits", permits, "inspections", inspections, "flags", s.flags, "draft", new JArray(), "uncertainty", uncertainty, "pmLines", s.pmLines);
+        }
+        internal static JObject SiteView(State s)
+        {
+            var trench = new JArray();
+            for (double ft = 0; ft <= s.Length; ft += s.Job.N("stationEveryFt")) trench.Add(TrenchAt(s, ft));
+            var local = s.events.FirstOrDefault(e => e.B("fired") && !e.B("resolved") && (!e.Has("zone")
+                || e.N("zone") == ZoneAt(s, s.truck.N("stationFt")).N("id", double.NaN) || e.B("inspected")));
+            return O("truck", O("stationFt", s.truck["stationFt"], "moving", s.truck["moving"], "dismounted", s.truck["dismounted"]),
+                "crews", new JArray(CREW_IDS.Select(id =>
+                {
+                    var c = s.crews[id]; var size = s.Machine(c.machine).S("sizeClass");
+                    return O("id", id, "stationFt", c.pos, "status", c.status, "machinePlate", string.IsNullOrEmpty(size) ? null : char.ToUpperInvariant(size[0]) + size.Substring(1), "moodLevel", c.mood);
+                })), "trench", trench,
+                "boards", new JArray(s.Zones.Select(z => O("zone", z["id"], "permitNumber", s.permits[State.ZoneKey(z)].B("entered") ? s.permits[State.ZoneKey(z)].Get("number") : null,
+                    "inspectionNumber", s.inspections[State.ZoneKey(z)].B("cleared") ? s.inspections[State.ZoneKey(z)].Get("number") : null))),
+                "sky", Rain.Sky(s), "gate", O("trucksWaiting", s.deliveries.Count(d => !d.B("arrived"))),
+                "activeEvent", local == null ? null : O("id", local["id"], "card", local["shownCard"]),
+                "orders", new JArray(s.orders.Where(o => o.S("crew") != null && o.Has("landedT") && o.S("status") != "sent" && o.S("status") != "confirmed"
+                    && Nearby(s, s.crews[o.S("crew")].pos)).Select(PublicOrder)));
+        }
+        internal static JObject View(State s, string seat)
+        {
+            if (seat == "plan") return PlanView(s);
+            if (seat == "site") return SiteView(s);
+            if (seat == "facilitator")
+            {
+                var state = JObject.FromObject(s); state.Remove("messages");
+                state["deviations"] = new JArray(s.deviations.Select(d => { var result = d.Copy(); result["state"] = !d.B("triggered") ? "armed" : d.B("caught") ? "caught" : "missed"; return result; }));
+                state["plan"] = PlanView(s); state["site"] = SiteView(s); return state;
+            }
+            throw new ArgumentException("unknown seat");
+        }
+    }
+}
