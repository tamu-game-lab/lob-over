        "trafficCongestion": "High"
      },
      "signature": "Granite plus monsoon plus winter freeze. Won on the calendar.",
      "_hazard_source": "Hazard Matrix sheet; V.High = severe hazard (soil cohesion V.High means dangerously weak ground; bedrock depth Low means rock too deep to matter)"
    }
  },
  "money": {
    "overheadRate": 0.3,
    "deadlineSlackDays": 12,
    "budgetFormula": "promisedFinishDay * dailyFleetUsd * 1.3 + 60000",
    "_source": "LOB-Game Sandbox: deadline = default plan finish + 12 days; budget = finish x daily fleet cost x 1.3 + $60,000"
  },
  "workbookDurations": {
    "_source": "LOB Disruption Event Library Final7, Response Option sheet (Base Rate Drop, Duration). rateDrop is the fraction LOST: the crew works at (1 - rateDrop). Where the Situations sheet disagrees (E1 1 day, P3 1-2 days, B1 2 days) the game uses the Response Option sheet's value.",
    "E1": {
      "name": "Buried utility or existing pipeline strike",
      "hits": "exc",
      "rateDrop": 0.4,
      "durationDays": 3
    },
    "E2": {
      "name": "Unforeseen ground conditions, hard rock refusal",
      "hits": "exc",
      "rateDrop": 0.6,
      "durationDays": 2
    },
    "P1": {
      "name": "Trench collapse / cave-in",
      "hits": "pipe",
      "rateDrop": 1.0,
      "durationDaysByExcavator": {
        "small": 3,
        "standard": 2,
        "large": 1
      },
      "lenderLosesSameDays": true,
      "_validate": "the sheet's Day column reads 2/1/0 for option A (own machine) and 3/2/1 for option C (hired); the game uses 3/2/1 clearing days for both, lender loses the same days"
    },
    "P2": {
      "name": "Late pipe delivery / supply chain lag",
      "hits": "pipe",
      "rateDrop": 0.5,
      "durationDays": 3
    },
    "P3": {
      "name": "Pipe dropped during lifting / rigging failure",
      "hits": "pipe",
      "rateDrop": 0.8,
      "durationDays": 2
    },
    "B1": {
      "name": "Poor backfill compaction density / QC test failure",
      "hits": "back",
      "rateDrop": 0.3,
      "durationDays": 3
    },
    "A1": {
      "name": "Trench movement and water-driven settlement",
      "hits": "all",
      "rateDrop": 0.3,
      "durationDays": 2
    },
    "A2": {
      "name": "Extreme weather",
      "hits": "all",
      "rateDrop": 0.5,
      "durationDays": 2
    }
  }
}
{
 "_doc": [
  "Reference oracle for the no-event push/pull goldens (Phase 0, WO-02).",
  "Continuous-time crew model, DT = 0.01 day. Conventions the JS and C# simulations must reproduce:",
  "- Day N in the design means the crew starts at t = N - 1 (Day 1 = t 0). Output 'finishDay' is t at completion.",
  "- A crew advances at its machine rate, never past its leader (pipe <= excavation, backfill <= pipe), no distance margin.",
  "- Optional WIP cap: excavation may not lead backfill by more than cap ft (pull by distance).",
  "- idleDays = days on site - days actually working; on site = from start to that crew's own finish.",
  "- crewCostUsd = sum(daily machine cost x days on site) x 1.3 overhead; mobilization, events and purchases excluded.",
  "- peakOpenTrenchFt = max over time of (excavation position - backfill position).",
  "Tolerances for parity: finish +-0.1 day, idle +-0.1 day, cost +-$500, peak +-10 ft."
 ],
