PlanPanel.cs
using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using LOBOver.Sim;
using Newtonsoft.Json.Linq;
using TMPro;
using UnityEngine;

namespace LOBOver.World
{
    // Showcase only. During the study, the Plan seat uses the web page, away from the Site seat.
    public sealed class PlanPanel : MonoBehaviour
    {
        private Chart chart;
        private Transform drawing;
        private readonly Dictionary<string, LineRenderer> planned = new Dictionary<string, LineRenderer>();
        private readonly Dictionary<string, LineRenderer> reported = new Dictionary<string, LineRenderer>();
        private TextMeshPro budget, inbox, radio, responses, keypad, result;
        private LineRenderer promise, deadlineRule;
        private double length, deadline;
        private static readonly CultureInfo Format = CultureInfo.InvariantCulture;
        public void Configure(WorldAssets assets, double lengthFt, double deadlineDay)
        {
            if (drawing != null) WorldDrawing.Remove(drawing.gameObject);
            drawing = WorldDrawing.Group("PlanPlot", transform).transform;
            planned.Clear(); reported.Clear(); length = lengthFt; deadline = deadlineDay;
            chart = new Chart(drawing, assets, length, deadline, new Rect(-1.32f, -0.45f, 1.55f, 0.9f));
            chart.Label("Title", "PLAN   exc / pipe / back   Â·   thin: planned   thick: reported", new Vector2(0, 0.66f), new Vector2(2.8f, 0.13f), 0.06f);
            budget = chart.Label("Budget", "", new Vector2(0, 0.53f), new Vector2(2.8f, 0.13f), 0.06f);
            inbox = chart.Label("Inbox", "", new Vector2(0.88f, 0.32f), new Vector2(1.05f, 0.32f), 0.045f);
            radio = chart.Label("Radio", "", new Vector2(0.88f, -0.02f), new Vector2(1.05f, 0.28f), 0.042f);
            responses = chart.Label("Respond", "", new Vector2(0.88f, -0.3f), new Vector2(1.05f, 0.25f), 0.042f);
            keypad = chart.Label("Keypad", "", new Vector2(0, -0.61f), new Vector2(2.8f, 0.14f), 0.045f);
            result = chart.Label("Result", "", new Vector2(-0.55f, -0.2f), new Vector2(1.4f, 0.4f), 0.055f);
            foreach (var text in new[] { inbox, radio, responses, keypad })
            { text.enableAutoSizing = true; text.fontSizeMin = 0.2f; text.fontSizeMax = text.fontSize; text.overflowMode = TextOverflowModes.Truncate; }
            promise = chart.Rule("Promise", 1, true, Color.gray); deadlineRule = chart.Rule("Deadline", deadline, true, Color.white);
            for (var i = 0; i < WorldUnits.CrewIds.Length; i++)
            {
                var id = WorldUnits.CrewIds[i];
                planned[id] = WorldDrawing.Line("Planned_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.004f);
                reported[id] = WorldDrawing.Line("Reported_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.01f);
            }
        }
        public void Apply(PlanView view, double time)
        {
            if (chart == null) return;
            var b = view.budget;
            budget.text = string.Format(Format, "${0:N0} spent   ${1:N0} committed   ${2:N0} budget   |   promise {3}   deadline {4}", b.spentUsd, b.committedUsd, b.budgetUsd, b.promisedDay, b.deadlineDay);
            promise.SetPositions(new[] { chart.Point(0, b.promisedDay), chart.Point(length, b.promisedDay) });
            deadlineRule.SetPositions(new[] { chart.Point(0, b.deadlineDay), chart.Point(length, b.deadlineDay) });
            foreach (var id in WorldUnits.CrewIds)
            {
                var projection = Project(view.plannedLines[id], length, Math.Max(time, deadline - 1));
                planned[id].positionCount = projection.Count;
                planned[id].SetPositions(projection.Select(p => chart.Point(p.ft, Math.Min(deadline, p.t + 1))).ToArray());
                var steps = new List<Vector3>(); PointView previous = null;
                foreach (var point in view.reportedLines[id])
                {
                    if (previous != null) steps.Add(chart.Point(previous.ft, point.t + 1));
                    steps.Add(chart.Point(point.ft, point.t + 1)); previous = point;
                }
                reported[id].positionCount = steps.Count; reported[id].SetPositions(steps.ToArray());
            }
            inbox.text = "INBOX\n" + string.Join("\n", view.inbox.Skip(Math.Max(0, view.inbox.Count - 3)).Select(item =>
                "Day " + item.day.ToString("0.##", Format) + " " + item.subject + ": " + (item.body ?? string.Join("; ", item.notes ?? new List<string>()))));
            radio.text = "RADIO\n" + string.Join("\n", view.radioLog.Select(item => item.id + " " + item.crew + " " + (string)item.op?["op"] + " Â· " + item.status));
            responses.text = "RESPOND\n" + string.Join("\n", view.responses.Select(item => item.label + " " + item.cost?.usd + " " + item.cost?.perDayUsd));
            keypad.text = "KEYPAD   " + string.Join("   ", view.permits.Select(item => "ZONE " + item.zone + " permit: " + (item.entered ? item.number : "â€”")))
                + "\n" + string.Join("   ", view.inspections.Select(item => "ZONE " + item.zone + " inspection: " + (item.cleared ? "entered" : "â€”")));
        }
        public void ShowResult(JObject value)
        {
            // Numerical outcome facts only; the Site board never receives the result or budget.
            result.text = "Finish day: " + (value["finishDay"]?.ToString() ?? "â€”") + "\nSpent: $" + ((double?)value["spentUsd"] ?? 0).ToString("N0", Format)
                + "\nIdle crew-days: " + ((double?)value["idleCrewDays"] ?? 0).ToString("0.0", Format)
                + "\nPeak open trench: " + ((double?)value["peakOpenTrenchFt"] ?? 0).ToString("0", Format) + " ft";
        }

        // Mirrors Planning.PlannedPolylines using PlanView only, including holds and loans.
        public static List<PointView> Project(PlannedLineView line, double length, double horizon)
        {
            var holds = line.holds ?? new List<HoldView>(); var loans = line.loans ?? new List<LoanView>();
            var segments = line.segments ?? new List<SegmentView>(); var start = line.startDay - 1;
            var breaks = new List<double> { start, horizon };
            breaks.AddRange(segments.Select(s => s.fromT));
            foreach (var hold in holds) { breaks.Add(hold.fromT); if (hold.untilT.HasValue) breaks.Add(hold.untilT.Value); }
            foreach (var loan in loans) { breaks.Add(loan.fromT); breaks.Add(loan.untilT); }
            double time = start, feet = 0;
            var points = new List<PointView> { new PointView { t = start, ft = 0 } };
            foreach (var next in breaks.Distinct().Where(t => t > start && t <= horizon).OrderBy(t => t))
            {
                var segment = segments.OrderBy(s => s.fromT).LastOrDefault(s => s.fromT <= time);
                var rate = holds.Any(h => time >= h.fromT && (!h.untilT.HasValue || time < h.untilT)) ? 0
                    : (segment == null ? line.rate : segment.rate) + loans.Where(l => time >= l.fromT && time < l.untilT).Sum(l => l.rate);
                if (rate > 0 && feet + (next - time) * rate >= length)
                { points.Add(new PointView { t = time + (length - feet) / rate, ft = length }); break; }
                feet += (next - time) * rate; time = next; points.Add(new PointView { t = time, ft = feet });
            }
            return points;
        }
    }
}
SiteSky.cs
using UnityEngine;

namespace LOBOver.World
{
    public sealed class SiteSky : MonoBehaviour
    {
        public ParticleSystem rain;
        public Transform cloudBank;
        public Transform observer;
        public string State { get; private set; }
        public bool Raining => rain.gameObject.activeSelf;
        private WorldAssets assets;
        private AudioSource bed;
        private bool originalFog;
        private Color originalFogColour;
        private float originalFogDensity;
        public void Configure(WorldAssets source)
        {
            assets = source;
            if (bed == null) { bed = WorldDrawing.Sound(gameObject, true); bed.spatialBlend = 0; }
            originalFog = RenderSettings.fog; originalFogColour = RenderSettings.fogColor; originalFogDensity = RenderSettings.fogDensity;
            State = null; Apply("clear");
        }
        public void Apply(string state)
        {
            if (State == state) return;
            State = state; var raining = state == "rain";
            cloudBank.gameObject.SetActive(state == "towersSouth" || raining);
            rain.gameObject.SetActive(raining);
            if (raining && Application.isPlaying) rain.Play();
            RenderSettings.fog = raining || originalFog;
            RenderSettings.fogColor = raining ? new Color(0.48f, 0.5f, 0.52f) : originalFogColour;
            RenderSettings.fogDensity = raining ? 0.006f : originalFogDensity;
            WorldDrawing.Loop(bed, raining ? assets.rainfall : state == "towersSouth" ? assets.wind : null);
        }
        private void LateUpdate()
        {
            if (observer == null) return;
            rain.transform.position = observer.position + Vector3.up * 12;
            // WO-08: a cumulus billboard bank 2 km south of the site.
            cloudBank.forward = (cloudBank.position - observer.position).normalized;
        }
        private void OnDestroy()
        {
            if (assets == null) return;
            RenderSettings.fog = originalFog; RenderSettings.fogColor = originalFogColour; RenderSettings.fogDensity = originalFogDensity;
        }
    }
}
TrailerBoard.cs
using System.Collections.Generic;
using LOBOver.Sim;
using UnityEngine;

namespace LOBOver.World
{
    public sealed class TrailerBoard : MonoBehaviour
    {
        private readonly Dictionary<string, List<Vector3>> points = new Dictionary<string, List<Vector3>>();
        private readonly Dictionary<string, LineRenderer> lines = new Dictionary<string, LineRenderer>();
        private readonly Dictionary<int, LineRenderer> permits = new Dictionary<int, LineRenderer>();
        private int lastDay = -1;
        private Chart chart;
        private Transform drawing;
        public int LineCount => lines.Count;
        public int PointCount(string crew) => points[crew].Count;

        public void Configure(WorldAssets assets, double lengthFt, double deadline, Dictionary<int, double> boundaries)
        {
            if (drawing != null) WorldDrawing.Remove(drawing.gameObject);
            drawing = WorldDrawing.Group("SitePlot", transform).transform;
            points.Clear(); lines.Clear(); permits.Clear(); lastDay = -1;
            chart = new Chart(drawing, assets, lengthFt, deadline, new Rect(-0.82f, -0.36f, 1.65f, 0.65f));
            chart.Label("Title", "SITE  Â·  actual feet / day", new Vector2(0, 0.42f), new Vector2(1.8f, 0.15f), 0.08f);
            for (var i = 0; i < WorldUnits.CrewIds.Length; i++)
            {
                var id = WorldUnits.CrewIds[i]; points[id] = new List<Vector3>();
                lines[id] = WorldDrawing.Line("Actual_" + id, drawing, assets.ink, WorldUnits.CrewColours[i], 0.009f);
            }
            foreach (var item in boundaries)
                permits[item.Key] = chart.Rule("UnpostedZone_" + item.Key, item.Value, false, Color.gray);
        }
        public void Apply(SiteView view, int displayDay)
        {
            foreach (var board in view.boards) if (permits.TryGetValue((int)board.zone, out var rule)) rule.gameObject.SetActive(board.permitNumber == null);
            if (displayDay == lastDay) return;
            foreach (var crew in view.crews)
            {
                points[crew.id].Add(chart.Point(crew.stationFt, displayDay));
                lines[crew.id].positionCount = points[crew.id].Count;
                lines[crew.id].SetPositions(points[crew.id].ToArray());
            }
            lastDay = displayDay;
        }
    }

    internal sealed class Chart
    {
        private readonly Transform root;
        private readonly WorldAssets assets;
        private readonly double length, deadline;
        private readonly Rect area;
        public Chart(Transform root, WorldAssets assets, double length, double deadline, Rect area)
        {
            this.root = root; this.assets = assets; this.length = length; this.deadline = deadline; this.area = area;
            var axes = WorldDrawing.Line("Axes", root, assets.ink, Color.white, 0.005f);
            axes.positionCount = 3; axes.SetPositions(new[] { Point(0, deadline), Point(0, 1), Point(length, 1) });
            Label("StationAxis", "0 ft", new Vector2(area.center.x, area.yMin - 0.045f), new Vector2(area.width, 0.1f), 0.045f); Label("StationEnd", length + " ft", new Vector2(area.center.x, area.yMin - 0.045f), new Vector2(area.width, 0.1f), 0.045f).alignment = TMPro.TextAlignmentOptions.TopRight;
            Label("DayAxis", "Day " + deadline, new Vector2(area.xMin + 0.1f, area.yMax + 0.045f), new Vector2(0.3f, 0.1f), 0.045f);
        }
        public Vector3 Point(double feet, double day) => new Vector3(
            area.xMin + (float)(feet / length) * area.width,
            area.yMin + (float)((day - 1) / (deadline - 1)) * area.height, -0.065f);
        public TMPro.TextMeshPro Label(string name, string value, Vector2 position, Vector2 size, float height)
        {
            var text = WorldDrawing.Text(name, root, new Vector3(position.x, position.y, -0.07f), size, height, assets.font);
            text.text = value; return text;
        }
        public LineRenderer Rule(string name, double value, bool day, Color colour)
        {
            var line = WorldDrawing.Line(name, root, assets.ink, colour, 0.004f); line.positionCount = 2;
            line.SetPositions(day ? new[] { Point(0, value), Point(length, value) } : new[] { Point(value, 1), Point(value, deadline) });
            return line;
        }
    }
}
