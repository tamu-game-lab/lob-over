                 var passes = BuildChecks.Passes(out var settingsReport);
                 if (!passes) Debug.LogError("LOB Over: " + settingsReport);
-                if (!File.Exists(SiteSceneBuilder.ScenePath))
+                if (!File.Exists(PlaySceneBuilder.ScenePath))
