diff --git a/Assets/LOBOver/Tests/VerifyLevel1.cs.txt b/Assets/LOBOver/Tests/VerifyLevel1.cs.txt
new file mode 100644
index 0000000000000000000000000000000000000000..c3616e150d699267ccdc2742d913718d31b4d16b
--- /dev/null
+++ b/Assets/LOBOver/Tests/VerifyLevel1.cs.txt
@@ -0,0 +1,14 @@
+using System;
+using LOBOver.Client;
+
+internal static class VerifyLevel1
+{
+    public static void Run()
+    {
+        if (!DiscoveryPacket.TryParse("LOBOVER 1 7331 BRYAN-PC\n", out var port, out var name) || port != 7331 || name != "BRYAN-PC")
+            throw new Exception("Discovery packet did not preserve the advertised port and hostname");
+        foreach (var invalid in new[] { "", "LOBOVER 2 7331 pc", "LOBOVER 1 0 pc", "LOBOVER 1 65536 pc", "LOBOVER 1 7331 pc extra", "LOBOVER 1 7331 ../host" })
+            if (DiscoveryPacket.TryParse(invalid, out _, out _)) throw new Exception("Invalid discovery packet accepted: " + invalid);
+        Console.WriteLine("PASS: Level 1 discovery parser; 1 valid packet, 6 invalid packets.");
+    }
+}
diff --git a/Assets/LOBOver/Tests/level1-contract.test.mjs b/Assets/LOBOver/Tests/level1-contract.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9a0e7111a4b67893eb2a879f4e1d710ccf9a38bd
--- /dev/null
+++ b/Assets/LOBOver/Tests/level1-contract.test.mjs
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHost } from '../../../Monitor/src/host/core.js';
+import { loadCatalog } from '../../../Monitor/src/common/catalog.js';
+import { loadScenario } from '../../../Monitor/src/scenario/load.js';
+
+// No sockets or network: verify the real WO-L1 host contract consumed by the Unity client.
+test('Level 1 host accepts site/quest and exposes the presenter geometry and exchange shape', () => {
+  const catalog = loadCatalog();
+  const scenario = loadScenario('Data/Scenarios/level1_texas.json', { catalog });
+  const host = createHost({ scenario, catalog });
+  const messages = []; let receive;
+  const socket = { send: value => messages.push(value), onMessage: callback => { receive = callback; }, onClose() {}, close() {} };
+  try {
+    host.attach(socket);
+    receive({ t: 'hello', v: 1, seat: 'site', client: 'quest' });
+    const welcome = messages.find(message => message.t === 'welcome');
+    assert.equal(welcome.seat, 'site'); assert.equal(welcome.stage, 'level1_texas');
+    const view = welcome.state.view;
+    assert.equal(view.project.job.lengthFt, 3000); assert.ok(Array.isArray(view.project.job.zones));
+    assert.deepEqual(view.crews.map(crew => crew.id), ['exc', 'pipe', 'back']);
+    assert.equal(view.budget, undefined); assert.equal(view.plannedLines, undefined);
+    for (const [i, action] of ['moveTo', 'dismount', 'mount', 'moveTo', 'dismount'].entries()) {
+      receive({ t: 'cmd', v: 1, id: `quest-${i}`, seat: 'site', action, ...(action === 'moveTo' ? { stationFt: 0 } : {}) });
+      assert.equal(messages.find(message => message.id === `quest-${i}`).t, 'ack', action);
+    }
+    const exchange = scenario.lines.find(line => line.id === 'grumble_back_pipe');
+    assert.equal(exchange.turns.length, 2);
+    assert.deepEqual(exchange.turns.map(turn => turn.speaker), ['foreman_back', 'foreman_pipe']);
+    assert.ok(messages.some(message => message.t === 'state'));
+  } finally { host.close(); }
+});
diff --git a/Assets/LOBOver/Tests/level1-host.mjs b/Assets/LOBOver/Tests/level1-host.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8cdbadb13b0356af3adb56faba79729ed807dcaa
--- /dev/null
+++ b/Assets/LOBOver/Tests/level1-host.mjs
@@ -0,0 +1,36 @@
+// Real Node host on the integration-test port. Test-only voice delivery stays outside Monitor/.
+import { createServer } from 'node:http';
+import { createRequire } from 'node:module';
+import { readFile } from 'node:fs/promises';
+import { createInterface } from 'node:readline';
+import { createHost } from '../../../Monitor/src/host/core.js';
+import { loadCatalog } from '../../../Monitor/src/common/catalog.js';
+import { loadScenario } from '../../../Monitor/src/scenario/load.js';
+const require = createRequire(new URL('../../../Monitor/package.json', import.meta.url));
+const { WebSocketServer, WebSocket } = require('ws');
+const catalog = loadCatalog();
+const scenario = loadScenario('Data/Scenarios/level1_texas.json', { catalog });
+const core = createHost({ scenario, catalog });
+const server = createServer();
+const wss = new WebSocketServer({ server, path: '/ws' });
+wss.on('connection', socket => {
+  core.attach({
+    send(message) { if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify(message)); },
+    onMessage(receive) { socket.on('message', raw => {
+      const message = JSON.parse(raw);
+      if (message.t === 'hello' && (message.seat !== 'site' || message.client !== 'quest')) throw new Error('Expected site/quest hello');
+      receive(message);
+    }); },
+    onClose(close) { socket.on('close', close); }, close() { socket.close(); },
+  });
+});
+await new Promise(resolve => server.listen(7333, '127.0.0.1', resolve));
+const input = createInterface({ input: process.stdin });
+input.on('line', async line => {
+  if (line !== 'exchange') return;
+  const scenario = JSON.parse(await readFile('Data/Scenarios/level1_texas.json', 'utf8'));
+  const exchange = scenario.lines.find(item => item.id === 'grumble_back_pipe');
+  const message = JSON.stringify({ t: 'voice', v: 1, seats: ['site'], lineIds: [exchange.id], lines: [exchange] });
+  for (const socket of wss.clients) { socket.send(message); socket.send(message); }
+});
+console.log('Level1 test host listening on 7333');
