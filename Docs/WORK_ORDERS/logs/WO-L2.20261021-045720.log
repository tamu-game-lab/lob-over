            foreach (var audio in model.GetComponentsInChildren<AudioSource>(true))
                if (scaledAudio.Add(audio.GetInstanceID()))
                { audio.minDistance *= model.localScale.x; audio.maxDistance *= model.localScale.x; audio.spatialBlend = 1; audio.rolloffMode = AudioRolloffMode.Logarithmic; }
            foreach (var particle in model.GetComponentsInChildren<ParticleSystem>(true))
            {
                var main = particle.main; main.scalingMode = ParticleSystemScalingMode.Hierarchy;
                main.simulationSpace = ParticleSystemSimulationSpace.Local;
            }
            // Cell surfaces are pointable even while undug; crew proxies cover tiny animated meshes.
            foreach (var cell in world.GetComponentsInChildren<StationCell>()) InspectTarget.Attach(cell.gameObject, "wall");
            foreach (var crew in world.GetComponentsInChildren<CrewRig>())
                if (crew.GetComponent<BoxCollider>() == null)
                {
                    var hit = crew.gameObject.AddComponent<BoxCollider>(); hit.center = new Vector3(0, 2, 0); hit.size = new Vector3(6, 4, 6);
                    InspectTarget.Attach(crew.gameObject, "crew");
                }
        }
        private void Point(InspectTarget target, Vector3 point)
        {
            if (!director.Ready || target == null || !target.transform.IsChildOf(model)) return;
            var crew = target.GetComponentInParent<CrewRig>(); var cell = target.GetComponentInParent<StationCell>();
            var board = target.GetComponentInParent<ZoneBoard>();
            var ft = crew != null ? crew.StationFt : cell != null ? cell.StationFt : board != null
                ? (double)director.Job["zones"].OfType<JObject>().First(z => (int)z["id"] == board.Zone)["fromFt"]
                : Mathf.Clamp(world.transform.InverseTransformPoint(point).x / WorldUnits.MetresPerFoot, 0, (float)world.LengthFt);
            var reply = director.InspectAt(target.target, ft);
            label.text = (string)reply?["text"]; labelTarget = target.transform; labelUntil = Time.unscaledTime + LabelSeconds;
        }
        private void OnEvent(JObject message)
        {
            if (!Director.ForSeat(message, "site")) return;
            card.text = (string)message["card"]?["title"] + "\n" + string.Join("\n", message["card"]?["facts"]?.Values<string>() ?? Enumerable.Empty<string>());
            cardUntil = Time.unscaledTime + CardSeconds;
        }
        private void MissingVoice(string text)
        { label.text = text; labelTarget = null; labelUntil = Time.unscaledTime + 8; } // WO-09 missing-clip fallback.
        private void Update()
        {
            if (Input.GoDown) Place();
            var hand = xr.RightController.position;
            if (Input.GripHeld)
            { if (dragging) model.position += hand - previousHand; dragging = true; }
            else dragging = false;
            previousHand = hand;
            if (controlsText != null) controlsText.text = director.scenarioId + "\nDay " + director.DisplayDay + " / " + director.SecondsPerDay.ToString("0.##") + " s per day";
        }
        private void LateUpdate()
        {
            // SiteSky is shared with the desktop world; its fog must not cover the real room.
            RenderSettings.fog = false;
            if (label == null) return;
            label.gameObject.SetActive(Time.unscaledTime < labelUntil);
            label.transform.position = (labelTarget == null ? model.position : labelTarget.position) + Vector3.up * 0.2f;
            label.transform.rotation = Quaternion.LookRotation(label.transform.position - eye.position);
            card.gameObject.SetActive(Time.unscaledTime < cardUntil);
            card.transform.position = model.position + model.right * (world.LengthFt > 0 ? (float)world.LengthFt * WorldUnits.MetresPerFoot * model.localScale.x / 2 : 1) + Vector3.up * 0.5f;
            card.transform.rotation = Quaternion.LookRotation(card.transform.position - eye.position);
        }
    }
}
StartPanel.cs
using System.Collections;
using LOBOver.Runtime;
using LOBOver.MR;
using LOBOver.VR;
using LOBOver.World;
using TMPro;
using UnityEngine;
using LOBOver.XR;
using UnityEngine.UI;
using UnityEngine.InputSystem;
using UnityEngine.EventSystems;
using System.Collections.Generic;

namespace LOBOver.Start
{
    public enum ShowcaseMode { VRSite, MRDiorama, Desktop }

    // Runs before Director.OnEnable, so opening the scene never starts the simulation behind the menu.
    [DefaultExecutionOrder(-500)]
    public sealed class StartPanel : MonoBehaviour
    {
        public Director director;
        public WorldAssets assets;
        public AudioClip clickClip;
        public XRRig xr;
        public DesktopPreview preview;
        public GameObject fullScaleRoot, vrRoot, mrRoot, desktopRoot, fullScalePlan;
        public Transform panel;
        public GameObject worldTruck;
        public DioramaSeat diorama;
        public ShowcaseMode SelectedMode { get; private set; }
        public string SelectedScenario { get; private set; } = "slice_texas";
        public bool Autoplan { get; private set; } = true;
        public bool Running { get; private set; }
        private TextMeshProUGUI selection;
        public bool Placed { get; private set; }
#if UNITY_EDITOR
        private Vector3 previewPosition;
        private Quaternion previewRotation;
#endif
        private bool beginning;
        private const float PanelAhead = 0.6f; // WO-S6 item 7.
        private const float ChestBelowEye = 0.3f; // Presentation offset for chest-height placement (WO-S6).
        private static readonly string[] Scenarios = { "slice_texas", "stage1_texas", "stage2_texas" };
        private static readonly string[] ScenarioNames = { "Slice", "Stage 1", "Stage 2" };
        private void Awake()
        {
            if (director == null) return;
            director.enabled = false;
            ReadPreferences();
            SetRoots(false, false, false, false);
            if (panel != null && assets != null) { BuildControls(); panel.gameObject.SetActive(false); }
#if UNITY_EDITOR
            if (preview != null)
            {
                previewPosition = preview.previewCamera.transform.position; previewRotation = preview.previewCamera.transform.rotation;
            }
            if (preview != null && !OVRManager.isHmdPresent)
            {
                preview.enabled = false; desktopRoot.SetActive(true);
                if (xr != null && xr.TryHeadPose(out var pose)) preview.previewCamera.transform.SetPositionAndRotation(pose.position, pose.rotation);
            }
#endif
        }
        private IEnumerator Start()
        {
            yield return null;
            if (panel == null || xr == null) yield break;
            Pose pose;
            while (!xr.TryHeadPose(out pose)) yield return null;
            PlaceOnce(pose);
        }
        public void PlaceOnce(Pose pose)
        {
            if (Placed || panel == null) return;
            var forward = Vector3.ProjectOnPlane(pose.rotation * Vector3.forward, Vector3.up).normalized;
            if (forward.sqrMagnitude < 0.1f) forward = Vector3.forward;
            panel.SetPositionAndRotation(pose.position + forward * PanelAhead - Vector3.up * ChestBelowEye, Quaternion.LookRotation(forward));
            panel.gameObject.SetActive(true); Placed = true;
#if UNITY_EDITOR
            if (preview != null && !OVRManager.isHmdPresent)
                preview.previewCamera.transform.SetPositionAndRotation(pose.position, Quaternion.LookRotation(panel.position - pose.position));
#endif
        }
        private void ReadPreferences()
        {
            SelectedMode = (ShowcaseMode)Mathf.Clamp(PlayerPrefs.GetInt("LOBOver.Mode", 0), 0, 2);
#if UNITY_ANDROID && !UNITY_EDITOR
            if (SelectedMode == ShowcaseMode.Desktop) SelectedMode = ShowcaseMode.VRSite;
#endif
            SelectedScenario = PlayerPrefs.GetString("LOBOver.Scenario", Scenarios[0]);
            if (System.Array.IndexOf(Scenarios, SelectedScenario) < 0) SelectedScenario = Scenarios[0];
        }
        public void SelectMode(ShowcaseMode mode) { SelectedMode = mode; Refresh(); }
        public void SelectScenario(string scenario)
        {
            if (System.Array.IndexOf(Scenarios, scenario) < 0) return;
            SelectedScenario = scenario; Refresh();
        }
        private void BuildControls()
        {
            selection = Label("Selection", new Vector2(0, 310), new Vector2(1100, 160), 35);
            var names = new[] { "VR Site", "MR Diorama", "Desktop" };
            for (var i = 0; i < names.Length; i++)
            {
#if !UNITY_EDITOR
                if (i == 2) continue;
#endif
                var mode = (ShowcaseMode)i;
                Button(names[i], new Vector2((i - 1) * 370, 110), new Vector2(340, 140), () => SelectMode(mode));
            }
            for (var i = 0; i < Scenarios.Length; i++)
            {
                var scenario = Scenarios[i];
                Button(ScenarioNames[i], new Vector2((i - 1) * 370, -80), new Vector2(340, 120), () => SelectScenario(scenario));
            }
            Button("Autoplan", new Vector2(-250, -280), new Vector2(440, 130), () => { Autoplan = !Autoplan; Refresh(); });
            Button("Start", new Vector2(250, -280), new Vector2(440, 130), Begin);
            Refresh();
        }
        private TextMeshProUGUI Label(string name, Vector2 position, Vector2 size, float fontSize)
        {
            var obj = new GameObject(name, typeof(RectTransform)); obj.transform.SetParent(panel, false);
            var label = obj.AddComponent<TextMeshProUGUI>(); label.font = assets.font; label.fontSize = fontSize;
            label.alignment = TextAlignmentOptions.Center; label.richText = false; label.raycastTarget = false;
            label.rectTransform.anchoredPosition = position; label.rectTransform.sizeDelta = size; return label;
        }
        private void Button(string title, Vector2 position, Vector2 size, UnityEngine.Events.UnityAction action)
        {
            var obj = new GameObject(title, typeof(RectTransform)); obj.transform.SetParent(panel, false);
            var rect = (RectTransform)obj.transform; rect.anchoredPosition = position; rect.sizeDelta = size;
            var image = obj.AddComponent<Image>(); image.color = new Color(0.85f, 0.43f, 0.15f);
            var button = obj.AddComponent<Button>(); button.targetGraphic = image; button.transition = Selectable.Transition.None;
            var sound = obj.AddComponent<AudioSource>(); sound.playOnAwake = false; sound.spatialBlend = 1; sound.clip = clickClip;
            button.onClick.AddListener(() => { if (sound.clip != null) sound.Play(); }); button.onClick.AddListener(action);
            var label = Label(title + "Label", Vector2.zero, size * 0.9f, 35); label.text = title; label.transform.SetParent(rect, false);
        }
        private void Refresh()
        {
            PlayerPrefs.SetInt("LOBOver.Mode", (int)SelectedMode); PlayerPrefs.SetString("LOBOver.Scenario", SelectedScenario); PlayerPrefs.Save();
            if (selection != null) selection.text = "LOB, Over\n" + new[] { "VR Site", "MR Diorama", "Desktop" }[(int)SelectedMode] + " / " + ScenarioNames[System.Array.IndexOf(Scenarios, SelectedScenario)] + " / Autoplan " + (Autoplan ? "on" : "off");
        }
        public void Begin()
        {
            if (beginning || Running) return;
            beginning = true; StartCoroutine(BeginMode());
        }
        private IEnumerator BeginMode()
        {
            yield return null;
            ActivateMode(SelectedMode);
            director.AutoplanEnabled = Autoplan; director.scenarioId = SelectedScenario;
            director.enabled = true;
            // OnEnable performs the first load. Reusing the panel in tests may find a ready Director.
            if (director.Ready) director.Load(SelectedScenario);
            beginning = false;
        }
        // Public seam for PlayMode tests: only root routing; it does not require XR or start a job.
        public void ActivateMode(ShowcaseMode mode)
        {
            SelectedMode = mode; Running = true;
            var vr = mode == ShowcaseMode.VRSite; var mr = mode == ShowcaseMode.MRDiorama;
            SetRoots(vr || mode == ShowcaseMode.Desktop, vr, mr, mode == ShowcaseMode.Desktop);
            if (fullScalePlan != null) fullScalePlan.SetActive(mode == ShowcaseMode.Desktop);
            if (worldTruck != null) worldTruck.SetActive(mode != ShowcaseMode.VRSite);
            if (panel != null) panel.gameObject.SetActive(false);
#if UNITY_EDITOR
            if (preview != null)
            {
                preview.previewCamera.transform.SetPositionAndRotation(previewPosition, previewRotation);
                preview.enabled = mode == ShowcaseMode.Desktop;
            }
#endif
            if (mr && diorama != null) diorama.Place();
        }
        private void SetRoots(bool full, bool vr, bool mr, bool desktop)
        {
            if (fullScaleRoot != null) fullScaleRoot.SetActive(full);
            if (vrRoot != null) vrRoot.SetActive(vr);
            if (mrRoot != null) mrRoot.SetActive(mr);
            if (desktopRoot != null) desktopRoot.SetActive(desktop);
        }
        private void Update()
        {
#if UNITY_EDITOR
            // Editor mouse uses the same uGUI Button events; device presses come solely from ISDK.
            if (!Running && Placed && preview != null && !OVRManager.isHmdPresent && Mouse.current != null
                && Mouse.current.leftButton.wasReleasedThisFrame && EventSystem.current != null)
            {
                var data = new PointerEventData(EventSystem.current) { position = Mouse.current.position.ReadValue() };
                var hits = new List<RaycastResult>();
                panel.GetComponent<Canvas>().worldCamera = preview.previewCamera;
                panel.GetComponent<GraphicRaycaster>().Raycast(data, hits);
                if (hits.Count > 0) ExecuteEvents.ExecuteHierarchy(hits[0].gameObject, data, ExecuteEvents.pointerClickHandler);
            }
#endif
            if (director != null && director.LoadError != null && selection != null)
            { panel.gameObject.SetActive(true); selection.text = director.LoadError; }
        }
    }
}
XRSceneSetup.cs
using System;
using System.Linq;
using LOBOver.Editor;
using LOBOver.Runtime;
using LOBOver.VR;
using LOBOver.MR;
using LOBOver.World;
using LOBOver.XR;
using Oculus.Interaction;
using UnityEngine.EventSystems;
using UnityEngine.UI;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;
using UnityEngine.SceneManagement;
using Object = UnityEngine.Object;

namespace LOBOver.Start.Editor
{
    public static class XRSceneSetup
    {
        // The builder passes only its owned world; block objects are discovered, never altered.
        public static void Build(SiteWorld world, DesktopPreview preview, WorldAssets assets)
        {
            var scene = world.gameObject.scene;
            var full = world.transform.parent.gameObject;
            var site = full.transform.parent;
            var hub = scene.GetRootGameObjects().Single(root => root.name == "[LOBOver] Hub").transform;
            var xr = world.director.GetComponent<XRRig>(); xr.Resolve(false); preview.xr = xr;
            var mr = WorldDrawing.Group("MRDiorama", hub); mr.SetActive(false);
            var model = Object.Instantiate(full, mr.transform); model.name = "DioramaRoot";
            model.transform.localScale = Vector3.one * DioramaSeat.ScaleFor(DioramaSeat.SliceLengthFeet);
            var modelWorld = model.GetComponentInChildren<SiteWorld>(true); modelWorld.sky.enabled = false;
            modelWorld.director = world.director;
            var before = model.transform.Find("Ground/BeforeTrench"); if (before != null) Object.DestroyImmediate(before.gameObject);
            var dome = modelWorld.sky.transform.Find("SkyInspectDome"); if (dome != null) Object.DestroyImmediate(dome.gameObject);
            InspectTarget.Attach(modelWorld.trailerBoard.gameObject, "board");
            InspectTarget.Attach(modelWorld.planPanel.gameObject, "board");
            var clip = SiteAssetBuilder.Required<AudioClip>("Assets/LOBGame/Audio/Construction/hydraulics_01.wav");
            var vr = WorldDrawing.Group("VRSite", site); vr.SetActive(false);
            var seat = vr.AddComponent<InspectorSeat>();
            seat.director = world.director; seat.world = world; seat.xr = xr; seat.siteSpace = site; seat.assets = assets; seat.clickClip = clip;
            seat.cab = BuildCab(vr.transform, assets, out var dashboard); seat.dashboard = dashboard;
            seat.wrist = Wrist("InspectorClipboard", vr.transform, xr, assets, new Vector2(0.22f, 0.16f));
            var fadeObject = WorldDrawing.Group("ComfortMask", vr.transform);
            fadeObject.AddComponent<RigAnchorFollower>().rig = xr;
            seat.fade = fadeObject.AddComponent<ComfortFade>();
            var fadePath = SiteAssetBuilder.Prefabs + "ComfortFade.mat";
            var fadeMaterial = AssetDatabase.LoadAssetAtPath<Material>(fadePath);
            if (fadeMaterial == null)
            {
                var shader = Shader.Find("LOBOver/ComfortFade");
                if (shader == null) throw new InvalidOperationException("LOBOver/ComfortFade shader is not imported");
                fadeMaterial = new Material(shader); AssetDatabase.CreateAsset(fadeMaterial, fadePath);
            }
            seat.fade.material = fadeMaterial;
            seat.speech = vr.AddComponent<InspectionSpeech>();
            seat.voice = vr.AddComponent<SeatAudio>(); seat.voice.director = world.director; seat.voice.world = world;
            seat.voice.listener = xr.CentreEye; seat.voice.dashboard = dashboard;
            seat.flagPrefab = Flag("InspectorFlag", assets, false); seat.stopFlagPrefab = Flag("StopWorkFlag", assets, true);
            var diorama = mr.AddComponent<DioramaSeat>();
            diorama.director = world.director; diorama.world = modelWorld; diorama.model = model.transform;
            diorama.xr = xr; diorama.assets = assets; diorama.clickClip = clip;
            diorama.wrist = Wrist("DioramaControls", mr.transform, xr, assets, new Vector2(0.28f, 0.17f));
            diorama.voice = mr.AddComponent<SeatAudio>(); diorama.voice.director = world.director; diorama.voice.world = modelWorld;
            diorama.voice.listener = xr.CentreEye; diorama.voice.dashboard = model.transform; diorama.voice.presenter = true;
            if (!XRRig.Components<AudioListener>(scene).Any(listener => listener.isActiveAndEnabled))
            {
                var listener = WorldDrawing.Group("SeatListener", world.director.transform);
                listener.AddComponent<AudioListener>(); listener.AddComponent<RigAnchorFollower>().rig = xr;
            }
            if (!XRRig.Components<PointableCanvasModule>(scene).Any(module => module.isActiveAndEnabled))
            {
                var events = WorldDrawing.Group("UIEvents", world.director.transform);
                events.AddComponent<EventSystem>(); events.AddComponent<PointableCanvasModule>();
            }
            var start = new GameObject("[LOBOver] Start").AddComponent<StartPanel>();
            start.director = world.director; start.assets = assets; start.clickClip = clip; start.xr = xr; start.diorama = diorama;
            start.fullScaleRoot = full; start.vrRoot = vr; start.mrRoot = mr; start.desktopRoot = preview.gameObject;
            start.fullScalePlan = world.planPanel.gameObject; start.worldTruck = world.truck.gameObject; start.preview = preview;
            var canvasObject = new GameObject("StartChoices", typeof(RectTransform)); canvasObject.transform.SetParent(start.transform, false);
            var canvas = canvasObject.AddComponent<Canvas>(); canvas.renderMode = RenderMode.WorldSpace;
            var rect = (RectTransform)canvas.transform; rect.sizeDelta = new Vector2(1200, 850);
            rect.localScale = Vector3.one * 0.0005f;
            canvasObject.AddComponent<GraphicRaycaster>();
            canvasObject.AddComponent<Image>().color = new Color(0.12f, 0.15f, 0.17f, 1);
            InteractionSurface.Canvas(canvas); start.panel = rect;
            world.director.enabled = false;
        }
        private static Transform Wrist(string name, Transform parent, XRRig xr, WorldAssets assets, Vector2 size)
        {
            var root = WorldDrawing.Group(name, parent).transform;
            var follower = root.gameObject.AddComponent<RigAnchorFollower>(); follower.rig = xr; follower.leftWrist = true;
            follower.positionOffset = new Vector3(0, 0.05f, 0.08f); follower.rotationOffset = new Vector3(60, 0, 0);
            WorldDrawing.Box("Board", root, Vector3.zero, new Vector3(size.x, size.y, 0.01f), assets.steel); return root;
        }
        private static Transform BuildCab(Transform parent, WorldAssets assets, out Transform dashboard)
        {
            var root = WorldDrawing.Group("SiteTruck", parent).transform;
            // WO-09 section 1: 2.2 x 2 x 2.6 m frame; the +Z front stays open.
            for (var x = -1; x <= 1; x += 2)
            {
                WorldDrawing.Box("RearPillar", root, new Vector3(x * 1.1f, 1, -1.3f), new Vector3(0.08f, 2, 0.08f), assets.steel);
                WorldDrawing.Box("FrontPillar", root, new Vector3(x * 1.1f, 1, 1.3f), new Vector3(0.08f, 2, 0.08f), assets.steel);
                WorldDrawing.Box("SideSill", root, new Vector3(x * 1.1f, 0.45f, 0), new Vector3(0.08f, 0.08f, 2.6f), assets.steel);
                WorldDrawing.Box("RoofRail", root, new Vector3(x * 1.1f, 2, 0), new Vector3(0.08f, 0.08f, 2.6f), assets.steel);
            }
            WorldDrawing.Box("Floor", root, new Vector3(0, 0.05f, 0), new Vector3(2.2f, 0.1f, 2.6f), assets.steel);
            WorldDrawing.Box("DriverSeat", root, new Vector3(0, 0.45f, 0), new Vector3(0.55f, 0.15f, 0.6f), assets.steel);
            WorldDrawing.Box("SeatBack", root, new Vector3(0, 0.75f, -0.3f), new Vector3(0.55f, 0.6f, 0.1f), assets.steel);
            dashboard = WorldDrawing.Group("Dashboard", root).transform; dashboard.localPosition = new Vector3(0, 1.1f, 0.8f);
            WorldDrawing.Box("Board", dashboard, Vector3.zero, new Vector3(0.8f, 0.3f, 0.04f), assets.steel);
            return root;
        }
        private static GameObject Flag(string name, WorldAssets assets, bool stopped)
        {
            var root = new GameObject(name);
            try
            {
                var material = assets.orange;
                if (stopped)
                {
                    var path = SiteAssetBuilder.Prefabs + "StopWorkFact.mat";
                    material = AssetDatabase.LoadAssetAtPath<Material>(path);
                    if (material == null) { material = new Material(assets.orange); AssetDatabase.CreateAsset(material, path); }
                    material.SetColor("_BaseColor", new Color(0.8f, 0.06f, 0.04f)); EditorUtility.SetDirty(material);
                }
                WorldDrawing.Box("Pole", root.transform, new Vector3(0, 0.6f, 0), new Vector3(0.04f, 1.2f, 0.04f), assets.timber);
                // A stop-work flag records the inspector's action, never a judgement of that action.
                WorldDrawing.Box("Flag", root.transform, new Vector3(0.2f, 1, 0), new Vector3(0.4f, 0.25f, 0.02f), material);
                return PrefabUtility.SaveAsPrefabAsset(root, SiteAssetBuilder.Prefabs + name + ".prefab");
            }
            finally { Object.DestroyImmediate(root); }
        }
    }
}
InspectionSpeech.cs
using UnityEngine;

namespace LOBOver.VR
{
    public sealed class InspectionSpeech : MonoBehaviour
    {
#if UNITY_ANDROID && !UNITY_EDITOR
        private AndroidJavaObject speech;
        private bool ready;
        private sealed class Listener : AndroidJavaProxy
        {
            private readonly InspectionSpeech owner;
            public Listener(InspectionSpeech value) : base("android.speech.tts.TextToSpeech$OnInitListener") { owner = value; }
            public void onInit(int status) { owner.ready = status == 0; }
        }
        private Listener listener;
        private void Start()
        {
            try
            {
                using (var player = new AndroidJavaClass("com.unity3d.player.UnityPlayer"))
                using (var activity = player.GetStatic<AndroidJavaObject>("currentActivity"))
                {
                    listener = new Listener(this);
                    speech = new AndroidJavaObject("android.speech.tts.TextToSpeech", activity, listener);
                }
            }
            catch (AndroidJavaException) { ready = false; }
        }
#endif
        public void Speak(string text)
        {
#if UNITY_ANDROID && !UNITY_EDITOR
            if (!ready || speech == null) return;
            try { speech.Call<int>("speak", text, 0, null, "inspection"); }
            catch (AndroidJavaException) { ready = false; }
#endif
        }
        private void OnDestroy()
        {
#if UNITY_ANDROID && !UNITY_EDITOR
            if (speech == null) return;
            speech.Call("stop"); speech.Call("shutdown"); speech.Dispose(); speech = null;
#endif
        }
    }
}
InspectorInput.cs
using System;
using System.Collections.Generic;
using LOBOver.Sim;
using Newtonsoft.Json.Linq;

namespace LOBOver.VR
{
    public enum InspectorButton { None, Flag, StopWork, Confirm, Done, NotCarriedOut }
    public interface IInspectorInput
    {
        bool TriggerDown { get; }
        bool GoDown { get; }
        bool MountDown { get; }
        bool GripHeld { get; }
        float Turn { get; }
        float Navigate { get; }
        InspectorButton Button { get; }
    }
    public sealed class OvrInput : IInspectorInput
    {
        public bool TriggerDown => false; // Selection is delivered by Interaction SDK pointer events.
        public bool GoDown => OVRInput.GetDown(OVRInput.RawButton.A);
        public bool MountDown => OVRInput.GetDown(OVRInput.RawButton.B);
        public bool GripHeld => OVRInput.Get(OVRInput.RawButton.RHandTrigger);
        public float Turn => OVRInput.Get(OVRInput.RawAxis2D.RThumbstick).x;
        public float Navigate => OVRInput.Get(OVRInput.RawAxis2D.RThumbstick).y;
        public InspectorButton Button => InspectorButton.None;
    }
    public sealed class FakeInput : IInspectorInput
    {
        public bool TriggerDown { get; set; }
        public bool GoDown { get; set; }
        public bool MountDown { get; set; }
        public bool GripHeld { get; set; }
        public float Turn { get; set; }
        public float Navigate { get; set; }
        public InspectorButton Button { get; set; }
    }

    // The input seam consumes Site state only. Tests advance its clock without a headset.
    public sealed class InspectorInputLayer
    {
        public const float DwellSeconds = 2, CooldownSeconds = 4; // WO-09 section 4.
        public event Action<JObject> Command;
        public event Action<string> Text;
        public event Action ConfirmRequested;
        public TruckView Truck { get; private set; }
        public double CabStation { get; private set; }
        public float DwellFraction => Math.Min(1, dwell / DwellSeconds);
        private string focused;
        private float dwell;
        private bool fired;
        private readonly Dictionary<string, float> lastInspection = new Dictionary<string, float>();

        public void Observe(TruckView truck)
        {
            Truck = truck;
            // The simulation interpolates stationFt during travel. Never expose that as cab motion.
            if (!truck.moving) CabStation = truck.stationFt;
        }
        public void Tick(IInspectorInput input, float dt, float now, string identity, string target, int zone, string orderId)
        {
            if (input.MountDown && Truck != null) Send(new JObject { ["action"] = Truck.dismounted ? "mount" : "dismount" });
            if (input.Button != InspectorButton.None) Press(input.Button, zone, orderId);
            if (identity != focused) { focused = identity; dwell = 0; fired = false; }
            if (identity == null || Truck == null || !Truck.dismounted || Truck.moving) { dwell = 0; return; }
            dwell += Math.Max(0, dt);
            if (fired || dwell < DwellSeconds || lastInspection.TryGetValue(identity, out var last) && now - last < CooldownSeconds) return;
            fired = true; lastInspection[identity] = now;
            Send(new JObject { ["action"] = "inspect", ["target"] = target });
        }
        public void Ride(double station)
        {
            if (Truck == null) return;
            if (Truck.moving || Truck.dismounted) { Text?.Invoke("mount before moving"); return; }
            Send(new JObject { ["action"] = "moveTo", ["stationFt"] = station });
        }
        public void Press(InspectorButton button, int zone, string orderId)
        {
            if (Truck == null || !Truck.dismounted || Truck.moving) { Text?.Invoke("dismount first"); return; }
            if (button == InspectorButton.Flag)
                Send(new JObject { ["action"] = "flag", ["stationFt"] = Truck.stationFt, ["note"] = "" });
            if (button == InspectorButton.StopWork) Send(new JObject { ["action"] = "stopWork", ["zone"] = zone });
            if (button == InspectorButton.Confirm)
            { if (orderId == null) Text?.Invoke("no order landed here"); else ConfirmRequested?.Invoke(); }
            if (button == InspectorButton.Done || button == InspectorButton.NotCarriedOut)
            {
                if (orderId == null) { Text?.Invoke("no order landed here"); return; }
                Send(new JObject { ["action"] = "confirm", ["orderId"] = orderId, ["outcome"] = button == InspectorButton.Done ? "done" : "notDone" });
            }
        }
        private void Send(JObject command) => Command?.Invoke(command);
    }
}
InspectorSeat.cs
using System.Collections;
using System.Collections.Generic;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.Sim;
using LOBOver.World;
using LOBOver.XR;
using Newtonsoft.Json.Linq;
using TMPro;
using UnityEngine;

namespace LOBOver.VR
{
    public sealed class InspectorSeat : MonoBehaviour
    {
        public Director director;
        public SiteWorld world;
        public XRRig xr;
        public Transform siteSpace;
        public IInspectorInput Input { get; set; } = new OvrInput();
        public Transform cab, dashboard, wrist;
        public WorldAssets assets;
        public AudioClip clickClip;
        public ComfortFade fade;
        public SeatAudio voice;
        public InspectionSpeech speech;
        public GameObject flagPrefab, stopFlagPrefab;
        public InspectorInputLayer InputLayer { get; private set; }
        private TextMeshPro clipboard, dashText, cardText, wristCard, selectedText;
        private GameObject confirmation;
        private Transform zoneChoices;
        private RayButton destinationButton;
        private readonly List<RayButton> verbs = new List<RayButton>();
        private readonly List<double> destinations = new List<double>();
        private readonly List<GameObject> flags = new List<GameObject>();
        private readonly HashSet<string> listened = new HashSet<string>();
        private LineRenderer reticle;
        private AudioSource engine;
        private Coroutine ride;
        private bool positioned, dismounted, turnLatched, navLatched;
        private double station;
        private float fadeSeconds = ShortFade, cardUntil, voiceUntil;
        private string inspection = "", missingVoice = "";
        private int selected;
        private JObject pendingFact;
        // WO-09 sections 1-7: comfort, geometry and card timings.
        private const float ShortFade = 0.3f, LongFade = 0.6f, EngineSeconds = 1.5f, SeatEye = 1.15f;
        private const float StandingEye = 1.7f, EdgeOffset = 1.5f, SnapDegrees = 30, CardSeconds = 20, VoiceSeconds = 8;

        private void OnEnable()
        {
            if (director == null) return;
            if (InputLayer == null) BuildControls();
            wrist.gameObject.SetActive(true);
            director.ViewsChanged += OnViews; director.Message += OnMessage; director.Loaded += ResetSeat;
            InspectTarget.Selected += Point; voice.MissingVoice += MissingVoice;
            ResetSeat();
            if (director.SiteView != null) OnViews(director.SiteView, null);
        }
        private void OnDisable()
        {
            if (director == null) return;
            director.ViewsChanged -= OnViews; director.Message -= OnMessage; director.Loaded -= ResetSeat;
            InspectTarget.Selected -= Point; voice.MissingVoice -= MissingVoice;
            if (ride != null) StopCoroutine(ride);
            ride = null; if (engine != null) engine.Stop(); if (fade != null) fade.SetExplicitFade(0);
            wrist.gameObject.SetActive(false);
        }
        private void ResetSeat()
        {
            if (ride != null) StopCoroutine(ride);
            ride = null; positioned = false; listened.Clear(); destinations.Clear(); selected = 0;
            inspection = ""; missingVoice = ""; cardUntil = voiceUntil = 0; pendingFact = null;
            confirmation.SetActive(false);
            foreach (var flag in flags) if (flag != null) Destroy(flag);
            flags.Clear();
            if (director.Job == null) return;
            var length = (double)director.Job["lengthFt"];
            for (double ft = 0; ft <= length; ft += WorldUnits.StationFeet) destinations.Add(ft);
            foreach (var zone in director.Job["zones"].OfType<JObject>()) destinations.Add((double)zone["fromFt"]);
            if (zoneChoices != null) WorldDrawing.Remove(zoneChoices.gameObject);
            zoneChoices = WorldDrawing.Group("ZoneDestinations", dashboard).transform;
            var zones = director.Job["zones"].OfType<JObject>().ToArray();
            for (var i = 0; i < zones.Length; i++)
            {
                var ft = (double)zones[i]["fromFt"];
                RayButton.Create(zoneChoices, "Zone " + zones[i]["id"] + "\n" + WorldUnits.Station(ft),
                    new Vector3((i - (zones.Length - 1) / 2f) * 0.19f, -0.30f, -0.04f), new Vector2(0.18f, 0.07f), assets, clickClip, () => InputLayer.Ride(ft));
            }
            // The slice's collapse stake is authored at 5+20, between the regular survey stakes.
            // Offer crew stations as well (updated when cycling), without rounding the selected destination.
            RefreshDestinations();
        }
        private void BuildControls()
        {
            InputLayer = new InspectorInputLayer(); InputLayer.Command += Send;
            InputLayer.Text += text => inspection = text;
            InputLayer.ConfirmRequested += () => confirmation.SetActive(true);
            clipboard = WorldDrawing.Text("Inspection", wrist, new Vector3(0, 0.012f, -0.012f), new Vector2(0.20f, 0.10f), 0.012f, assets.font);
            clipboard.enableAutoSizing = true; clipboard.fontSizeMin = 0.65f; clipboard.fontSizeMax = 1.2f;
            wristCard = WorldDrawing.Text("Event", wrist, new Vector3(0, 0.15f, -0.012f), new Vector2(0.22f, 0.13f), 0.012f, assets.font);
            var labels = new[] { "Flag", "Stop work", "Confirm" };
            for (var i = 0; i < labels.Length; i++)
            {
                var button = (InspectorButton)(i + 1);
                verbs.Add(RayButton.Create(wrist, labels[i], new Vector3((i - 1) * 0.065f, -0.06f, -0.015f), new Vector2(0.03f, 0.02f), assets, clickClip, () => Press(button)));
            }
            confirmation = WorldDrawing.Group("ConfirmOutcome", wrist);
            RayButton.Create(confirmation.transform, "Done", new Vector3(-0.055f, -0.105f, 0), new Vector2(0.09f, 0.035f), assets, clickClip, () => Press(InspectorButton.Done));
            RayButton.Create(confirmation.transform, "Not carried out", new Vector3(0.055f, -0.105f, 0), new Vector2(0.09f, 0.035f), assets, clickClip, () => Press(InspectorButton.NotCarriedOut));
            dashText = WorldDrawing.Text("TruckState", dashboard, new Vector3(0, 0.09f, -0.04f), new Vector2(0.75f, 0.08f), 0.03f, assets.font);
            selectedText = WorldDrawing.Text("Destination", dashboard, new Vector3(0, 0.02f, -0.04f), new Vector2(0.75f, 0.08f), 0.027f, assets.font);
            RayButton.Create(dashboard, "Previous", new Vector3(-0.26f, -0.08f, -0.04f), new Vector2(0.22f, 0.06f), assets, clickClip, () => Select(-1));
            destinationButton = RayButton.Create(dashboard, "Ride", new Vector3(0, -0.08f, -0.04f), new Vector2(0.22f, 0.06f), assets, clickClip, RideSelected);
            RayButton.Create(dashboard, "Next", new Vector3(0.26f, -0.08f, -0.04f), new Vector2(0.22f, 0.06f), assets, clickClip, () => Select(1));
            RayButton.Create(dashboard, "Settings: fade 0.3 s / 0.6 s", new Vector3(0, -0.20f, -0.04f), new Vector2(0.5f, 0.06f), assets, clickClip,
                () => { fadeSeconds = fadeSeconds == ShortFade ? LongFade : ShortFade; });
            cardText = WorldDrawing.Text("EventCard", dashboard, new Vector3(0, 0.42f, -0.04f), new Vector2(0.8f, 0.45f), 0.035f, assets.font);
            engine = WorldDrawing.Sound(cab.gameObject, true); engine.clip = assets.dozer;
            reticle = WorldDrawing.Line("DwellReticle", transform, assets.ink, Color.white, 0.0005f);
            reticle.gameObject.AddComponent<RigAnchorFollower>().rig = xr;
            reticle.positionCount = 33;
        }
        private void RefreshDestinations()
        {
            if (director.SiteView != null)
                foreach (var crew in director.SiteView.crews)
                    if (!destinations.Contains(crew.stationFt)) destinations.Add(crew.stationFt);
            destinations.Sort();
        }
        private void Select(int direction)
        {
            RefreshDestinations();
            if (destinations.Count == 0) return;
            selected = (selected + direction + destinations.Count) % destinations.Count;
        }
        private void RideSelected() { if (destinations.Count > 0) InputLayer.Ride(destinations[selected]); }
        private string FirstOrder => director.SiteView?.orders.FirstOrDefault()?.id;
        private int Zone => director.SiteView == null ? 0 : world.ZoneAt(director.SiteView.truck.stationFt);
        private void Press(InspectorButton button)
        {
            DismissCard(); InputLayer.Press(button, Zone, FirstOrder);
            if (button == InspectorButton.Done || button == InspectorButton.NotCarriedOut) confirmation.SetActive(false);
        }
        private void Send(JObject command)
        {
            var action = (string)command["action"];
            pendingFact = action == "flag" || action == "stopWork" ? (JObject)command.DeepClone() : null;
            director.Send(command);
            if (action == "moveTo" && director.SiteView?.truck.moving == true && ride == null) ride = StartCoroutine(Ride());
        }
        private void OnViews(SiteView site, PlanView ignored)
        {
            InputLayer.Observe(site.truck);
            if (!positioned) { Position(site.truck); positioned = true; }
            else if (ride == null && !site.truck.moving && (station != site.truck.stationFt || dismounted != site.truck.dismounted))
                ride = StartCoroutine(Ride(false));
            if (site.truck.moving && ride == null) ride = StartCoroutine(Ride());
        }
        private void Position(TruckView truck)
        {
            station = truck.stationFt; dismounted = truck.dismounted;
            cab.localPosition = new Vector3((float)station * WorldUnits.MetresPerFoot, 0, WorldUnits.RoadZ);
            cab.localRotation = Quaternion.Euler(0, 90, 0);
            var eye = xr.CentreEye;
            // Preserve the existing discrete ride while keeping the tracked rig fixed: move only our site.
            var desired = siteSpace.TransformPoint(new Vector3((float)station * WorldUnits.MetresPerFoot,
                dismounted ? StandingEye : SeatEye, dismounted ? WorldUnits.TrenchWidth / 2 + EdgeOffset : WorldUnits.RoadZ));
            var yaw = eye.eulerAngles.y - ((dismounted ? 180 : 90) + siteSpace.eulerAngles.y);
            siteSpace.RotateAround(desired, Vector3.up, yaw);
            siteSpace.position += eye.position - desired;
            world.sky.observer = eye;
        }
        private void Point(InspectTarget target, Vector3 position)
        {
            if (director.SiteView == null || !target.transform.IsChildOf(world.transform.parent)) return;
            DismissCard();
            if (director.SiteView.truck.dismounted && !director.SiteView.truck.moving)
                director.Send(new JObject { ["action"] = "inspect", ["target"] = target.target });
        }
        private IEnumerator Ride(bool engineOn = true)
        {
            yield return Fade(0, 1);
            if (engineOn)
            { engine.Play(); yield return new WaitForSecondsRealtime(EngineSeconds); engine.Stop(); }
            while (director.SiteView == null || director.SiteView.truck.moving) yield return null;
            Position(director.SiteView.truck);
            yield return Fade(1, 0); ride = null;
        }
        private IEnumerator Fade(float from, float to)
        {
            for (float elapsed = 0; elapsed < fadeSeconds; elapsed += Time.unscaledDeltaTime)
            { fade.SetExplicitFade(Mathf.Lerp(from, to, elapsed / fadeSeconds)); yield return null; }
            fade.SetExplicitFade(to);
        }
        private void Update()
        {
            if (InputLayer == null || director.SiteView == null) return;
            var input = Input;
            if (input.MountDown) DismissCard();
            var eye = xr.CentreEye;
            InspectTarget target = null;
            if (ride == null && Physics.Raycast(eye.position, eye.forward, out var hit, 6000, ~0, QueryTriggerInteraction.Collide))
                target = hit.collider.GetComponentInParent<InspectTarget>();
            InputLayer.Tick(input, Time.unscaledDeltaTime, Time.unscaledTime, target == null ? null : target.GetInstanceID().ToString(), target?.target, Zone, FirstOrder);
            if (input.GoDown) { DismissCard(); RideSelected(); }
            if (Mathf.Abs(input.Turn) < 0.3f) turnLatched = false;
            if (!turnLatched && Mathf.Abs(input.Turn) > 0.7f && ride == null)
            { siteSpace.RotateAround(eye.position, Vector3.up, -Mathf.Sign(input.Turn) * SnapDegrees); turnLatched = true; }
            if (Mathf.Abs(input.Navigate) < 0.3f) navLatched = false;
            if (!navLatched && Mathf.Abs(input.Navigate) > 0.7f) { Select(input.Navigate > 0 ? 1 : -1); navLatched = true; }
            for (var i = 0; i < 33; i++)
            {
                var angle = i / 32f * Mathf.PI * 2;
                var radius = Mathf.Lerp(0.002f, 0.007f, InputLayer.DwellFraction);
                reticle.SetPosition(i, new Vector3(Mathf.Cos(angle) * radius, Mathf.Sin(angle) * radius, 0.5f));
            }
            reticle.gameObject.SetActive(ride == null && target != null);
            var truck = director.SiteView.truck;
            dashText.text = truck.moving || ride != null ? "driving" : WorldUnits.Station(truck.stationFt) + (truck.dismounted ? " dismounted" : " mounted");
            if (destinations.Count > 0)
            {
                selectedText.text = "Previous " + WorldUnits.Station(destinations[(selected + destinations.Count - 1) % destinations.Count]) + "   > " + WorldUnits.Station(destinations[selected]) + "   Next " + WorldUnits.Station(destinations[(selected + 1) % destinations.Count]);
                destinationButton.label.text = "Ride " + WorldUnits.Station(destinations[selected]);
            }
            clipboard.text = "Day " + director.DisplayDay + " / " + director.Speed + "\n" + (Time.unscaledTime < voiceUntil ? missingVoice : inspection);
            cardText.gameObject.SetActive(Time.unscaledTime < cardUntil); wristCard.gameObject.SetActive(Time.unscaledTime < cardUntil);
            foreach (var button in verbs) button.Available = truck.dismounted && !truck.moving;
            if (truck.dismounted && !truck.moving)
                foreach (var crew in director.SiteView.crews.Where(c => c.status == "arguing" || c.status == "held"))
                {
                    var key = crew.id + ":" + crew.status + ":" + crew.moodLevel;
                    if (Vector3.Distance(eye.position, world.Crew(crew.id).transform.position) <= 10 && listened.Add(key))
                        director.Send(new JObject { ["action"] = "listen" });
                }
        }
        private void DismissCard() { cardUntil = 0; }
        private void MissingVoice(string value) { missingVoice = value; voiceUntil = Time.unscaledTime + VoiceSeconds; }
        private void OnMessage(JObject message)
        {
            var type = (string)message["t"];
            if (type == "ack" && pendingFact != null)
            {
                var isStop = (string)pendingFact["action"] == "stopWork";
                var obj = Instantiate(isStop ? stopFlagPrefab : flagPrefab, world.transform);
                var position = isStop ? world.Board((int)pendingFact["zone"]).transform.localPosition : new Vector3((float)pendingFact["stationFt"] * WorldUnits.MetresPerFoot, 0, 1.2f);
                obj.transform.localPosition = position; flags.Add(obj); pendingFact = null;
            }
            if (type == "nack") { inspection = (string)message["reason"]; pendingFact = null; }
            if (!Director.ForSeat(message, "site")) return;
            if (type == "inspection") { inspection = (string)message["text"]; speech.Speak(inspection); }
            if (type == "event")
            {
                cardText.text = (string)message["card"]?["title"] + "\n" + string.Join("\n", message["card"]?["facts"]?.Values<string>() ?? Enumerable.Empty<string>());
                wristCard.text = cardText.text; cardUntil = Time.unscaledTime + CardSeconds;
            }
        }
    }
}
RayButton.cs
using System;
using LOBOver.World;
using LOBOver.XR;
using TMPro;
using UnityEngine;

namespace LOBOver.VR
{
    public sealed class RayButton : MonoBehaviour
    {
        public TextMeshPro label;
        public Transform face;
        public AudioSource click;
        public bool Available = true;
        public Action Pressed;
        private float depressedUntil;
        // WO-09 section 5: 5 mm depression; the short click uses hydraulics_01.
        public void Press()
        {
            depressedUntil = Time.unscaledTime + 0.12f;
            if (click != null && click.clip != null) click.Play();
            Pressed?.Invoke();
        }
        private void Update()
        {
            if (face != null) face.localPosition = new Vector3(0, 0, Time.unscaledTime < depressedUntil ? 0.005f : 0);
            if (label != null) label.color = Available ? Color.white : Color.gray;
        }
        public static RayButton Create(Transform parent, string title, Vector3 position, Vector2 size, WorldAssets assets, AudioClip sound, Action action)
        {
            var root = WorldDrawing.Group(title, parent); root.transform.localPosition = position;
            var button = root.AddComponent<RayButton>();
            button.face = WorldDrawing.Box("SafetyOrange", root.transform, Vector3.zero, new Vector3(size.x, size.y, 0.01f), assets.orange).transform;
            button.label = WorldDrawing.Text("Label", root.transform, new Vector3(0, 0, -0.006f), size * 0.9f, size.y * 0.27f, assets.font);
            button.label.alignment = TextAlignmentOptions.Center; button.label.text = title;
            button.click = WorldDrawing.Sound(root, false, 2); button.click.clip = sound;
            button.Pressed = action;
            var surface = WorldDrawing.Group("ButtonSurface", root.transform); surface.transform.localPosition = new Vector3(0, 0, -0.006f);
            InteractionSurface.Button(surface, size).Selected += _ => button.Press();
            return button;
        }
    }
}
SeatAudio.cs
using System;
using System.Collections;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using LOBOver.Runtime;
using LOBOver.World;
using Newtonsoft.Json.Linq;
using UnityEngine;
using UnityEngine.Networking;

namespace LOBOver.VR
{
    public sealed class SeatAudio : MonoBehaviour
    {
        public Director director;
        public SiteWorld world;
        public Transform listener, dashboard;
        public bool presenter;
        public event Action<string> MissingVoice;
        private readonly Queue<string> queue = new Queue<string>();
        private readonly List<string> waiting = new List<string>();
        private AudioSource source;
        private Coroutine playing;
        private const float ListenMetres = 10, MissingSeconds = 8; // WO-09 sections 5-6.
        private void OnEnable()
        {
            if (director == null) return;
            director.Voice += OnVoice; director.Loaded += Clear;
            if (source == null) source = WorldDrawing.Sound(WorldDrawing.Group("ForemanVoice", transform), false);
        }
        private void OnDisable()
        {
            if (director != null) { director.Voice -= OnVoice; director.Loaded -= Clear; }
            Clear();
        }
        private void Clear()
        {
            queue.Clear(); waiting.Clear();
            if (playing != null) StopCoroutine(playing);
            playing = null;
            if (source != null) { source.Stop(); if (source.clip != null) Destroy(source.clip); source.clip = null; }
        }
        private JObject Line(string id) => director.Lines?.OfType<JObject>().FirstOrDefault(line => (string)line["id"] == id);
        private CrewRig Speaker(JObject line)
        {
            var speaker = (string)line?["speaker"];
            return speaker != null && speaker.StartsWith("foreman_", StringComparison.Ordinal) ? world.Crew(speaker.Substring(8)) : null;
        }
        private bool Audible(string id)
        {
            var crew = Speaker(Line(id));
            return presenter || crew == null || listener != null && Vector3.Distance(listener.position, crew.transform.position) <= ListenMetres;
        }
        private void OnVoice(JObject message)
        {
            if (!Director.ForSeat(message, "site")) return;
            foreach (var id in message["lineIds"]?.Values<string>() ?? Enumerable.Empty<string>())
                if (Audible(id)) queue.Enqueue(id); else if (!waiting.Contains(id)) waiting.Add(id);
        }
        private void Update()
        {
            for (var i = 0; i < waiting.Count;)
                if (Audible(waiting[i])) { queue.Enqueue(waiting[i]); waiting.RemoveAt(i); } else i++;
            if (playing == null && queue.Count > 0) playing = StartCoroutine(Play());
        }
        private IEnumerator Play()
        {
            yield return null;
            while (queue.Count > 0)
            {
                var id = queue.Dequeue(); var line = Line(id);
                if (line == null) continue;
                var crew = Speaker(line);
                var relative = "Voice/" + director.scenarioId + "/" + id + ".wav";
#if !UNITY_ANDROID || UNITY_EDITOR
                if (!File.Exists(Path.Combine(Application.streamingAssetsPath, relative)))
                { MissingVoice?.Invoke((string)line["text"]); yield return new WaitForSecondsRealtime(MissingSeconds); continue; }
#endif
                using (var request = UnityWebRequestMultimedia.GetAudioClip(StreamingData.Url(relative), AudioType.WAV))
                {
                    yield return request.SendWebRequest();
                    if (request.result != UnityWebRequest.Result.Success)
                    { MissingVoice?.Invoke((string)line["text"]); yield return new WaitForSecondsRealtime(MissingSeconds); continue; }
                    source.clip = DownloadHandlerAudioClip.GetContent(request);
                    Position(crew); source.Play();
                    while (source.isPlaying) { Position(crew); yield return null; }
                    Destroy(source.clip); source.clip = null;
                }
            }
            playing = null;
        }
        private void Position(CrewRig crew)
        {
            source.transform.position = crew != null ? crew.transform.position : dashboard.position;
            source.spatialBlend = 1;
            // A logarithmic tail keeps the miniature audible beyond its scaled field radius.
            source.rolloffMode = presenter ? AudioRolloffMode.Logarithmic : AudioRolloffMode.Linear;
            var scale = presenter ? world.transform.lossyScale.x : 1;
            source.minDistance = 2 * scale; source.maxDistance = 50 * scale;
        }
    }
}
