diff --git a/Assets/LOBOver/Runtime/World/SiteWorld.cs b/Assets/LOBOver/Runtime/World/SiteWorld.cs
index f390e2f3234ff421e637305c8b673b815191452b..a71421edfd4197c20a5e35af5f16cc4764c83bd6
