+      .filter(Boolean).map(({ id, speaker, text }) => ({ id, speaker, text })) };
+  }
+  function drain(requester) {
+    for (let message of sim.drain()) {
+      if (message.t === 'result') {
+        result = { ...message, previousRun: runs.get(scenario.result.overlayPreviousStage) ?? null };
