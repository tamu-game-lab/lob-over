wrap}#pm{border-left:3px solid #5a7180;padding:10px 13px;background:#e9edef}#pm[hidden],#responses[hidden],#overlay[hidden]{display:none}.response{margin-bottom:12px}table{width:100%;border-collapse:collapse;font-size:12px}td,th{text-align:left;padding:6px;border-bottom:1px solid #d9dedb}.result-details{display:grid;grid-template-columns:1fr 1fr;gap:16px}.keypad input{width:130px}.start-handle{cursor:ns-resize;fill:white;stroke:#23313b;stroke-width:2}#events:empty{display:none}@media(max-width:850px){main{padding:12px}.layout,.bottom,.result-details{grid-template-columns:1fr}.budget{grid-template-columns:repeat(3,1fr)}header{padding:14px}#chart{height:400px}}
