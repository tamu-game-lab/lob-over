eight:42px;background:#ddd8c9;border-block:1px dashed #9e9d92}.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px}.swatch{display:inline-block;width:24px;height:14px;border:1px solid #aab8b8;vertical-align:middle;margin-right:3px}#crew-list{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.crew-card{padding:9px 12px;border:1px solid #c8d0cd;background:#f2f3ed}.mood{font-family:monospace}#feedback{min-height:22px}#events:empty{display:none}.event{border-left:3px solid #647e8b;padding:8px 12px;margin-bottom:10px;background:#edf1f1}.event h3{font-size:15px;margin:0}.event p{margin:5px 0}.item{border-bottom:1px solid #d5dcd8;padding:10px 0}.item p{margin:4px 0}#clipboard{min-height:100px;background:repeating-linear-gradient(#faf7ed 0 27px,#d7dfd9 27px 28px);padding:10px;line-height:28px;white-space:pre-line}#actual{width:100%;height:230px}#actual text{font:11px system-ui;fill:#344955}.board{padding:9px 0;border-bottom:1px solid #d5dcd8}#sky-drawing{width:70px;height:40px}#listen-lines{max-height:200px;overflow:auto}@media(max-width:750px){main{padding:10px}.layout{grid-template-columns:1fr}header{padding:14px}.panel{padding:12px}.row{gap:7px}.row button{min-height:42px}}
