+
+async function main(args) {
+  const [scenarioPath, ...options] = args;
+  if (!scenarioPath || scenarioPath.startsWith('--')) throw new Error('Usage: node server.js <scenario.json> [--port 7331] [--stage2 <scenario.json>]');
