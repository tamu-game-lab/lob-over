import { spawn } from 'node:child_process';
import { once } from 'node:events';
import assert from 'node:assert/strict';
const cwd = process.cwd();
for (const npm of [false, true]) {
  const env = { ...process.env }; delete env.INIT_CWD;
  const child = npm
    ? spawn(process.env.ComSpec, ['/d', '/s', '/c', 'npm.cmd --prefix Monitor run host -- Data/Scenarios/stage1_texas.json'], { cwd, env, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] })
    : spawn(process.execPath, ['Monitor/src/host/server.js', 'Data/Scenarios/stage1_texas.json'], { cwd, env, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] });
  let stderr = '';
  child.stderr.on('data', data => stderr += data);
  try {
    await new Promise((resolve, reject) => {
      let output = '';
      child.stdout.on('data', data => { output += data; if (output.includes('listening on 7331')) resolve(); });
      child.once('error', reject);
      child.once('exit', code => reject(new Error("'`Host exited ${code}: ${stderr}`)));
    });
    const codes = [];
    for (const name of ['"'plan', 'site']) codes.push((await fetch("'`http://localhost:7331/${name}.html`)).status);
    assert.deepEqual(codes, [200, 200]);
    console.log(`${npm ? '"'npm.cmd --prefix Monitor run host -- Data/Scenarios/stage1_texas.json' : 'node Monitor/src/host/server.js Data/Scenarios/stage1_texas.json'} -> "'${codes.join('"' ')}"'`);
    assert.equal(stderr, '"'');
  } finally {
    const exited = once(child, 'exit');
    if (npm) {
      const killer = spawn('taskkill.exe', ['/PID', String(child.pid), '/T', '/F'], { windowsHide: true, stdio: 'ignore' });
      await once(killer, 'exit');
    } else child.kill();
    await exited;
    await assert.rejects(fetch('http://localhost:7331/plan.html'));
    console.log('Host stopped; port 7331 closed.');
  }
}
