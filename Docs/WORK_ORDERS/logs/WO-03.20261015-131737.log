+    : loadScenario(resolve(dirname(resolve(base, scenarioPath)), 'stage2_texas.json'), { catalog });
+  const stages = new Map([scenario, stage2].map(s => [s.id, s]));
+  const runs = new Map();
+  let sim, transcript, snapshotDay, result, initialMessages, inspected;
 
-log.info('Usage: npm.cmd --prefix Monitor run host');
-log.warn('The host is a stub until WO-03.');
-process.exitCode = 2;
+  function reset() {
+    sim = createSim(scenario, catalog);
