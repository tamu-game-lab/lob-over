@@ -0,0 +1,80 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOB · Site</title><style>
+:root{font:14px/1.45 system-ui,sans-serif;color:#283942;background:#eeeae2}*{box-sizing:border-box}body{margin:0}header{padding:18px 26px;background:#2b3d43;color:white;display:flex;justify-content:space-between;align-items:center}h1{font-size:21px;margin:0}h2{font-size:15px;margin:0 0 12px}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#d5dfe4}main{padding:18px 24px;max-width:1600px;margin:auto}.panel{padding:16px;background:#fffdf8;border:1px solid #c7cec9;margin-bottom:16px}.layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(300px,1fr);gap:16px}.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.row label{display:flex;flex-direction:column;font-size:12px}.row input{width:125px}button,input{font:inherit;padding:8px 10px;border:1px solid #8b999f;border-radius:3px;background:#fffdf8;color:inherit}button{cursor:pointer}button:hover{background:#e7edf0}button:disabled{opacity:.45;cursor:default}.primary{background:#2d4754;color:white}#strip-scroll{overflow-x:auto;margin:12px 0;border:1px solid #bac5c7}#strip{position:relative;width:2400px;height:250px;background:#f1f0e8}.zone-board{position:absolute;top:0;height:50px;padding:7px;border-left:1px solid #879ba3;font-size:12px;background:#e3e8e6}.cell{position:absolute;top:80px;height:80px;border:1px solid #aab8b8;border-radius:0;font:11px ui-monospace,monospace;padding:3px;color:#263941}.cell span{background:#fffdf8e8}.undug{background:#e3e0d7}.open{background:repeating-linear-gradient(45deg,#f8f5eb 0 6px,#b3aa91 6px 8px)}.piped{background:repeating-linear-gradient(0deg,#e3e9e8 0 7px,#839aa4 7px 10px)}.backfilled{background:repeating-linear-gradient(45deg,#b6c0b9 0 3px,#e7ece5 3px 6px)}.crew{position:absolute;top:53px;font-size:12px;white-space:nowrap;pointer-events:none;transform:translateX(-15%)}#truck{position:absolute;top:191px;transition:left .25s linear;white-space:nowrap;font-size:18px;transform:translateX(-15%)}.road{position:absolute;top:186px;left:0;width:100%;h