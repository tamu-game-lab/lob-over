+function showResult(message){
+  result=message;$('overlay').hidden=false;$('chart-title').textContent=state.view.project.title;
+  html('numbers',Object.entries(result).filter(([k,v])=>typeof v==='number'&&!['v','day'].includes(k)).map(([k,v])=>`<tr><th>${esc(k)}</th><td>${num(v)}</td></tr>`).join('')+Object.entries(result.idleDays??{}).map(([k,v])=>`<tr><th>${k} idle days</th><td>${num(v)}</td></tr>`).join('')+(result.lost?`<tr><th>Run ended</th><td>${esc(result.lost)}</td></tr>`:''));
+  html('changes',result.changeLog.map(c=>`<div class="item"><b>Day ${num(c.day+1)}</b><p>${c.ops.map(o=>esc(describe(o))).join('<br>')}</p></div>`).join(''));
+  html('result-events',result.events.map(e=>`<div>${esc(e.id)} · Day ${num(e.day+1)} · ${esc(e.option??'—')} · ${num(e.daysLost)} days · ${esc(e.protection??'—')}</div>`).join(''));drawChart();
+}
+async function playVoice(message){
+  const voiceStage=stage;
+  for(const line of message.lines??[]){
+    const url=`/Voice/${encodeURIComponent(voiceStage)}/${encodeURIComponent(line.id)}.wav`;
+    if(!voiceFiles.has(url))voiceFiles.set(url,fetch(url,{method:'HEAD'}).then(r=>r.ok).catch(()=>false));
+    const fallback=()=>{if(stage!==voiceStage)return;clearTimeout(pmTimer);$('pm').hidden=false;$('pm-text').textContent=line.text;pmTimer=setTimeout(()=>{$('pm').hidden=true;},VOICE_MS);};
+    if(await voiceFiles.get(url)){try{await new Audio(url).play();}catch{fallback();}}else fallback();
+  }
+}
+socket.onmessage=event=>{
+  const message=JSON.parse(event.data);
+  if(message.t==='welcome'){$('connection').textContent=message.mirror?'Mirror · read only':'Connected';acceptState(message.state);}
+  else if(message.t==='state')acceptState(message);
+  else if(message.t==='ack'||message.t==='nack'){
+    const callback=pending.get(message.id);pending.delete(message.id);
+    if(message.t==='nack')$('feedback').textContent=message.reason;
+    else{callback?.();if(message.permits)$('feedback').textContent=message.permits.map(p=>p.number).join(' · ');}
+  }else if(message.t==='report')lastReport=message;
+  else if(message.t==='event')$('events').insertAdjacentHTML('afterbegin',`<article><h2>${esc(message.card.title)}</h2>${message.card.facts.map(f=>`<p>${esc(f)}</p>`).join('')}</article>`);
+  else if(message.t==='voice')playVoice(message);
+  else if(message.t==='result')showResult(message);
+};
+function acceptState(message){
+  if(state?.runId!==message.runId){result=null;draft=[];catalogStage=null;lastReport=null;$('overlay').hidden=true;$('events').innerHTML='';$('draft').innerHTML='';$('feedback').textContent='';$('chart-title').textContent='Line of balance';$('response-options').dataset.keys='';}
+  state=message;stage=message.stage;lastDay=message.day;render();
+}
+</script></body></html>
diff --git a/Monitor/web/site.html b/Monitor/web/site.html
new file mode 100644
index 0000000000000000000000000000000000000000..8dd635fa98ad779cd8051f06cfabeee38baa7f52
--- /dev/null
+++ b/Monitor/web/site.html
@@ -0,0 +1,81 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOB · Site</title><style>
+:root{font:14px/1.45 system-ui,sans-serif;color:#283942;background:#eeeae2}*{box-sizing:border-box}body{margin:0}header{padding:18px 26px;background:#2b3d43;color:white;display:flex;justify-content:space-between;align-items:center}h1{font-size:21px;margin:0}h2{font-size:15px;margin:0 0 12px}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#d5dfe4}main{padding:18px 24px;max-width:1600px;margin:auto}.panel{padding:16px;background:#fffdf8;border:1px solid #c7cec9;margin-bottom:16px}.layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(300px,1fr);gap:16px}.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.row label{display:flex;flex-direction:column;font-size:12px}.row input{width:125px}button,input{font:inherit;padding:8px 10px;border:1px solid #8b999f;border-radius:3px;background:#fffdf8;color:inherit}button{cursor:pointer}button:hover{background:#e7edf0}button:disabled{opacity:.45;cursor:default}.primary{background:#2d4754;color:white}#strip-scroll{overflow-x:auto;margin:12px 0;border:1px solid #bac5c7}#strip{position:relative;width:2400px;height:250px;background:#f1f0e8}.zone-board{position:absolute;top:0;height:50px;padding:7px;border-left:1px solid #879ba3;font-size:12px;background:#e3e8e6}.cell{position:absolute;top:80px;height:80px;border:1px solid #aab8b8;border-radius:0;font:11px ui-monospace,monospace;padding:3px;color:#263941}.cell span{background:#fffdf8e8}.undug{background:#e3e0d7}.open{background:repeating-linear-gradient(45deg,#f8f5eb 0 6px,#b3aa91 6px 8px)}.piped{background:repeating-linear-gradient(0deg,#e3e9e8 0 7px,#839aa4 7px 10px)}.backfilled{background:repeating-linear-gradient(45deg,#b6c0b9 0 3px,#e7ece5 3px 6px)}.crew{position:absolute;top:53px;font-size:12px;white-space:nowrap;pointer-events:none;transform:translateX(-15%)}#truck{position:absolute;top:191px;transition:left .25s linear;white-space:nowrap;font-size:18px;transform:translateX(-15%)}.road{position:absolute;top:186px;left:0;width:100%;height:42px;background:#ddd8c9;border-block:1px dashed #9e9d92}.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px}.swatch{display:inline-block;width:24px;height:14px;border:1px solid #aab8b8;vertical-align:middle;margin-right:3px}#crew-list{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0}.crew-card{padding:9px 12px;border:1px solid #c8d0cd;background:#f2f3ed}.mood{font-family:monospace}#feedback{min-height:22px}#events:empty{display:none}.event{border-left:3px solid #647e8b;padding:8px 12px;margin-bottom:10px;background:#edf1f1}.event h3{font-size:15px;margin:0}.event p{margin:5px 0}.item{border-bottom:1px solid #d5dcd8;padding:10px 0}.item p{margin:4px 0}#clipboard{min-height:100px;background:repeating-linear-gradient(#faf7ed 0 27px,#d7dfd9 27px 28px);padding:10px;line-height:28px;white-space:pre-line}#actual{width:100%;height:230px}#actual text{font:11px system-ui;fill:#344955}.board{padding:9px 0;border-bottom:1px solid #d5dcd8}#sky-drawing{width:70px;height:40px}#listen-lines{max-height:200px;overflow:auto}@media(max-width:750px){main{padding:10px}.layout{grid-template-columns:1fr}header{padding:14px}.panel{padding:12px}.row{gap:7px}.row button{min-height:42px}}
+button.primary:hover{background:#365568}
+</style></head><body><header><div><div class="eyebrow">LOB, Over / Field inspector</div><h1 id="title">Site</h1></div><div><div id="today"></div><small id="connection">Connecting</small></div></header>
+<main><section class="panel"><div class="row"><h2 style="margin:0;flex:1">The line</h2><svg id="sky-drawing" viewBox="0 0 70 40" aria-hidden="true"></svg><span id="sky"></span></div><div class="legend"><span><i class="swatch undug"></i>undug</span><span><i class="swatch open"></i>open</span><span><i class="swatch piped"></i>piped</span><span><i class="swatch backfilled"></i>backfilled</span><span>≈ water · ∕ wall · □ protection</span></div>
+<div id="strip-scroll"><div id="strip"><div id="zones"></div><div id="cells"></div><div id="crew-icons"></div><div class="road"></div><div id="truck">▣ Truck</div></div></div>
+<div class="row"><label>Station<input id="destination" placeholder="7+20" autocomplete="off"></label><button id="move">Move to station</button><button id="mount" class="primary">Dismount</button><span id="truck-location"></span></div><div id="crew-list"></div><p id="feedback" role="status"></p></section>
+<div class="layout"><div><section id="events" class="panel"></section><section class="panel"><h2>Inspect</h2><div id="inspect-buttons" class="row"></div><h3>Clipboard</h3><div id="clipboard"></div><div class="row" style="margin-top:12px"><button id="listen">Listen</button><label><input id="read-aloud" type="checkbox">Read clipboard aloud</label></div><div id="listen-lines"></div></section>
+<section class="panel"><h2>Field actions</h2><div class="row"><label>Flag station<input id="flag-station" placeholder="7+20"></label><label>Note · 40 characters<input id="flag-note" maxlength="40" style="width:250px"></label><button id="flag">Flag</button><button id="stop-work">Stop work</button></div></section></div>
+<aside><section class="panel"><h2>Confirm</h2><div id="orders"></div></section><section class="panel"><h2>Trailer board</h2><div class="legend"><span>━ exc</span><span>┄ pipe</span><span>┈ back</span><span>Live actual</span></div><svg id="actual" viewBox="0 0 420 240" role="img" aria-label="Live actual lines"></svg><div id="boards"></div><p id="gate"></p></section></aside></div></main>
+<script>
+'use strict';
+const $=id=>document.getElementById(id),esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const station=ft=>{ft=Math.round(ft);return Math.floor(ft/100)+'+'+String(ft%100).padStart(2,'0');};
+const parseStation=text=>text.includes('+')?Number(text.split('+')[0])*100+Number(text.split('+')[1]):Number(text);
+const html=(id,value)=>{if($(id).innerHTML!==value)$(id).innerHTML=value;};
+const TARGETS=['wall','water','pipe','machine','protection','board','sky','ticket','crew'];
+// Protocol mood levels 0–3, expressed without decision colors.
+const MOODS=['○','◔','◑','●'];
+let state, result, stage, lastDay=0, sequence=0;
+const cards=new Map();
+const socket=new WebSocket(`${location.protocol==='https:'?'wss':'ws'}://${location.host}/ws`);
+socket.onopen=()=>socket.send(JSON.stringify({t:'hello',v:1,seat:'site',client:'web'}));
+socket.onclose=()=>{$('connection').textContent='Disconnected';};
+function command(action,fields={}){if(socket.readyState!==WebSocket.OPEN)return;$('feedback').textContent='';socket.send(JSON.stringify({t:'cmd',v:1,id:'s-'+(++sequence),seat:'site',action,...fields}));}
+$('move').onclick=()=>command('moveTo',{stationFt:parseStation($('destination').value)});
+$('mount').onclick=()=>command(state.view.truck.dismounted?'mount':'dismount');
+$('listen').onclick=()=>command('listen');
+$('flag').onclick=()=>command('flag',{stationFt:parseStation($('flag-station').value),note:$('flag-note').value});
+function zoneAt(ft){const job=state.view.project.job;return job.zones.find(z=>ft>=z.fromFt&&(ft<z.toFt||ft===job.lengthFt));}
+$('stop-work').onclick=()=>command('stopWork',{zone:zoneAt(state.view.truck.stationFt).id});
+html('inspect-buttons',TARGETS.map(target=>`<button data-inspect="${target}">${target}</button>`).join(''));
+$('inspect-buttons').onclick=e=>{if(e.target.dataset.inspect)command('inspect',{target:e.target.dataset.inspect});};
+$('orders').onclick=e=>{if(e.target.dataset.order)command('confirm',{orderId:e.target.dataset.order,outcome:e.target.dataset.outcome});};
+$('cells').onclick=e=>{const button=e.target.closest('[data-station]');if(button)command('moveTo',{stationFt:Number(button.dataset.station)});};
+function render(){
+  const v=state.view,job=v.project.job,scale=2400/job.lengthFt;
+  $('title').textContent=v.project.title+' / Site';$('today').textContent='Day '+state.displayDay;
+  $('truck').style.left=Math.min(2340,v.truck.stationFt*scale)+'px';
+  $('truck-location').textContent=station(v.truck.stationFt)+(v.truck.moving?' · moving':v.truck.dismounted?' · on foot':' · mounted');
+  $('mount').textContent=v.truck.dismounted?'Mount':'Dismount';
+  $('mount').disabled=v.truck.moving;$('move').disabled=v.truck.moving||v.truck.dismounted;
+  const fieldDisabled=v.truck.moving||!v.truck.dismounted;
+  for(const button of document.querySelectorAll('[data-inspect],#listen,#flag,#stop-work'))button.disabled=fieldDisabled;
+  html('zones',job.zones.map(z=>{const b=v.boards.find(b=>b.zone===z.id);return `<div class="zone-board" style="left:${z.fromFt*scale}px;width:${(z.toFt-z.fromFt)*scale}px">Zone ${z.id} · ${station(z.fromFt)}–${station(z.toFt)}<br>Permit ${esc(b.permitNumber??'—')}</div>`;}).join(''));
+  html('cells',v.trench.filter(c=>c.stationFt<job.lengthFt).map(c=>`<button class="cell ${c.state}" data-station="${c.stationFt}" aria-label="Station ${station(c.stationFt)}" title="${esc([c.state,c.water,c.wall,c.protection].filter(Boolean).join(' · '))}" style="left:${c.stationFt*scale}px;width:${job.stationEveryFt*scale}px" ${v.truck.moving||v.truck.dismounted?'disabled':''}><span>${station(c.stationFt)}</span><br>${c.water&&c.water!=='none'?'≈':''}${c.wall==='slumped'?' ∕':''}${c.protection!=='none'?' □':''}</button>`).join(''));
+  html('crew-icons',v.crews.map((c,i)=>`<div class="crew" style="left:${Math.min(2320,c.stationFt*scale)}px;top:${53+i*9}px" title="${esc(c.machinePlate)}">◆ ${c.id} ${MOODS[c.moodLevel]}</div>`).join(''));
+  html('crew-list',v.crews.map(c=>`<div class="crew-card" data-crew="${c.id}" title="Plate: ${esc(c.machinePlate)}"><b>${c.id}</b> · ${station(c.stationFt)} · <span class="crew-status">${esc(c.status)}</span> <span class="mood" aria-label="Mood ${c.moodLevel}">${MOODS[c.moodLevel]} ${c.moodLevel}</span></div>`).join(''));
+  html('orders',v.orders.map(o=>`<div class="item" data-order="${o.id}"><b>${esc(o.crew)} · ${esc(o.op.op)}</b><p>${esc(o.id)} · ${esc(o.status==='notCarriedOut'?'not carried out':o.status)}</p><button data-order="${o.id}" data-outcome="done" ${fieldDisabled?'disabled':''}>Done</button> <button data-order="${o.id}" data-outcome="notDone" ${fieldDisabled?'disabled':''}>Not carried out</button></div>`).join('')||(v.truck.moving?'Truck moving':'No orders at this station.'));
+  html('boards',v.boards.map(b=>`<div class="board"><b>Zone ${b.zone}</b> · Permit ${esc(b.permitNumber??'—')}<br>Inspection ${esc(b.inspectionNumber??'—')}</div>`).join(''));
+  $('gate').textContent='Trucks waiting: '+v.gate.trucksWaiting;
+  $('sky').textContent={clear:'clear',towersSouth:'towers to the south',rain:'rain'}[v.sky];
+  $('sky-drawing').innerHTML=v.sky==='clear'?'<circle cx="35" cy="20" r="11" fill="none" stroke="#516e7a" stroke-width="2"/><path d="M35 2v4m0 28v4M17 20h-4m44 0h-4M22 7l3 3m20 20l3 3M22 33l3-3M45 10l3-3" stroke="#516e7a"/>':'<path d="M12 25c-8-15 10-19 15-10 0-19 25-17 25 0 15 0 14 15 3 15H16" fill="#d0dadc" stroke="#516e7a"/>'+(v.sky==='rain'?'<path d="M20 31l-4 7m18-7l-4 7m18-7l-4 7" stroke="#516e7a"/>':'');
+  if(v.activeEvent?.card)cards.set(v.activeEvent.id,v.activeEvent.card);
+  html('events',[...cards.values()].reverse().map(card=>`<article class="event"><h3>${esc(card.title)}</h3>${card.facts.map(f=>`<p>${esc(f)}</p>`).join('')}</article>`).join(''));
+  drawActual();
+}
+function drawActual(){
+  const job=state.view.project.job,maxT=Math.max(1,Math.ceil(state.day)),x=ft=>35+ft/job.lengthFt*345,y=t=>205-t/maxT*170;
+  let s='<text x="5" y="16">Day</text><text x="180" y="237">Station</text>';
+  for(const z of [...job.zones.map(z=>z.fromFt),job.lengthFt])s+=`<line x1="${x(z)}" y1="28" x2="${x(z)}" y2="205" stroke="#d1dcd7"/><text x="${x(z)}" y="222" text-anchor="middle">${station(z)}</text>`;
+  s+=`<text x="4" y="205">1</text><text x="4" y="35">${maxT+1}</text>`;
+  for(const [i,id] of ['exc','pipe','back'].entries())s+=`<polyline points="${state.view.actualLines[id].map(p=>`${x(p.ft)},${y(p.t)}`).join(' ')}" fill="none" stroke="#324f60" stroke-width="2" stroke-dasharray="${['','8 4','2 4'][i]}"/>`;
+  $('actual').innerHTML=s;
+}
+socket.onmessage=event=>{
+  const message=JSON.parse(event.data);
+  if(message.t==='welcome'){$('connection').textContent=message.mirror?'Mirror · read only':'Connected';acceptState(message.state);}
+  else if(message.t==='state')acceptState(message);
+  else if(message.t==='nack')$('feedback').textContent=message.reason;
+  else if(message.t==='inspection'){$('clipboard').textContent=message.text;if($('read-aloud').checked&&'speechSynthesis'in window)speechSynthesis.speak(new SpeechSynthesisUtterance(message.text));}
+  else if(message.t==='event'){cards.set(message.eventId,message.card);render();}
+  else if(message.t==='voice')html('listen-lines',(message.lines??[]).map(line=>`<p><b>${esc(line.speaker==='pm'?'PM':line.speaker.replace('foreman_',''))}</b> · ${esc(line.text)}</p>`).join(''));
+  else if(message.t==='result'){result=message;$('feedback').textContent=state.view.project.title;}
+};
+function acceptState(message){
+  if(state?.runId!==message.runId){cards.clear();result=null;$('clipboard').textContent='';$('listen-lines').innerHTML='';$('feedback').textContent='';}
+  state=message;stage=message.stage;lastDay=message.day;render();
+}
+</script></body></html>

diff --git a/Monitor/e2e/stage1.e2e.js b/Monitor/e2e/stage1.e2e.js
new file mode 100644
index 0000000000000000000000000000000000000000..275f8ba7967d388c11b87bf6b29d733b63f97958
--- /dev/null
+++ b/Monitor/e2e/stage1.e2e.js
@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { mkdir, readFile, readdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { chromium } from 'playwright';
+
+const root = fileURLToPath(new URL('../../', import.meta.url));
+const output = fileURLToPath(new URL('../out/e2e/', import.meta.url));
+const scenario = JSON.parse(await readFile(new URL('../../Data/Scenarios/stage1_texas.json', import.meta.url), 'utf8'));
+
+async function clickAck(page, locator) {
+  const reply = page.evaluate(() => new Promise(resolve => {
+    const listener = event => {
+      const message = JSON.parse(event.data);
+      if (message.t === 'ack' || message.t === 'nack') { socket.removeEventListener('message', listener); resolve(message); }
+    };
+    socket.addEventListener('message', listener);
+  }));
+  await locator.click();
+  const message = await reply;
+  assert.equal(message.t, 'ack', message.reason);
+  return message;
+}
+async function hold(plan, days) {
+  await plan.locator('#hold-crew').selectOption('back');
+  await plan.locator('#hold-days').fill(String(days));
+  await plan.locator('#add-hold').click();
+}
+async function ride(site, ft) {
+  if (await site.evaluate(() => state.view.truck.dismounted)) await clickAck(site, site.locator('#mount'));
+  await site.locator('#destination').fill(`${Math.floor(ft / 100)}+${String(Math.round(ft % 100)).padStart(2, '0')}`);
+  await clickAck(site, site.locator('#move'));
+  await site.waitForFunction(() => !state.view.truck.moving);
+  await clickAck(site, site.locator('#mount'));
+  assert.equal(await site.evaluate(() => state.view.truck.dismounted), true);
+}
+async function signInspection(plan, card) {
+  await plan.waitForFunction(zone => state.view.inbox.some(item => item.subject === `Zone ${zone} compaction`), card.zone, { timeout: 40_000 });
+  await plan.locator('#key-zone').selectOption(String(card.zone));
+  await plan.locator('#inspection-number').fill(card.number);
+  await clickAck(plan, plan.locator('#enter-inspection'));
+  console.log(`Inspection posted: zone ${card.zone}`);
+}
+
+test('Stage 1: three-seat field loop, daily report, argument and final overlay', { timeout: 180_000 }, async t => {
+  await mkdir(output, { recursive: true });
+  const before = new Set(await readdir(new URL('../out/', import.meta.url)));
+  const host = spawn(process.execPath, ['Monitor/src/host/server.js', 'Data/Scenarios/stage1_texas.json', '--port', '0'], {
+    cwd: root, env: { ...process.env, INIT_CWD: root, NODE_ENV: 'test' }, windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  let stderr = '', browser;
+  host.stderr.on('data', data => { stderr += data; });
+  try {
+    const port = await new Promise((resolve, reject) => {
+      let stdout = '';
+      host.stdout.on('data', data => { stdout += data; const match = stdout.match(/listening on (\d+)/); if (match) resolve(Number(match[1])); });
+      host.once('error', reject);host.once('exit', code => reject(new Error(`Host exited ${code}: ${stderr}`)));
+    });
+    browser = await chromium.launch({ headless: true });
+    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+    const pages = {}, errors = [];
+    for (const name of ['plan', 'site', 'facilitator']) {
+      const page = await context.newPage();pages[name] = page;
+      page.on('pageerror', error => errors.push(`${name}: ${error.message}`));
+      await page.goto(`http://127.0.0.1:${port}/${name}.html`);
+      await page.waitForFunction(() => !!state);
+    }
+    const { plan, site, facilitator } = pages;
+    assert.equal(await facilitator.locator('#speed').innerText(), 'paused');
+    await clickAck(facilitator, facilitator.locator('#start'));
+    await ride(site, 720);
+    assert.ok(await site.evaluate(() => state.displayDay < 6));
+    await site.getByRole('heading', { name: 'Trench wall collapse at 7+20', exact: true }).waitFor({ timeout: 35_000 });
+    assert.equal(await plan.getByText(/collapse/i).count(), 0);
+    assert.equal(await plan.locator('#inbox .item').first().getAttribute('data-kind'), 'report');
+    await plan.screenshot({ path: `${output}/plan-report.png` });
+    await site.screenshot({ path: `${output}/site-event.png` });
+    await clickAck(site, site.locator('#stop-work'));
+    await plan.locator('#lend-machine').selectOption('excavator_standard');
+    await plan.locator('#lend-crew').selectOption('pipe');
+    await plan.locator('#lend-days').fill('2');
+    await plan.locator('#add-lend').click();
+    await hold(plan, 2);
+    await clickAck(plan, plan.locator('#commit'));
+    await plan.waitForFunction(() => document.getElementById('speed').textContent === '5 s per day');
+    await plan.waitForFunction(() => state.view.radioLog.find(o => o.op.op === 'lend')?.status === 'landed', null, { timeout: 10_000 });
+    const lendId = await plan.evaluate(() => state.view.radioLog.find(o => o.op.op === 'lend').id);
+    await ride(site, await site.evaluate(() => state.view.crews.find(c => c.id === 'exc').stationFt));
+    await clickAck(site, site.locator(`[data-order="${lendId}"][data-outcome="notDone"]`));
+    await clickAck(plan, plan.getByRole('button', { name: 'Radio again', exact: true }));
+    await clickAck(site, site.locator(`[data-order="${lendId}"][data-outcome="done"]`));
+    await ride(site, await site.evaluate(() => state.view.crews.find(c => c.id === 'back').stationFt));
+    const holdId = await plan.evaluate(() => state.view.radioLog.find(o => o.op.op === 'hold').id);
+    await clickAck(site, site.locator(`[data-order="${holdId}"][data-outcome="done"]`));
+    const reportDay = await plan.evaluate(() => lastReport?.day ?? 0);
+    await plan.waitForFunction(day => lastReport?.day > day, reportDay, { timeout: 10_000 });
+    assert.equal(await plan.evaluate(() => lastReport.feetByCrew.pipe), 720);
+    assert.equal(await plan.evaluate(() => state.view.reportedLines.pipe.at(-1).ft), 720);
+    t.diagnostic(`Next daily report: pipe 720 ft, day ${await plan.evaluate(() => lastReport.day)}`);
+    console.log('Field loop complete; next report pipe 720 ft');
+
+    // WO-03 includes hold points: the paper seat supplies each authored card when its report lands.
+    await signInspection(plan, scenario.inspections.cards[0]);
+    await site.waitForFunction(() => state.view.crews.filter(c => c.status === 'arguing').length === 2, null, { timeout: 15_000 });
+    await hold(plan, 3);
+    await clickAck(plan, plan.locator('#commit'));
+    console.log('Argument addressed with hold back 3; starting fast pacing');
+    await facilitator.evaluate(() => control('fast'));
+    for (const card of scenario.inspections.cards.slice(1)) await signInspection(plan, card);
+    await plan.waitForFunction(() => !!result, null, { timeout: 30_000 });
+    const final = await plan.evaluate(() => result);
+    assert.ok(final.finishDay > 35 && final.finishDay < 46, JSON.stringify(final));
+    assert.equal(final.lost, undefined);
+    assert.equal(await plan.locator('#overlay').isVisible(), true);
+    assert.ok(await plan.locator('#chart polyline').count() >= 6);
+    assert.equal(await plan.locator('#changes .item').count(), final.changeLog.length);
+    for (const [name, page] of Object.entries(pages)) {
+      await page.evaluate(() => window.scrollTo(0, 0));
+      await page.screenshot({ path: `${output}/${name}.png` });
+      assert.doesNotMatch(await page.locator('body').innerText(), /correct|wrong|well done|good job|score|mistake|should have/i, name);
+    }
+    await site.setViewportSize({ width: 390, height: 844 });
+    assert.equal(await site.evaluate(() => document.documentElement.scrollWidth <= innerWidth), true);
+    await site.screenshot({ path: `${output}/site-phone.png` });
+    const transcript = await (await context.request.get(`http://127.0.0.1:${port}/transcript.json`)).json();
+    assert.equal(transcript.scenario, scenario.id);
+    assert.equal(transcript.result.finishDay, Number(final.finishDay.toFixed(3)));
+    assert.ok(transcript.snapshots.length > 35);
+    assert.ok(transcript.messages.some(m => m.message.t === 'result'));
+    const written = (await readdir(new URL('../out/', import.meta.url))).filter(name => !before.has(name) && name.startsWith('stage1_texas.') && name.endsWith('.json'));
+    assert.equal(written.length, 1);
+    assert.deepEqual(errors, []);
+    assert.equal(stderr, '');
+    t.diagnostic(`finishDay=${final.finishDay}; lost=absent; ${transcript.snapshots.length} snapshots; desktop and phone screenshots saved`);
+  } finally {
+    await browser?.close();
+    if (host.exitCode === null) { const exited = once(host, 'exit');host.kill();await exited; }
+  }
+});
diff --git a/Monitor/src/host/clients.js b/Monitor/src/host/clients.js
new file mode 100644
index 0000000000000000000000000000000000000000..329fb7e5ebf940edf205caa928ec1ec9af191f8b
--- /dev/null
+++ b/Monitor/src/host/clients.js
@@ -0,0 +1,64 @@
+import { WebSocket, WebSocketServer } from 'ws';
+
+const SEATS = new Set(['plan', 'site', 'facilitator']);
+export function createClients(server, { state, welcome, command }) {
+  const wss = new WebSocketServer({ server, path: '/ws' });
+  const clients = new Map();
+  const send = (socket, message) => {
+    if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify(message));
+  };
+  const broadcast = () => {
+    const views = new Map();
+    for (const [socket, client] of clients) {
+      if (!views.has(client.seat)) views.set(client.seat, state(client.seat));
+      send(socket, views.get(client.seat));
+    }
+  };
+  wss.on('connection', socket => {
+    socket.on('error', error => console.error('WebSocket:', error.message));
+    socket.on('close', () => clients.delete(socket));
+    socket.on('message', raw => {
+      let message;
+      try { message = JSON.parse(raw); } catch { return; }
+      if (!message || message.v !== 1) return;
+      if (message.t === 'hello') {
+        if (!SEATS.has(message.seat) || clients.has(socket)) return;
+        const mirror = [...clients.values()].some(c => c.seat === message.seat && !c.mirror);
+        clients.set(socket, { seat: message.seat, mirror });
+        send(socket, { t: 'welcome', v: 1, protocol: 1, seat: message.seat, mirror,
+          stage: state(message.seat).stage, state: state(message.seat) });
+        welcome(socket, message.seat, send);
+        return;
+      }
+      if (message.t !== 'cmd' && message.t !== 'ctrl') {
+        console.warn('Unknown message type:', message.t);
+        return;
+      }
+      const client = clients.get(socket);
+      let reason;
+      if (!client) reason = 'hello required';
+      else if (client.mirror) reason = 'mirror';
+      else if (message.t === 'ctrl' && client.seat !== 'facilitator'
+        || message.t === 'cmd' && (message.seat !== client.seat || client.seat === 'facilitator')) {
+        reason = 'action unavailable for seat';
+      }
+      if (reason) { send(socket, { t: 'nack', v: 1, id: message.id, reason }); return; }
+      command(socket, client.seat, message, send);
+    });
+  });
+  return {
+    broadcast,
+    deliver(message, requester) {
+      for (const [socket, client] of clients) {
+        if (message.t === 'inspection') {
+          if (socket === requester) send(socket, message);
+        } else {
+          const seats = message.t === 'report' ? ['plan', 'facilitator']
+            : message.t === 'result' ? [...SEATS] : message.seats ?? [];
+          if (seats.includes(client.seat)) send(socket, message);
+        }
+      }
+    },
+    close() { for (const socket of wss.clients) socket.terminate(); wss.close(); },
+  };
+}
diff --git a/Monitor/src/host/host.test.js b/Monitor/src/host/host.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9a70a653f299e9005e096cdc3b5bc46b6e61fbe3
--- /dev/null
+++ b/Monitor/src/host/host.test.js
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { fileURLToPath } from 'node:url';
+import { WebSocket } from 'ws';
+import { startHost } from './server.js';
+
+const scenarioPath = fileURLToPath(new URL('../../../Data/Scenarios/stage1_texas.json', import.meta.url));
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+function inbox(socket) {
+  const messages = [], waiters = new Set();
+  socket.on('message', data => {
+    const message = JSON.parse(data);messages.push(message);
+    for (const waiter of waiters) if (waiter.predicate(message)) {
+      clearTimeout(waiter.timer);waiters.delete(waiter);waiter.resolve(message);
+    }
+  });
+  return { messages, next(predicate) {
+    return new Promise((resolve, reject) => {
+      const waiter = { predicate, resolve };
+      waiter.timer = setTimeout(() => { waiters.delete(waiter);reject(new Error('Protocol reply timed out')); }, 3000);
+      waiters.add(waiter);
+    });
+  } };
+}
+test('host: static files, seat ownership, request routing, pacing and stage controls', { timeout: 15_000 }, async () => {
+  const host = await startHost({ scenarioPath, port: 0, testMode: false });
+  const clients = [];
+  let id = 0;
+  async function connect(seat) {
+    const socket = new WebSocket(`ws://127.0.0.1:${host.port}/ws`), queue = inbox(socket);
+    clients.push(socket);await once(socket, 'open');
+    const welcome = queue.next(m => m.t === 'welcome');
+    socket.send(JSON.stringify({ t: 'hello', v: 1, seat, client: 'web' }));
+    return { socket, queue, welcome: await welcome, seat };
+  }
+  async function command(client, action, fields = {}, type = client.seat === 'facilitator' ? 'ctrl' : 'cmd') {
+    const commandId = `test-${++id}`;
+    const next = client.queue.next(m => m.id === commandId && (m.t === 'ack' || m.t === 'nack'));
+    client.socket.send(JSON.stringify({ t: type, v: 1, id: commandId, seat: client.seat, action, ...fields }));
+    return next;
+  }
+  try {
+    for (const page of ['plan', 'site', 'facilitator']) {
+      const response = await fetch(`http://127.0.0.1:${host.port}/${page}.html`);
+      assert.equal(response.status, 200);assert.match(response.headers.get('content-type'), /text\/html/);
+    }
+    assert.equal((await fetch(`http://127.0.0.1:${host.port}/Voice/stage1_texas/pm_open_01.wav`, { method: 'HEAD' })).status, 200);
+    assert.equal((await fetch(`http://127.0.0.1:${host.port}/%2e%2e%5cData/catalog.json`)).status, 404);
+    const plan = await connect('plan'), mirror = await connect('plan'), site = await connect('site'), siteMirror = await connect('site'), facilitator = await connect('facilitator');
+    assert.equal(plan.welcome.mirror, false);assert.equal(mirror.welcome.mirror, true);
+    assert.equal(plan.welcome.state.speed, 'paused');
+    assert.equal(plan.welcome.state.view.actualLines, undefined);
+    assert.equal(plan.welcome.state.view.trench, undefined);
+    assert.equal(site.welcome.state.view.budget, undefined);
+    assert.equal(site.welcome.state.view.plannedLines, undefined);
+    assert.equal(site.welcome.state.view.trench.find(c => c.stationFt === 2000).water, undefined);
+    assert.equal((await command(mirror, 'commit', { ops: [] })).reason, 'mirror');
+    assert.equal((await command(plan, 'start', {}, 'ctrl')).reason, 'action unavailable for seat');
+    assert.equal((await command(plan, 'moveTo', { seat: 'site', stationFt: 720 })).reason, 'action unavailable for seat');
+    assert.equal((await command(facilitator, 'fast')).reason, 'unknown control');
+    assert.equal((await command(site, 'dismount')).t, 'ack');
+    const inspection = site.queue.next(m => m.t === 'inspection');
+    assert.equal((await command(site, 'inspect', { target: 'board' })).t, 'ack');
+    assert.match((await inspection).text, /TX-0141/);
+    await sleep(300);
+    assert.equal(siteMirror.queue.messages.some(m => m.t === 'inspection'), false);
+    const posted = await command(plan, 'commit', { ops: [{ op: 'enterPermit', zone: 1, code: '4821-5' }] });
+    assert.deepEqual(posted.permits, [{ zone: 1, number: 'TX-0141' }]);
+    assert.equal((await command(plan, 'commit', { ops: [{ op: 'setStart', crew: 'back', day: 12 }] })).reason, 'plan locked');
+    assert.equal((await command(facilitator, 'start')).t, 'ack');
+    await sleep(320);
+    const running = facilitator.queue.next(m => m.t === 'state');
+    await command(facilitator, 'pause');
+    const stopped = await running;
+    assert.equal(stopped.speed, 'paused');assert.ok(stopped.day >= .04 && stopped.day <= .1);
+    await sleep(300);
+    assert.equal(facilitator.queue.messages.filter(m => m.t === 'state').at(-1).day, stopped.day);
+    const loaded = facilitator.queue.next(m => m.t === 'state' && m.stage === 'stage2_texas');
+    assert.equal((await command(facilitator, 'load', { stage: 'stage2_texas' })).t, 'ack');
+    const stage2 = await loaded;
+    assert.equal(stage2.day, 0);assert.equal(stage2.speed, 'paused');
+    assert.equal((await command(plan, 'commit', { ops: [{ op: 'setStart', crew: 'back', day: 12 }] })).t, 'ack');
+    const reset = facilitator.queue.next(m => m.t === 'state' && m.runId > stage2.runId);
+    await command(facilitator, 'reset');assert.equal((await reset).day, 0);
+    assert.equal((await command(facilitator, 'load', { stage: 'missing' })).reason, 'stage not loaded');
+    for (const client of [plan, mirror, site, facilitator]) {
+      const replies = client.queue.messages.filter(m => m.t === 'ack' || m.t === 'nack');
+      assert.equal(new Set(replies.map(m => m.id)).size, replies.length);
+    }
+  } finally {
+    for (const socket of clients) socket.terminate();
+    await host.close();
+  }
+});
diff --git a/Monitor/src/host/pacing.js b/Monitor/src/host/pacing.js
new file mode 100644
index 0000000000000000000000000000000000000000..065c80e9984ae6a4e1f42182821e7a84c690e546
--- /dev/null
+++ b/Monitor/src/host/pacing.js
@@ -0,0 +1,25 @@
+// WO-03: identical simulation ticks at full, office and test speeds.
+export const STEP_DAYS = 0.01;
+export const FULL_MS = 50;
+export const SLOW_MS = 200;
+export const FAST_MS = 2;
+export const STATE_MS = 250;
+
+export function createPacer(getSim, afterTick) {
+  let timer, fast = false, closed = false;
+  function schedule() {
+    clearTimeout(timer);
+    const sim = getSim();
+    if (closed || sim.done || sim.speed === 'paused') return;
+    timer = setTimeout(() => {
+      getSim().tick(STEP_DAYS);
+      afterTick();
+      schedule();
+    }, fast ? FAST_MS : sim.speed === 'slow' ? SLOW_MS : FULL_MS);
+  }
+  return {
+    sync: schedule,
+    setFast(value) { fast = value; schedule(); },
+    close() { closed = true; clearTimeout(timer); },
+  };
+}
