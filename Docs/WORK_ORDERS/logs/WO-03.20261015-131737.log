@@ -0,0 +1,142 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { mkdir, readFile, readdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { chromium } from 'playwright';
+
+const root = fileURLToPath(new URL('../../', import.meta.url));
+const output = fileURLToPath(new URL('../out/e2e/', import.meta.url));
+const scenario = JSON.parse(await readFile(new URL('../../Data/Scenarios/stage1_texas.json', import.meta.url), 'utf8'));
+
+async function clickAck(page, locator) {
+  const reply = page.evaluate(() => new Promise(resolve => {
+    const listener = event => {
+      const message = JSON.parse(event.data);
+      if (message.t === 'ack' || message.t === 'nack') { socket.removeEventListener('message', listener); resolve(message); }
+    };
+    socket.addEventListener('message', listener);
+  }));
+  await locator.click();
+  const message = await reply;
+  assert.equal(message.t, 'ack', message.reason);
+  return message;
+}
+async function hold(plan, days) {
+  await plan.locator('#hold-crew').selectOption('back');
+  await plan.locator('#hold-days').fill(String(days));
+  await plan.locator('#add-hold').click();
+}
+async function ride(site, ft) {
+  if (await site.evaluate(() => state.view.truck.dismounted)) await clickAck(site, site.locator('#mount'));
+  await site.locator('#destination').fill(`${Math.floor(ft / 100)}+${String(Math.round(ft % 100)).padStart(2, '0')}`);
+  await clickAck(site, site.locator('#move'));
+  await site.waitForFunction(() => !state.view.truck.moving);
+  await clickAck(site, site.locator('#mount'));
+  assert.equal(await site.evaluate(() => state.view.truck.dismounted), true);
+}
+async function signInspection(plan, card) {
+  await plan.waitForFunction(zone => state.view.inbox.some(item => item.subject === `Zone ${zone} compaction`), card.zone, { timeout: 40_000 });
+  await plan.locator('#key-zone').selectOption(String(card.zone));
+  await plan.locator('#inspection-number').fill(card.number);
+  await clickAck(plan, plan.locator('#enter-inspection'));
+  console.log(`Inspection posted: zone ${card.zone}`);
+}
+
+test('Stage 1: three-seat field loop, daily report, argument and final overlay', { timeout: 180_000 }, async t => {
+  await mkdir(output, { recursive: true });
+  const before = new Set(await readdir(new URL('../out/', import.meta.url)));
+  const host = spawn(process.execPath, ['Monitor/src/host/server.js', 'Data/Scenarios/stage1_texas.json', '--port', '0'], {
+    cwd: root, env: { ...process.env, INIT_CWD: root, NODE_ENV: 'test' }, windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  let stderr = '', browser;
+  host.stderr.on('data', data => { stderr += data; });
+  try {
+    const port = await new Promise((resolve, reject) => {
+      let stdout = '';
+      host.stdout.on('data', data => { stdout += data; const match = stdout.match(/listening on (\d+)/); if (match) resolve(Number(match[1])); });
+      host.once('error', reject);host.once('exit', code => reject(new Error(`Host exited ${code}: ${stderr}`)));
+    });
+    browser = await chromium.launch({ headless: true });
+    const context = await browser.newContext({ viewport: { width: 1280, height: 800 } });
+    const pages = {}, errors = [];
+    for (const name of ['plan', 'site', 'facilitator']) {
+      const page = await context.newPage();pages[name] = page;
+      page.on('pageerror', error => errors.push(`${name}: ${error.message}`));
+      await page.goto(`http://127.0.0.1:${port}/${name}.html`);
+      await page.waitForFunction(() => !!state);
+    }
+    const { plan, site, facilitator } = pages;
+    assert.equal(await facilitator.locator('#speed').innerText(), 'paused');
+    await clickAck(facilitator, facilitator.locator('#start'));
+    await ride(site, 720);
+    assert.ok(await site.evaluate(() => state.displayDay < 6));
+    await site.getByRole('heading', { name: 'Trench wall collapse at 7+20', exact: true }).waitFor({ timeout: 35_000 });
+    assert.equal(await plan.getByText(/collapse/i).count(), 0);
+    assert.equal(await plan.locator('#inbox .item').first().getAttribute('data-kind'), 'report');
+    await plan.screenshot({ path: `${output}/plan-report.png` });
+    await site.screenshot({ path: `${output}/site-event.png` });
+    await clickAck(site, site.locator('#stop-work'));
+    await plan.locator('#lend-machine').selectOption('excavator_standard');
+    await plan.locator('#lend-crew').selectOption('pipe');
+    await plan.locator('#lend-days').fill('2');
+    await plan.locator('#add-lend').click();
+    await hold(plan, 2);
+    await clickAck(plan, plan.locator('#commit'));
+    await plan.waitForFunction(() => document.getElementById('speed').textContent === '5 s per day');
+    await plan.waitForFunction(() => state.view.radioLog.find(o => o.op.op === 'lend')?.status === 'landed', null, { timeout: 10_000 });
+    const lendId = await plan.evaluate(() => state.view.radioLog.find(o => o.op.op === 'lend').id);
+    await ride(site, await site.evaluate(() => state.view.crews.find(c => c.id === 'exc').stationFt));
+    await clickAck(site, site.locator(`[data-order="${lendId}"][data-outcome="notDone"]`));
+    await clickAck(plan, plan.getByRole('button', { name: 'Radio again', exact: true }));
+    await clickAck(site, site.locator(`[data-order="${lendId}"][data-outcome="done"]`));
+    await ride(site, await site.evaluate(() => state.view.crews.find(c => c.id === 'back').stationFt));
+    const holdId = await plan.evaluate(() => state.view.radioLog.find(o => o.op.op === 'hold').id);
+    await clickAck(site, site.locator(`[data-order="${holdId}"][data-outcome="done"]`));
+    const reportDay = await plan.evaluate(() => lastReport?.day ?? 0);
+    await plan.waitForFunction(day => lastReport?.day > day, reportDay, { timeout: 10_000 });
+    assert.equal(await plan.evaluate(() => lastReport.feetByCrew.pipe), 720);
+    assert.equal(await plan.evaluate(() => state.view.reportedLines.pipe.at(-1).ft), 720);
+    t.diagnostic(`Next daily report: pipe 720 ft, day ${await plan.evaluate(() => lastReport.day)}`);
+    console.log('Field loop complete; next report pipe 720 ft');
+
+    // WO-03 includes hold points: the paper seat supplies each authored card when its report lands.
+    await signInspection(plan, scenario.inspections.cards[0]);
+    await site.waitForFunction(() => state.view.crews.filter(c => c.status === 'arguing').length === 2, null, { timeout: 15_000 });
+    await hold(plan, 3);
+    await clickAck(plan, plan.locator('#commit'));
+    console.log('Argument addressed with hold back 3; starting fast pacing');
+    await facilitator.evaluate(() => control('fast'));
+    for (const card of scenario.inspections.cards.slice(1)) await signInspection(plan, card);
+    await plan.waitForFunction(() => !!result, null, { timeout: 30_000 });
+    const final = await plan.evaluate(() => result);
+    assert.ok(final.finishDay > 35 && final.finishDay < 46, JSON.stringify(final));
+    assert.equal(final.lost, undefined);
+    assert.equal(await plan.locator('#overlay').isVisible(), true);
+    assert.ok(await plan.locator('#chart polyline').count() >= 6);
+    assert.equal(await plan.locator('#changes .item').count(), final.changeLog.length);
+    for (const [name, page] of Object.entries(pages)) {
+      await page.evaluate(() => window.scrollTo(0, 0));
+      await page.screenshot({ path: `${output}/${name}.png` });
+      assert.doesNotMatch(await page.locator('body').innerText(), /correct|wrong|well done|good job|score|mistake|should have/i, name);
+    }
+    await site.setViewportSize({ width: 390, height: 844 });
+    assert.equal(await site.evaluate(() => document.documentElement.scrollWidth <= innerWidth), true);
+    await site.screenshot({ path: `${output}/site-phone.png` });
+    const transcript = await (await context.request.get(`http://127.0.0.1:${port}/transcript.json`)).json();
+    assert.equal(transcript.scenario, scenario.id);
+    assert.equal(transcript.result.finishDay, Number(final.finishDay.toFixed(3)));
+    assert.ok(transcript.snapshots.length > 35);
+    assert.ok(transcript.messages.some(m => m.message.t === 'result'));
+    const written = (await readdir(new URL('../out/', import.meta.url))).filter(name => !before.has(name) && name.startsWith('stage1_texas.') && name.endsWith('.json'));
+    assert.equal(written.length, 1);
+    assert.deepEqual(errors, []);
+    assert.equal(stderr, '');
+    t.diagnostic(`finishDay=${final.finishDay}; lost=absent; ${transcript.snapshots.length} snapshots; desktop and phone screenshots saved`);
+  } finally {
+    await browser?.close();
+    if (host.exitCode === null) { const exited = once(host, 'exit');host.kill();await exited; }
+  }
+});
diff --git a/Monitor/src/host/clients.js b/Monitor/src/host/clients.js
new file mode 100644
index 0000000000000000000000000000000000000000..329fb7e5ebf940edf205caa928ec1ec9af191f8b
--- /dev/null
+++ b/Monitor/src/host/clients.js
@@ -0,0 +1,64 @@
+import { WebSocket, WebSocketServer } from 'ws';
+
+const SEATS = new Set(['plan', 'site', 'facilitator']);
+export function createClients(server, { state, welcome, command }) {
+  const wss = new WebSocketServer({ server, path: '/ws' });
+  const clients = new Map();
+  const send = (socket, message) => {
+    if (socket.readyState === WebSocket.OPEN) socket.send(JSON.stringify(message));
+  };
+  const broadcast = () => {
+    const views = new Map();
+    for (const [socket, client] of clients) {
+      if (!views.has(client.seat)) views.set(client.seat, state(client.seat));
+      send(socket, views.get(client.seat));
+    }
+  };
+  wss.on('connection', socket => {
+    socket.on('error', error => console.error('WebSocket:', error.message));
+    socket.on('close', () => clients.delete(socket));
+    socket.on('message', raw => {
+      let message;
+      try { message = JSON.parse(raw); } catch { return; }
+      if (!message || message.v !== 1) return;
+      if (message.t === 'hello') {
+        if (!SEATS.has(message.seat) || clients.has(socket)) return;
+        const mirror = [...clients.values()].some(c => c.seat === message.seat && !c.mirror);
+        clients.set(socket, { seat: message.seat, mirror });
+        send(socket, { t: 'welcome', v: 1, protocol: 1, seat: message.seat, mirror,
+          stage: state(message.seat).stage, state: state(message.seat) });
+        welcome(socket, message.seat, send);
+        return;
+      }
+      if (message.t !== 'cmd' && message.t !== 'ctrl') {
+        console.warn('Unknown message type:', message.t);
+        return;
+      }
+      const client = clients.get(socket);
+      let reason;
+      if (!client) reason = 'hello required';
+      else if (client.mirror) reason = 'mirror';
+      else if (message.t === 'ctrl' && client.seat !== 'facilitator'
+        || message.t === 'cmd' && (message.seat !== client.seat || client.seat === 'facilitator')) {
+        reason = 'action unavailable for seat';
+      }
+      if (reason) { send(socket, { t: 'nack', v: 1, id: message.id, reason }); return; }
+      command(socket, client.seat, message, send);
+    });
+  });
+  return {
+    broadcast,
+    deliver(message, requester) {
+      for (const [socket, client] of clients) {
+        if (message.t === 'inspection') {
+          if (socket === requester) send(socket, message);
+        } else {
+          const seats = message.t === 'report' ? ['plan', 'facilitator']
+            : message.t === 'result' ? [...SEATS] : message.seats ?? [];
+          if (seats.includes(client.seat)) send(socket, message);
+        }
+      }
+    },
+    close() { for (const socket of wss.clients) socket.terminate(); wss.close(); },
+  };
+}
diff --git a/Monitor/src/host/host.test.js b/Monitor/src/host/host.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9a70a653f299e9005e096cdc3b5bc46b6e61fbe3
--- /dev/null
+++ b/Monitor/src/host/host.test.js
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { fileURLToPath } from 'node:url';
+import { WebSocket } from 'ws';
+import { startHost } from './server.js';
+
+const scenarioPath = fileURLToPath(new URL('../../../Data/Scenarios/stage1_texas.json', import.meta.url));
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+function inbox(socket) {
+  const messages = [], waiters = new Set();
+  socket.on('message', data => {
+    const message = JSON.parse(data);messages.push(message);
+    for (const waiter of waiters) if (waiter.predicate(message)) {
+      clearTimeout(waiter.timer);waiters.delete(waiter);waiter.resolve(message);
+    }
+  });
+  return { messages, next(predicate) {
+    return new Promise((resolve, reject) => {
+      const waiter = { predicate, resolve };
+      waiter.timer = setTimeout(() => { waiters.delete(waiter);reject(new Error('Protocol reply timed out')); }, 3000);
+      waiters.add(waiter);
+    });
+  } };
+}
+test('host: static files, seat ownership, request routing, pacing and stage controls', { timeout: 15_000 }, async () => {
+  const host = await startHost({ scenarioPath, port: 0, testMode: false });
+  const clients = [];
+  let id = 0;
+  async function connect(seat) {
+    const socket = new WebSocket(`ws://127.0.0.1:${host.port}/ws`), queue = inbox(socket);
+    clients.push(socket);await once(socket, 'open');
+    const welcome = queue.next(m => m.t === 'welcome');
+    socket.send(JSON.stringify({ t: 'hello', v: 1, seat, client: 'web' }));
+    return { socket, queue, welcome: await welcome, seat };
+  }
+  async function command(client, action, fields = {}, type = client.seat === 'facilitator' ? 'ctrl' : 'cmd') {
+    const commandId = `test-${++id}`;
+    const next = client.queue.next(m => m.id === commandId && (m.t === 'ack' || m.t === 'nack'));
+    client.socket.send(JSON.stringify({ t: type, v: 1, id: commandId, seat: client.seat, action, ...fields }));
+    return next;
+  }
+  try {
+    for (const page of ['plan', 'site', 'facilitator']) {
+      const response = await fetch(`http://127.0.0.1:${host.port}/${page}.html`);
+      assert.equal(response.status, 200);assert.match(response.headers.get('content-type'), /text\/html/);
+    }
+    assert.equal((await fetch(`http://127.0.0.1:${host.port}/Voice/stage1_texas/pm_open_01.wav`, { method: 'HEAD' })).status, 200);
+    assert.equal((await fetch(`http://127.0.0.1:${host.port}/%2e%2e%5cData/catalog.json`)).status, 404);
+    const plan = await connect('plan'), mirror = await connect('plan'), site = await connect('site'), siteMirror = await connect('site'), facilitator = await connect('facilitator');
+    assert.equal(plan.welcome.mirror, false);assert.equal(mirror.welcome.mirror, true);
+    assert.equal(plan.welcome.state.speed, 'paused');
+    assert.equal(plan.welcome.state.view.actualLines, undefined);
+    assert.equal(plan.welcome.state.view.trench, undefined);
+    assert.equal(site.welcome.state.view.budget, undefined);
+    assert.equal(site.welcome.state.view.plannedLines, undefined);
+    assert.equal(site.welcome.state.view.trench.find(c => c.stationFt === 2000).water, undefined);
+    assert.equal((await command(mirror, 'commit', { ops: [] })).reason, 'mirror');
+    assert.equal((await command(plan, 'start', {}, 'ctrl')).reason, 'action unavailable for seat');
+    assert.equal((await command(plan, 'moveTo', { seat: 'site', stationFt: 720 })).reason, 'action unavailable for seat');
+    assert.equal((await command(facilitator, 'fast')).reason, 'unknown control');
+    assert.equal((await command(site, 'dismount')).t, 'ack');
+    const inspection = site.queue.next(m => m.t === 'inspection');
+    assert.equal((await command(site, 'inspect', { target: 'board' })).t, 'ack');
+    assert.match((await inspection).text, /TX-0141/);
+    await sleep(300);
+    assert.equal(siteMirror.queue.messages.some(m => m.t === 'inspection'), false);
+    const posted = await command(plan, 'commit', { ops: [{ op: 'enterPermit', zone: 1, code: '4821-5' }] });
+    assert.deepEqual(posted.permits, [{ zone: 1, number: 'TX-0141' }]);
+    assert.equal((await command(plan, 'commit', { ops: [{ op: 'setStart', crew: 'back', day: 12 }] })).reason, 'plan locked');
+    assert.equal((await command(facilitator, 'start')).t, 'ack');
+    await sleep(320);
+    const running = facilitator.queue.next(m => m.t === 'state');
+    await command(facilitator, 'pause');
+    const stopped = await running;
+    assert.equal(stopped.speed, 'paused');assert.ok(stopped.day >= .04 && stopped.day <= .1);
+    await sleep(300);
+    assert.equal(facilitator.queue.messages.filter(m => m.t === 'state').at(-1).day, stopped.day);
+    const loaded = facilitator.queue.next(m => m.t === 'state' && m.stage === 'stage2_texas');
+    assert.equal((await command(facilitator, 'load', { stage: 'stage2_texas' })).t, 'ack');
+    const stage2 = await loaded;
+    assert.equal(stage2.day, 0);assert.equal(stage2.speed, 'paused');
+    assert.equal((await command(plan, 'commit', { ops: [{ op: 'setStart', crew: 'back', day: 12 }] })).t, 'ack');
+    const reset = facilitator.queue.next(m => m.t === 'state' && m.runId > stage2.runId);
+    await command(facilitator, 'reset');assert.equal((await reset).day, 0);
+    assert.equal((await command(facilitator, 'load', { stage: 'missing' })).reason, 'stage not loaded');
+    for (const client of [plan, mirror, site, facilitator]) {
+      const replies = client.queue.messages.filter(m => m.t === 'ack' || m.t === 'nack');
+      assert.equal(new Set(replies.map(m => m.id)).size, replies.length);
+    }
+  } finally {
+    for (const socket of clients) socket.terminate();
+    await host.close();
+  }
+});
diff --git a/Monitor/src/host/pacing.js b/Monitor/src/host/pacing.js
