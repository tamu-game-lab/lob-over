@@ -0,0 +1,158 @@
+<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LOB · Plan</title>
+<style>
+:root{font:14px/1.45 system-ui,sans-serif;color:#23313b;background:#eeeae2}*{box-sizing:border-box}body{margin:0}header{background:#243540;color:#fff;padding:18px 28px;display:flex;align-items:center;justify-content:space-between}h1{font-size:21px;margin:0}h2{font-size:15px;margin:0 0 12px}h3{font-size:14px}small,.muted{color:#65737b}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase}header .eyebrow{color:#d5dfe4}main{padding:18px 24px;max-width:1600px;margin:auto}.budget{display:grid;grid-template-columns:repeat(7,1fr);background:#faf8f3;border:1px solid #c7cec9;margin-bottom:16px}.budget div{padding:10px 14px;border-right:1px solid #d9dcd7}.budget span{display:block;font-size:11px;color:#52616b}.budget b{font:600 18px ui-monospace,monospace;white-space:nowrap}.layout{display:grid;grid-template-columns:minmax(0,2.15fr) minmax(310px,1fr);gap:16px}.panel{background:#fffdf8;border:1px solid #c7cec9;padding:16px;margin-bottom:16px}svg{width:100%;display:block}#chart{height:460px;touch-action:none}svg text{font:12px system-ui;fill:#334651}.legend{font-size:12px;display:flex;gap:18px;color:#53636b}.bottom{display:grid;grid-template-columns:1fr 1fr;gap:16px}button,input,select{font:inherit;border:1px solid #8b999f;background:#fffdf8;color:#23313b;border-radius:3px;padding:7px 9px;max-width:100%}button{cursor:pointer}button:hover{background:#e7edf0}button:disabled{opacity:.5;cursor:default}button.primary{background:#243f50;color:white;border:1px solid #243f50}label{font-size:12px;display:flex;flex-direction:column;gap:4px;margin-bottom:9px}.row{display:flex;gap:8px;align-items:end;flex-wrap:wrap}.row label{flex:1;min-width:75px}.row button{margin-bottom:9px}details{border-top:1px solid #d3d9d8;padding:9px 0}summary{cursor:pointer;font-weight:600}.scroll{max-height:260px;overflow:auto}.item{border-bottom:1px solid #d9dedb;padding:9px 0}.item:first-child{padding-top:0}.item p{margin:4px 0}.draft{padding-left:20px}#feedback{min-height:22px;white-space:pre-wrap}#pm{border-left:3px solid #5a7180;padding:10px 13px;background:#e9edef}#pm[hidden],#responses[hidden],#overlay[hidden]{display:none}.response{margin-bottom:12px}table{width:100%;border-collapse:collapse;font-size:12px}td,th{text-align:left;padding:6px;border-bottom:1px solid #d9dedb}.result-details{display:grid;grid-template-columns:1fr 1fr;gap:16px}.keypad input{width:130px}.start-handle{cursor:ns-resize;fill:white;stroke:#23313b;stroke-width:2}#events:empty{display:none}@media(max-width:850px){main{padding:12px}.layout,.bottom,.result-details{grid-template-columns:1fr}.budget{grid-template-columns:repeat(3,1fr)}header{padding:14px}#chart{height:400px}}
+</style></head><body>
